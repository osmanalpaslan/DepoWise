<!-- Avalonia UI Modern Accordion Sol Menü Örneği -->
<StackPanel Width="250" Background="#1E1E24">
    <!-- Malzemeler Accordion Başlığı -->
    <Expander Header="📦 Malzemeler" IsExpanded="True" Background="Transparent" Foreground="White">
        <StackPanel Margin="10,0,0,0">
            <Button Content="• Malzeme Listesi" Classes="MenuLink"/>
            <Button Content="• Yeni Kayıt" Classes="MenuLink"/>
        </StackPanel>
    </Expander>

    <!-- Araçlar Accordion Başlığı -->
    <Expander Header="🚚 Araçlar" IsExpanded="False" Background="Transparent" Foreground="White">
        <StackPanel Margin="10,0,0,0">
            <Button Content="• Araç Listesi" Classes="MenuLink"/>
            <Button Content="• Yeni Araç Ekle" Classes="MenuLink"/>
        </StackPanel>
    </Expander>
</StackPanel>