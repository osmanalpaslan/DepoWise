<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- PostgreSQL geçişi Faz 1 (2026-07-23): .NET PostgreSQL sürücüsü. Şimdilik yalnız bağlantı
         doğrulama testi için; asıl veri katmanı Faz 3'te uyarlanacak. -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <!-- PostgreSQL bağlantı testi, sunucu yoksa SESSİZCE ATLANSIN diye (Skip.If). -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <!-- Paket 1 (2026-08-09): API'yi bellek-içi ayağa kaldırıp GERÇEK HTTP hattı üzerinden test etmek için
         (çok-firmalı izolasyon testleri). Kimlik doğrulama + yetkilendirme + model bağlama dahil kapsanır. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- ⚠️ DepoWise.Web BİLİNÇLİ olarak referanslanmaz: web, ortak dosyaların AYNASINI derler
         (ListColumns, ScreenPlatform, MenuNodeView) → referans verilirse mevcut testlerde tür
         çakışması olur. BAG-01'in karar mantığı bu yüzden Application katmanındaki
         BaglantiIzleyici sınıfındadır ve oradan test edilir. -->
    <ProjectReference Include="..\..\src\DepoWise.Api\DepoWise.Api.csproj" />
    <ProjectReference Include="..\..\src\DepoWise.Infrastructure\DepoWise.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\DepoWise.Application\DepoWise.Application.csproj" />
    <ProjectReference Include="..\..\src\DepoWise.Domain\DepoWise.Domain.csproj" />
  </ItemGroup>

</Project>
