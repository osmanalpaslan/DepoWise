<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- ADR-200: WinForms → Avalonia. Karar ÖLÇÜMLE verildi (aynı ekran, aynı yayın koşulları):
         WinForms tek dosya 69 MB / 937 ms · Avalonia tek dosya 45 MB / 2410 ms ·
         Avalonia klasör 201 MB / 968 ms  → Avalonia'nın KENDİSİ yavaş değil (968 ms), fark
         tek-dosya kendi kendini açma maliyeti. Avalonia 24 MB DAHA KÜÇÜK, çünkü WinForms tüm
         Microsoft.WindowsDesktop.App çatısını taşıyor. ReadyToRun denendi ve REDDEDİLDİ
         (59 MB / 5851 ms — hem daha büyük hem daha yavaş).
         Ayrıca: uygulamayla aynı yığın → ortak tasarım dili, gerçek animasyon, tek teknoloji bakımı. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AlpnexSetup</AssemblyName>
    <RootNamespace>DepoWise.Setup</RootNamespace>
    <ApplicationIcon>Assets\app-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Tek dosya self-contained: hedef makinede .NET kurulumu GEREKMEZ. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>

    <!-- Sunucu adresi derleme zamanında gömülür (-p:ServerUrl=... ile değiştirilebilir). -->
    <ServerUrl Condition="'$(ServerUrl)'==''">https://depowise-erp.fly.dev</ServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ServerUrl</_Parameter1>
      <_Parameter2>$(ServerUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Kurulum aracının ORTAK mantığı (checksum kapısı, adres kapısı, sürüm durumu, manifest,
       ön-koşullar, indirme yöneticisi) DepoWise.Application içinde yaşar: aynı dosyaları test
       projesi de derler → mantık TEST EDİLEBİLİR.
       Proje REFERANSI yerine dosya bağlama (Link) kullanılır — web projesinde de kullanılan mevcut
       desendir; tek dosya yayında gereksiz bağımlılık çekilmez. -->
  <ItemGroup>
    <Compile Include="..\DepoWise.Application\Setup\SetupPackageVerifier.cs" Link="Core\SetupPackageVerifier.cs" />
    <Compile Include="..\DepoWise.Application\Setup\SetupUrlPolicy.cs" Link="Core\SetupUrlPolicy.cs" />
    <Compile Include="..\DepoWise.Application\Setup\SetupInstallState.cs" Link="Core\SetupInstallState.cs" />
    <Compile Include="..\DepoWise.Application\Setup\SetupManifest.cs" Link="Core\SetupManifest.cs" />
    <Compile Include="..\DepoWise.Application\Setup\SetupPrerequisites.cs" Link="Core\SetupPrerequisites.cs" />
    <Compile Include="..\DepoWise.Application\Setup\SetupDownloader.cs" Link="Core\SetupDownloader.cs" />
  </ItemGroup>

</Project>
