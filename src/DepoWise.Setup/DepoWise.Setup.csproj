<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AlpnexSetup</AssemblyName>
    <!-- Kurulum aracı exe simgesi (Alpnex logosu) -->
    <ApplicationIcon>Assets\app-logo.ico</ApplicationIcon>
    <!-- Tek dosya self-contained yayınlandığında paketi sıkıştır (boyutu ~%40 küçültür). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Native kütüphaneleri de exe'ye GÖM (yanına DLL çıkmasın): kurulum aracı TEK dosya olarak indirilir/servis
         edilir; yoksa çalışırken eksik native DLL hatası verir (2026-07-26). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- Sunucu adresi (kurulum bu adresten uygulamayı indirir). Yayınlarken -p:ServerUrl=... ile değiştirilebilir. -->
    <ServerUrl Condition="'$(ServerUrl)'==''">https://depowise-erp.fly.dev</ServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ServerUrl</_Parameter1>
      <_Parameter2>$(ServerUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Kurulum aracının ORTAK mantığı (checksum kapısı, adres kapısı, sürüm durumu, manifest,
       ön-koşullar) DepoWise.Application içinde yaşar: aynı dosyaları test projesi de derler
       (ProjectReference üzerinden) → mantık TEST EDİLEBİLİR.
       Proje REFERANSI yerine dosya bağlama (Link) kullanılır — bu, web projesinde de kullanılan
       mevcut desendir; kurulum aracı tek dosya yayınlandığı için gereksiz bağımlılık çekilmez. -->
  <ItemGroup>
    <Compile Include="..\DepoWise.Application\Setup\SetupPackageVerifier.cs" Link="Core\SetupPackageVerifier.cs" />
    <Compile Include="..\DepoWise.Application\Setup\SetupUrlPolicy.cs" Link="Core\SetupUrlPolicy.cs" />
    <Compile Include="..\DepoWise.Application\Setup\SetupInstallState.cs" Link="Core\SetupInstallState.cs" />
    <Compile Include="..\DepoWise.Application\Setup\SetupManifest.cs" Link="Core\SetupManifest.cs" />
    <Compile Include="..\DepoWise.Application\Setup\SetupPrerequisites.cs" Link="Core\SetupPrerequisites.cs" />
  </ItemGroup>

</Project>
