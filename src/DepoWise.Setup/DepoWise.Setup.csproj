<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DepoWiseSetup</AssemblyName>
    <!-- Tek dosya self-contained yayınlandığında paketi sıkıştır (boyutu ~%40 küçültür). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Sunucu adresi (kurulum bu adresten uygulamayı indirir). Yayınlarken -p:ServerUrl=... ile değiştirilebilir. -->
    <ServerUrl Condition="'$(ServerUrl)'==''">https://depowise-erp.fly.dev</ServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ServerUrl</_Parameter1>
      <_Parameter2>$(ServerUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
