<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ SİMGELER — 24×24 vektör, TEK DOSYA ═══
         NuGet simge paketi BİLEREK eklenmedi: kurulum aracı tek dosya self-contained yayınlanıyor;
         6 glif için paket eklemek indirilen boyutu ve lisans yüzeyini gereksiz büyütür.
         Geometriler bu proje için çizilmiştir; üçüncü taraf lisansı taşımaz.
         Renk dışarıdan verilir (Foreground) → aynı simge başarı/hata/nötr olarak kullanılabilir. -->

    <StreamGeometry x:Key="SimgeOnay">M4.5,12.5 L9.5,17.5 L19.5,6.5</StreamGeometry>

    <StreamGeometry x:Key="SimgeCarpi">M6,6 L18,18 M18,6 L6,18</StreamGeometry>

    <!-- Üçgen + ünlem: uyarı/hata -->
    <StreamGeometry x:Key="SimgeUyari">M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,16.6 L12,17.4</StreamGeometry>

    <!-- Aşağı ok + taban: indirme -->
    <StreamGeometry x:Key="SimgeIndir">M12,3 L12,15 M6.5,10 L12,15.5 L17.5,10 M3.5,19.5 L20.5,19.5</StreamGeometry>

    <!-- Kalkan: doğrulama -->
    <StreamGeometry x:Key="SimgeKalkan">M12,2.5 L20,5.5 L20,11.5 C20,16.5 16.5,20 12,21.5 C7.5,20 4,16.5 4,11.5 L4,5.5 Z M8.5,12 L11,14.5 L15.5,9.5</StreamGeometry>

    <StreamGeometry x:Key="SimgeKlasor">M3,6.5 A1.5,1.5 0 0 1 4.5,5 L9.5,5 L11.5,7.5 L19.5,7.5 A1.5,1.5 0 0 1 21,9 L21,18 A1.5,1.5 0 0 1 19.5,19.5 L4.5,19.5 A1.5,1.5 0 0 1 3,18 Z</StreamGeometry>

</ResourceDictionary>
