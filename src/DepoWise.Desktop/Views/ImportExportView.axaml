<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="DepoWise.Desktop.Views.ImportExportView"
             x:DataType="vm:ImportExportViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Excel Merkezi"/>

        <!-- Dışa Aktar -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0">
            <StackPanel Spacing="12">
                <SelectableTextBlock Text="DIŞA AKTAR (EXPORT)" Classes="SectionTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <SelectableTextBlock Text="Kaynak" Classes="Helper" VerticalAlignment="Center"/>
                    <ComboBox Classes="Field" Width="250" ItemsSource="{Binding ExportItems}" SelectedItem="{Binding SelectedExport}"/>
                    <!-- 2026-09-03 (kullanıcı isteği): dışa aktarımda da şube seçilir. Varsayılan = giriş
                         yapılan şube (davranış değişmez). Farklı şube seçilirse ŞİFRE alanı görünür. -->
                    <SelectableTextBlock Text="Şube" Classes="Helper" VerticalAlignment="Center"/>
                    <ComboBox Classes="Field" Width="200" ItemsSource="{Binding ExportBranches}" SelectedItem="{Binding SelectedExportBranch}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImportExportViewModel+BranchOption">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Classes="Field" Width="170" PasswordChar="●" Watermark="Şube şifresi"
                             Text="{Binding ExportBranchPassword}" IsVisible="{Binding ShowExportBranchPassword}"
                             ToolTip.Tip="Giriş yaptığınız şubeden farklı bir şube seçtiniz; o şubenin şifresi gerekir (şifresi olmayan şube serbesttir)."/>
                    <Button Classes="Primary"  Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconExportExcel}"/>
                            <TextBlock Text="Excel'e Aktar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <SelectableTextBlock Text="Seçilen kaynağın güncel verisi Excel (.xlsx) olarak kaydedilir (yalnız yetkili olduğunuz veriler)." Classes="Helper"/>
            </StackPanel>
        </Border>

        <!-- İçe Aktar -->
        <Border Grid.Row="2" Classes="Panel" Margin="0,16,0,0">
            <StackPanel Spacing="12">
                <SelectableTextBlock Text="İÇE AKTAR (IMPORT)" Classes="SectionTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <SelectableTextBlock Text="Ekran" Classes="Helper" VerticalAlignment="Center"/>
                    <ComboBox Classes="Field" Width="220" ItemsSource="{Binding ImportItems}" SelectedItem="{Binding SelectedImport}"/>
                    <SelectableTextBlock Text="Şube (zorunlu)" Classes="Helper" VerticalAlignment="Center"/>
                    <ComboBox Classes="Field" Width="220" ItemsSource="{Binding ImportBranches}" SelectedItem="{Binding SelectedImportBranch}"
                              PlaceholderText="Şube seçin…">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImportExportViewModel+BranchOption">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- 2026-09-03: farklı şubeye aktarımda o şubenin şifresi istenir (girişteki kuralın aynısı). -->
                    <TextBox Classes="Field" Width="170" PasswordChar="●" Watermark="Şube şifresi"
                             Text="{Binding ImportBranchPassword}" IsVisible="{Binding ShowImportBranchPassword}"
                             ToolTip.Tip="Giriş yaptığınız şubeden farklı bir şube seçtiniz; o şubenin şifresi gerekir (şifresi olmayan şube serbesttir)."/>
                    <Button Classes="Secondary"  Command="{Binding DownloadTemplateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconImportExcel}"/>
                            <TextBlock Text="Örnek Excel İndir" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- ⭐ FAZ 4.15: şube şifresi girilip doğrulanmadan buton AKTİF OLMAZ. -->
                    <Button Classes="Primary" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}"
                            ToolTip.Tip="{Binding ImportEngeli}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconImportExcel}"/>
                            <TextBlock Text="Excel'den İçe Aktar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- ⭐ FAZ 4.15: engelin SEBEBİ ekranda yazar (buton neden pasif belli olsun). -->
                <SelectableTextBlock Text="{Binding ImportEngeli}" IsVisible="{Binding HasImportEngeli}"
                                     Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <SelectableTextBlock Text="Önce ŞUBE seçin (zorunlu): kayıtlar bu şubeye yazılır; tüm şubelerde görünmesi için 'Tüm Şubeler' seçin. Sonra 'Örnek Excel İndir' ile şablonu alın, doldurun, içe aktarın. Farklı şubeye aktarımda uyarı çıkar."
                           Classes="Helper" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Sonuç -->
        <Border Grid.Row="3" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ImportResult, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ScrollViewer>
                <SelectableTextBlock Text="{Binding ImportResult}" Classes="Body" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <SelectableTextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
