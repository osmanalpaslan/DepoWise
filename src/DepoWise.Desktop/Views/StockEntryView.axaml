<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:org="using:DepoWise.Infrastructure.Organization"
             xmlns:veh="using:DepoWise.Infrastructure.Vehicles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
             x:Class="DepoWise.Desktop.Views.StockEntryView"
             x:DataType="vm:StockEntryViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Malzeme Giriş-Çıkış">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- Form -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Kayıt Tipi" Width="160">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="{Binding QuantityLabel}" IsRequired="True" Width="140">
                        <NumericUpDown Classes="Field" Value="{Binding Quantity}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Birim Fiyat" Width="140" IsVisible="{Binding ShowPrice}">
                        <NumericUpDown Classes="Field" Value="{Binding UnitPrice}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                    </ctrl:FormField>
                    <!-- İşlem şubesi = login (çalışma) şube — salt-okunur; kullanıcı seçmez (kullanıcı isteği 2026-08-06) -->
                    <ctrl:FormField Label="Şube (Şubeniz)" Width="200" IsVisible="{Binding ShowSingleBranch}">
                        <SelectableTextBlock Classes="Field" Text="{Binding LoginBranchName}" VerticalAlignment="Center"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Kaynak Şube (Şubeniz)" Width="180" IsVisible="{Binding IsTransfer}">
                        <SelectableTextBlock Classes="Field" Text="{Binding LoginBranchName}" VerticalAlignment="Center"/>
                    </ctrl:FormField>
                    <!-- Ortak seçim alanı davranışı (madde 3, kullanıcı isteği 2026-08-06): AsyncPopulator — tıklanınca
                         (arama yapmadan) en fazla 25 kayıt, arama başlayınca sınırsız + Türkçe-doğru (SearchPopulator). -->
                    <ctrl:FormField Label="Hedef Şube" IsRequired="True" Width="180" IsVisible="{Binding IsTransfer}">
                        <AutoCompleteBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}" AsyncPopulator="{Binding BranchPopulator}" SelectedItem="{Binding ToBranch}"
                                          MinimumPrefixLength="0" ValueMemberBinding="{Binding Name}">
                            <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="org:BranchRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                    </ctrl:FormField>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Teslim Eden / Alan (Personel)" Width="240">
                        <AutoCompleteBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Personnel}" AsyncPopulator="{Binding PersonnelPopulator}" SelectedItem="{Binding PersonnelSel}"
                                  MinimumPrefixLength="0" PlaceholderText="Personel ara..." ValueMemberBinding="{Binding Name}">
                            <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Transfer Edilen / Kullanılan Araç" Width="280">
                        <AutoCompleteBox ItemsSource="{Binding Vehicles}" AsyncPopulator="{Binding VehiclePopulator}" SelectedItem="{Binding VehicleSel}"
                                         MinimumPrefixLength="0" PlaceholderText="İç kod / plaka ara..."
                                         ValueMemberBinding="{Binding Display}">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate x:DataType="veh:VehicleListRow"><SelectableTextBlock Text="{Binding Display}"/></DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                    </ctrl:FormField>
                </StackPanel>

                <!-- Malzeme seçimi: Transfer/Depo Çıkışı'nda ZORUNLU; Yeni Kayıt'ta OPSİYONEL (madde 1.1,
                     kullanıcı isteği 2026-08-06) — mevcut malzeme seçilirse aşağıdaki kart alanları kilitlenir. -->
                <ctrl:FormField Label="{Binding MaterialPickerLabel}" IsRequired="{Binding MaterialPickerRequired}" IsVisible="{Binding ShowMaterialPicker}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Classes="Search" Text="{Binding MaterialSearch}" PlaceholderText="Malzeme ara (kod/ad)"/>
                            <SelectableTextBlock Grid.Column="1" Text="{Binding BalanceText}" Classes="Helper" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Seçimi Temizle" Margin="8,0,0,0"
                                    IsVisible="{Binding NewFieldsLocked}" Command="{Binding ClearPickedMaterialCommand}"/>
                        </Grid>
                        <Border Classes="Table" MaxHeight="130" IsVisible="{Binding MaterialResults.Count}">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding MaterialResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:MaterialRefRow">
                                            <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Content="{Binding Name}"
                                                    Command="{Binding $parent[ItemsControl].((vm:StockEntryViewModel)DataContext).PickMaterialCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ctrl:FormField>

                <!-- Yeni Kayıt: malzeme kartı alanları — mevcut malzeme seçildiyse (NewFieldsLocked) Kod/Ad/Tür/
                     Birim/Kategori/Alt Kategori/Marka KİLİTLENİR (madde 1.1); Tedarikçi HER ZAMAN aktif kalır. -->
                <StackPanel Spacing="14" IsVisible="{Binding ShowNewForm}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ctrl:FormField Label="Kod" IsRequired="True" Width="180" IsEnabled="{Binding NewFieldsEnabled}">
                            <TextBox Classes="Field" Text="{Binding Code}"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Ad" IsRequired="True" Width="280" IsEnabled="{Binding NewFieldsEnabled}">
                            <TextBox Classes="Field" Text="{Binding Name}"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Tür" Width="180" IsEnabled="{Binding NewFieldsEnabled}">
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding NewType}"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Birim" IsRequired="True" Width="160" IsEnabled="{Binding NewFieldsEnabled}">
                            <AutoCompleteBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Units}" AsyncPopulator="{Binding UnitPopulator}" SelectedItem="{Binding SelectedUnit}"
                                              MinimumPrefixLength="0" ValueMemberBinding="{Binding Name}">
                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </ctrl:FormField>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ctrl:FormField Label="Kategori" Width="200" IsEnabled="{Binding NewFieldsEnabled}">
                            <AutoCompleteBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" AsyncPopulator="{Binding CategoryPopulator}" SelectedItem="{Binding SelectedCategory}"
                                              MinimumPrefixLength="0" ValueMemberBinding="{Binding Name}">
                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Alt Kategori" Width="200" IsEnabled="{Binding NewFieldsEnabled}">
                            <AutoCompleteBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding SubCategories}" AsyncPopulator="{Binding SubCategoryPopulator}" SelectedItem="{Binding SelectedSubCategory}"
                                              MinimumPrefixLength="0" ValueMemberBinding="{Binding Name}">
                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Marka" Width="200" IsEnabled="{Binding NewFieldsEnabled}">
                            <AutoCompleteBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Brands}" AsyncPopulator="{Binding BrandPopulator}" SelectedItem="{Binding SelectedBrand}"
                                              MinimumPrefixLength="0" ValueMemberBinding="{Binding Name}">
                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </ctrl:FormField>
                        <!-- Tedarikçi (madde 1.1): mevcut malzeme seçilse bile AKTİF kalır — bu girişte farklı
                             tedarikçi seçilirse malzeme kartındaki tedarikçi de güncellenir (kullanıcı kararı). -->
                        <ctrl:FormField Label="Tedarikçi" Width="200">
                            <AutoCompleteBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Suppliers}" AsyncPopulator="{Binding SupplierPopulator}" SelectedItem="{Binding SelectedSupplier}"
                                              MinimumPrefixLength="0" ValueMemberBinding="{Binding Name}">
                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                        </ctrl:FormField>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Fatura / İrsaliye No" Width="200">
                        <TextBox Classes="Field" Text="{Binding InvoiceNo}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Sipariş Fişi No" Width="200">
                        <TextBox Classes="Field" Text="{Binding OrderSlipNo}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Veresiye Fişi No" Width="200">
                        <TextBox Classes="Field" Text="{Binding CreditSlipNo}"/>
                    </ctrl:FormField>
                </StackPanel>
                <ctrl:FormField Label="Açıklama">
                    <TextBox Classes="Field" Text="{Binding Note}" AcceptsReturn="True" Height="44"/>
                </ctrl:FormField>

                <SelectableTextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="Temizle" Command="{Binding ClearFormCommand}"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Son hareketler -->
        <Panel Grid.Row="2" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,*,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="TARİH" MinWidth="120"/>
                            <SelectableTextBlock Grid.Column="1" Text="TİP" MinWidth="80"/>
                            <SelectableTextBlock Grid.Column="2" Text="MALZEME" MinWidth="160"/>
                            <SelectableTextBlock Grid.Column="3" Text="YÖN" MinWidth="60"/>
                            <SelectableTextBlock Grid.Column="4" Text="MİKTAR" MinWidth="100"/>
                            <SelectableTextBlock Grid.Column="5" Text="B.FİYAT" MinWidth="80"/>
                            <SelectableTextBlock Grid.Column="6" Text="AÇIKLAMA" MinWidth="120"/>
                            <SelectableTextBlock Grid.Column="7" Text="" MinWidth="80"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Movements}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:StockMovementRow">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,*,Auto">
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding DateText}" MinWidth="120" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding TypeText}" MinWidth="80" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding Name}" MinWidth="160" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding DirectionText}" MinWidth="60" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="4" Text="{Binding QtyText}" MinWidth="100" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Grid.Column="5" Text="{Binding PriceText}" MinWidth="80" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="6" Text="{Binding NoteText}" MinWidth="120" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Column="7" MinWidth="80" VerticalAlignment="Center">
                                        <Button Classes="Ghost" Content="İptal" IsVisible="{Binding CanReverse}"
                                                Command="{Binding $parent[ItemsControl].((vm:StockEntryViewModel)DataContext).ReverseMovementCommand}"
                                                CommandParameter="{Binding}"/>
                                        <SelectableTextBlock Text="{Binding StatusText}" Classes="Helper" IsVisible="{Binding IsReversed}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Hareket yok" Message="Henüz stok hareketi yok." IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
