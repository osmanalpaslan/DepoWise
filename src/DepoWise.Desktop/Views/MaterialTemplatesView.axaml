<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
             x:Class="DepoWise.Desktop.Views.MaterialTemplatesView"
             x:DataType="vm:MaterialTemplatesViewModel">

    <!-- Malzeme Şablonları (2026-08-08): şablon oluştur/düzenle/sil. Şablon SEÇİMİ Malzemeler formundadır.
         Yapı, Araç Genel Tanım (VehicleTemplatesView) ekranıyla aynı desendedir. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <ctrl:Toolbar Grid.Row="0" Title="Malzeme Şablonları"
                      SearchText="{Binding Search, Mode=TwoWay}" SearchWatermark="Şablon ara (ad/kod)..."
                      PrimaryActionText="{Binding AddButtonText}" PrimaryActionCommand="{Binding ToggleAddCommand}">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Ara" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- Yeni / düzenlenen şablon formu -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}"/>
                <KeyBinding Gesture="Escape" Command="{Binding ClearCommand}"/>
            </Border.KeyBindings>
            <ScrollViewer MaxHeight="420">
            <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
                <SelectableTextBlock Text="{Binding FormTitle}" Classes="SectionTitle"/>

                <SelectableTextBlock Text="Tanım" Classes="CardLabel"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Şablon Adı" IsRequired="True" Width="260"
                                    HasError="{Binding HasNameError}" ErrorText="{Binding NameError}">
                        <TextBox Classes="Field" Text="{Binding NewName}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Örnek Kod" Width="160" HelpText="Malzeme formuna ön-dolgu olarak gelir">
                        <TextBox Classes="Field" Text="{Binding NewCode}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Tür" Width="170">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding NewType}"/>
                    </ctrl:FormField>
                </StackPanel>

                <SelectableTextBlock Text="Sınıflandırma" Classes="CardLabel"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Kategori" Width="220">
                        <ctrl:LookupBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Categories}" SelectedItem="{Binding SelCategory}"
                                  PlaceholderText="Kategori seç / ara..."/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Birim" Width="200">
                        <ctrl:LookupBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Units}" SelectedItem="{Binding SelUnit}"
                                  PlaceholderText="Birim seç / ara..."/>
                    </ctrl:FormField>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Marka" Width="220">
                        <ctrl:LookupBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Brands}" SelectedItem="{Binding SelBrand}"
                                  PlaceholderText="Marka seç / ara..."/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Tedarikçi" Width="220">
                        <ctrl:LookupBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelSupplier}"
                                  PlaceholderText="Tedarikçi seç / ara..."/>
                    </ctrl:FormField>
                </StackPanel>

                <SelectableTextBlock Text="Stok / Fiyat" Classes="CardLabel"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Min. Stok" Width="150">
                        <NumericUpDown Classes="Field" Value="{Binding NewMinStock}" Minimum="0"
                                       FormatString="0.##" ShowButtonSpinner="False"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Birim Fiyat" Width="150">
                        <NumericUpDown Classes="Field" Value="{Binding NewUnitPrice}" Minimum="0"
                                       FormatString="0.##" ShowButtonSpinner="False"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Para Birimi" Width="130">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding NewCurrency}"/>
                    </ctrl:FormField>
                </StackPanel>

                <ctrl:FormField Label="Açıklama" Width="480">
                    <TextBox Classes="Field" Text="{Binding NewDescription}" AcceptsReturn="True" MaxHeight="90"/>
                </ctrl:FormField>

                <!-- B-4 (PRT-01 Grup 2b): Uyumlu Araçlar — web'de (MaterialTemplates.razor) zaten yönetiliyordu,
                     masaüstünde yalnız korunuyordu. Malzemeler ekranındaki VehiclePick deseninin aynısı. -->
                <ctrl:FormField Label="Uyumlu Araçlar" Width="480"
                                HelpText="Bu şablondan oluşacak malzemenin takıldığı araçlar (çoklu seçim).">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Classes="Search" Text="{Binding VehicleSearch}" PlaceholderText="Araç ara (kod/plaka)"/>
                            <Button Grid.Column="1" Classes="Secondary" Content="Tümünü Seç" Margin="8,0,0,0" Command="{Binding SelectAllVehiclesCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Temizle" Margin="6,0,0,0" Command="{Binding ClearVehiclesCommand}"/>
                        </Grid>
                        <Border Classes="Table" MaxHeight="160">
                            <ListBox ItemsSource="{Binding FilteredVehiclePicks}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VehiclePick">
                                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Display}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </ctrl:FormField>

                <!-- B-5 (PRT-01 Grup 2b): Şablon fotoğrafları — web'de zaten vardı, masaüstüne eklendi.
                     Aynı FileService/Storage altyapısı ve AYNI varlık adı ("material_template") kullanılır. -->
                <SelectableTextBlock Text="Fotoğraflar" Classes="CardLabel"/>
                <StackPanel Spacing="8">
                    <Button Classes="Secondary" Content="Foto Ekle" HorizontalAlignment="Left"
                            Command="{Binding AddPhotosCommand}"/>

                    <!-- Kaydedilmeyi bekleyenler -->
                    <ItemsControl ItemsSource="{Binding Photos}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhotoStage">
                                <Border Margin="0,0,8,8" Width="84" Height="84" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource SurfaceElevatedBrush}">
                                    <Panel>
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                        <Button Classes="Icon" Content="×" Width="24" Height="24"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Command="{Binding $parent[ItemsControl].((vm:MaterialTemplatesViewModel)DataContext).RemovePhotoCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Kayıtlı fotoğraflar (yalnız düzenlemede dolar) -->
                    <ItemsControl ItemsSource="{Binding DetailPhotos}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetailPhoto">
                                <Border Margin="0,0,8,8" Width="84" Height="84" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource SurfaceElevatedBrush}">
                                    <Panel>
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                        <Button Classes="Icon" Content="×" Width="24" Height="24"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Command="{Binding $parent[ItemsControl].((vm:MaterialTemplatesViewModel)DataContext).DeleteDetailPhotoCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding AddCommand}"/>
                    <Button Classes="Ghost" Content="Vazgeç" Command="{Binding ClearCommand}"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Şablon listesi -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <Panel Grid.Column="0">
                <Border Classes="Table" IsVisible="{Binding HasRows}">
                    <ScrollViewer>
                        <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:MaterialTemplateRow">
                                    <Grid ColumnDefinitions="140,*,120,160">
                                        <SelectableTextBlock Grid.Column="0" Text="{Binding CodeDisplay}" VerticalAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                             FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <SelectableTextBlock Grid.Column="2" Text="{Binding UnitName}" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <SelectableTextBlock Grid.Column="3" Text="{Binding ScopeText}" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <ctrl:StatePanel Mode="Empty" Title="Şablon yok"
                                 Message="Henüz malzeme şablonu oluşturulmadı. Sağ üstteki “Yeni Şablon” ile ekleyebilirsiniz."
                                 IsVisible="{Binding IsEmpty}"/>
                <ctrl:StatePanel Mode="Error" Title="Şablonlar yüklenemedi" Message="{Binding LoadError}"
                                 IsVisible="{Binding HasError}"/>
            </Panel>

            <!-- Seçili şablon işlemleri -->
            <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" Width="240" IsVisible="{Binding HasSelection}"
                    VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <SelectableTextBlock Text="Seçili Şablon" Classes="SectionTitle"/>
                    <SelectableTextBlock Text="{Binding Selected.Name}" Classes="Body" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <SelectableTextBlock Text="{Binding Selected.ScopeText}" Classes="Helper"
                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Classes="Secondary" HorizontalAlignment="Stretch" Content="Düzenle" Command="{Binding BeginEditCommand}"/>
                    <Button Classes="Ghost" HorizontalAlignment="Stretch" Content="Sil" Command="{Binding RequestDeleteCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <SelectableTextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0"
                             Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
