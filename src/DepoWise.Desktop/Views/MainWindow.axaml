<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DepoWise.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="DepoWise.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/app-logo.ico"
        MinWidth="900" MinHeight="560"
        Width="1180" Height="720"
        Background="{DynamicResource Brand.Surface.Brush}"
        Title="{Binding AppName}">

    <Grid ColumnDefinitions="250,*">

        <!-- ===== Sol koyu menü ===== -->
        <Border Grid.Column="0" Background="{DynamicResource Brand.Primary.Brush}"
                BorderBrush="{DynamicResource Brand.Border.Brush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="18,20,18,16">
                    <Image Source="/Assets/logo.png" Width="172" HorizontalAlignment="Left"
                           Stretch="Uniform"/>
                </Border>

                <!-- Alt: kullanıcı -->
                <Border DockPanel.Dock="Bottom" Padding="16,12" Background="{DynamicResource Brand.Hover.Brush}">
                    <TextBlock Text="{Binding DisplayName, StringFormat='👤 {0}'}" FontSize="12"
                               Foreground="{DynamicResource Brand.OnPrimary.Brush}" Opacity="0.9"/>
                </Border>

                <!-- Menü -->
                <ScrollViewer>
                    <StackPanel Margin="10,4">
                        <Button Content="🏠   Genel" Classes="NavTop" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Foreground="{DynamicResource Brand.OnPrimary.Brush}"
                                Command="{Binding GoDashboardCommand}"/>

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavGroupVm">
                                    <StackPanel Margin="0,2">
                                        <ToggleButton Classes="NavGroup" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      Foreground="{DynamicResource Brand.OnPrimary.Brush}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Classes="chev" Text="›" FontSize="16"
                                                           Opacity="0.6" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ToggleButton>
                                        <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}"
                                                      Margin="14,2,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NavLink">
                                                    <Button Content="{Binding Title}" Classes="NavLink"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Foreground="{DynamicResource Brand.OnPrimary.Brush}"
                                                            Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).NavigateCommand}"
                                                            CommandParameter="{Binding Key}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Sağ içerik (koyu) ===== -->
        <DockPanel Grid.Column="1" Background="{DynamicResource Brand.Surface.Brush}">
            <!-- Üst bar -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Brand.Primary.Brush}"
                    BorderBrush="{DynamicResource Brand.Border.Brush}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTitle}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brand.OnPrimary.Brush}"/>
                        <TextBlock Text="{Binding Welcome}" FontSize="11" Opacity="0.55"
                                   Foreground="{DynamicResource Brand.OnPrimary.Brush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔄  Eşitle" VerticalAlignment="Center"
                            Background="{DynamicResource Brand.Accent.Brush}" Foreground="White"
                            CornerRadius="{DynamicResource Brand.CornerRadius}" Padding="16,9" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- İçerik -->
            <ContentControl Content="{Binding CurrentPage}"/>
        </DockPanel>
    </Grid>
</Window>
