<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DepoWise.Desktop.ViewModels"
        xmlns:local="using:DepoWise.Desktop"
        xmlns:a11y="using:Avalonia.Automation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
        x:Class="DepoWise.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/app-logo.ico"
        MinWidth="900" MinHeight="560"
        Width="1180" Height="720"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{Binding AppName}">

    <Grid ColumnDefinitions="56,Auto,*">

        <!-- ===== İkon rayı (48–56px) ===== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Marka ikonu (daraltılmış çubuk) — şeffaf, arka plan yok -->
                <Border DockPanel.Dock="Top" Height="60" Padding="0">
                    <Image Source="/Assets/app-icon-256.png" Width="32" Height="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- Kullanıcı avatarı (alt) -->
                <Border DockPanel.Dock="Bottom" Height="56">
                    <Border Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"
                            ToolTip.Tip="{Binding DisplayName}">
                        <SelectableTextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Border>
                <!-- Modül ikonları -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="2" Margin="0,6">
                        <Button Classes="NavRail" ToolTip.Tip="Ana Ekran" a11y:AutomationProperties.Name="Ana Ekran"
                                Command="{Binding GoDashboardCommand}" Content="🏠"/>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavGroupVm">
                                    <Button Classes="NavRail" Classes.active="{Binding IsActive}"
                                            ToolTip.Tip="{Binding Title}" a11y:AutomationProperties.Name="{Binding Title}"
                                            Content="{Binding Icon}"
                                            Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).SelectGroupCommand}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Açıklamalı menü paneli (190–220px, daraltılabilir) ===== -->
        <Border Grid.Column="1" Width="210" IsVisible="{Binding IsNavPanelOpen}"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo (açık kenar çubuğu) — şeffaf, arka plan yok. Sembol + marka yazısı. -->
                <Border DockPanel.Dock="Top" Height="60" Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Source="/Assets/app-icon-256.png" Width="32" Height="32" VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="DepoWise" Classes="SectionTitle" VerticalAlignment="Center"
                                             Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                    </StackPanel>
                </Border>
                <!-- Kullanıcı -->
                <Border DockPanel.Dock="Bottom" Height="56" Padding="16,0"
                        Background="{DynamicResource SurfaceElevatedBrush}">
                    <SelectableTextBlock Text="{Binding DisplayName}" Classes="Body" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
                <!-- Menü arama -->
                <Border DockPanel.Dock="Top" Padding="10,6">
                    <TextBox Text="{Binding MenuSearch}" Watermark="🔍 Ekran ara..." Classes="Field"/>
                </Border>
                <ScrollViewer>
                    <StackPanel Margin="8,6">
                        <!-- Arama sonuçları (düz liste; tıkla → aç) -->
                        <ItemsControl ItemsSource="{Binding MenuSearchResults}" IsVisible="{Binding IsSearchingMenu}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MenuSearchItem">
                                    <Button Content="{Binding Display}" Classes="NavLink"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding Key}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Ana Ekran" Classes="NavTop" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" IsVisible="{Binding !IsSearchingMenu}"
                                Command="{Binding GoDashboardCommand}"/>

                        <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding !IsSearchingMenu}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavGroupVm">
                                    <StackPanel Margin="0,2">
                                        <ToggleButton Classes="NavGroup" Classes.active="{Binding IsActive}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <SelectableTextBlock Grid.Column="0" Text="{Binding Title}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <SelectableTextBlock Grid.Column="1" Classes="chev" Text="›" FontSize="16"
                                                           Opacity="0.6" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ToggleButton>
                                        <!-- Alt-liste: açılışta yumuşak beliriş (opacity geçişi; Classes=NavChildren) -->
                                        <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}"
                                                      Classes="NavChildren"
                                                      Opacity="{Binding IsExpanded, Converter={x:Static local:Conv.BoolToOpacity}}"
                                                      Margin="10,2,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NavLinkVm">
                                                    <Button Content="{Binding Title}" Classes="NavLink"
                                                            Classes.active="{Binding IsActive}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NavigateCommand}"
                                                            CommandParameter="{Binding Key}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Sağ içerik ===== -->
        <DockPanel Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}">
            <!-- Üst bar (56–64px) -->
            <Border DockPanel.Dock="Top" Height="60" Background="{DynamicResource TopBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,0"
                    BoxShadow="0 3 18 0 #2A000000" ZIndex="1">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- Panel daralt/genişlet -->
                    <Button Grid.Column="0" Classes="IconGhost" Content="☰" FontSize="16"
                            VerticalAlignment="Center" ToolTip.Tip="Menüyü daralt/genişlet"
                            a11y:AutomationProperties.Name="Menüyü daralt veya genişlet"
                            Command="{Binding ToggleNavPanelCommand}"/>
                    <!-- Başlık + bağlam -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                        <SelectableTextBlock Text="{Binding CurrentTitle}" Classes="PageTitle"
                                   TextTrimming="CharacterEllipsis"/>
                        <SelectableTextBlock Text="{Binding CurrentContext}" Classes="Helper"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- Eşitle (mevcut yer tutucu; gerçek sync komutu ilgili fazda bağlanacak) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- Sunucu bağlantı durumu -->
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="10,4"
                                VerticalAlignment="Center" ToolTip.Tip="Sunucu bağlantı durumu">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center"/>
                                <SelectableTextBlock Text="{Binding ConnectionText}" Classes="Helper" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Classes="Secondary" Content="🟢 Basit Ekran Bilgisi" Command="{Binding ShowSimpleScreenInfoCommand}"
                                IsVisible="{Binding IsSuperAdmin}"
                                ToolTip.Tip="Yalnız ekran adı + alan adları (kolay tarif için)"/>
                        <Button Classes="Secondary" Content="ⓘ Ekran Bilgisi" Command="{Binding ShowScreenInfoCommand}"
                                IsVisible="{Binding IsSuperAdmin}"
                                ToolTip.Tip="Bu ekranın gerçek kodunu göster (kopyalanabilir)"/>
                        <ProgressBar Width="90" Height="6" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                     Value="{Binding SyncProgress}" IsVisible="{Binding IsSyncing}"/>
                        <SelectableTextBlock Text="{Binding SyncProgress, StringFormat='%{0}'}" Classes="Helper"
                                   VerticalAlignment="Center" IsVisible="{Binding IsSyncing}"/>
                        <Button Classes="Primary" Content="Eşitle" Command="{Binding SyncCommand}"
                                IsEnabled="{Binding !IsSyncing}"
                                ToolTip.Tip="Sunucudaki tanımları bu makineye çeker"/>
                    </StackPanel>
                    <!-- Kullanıcı -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Spacing="3" Margin="0,0,6,0">
                            <SelectableTextBlock Text="{Binding BuildStamp}" Classes="Helper" ToolTip.Tip="Çalışan derleme zamanı"/>
                            <SelectableTextBlock Text="{Binding Version}" Classes="Helper" FontWeight="SemiBold"
                                       ToolTip.Tip="Kurulu uygulama sürümü"/>
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding DisplayName}" Classes="Body" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}">
                            <SelectableTextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Classes="Secondary" Content="Çıkış" Command="{Binding LogoutCommand}"
                                ToolTip.Tip="Çıkış yap (giriş ekranına dön)"
                                a11y:AutomationProperties.Name="Çıkış yap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- İçerik (modül ekranı; ViewLocator VM->View) -->
            <ContentControl Content="{Binding CurrentPage}"/>
        </DockPanel>
    </Grid>
</Window>
