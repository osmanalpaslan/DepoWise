<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DepoWise.Desktop.ViewModels"
        xmlns:ui="using:DepoWise.Application.Ui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="DepoWise.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        MinWidth="640" MinHeight="420"
        Width="900" Height="560"
        Title="{Binding AppName}">

    <!-- Renkler ekrana SABİT yazılmaz; merkezi tema "Brand.*" DynamicResource'larından gelir. -->
    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource Brand.Surface.Brush}">

        <!-- Sol menü (yetkiye göre MenuBuilder) -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                Background="{DynamicResource Brand.Primary.Brush}">
            <DockPanel Margin="0,16">
                <TextBlock DockPanel.Dock="Top" Text="{Binding AppName}"
                           Foreground="{DynamicResource Brand.OnPrimary.Brush}"
                           FontSize="20" FontWeight="Bold" Margin="16,0,16,4"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding CompanyName}"
                           Foreground="{DynamicResource Brand.OnPrimary.Brush}"
                           Opacity="0.8" Margin="16,0,16,12"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding UserName, StringFormat='Kullanıcı: {0}'}"
                           Foreground="{DynamicResource Brand.OnPrimary.Brush}" Opacity="0.7"
                           Margin="16,12,16,0" FontSize="11"/>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:MenuItem">
                                <Button Content="{Binding Label}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Foreground="{DynamicResource Brand.OnPrimary.Brush}"
                                        Padding="16,10" Margin="8,1"
                                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).NavigateCommand}"
                                        CommandParameter="{Binding Key}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Üst başlık şeridi -->
        <Border Grid.Row="0" Grid.Column="1" Padding="20,12"
                Background="{DynamicResource Brand.Surface.Brush}">
            <TextBlock Text="{Binding CurrentTitle}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
        </Border>

        <!-- İçerik (seçili modül ekranı; ViewLocator VM->View çözer) -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}"/>

        <Border Grid.Row="2" Grid.Column="1" Padding="12"
                Background="{DynamicResource Brand.Surface.Brush}">
            <TextBlock Text="{Binding CompanyName}" Opacity="0.6"
                       Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
        </Border>
    </Grid>
</Window>
