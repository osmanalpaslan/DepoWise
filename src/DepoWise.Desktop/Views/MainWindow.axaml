<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DepoWise.Desktop.ViewModels"
        xmlns:search="using:DepoWise.Infrastructure.Search"
        xmlns:ctrl="using:DepoWise.Desktop.Controls"
        xmlns:local="using:DepoWise.Desktop"
        xmlns:a11y="using:Avalonia.Automation"
        xmlns:chat="using:DepoWise.Infrastructure.Chat"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
        x:Class="DepoWise.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/app-logo.ico"
        MinWidth="980" MinHeight="560"
        Width="1180" Height="720"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{Binding AppName}">
        <!-- ⭐ ASGARİ GENİŞLİK — ÖLÇÜMLE BULUNDU (görsel QA 2026-09-06).
             ÖNCE: MinWidth 900'dü ve üst bar o genişliğe SIĞMIYORDU. UI Automation ölçümü: 934 px'te
             kullanıcı düğmesi pencerenin 177 px DIŞINDA, yani hesap menüsüne/çıkışa TIKLANAMIYORDU.
             Üst bar 60 px sabit yükseklikte TEK SATIRLIK Grid'dir (Auto,*,8×Auto) ve sarılamaz.

             İLK ÇÖZÜM YETERSİZDİ: sınırı 1150/1180'e çekmek taşmayı bitiriyordu ama %125 Windows
             ölçeklemesi kullanan 1366 px'lik bir dizüstünde mantıksal genişlik 1092 px'e düşer —
             1180'lik bir pencere O EKRANA SIĞMAZDI. Yani sınırı yükseltmek sorunu başka kullanıcıya
             taşıyordu.

             ŞİMDİKİ ÇÖZÜM: üst bar UYARLANABİLİR (GenislikEsikConverter). Pencere daraldıkça sırayla
             global arama kutusu (1300 altı · 178 px), kullanıcı adı (1200 altı · 148 px) ve "Ekran"
             etiketi (1120 altı · 45 px) gizlenir; işlevlerin hiçbiri kaybolmaz (menü araması, baş harf
             dairesi, ikon yerinde kalır). Böylece asgari genişlik ölçümle 980'e indi.

             DOĞRULAMA (UI Automation, 53 ekran × 5 genişlik): 1920 · 1366 · 1180 · 1100 · 980 —
             tıklanamaz/kırpık öğe SIFIR. 980, 1366@%125 (1092) ve 1280@%125 (1024) senaryolarının
             ikisinin de altındadır. -->

    <!-- İkon rayı 2026-08-19'da KALDIRILDI (kullanıcı isteği): dikey şerit yer kaplıyordu ve
         taşıdığı her şeyin karşılığı menü panelinde zaten var (Ana Ekran · gruplar · kullanıcı).
         Menü panelini gizleyip geri açan üst bardaki düğme YERİNDE — menüsüz kalma durumu yok. -->
    <Grid ColumnDefinitions="Auto,*">

        <!-- ===== Açıklamalı menü paneli (190–220px, daraltılabilir) ===== -->
        <Border Grid.Column="0" Width="210" IsVisible="{Binding IsNavPanelOpen}"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource AmberBarEdgeBrush}" BorderThickness="0,0,1,0">
            <!-- Kehribar yarı şeffaf katman (menü paneli) -->
            <Border Background="{DynamicResource AmberSideOverlayBrush}">
            <DockPanel>
                <!-- Logo (açık kenar çubuğu) — şeffaf, arka plan yok. Sembol + marka yazısı. -->
                <Border DockPanel.Dock="Top" Height="60" Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Source="/Assets/app-icon-256.png" Width="34" Height="34" VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="Alpnex" Classes="SectionTitle" VerticalAlignment="Center"
                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <!-- Kullanıcı -->
                <Border DockPanel.Dock="Bottom" Height="56" Padding="16,0"
                        Background="{DynamicResource SurfaceElevatedBrush}">
                    <SelectableTextBlock Text="{Binding DisplayName}" Classes="Body" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
                <!-- Menü arama -->
                <Border DockPanel.Dock="Top" Padding="10,6">
                    <TextBox x:Name="MenuAramaKutusu" Text="{Binding MenuSearch}"
                             Watermark="Ekran ara…" Classes="Search"/>
                </Border>
                <ScrollViewer>
                    <StackPanel Margin="8,6">
                        <!-- Arama sonuçları (düz liste; tıkla → aç) -->
                        <ItemsControl ItemsSource="{Binding MenuSearchResults}" IsVisible="{Binding IsSearchingMenu}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MenuSearchItem">
                                    <Button Content="{Binding Display}" Classes="NavLink"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding Key}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Ana Ekran" Classes="NavTop" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" IsVisible="{Binding !IsSearchingMenu}"
                                Command="{Binding GoDashboardCommand}"/>

                        <!-- SEC (2026-08-19): menü ÜÇ seviyeli olabilir — ÜST GRUP → ÜST MENÜ → EKRAN.
                             Dış ItemsControl "Sections" üzerinde döner. Üst grup tanımlı DEĞİLSE her düğüm
                             tek üst menü taşır, başlık gizlenir ve alt liste daima görünür → menü bugünkü
                             hâliyle BİREBİR aynı çizilir. İçteki grup şablonu ve ikon rayı DEĞİŞTİRİLMEDİ. -->
                        <ItemsControl ItemsSource="{Binding Sections}" IsVisible="{Binding !IsSearchingMenu}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavSectionVm">
                                    <StackPanel Margin="0,2">
                                        <!-- Üst grup başlığı — yalnız gerçek bir üst grupta görünür -->
                                        <ToggleButton Classes="NavGroup" IsVisible="{Binding IsSection}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                <!-- ⭐ FAZ 2 (ADR-221): ÜST GRUP renk çubuğu — hiyerarşinin EN GÜÇLÜ tonu
                                                     (3px, tam opaklık). Alt seviyeler aynı aileyi giderek inceltir:
                                                     üst grup 3px → üst menü 2px/0.85 → ekran 2px/0.55.
                                                     Renk TEK BAŞINA anlam taşımaz; ikon ve girinti de aynı bilgiyi verir. -->
                                                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,1,10,1"
                                                        Background="{Binding FamilyBrush}" IsVisible="{Binding HasFamily}"/>
                                                <!-- M6: üst grup ikonu. Alt gruplarınkinden farklı geometri (hiyerarşi okunsun). -->
                                                <PathIcon Grid.Column="1" Width="16" Height="16" Margin="0,0,10,0"
                                                          VerticalAlignment="Center"
                                                          Data="{Binding IconGeometry}" IsVisible="{Binding HasIcon}"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <SelectableTextBlock Grid.Column="2" Text="{Binding Title}"
                                                           FontWeight="Bold" VerticalAlignment="Center" FontSize="12" LetterSpacing="0.6"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <SelectableTextBlock Grid.Column="3" Classes="chev" Text="›" FontSize="16"
                                                           Opacity="0.6" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ToggleButton>

                                        <ItemsControl ItemsSource="{Binding Groups}"
                                                      IsVisible="{Binding ChildrenVisible}"
                                                      Margin="{Binding ChildIndent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavGroupVm">
                                    <StackPanel Margin="0,2">
                                        <ToggleButton Classes="NavGroup" Classes.active="{Binding IsActive}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                <!-- ⭐ FAZ 2 (ADR-221): ÜST MENÜ renk çubuğu — üst grubun ailesini MİRAS alır,
                                                     ondan bir kademe yumuşaktır (2px, 0.85 opaklık). -->
                                                <Border Grid.Column="0" Width="2" CornerRadius="1" Margin="0,2,10,2"
                                                        Background="{Binding FamilyBrush}" IsVisible="{Binding HasFamily}"
                                                        Opacity="0.85"/>
                                                <!-- M6: vektör grup ikonu. Kaynak bulunamazsa HasIcon=false → sütun boş kalır, çökme yok.
                                                     Panel genişliği değişmez: 16px ikon + 10px boşluk, başlık sütunu "*" olduğu için kısalır. -->
                                                <PathIcon Grid.Column="1" Width="16" Height="16" Margin="0,0,10,0"
                                                          VerticalAlignment="Center"
                                                          Data="{Binding IconGeometry}" IsVisible="{Binding HasIcon}"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <!-- Menü metni VARYANT-DUYARLI (TextPrimaryBrush): açık modda koyu,
                                                     koyu modda açık. Kenar menü zemini de varyantla değişir (açık
                                                     modda beyaz), sabit renk açık modda görünmez oluyordu (2026-07-19). -->
                                                <SelectableTextBlock Grid.Column="2" Text="{Binding Title}"
                                                           FontWeight="Bold" VerticalAlignment="Center" FontSize="12" LetterSpacing="0.6"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <SelectableTextBlock Grid.Column="3" Classes="chev" Text="›" FontSize="16"
                                                           Opacity="0.6" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ToggleButton>
                                        <!-- Alt-liste: açılışta yumuşak beliriş (opacity geçişi; Classes=NavChildren) -->
                                        <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}"
                                                      Classes="NavChildren"
                                                      Opacity="{Binding IsExpanded, Converter={x:Static local:Conv.BoolToOpacity}}"
                                                      Margin="10,2,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NavLinkVm">
                                                    <!-- ⭐ MNU-IKON (kullanıcı isteği 2026-09-05): alt menülerde İKON.
                                                         Eskiden bu şablon yalnız metin taşıyordu; alt menülerin hiçbirinde
                                                         ikon yoktu. Grup satırlarıyla AYNI ölçüler (14px ikon + 8px boşluk,
                                                         metin sütunu "*") → hizalama bozulmaz, panel genişliği değişmez.
                                                         Kaynak yoksa HasIcon=false → sütun boş kalır, çökme yok. -->
                                                    <Button Classes="NavLink"
                                                            Classes.active="{Binding IsActive}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NavigateCommand}"
                                                            CommandParameter="{Binding Key}">
                                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                                            <!-- ⭐ FAZ 2 (ADR-221): EKRAN renk çubuğu — hiyerarşinin EN YUMUŞAK tonu
                                                                 (2px, 0.55 opaklık). Ekranın kendi rengi yoktur; üst menüsünün
                                                                 ailesini miras alır. Üç kademe birlikte "üst grup > üst menü >
                                                                 ekran" derinliğini renkle de anlatır. -->
                                                            <Border Grid.Column="0" Width="2" CornerRadius="1" Margin="0,3,8,3"
                                                                    Background="{Binding FamilyBrush}" IsVisible="{Binding HasFamily}"
                                                                    Opacity="0.55"/>
                                                            <PathIcon Grid.Column="1" Width="14" Height="14" Margin="0,0,8,0"
                                                                      VerticalAlignment="Center"
                                                                      Data="{Binding IconGeometry}" IsVisible="{Binding HasIcon}"
                                                                      Opacity="0.75"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            </Border>
        </Border>

        <!-- ===== Sağ içerik ===== -->
        <DockPanel Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
            <!-- Üst bar (56–64px) — kehribar yarı şeffaf katman -->
            <Border DockPanel.Dock="Top" Height="60" Background="{DynamicResource TopBarBackgroundBrush}"
                    BorderBrush="{DynamicResource AmberBarEdgeBrush}" BorderThickness="0,0,0,1"
                    BoxShadow="0 3 18 0 #2A000000" ZIndex="1">
                <Border Background="{DynamicResource AmberBarOverlayBrush}" Padding="16,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                    <!-- 1) Menü daralt/genişlet -->
                    <Button Grid.Column="0" Classes="IconGhost" VerticalAlignment="Center"
                            ToolTip.Tip="Menüyü daralt/genişlet"
                            a11y:AutomationProperties.Name="Menüyü daralt veya genişlet"
                            Command="{Binding ToggleNavPanelCommand}">
                        <PathIcon Width="17" Height="17" Data="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z"/>
                    </Button>

                    <!-- 2) Başlık + bağlam. MinWidth sayesinde pencere daralınca
                            başlık tamamen kaybolmaz, kısalarak kalır.
                         ⭐ DÜZELTME (görsel QA 2026-09-06): burası dikey StackPanel'di. Dikey StackPanel
                            çocuklarını, kendisine verilen daraltılmış genişliğe SIKIŞTIRMAZ; metin tam
                            genişlikte çizilir ve ClipToBounds onu HAM keser. Sonuç: 1150 px'te başlık
                            "Maliye" diye ortadan kesiliyor, üç nokta (…) hiç görünmüyor ve firma kutusuna
                            yapışıyordu. Grid çocuğu düzenlenen genişliğe kırpar → TextTrimming gerçekten
                            çalışır ve "Maliyet Me…" gibi okunur bir kısaltma çıkar. Sağa 14 px boşluk
                            eklendi ki başlık firma kutusuna yaslanmasın. Geniş pencerede görünüm aynıdır. -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center"
                          Margin="10,0,14,0" MinWidth="90" ClipToBounds="True">
                        <SelectableTextBlock Grid.Row="0" Text="{Binding CurrentTitle}" Classes="PageTitle"
                                             TextTrimming="CharacterEllipsis"/>
                        <SelectableTextBlock Grid.Row="1" Text="{Binding CurrentContext}" Classes="Helper"
                                             TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- 3) BAĞLAM: firma + şube tek kutuda -->
                    <Border Grid.Column="2" Height="36" Padding="12,0" CornerRadius="10"
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            ToolTip.Tip="{Binding ActiveCompanyTip}">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <PathIcon Width="15" Height="15" Foreground="{DynamicResource TextMutedBrush}"
                                      Data="M12 2 4 5.5v6c0 4.6 3.2 8.6 8 9.9 4.8-1.3 8-5.3 8-9.9v-6L12 2Z"/>
                            <StackPanel VerticalAlignment="Center">
                                <SelectableTextBlock Text="{Binding ActiveCompanyName}" Classes="Body"
                                                     FontSize="12" FontWeight="SemiBold"
                                                     MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <SelectableTextBlock Text="{Binding ActiveBranchName}" Classes="Helper"
                                                         MaxWidth="130" TextTrimming="CharacterEllipsis"
                                                         ToolTip.Tip="{Binding ActiveBranchTip}"/>
                                    <!-- "Tüm Şubeler" modunda uyarı işareti (mevcut davranış) -->
                                    <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                                              Foreground="{DynamicResource WarningBrush}"
                                              Data="{DynamicResource IconWarning}"
                                              IsVisible="{Binding IsAllBranches}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4) DURUM: bağlantı + senkron tek kutuda, tıklanınca durum paneli -->
                    <Button Grid.Column="3" Classes="Ghost" Height="36" Padding="12,0"
                            CornerRadius="10" VerticalAlignment="Center" Margin="0,0,8,0"
                            Command="{Binding ShowSyncStatusCommand}"
                            ToolTip.Tip="Senkron durumu: son gönderim/çekme zamanı, bekleyen ve gönderilemeyen kayıtlar">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center"/>

                            <!-- ⭐ FAZ 4.12 (kullanıcı isteği 2026-09-06) — SENKRON HALKASI.
                                 BOŞTA: halka bir sonraki eşitlemeye kadar yavaşça dolar (SANİYE YAZMAZ).
                                 EŞİTLERKEN: aynı halka yüzde ilerlemesini gösterir, ortasında % yazar.
                                 Tek görselin iki hâli olduğu için geçişte yer değiştirme/sıçrama olmaz. -->
                            <Panel Width="26" Height="26" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding SyncRingTooltip}">
                                <Ellipse Width="26" Height="26" StrokeThickness="2"
                                         Stroke="{DynamicResource OverlaySelectedBrush}"/>
                                <!-- Boşta: geri sayım yayı (soluk) -->
                                <Path Stretch="None" StrokeThickness="2" StrokeLineCap="Round"
                                      Stroke="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                                      IsVisible="{Binding !IsSyncing}"
                                      Data="{Binding SyncCountdown, Converter={x:Static vm:ArcProgressConverter.Instance}, ConverterParameter=26}"/>
                                <!-- Eşitlerken: ilerleme yayı (vurgu rengi) -->
                                <Path Stretch="None" StrokeThickness="3" StrokeLineCap="Round"
                                      Stroke="{DynamicResource AccentBrush}"
                                      IsVisible="{Binding IsSyncing}"
                                      Data="{Binding SyncProgress, Converter={x:Static vm:ArcProgressConverter.Instance}, ConverterParameter=26}"/>
                                <SelectableTextBlock Text="{Binding SyncRingText}" FontSize="9" FontWeight="SemiBold"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Panel>

                            <StackPanel VerticalAlignment="Center">
                                <SelectableTextBlock Text="{Binding SyncStatusChip}" Classes="Body"
                                                     FontSize="12" FontWeight="SemiBold"
                                                     MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                <SelectableTextBlock Text="{Binding ConnectionText}" Classes="Helper"
                                                     IsVisible="{Binding !IsSyncing}"/>
                                <SelectableTextBlock Text="{Binding SyncProgress, StringFormat='Eşitleniyor · %{0}'}"
                                                     Classes="Helper" IsVisible="{Binding IsSyncing}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 5) Tek birincil eylem -->
                    <Button Grid.Column="4" Classes="Primary" Height="36" VerticalAlignment="Center"
                            Command="{Binding SyncCommand}" IsEnabled="{Binding !IsSyncing}"
                            ToolTip.Tip="Sunucudaki tanımları bu makineye çeker">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="15" Height="15" Foreground="#241703"
                                      Data="M12 5V2L8 6l4 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7Z"/>
                            <TextBlock Text="Eşitle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ⭐ ARA-01 (ADR-174) — GLOBAL ARAMA: Enter ile arar (anlık öneri yok, min 2 karakter).
                         Yeni yetki modülü YOK — sonuçlar serviste kaynak modül yetkisi + kapsamdan süzülür.
                         Yerel kaynaklar ÇEVRİMDIŞI aranır; Proje+Evrak çevrimiçiyse sunucudan eklenir. -->
                    <!-- ⭐ ÖLÇEKLENME (2026-09-06): 1300 px altında global arama kutusu (170 px) gizlenir.
                         Arama kaybolmaz — menü panelindeki "Ekran ara…" kutusu yerinde durur ve dar
                         pencerede üst barın taşmasını bu 178 px önler. -->
                    <Panel Grid.Column="5" x:Name="GlobalSearchRoot" VerticalAlignment="Center" Margin="0,0,8,0"
                           IsVisible="{Binding $parent[Window].Bounds.Width,
                                       Converter={x:Static vm:GenislikEsikConverter.Instance},
                                       ConverterParameter=1300}">
                        <TextBox x:Name="GlobalSearchBox" Classes="Field" Width="170" Watermark="Ara… (Enter)"
                                 Text="{Binding SearchText}" a11y:AutomationProperties.Name="Global arama">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding RunSearchCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Popup IsOpen="{Binding SearchOpen, Mode=TwoWay}" PlacementTarget="GlobalSearchBox"
                               Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="10" Width="400" MaxHeight="440" Padding="8"
                                    BoxShadow="0 6 24 0 #40000000">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Classes="Secondary" Content="Kapat" HorizontalAlignment="Right"
                                            Margin="0,6,0,0" Command="{Binding CloseSearchCommand}"/>
                                    <SelectableTextBlock DockPanel.Dock="Bottom" Classes="Helper" Margin="2,6,2,0"
                                        Text="{Binding SearchRemoteNote}" IsVisible="{Binding HasSearchRemoteNote}"/>
                                    <ScrollViewer>
                                        <StackPanel>
                                            <SelectableTextBlock Classes="Body" Margin="2" Text="Sonuç yok. (En az 2 karakter yazıp Enter'a basın.)"
                                                                 IsVisible="{Binding SearchEmpty}"/>
                                            <ItemsControl ItemsSource="{Binding SearchGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="search:SearchGroup">
                                                        <StackPanel Margin="0,2">
                                                            <TextBlock Text="{Binding ModuleDisplay}" FontSize="11" FontWeight="SemiBold"
                                                                       Opacity="0.7" Margin="4,4,4,2"/>
                                                            <ItemsControl ItemsSource="{Binding Hits}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="search:SearchHit">
                                                                        <Button Classes="Ghost" Padding="6,3" HorizontalAlignment="Stretch"
                                                                                HorizontalContentAlignment="Left" Cursor="Hand"
                                                                                Command="{Binding #GlobalSearchRoot.((vm:ShellViewModel)DataContext).OpenSearchHitCommand}"
                                                                                CommandParameter="{Binding}" ToolTip.Tip="İlgili ekranı aç">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <TextBlock Text="{Binding Label}" FontSize="12.5"/>
                                                                                <TextBlock Text="{Binding SubLabel}" FontSize="11.5" Opacity="0.65"
                                                                                           IsVisible="{Binding SubLabel, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Classes="Ghost" Padding="6,3" HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Left" IsVisible="{Binding HasMore}"
                                                                    Command="{Binding #GlobalSearchRoot.((vm:ShellViewModel)DataContext).OpenSearchGroupCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="Daha fazlası için ekrana git…" FontSize="12"
                                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Panel>

                    <!-- ⭐ BLD-01 (ADR-172) — BİLDİRİM ÇANI: aktif VE okunmamış bildirim sayısı; tıkla → Uyarılar.
                         Sayaç girişte bir kez + Uyarılar ekranı etkileşimlerinde tazelenir (her geçişte değil). -->
                    <Button Grid.Column="6" Classes="IconGhost" VerticalAlignment="Center" Margin="0,0,4,0"
                            ToolTip.Tip="Bildirimler — okunmamış uyarı sayısı"
                            a11y:AutomationProperties.Name="Bildirimler"
                            Command="{Binding OpenAlertsCommand}">
                        <Panel>
                            <PathIcon Width="17" Height="17" Data="{DynamicResource IconAlerts}"/>
                            <Border CornerRadius="999" Background="{DynamicResource DangerBrush}" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-9,0"
                                    IsVisible="{Binding HasUnreadAlerts}">
                                <TextBlock Text="{Binding UnreadAlerts}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Panel>
                    </Button>

                    <!-- ⭐ LOG-01 (kullanıcı isteği 2026-08-27) — EKRAN ARAÇLARI.
                         Aktif ekrana ÖZEL işlemler tek bir menüde toplanır: kayıt geçmişi (log) ve ekran
                         bilgisi. Eskiden ekran bilgisi kullanıcı menüsündeydi (ekranla ilgisiz bir yer);
                         buraya taşındı. Menü içeriği ActiveKey ile birlikte tazelenir. -->
                    <Button Grid.Column="7" Classes="Ghost" Height="36" Padding="10,0" CornerRadius="10"
                            VerticalAlignment="Center" Margin="0,0,4,0"
                            ToolTip.Tip="Bu ekrana ait araçlar: kayıt geçmişi ve ekran bilgisi"
                            a11y:AutomationProperties.Name="Ekran araçları">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <PathIcon Width="15" Height="15" Data="{DynamicResource IconSettings}"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <!-- 1120 px altında yalnız ETİKET gizlenir; düğme ve ikonu yerinde kalır. -->
                            <SelectableTextBlock Text="Ekran" Classes="Body" FontSize="12.5" VerticalAlignment="Center"
                                                 IsVisible="{Binding $parent[Window].Bounds.Width,
                                                             Converter={x:Static vm:GenislikEsikConverter.Instance},
                                                             ConverterParameter=1120}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{Binding ScreenLogHeader}" Command="{Binding ShowScreenLogCommand}"
                                          IsVisible="{Binding CanShowScreenLog}"/>
                                <!-- ⭐ FAZ 4.3 (kullanıcı isteği 2026-09-06): "her kaydın kendine ait log ekranı" -->
                                <MenuItem Header="Seçili Kaydın Geçmişi" Command="{Binding ShowRecordLogCommand}"
                                          IsVisible="{Binding CanShowRecordLog}"/>
                                <!-- ⭐ FAZ 4.4 (kullanıcı isteği 2026-09-06): senkron çakışma ekranı -->
                                <MenuItem Header="Senkron Çakışmaları" Command="{Binding ShowSyncConflictsCommand}"
                                          IsVisible="{Binding CanShowSyncConflicts}"/>
                                <Separator IsVisible="{Binding CanShowScreenLog}"/>
                                <MenuItem Header="Ekran Bilgisi" Command="{Binding ShowScreenInfoCommand}"
                                          IsVisible="{Binding IsSuperAdmin}"/>
                                <MenuItem Header="Basit Ekran Bilgisi" Command="{Binding ShowSimpleScreenInfoCommand}"
                                          IsVisible="{Binding IsSuperAdmin}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Border Grid.Column="8" Width="1" Height="26" Margin="12,0"
                            Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Center"/>

                    <!-- 6) Kullanıcı menüsü — taşınan komutlar burada -->
                    <Button Grid.Column="9" Classes="Ghost" Height="36" Padding="4,0,10,0"
                            CornerRadius="10" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding DisplayName}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{DynamicResource AccentBrush}">
                                <SelectableTextBlock Text="{Binding Initial}" Foreground="#241703" FontWeight="Bold"
                                                     FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- 1200 px altında kullanıcı ADI gizlenir; baş harf dairesi ve ok yerinde
                                 kalır, menü (Sürüm · Yereli Sıfırla · Çıkış) aynen açılır. Ad, düğmenin
                                 ToolTip'inde zaten var — bilgi kaybı yok. -->
                            <SelectableTextBlock Text="{Binding DisplayName}" Classes="Body" FontSize="12.5"
                                                 VerticalAlignment="Center" MaxWidth="140"
                                                 TextTrimming="CharacterEllipsis"
                                                 IsVisible="{Binding $parent[Window].Bounds.Width,
                                                             Converter={x:Static vm:GenislikEsikConverter.Instance},
                                                             ConverterParameter=1200}"/>
                            <PathIcon Width="13" Height="13" Data="M7 10l5 5 5-5z"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{Binding Version, StringFormat='Sürüm {0}'}" IsEnabled="False"/>
                                <MenuItem Header="{Binding BuildStamp, StringFormat='Derleme {0}'}" IsEnabled="False"/>
                                <Separator/>
                                @* LOG-01: "Ekran Bilgisi" ve "Basit Ekran Bilgisi" buradan ÇIKARILDI —
                                   artık üst bardaki "Ekran Araçları" (⋯) menüsünde, ekrana özel olarak. *@
                                <MenuItem Header="Yereli Sıfırla…" Command="{Binding ResetLocalAndResyncCommand}"
                                          IsVisible="{Binding IsSuperAdmin}"
                                          Foreground="{DynamicResource DangerBrush}"/>
                                <Separator IsVisible="{Binding IsSuperAdmin}"/>
                                <MenuItem Header="Çıkış" Command="{Binding LogoutCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                </Grid>
                </Border>
            </Border>


            <!-- AÇIK EKRAN SEKMELERİ (kullanıcı isteği 2026-09-03; tasarım 2026-09-03'te yenilendi):
                 menüden açılan ekranlar alt şeritte sekme olur; tıkla → ekrana dön, ✕ → sekmeyi kaldır.
                 Yalnız bellekte tutulur → her uygulama açılışında kendiliğinden sıfırlanır. Ana ekran
                 sekme olmaz. ŞERİT YÜKSEKLİĞİ, kenar çubuğundaki kullanıcı şeridiyle AYNIDIR (56)
                 ve aynı zemin rengini kullanır — kullanıcı isteği: renkler aynı, görünüm modern. -->
            <!-- ⭐ TASARIM 2026-09-04 (kullanıcının çizdiği örnek): şerit, tarayıcı sekmesi diline geçti.
                 Her sekme = GRUP İKONU + etiket + ✕; aktif sekme, İÇERİĞE BAKAN kenarında 2 px kehribar
                 çizgi taşır (burada şerit altta olduğu için ÜST kenar) ve zemini bir ton açılır.
                 Web'deki şerit birebir aynı dili kullanır; tek fark konumdur (webde üstte). -->
            <Border DockPanel.Dock="Bottom" Height="46"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding AltBarGorunur}" Padding="8,0">
                <Border.Styles>
                    <!-- Sekme gövdesi: boşta şeffaf, üzerine gelince hafif zemin, aktifken açık zemin. -->
                    <Style Selector="Border.sekme">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="Border.sekme:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                    </Style>
                    <Style Selector="Border.sekme.aktif">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    </Style>

                    <!-- Vurgu çizgisi HER sekmede vardır; yalnız rengi değişir → aktiflik değişince
                         satır yüksekliği oynamaz (görsel zıplama olmaz). -->
                    <Style Selector="Border.sekmeCizgi">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="Border.sekmeCizgi.aktif">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    </Style>

                    <Style Selector="PathIcon.sekmeIkon">
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                    </Style>
                    <Style Selector="PathIcon.sekmeIkon.aktif">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    </Style>

                    <Style Selector="TextBlock.sekmeYazi">
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    </Style>
                    <Style Selector="TextBlock.sekmeYazi.aktif">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>

                    <!-- Sekme içindeki düğmeler ÇERÇEVESİZDİR: çerçeveyi sekmenin kendisi taşır,
                         iç içe iki kutu görüntüsü olmaz. Ghost sınıfı burada kasten kullanılmadı. -->
                    <Style Selector="Button.sekmeDugme">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <!-- ⚠ Şart: düğme dikeyde GERİLİR, ama içeriği kendiliğinden ortalanmaz →
                             ✕ sekmenin üst kenarına yapışıyordu (önizlemede görüldü, 2026-09-04). -->
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="Button.sekmeDugme /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="Button.sekmeKapat">
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                    <Style Selector="Button.sekmeKapat:pointerover">
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    </Style>
                    <!-- İ1: "Diğer Sayfalar" menüsündeki satırlar. Renkler TEMA KAYNAKLARINDAN gelir,
                         bu yüzden koyu ve açık temanın ikisinde de doğru okunur; köşeler yuvarlaktır. -->
                    <Style Selector="Button.tasanSatir">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="Button.tasanSatir:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                    </Style>
                    <Style Selector="Button.tasanSatir:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>

                    <Style Selector="Button.yeniSekme">
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                    </Style>
                    <Style Selector="Button.yeniSekme:pointerover">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    </Style>
                </Border.Styles>

                <DockPanel LastChildFill="True">
                    <!-- ⭐ "Yeni Sekme" düğmesi KALDIRILDI (kullanıcı isteği 2026-09-06):
                         "yeni sekme alanını tamamen kaldıralım". Yaptığı tek iş soldaki ekran
                         aramasına odaklanmaktı; o arama kutusu menüde zaten duruyor, yani hiçbir
                         işlev kaybolmadı. Boşalan sağ uç, alt barın en sağında SABİT duracak olan
                         SOHBET düğmesine ayrıldı (aşağıda). -->

                    <!-- ═══ SOHBET — alt barın EN SAĞINDA SABİT (kullanıcı tasarımı 2026-09-06) ═══
                         Sağa yerleştirildiği için ekran sekmeleri kayarken kaybolmaz. İçinde önce
                         AÇIK KONUŞMA SEKMELERİ, en sağda da ANA SOHBET düğmesi durur. Yetkisi
                         olmayan kullanıcıda tamamı görünmez (deny-by-default). -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Stretch" IsVisible="{Binding Chat.Kullanilabilir}">

                        <!-- Açık konuşmaların sekmeleri: tıkla → pencere açılır/kapanır, ✕ → sekme kalkar -->
                        <ItemsControl ItemsSource="{Binding Chat.Konusmalar}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KonusmaVm">
                                    <Border Classes="sekme" VerticalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,6,0">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding Online}"/>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding !Online}"/>
                                            <Button Classes="sekmeDugme" Padding="0" Background="Transparent"
                                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Chat.KonusmaAcKapaCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Mesaj penceresini aç / kapat">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Display}" FontSize="12.5" VerticalAlignment="Center"
                                                               MaxWidth="130" TextTrimming="CharacterEllipsis"/>
                                                    <Border CornerRadius="999" Background="{DynamicResource DangerBrush}" Padding="5,0"
                                                            VerticalAlignment="Center" IsVisible="{Binding OkunmamisVar}">
                                                        <TextBlock Text="{Binding Okunmamis}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="sekmeKapat" Content="✕" FontSize="11" Padding="4,0"
                                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Chat.KonusmayiKapatCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Sekmeyi kaldır (mesajlar silinmez)"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ANA SOHBET DÜĞMESİ — en sağda, sabit -->
                        <Button Classes="sekmeDugme" Padding="14,0" VerticalAlignment="Stretch"
                                Command="{Binding Chat.PaneliAcKapaCommand}"
                                ToolTip.Tip="Sohbet: firmadaki kullanıcıları gör ve mesaj gönder">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <PathIcon Width="15" Height="15" VerticalAlignment="Center"
                                          Data="M4 4h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H8l-4 4V5a1 1 0 0 1 1-1Z"/>
                                <TextBlock Text="Sohbet" FontSize="12.5" VerticalAlignment="Center"/>
                                <Border CornerRadius="999" Background="{DynamicResource DangerBrush}" Padding="5,0"
                                        VerticalAlignment="Center" IsVisible="{Binding Chat.ToplamOkunmamisVar}">
                                    <TextBlock Text="{Binding Chat.ToplamOkunmamis}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>


                    <!-- ═══ İ1 (kullanıcı tasarımı 2026-09-06) — TAŞAN SEKMELER "DİĞER SAYFALAR"A GİDER ═══
                         Eskiden şerit yatay KAYDIRILIYORDU: sekme çoğalınca kullanıcı kaydırma çubuğuyla
                         uğraşıyor, sağdaki sohbet düğmesi de dar pencerede sıkışıyordu. Artık sığmayan
                         sekmeler ölçümle belirlenip (bkz. Controls/TasanSekmePaneli) yukarı açılan
                         "Diğer Sayfalar ∨" menüsünde toplanır. Pencere büyüyünce kendiliğinden geri gelirler.

                         SIRA (soldan sağa): sığan sekmeler → "Diğer Sayfalar ∨" → EN SAĞDA SABİT "Sohbet".
                         Sohbet yukarıda DockPanel.Dock="Right" ile sabitlenmiştir; bu blok kalan alanı doldurur. -->

                    <!-- "Diğer Sayfalar ∨" — sekmelerin HEMEN ARDINDA, sohbetin SOLUNDA -->
                    <Button DockPanel.Dock="Right" Classes="sekmeDugme" Padding="12,0" Margin="4,0,6,0"
                            VerticalAlignment="Stretch" IsVisible="{Binding TasanVar}"
                            ToolTip.Tip="Alt bara sığmayan açık sayfalar burada toplanır">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TasanBaslik}" FontSize="12.5" VerticalAlignment="Center"/>
                            <TextBlock Text="⌃" FontSize="11" VerticalAlignment="Center" Opacity="0.75"/>
                        </StackPanel>
                        <Button.Flyout>
                            <!-- YUKARI açılır (şerit altta olduğu için tek doğru yön budur) -->
                            <Flyout Placement="Top" HorizontalOffset="0" ShowMode="Standard">
                                <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding TasanSekmeler}" MinWidth="230">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ShellViewModel+TasanSekmeGrubu">
                                                <Button Classes="tasanSatir" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Padding="10,8"
                                                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).TasaniAcCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <PathIcon Width="15" Height="15" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                                  Data="{Binding Icon}"
                                                                  IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        <TextBlock Text="{Binding Gosterim}" FontSize="12.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <ItemsControl ItemsSource="{Binding OpenTabs}" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctrl:TasanSekmePaneli AraBosluk="2"
                                        AktifSira="{Binding $parent[Window].((vm:ShellViewModel)DataContext).AktifSekmeSirasi}"
                                        TasmaKomutu="{Binding $parent[Window].((vm:ShellViewModel)DataContext).TasmaGuncelleCommand}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OpenScreenTab">
                                    <Border Classes="sekme" Classes.aktif="{Binding IsActive}"
                                            CornerRadius="8,8,0,0" ClipToBounds="True">
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Top" Height="2"
                                                    Classes="sekmeCizgi" Classes.aktif="{Binding IsActive}"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                                                <Button Classes="sekmeDugme" Padding="14,0,8,0"
                                                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).ActivateTabCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Bu ekrana dön">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <PathIcon Width="15" Height="15" VerticalAlignment="Center"
                                                                  Classes="sekmeIkon" Classes.aktif="{Binding IsActive}"
                                                                  Data="{Binding Icon}"
                                                                  IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        <TextBlock Classes="sekmeYazi" Classes.aktif="{Binding IsActive}"
                                                                   Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="sekmeDugme sekmeKapat" Padding="6,0,12,0" Content="✕"
                                                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).CloseTabCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Sekmeyi kaldır (ekran verisi silinmez)"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- İçerik (modül ekranı; ViewLocator VM->View) -->
            <ContentControl Content="{Binding CurrentPage}"/>
        </DockPanel>

        <!-- ═══════════════ SOHBET PENCERELERİ — ÜST KATMAN ═══════════════
             Kullanıcı isteği: "ekranda fazladan yer işgal etmemeli". Bu yüzden pencereler
             yerleşime (layout) GİRMEZ: içeriğin üstünde, sağ alt köşede çizilirler. Alt bar
             46 px olduğu için 58 px alt boşlukla onun üzerinde dururlar. Kapalıyken hiçbiri
             çizilmediğinden ekranda sıfır yer kaplarlar. -->
        <Grid Grid.Column="1" ZIndex="50" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,12,58" IsVisible="{Binding Chat.Kullanilabilir}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">

                <!-- Açık konuşma pencereleri (yan yana) -->
                <ItemsControl ItemsSource="{Binding Chat.Konusmalar}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KonusmaVm">
                            <Border Width="330" Height="430" CornerRadius="12" IsVisible="{Binding Acik}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    BoxShadow="0 8 28 0 #55000000">
                                <DockPanel>
                                    <!-- Başlık: kim, çevrimiçi mi, kapat -->
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceElevatedBrush}"
                                            CornerRadius="12,12,0,0" Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                    Background="{DynamicResource AccentBrush}">
                                                <TextBlock Text="{Binding Initial}" Foreground="#241703" FontWeight="Bold"
                                                           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                             Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding Online}"/>
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                             Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding !Online}"/>
                                                    <TextBlock Text="Çevrim içi" FontSize="10.5" IsVisible="{Binding Online}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="Çevrim dışı" FontSize="10.5" IsVisible="{Binding !Online}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="IconGhost" Content="✕" FontSize="12"
                                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Chat.KonusmaAcKapaCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Pencereyi kapat (sekme alt barda kalır)"/>
                                        </Grid>
                                    </Border>

                                    <!-- Yazma alanı -->
                                    <Border DockPanel.Dock="Bottom" Padding="8" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}">
                                        <StackPanel Spacing="6">
                                            <SelectableTextBlock Text="{Binding Hata}" Classes="Helper" TextWrapping="Wrap"
                                                                 Foreground="{DynamicResource DangerBrush}"
                                                                 IsVisible="{Binding Hata, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Grid.Column="0" Classes="Field" Text="{Binding Taslak}"
                                                         Watermark="Mesaj yazın…" AcceptsReturn="False">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter"
                                                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Chat.GonderCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Grid.Column="1" Classes="Primary" Content="Gönder" Margin="6,0,0,0"
                                                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Chat.GonderCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Mesajlar (eskiden yeniye) -->
                                    <ScrollViewer Padding="8">
                                        <ItemsControl ItemsSource="{Binding Mesajlar}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="chat:ChatMesaj">
                                                    <Border CornerRadius="10" Padding="9,6" Margin="0,3" MaxWidth="240"
                                                            HorizontalAlignment="{Binding Mine, Converter={x:Static vm:MesajHizaConverter.Instance}}"
                                                            Background="{Binding Mine, Converter={x:Static vm:MesajZeminConverter.Instance}}">
                                                        <StackPanel Spacing="2">
                                                            <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12.5"/>
                                                            <TextBlock Text="{Binding SaatMetni}" FontSize="9.5" HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- KİŞİ LİSTESİ paneli (ana sohbet penceresi) -->
                <Border Width="330" Height="470" CornerRadius="12" IsVisible="{Binding Chat.PanelAcik}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        BoxShadow="0 8 28 0 #55000000">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceElevatedBrush}"
                                CornerRadius="12,12,0,0" Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Kullanıcılar" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="IconGhost" Content="✕" FontSize="12"
                                        Command="{Binding Chat.PaneliAcKapaCommand}" ToolTip.Tip="Kapat"/>
                            </Grid>
                        </Border>

                        <Border DockPanel.Dock="Top" Padding="10,8,10,4">
                            <TextBox Classes="Search" Text="{Binding Chat.Arama}" Watermark="Kullanıcı ara…"/>
                        </Border>

                        <!-- Çevrimdışıyken sohbet çalışmaz: sahte liste göstermek yerine açıkça söylenir. -->
                        <Border DockPanel.Dock="Bottom" Padding="10,8" IsVisible="{Binding Chat.Cevrimdisi}">
                            <SelectableTextBlock Classes="Helper" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource WarningBrush}"
                                                 Text="Sunucuya ulaşılamıyor. Sohbet yalnız çevrimiçiyken çalışır; bağlantı gelince liste kendiliğinden tazelenir."/>
                        </Border>

                        <ScrollViewer Padding="6">
                            <ItemsControl ItemsSource="{Binding Chat.GorunenKisiler}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="chat:ChatKisi">
                                        <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="8,7" Margin="0,1" Cursor="Hand"
                                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Chat.KisiyiAcCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Mesaj penceresini aç">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Panel Grid.Column="0">
                                                    <Border Width="34" Height="34" CornerRadius="17"
                                                            Background="{DynamicResource OverlaySelectedBrush}">
                                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="13"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding Online}"/>
                                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding !Online}"/>
                                                </Panel>
                                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Display}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DurumMetni}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="999" Background="{DynamicResource DangerBrush}"
                                                        Padding="6,1" VerticalAlignment="Center"
                                                        IsVisible="{Binding Unread}">
                                                    <TextBlock Text="{Binding Unread}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
