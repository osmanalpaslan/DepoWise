<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:sec="using:DepoWise.Infrastructure.Security"
             xmlns:org="using:DepoWise.Infrastructure.Organization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="660"
             x:Class="DepoWise.Desktop.Views.UsersView"
             x:DataType="vm:UsersViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Kullanıcılar"
                      PrimaryActionText="Yeni Kullanıcı" PrimaryActionCommand="{Binding NewUserCommand}">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- Yeni kullanıcı formu -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="YENİ KULLANICI" Classes="SectionTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Kullanıcı Adı" IsRequired="True" Width="220">
                        <TextBox Classes="Field" Text="{Binding NewUsername}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Şifre" IsRequired="True" Width="220">
                        <TextBox Classes="Field" Text="{Binding NewPassword}" PasswordChar="●"/>
                    </ctrl:FormField>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Ad Soyad" Width="220">
                        <TextBox Classes="Field" Text="{Binding NewFullName}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Şube" Width="220" HelpText="Boş = şubesiz.">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}" SelectedItem="{Binding FormBranch}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="org:BranchRow"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </ctrl:FormField>
                </StackPanel>
                <ctrl:FormField Label="Roller" HelpText="Rol verilmezse kullanıcı hiçbir ekran görmez (yetkiler ayrıca verilir).">
                    <ItemsControl ItemsSource="{Binding AssignableRoles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RolePick">
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ctrl:FormField>
                <ctrl:FormField Label="Yetki Şablonu (Süper Admin)" Width="320" IsVisible="{Binding CanUseTemplates}"
                                HelpText="Seçilirse yeni kullanıcının yetkileri bu şablona göre yazılır.">
                    <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="sec:PermissionTemplateRow"><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ctrl:FormField>
                <TextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding CancelAddCommand}"/>
                    <Button Classes="Primary" Content="Oluştur" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Seçili kullanıcı: şube ata + şifre değiştir + sil -->
        <Border Grid.Row="2" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Seçili kullanıcı:" Classes="Helper" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Selected.Username}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Şube:" Classes="Helper" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox Classes="Field" Width="200" ItemsSource="{Binding Branches}" SelectedItem="{Binding AssignBranch}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="org:BranchRow"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="Primary" Content="Şube Ata" Command="{Binding AssignBranchToUserCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding CanManageUsers}">
                    <TextBlock Text="Yeni şifre:" Classes="Helper" VerticalAlignment="Center"/>
                    <TextBox Classes="Field" Width="200" Text="{Binding NewPasswordForSelected}" PasswordChar="●"/>
                    <Button Classes="Secondary" Content="Şifre Değiştir" Command="{Binding ChangePasswordCommand}"/>
                    <Button Classes="Secondary" Content="Aktif / Pasif" Command="{Binding ToggleActiveCommand}"/>
                    <Button Classes="Danger" Content="Kullanıcıyı Sil" Margin="20,0,0,0" Command="{Binding DeleteUserCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Liste -->
        <Panel Grid.Row="3" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="Auto,*,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="KULLANICI" MinWidth="150"/>
                            <TextBlock Grid.Column="1" Text="AD SOYAD" MinWidth="150"/>
                            <TextBlock Grid.Column="2" Text="ROLLER" MinWidth="160"/>
                            <TextBlock Grid.Column="3" Text="ŞUBE" MinWidth="120"/>
                            <TextBlock Grid.Column="4" Text="DURUM" MinWidth="70"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="sec:UserRow">
                                <Grid ColumnDefinitions="Auto,*,*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Username}" MinWidth="150" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FullName}" MinWidth="150" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Roles}" MinWidth="160" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding BranchDisplay}" MinWidth="120" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" MinWidth="70" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Kullanıcı yok" Message="Henüz kullanıcı yok." IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
