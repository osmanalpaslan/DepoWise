<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:sec="using:DepoWise.Infrastructure.Security"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.UsersView"
             x:DataType="vm:UsersViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Kullanıcılar"
                      PrimaryActionText="Yeni Kullanıcı" PrimaryActionCommand="{Binding NewUserCommand}">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- Yeni kullanıcı formu -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="YENİ KULLANICI" Classes="SectionTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Kullanıcı Adı" IsRequired="True" Width="220">
                        <TextBox Classes="Field" Text="{Binding NewUsername}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Şifre" IsRequired="True" Width="220">
                        <TextBox Classes="Field" Text="{Binding NewPassword}" PasswordChar="●"/>
                    </ctrl:FormField>
                </StackPanel>
                <ctrl:FormField Label="Ad Soyad" Width="340">
                    <TextBox Classes="Field" Text="{Binding NewFullName}"/>
                </ctrl:FormField>
                <ctrl:FormField Label="Roller" HelpText="Rol verilmezse kullanıcı hiçbir ekran görmez (yetkiler ayrıca verilir).">
                    <ItemsControl ItemsSource="{Binding AssignableRoles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RolePick">
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ctrl:FormField>
                <TextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding CancelAddCommand}"/>
                    <Button Classes="Primary" Content="Oluştur" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Liste -->
        <Panel Grid.Row="2" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="Auto,*,*,Auto">
                            <TextBlock Grid.Column="0" Text="KULLANICI" MinWidth="160"/>
                            <TextBlock Grid.Column="1" Text="AD SOYAD" MinWidth="160"/>
                            <TextBlock Grid.Column="2" Text="ROLLER" MinWidth="180"/>
                            <TextBlock Grid.Column="3" Text="DURUM" MinWidth="80"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="sec:UserRow">
                                <Grid ColumnDefinitions="Auto,*,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Username}" MinWidth="160" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FullName}" MinWidth="160" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Roles}" MinWidth="180" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding IsActive}" MinWidth="80" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Kullanıcı yok" Message="Henüz kullanıcı yok." IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
