<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:sec="using:DepoWise.Infrastructure.Security"
             xmlns:org="using:DepoWise.Infrastructure.Organization"
             xmlns:orgp="using:DepoWise.Infrastructure.Org"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="660"
             x:Class="DepoWise.Desktop.Views.UsersView"
             x:DataType="vm:UsersViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Kullanıcılar"
                      PrimaryActionText="Yeni Kullanıcı" PrimaryActionCommand="{Binding NewUserCommand}">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- Yeni kullanıcı formu -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
                <SelectableTextBlock Text="YENİ KULLANICI" Classes="SectionTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Kullanıcı Adı" IsRequired="True" Width="220">
                        <TextBox Classes="Field" Text="{Binding NewUsername}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Şifre" IsRequired="True" Width="220">
                        <TextBox Classes="Field" Text="{Binding NewPassword}" PasswordChar="●"/>
                    </ctrl:FormField>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Ad Soyad" Width="220">
                        <TextBox Classes="Field" Text="{Binding NewFullName}"/>
                    </ctrl:FormField>
                    <!-- Firma seçimi YALNIZ süper adminde görünür; kullanıcı seçilen firmaya bağlı oluşturulur -->
                    <ctrl:FormField Label="Firma" IsRequired="True" Width="220" IsVisible="{Binding IsSuperAdmin}"
                                    HelpText="Kullanıcı bu firmaya bağlı oluşturulur. Firma değişince şube listesi yenilenir.">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Companies}" SelectedItem="{Binding FormCompany}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CompanyPick"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </ctrl:FormField>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Şube" Width="220" HelpText="Seçili firmanın şubeleri. Boş = şubesiz.">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding FormBranches}" SelectedItem="{Binding FormBranch}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="org:BranchRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </ctrl:FormField>
                    <!-- Fikir B: hesabı bir PERSONEL kaydına bağla (hesabı olmayan personeller listelenir) -->
                    <ctrl:FormField Label="Personel seç (bağla)" Width="220" IsVisible="{Binding FormCompanyIsOwn}"
                                    HelpText="Bu hesap hangi personele ait? Listede yoksa önce Personel ekranından ekleyin.">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding LinkablePersonnel}" SelectedItem="{Binding FormPersonnel}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="orgp:PersonnelRecord"><SelectableTextBlock Text="{Binding FullName}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </ctrl:FormField>
                    <SelectableTextBlock Classes="Helper" Width="240" TextWrapping="Wrap" VerticalAlignment="Center"
                                         IsVisible="{Binding ShowOtherCompanyPersonnelNote}"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         Text="Başka firma seçili: personel bağlama burada yapılamaz. Kullanıcı oluşturulduktan sonra o firmanın Personel ekranından bağlanabilir."/>
                </StackPanel>
                <ctrl:FormField Label="Rol" HelpText="Tek rol seçilir. Rol verilmezse kullanıcı hiçbir ekran görmez (yetkiler ayrıca verilir).">
                    <ItemsControl ItemsSource="{Binding AssignableRoles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RolePick">
                                <RadioButton GroupName="newUserRole" IsChecked="{Binding IsSelected}" Content="{Binding Name}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ctrl:FormField>
                <CheckBox IsChecked="{Binding NewViewAllBranches}" IsVisible="{Binding IsSuperAdmin}" Margin="0,4"
                          Content="Tüm Şubeler yetkisi (yalnız Süper Admin — tüm şube verisiyle çalışır)"/>
                <ctrl:FormField Label="Yetki Şablonu (Süper Admin)" Width="320" IsVisible="{Binding CanUseTemplates}"
                                HelpText="Seçilirse yeni kullanıcının yetkileri bu şablona göre yazılır.">
                    <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="sec:PermissionTemplateRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ctrl:FormField>
                <SelectableTextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding CancelAddCommand}"/>
                    <Button Classes="Primary" Content="Oluştur" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Seçili kullanıcı: şube ata + şifre değiştir + sil -->
        <Border Grid.Row="2" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <SelectableTextBlock Text="Seçili kullanıcı:" Classes="Helper" VerticalAlignment="Center"/>
                    <SelectableTextBlock Text="{Binding Selected.Username}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <SelectableTextBlock Text="Şube:" Classes="Helper" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding CanManageSelected}"/>
                    <ComboBox Classes="Field" Width="200" ItemsSource="{Binding Branches}" SelectedItem="{Binding AssignBranch}" IsVisible="{Binding CanManageSelected}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="org:BranchRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="Primary" Content="Şube Ata" Command="{Binding AssignBranchToUserCommand}" IsVisible="{Binding CanManageSelected}"/>
                    <Button Classes="Secondary" Content="Tüm Şubeler Yetkisi (Aç/Kapat)" Margin="12,0,0,0"
                            IsVisible="{Binding IsSuperAdmin}" Command="{Binding ToggleViewAllBranchesCommand}"/>
                </StackPanel>
                <Border Classes="Panel" Padding="10,6" IsVisible="{Binding SelectedIsMasked}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                    <SelectableTextBlock Text="🔒 Bu kullanıcı bir admin — yalnız süper admin düzenleyebilir."
                                         Classes="Body" Foreground="{DynamicResource WarningBrush}"/>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding CanManageSelected}">
                    <Button Classes="Secondary" Content="Şifre Sıfırla" Command="{Binding ResetPasswordCommand}"
                            ToolTip.Tip="Şifreyi kullanıcı adına sıfırlar. Kullanıcı ilk girişte kendi şifresini belirler."/>
                    <Button Classes="Secondary" Content="Aktif / Pasif" Command="{Binding ToggleActiveCommand}"/>
                    <Button Classes="Danger" Content="Kullanıcıyı Sil" Margin="20,0,0,0" Command="{Binding DeleteUserCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding CanManageSelected}">
                    <SelectableTextBlock Text="Rol:" Classes="Helper" VerticalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding EditRoles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RolePick">
                                <RadioButton GroupName="editUserRole" IsChecked="{Binding IsSelected}" Content="{Binding Name}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="Primary" Content="Rolü Kaydet" Command="{Binding SaveRolesCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Liste -->
        <Panel Grid.Row="3" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="Auto,*,*,*,Auto,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="KULLANICI" MinWidth="150"/>
                            <SelectableTextBlock Grid.Column="1" Text="AD SOYAD" MinWidth="150"/>
                            <SelectableTextBlock Grid.Column="2" Text="PERSONEL" MinWidth="140"/>
                            <SelectableTextBlock Grid.Column="3" Text="ROLLER" MinWidth="160"/>
                            <SelectableTextBlock Grid.Column="4" Text="ŞUBE" MinWidth="120"/>
                            <SelectableTextBlock Grid.Column="5" Text="DURUM" MinWidth="70"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="sec:UserRow">
                                <Grid ColumnDefinitions="Auto,*,*,*,Auto,Auto">
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Username}" MinWidth="150" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding FullName}" MinWidth="150" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding PersonnelDisplay}" MinWidth="140" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding Roles}" MinWidth="160" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <SelectableTextBlock Grid.Column="4" Text="{Binding BranchDisplay}" MinWidth="120" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="5" Text="{Binding StatusText}" MinWidth="70" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Kullanıcı yok" Message="Henüz kullanıcı yok." IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
