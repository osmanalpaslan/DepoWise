<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <ctrl:Toolbar Grid.Row="0" Title="Tanımlar"/>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Spacing="10" MaxWidth="620" HorizontalAlignment="Left">

                <!-- Accordion: Tanım Listeleri (kategori/birim/marka/tedarikçi/şube/araç) -->
                <ItemsControl ItemsSource="{Binding LookupSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LookupSectionViewModel">
                            <Expander Header="{Binding Title}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                <StackPanel Spacing="10">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LookupRowViewModel">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                                                    <TextBox Grid.Column="0" Classes="Field" Text="{Binding Name}" MaxLength="50" VerticalAlignment="Center"
                                                             IsEnabled="{Binding $parent[ItemsControl].((vm:LookupSectionViewModel)DataContext).CanEdit}"/>
                                                    <Button Grid.Column="1" Classes="Ghost" Content="Kaydet"
                                                            IsVisible="{Binding $parent[ItemsControl].((vm:LookupSectionViewModel)DataContext).CanEdit}"
                                                            IsEnabled="{Binding !IsLocked}"
                                                            Command="{Binding $parent[ItemsControl].((vm:LookupSectionViewModel)DataContext).RenameCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="2" Classes="Ghost" Content="Sil"
                                                            IsVisible="{Binding $parent[ItemsControl].((vm:LookupSectionViewModel)DataContext).CanDelete}"
                                                            IsEnabled="{Binding !IsLocked}"
                                                            Command="{Binding $parent[ItemsControl].((vm:LookupSectionViewModel)DataContext).DeleteCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <!-- Sabit tanım kilidi — yalnız admin (kullanıcı isteği 2026-07-19) -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                                IsVisible="{Binding $parent[ItemsControl].((vm:LookupSectionViewModel)DataContext).CanToggleLock}">
                                                        <Button Classes="Ghost" Content="Kilitle" ToolTip.Tip="Sabit yap: düzenlenemez/silinemez, yeni tanım eklemeyi etkilemez"
                                                                IsVisible="{Binding !IsLocked}"
                                                                Command="{Binding $parent[ItemsControl].((vm:LookupSectionViewModel)DataContext).ToggleLockCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Classes="Ghost" Content="Kilidi Aç" ToolTip.Tip="Sabitliği kaldır: yeniden düzenlenebilir/silinebilir olur"
                                                                IsVisible="{Binding IsLocked}"
                                                                Command="{Binding $parent[ItemsControl].((vm:LookupSectionViewModel)DataContext).ToggleLockCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <SelectableTextBlock Text="Kayıt yok." Classes="Helper" IsVisible="{Binding !Items.Count}"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanWrite}">
                                        <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewName}" Watermark="Yeni tanım adı" MaxLength="50"/>
                                        <Button Grid.Column="1" Classes="Primary" Content="Ekle" Command="{Binding AddCommand}"/>
                                    </Grid>
                                    <SelectableTextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Malzeme Alt Kategorileri (madde 10): kategori seç → alt kategorilerini ekle/düzenle/sil -->
                <Expander Header="Malzeme — Alt Kategoriler" HorizontalAlignment="Stretch" Margin="0,0,0,10"
                          DataContext="{Binding SubCategorySection}">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <AutoCompleteBox Classes="Field" ItemsSource="{Binding Categories}" AsyncPopulator="{Binding CategoryPopulator}" SelectedItem="{Binding SelectedCategory}"
                                  MinimumPrefixLength="0" ValueMemberBinding="{Binding Name}"
                                  PlaceholderText="Önce kategori seçin..." HorizontalAlignment="Left" MinWidth="260">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                        <SelectableTextBlock Text="Alt kategorileri görmek/eklemek için bir kategori seçin." Classes="Helper"
                                   IsVisible="{Binding SelectedCategory, Converter={x:Static ObjectConverters.IsNull}}"/>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LookupRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                                        <TextBox Grid.Column="0" Classes="Field" Text="{Binding Name}" MaxLength="50"
                                                 IsEnabled="{Binding $parent[ItemsControl].((vm:SubCategorySectionViewModel)DataContext).CanEdit}"/>
                                        <Button Grid.Column="1" Classes="Secondary" Content="Kaydet"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:SubCategorySectionViewModel)DataContext).CanEdit}"
                                                Command="{Binding $parent[ItemsControl].((vm:SubCategorySectionViewModel)DataContext).RenameCommand}" CommandParameter="{Binding}"/>
                                        <Button Grid.Column="2" Classes="Danger" Content="Sil"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:SubCategorySectionViewModel)DataContext).CanDelete}"
                                                Command="{Binding $parent[ItemsControl].((vm:SubCategorySectionViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                              IsVisible="{Binding SelectedCategory, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewName}" Watermark="Yeni alt kategori adı" MaxLength="50"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Command="{Binding AddCommand}" IsVisible="{Binding CanWrite}"/>
                        </Grid>
                        <SelectableTextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <SelectableTextBlock Grid.Row="2" Text="{Binding Status}" Classes="Helper" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
