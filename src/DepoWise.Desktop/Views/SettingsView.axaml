<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <ctrl:Toolbar Grid.Row="0" Title="Tanımlar / Ayarlar"/>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Spacing="10" MaxWidth="620" HorizontalAlignment="Left">

                <!-- Accordion: Marka -->
                <Expander Header="Marka" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Uygulama adı, şirket ve iletişim bilgileri. Bu firmaya özel saklanır."
                                   Classes="Helper" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <ctrl:FormField Label="Uygulama Adı" IsRequired="True" Width="260"
                                            HelpText="Pencere başlığı ve markada görünür.">
                                <TextBox Classes="Field" Text="{Binding AppName}" IsEnabled="{Binding CanWrite}"/>
                            </ctrl:FormField>
                            <ctrl:FormField Label="Şirket Adı" IsRequired="True" Width="260">
                                <TextBox Classes="Field" Text="{Binding CompanyName}" IsEnabled="{Binding CanWrite}"/>
                            </ctrl:FormField>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <ctrl:FormField Label="İletişim" Width="260">
                                <TextBox Classes="Field" Text="{Binding Contact}" IsEnabled="{Binding CanWrite}"/>
                            </ctrl:FormField>
                            <ctrl:FormField Label="Web Sitesi" Width="260">
                                <TextBox Classes="Field" Text="{Binding Website}" IsEnabled="{Binding CanWrite}"/>
                            </ctrl:FormField>
                        </StackPanel>

                        <ctrl:FormField Label="Telif" Width="534">
                            <TextBox Classes="Field" Text="{Binding Copyright}" IsEnabled="{Binding CanWrite}"/>
                        </ctrl:FormField>
                    </StackPanel>
                </Expander>

                <!-- Accordion: Sunucu Yedek (Bulut) -->
                <Expander Header="Sunucu Yedek (Bulut)" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Tanımlanırsa her yerel yedek otomatik olarak sunucuya yüklenir. Sunucu yedekleri HİÇ silmez; tüm masaüstü makinelerin tüm günlük yedeklerini saklar. (Yerelde 30 gün rotasyon devam eder.)" Classes="Helper" TextWrapping="Wrap"/>
                        <ctrl:FormField Label="Sunucu Adresi (URL)" Width="534"
                                        HelpText="Örn. https://yedek.sirket.com/api/backups">
                            <TextBox Classes="Field" Text="{Binding BackupServerUrl}" IsEnabled="{Binding CanWrite}"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Erişim Anahtarı (Bearer Token)" Width="534">
                            <TextBox Classes="Field" Text="{Binding BackupServerToken}" PasswordChar="●" IsEnabled="{Binding CanWrite}"/>
                        </ctrl:FormField>
                    </StackPanel>
                </Expander>

                <!-- Accordion: Geliştirici Modu -->
                <Expander Header="Geliştirici Modu" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Geliştirici kodu girilince açılır → kullanıcı süper admin yetkilerine sahip olur. Çıkış yapınca otomatik kapanır." Classes="Helper" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DeveloperStatusText}" Classes="Body" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !DeveloperActive}">
                            <ctrl:FormField Label="Geliştirici Kodu" Width="220">
                                <TextBox Classes="Field" Text="{Binding DeveloperCode}" PasswordChar="●"/>
                            </ctrl:FormField>
                            <Button Classes="Primary" Content="Aktif Et" VerticalAlignment="Bottom" Command="{Binding ActivateDeveloperCommand}"/>
                        </StackPanel>
                        <Button Classes="Danger" Content="Geliştirici Modunu Kapat" HorizontalAlignment="Left"
                                IsVisible="{Binding DeveloperActive}" Command="{Binding DeactivateDeveloperCommand}"/>
                    </StackPanel>
                </Expander>

                <!-- Accordion: Tanım Listeleri (kategori/birim/marka/tedarikçi/şube/araç) -->
                <ItemsControl ItemsSource="{Binding LookupSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LookupSectionViewModel">
                            <Expander Header="{Binding Title}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                <StackPanel Spacing="10">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:LookupItem">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="Ghost" Content="Sil"
                                                            Command="{Binding $parent[ItemsControl].((vm:LookupSectionViewModel)DataContext).DeleteCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Kayıt yok." Classes="Helper" IsVisible="{Binding !Items.Count}"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanWrite}">
                                        <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewName}" Watermark="Yeni tanım adı"/>
                                        <Button Grid.Column="1" Classes="Primary" Content="Ekle" Command="{Binding AddCommand}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Hassas ayar onay paneli -->
                <Border Classes="Panel" IsVisible="{Binding ConfirmVisible}"
                        BorderBrush="{DynamicResource WarningBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Marka ayarlarını kaydet?" Classes="Body" FontWeight="SemiBold"/>
                        <TextBlock Text="Uygulama adı/markası görünümü ve pencere başlığını etkiler. Onaylıyor musunuz?"
                                   Classes="Helper" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Classes="Secondary" Content="Vazgeç" Command="{Binding CancelConfirmCommand}"/>
                            <Button Classes="Primary" Content="Onayla ve Kaydet" Command="{Binding ConfirmSaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Alt eylem çubuğu -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="{Binding Status}" Classes="Helper"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanWrite}">
                <Button Classes="Secondary" Content="Geri Al" Command="{Binding RevertCommand}"/>
                <Button Classes="Primary" Content="Kaydet" Command="{Binding RequestSaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
