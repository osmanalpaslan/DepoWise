<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:inf="using:DepoWise.Infrastructure.Vehicles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
             x:Class="DepoWise.Desktop.Views.VehicleTemplatesView"
             xmlns:conv="using:DepoWise.Desktop.Converters"
             x:DataType="vm:VehicleTemplatesViewModel">

    <UserControl.Resources>
        <conv:FormUstSiniriConverter x:Key="FormUstSiniri"/>
    </UserControl.Resources>

    <Grid x:Name="KokYerlesim" RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <ctrl:Toolbar ShowSearch="True" Grid.Row="0" Title="Araç Genel Tanım (Şablonlar)"
                      SearchText="{Binding Search, Mode=TwoWay}" SearchWatermark="Şablon ara..."
                      PrimaryActionText="{Binding AddButtonText}" PrimaryActionCommand="{Binding ToggleAddCommand}">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Ara" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- Yeni şablon formu -->
        <Border Background="{DynamicResource AppBackgroundBrush}" BorderThickness="0" Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}"/>
                <KeyBinding Gesture="Escape" Command="{Binding ClearCommand}"/>
            </Border.KeyBindings>
            <!-- 2026-10-12: form yüksekliği SABİT piksel değil — ekran yüksekliğinin oranı (FormListeOrani, Depo Giriş ile aynı);
                 büyük ekranda form büyür, sığmazsa kendi içinde kayar, altta liste görünür kalır. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="{Binding #KokYerlesim.Bounds.Height, Converter={StaticResource FormUstSiniri}}">
            <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                <SelectableTextBlock Text="{Binding FormTitle}" Classes="IosBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                        <ctrl:FormField Label="Ad" IsRequired="True" Width="260"
                                        HasError="{Binding HasNameError}" ErrorText="{Binding NameError}">
                            <TextBox Classes="Field" Text="{Binding NewName}"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Örnek İç Kod" Width="160" HelpText="ör. KM-001 → araçta otomatik artar">
                            <TextBox Classes="Field" Text="{Binding NewCode}"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Üretim Yılı" Width="130">
                            <NumericUpDown Classes="Field" Value="{Binding NewYear}" Minimum="0" Maximum="2100"
                                           FormatString="0" ShowButtonSpinner="False"/>
                        </ctrl:FormField>
                    </WrapPanel>

                </StackPanel></Border>
                <SelectableTextBlock Text="Sınıflandırma" Classes="IosFormBaslik"/>
                <ctrl:FormField Label="Makine Tipi">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Types}" SelectedItem="{Binding SelType}" PlaceholderText="Makine tipi seç / ara..."/>
                            <Button AutomationProperties.Name="Yeni makine tipi ekle" Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding [vehicle_types]}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddTypeCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingType}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewTypeName}" PlaceholderText="Yeni makine tipi"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddTypeCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddTypeCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>
                <ctrl:FormField Label="Kategori">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelCategory}" PlaceholderText="Kategori seç / ara..."/>
                            <Button AutomationProperties.Name="Yeni kategori ekle" Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding [vehicle_categories]}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddCatCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingCat}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewCatName}" PlaceholderText="Yeni kategori"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddCatCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddCatCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>
                <ctrl:FormField Label="Marka">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Brands}" SelectedItem="{Binding SelBrand}" PlaceholderText="Marka seç / ara..."/>
                            <Button AutomationProperties.Name="Yeni marka ekle" Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding [vehicle_brands]}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddBrandCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingBrand}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewBrandName}" PlaceholderText="Yeni marka"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddBrandCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddBrandCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                    <ctrl:FormField Label="Model">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Models}" SelectedItem="{Binding SelModel}" PlaceholderText="Model seç / ara..."/>
                                <Button AutomationProperties.Name="Yeni model ekle" Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding [vehicle_models]}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddModelCommand}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingModel}">
                                <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewModelName}" PlaceholderText="Yeni model (önce marka)"/>
                                <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddModelCommand}"/>
                                <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddModelCommand}"/>
                            </Grid>
                        </StackPanel>
                    </ctrl:FormField>

                </StackPanel></Border>
                <!-- Uyumlu malzemeler (araç oluşturulurken kopyalanır) -->
                <SelectableTextBlock Text="Uyumlu Malzemeler" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Classes="Search" Text="{Binding MaterialSearch}" PlaceholderText="Malzeme ara (kod/ad)"/>
                            <Button Grid.Column="1" Classes="Secondary" Content="Tümünü Seç" Margin="8,0,0,0" Command="{Binding SelectAllMaterialsCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Temizle" Margin="6,0,0,0" Command="{Binding ClearMaterialsCommand}"/>
                        </Grid>
                        <Border Classes="Table" MaxHeight="160">
                            <ListBox ItemsSource="{Binding FilteredMaterials}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TplMaterialPick">
                                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Display}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>

                </StackPanel></Border>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding ClearCommand}"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding AddCommand}"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Liste + Detay -->
        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="*,340">
          <Panel Grid.Column="0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" ctrl:TableHeaderSync.Source="{Binding #TabloItems}" DockPanel.Dock="Top">
                        <Grid ctrl:ColumnRules.Enabled="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c2"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                            </Grid.ColumnDefinitions>
                            <SelectableTextBlock Grid.Column="0" Text="AD" MinWidth="160"/>
                            <SelectableTextBlock Grid.Column="1" Text="ÖRNEK KOD" MinWidth="110"/>
                            <SelectableTextBlock Grid.Column="2" Text="TİP" MinWidth="110"/>
                            <SelectableTextBlock Grid.Column="3" Text="MARKA/MODEL" MinWidth="150"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="TabloItems" Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <!-- ⭐ iOS tasarım (2026-10-28): satır SAĞ TIK menüsü — seçili kayıt işlemleri (ekrandaki düğmelerle aynı komut ve koşul) -->
                        <ListBox.ContextMenu>
                            <ContextMenu Classes="SatirMenusu">
                                <MenuItem Header="Düzenle" Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <Separator/>
                                <MenuItem Header="Sil" Command="{Binding RequestDeleteCommand}" IsVisible="{Binding CanDelete}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="inf:VehicleTemplateRow">
                                <Grid ctrl:ColumnRules.Enabled="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c2"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                    </Grid.ColumnDefinitions>
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" MinWidth="160" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding CodeDisplay}" MinWidth="110" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding TypeDisplay}" MinWidth="110" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding BrandModelDisplay}" MinWidth="150" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel ActionText="{Binding AddButtonText}" ActionCommand="{Binding ToggleAddCommand}" Mode="Empty" Title="Şablon yok" Message="Henüz araç genel tanımı eklenmedi.">
                <!-- ekleme formu açıkken gizli (form zaten açık; düğmesi küçük pencerede taşıyordu) -->
                <ctrl:StatePanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsEmpty"/>
                        <Binding Path="!ShowAdd"/>
                    </MultiBinding>
                </ctrl:StatePanel.IsVisible>
            </ctrl:StatePanel>
          </Panel>

          <!-- Detay -->
          <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding HasSelection}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                <SelectableTextBlock Text="UYUMLU MALZEMELER" Classes="SectionTitle"/>
                <ItemsControl ItemsSource="{Binding DetailMaterials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="inf:TemplateMaterialRow">
                            <SelectableTextBlock Classes="Body" Margin="0,1" Text="{Binding Name, StringFormat='• {0}'}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel>
                  <Button Classes="Primary" Content="Düzenle" Margin="0,0,8,0" Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}"/>
                  <Button Classes="Danger" Content="Sil" Command="{Binding RequestDeleteCommand}" IsVisible="{Binding CanDelete}"/>
                </WrapPanel>
              </StackPanel>
              <StackPanel Spacing="8" DataContext="{Binding Selected}">
                <SelectableTextBlock Text="{Binding Name}" Classes="PageTitle" TextWrapping="Wrap"/>
                <Border Classes="Divider"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Örnek Kod" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CodeDisplay}" Classes="Body"/>
                  <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Makine Tipi" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TypeDisplay}" Classes="Body"/>
                  <SelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Kategori" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CategoryName}" Classes="Body"/>
                  <SelectableTextBlock Grid.Row="3" Grid.Column="0" Text="Marka/Model" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BrandModelDisplay}" Classes="Body"/>
                  <SelectableTextBlock Grid.Row="4" Grid.Column="0" Text="Üretim Yılı" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding YearDisplay}" Classes="Body"/>
                </Grid>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding !HasSelection}">
            <SelectableTextBlock Text="Detay için bir şablon seçin." Classes="Helper" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>

        <SelectableTextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
