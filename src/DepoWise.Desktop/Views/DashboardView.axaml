<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:rep="using:DepoWise.Application.Reports"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer Background="{DynamicResource AppBackgroundBrush}" Padding="24">
        <StackPanel Spacing="20">

            <!-- Hata durumu -->
            <Border IsVisible="{Binding HasError}" Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius8}" Padding="12,10">
                <TextBlock Text="{Binding LoadError}" Classes="Body"
                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- ===== Güncelleme ===== -->
            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{StaticResource Radius8}" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Uygulama Sürümü" Classes="Helper"/>
                        <TextBlock Text="{Binding CurrentVersion}" Classes="Body" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding UpdateMessage}" Classes="Body" TextWrapping="Wrap"
                                   IsVisible="{Binding UpdateMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsUpdating}">
                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" Height="8"/>
                            <TextBlock Grid.Column="1" Text="{Binding UpdateProgress, StringFormat='%{0}'}" Classes="Helper" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="Primary" Content="⬇ Güncellemeyi Yükle" Command="{Binding InstallUpdateCommand}"
                                IsVisible="{Binding CanApplyUpdate}" ToolTip.Tip="İndir ve kur (DB korunur)"/>
                        <Button Classes="Secondary" Content="🔄 Güncelle" Command="{Binding CheckUpdateCommand}"
                                IsEnabled="{Binding !IsUpdating}" ToolTip.Tip="Güncelleme kontrol et"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Özet ===== -->
            <StackPanel Spacing="12" IsVisible="{Binding IsLoaded}">
                <TextBlock Text="ÖZET" Classes="SectionTitle"/>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KpiCard">
                            <Button Classes="Ghost" Padding="0" Margin="0,0,12,12" Cursor="Hand"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenCommand}"
                                    CommandParameter="{Binding NavKey}"
                                    ToolTip.Tip="İlgili ekranı aç">
                                <Border Classes="Kpi" Classes.primary="{Binding Primary}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Classes="IconChip" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Value}" Classes="KpiValue"/>
                                            <TextBlock Text="{Binding Label}" Classes="KpiLabel"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Kritik Uyarılar ===== -->
            <StackPanel Spacing="12" IsVisible="{Binding IsLoaded}">
                <TextBlock Text="KRİTİK UYARILAR" Classes="SectionTitle"/>

                <!-- Uyarı varsa: liste -->
                <ItemsControl ItemsSource="{Binding Alerts}" IsVisible="{Binding HasAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="rep:DashboardAlert">
                            <Button Classes="Ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenAlertCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="İlgili ekranı aç">
                            <Border Classes="AlertRow">
                                <Grid ColumnDefinitions="4,Auto,*,Auto">
                                    <!-- Sol renk çubuğu (kritik=kırmızı / değilse turuncu) -->
                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                            Background="{Binding IsCritical, Converter={x:Static vm:AlertBrush.Instance}}"/>
                                    <!-- İkon placeholder -->
                                    <Border Grid.Column="1" Width="26" Height="26" Margin="10,0,0,0"
                                            CornerRadius="{StaticResource Radius6}"
                                            Background="{Binding IsCritical, Converter={x:Static vm:AlertBrush.Instance}}"
                                            Opacity="0.22"/>
                                    <!-- Başlık + detay -->
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}" Classes="Body" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Classes="Helper"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Uyarı yoksa: kompakt empty-state -->
                <Border IsVisible="{Binding !HasAlerts}" Background="{DynamicResource SurfaceElevatedBrush}"
                        CornerRadius="{StaticResource Radius8}" Padding="14,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource SuccessBrush}">
                            <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Aktif kritik uyarı yok." Classes="Body" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
