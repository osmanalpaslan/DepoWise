<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:rep="using:DepoWise.Application.Reports"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="DepoWise.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer Background="{DynamicResource AppBackgroundBrush}" Padding="28,22,28,32">
        <StackPanel Spacing="22">

            <!-- ⭐ B DÜZENİ (kullanıcı seçimi + revizyon 2026-10-29): başlık · hızlı işlemler · tek satır özet ·
                 [Son hareketler | Filo durumu] · [Uyarılar | En çok çıkan malzemeler | Uygulama] · (varsa) takvim + duyurular.
                 "Son 6 Ay Yakıt" kartı kullanıcı isteğiyle KALDIRILDI. Kartlar üzerine gelince hafif yükselir (Ios.axaml AnaKart). -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Genel Durum" Classes="AnaBaslik"/>
                    <TextBlock Text="Bugün ilgilenmen gerekenler ve son durum" Classes="Helper" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <Panel Grid.Column="1" VerticalAlignment="Center">
                <!-- Makine + Şube (hap biçiminde) -->
                <WrapPanel>
                    <Border Classes="Hap" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                      Data="M4 4h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-6v2h3v2H7v-2h3v-2H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm1 2v8h14V6Z"/>
                            <SelectableTextBlock Text="Makine" Classes="Helper" VerticalAlignment="Center"/>
                            <SelectableTextBlock Text="{Binding MachineName}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="Hap" Padding="12,6" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                      Data="M4 21V3h10v6h6v12H4Zm2-2h2v-2H6Zm0-4h2v-2H6Zm0-4h2V9H6Zm0-4h2V5H6Zm4 12h2v-2h-2Zm0-4h2v-2h-2Zm0-4h2V9h-2Zm0-4h2V5h-2Zm6 12h2v-2h-2Zm0-4h2v-2h-2Z"/>
                            <SelectableTextBlock Text="Şube" Classes="Helper" VerticalAlignment="Center"/>
                            <SelectableTextBlock Text="{Binding BranchName}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                </Panel>
            </Grid>

            <!-- Hata durumu -->
            <Border IsVisible="{Binding HasError}" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius12}" Padding="14,10">
                <SelectableTextBlock Text="{Binding LoadError}" Classes="Body"
                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

                    <!-- ⭐ M-65 Hızlı işlemler — yalnız menüde görünen ekranlar (yetki menüyle aynı) -->
                    <StackPanel Spacing="12" IsVisible="{Binding HizliIslemVar}">
                        <SelectableTextBlock Text="Hızlı İşlemler" Classes="IosBaslik"/>
                        <ItemsControl ItemsSource="{Binding HizliIslemler}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" ColumnSpacing="14"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HizliIslem">
                                    <Button Classes="IosKartDugme"
                                            Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenCommand}"
                                            CommandParameter="{Binding NavKey}" ToolTip.Tip="{Binding Aciklama}">
                                        <Border Classes="IosKart" Padding="14">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Grid.Column="0" Classes="IkonKutu buyuk" Background="{Binding TileBrush}">
                                                    <PathIcon Data="{Binding Icon}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Baslik}" FontSize="15" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Aciklama}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" FontSize="20" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>


            <!-- Özet sayıları -->
            <StackPanel IsVisible="{Binding IsLoaded}">
                            <!-- Özet sayıları: TEK satır (B düzeni) -->
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="14"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KpiCard">
                                        <Button Classes="IosKartDugme"
                                                Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenCommand}"
                                                CommandParameter="{Binding NavKey}" ToolTip.Tip="İlgili ekranı aç">
                                            <Border Classes="IosKart" Padding="16,14" MinHeight="118">
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Border Classes="IkonKutu" Background="{Binding TileBrush}">
                                                            <PathIcon Data="{Binding Icon}" IsVisible="{Binding HasIcon}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <SelectableTextBlock Text="{Binding Value}" Classes="IosBuyukSayi"/>
                                                    <TextBlock Classes="KpiAlt" Classes.uyari="{Binding CaptionWarn}"
                                                               Text="{Binding Caption}" IsVisible="{Binding HasCaption}"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
            </StackPanel>

            <!-- Satır 2: Son hareketler (geniş) + Filo durumu -->
            <Grid ColumnDefinitions="1.6*,*" ColumnSpacing="18" IsVisible="{Binding IsLoaded}">
                <Border Grid.Column="0" Classes="IosKart AnaKart" Padding="18,16" IsVisible="{Binding StokKartlariVar}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Son Hareketler" Classes="AnaKartBaslik" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="AnaBag" Content="Tümü ›" Command="{Binding OpenCommand}" CommandParameter="stock"
                                    ToolTip.Tip="Malzeme Giriş-Çıkış ekranını aç"/>
                        </Grid>
                        <TextBlock Text="Henüz stok hareketi yok." Classes="Helper" IsVisible="{Binding !SonHareketVar}"/>
                        <ItemsControl ItemsSource="{Binding SonHareketler}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SonHareketSatiri">
                                    <Button Classes="IosSatir AnaSatir" Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenCommand}"
                                            CommandParameter="stock" ToolTip.Tip="{Binding Aciklama}">
                                        <Grid ColumnDefinitions="92,150,*,Auto" ColumnSpacing="12" Margin="8,9">
                                            <TextBlock Grid.Column="0" Text="{Binding Zaman}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{Binding TurFirca}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Tur}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Malzeme}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Classes.iptal="{Binding Iptal}"/>
                                                <TextBlock Text="{Binding Aciklama}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding AciklamaVar}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Miktar}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Panel Grid.Column="1">
                            <!-- Filo Durumu (B düzeni, kullanıcı isteği 2026-10-29: "pasta dilimi grafik şeklinde"): halka grafik — dilimler araç
                                 durumlarının payı, ortada toplam araç; sağda renkli lejant + sayılar. Tıklayınca araç listesi. -->
                            <Button Classes="IosKartDugme" Command="{Binding OpenCommand}" CommandParameter="vehicles"
                                    ToolTip.Tip="Araç listesini aç">
                                <Border Classes="IosKart" Padding="18,16">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Filo Durumu" Classes="AnaKartBaslik"/>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                                            <Panel Grid.Column="0" Width="140" Height="140">
                                                <ctrl:OranHalkasi x:Name="FiloHalkasi" Kalinlik="18"
                                                                  Deger1="{Binding AracAktif}" Deger2="{Binding AracBakimda}"
                                                                  Deger3="{Binding AracArizali}" Deger4="{Binding AracPasif}"
                                                                  Renk1="#30D158" Renk2="#FF9F0A" Renk3="#FF453A" Renk4="#8E8E93"
                                                                  IzRengi="{DynamicResource SurfaceHoverBrush}"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                                    <SelectableTextBlock Text="{Binding AracToplam}" Classes="IosBuyukSayi" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="araç" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Panel>
                                            <StackPanel Grid.Column="1" Spacing="11" VerticalAlignment="Center">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Ellipse Width="10" Height="10" Fill="#30D158" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Çalışıyor" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AracAktif}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Ellipse Width="10" Height="10" Fill="#FF9F0A" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Bakımda" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AracBakimda}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Ellipse Width="10" Height="10" Fill="#FF453A" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Arızalı" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AracArizali}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Ellipse Width="10" Height="10" Fill="#8E8E93" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Pasif" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AracPasif}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Button>
                </Panel>
            </Grid>

            <!-- Satır 3: Uyarılar (en solda) · En çok çıkan malzemeler · Uygulama sürümü ve otomatik güncelleme -->
            <Grid ColumnDefinitions="1.3*,*,*" ColumnSpacing="18">
                <Border Grid.Column="0" Classes="IosKart AnaKart" Padding="18,16" IsVisible="{Binding IsLoaded}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Uyarılar" Classes="AnaKartBaslik"/>
                        <!-- Kategori hapları (sayılı) — kullanıcı isteği 2026-07-25. Tıkla → o kategori; tekrar → hiçbiri. -->
                        <WrapPanel>
                            <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding AlertFilter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=material}"
                                    Command="{Binding SelectAlertCategoryCommand}" CommandParameter="material">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconMaterials}"/>
                                    <TextBlock Text="Malzeme" VerticalAlignment="Center"/>
                                    <Border Classes="adet"><TextBlock Text="{Binding MalzemeCount}"/></Border>
                                </StackPanel>
                            </Button>
                            <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding AlertFilter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=maintenance}"
                                    Command="{Binding SelectAlertCategoryCommand}" CommandParameter="maintenance">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconMaintenance}"/>
                                    <TextBlock Text="Bakım" VerticalAlignment="Center"/>
                                    <Border Classes="adet"><TextBlock Text="{Binding BakimCount}"/></Border>
                                </StackPanel>
                            </Button>
                            <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding AlertFilter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=inspection}"
                                    Command="{Binding SelectAlertCategoryCommand}" CommandParameter="inspection">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconInspection}"/>
                                    <TextBlock Text="Sigorta-Muayene" VerticalAlignment="Center"/>
                                    <Border Classes="adet"><TextBlock Text="{Binding MuayeneCount}"/></Border>
                                </StackPanel>
                            </Button>
                            <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding AlertFilter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=fuel}"
                                    Command="{Binding SelectAlertCategoryCommand}" CommandParameter="fuel">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconFuel}"/>
                                    <TextBlock Text="Yakıt" VerticalAlignment="Center"/>
                                    <Border Classes="adet"><TextBlock Text="{Binding YakitCount}"/></Border>
                                </StackPanel>
                            </Button>
                            <!-- PAN-01 (ADR-175, PK-L2): 4 yeni kategori HEP görünür — çan/Uyarılar ile hizalı. -->
                            <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding AlertFilter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=document}"
                                    Command="{Binding SelectAlertCategoryCommand}" CommandParameter="document">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconAudit}"/>
                                    <TextBlock Text="Evrak" VerticalAlignment="Center"/>
                                    <Border Classes="adet"><TextBlock Text="{Binding EvrakCount}"/></Border>
                                </StackPanel>
                            </Button>
                            <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding AlertFilter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=work_order}"
                                    Command="{Binding SelectAlertCategoryCommand}" CommandParameter="work_order">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconDailyActivity}"/>
                                    <TextBlock Text="İş Emri" VerticalAlignment="Center"/>
                                    <Border Classes="adet"><TextBlock Text="{Binding IsEmriCount}"/></Border>
                                </StackPanel>
                            </Button>
                            <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding AlertFilter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=request}"
                                    Command="{Binding SelectAlertCategoryCommand}" CommandParameter="request">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconRequests}"/>
                                    <TextBlock Text="Talep" VerticalAlignment="Center"/>
                                    <Border Classes="adet"><TextBlock Text="{Binding TalepCount}"/></Border>
                                </StackPanel>
                            </Button>
                            <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding AlertFilter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=announcement}"
                                    Command="{Binding SelectAlertCategoryCommand}" CommandParameter="announcement">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconAlerts}"/>
                                    <TextBlock Text="Duyuru" VerticalAlignment="Center"/>
                                    <Border Classes="adet"><TextBlock Text="{Binding DuyuruCount}"/></Border>
                                </StackPanel>
                            </Button>
                            <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding AlertFilter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=rental}"
                                    Command="{Binding SelectAlertCategoryCommand}" CommandParameter="rental">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Width="14" Height="14" Data="{DynamicResource IconVehicles}"/>
                                    <TextBlock Text="Kiralık" VerticalAlignment="Center"/>
                                    <Border Classes="adet"><TextBlock Text="{Binding KiralikCount}"/></Border>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Uyarı varsa: iOS gruplu liste -->
                        <Border Classes="IosGrup" IsVisible="{Binding HasAlerts}">
                            <ItemsControl ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="rep:DashboardAlert">
                                        <Button Classes="IosSatir"
                                                Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenAlertCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="İlgili ekranı aç">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,10,12,10">
                                                <!-- Renkli simge kutusu: kritik = kırmızı, yaklaşıyor = turuncu; simge uyarı TİPİNE göre -->
                                                <Border Grid.Column="0" Classes="IkonKutu" VerticalAlignment="Top"
                                                        Background="{Binding IsCritical, Converter={x:Static vm:AlertBrush.Instance}}">
                                                    <PathIcon Data="{Binding Kind, Converter={x:Static vm:AlertIcon.Instance}}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <SelectableTextBlock Text="{Binding Title}" Classes="Body" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <SelectableTextBlock Text="{Binding Detail}" Classes="Helper"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <!-- 2026-10-04: bilgilendirme notu — uyarı neden sürüyor / ne yapılmalı -->
                                                    <SelectableTextBlock Text="{Binding Note, StringFormat='ⓘ {0}'}" IsVisible="{Binding HasNote}" Classes="Helper"
                                                                         Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <!-- #18: okundu → ana ekrandan kaldır (ilgili modül ekranında kalır) -->
                                                <Button Grid.Column="2" Classes="Secondary" Content="okundu" VerticalAlignment="Center" Padding="12,6"
                                                        Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).MarkAlertReadCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Ana ekrandan gizle"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- İlk açılış: kategori seçilmedi → yalnız yönlendirme ipucu (uyarı listelenmez). -->
                        <Border IsVisible="{Binding ShowSelectPrompt}" Classes="IosGrup" Padding="16,12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Width="16" Height="16" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextMutedBrush}" Data="{DynamicResource IconInfo}"/>
                                <SelectableTextBlock Text="Uyarıları görmek için yukarıdan bir kategori seçin." Classes="Body" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Seçili kategori boş → o kategoride uyarı yok. -->
                        <Border IsVisible="{Binding ShowEmptyCategory}" Classes="IosGrup" Padding="16,12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#30D158">
                                    <PathIcon Width="13" Height="13" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="{DynamicResource IconCheck}"/>
                                </Border>
                                <SelectableTextBlock Text="Bu kategoride aktif kritik uyarı yok." Classes="Body" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="IosKart AnaKart" Padding="18,16" IsVisible="{Binding StokKartlariVar}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="1">
                            <TextBlock Text="En Çok Çıkan Malzemeler" Classes="AnaKartBaslik"/>
                            <TextBlock Text="Son 30 gün · çıkış ve bakım tüketimi" Classes="Helper" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Son 30 günde çıkış yok." Classes="Helper" IsVisible="{Binding !EnCokCikanVar}"/>
                        <ItemsControl ItemsSource="{Binding EnCokCikanlar}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CikanMalzeme">
                                    <StackPanel Spacing="5" Background="Transparent" ToolTip.Tip="{Binding Kod}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Ad}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Miktar}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                        <ProgressBar Classes="IosCubuk" Minimum="0" Maximum="100" Value="{Binding Oran}"
                                                     Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Panel Grid.Column="2">
                    <!-- Uygulama sürümü ve güncelleme (iOS ayar listesi gibi) -->
                    <Border Classes="IosKart AnaKart" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Uygulama" Classes="AnaKartBaslik" Margin="0,0,0,10"/>
                        <Border Classes="IosGrup">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,10">
                                    <Border Grid.Column="0" Classes="IkonKutu" Background="#8E8E93">
                                        <PathIcon Data="{DynamicResource IconInfo}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Uygulama Sürümü" Classes="Body" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding CurrentVersion}" Classes="Body" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextMutedBrush}"/>
                                </Grid>
                                <Border Classes="IosAyrac"/>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,8">
                                    <Border Grid.Column="0" Classes="IkonKutu" Background="#0A84FF">
                                        <PathIcon Data="{DynamicResource IconUpdate}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Otomatik güncelleme" Classes="Body" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding AutoUpdateEnabled}" VerticalAlignment="Center"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  AutomationProperties.Name="Otomatik güncelleme"
                                                  ToolTip.Tip="Açıkken yeni sürüm çıkınca otomatik onay penceresi gelir (reddedilirse 10 dk'da bir tekrar sorar)"/>
                                </Grid>
                                <Border Classes="IosAyrac"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="16,8">
                                    <Border Grid.Column="0" Classes="IkonKutu" Background="#30D158">
                                        <PathIcon Data="{DynamicResource IconSync}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="Secondary" Content="Kontrol Et" Command="{Binding CheckUpdateCommand}"
                                                IsEnabled="{Binding !IsUpdating}" ToolTip.Tip="Sunucuda yeni sürüm var mı diye kontrol eder (indirmez/kurmaz)"/>
                                        <Button Classes="Primary" Content="Güncellemeyi İndir ve Kur" Command="{Binding InstallUpdateCommand}"
                                                IsVisible="{Binding CanApplyUpdate}" ToolTip.Tip="Güncellemeyi indirir ve kurar (veritabanı korunur)"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="16,10,16,0" Spacing="6">
                            <Border Classes="Hap uyari" HorizontalAlignment="Left" IsVisible="{Binding UpdateAvailable}">
                                <TextBlock Text="Yeni güncelleme mevcut"/>
                            </Border>
                            <!-- ⭐ GNC-02: sürüm artık desteklenmiyorsa mesaj VURGULU gösterilir (engellemez, görünmez de bırakmaz). -->
                            <Border IsVisible="{Binding DesteklenmeyenSurum}"
                                    Background="{DynamicResource WarningSoftBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="12,8">
                                <SelectableTextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                            <!-- Normal mesaj: yalnız sürüm desteklenirken. -->
                            <SelectableTextBlock Text="{Binding UpdateMessage}" Classes="Helper" TextWrapping="Wrap"
                                       IsVisible="{Binding !DesteklenmeyenSurum}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsUpdating}">
                                <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" Height="8"/>
                                <SelectableTextBlock Grid.Column="1" Text="{Binding UpdateProgress, StringFormat='%{0}'}" Classes="Helper" VerticalAlignment="Center"/>
                            </Grid>
                            <Expander Header="Hata ayrıntılarını göster" IsVisible="{Binding HasUpdateError}">
                                <SelectableTextBlock Text="{Binding UpdateErrorDetail}" TextWrapping="Wrap"
                                                     FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                                                     Foreground="{DynamicResource DangerBrush}"/>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Panel>
            </Grid>

            <!-- Satır 4 (yalnız içerik varsa): bugünün takvimi + aktif duyurular -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <Panel Grid.Column="0">
                    <!-- PAN-01 (ADR-175, PK-L1): Bugünün Takvimi — yetki yoksa HİÇ görünmez; boş gün bilgidir. -->
                    <Button Classes="IosKartDugme" IsVisible="{Binding ShowTodayCalendar}"
                            Command="{Binding OpenCommand}" CommandParameter="calendar" ToolTip.Tip="Takvimi aç">
                        <Border Classes="IosKart" Padding="16,14">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Classes="IkonKutu" Background="#FF453A">
                                        <PathIcon Data="{DynamicResource IconCalendar}"/>
                                    </Border>
                                    <TextBlock Text="Bugünün Takvimi" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <SelectableTextBlock Text="Bugün için kayıt yok." Classes="Helper"
                                                     IsVisible="{Binding TodayCalendarEmpty}"/>
                                <ItemsControl ItemsSource="{Binding TodayCalendar}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="rep:DashboardCalendarRow">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4">
                                                <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                                                    <TextBlock Text="{Binding SourceDisplay}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Button>
                </Panel>
                <Panel Grid.Column="1">
                    <!-- Aktif duyurular -->
                    <Button Classes="IosKartDugme" IsVisible="{Binding ShowAnnouncements}"
                            Command="{Binding OpenCommand}" CommandParameter="announcements" ToolTip.Tip="Duyuruları aç">
                        <Border Classes="IosKart" Padding="16,14">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Classes="IkonKutu" Background="#FF2D55">
                                        <PathIcon Data="{DynamicResource IconAnnouncements}"/>
                                    </Border>
                                    <TextBlock Text="Aktif Duyurular" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding ActiveAnnouncements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="rep:DashboardAnnouncementRow">
                                            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="12" Padding="12,9" Margin="0,0,0,6">
                                                <StackPanel Spacing="4">
                                                    <Border Classes="Hap tehlike" HorizontalAlignment="Left" IsVisible="{Binding IsImportant}">
                                                        <TextBlock Text="Önemli"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Button>
                </Panel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
