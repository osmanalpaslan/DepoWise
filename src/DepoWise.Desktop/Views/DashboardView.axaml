<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:rep="using:DepoWise.Application.Reports"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="620"
             x:Class="DepoWise.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer Padding="24" Background="{DynamicResource Brand.Surface.Brush}">
        <StackPanel Spacing="20">

            <!-- KPI kartları (mavi dolu) -->
            <TextBlock Text="GENEL ÖZET" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource Brand.OnSurface.Brush}" Opacity="0.6"/>
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KpiCard">
                        <Border Width="200" Height="104" Margin="0,0,16,16" Padding="18"
                                Background="{DynamicResource Brand.Accent.Brush}"
                                CornerRadius="{DynamicResource Brand.CornerRadius}">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Icon}" FontSize="18"/>
                                    <TextBlock Text="{Binding Value}" FontSize="34" FontWeight="Bold"
                                               Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="White" Opacity="0.92"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Kritik uyarılar -->
            <TextBlock Text="KRİTİK UYARILAR" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource Brand.OnSurface.Brush}" Opacity="0.6"/>
            <Border Background="{DynamicResource Brand.Panel.Brush}" CornerRadius="{DynamicResource Brand.CornerRadius}"
                    BorderBrush="{DynamicResource Brand.Border.Brush}" BorderThickness="1" Padding="14">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="rep:DashboardAlert">
                                <Border Margin="0,2" Padding="14,11" CornerRadius="8"
                                        Background="{Binding IsCritical, Converter={x:Static vm:AlertBrush.Instance}}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="⚠️" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="White" Opacity="0.85"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aktif kritik uyarı yok. ✔" IsVisible="{Binding !HasAlerts}"
                               Foreground="{DynamicResource Brand.Success.Brush}" Padding="4"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
