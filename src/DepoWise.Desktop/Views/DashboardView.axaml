<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:rep="using:DepoWise.Application.Reports"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer Background="{DynamicResource AppBackgroundBrush}" Padding="24">
        <StackPanel Spacing="20">

            <!-- Makine + Şube -->
            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{StaticResource Radius8}" Padding="12,8" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                  Data="M4 4h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-6v2h3v2H7v-2h3v-2H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm1 2v8h14V6Z"/>
                        <SelectableTextBlock Text="Makine:" Classes="Helper" VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="{Binding MachineName}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Width="1" Background="{DynamicResource BorderSubtleBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                  Data="M4 21V3h10v6h6v12H4Zm2-2h2v-2H6Zm0-4h2v-2H6Zm0-4h2V9H6Zm0-4h2V5H6Zm4 12h2v-2h-2Zm0-4h2v-2h-2Zm0-4h2V9h-2Zm0-4h2V5h-2Zm6 12h2v-2h-2Zm0-4h2v-2h-2Z"/>
                        <SelectableTextBlock Text="Şube:" Classes="Helper" VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="{Binding BranchName}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hata durumu -->
            <Border IsVisible="{Binding HasError}" Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius8}" Padding="12,10">
                <SelectableTextBlock Text="{Binding LoadError}" Classes="Body"
                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- ===== Özet ===== -->
            <StackPanel Spacing="12" IsVisible="{Binding IsLoaded}">
                <SelectableTextBlock Text="ÖZET" Classes="SectionTitle"/>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KpiCard">
                            <Button Classes="Ghost" Padding="0" Margin="0,0,12,12" Cursor="Hand"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenCommand}"
                                    CommandParameter="{Binding NavKey}"
                                    ToolTip.Tip="İlgili ekranı aç">
                                <Border Classes="Kpi" Classes.primary="{Binding Primary}">
                                    <StackPanel Spacing="8" MinWidth="150">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <SelectableTextBlock Grid.Column="0" Text="{Binding Label}" Classes="KpiLabel"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Classes="IconChip" Width="26" Height="26"
                                                    CornerRadius="{StaticResource Radius6}" VerticalAlignment="Center">
                                                <!-- M6: kart tipine göre ikon. Önceden BEŞ kart da aynı kutuyu taşıyordu. -->
                                                <PathIcon Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Foreground="{DynamicResource AccentBrush}"
                                                          Data="{Binding Icon}" IsVisible="{Binding HasIcon}"/>
                                            </Border>
                                        </Grid>
                                        <SelectableTextBlock Text="{Binding Value}" Classes="KpiValue"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Kritik Uyarılar ===== -->
            <StackPanel Spacing="12" IsVisible="{Binding IsLoaded}">
                <SelectableTextBlock Text="KRİTİK UYARILAR" Classes="SectionTitle"/>

                <!-- Kategori butonları (sayılı) — kullanıcı isteği 2026-07-25. Tıkla → o kategori; tekrar → Tümü. -->
                <WrapPanel>
                    <Button Classes="Secondary" Margin="0,0,8,8" CornerRadius="999" Padding="14,7"
                            Command="{Binding SelectAlertCategoryCommand}" CommandParameter="material">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="15" Height="15" Data="M12 2 3 6.5v11L12 22l9-4.5v-11L12 2Zm0 2.2 6.5 3.3L12 10.8 5.5 7.5 12 4.2ZM5 9.2l6 3v7.1l-6-3V9.2Zm8 10.1v-7.1l6-3v7.1l-6 3Z"/>
                            <TextBlock Text="Malzeme" VerticalAlignment="Center"/>
                            <Border CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding MalzemeCount}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Classes="Secondary" Margin="0,0,8,8" CornerRadius="999" Padding="14,7"
                            Command="{Binding SelectAlertCategoryCommand}" CommandParameter="maintenance">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="15" Height="15" Data="M20.7 19.3 14 12.6a5.5 5.5 0 0 1-7.4-6.9l3.1 3.1 2.1-2.1L8.7 3.6A5.5 5.5 0 0 1 15.6 11l6.7 6.7-1.6 1.6Z"/>
                            <TextBlock Text="Bakım" VerticalAlignment="Center"/>
                            <Border CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding BakimCount}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Classes="Secondary" Margin="0,0,8,8" CornerRadius="999" Padding="14,7"
                            Command="{Binding SelectAlertCategoryCommand}" CommandParameter="inspection">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="15" Height="15" Data="M12 2 4 5v6c0 5 3.4 9.2 8 11 4.6-1.8 8-6 8-11V5l-8-3Zm0 2.2 6 2.2v4.6c0 3.9-2.5 7.3-6 8.9-3.5-1.6-6-5-6-8.9V6.4l6-2.2Z"/>
                            <TextBlock Text="Sigorta-Muayene" VerticalAlignment="Center"/>
                            <Border CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding MuayeneCount}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Classes="Secondary" Margin="0,0,8,8" CornerRadius="999" Padding="14,7"
                            Command="{Binding SelectAlertCategoryCommand}" CommandParameter="fuel">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="15" Height="15" Data="M14 3H5v18h9v-7h2v4a3 3 0 0 0 6 0V9l-3.5-3.5-1.4 1.4L19 8.9V18a1 1 0 0 1-2 0v-5h-3V3Zm-2 7H7V5h5v5Z"/>
                            <TextBlock Text="Yakıt" VerticalAlignment="Center"/>
                            <Border CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding YakitCount}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <!-- PAN-01 (ADR-175, PK-L2): 4 yeni kategori HEP görünür — çan/Uyarılar ile hizalı. -->
                    <Button Classes="Secondary" Margin="0,0,8,8" CornerRadius="999" Padding="14,7"
                            Command="{Binding SelectAlertCategoryCommand}" CommandParameter="document">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="15" Height="15" Data="{DynamicResource IconAudit}"/>
                            <TextBlock Text="Evrak" VerticalAlignment="Center"/>
                            <Border CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding EvrakCount}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Classes="Secondary" Margin="0,0,8,8" CornerRadius="999" Padding="14,7"
                            Command="{Binding SelectAlertCategoryCommand}" CommandParameter="work_order">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="15" Height="15" Data="{DynamicResource IconDailyActivity}"/>
                            <TextBlock Text="İş Emri" VerticalAlignment="Center"/>
                            <Border CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding IsEmriCount}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Classes="Secondary" Margin="0,0,8,8" CornerRadius="999" Padding="14,7"
                            Command="{Binding SelectAlertCategoryCommand}" CommandParameter="request">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="15" Height="15" Data="{DynamicResource IconRequests}"/>
                            <TextBlock Text="Talep" VerticalAlignment="Center"/>
                            <Border CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding TalepCount}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Classes="Secondary" Margin="0,0,8,8" CornerRadius="999" Padding="14,7"
                            Command="{Binding SelectAlertCategoryCommand}" CommandParameter="announcement">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="15" Height="15" Data="{DynamicResource IconAlerts}"/>
                            <TextBlock Text="Duyuru" VerticalAlignment="Center"/>
                            <Border CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding DuyuruCount}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Uyarı varsa: liste -->
                <ItemsControl ItemsSource="{Binding Alerts}" IsVisible="{Binding HasAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="rep:DashboardAlert">
                            <Button Classes="Ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenAlertCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="İlgili ekranı aç">
                            <Border Classes="AlertRow">
                                <Grid ColumnDefinitions="4,Auto,*,Auto">
                                    <!-- Sol renk çubuğu (kritik=kırmızı / değilse turuncu) -->
                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                            Background="{Binding IsCritical, Converter={x:Static vm:AlertBrush.Instance}}"/>
                                    <!-- İkon (uyarı tipine göre) -->
                                    <Panel Grid.Column="1" Width="26" Height="26" Margin="10,0,0,0">
                                        <Border CornerRadius="{StaticResource Radius8}"
                                                Background="{Binding IsCritical, Converter={x:Static vm:AlertBrush.Instance}}"
                                                Opacity="0.18"/>
                                        <!-- M6: uyarı TİPİNE göre ikon (bakım/muayene/stok/yakıt) — hepsi aynı üçgeni taşıyordu. -->
                                        <PathIcon Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{Binding IsCritical, Converter={x:Static vm:AlertBrush.Instance}}"
                                                  Data="{Binding Kind, Converter={x:Static vm:AlertIcon.Instance}}"/>
                                    </Panel>
                                    <!-- Başlık + detay -->
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                                        <SelectableTextBlock Text="{Binding Title}" Classes="Body" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <SelectableTextBlock Text="{Binding Detail}" Classes="Helper"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- #18: okundu → ana ekrandan kaldır (ilgili modül ekranında kalır) -->
                                    <Button Grid.Column="3" Classes="Secondary" Content="okundu" Margin="8,0,10,0" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).MarkAlertReadCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="Ana ekrandan gizle"/>
                                </Grid>
                            </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- İlk açılış: kategori seçilmedi → yalnız yönlendirme ipucu (uyarı listelenmez). -->
                <Border IsVisible="{Binding ShowSelectPrompt}" Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius12}" Padding="14,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Width="16" Height="16" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextMutedBrush}" Data="{DynamicResource IconInfo}"/>
                        <SelectableTextBlock Text="Uyarıları görmek için yukarıdan bir kategori seçin." Classes="Body" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Seçili kategori boş → o kategoride uyarı yok. -->
                <Border IsVisible="{Binding ShowEmptyCategory}" Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius12}" Padding="14,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource SuccessBrush}">
                            <PathIcon Width="13" Height="13" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="{DynamicResource IconCheck}"/>
                        </Border>
                        <SelectableTextBlock Text="Bu kategoride aktif kritik uyarı yok." Classes="Body" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== PAN-01 (ADR-175, PK-L1): Bugünün Takvimi + Aktif Duyurular =====
                 Yetki yoksa şerit HİÇ görünmez (summary null verir); takvim yetkisi varken boş gün bilgidir. -->
            <StackPanel Spacing="12" IsVisible="{Binding ShowTodayCalendar}">
                <SelectableTextBlock Text="BUGÜNÜN TAKVİMİ" Classes="SectionTitle"/>
                <Button Classes="Ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand"
                        Command="{Binding OpenCommand}" CommandParameter="calendar" ToolTip.Tip="Takvimi aç">
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius12}" Padding="14,10">
                        <StackPanel Spacing="4">
                            <SelectableTextBlock Text="Bugün için kayıt yok." Classes="Body"
                                                 IsVisible="{Binding TodayCalendarEmpty}"/>
                            <ItemsControl ItemsSource="{Binding TodayCalendar}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="rep:DashboardCalendarRow">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                            <TextBlock Text="{Binding SourceDisplay}" FontSize="11.5" Opacity="0.65" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Button>
            </StackPanel>
            <StackPanel Spacing="12" IsVisible="{Binding ShowAnnouncements}">
                <SelectableTextBlock Text="AKTİF DUYURULAR" Classes="SectionTitle"/>
                <Button Classes="Ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand"
                        Command="{Binding OpenCommand}" CommandParameter="announcements" ToolTip.Tip="Duyuruları aç">
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius12}" Padding="14,10">
                        <ItemsControl ItemsSource="{Binding ActiveAnnouncements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rep:DashboardAnnouncementRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                        <TextBlock Text="📢" FontSize="12" VerticalAlignment="Center"/>
                                        <Border CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                                Background="{DynamicResource DangerBrush}" IsVisible="{Binding IsImportant}">
                                            <TextBlock Text="Önemli" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Button>
            </StackPanel>

            <!-- ===== Güncelleme ===== -->
            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius12}" Padding="16,14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- M6: sürüm/güncelleme kartı ikonsuzdu. -->
                        <Border Width="26" Height="26" Classes="IconChip" CornerRadius="{StaticResource Radius6}"
                                VerticalAlignment="Center">
                            <PathIcon Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{DynamicResource AccentBrush}" Data="{DynamicResource IconUpdate}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <SelectableTextBlock Text="Uygulama Sürümü" Classes="Helper"/>
                            <SelectableTextBlock Text="{Binding CurrentVersion}" Classes="Body" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                CornerRadius="999" Padding="11,5"
                                HorizontalAlignment="Left" IsVisible="{Binding UpdateAvailable}">
                            <SelectableTextBlock Text="Yeni güncelleme mevcut" FontWeight="Bold"
                                                 Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <!-- ⭐ GNC-02: sürüm artık desteklenmiyorsa mesaj VURGULU gösterilir.
                             Engellemiyoruz (kullanıcı uzakta, kilitlenmemeli) ama görünmez de bırakmıyoruz:
                             eskiden BelowMinSupported hesaplanıyor ama hiçbir yerde kullanılmıyordu. -->
                        <Border IsVisible="{Binding DesteklenmeyenSurum}" Margin="0,0,0,6"
                                Background="{DynamicResource WarningSoftBrush}"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8">
                            <SelectableTextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <!-- Normal mesaj: yalnız sürüm desteklenirken. Desteklenmiyorsa üstteki vurgulu bant gösterilir. -->
                        <SelectableTextBlock Text="{Binding UpdateMessage}" Classes="Body" TextWrapping="Wrap"
                                   IsVisible="{Binding !DesteklenmeyenSurum}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsUpdating}">
                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" Height="8"/>
                            <SelectableTextBlock Grid.Column="1" Text="{Binding UpdateProgress, StringFormat='%{0}'}" Classes="Helper" VerticalAlignment="Center"/>
                        </Grid>
                        <Expander Header="Hata ayrıntılarını göster" IsVisible="{Binding HasUpdateError}" Margin="0,4,0,0">
                            <SelectableTextBlock Text="{Binding UpdateErrorDetail}" TextWrapping="Wrap"
                                                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                                                 Foreground="{DynamicResource DangerBrush}"/>
                        </Expander>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ToggleSwitch IsChecked="{Binding AutoUpdateEnabled}" VerticalAlignment="Center"
                                      OnContent="Otomatik: Açık" OffContent="Otomatik: Kapalı"
                                      ToolTip.Tip="Açıkken yeni sürüm çıkınca otomatik onay penceresi gelir (reddedilirse 10 dk'da bir tekrar sorar)"/>
                        <Button Classes="Primary" Content="Güncellemeyi İndir ve Kur" Command="{Binding InstallUpdateCommand}"
                                IsVisible="{Binding CanApplyUpdate}" ToolTip.Tip="Güncellemeyi indirir ve kurar (veritabanı korunur)"/>
                        <Button Classes="Secondary" Content="Kontrol Et" Command="{Binding CheckUpdateCommand}"
                                IsEnabled="{Binding !IsUpdating}" ToolTip.Tip="Sunucuda yeni sürüm var mı diye kontrol eder (indirmez/kurmaz)"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
