<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:rep="using:DepoWise.Application.Reports"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer Background="{DynamicResource AppBackgroundBrush}" Padding="24">
        <StackPanel Spacing="20">

            <!-- Makine + Şube -->
            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{StaticResource Radius8}" Padding="12,8" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SelectableTextBlock Text="🖥" VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="Makine:" Classes="Helper" VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="{Binding MachineName}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Width="1" Background="{DynamicResource BorderSubtleBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SelectableTextBlock Text="🏢" VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="Şube:" Classes="Helper" VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="{Binding BranchName}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hata durumu -->
            <Border IsVisible="{Binding HasError}" Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius8}" Padding="12,10">
                <SelectableTextBlock Text="{Binding LoadError}" Classes="Body"
                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- ===== Güncelleme ===== -->
            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="{StaticResource Radius8}" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <SelectableTextBlock Text="Uygulama Sürümü" Classes="Helper"/>
                        <SelectableTextBlock Text="{Binding CurrentVersion}" Classes="Body" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
                        <Border Background="{DynamicResource WarningBrush}" CornerRadius="6" Padding="10,4"
                                HorizontalAlignment="Left" IsVisible="{Binding UpdateAvailable}">
                            <SelectableTextBlock Text="🔔 Yeni güncelleme mevcut!" Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <SelectableTextBlock Text="{Binding UpdateMessage}" Classes="Body" TextWrapping="Wrap"
                                   IsVisible="{Binding UpdateMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsUpdating}">
                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" Height="8"/>
                            <SelectableTextBlock Grid.Column="1" Text="{Binding UpdateProgress, StringFormat='%{0}'}" Classes="Helper" VerticalAlignment="Center"/>
                        </Grid>
                        <Expander Header="Hata ayrıntılarını göster" IsVisible="{Binding HasUpdateError}" Margin="0,4,0,0">
                            <SelectableTextBlock Text="{Binding UpdateErrorDetail}" TextWrapping="Wrap"
                                                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                                                 Foreground="{DynamicResource DangerBrush}"/>
                        </Expander>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ToggleSwitch IsChecked="{Binding AutoUpdateEnabled}" VerticalAlignment="Center"
                                      OnContent="Otomatik: Açık" OffContent="Otomatik: Kapalı"
                                      ToolTip.Tip="Açıkken yeni sürüm çıkınca otomatik onay penceresi gelir (reddedilirse 10 dk'da bir tekrar sorar)"/>
                        <Button Classes="Primary" Content="⬇ Güncellemeyi İndir ve Kur" Command="{Binding InstallUpdateCommand}"
                                IsVisible="{Binding CanApplyUpdate}" ToolTip.Tip="Güncellemeyi indirir ve kurar (veritabanı korunur)"/>
                        <Button Classes="Secondary" Content="🔄 Kontrol Et" Command="{Binding CheckUpdateCommand}"
                                IsEnabled="{Binding !IsUpdating}" ToolTip.Tip="Sunucuda yeni sürüm var mı diye kontrol eder (indirmez/kurmaz)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Özet ===== -->
            <StackPanel Spacing="12" IsVisible="{Binding IsLoaded}">
                <SelectableTextBlock Text="ÖZET" Classes="SectionTitle"/>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KpiCard">
                            <Button Classes="Ghost" Padding="0" Margin="0,0,12,12" Cursor="Hand"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenCommand}"
                                    CommandParameter="{Binding NavKey}"
                                    ToolTip.Tip="İlgili ekranı aç">
                                <Border Classes="Kpi" Classes.primary="{Binding Primary}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Classes="IconChip" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                            <SelectableTextBlock Text="{Binding Value}" Classes="KpiValue"/>
                                            <SelectableTextBlock Text="{Binding Label}" Classes="KpiLabel"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Kritik Uyarılar ===== -->
            <StackPanel Spacing="12" IsVisible="{Binding IsLoaded}">
                <SelectableTextBlock Text="KRİTİK UYARILAR" Classes="SectionTitle"/>

                <!-- Kategori butonları (sayılı) — kullanıcı isteği 2026-07-25. Tıkla → o kategori; tekrar → Tümü. -->
                <WrapPanel>
                    <Button Classes="Secondary" Margin="0,0,8,8" Command="{Binding SelectAlertCategoryCommand}" CommandParameter="material"
                            Content="{Binding MalzemeCount, StringFormat='📦 Malzeme ({0})'}"/>
                    <Button Classes="Secondary" Margin="0,0,8,8" Command="{Binding SelectAlertCategoryCommand}" CommandParameter="maintenance"
                            Content="{Binding BakimCount, StringFormat='🔧 Bakım ({0})'}"/>
                    <Button Classes="Secondary" Margin="0,0,8,8" Command="{Binding SelectAlertCategoryCommand}" CommandParameter="inspection"
                            Content="{Binding MuayeneCount, StringFormat='🛡️ Sigorta-Muayene ({0})'}"/>
                    <Button Classes="Secondary" Margin="0,0,8,8" Command="{Binding SelectAlertCategoryCommand}" CommandParameter="fuel"
                            Content="{Binding YakitCount, StringFormat='⛽ Yakıt ({0})'}"/>
                </WrapPanel>

                <!-- Uyarı varsa: liste -->
                <ItemsControl ItemsSource="{Binding Alerts}" IsVisible="{Binding HasAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="rep:DashboardAlert">
                            <Button Classes="Ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenAlertCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="İlgili ekranı aç">
                            <Border Classes="AlertRow">
                                <Grid ColumnDefinitions="4,Auto,*,Auto">
                                    <!-- Sol renk çubuğu (kritik=kırmızı / değilse turuncu) -->
                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                            Background="{Binding IsCritical, Converter={x:Static vm:AlertBrush.Instance}}"/>
                                    <!-- İkon (uyarı tipine göre) -->
                                    <Panel Grid.Column="1" Width="26" Height="26" Margin="10,0,0,0">
                                        <Border CornerRadius="{StaticResource Radius6}"
                                                Background="{Binding IsCritical, Converter={x:Static vm:AlertBrush.Instance}}"
                                                Opacity="0.22"/>
                                        <SelectableTextBlock Text="{Binding Icon}" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Panel>
                                    <!-- Başlık + detay -->
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                                        <SelectableTextBlock Text="{Binding Title}" Classes="Body" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <SelectableTextBlock Text="{Binding Detail}" Classes="Helper"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- #18: okundu → ana ekrandan kaldır (ilgili modül ekranında kalır) -->
                                    <Button Grid.Column="3" Classes="Secondary" Content="okundu" Margin="8,0,10,0" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).MarkAlertReadCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="Ana ekrandan gizle"/>
                                </Grid>
                            </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Uyarı yoksa: kompakt empty-state -->
                <Border IsVisible="{Binding !HasAlerts}" Background="{DynamicResource SurfaceElevatedBrush}"
                        CornerRadius="{StaticResource Radius8}" Padding="14,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource SuccessBrush}">
                            <SelectableTextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <SelectableTextBlock Text="Aktif kritik uyarı yok." Classes="Body" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
