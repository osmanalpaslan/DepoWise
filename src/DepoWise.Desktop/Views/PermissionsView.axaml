<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:sec="using:DepoWise.Infrastructure.Security"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
             x:Class="DepoWise.Desktop.Views.PermissionsView"
             x:DataType="vm:PermissionsViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Yetkiler"/>

        <!-- Kullanıcı seçimi (önce kullanıcı seçilir → ağaç oluşur) -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <SelectableTextBlock Text="Kullanıcı" Classes="Helper" VerticalAlignment="Center"/>
                <ComboBox Classes="Field" Width="260" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="sec:UserRow"><SelectableTextBlock Text="{Binding Username}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadUsersCommand}"
                        IsVisible="{Binding !IsEditing}"/>

                <!-- YET-C3 (2026-08-19): ROL aynı ekranda. Rol, kullanıcının alabileceği yetkilerin
                     ÜST SINIRINI belirler; ayrı ekrana gitmek gerekmesin diye buraya alındı.
                     Yalnız düzenleme modunda açılır; kendi rolünü değiştirmek kilitlenme yarattığı
                     için o durumda kutu kapalı kalır (RoleEnabled). -->
                <SelectableTextBlock Text="Rol" Classes="Helper" VerticalAlignment="Center"
                                     IsVisible="{Binding HasUser}"/>
                <ComboBox Classes="Field" Width="190" ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding SelectedRole}" IsEnabled="{Binding RoleEnabled}"
                          IsVisible="{Binding HasUser}"
                          ToolTip.Tip="Rol, kullanıcının alabileceği yetkilerin üst sınırını belirler.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PermissionsViewModel+RoleOption">
                            <SelectableTextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Düzenle → Kaydet / Vazgeç. Ekran SALT-OKUNUR açılır; verilmiş yetkiler görünür
                     ama yanlışlıkla değiştirilemez. -->
                <Button Classes="Primary" Content="Düzenle" Command="{Binding BeginEditCommand}"
                        IsVisible="{Binding CanBeginEdit}"/>
                <!-- A3: şablondan doldurma — ayrı ekrana gitmeye gerek yok. Kutuları doldurur, KAYDETMEZ. -->
                <ComboBox Classes="Field" Width="200" ItemsSource="{Binding Templates}"
                          SelectedItem="{Binding SelectedTemplate}" IsEnabled="{Binding TemplateEnabled}"
                          IsVisible="{Binding TemplateEnabled}" PlaceholderText="Şablondan doldur"
                          ToolTip.Tip="Şablon yetkileri kutulara yazar; kaydetmez.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PermissionsViewModel+TemplateOption">
                            <SelectableTextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveCommand}" IsVisible="{Binding CanSavePerms}"/>
                <!-- ⭐ YTK-05: tüm ağacı tek hamlede temizler. Yalnız DÜZENLEME modunda görünür ve
                     sunucuya HİÇBİR ŞEY YAZMAZ — bu yüzden Danger değil Secondary. Yıkıcı olan,
                     yandaki "Yetkileri Sıfırla"dır. -->
                <Button Classes="Secondary" Content="Tümünü Temizle" Command="{Binding ClearAllPermsCommand}"
                        IsVisible="{Binding IsEditing}"
                        ToolTip.Tip="Ekrandaki tüm işaretleri kaldırır. Kaydet'e basmazsanız sunucuda hiçbir şey değişmez."/>
                <Button Classes="Secondary" Content="Vazgeç" Command="{Binding CancelEditCommand}"
                        IsVisible="{Binding IsEditing}"/>
                <!-- G1a (2026-08-12): yetki özeti + sıfırlama. Sıfırlama YIKICI → Danger + ayrıca onay penceresi. -->
                <Button Classes="Secondary" Content="Yetki Özeti" Command="{Binding ShowSummaryCommand}"
                        IsVisible="{Binding HasUser}" ToolTip.Tip="Bu kullanıcının gerçekte erişebildiği ekranları listeler."/>
                <Button Classes="Danger" Content="Yetkileri Sıfırla" Command="{Binding ResetPermsCommand}"
                        IsVisible="{Binding CanResetPerms}" IsEnabled="{Binding !IsEditing}"
                        ToolTip.Tip="Kullanıcının tüm ekran ve buton yetkilerini siler. Kullanıcı kaydı ve rolü silinmez."/>
            </StackPanel>
        </Border>

        <!-- Durum şeridi: ekranın salt-okunur mu düzenlenebilir mi olduğu ve bekleyen rol değişikliği -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8" CornerRadius="8"
                Background="{DynamicResource SurfaceElevatedBrush}"
                IsVisible="{Binding HasUser}">
            <StackPanel Spacing="4">
                <SelectableTextBlock Classes="Helper" IsVisible="{Binding !IsEditing}"
                    Text="Bu ekran şu an salt-okunur. Verilmiş yetkileri görüyorsunuz; değiştirmek için Düzenle deyin."/>
                <SelectableTextBlock Classes="Helper" IsVisible="{Binding IsEditing}"
                    Text="Düzenleme açık. İşaretli kutular mevcut yetkilerdir; değişiklikler Kaydet denene kadar yazılmaz."/>
                <SelectableTextBlock Classes="Helper" FontWeight="Bold"
                    Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding RoleChanged}"
                    Text="Rol değişikliği bekliyor — Kaydet dediğinizde önce rol yazılır, sonra yetki ağacı yeni role göre yenilenir."/>
            </StackPanel>
        </Border>

        <!-- Yetki ağacı (yalnız kullanıcı seçilince) -->
        <!-- ⭐ DÜZELTME (kullanıcı bildirimi 2026-09-06): "Korumalı Alanlar" bölümü ALT BAR gibi
             davranıp sayfanın içeriğini daraltıyordu. Grid'de Auto yükseklikli AYRI bir satırdaydı;
             listesi uzadıkça yetki ağacına kalan yeri sürekli yiyordu. Artık AYNI kaydırma alanının
             EN ALTINDA duruyor: ekranda sabit yer KAPLAMAZ, sayfa aşağı kaydırılınca gelir.
             Görünürlük kuralları DEĞİŞMEDİ: ağaç yalnız kullanıcı seçiliyken, korumalı alanlar
             (firma ayarı olduğu için) kullanıcı seçilmeden de görünür. -->
        <ScrollViewer Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Spacing="16">
                <StackPanel Spacing="16" IsVisible="{Binding HasUser}">
                <!-- ── ŞUBE KAPSAMI (G4-3e) ────────────────────────────────────────────────
                     İKİNCİ BİR YETKİ AĞACI DEĞİLDİR: modül yetkileri aşağıdaki ağaçta kalır.
                     Burada yalnız "hangi şubelerde" sorusu yönetilir.
                     ETKİN ERİŞİM = MODÜL YETKİSİ ∧ ŞUBE KAPSAMI ∧ PLATFORM ∧ diğer kurallar.
                     ⚠️ Liste AKTÖRÜN kapsamıyla kırpılmış gelir; asıl kapı serviste
                        (BranchAccess.RequireGrantable) — yetkisiz şube gönderilirse HATA verir. -->
                <Border Classes="Panel" IsVisible="{Binding ScopeLoaded}">
                    <StackPanel Spacing="8">
                        <SelectableTextBlock Text="Şube Kapsamı" Classes="SectionTitle"/>
                        <SelectableTextBlock Classes="Helper" TextWrapping="Wrap">
                            <Run Text="Mevcut kapsam:"/>
                            <Run Text="{Binding ScopeModeText}" FontWeight="Bold"/>
                        </SelectableTextBlock>
                        <SelectableTextBlock Text="{Binding ScopeHint}" Classes="Helper" TextWrapping="Wrap"/>

                        <!-- GUI-05: kapsam okunamadıysa SEBEP burada görünür. Eskiden hata Status'a
                             yazılıp hemen ardından yetki yüklemesince eziliyor, bölüm sessizce kayboluyordu. -->
                        <SelectableTextBlock Text="{Binding ScopeError}" Classes="Helper" TextWrapping="Wrap"
                                             Foreground="{DynamicResource DangerBrush}"
                                             IsVisible="{Binding ScopeError, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                        <Border Classes="Field" MaxHeight="160" Padding="8,4"
                                IsVisible="{Binding CanEditScope}">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding ScopeBranches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PermissionsViewModel+ScopePick">
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Button Classes="Primary" Content="Şube Kapsamını Kaydet"
                                Command="{Binding SaveBranchScopeCommand}"
                                IsVisible="{Binding CanEditScope}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Admin/Süper Admin hedef: tam yetkili, salt-okunur bilgi -->
                <Border Classes="Panel" IsVisible="{Binding IsTargetAdmin}">
                    <SelectableTextBlock TextWrapping="Wrap" Classes="Helper"
                        Text="Bu kullanıcı Admin / Süper Admin — TÜM ekranlara erişir (aşağıdaki alanlar bu yüzden tam işaretli ve salt-okunurdur). Yetkilerini kısıtlamak için önce rolünü Personel yapın."/>
                </Border>

                <!-- G1a: YETKİ ÖZETİ — ham izin satırı değil, ETKİN yetki (admin bypass'ı ve rol kilitleri uygulanmış). -->
                <Border Classes="Panel" IsVisible="{Binding HasSummary}">
                    <StackPanel Spacing="8">
                        <SelectableTextBlock Text="Yetki Özeti" Classes="SectionTitle"/>
                        <SelectableTextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Classes="Helper"/>
                        <Border Classes="Table" MaxHeight="260">
                            <ListBox Classes="Table" ItemsSource="{Binding Summary}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PermissionsViewModel+SummaryRow">
                                        <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="*,Auto">
                                            <SelectableTextBlock Grid.Column="0" Text="{Binding Label}" MinWidth="220" VerticalAlignment="Center"/>
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding Actions}" MinWidth="240" MaxWidth="240" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>
                <!-- ⭐ FAZ 3d — ARAMA · SÜZGEÇ · DEĞİŞİKLİK ROZETİ.
                     Yalnız GÖRÜNÜRLÜK süzer; hiçbir yetki kararı burada verilmez. -->
                <Border Classes="Panel">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Text="{Binding AgacArama}" Watermark="Ekran / alan ara…"
                                     ToolTip.Tip="Yazdıkça ağaç süzülür; eşleşmeyen gruplar gizlenir."/>
                            <CheckBox Grid.Column="1" Content="Yalnız verilenler" Margin="12,0,0,0"
                                      IsChecked="{Binding YalnizVerilenler}"
                                      ToolTip.Tip="Yalnız en az bir kutusu işaretli satırları gösterir."/>
                            <CheckBox Grid.Column="2" Content="Yalnız değişenler" Margin="12,0,0,0"
                                      IsChecked="{Binding YalnizDegisenler}"
                                      ToolTip.Tip="Yükledikten sonra değiştirdiğiniz satırları gösterir — kaydetmeden önce gözden geçirmek için."/>
                        </Grid>
                        <SelectableTextBlock Text="{Binding DegisiklikRozeti}" Classes="Helper" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Modüller -->
                <Border Classes="Table">
                    <DockPanel>
                        <Border Classes="TableHeader" DockPanel.Dock="Top">
                            <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="*,90,90,90,90">
                                <SelectableTextBlock Grid.Column="0" Text="EKRAN / MODÜL" MinWidth="200"/>
                                <SelectableTextBlock Grid.Column="1" Text="Görüntüle" TextAlignment="Center"/>
                                <SelectableTextBlock Grid.Column="2" Text="Ekle" TextAlignment="Center"/>
                                <SelectableTextBlock Grid.Column="3" Text="Düzenle" TextAlignment="Center"/>
                                <SelectableTextBlock Grid.Column="4" Text="Sil" TextAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- ⭐ 2026-09-03 (kullanıcı isteği): ağaç MENÜ GİBİ KATEGORİZE + grup başına
                             "Tümünü Seç"/"Temizle". Düğümler eski düz listeyle AYNI örneklerdir;
                             kaydetme yolu değişmedi. Rapor kalemleri "Raporlar" grubundadır. -->
                        <ItemsControl ItemsSource="{Binding Groups}" IsEnabled="{Binding TreeEnabled}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PermGroupNode">
                                    <StackPanel IsVisible="{Binding Gorunur}">
                                        <Border Background="{DynamicResource SurfaceElevatedBrush}" Padding="12,6" Margin="0,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <!-- ⭐ FAZ 3d: ÜÇ DURUMLU grup kutusu — hepsi / hiçbiri / KISMEN.
                                                     Kısmi durum artık görünür; işaretlemek görünen satırların
                                                     tamamını açar/kapatır. -->
                                                <CheckBox Grid.Column="0" IsThreeState="True" IsChecked="{Binding TumSecili}"
                                                          Margin="0,0,8,0" VerticalAlignment="Center"
                                                          ToolTip.Tip="Bu gruptaki GÖRÜNEN satırların tamamını işaretler/temizler. Kare işaret = grup kısmen yetkili."/>
                                                <SelectableTextBlock Grid.Column="1" Text="{Binding Title}" Classes="SectionTitle" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Classes="Ghost" Content="Tümünü Seç" FontSize="12" Padding="8,3"
                                                        Command="{Binding $parent[ItemsControl].((vm:PermissionsViewModel)DataContext).SelectAllInGroupCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Bu gruptaki tüm yetkileri işaretler; uygun olmayanları elle kaldırıp kaydedin."/>
                                                <Button Grid.Column="3" Classes="Ghost" Content="Temizle" FontSize="12" Padding="8,3"
                                                        Command="{Binding $parent[ItemsControl].((vm:PermissionsViewModel)DataContext).ClearAllInGroupCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Bu gruptaki tüm işaretleri kaldırır (kaydedene kadar yazılmaz)."/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ModulePermNode">
                                                    <!-- FAZ 3b-5: ALAN kalemlerinde (fld_*) "Yaz" ve "Sil" anlamsızdır;
                                                         o iki kutu HİÇ çizilmez ("—" yazılır). Web'deki PermMatrix ile
                                                         aynı karar; iki platform aynı şeyi gösterir. -->
                                                    <Grid ColumnDefinitions="*,90,90,90,90" Height="38" IsVisible="{Binding Gorunur}">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <!-- FAZ 3d: kaydedilmemiş değişiklik işareti -->
                                                            <TextBlock Text="●" Foreground="{DynamicResource WarningBrush}" FontSize="14"
                                                                       VerticalAlignment="Center" IsVisible="{Binding Degisti}"
                                                                       ToolTip.Tip="Bu satır değişti — henüz kaydedilmedi."/>
                                                            <SelectableTextBlock Text="{Binding Label}" MinWidth="180" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding CanView}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <CheckBox Grid.Column="2" IsChecked="{Binding CanCreate}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsVisible="{Binding IsModuleItem}"/>
                                                        <TextBlock Grid.Column="2" Text="—" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsFieldItem}"/>
                                                        <CheckBox Grid.Column="3" IsChecked="{Binding CanEdit}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <CheckBox Grid.Column="4" IsChecked="{Binding CanDelete}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsVisible="{Binding IsModuleItem}"/>
                                                        <TextBlock Grid.Column="4" Text="—" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsFieldItem}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Özel butonlar / "+" -->
                <SelectableTextBlock Text="ÖZEL BUTON / &quot;+&quot; YETKİLERİ" Classes="SectionTitle"/>
                <Border Classes="Table">
                    <ItemsControl ItemsSource="{Binding Buttons}" IsEnabled="{Binding TreeEnabled}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ButtonPermNode">
                                <CheckBox IsChecked="{Binding Granted}" Content="{Binding Label}" Margin="12,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <SelectableTextBlock Text="Verilmeyen modüller menüde/butonlarda görünmez (deny-by-default). Admin / Süper Admin her zaman tam yetkilidir; onlara yetki vermeye gerek yoktur."
                           Classes="Helper" TextWrapping="Wrap"/>
                </StackPanel>

            <!-- Kullanıcı seçilmeden -->
            <ctrl:StatePanel Margin="0,16,0,0" Mode="Empty" Title="Kullanıcı seçin"
                             Message="Yetki ağacını görmek için yukarıdan bir kullanıcı seçin." IsVisible="{Binding !HasUser}"/>

            <!-- ═══ FAZ 3b-5 (ADR-223) — KORUMALI ALANLAR ═══════════════════════════════════════
                 FİRMA ayarıdır, kişiye özel DEĞİLDİR → kullanıcı seçilmeden de görünür ve yönetilir
                 (web'deki bölümle aynı davranış). Korumalı yapılan alan YETKİ AĞACINDA ayrı bir satır
                 olarak belirir; kimin göreceği oradan seçilir. Karar aynı servisten gelir. -->
            <StackPanel Margin="0,16,0,0" IsVisible="{Binding KorumaYonetebilir}">
                <SelectableTextBlock Text="KORUMALI ALANLAR" Classes="SectionTitle"/>
                <SelectableTextBlock Classes="Helper" TextWrapping="Wrap"
                    Text="Bir alanı korumalı yaparsanız o alanı yalnız yetkisi olan kişiler görür. Yetkiyi yukarıdaki yetki ağacından, alanın kendi ekranının altından verirsiniz. Hiçbir alan korumalı değilken uygulama bugünkü gibi çalışır."/>
                <Border Classes="Table">
                    <ItemsControl ItemsSource="{Binding KorumaliAlanlar}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KorumaliAlanNode">
                                <Grid ColumnDefinitions="280,*" Margin="12,6">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Korumali}" VerticalAlignment="Center">
                                        <StackPanel>
                                            <SelectableTextBlock Text="{Binding Label}"/>
                                            <SelectableTextBlock Text="{Binding ScreenLabel}" Classes="Helper"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Note}" Classes="Helper"
                                                         TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <SelectableTextBlock Text="{Binding KorumaStatus}" Classes="Helper" TextWrapping="Wrap"
                                     IsVisible="{Binding KorumaStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            </StackPanel>
        </ScrollViewer>



        <SelectableTextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
