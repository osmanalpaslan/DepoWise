<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:inf="using:DepoWise.Infrastructure.Maintenance"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:veh="using:DepoWise.Infrastructure.Vehicles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.MaintenanceView"
             x:DataType="vm:MaintenanceViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="*,Auto">
        <TabControl Grid.Row="0" Classes="NoHeader" SelectedIndex="{Binding SelectedTab}">

            <!-- ═══════════ BAKIM TANIMLARI ═══════════ -->
            <TabItem Header="Bakım Tanımları">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
                    <ctrl:Toolbar Grid.Row="0" Title="Bakım Tanımları"
                                  PrimaryActionText="{Binding AddDefButtonText}" PrimaryActionCommand="{Binding ToggleDefAddCommand}">
                        <ctrl:Toolbar.FilterContent>
                            <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadDefsCommand}"/>
                        </ctrl:Toolbar.FilterContent>
                    </ctrl:Toolbar>

                    <!-- Yeni/düzenle tanım formu -->
                    <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowDefAdd}">
                        <Border.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddDefCommand}"/>
                            <KeyBinding Gesture="Escape" Command="{Binding ClearDefCommand}"/>
                        </Border.KeyBindings>
                        <ScrollViewer MaxHeight="380">
                        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
                            <SelectableTextBlock Text="{Binding DefFormTitle}" Classes="SectionTitle"/>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <ctrl:FormField Label="Tanım Adı" IsRequired="True" Width="280"
                                                HasError="{Binding HasDefNameError}" ErrorText="{Binding DefNameError}">
                                    <TextBox Classes="Field" Text="{Binding DefName}" />
                                </ctrl:FormField>
                                <ctrl:FormField Label="Periyot" Width="140">
                                    <NumericUpDown Classes="Field" Value="{Binding DefIntervalValue}" Minimum="0"
                                                   FormatString="0.##" ShowButtonSpinner="False"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Birim" Width="120">
                                    <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding DefUnitDisplay}"/>
                                </ctrl:FormField>
                            </StackPanel>
                            <ctrl:FormField Label="Açıklama">
                                <TextBox Classes="Field" Text="{Binding DefDescription}" AcceptsReturn="True" Height="52"/>
                            </ctrl:FormField>

                            <ctrl:FormField Label="İlişkili Araçlar (periyodik takip)"
                                            HelpText="Seçilen araçlar bu bakım için periyodik takip edilir.">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBox Grid.Column="0" Classes="Search" Text="{Binding VehicleSearch}" PlaceholderText="Araç ara (kod/plaka)"/>
                                        <Button Grid.Column="1" Classes="Secondary" Content="Tümünü Seç" Margin="8,0,0,0" Command="{Binding SelectAllVehiclesCommand}"/>
                                        <Button Grid.Column="2" Classes="Ghost" Content="Temizle" Margin="6,0,0,0" Command="{Binding ClearVehiclesCommand}"/>
                                    </Grid>
                                    <Border Classes="Table" MaxHeight="150">
                                        <ListBox ItemsSource="{Binding FilteredVehicles}" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:VehiclePick">
                                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Display}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                            </ctrl:FormField>

                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <Button Classes="Secondary" Content="İptal" Command="{Binding ClearDefCommand}"/>
                                <Button Classes="Primary" Content="Kaydet" Command="{Binding AddDefCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Liste + Detay -->
                    <Grid Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="*,360">
                        <Panel Grid.Column="0">
                            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasDefs}">
                                <DockPanel>
                                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <SelectableTextBlock Grid.Column="0" Text="BAKIM TANIMI" MinWidth="180"/>
                                            <SelectableTextBlock Grid.Column="1" Text="PERİYOT" MinWidth="120"/>
                                        </Grid>
                                    </Border>
                                    <ListBox Classes="Table" ItemsSource="{Binding Defs}" SelectedItem="{Binding SelectedDef}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="inf:MaintenanceDefinitionRow">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" MinWidth="180" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <SelectableTextBlock Grid.Column="1" Text="{Binding IntervalDisplay}" MinWidth="120" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding DefsError}"
                                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadDefsCommand}" IsVisible="{Binding HasDefsError}"/>
                            <ctrl:StatePanel Mode="Empty" Title="Tanım yok" Message="Henüz bakım tanımı eklenmedi." IsVisible="{Binding DefsEmpty}"/>
                        </Panel>

                        <!-- Tanım detayı -->
                        <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding HasDefSelection}">
                            <ScrollViewer>
                                <StackPanel Spacing="10">
                                    <SelectableTextBlock Text="{Binding SelectedDef.Name}" Classes="PageTitle" TextWrapping="Wrap"/>
                                    <ctrl:StatusBadge Kind="Info" Text="{Binding SelectedDef.IntervalDisplay}" HorizontalAlignment="Left"/>
                                    <SelectableTextBlock Text="{Binding SelectedDef.Description}" Classes="Helper" TextWrapping="Wrap"
                                               IsVisible="{Binding SelectedDef.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <Border Classes="Divider"/>

                                    <SelectableTextBlock Text="ALT BAKIM TANIMLARI" Classes="SectionTitle"/>
                                    <ItemsControl ItemsSource="{Binding SubDefs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="inf:MaintenanceDefinitionRow">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" Classes="Body" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="Ghost" Content="Sil"
                                                            Command="{Binding $parent[ItemsControl].((vm:MaintenanceViewModel)DataContext).DeleteSubDefCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanWrite}">
                                        <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewSubDefName}" PlaceholderText="Yeni alt bakım adı"/>
                                        <Button Grid.Column="1" Classes="Secondary" Content="Ekle" Margin="8,0,0,0" Command="{Binding AddSubDefCommand}"/>
                                    </Grid>

                                    <Border Classes="Divider"/>
                                    <WrapPanel>
                                        <Button Classes="Primary" Content="Düzenle" Margin="0,0,8,0" Command="{Binding BeginEditDefCommand}" IsVisible="{Binding CanEdit}"/>
                                        <Button Classes="Danger" Content="Sil" Command="{Binding RequestDeleteDefCommand}" IsVisible="{Binding CanDelete}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding !HasDefSelection}">
                            <SelectableTextBlock Text="Detay/alt bakım için bir tanım seçin." Classes="Helper" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════ ARAÇ BAKIMLARI ═══════════ -->
            <TabItem Header="Araç Bakımları">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
                    <ctrl:Toolbar Grid.Row="0" Title="Araç Bakımları"
                                  PrimaryActionText="{Binding AddMntButtonText}" PrimaryActionCommand="{Binding ToggleMntAddCommand}">
                        <ctrl:Toolbar.FilterContent>
                            <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadMaintCommand}"/>
                        </ctrl:Toolbar.FilterContent>
                    </ctrl:Toolbar>

                    <!-- Yeni bakım kaydı formu -->
                    <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowMntAdd}">
                        <ScrollViewer MaxHeight="420">
                        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                            <SelectableTextBlock Text="YENİ BAKIM KAYDI" Classes="SectionTitle"/>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <ctrl:FormField Label="Araç" IsRequired="True" Width="220">
                                    <AutoCompleteBox ItemsSource="{Binding MntVehicles}" SelectedItem="{Binding MntVehicle}"
                                                     FilterMode="Contains" MinimumPrefixLength="0" PlaceholderText="İç kod / plaka ara..."
                                                     ValueMemberBinding="{Binding Display}">
                                        <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="veh:VehicleListRow"><SelectableTextBlock Text="{Binding Display}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Bakım Tanımı" IsRequired="True" Width="220">
                                    <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding MntDefs}" SelectedItem="{Binding MntDef}">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="inf:MaintenanceDefinitionRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Alt Bakım" Width="240">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding MntSubDefs}" SelectedItem="{Binding MntSubDef}">
                                                <ComboBox.ItemTemplate><DataTemplate x:DataType="inf:MaintenanceDefinitionRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0" ToolTip.Tip="Yeni alt bakım" Command="{Binding StartAddMntSubCommand}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingMntSub}">
                                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewMntSubName}" PlaceholderText="Yeni alt bakım adı"/>
                                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddMntSubCommand}"/>
                                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddMntSubCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </ctrl:FormField>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <ctrl:FormField Label="Teknisyen" Width="200">
                                    <AutoCompleteBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Technicians}" SelectedItem="{Binding MntTechnician}"
                                              FilterMode="Contains" MinimumPrefixLength="0" PlaceholderText="Teknisyen ara..." ValueMemberBinding="{Binding Name}">
                                        <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Yapılma KM" Width="130">
                                    <NumericUpDown Classes="Field" Value="{Binding MntKm}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Yapılma Saat" Width="130">
                                    <NumericUpDown Classes="Field" Value="{Binding MntHour}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Tarih" Width="160">
                                    <DatePicker Classes="Field" SelectedDate="{Binding MntDate}"/>
                                </ctrl:FormField>
                            </StackPanel>
                            <ctrl:FormField Label="Açıklama">
                                <TextBox Classes="Field" Text="{Binding MntDescription}" AcceptsReturn="True" Height="48"/>
                            </ctrl:FormField>

                            <!-- Araç durumu: bakım kaydı açarken aracı "Arızalı" vb. işaretle. Boş = dokunma. -->
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <ctrl:FormField Label="Araç Durumu (değiştir)" Width="180"
                                                HelpText="Boş = aracın durumu değişmez.">
                                    <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding VehicleStatusOptions}" SelectedItem="{Binding MntVehStatus}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StatusPick"><SelectableTextBlock Text="{Binding Label}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Araç Durum Açıklaması" Width="320" IsVisible="{Binding ShowVehStatusNote}"
                                                HelpText="Arıza/bakım sebebi (araç kartına yazılır).">
                                    <TextBox Classes="Field" Text="{Binding MntVehStatusNote}"/>
                                </ctrl:FormField>
                            </StackPanel>

                            <ctrl:FormField Label="Malzemeler (stoktan düşülür)">
                                <StackPanel Spacing="6">
                                    <TextBox Classes="Search" Text="{Binding MntMaterialSearch}" PlaceholderText="Malzeme ara (kod/ad)"/>
                                    <Border Classes="Table" MaxHeight="120">
                                        <ScrollViewer>
                                            <ItemsControl ItemsSource="{Binding MntMaterialResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="m:MaterialRefRow">
                                                        <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Name}"
                                                                Command="{Binding $parent[ItemsControl].((vm:MaintenanceViewModel)DataContext).AddMntMaterialCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding MntLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MntMaterialLine">
                                                <Grid ColumnDefinitions="*,120,Auto" Margin="0,2">
                                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" Classes="Body" VerticalAlignment="Center"/>
                                                    <NumericUpDown Grid.Column="1" Classes="Field" Value="{Binding Quantity}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                                                    <Button Grid.Column="2" Classes="Ghost" Content="Kaldır" Margin="6,0,0,0"
                                                            Command="{Binding $parent[ItemsControl].((vm:MaintenanceViewModel)DataContext).RemoveMntLineCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ctrl:FormField>

                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <Button Classes="Secondary" Content="İptal" Command="{Binding ClearMntCommand}"/>
                                <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveMntCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="*,340">
                        <Panel Grid.Column="0">
                            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasMaint}">
                                <DockPanel>
                                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="m1"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="m3"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="m4"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="m5"/>
                                            </Grid.ColumnDefinitions>
                                            <SelectableTextBlock Grid.Column="0" Text="ARAÇ" MinWidth="90"/>
                                            <SelectableTextBlock Grid.Column="1" Text="BAKIM" MinWidth="140"/>
                                            <SelectableTextBlock Grid.Column="2" Text="YAPILMA" MinWidth="100"/>
                                            <SelectableTextBlock Grid.Column="3" Text="SONRAKİ" MinWidth="100"/>
                                            <SelectableTextBlock Grid.Column="4" Text="DURUM" MinWidth="70"/>
                                        </Grid>
                                    </Border>
                                    <ListBox Classes="Table" ItemsSource="{Binding Maintenances}" SelectedItem="{Binding SelectedMaint}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="inf:MaintenanceRow">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="m1"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="m3"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="m4"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="m5"/>
                                                    </Grid.ColumnDefinitions>
                                                    <SelectableTextBlock Grid.Column="0" Text="{Binding VehicleCode}" MinWidth="90" VerticalAlignment="Center"/>
                                                    <SelectableTextBlock Grid.Column="1" Text="{Binding DefinitionName}" MinWidth="140" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <SelectableTextBlock Grid.Column="2" Text="{Binding PerformedDisplay}" MinWidth="100" VerticalAlignment="Center"/>
                                                    <SelectableTextBlock Grid.Column="3" Text="{Binding NextDueDisplay}" MinWidth="100" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <SelectableTextBlock Grid.Column="4" Text="{Binding StatusText}" MinWidth="70" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding MaintError}"
                                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadMaintCommand}" IsVisible="{Binding HasMaintError}"/>
                            <ctrl:StatePanel Mode="Empty" Title="Bakım kaydı yok" Message="Henüz bakım kaydı girilmedi." IsVisible="{Binding MaintEmpty}"/>
                        </Panel>

                        <!-- Detay -->
                        <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding HasMaintSelection}">
                            <ScrollViewer>
                                <StackPanel Spacing="10">
                                    <SelectableTextBlock Text="{Binding SelectedMaint.DefinitionName}" Classes="PageTitle" TextWrapping="Wrap"/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" DataContext="{Binding SelectedMaint}">
                                        <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Araç" Classes="Helper" Margin="0,2,12,2"/>
                                        <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VehicleCode}" Classes="Body"/>
                                        <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Alt Bakım" Classes="Helper" Margin="0,2,12,2"/>
                                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubDisplay}" Classes="Body"/>
                                        <SelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Yapılma" Classes="Helper" Margin="0,2,12,2"/>
                                        <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PerformedDisplay}" Classes="Body"/>
                                        <SelectableTextBlock Grid.Row="3" Grid.Column="0" Text="Sonraki" Classes="Helper" Margin="0,2,12,2"/>
                                        <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NextDueDisplay}" Classes="Body"/>
                                    </Grid>
                                    <Border Classes="Divider"/>
                                    <SelectableTextBlock Text="KULLANILAN MALZEMELER" Classes="SectionTitle"/>
                                    <ItemsControl ItemsSource="{Binding MaintMaterials}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="inf:MaintenanceMaterialRow">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" Classes="Body"/>
                                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Quantity}" Classes="Body" FontWeight="SemiBold"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="Divider"/>
                                    <StackPanel Spacing="6" IsVisible="{Binding CanCancelSelected}">
                                        <ctrl:FormField Label="İptal Gerekçesi">
                                            <TextBox Classes="Field" Text="{Binding CancelReason}"/>
                                        </ctrl:FormField>
                                        <Button Classes="Danger" Content="Bakımı İptal Et" HorizontalAlignment="Left" Command="{Binding CancelMaintCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding !HasMaintSelection}">
                            <SelectableTextBlock Text="Detay için bir bakım kaydı seçin." Classes="Helper" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════ UYARILAR ═══════════ -->
            <TabItem Header="Uyarılar">
                <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                    <ctrl:Toolbar Grid.Row="0" Title="Periyodik Bakım Uyarıları">
                        <ctrl:Toolbar.FilterContent>
                            <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadAlertsCommand}"/>
                        </ctrl:Toolbar.FilterContent>
                    </ctrl:Toolbar>
                    <Panel Grid.Row="1" Margin="0,16,0,0">
                        <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                            <DockPanel>
                                <Border Classes="TableHeader" DockPanel.Dock="Top">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                        </Grid.ColumnDefinitions>
                                        <SelectableTextBlock Grid.Column="0" Text="ARAÇ" MinWidth="110"/>
                                        <SelectableTextBlock Grid.Column="1" Text="BAKIM TANIMI" MinWidth="160"/>
                                        <SelectableTextBlock Grid.Column="2" Text="İLERLEME" MinWidth="90"/>
                                        <SelectableTextBlock Grid.Column="3" Text="TÜKETİLEN / PERİYOT" MinWidth="150"/>
                                        <SelectableTextBlock Grid.Column="4" Text="DURUM" MinWidth="110"/>
                                    </Grid>
                                </Border>
                                <ListBox Classes="Table" ItemsSource="{Binding Items}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MaintenanceAlertRow">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                                </Grid.ColumnDefinitions>
                                                <SelectableTextBlock Grid.Column="0" Text="{Binding VehicleCode}" MinWidth="110" VerticalAlignment="Center"/>
                                                <SelectableTextBlock Grid.Column="1" Text="{Binding Definition}" MinWidth="160" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Definition}"/>
                                                <SelectableTextBlock Grid.Column="2" Text="{Binding ProgressText}" MinWidth="90" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <SelectableTextBlock Grid.Column="3" Text="{Binding ConsumedText}" MinWidth="150" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <ctrl:StatusBadge Grid.Column="4" MinWidth="110" VerticalAlignment="Center" Kind="{Binding LevelKind}" Text="{Binding LevelText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                                         ActionText="Tekrar Dene" ActionCommand="{Binding LoadAlertsCommand}" IsVisible="{Binding HasError}"/>
                        <ctrl:StatePanel Mode="Empty" Title="Bakım uyarısı yok" Message="Aktif periyodik bakım uyarısı bulunmuyor." IsVisible="{Binding IsEmpty}"/>
                    </Panel>
                </Grid>
            </TabItem>
        </TabControl>

        <SelectableTextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
