<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
             x:Class="DepoWise.Desktop.Views.MaintenanceView"
             x:DataType="vm:MaintenanceViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <ctrl:Toolbar Grid.Row="0" Title="Bakım Takibi">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <Panel Grid.Row="1" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ARAÇ" MinWidth="110"/>
                            <TextBlock Grid.Column="1" Text="BAKIM TANIMI" MinWidth="160"/>
                            <TextBlock Grid.Column="2" Text="İLERLEME" MinWidth="90"/>
                            <TextBlock Grid.Column="3" Text="TÜKETİLEN / PERİYOT" MinWidth="150"/>
                            <TextBlock Grid.Column="4" Text="DURUM" MinWidth="110"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MaintenanceAlertRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding VehicleCode}" MinWidth="110" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Definition}" MinWidth="160" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Definition}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" MinWidth="90" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ConsumedText}" MinWidth="150" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ctrl:StatusBadge Grid.Column="4" MinWidth="110" VerticalAlignment="Center"
                                                      Kind="{Binding LevelKind}" Text="{Binding LevelText}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}"
                             IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Bakım uyarısı yok"
                             Message="Aktif periyodik bakım uyarısı bulunmuyor."
                             IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,10,0,0"
                   Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
