<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="DepoWise.Desktop.Views.BackupView"
             x:DataType="vm:BackupViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Yedek Yönetimi"
                      PrimaryActionText="Yedek Al" PrimaryActionCommand="{Binding BackupCommand}">
            <ctrl:Toolbar.FilterContent>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="Secondary" Content="Sunucuya Yükle" Command="{Binding UploadToServerCommand}"
                            IsVisible="{Binding ServerConfigured}"/>
                    <Button Classes="Secondary" Content="Klasörü Aç" Command="{Binding OpenFolderCommand}"/>
                    <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
                </StackPanel>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <Panel Grid.Row="1" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="*,Auto,Auto,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="DOSYA" MinWidth="240"/>
                            <SelectableTextBlock Grid.Column="1" Text="BOYUT" MinWidth="100" MaxWidth="100"/>
                            <SelectableTextBlock Grid.Column="2" Text="TARİH" MinWidth="150" MaxWidth="150"/>
                            <SelectableTextBlock Grid.Column="3" Text="" MinWidth="120" MaxWidth="120"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackupRowVm">
                                <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="*,Auto,Auto,Auto">
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding FileName}" MinWidth="240" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding SizeText}" MinWidth="100" MaxWidth="100" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SizeText}" />
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding DateText}" MinWidth="150" MaxWidth="150" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DateText}" />
                                    <Button Grid.Column="3" Classes="Secondary" Content="Geri Yükle" MinWidth="120"
                                            Command="{Binding $parent[ItemsControl].((vm:BackupViewModel)DataContext).RestoreCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Yedek yok" Message="Henüz yedek alınmadı." IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
