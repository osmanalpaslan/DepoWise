<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:rep="using:DepoWise.Application.Reports"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
             x:Class="DepoWise.Desktop.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <ctrl:Toolbar Grid.Row="0" Title="Raporlar"/>

        <!-- Filtreler (ortak form bileşenleri) -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                <!-- Rapor listesi TEK KATALOĞA (ReportItems) göre; ComboBox raporun adını gösterir. -->
                <ctrl:FormField Label="Rapor" Width="220">
                    <ComboBox Classes="Field" ItemsSource="{Binding ReportItems}"
                              SelectedItem="{Binding SelectedReport}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="rep:ReportDescriptor"><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ctrl:FormField>
                <!-- Tarih yalnız rapor tarih kullanıyorsa (RequiresDate → Bu Ay ön-dolu). -->
                <ctrl:FormField Label="Başlangıç" Width="170" IsVisible="{Binding ShowDate}">
                    <DatePicker Classes="Field" SelectedDate="{Binding FromDate}"/>
                </ctrl:FormField>
                <ctrl:FormField Label="Bitiş" Width="170" IsVisible="{Binding ShowDate}">
                    <DatePicker Classes="Field" SelectedDate="{Binding ToDate}"/>
                </ctrl:FormField>
                <!-- Şube seçici (çoklu) yalnız rapor şube kullanıyorsa VE kullanıcı yetkiliyse (btn-branch-select).
                     İşaretsiz = oturum (login) şubesi (non-breaking). -->
                <ctrl:FormField Label="Şube (çoklu; boş=kendi şubem)" Width="230" IsVisible="{Binding ShowBranchSelect}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Branches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <Button Classes="Primary" Content="Sorgula" Command="{Binding RunCommand}" VerticalAlignment="Bottom"/>
                <Button Content="Excel'e Aktar" Command="{Binding ExportExcelCommand}" VerticalAlignment="Bottom"
                        ToolTip.Tip="Seçili rapor ve filtrelerle tüm sonucu Excel'e aktarır (yetki gerekir)."/>
            </StackPanel>
        </Border>

        <!-- Tablo / durumlar -->
        <Panel Grid.Row="2" Margin="0,16,0,0">
            <Border Classes="Table" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <ItemsControl ItemsSource="{Binding Headers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <SelectableTextBlock Text="{Binding}" MinWidth="160"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Rows}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <SelectableTextBlock Text="{Binding}" MinWidth="160" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ctrl:StatePanel Mode="Empty" Title="Rapor hazır" Message="Filtreleri seçip Sorgula'ya basın."
                             IsVisible="{Binding IsPrompt}"/>
            <ctrl:StatePanel Mode="Empty" Title="Sonuç yok" Message="Seçili kriterlere uygun veri bulunamadı."
                             IsVisible="{Binding IsEmptyResult}"/>
            <ctrl:StatePanel Mode="Error" Title="Rapor çalıştırılamadı" Message="{Binding LoadError}"
                             IsVisible="{Binding HasError}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0"
                   Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
