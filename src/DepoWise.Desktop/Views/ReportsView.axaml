<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:rep="using:DepoWise.Application.Reports"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
             x:Class="DepoWise.Desktop.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <ctrl:Toolbar Grid.Row="0" Title="Raporlar"/>

        <!-- Filtreler (ortak form bileşenleri) -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0">
            <!-- DUZELTME (final QA olcumu 2026-09-06): bu satir yatay StackPanel idi; dar pencerede
                 Excel disa aktarma dugmesi pencere DISINDA kaliyordu (1154 px de 91 px olculdu).
                 WrapPanel dar pencerede alt satira sarar; genis pencerede gorunum aynidir. -->
            <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="10" VerticalAlignment="Bottom">
                <!-- Rapor listesi TEK KATALOĞA (ReportItems) göre; ComboBox raporun adını gösterir. -->
                <ctrl:FormField Label="Rapor" Width="220">
                    <ComboBox Classes="Field" ItemsSource="{Binding ReportItems}"
                              SelectedItem="{Binding SelectedReport}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="rep:ReportDescriptor"><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ctrl:FormField>
                <!-- Tarih yalnız rapor tarih kullanıyorsa (RequiresDate → Bu Ay ön-dolu). -->
                <ctrl:FormField Label="Başlangıç" Width="280" IsVisible="{Binding ShowDate}">
                    <DatePicker Classes="Field" SelectedDate="{Binding FromDate}"/>
                </ctrl:FormField>
                <ctrl:FormField Label="Bitiş" Width="280" IsVisible="{Binding ShowDate}">
                    <DatePicker Classes="Field" SelectedDate="{Binding ToDate}"/>
                </ctrl:FormField>
                <!-- Şube seçici (çoklu) yalnız rapor şube kullanıyorsa VE kullanıcı yetkiliyse (btn-branch-select).
                     İşaretsiz = oturum (login) şubesi (non-breaking). -->
                <ctrl:FormField Label="Şube / Şantiye (çoklu; boş=kendi şubem)" Width="230" IsVisible="{Binding ShowBranchSelect}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Branches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- Araç Türü filtresi (Araç Raporu) — çoklu işaret. -->
                <ctrl:FormField Label="Araç Türü (çoklu)" Width="180" IsVisible="{Binding ShowVehicleType}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding VehicleTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- Araç seçimi (çoklu) — arama + Tümünü Seç (aramadaki, yoksa tümü) / Kaldır. Boş = tüm araçlar. -->
                <ctrl:FormField Label="Araç (çoklu; boş=tümü)" Width="240" IsVisible="{Binding ShowVehicleSelect}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Classes="Search" Text="{Binding VehicleSearch}" PlaceholderText="Araç ara (kod/plaka)"/>
                            <Button Grid.Column="1" Classes="Secondary" Content="Tümü" Margin="6,0,0,0" Command="{Binding SelectAllVehiclesCommand}"
                                    ToolTip.Tip="Aramadaki araçları (arama yoksa tümünü) seçer"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Kaldır" Margin="4,0,0,0" Command="{Binding ClearVehiclesCommand}"
                                    ToolTip.Tip="Araç seçimini temizler"/>
                        </Grid>
                        <Border Classes="Field" MaxHeight="120" Padding="8,4">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding FilteredVehiclePicks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VehiclePick">
                                            <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ctrl:FormField>
                <!-- Bakım Tanımı filtresi (Bakım Raporu) — çoklu işaret. -->
                <ctrl:FormField Label="Bakım Tanımı (çoklu)" Width="190" IsVisible="{Binding ShowMaintenanceDef}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding MaintenanceDefs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- Teknisyen filtresi (Bakım Raporu) — çoklu işaret. -->
                <ctrl:FormField Label="Teknisyen (çoklu)" Width="190" IsVisible="{Binding ShowTechnician}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Technicians}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- Tedarikçi filtresi (Depo Girişi) — çoklu işaret. -->
                <ctrl:FormField Label="Tedarikçi (çoklu)" Width="190" IsVisible="{Binding ShowSupplier}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Suppliers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- Talep Eden filtresi (Talep Raporu) — çoklu işaret (personel listesi). -->
                <ctrl:FormField Label="Talep Eden (çoklu)" Width="190" IsVisible="{Binding ShowRequester}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Requesters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- STK-06: STOK LOKASYONU filtresi (Stok Durumu + Stok Sayım). Boş = tüm depoların toplamı
                     (Atanmamış dahil). "📦 Atanmamış" AYRI seçenektir: lokasyonu bilinmeyen geçmiş stok —
                     gerçek bir depo değildir. Liste YEREL veriden gelir → çevrimdışı çalışır. -->
                <ctrl:FormField Label="Depo / Şantiye (boş=tümü)" Width="190" IsVisible="{Binding ShowLocation}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Locations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- STK-10b-2 (ADR-104 / KARAR-10): SERBEST METİN ARAMA. Semantiği mevcut Stok
                     Hareketleri ekranından AYNEN taşındı: kod · malzeme adı · not · fatura no ·
                     belge no. SKALER alan; filtre SUNUCU/SQL tarafında uygulanır. -->
                <ctrl:FormField Label="Ara (kod, malzeme, not, belge)" Width="230" IsVisible="{Binding ShowSearch}"
                                HelpText="Kod, malzeme adı, not, fatura no ve belge no içinde arar.">
                    <TextBox Classes="Search" Text="{Binding SearchText}" PlaceholderText="Ara..."/>
                </ctrl:FormField>
                <!-- STK-10b-1: STOK HAREKET TÜRÜ filtresi (Stok Hareketleri Raporu). Sabit liste, TEK
                     kaynak: MovementTypeOptions (STK-B1) → web ile AYNI seçenekler ve AYNI Türkçe
                     etiketler. Boş = tüm türler. Sorgu/ağ yok → çevrimdışı çalışır. -->
                <ctrl:FormField Label="Hareket Türü (çoklu; boş=tümü)" Width="200" IsVisible="{Binding ShowMovementType}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding MovementTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- ADR-182: GÜNLÜK FAALİYET KAYIT TİPİ filtresi. Hareket Türü ile AYNI desen; sabit
                     liste, TEK kaynak: DailyActivityTypeOptions → web ile AYNI seçenekler ve AYNI
                     Türkçe etiketler. Boş = TÜM tipler. Sorgu/ağ yok → çevrimdışı çalışır. -->
                <!-- Sıralama (kullanıcı isteği 2026-09-02): rapor satır sırasını kullanıcı seçer.
                     Seçenekler SABİT listedir (ReportSortOptions); kullanıcı metni SQL'e girmez. -->
                <ctrl:FormField Label="Sıralama" Width="200" IsVisible="{Binding ShowSort}">
                    <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                              ToolTip.Tip="Rapor satırlarının hangi sıraya göre listeleneceğini seçer.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BranchPick">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ctrl:FormField>

                <ctrl:FormField Label="Kayıt Tipi (çoklu; boş=tümü)" Width="200" IsVisible="{Binding ShowActivityType}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding ActivityTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- STK-10b-3: MALZEME filtresi (Stok Hareketleri Raporu). Liste ÖN YÜKLENMEZ — mevcut
                     yerel arama deseni (Materials.List(term), ilk 30) kullanılır: ağ YOK, çevrimdışı
                     çalışır. Seçilen malzemenin ADI kutuda görünür; isteğe materials.id gider.
                     "Temizle" seçimi kaldırır → filtre kalkar (web'deki Clearable ile aynı). -->
                <ctrl:FormField Label="Malzeme (kod/ad ile ara)" Width="230" IsVisible="{Binding ShowMaterial}"
                                HelpText="Boş = tüm malzemeler">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Classes="Search" Text="{Binding MaterialSearch}" PlaceholderText="Malzeme ara (kod/ad)"/>
                            <Button Grid.Column="1" Classes="Ghost" Content="Temizle" Margin="4,0,0,0"
                                    Command="{Binding ClearMaterialCommand}"/>
                        </Grid>
                        <Border Classes="Table" MaxHeight="110" IsVisible="{Binding MaterialResults.Count}">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding MaterialResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:MaterialRefRow">
                                            <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Content="{Binding Name}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ReportsViewModel)DataContext).PickMaterialCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ctrl:FormField>
                <!-- G4-4b — CARİ filtresi (ön muhasebe raporları). Malzeme seçicisinin AYNI deseni:
                     yaz → yerel arama → seç. Seçenekler ÖN YÜKLENMEZ; çevrimdışı çalışır.
                     Boş = tüm cariler (web'deki "Clearable" ile aynı semantik). -->
                <ctrl:FormField Label="Cari (kod/ünvan ile ara)" Width="230" IsVisible="{Binding ShowParty}"
                                HelpText="Boş = tüm cariler">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Classes="Search" Text="{Binding PartySearch}" PlaceholderText="Cari ara (kod/ünvan)"/>
                            <Button Grid.Column="1" Classes="Ghost" Content="Temizle" Margin="4,0,0,0"
                                    Command="{Binding ClearPartyCommand}"/>
                        </Grid>
                        <Border Classes="Table" MaxHeight="110" IsVisible="{Binding PartyResults.Count}">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding PartyResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReportsViewModel+PartyRefRow">
                                            <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Content="{Binding Display}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ReportsViewModel)DataContext).PickPartyCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ctrl:FormField>
                <!-- Durum filtresi (Talep Raporu) — sabit liste; boş = tüm durumlar. -->
                <ctrl:FormField Label="Durum (çoklu; boş=tümü)" Width="180" IsVisible="{Binding ShowStatus}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Statuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <Button Classes="Primary" Content="Sorgula" Command="{Binding RunCommand}" VerticalAlignment="Bottom"/>
                <Button Content="Excel'e Aktar" Command="{Binding ExportExcelCommand}" VerticalAlignment="Bottom"
                        ToolTip.Tip="Seçili rapor ve filtrelerle tüm sonucu Excel'e aktarır (yetki gerekir)."/>
            </WrapPanel>
        </Border>

        <!-- Katalog-sürümlü bilgi/metodoloji notu (varsa) — genel amaçlı (ReportDescriptor.InfoNote). -->
        <SelectableTextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="{Binding SelectedReport.InfoNote}"
                   IsVisible="{Binding SelectedReport.InfoNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- Tablo / durumlar -->
        <Panel Grid.Row="3" Margin="0,16,0,0">
            <!-- Ortak tablo bileşeni (Birim 4): kolon-altı filtre / sıralama / genişlik / gizleme + kişisel
                 tercih. Rapora özel değil — DataContext bir GridController'dır (Grid), rapor sonucu buraya beslenir. -->
            <ctrl:DataGridView DataContext="{Binding Grid}" IsVisible="{Binding HasRows}"/>

            <ctrl:StatePanel Mode="Empty" Title="Rapor hazır" Message="Filtreleri seçip Sorgula'ya basın."
                             IsVisible="{Binding IsPrompt}"/>
            <ctrl:StatePanel Mode="Empty" Title="Sonuç yok" Message="Seçili kriterlere uygun veri bulunamadı."
                             IsVisible="{Binding IsEmptyResult}"/>
            <ctrl:StatePanel Mode="Error" Title="Rapor çalıştırılamadı" Message="{Binding LoadError}"
                             IsVisible="{Binding HasError}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0"
                   Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
