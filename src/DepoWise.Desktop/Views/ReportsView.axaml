<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:rep="using:DepoWise.Application.Reports"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
             x:Class="DepoWise.Desktop.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <ctrl:Toolbar Grid.Row="0" Title="Raporlar"/>

        <!-- Filtreler (ortak form bileşenleri) -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                <!-- Rapor listesi TEK KATALOĞA (ReportItems) göre; ComboBox raporun adını gösterir. -->
                <ctrl:FormField Label="Rapor" Width="220">
                    <ComboBox Classes="Field" ItemsSource="{Binding ReportItems}"
                              SelectedItem="{Binding SelectedReport}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="rep:ReportDescriptor"><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ctrl:FormField>
                <!-- Tarih yalnız rapor tarih kullanıyorsa (RequiresDate → Bu Ay ön-dolu). -->
                <ctrl:FormField Label="Başlangıç" Width="170" IsVisible="{Binding ShowDate}">
                    <DatePicker Classes="Field" SelectedDate="{Binding FromDate}"/>
                </ctrl:FormField>
                <ctrl:FormField Label="Bitiş" Width="170" IsVisible="{Binding ShowDate}">
                    <DatePicker Classes="Field" SelectedDate="{Binding ToDate}"/>
                </ctrl:FormField>
                <!-- Şube seçici (çoklu) yalnız rapor şube kullanıyorsa VE kullanıcı yetkiliyse (btn-branch-select).
                     İşaretsiz = oturum (login) şubesi (non-breaking). -->
                <ctrl:FormField Label="Şube (çoklu; boş=kendi şubem)" Width="230" IsVisible="{Binding ShowBranchSelect}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Branches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- Araç Türü filtresi (Araç Raporu) — çoklu işaret. -->
                <ctrl:FormField Label="Araç Türü (çoklu)" Width="180" IsVisible="{Binding ShowVehicleType}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding VehicleTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- Araç seçimi (çoklu) — arama + Tümünü Seç (aramadaki, yoksa tümü) / Kaldır. Boş = tüm araçlar. -->
                <ctrl:FormField Label="Araç (çoklu; boş=tümü)" Width="240" IsVisible="{Binding ShowVehicleSelect}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Classes="Search" Text="{Binding VehicleSearch}" PlaceholderText="Araç ara (kod/plaka)"/>
                            <Button Grid.Column="1" Classes="Secondary" Content="Tümü" Margin="6,0,0,0" Command="{Binding SelectAllVehiclesCommand}"
                                    ToolTip.Tip="Aramadaki araçları (arama yoksa tümünü) seçer"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Kaldır" Margin="4,0,0,0" Command="{Binding ClearVehiclesCommand}"
                                    ToolTip.Tip="Araç seçimini temizler"/>
                        </Grid>
                        <Border Classes="Field" MaxHeight="120" Padding="8,4">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding FilteredVehiclePicks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VehiclePick">
                                            <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ctrl:FormField>
                <!-- Bakım Tanımı filtresi (Bakım Raporu) — çoklu işaret. -->
                <ctrl:FormField Label="Bakım Tanımı (çoklu)" Width="190" IsVisible="{Binding ShowMaintenanceDef}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding MaintenanceDefs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <!-- Teknisyen filtresi (Bakım Raporu) — çoklu işaret. -->
                <ctrl:FormField Label="Teknisyen (çoklu)" Width="190" IsVisible="{Binding ShowTechnician}">
                    <Border Classes="Field" MaxHeight="110" Padding="8,4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Technicians}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchPick">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </ctrl:FormField>
                <Button Classes="Primary" Content="Sorgula" Command="{Binding RunCommand}" VerticalAlignment="Bottom"/>
                <Button Content="Excel'e Aktar" Command="{Binding ExportExcelCommand}" VerticalAlignment="Bottom"
                        ToolTip.Tip="Seçili rapor ve filtrelerle tüm sonucu Excel'e aktarır (yetki gerekir)."/>
            </StackPanel>
        </Border>

        <!-- Katalog-sürümlü bilgi/metodoloji notu (varsa) — genel amaçlı (ReportDescriptor.InfoNote). -->
        <SelectableTextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="{Binding SelectedReport.InfoNote}"
                   IsVisible="{Binding SelectedReport.InfoNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- Tablo / durumlar -->
        <Panel Grid.Row="3" Margin="0,16,0,0">
            <!-- Ortak tablo bileşeni (Birim 4): kolon-altı filtre / sıralama / genişlik / gizleme + kişisel
                 tercih. Rapora özel değil — DataContext bir GridController'dır (Grid), rapor sonucu buraya beslenir. -->
            <ctrl:DataGridView DataContext="{Binding Grid}" IsVisible="{Binding HasRows}"/>

            <ctrl:StatePanel Mode="Empty" Title="Rapor hazır" Message="Filtreleri seçip Sorgula'ya basın."
                             IsVisible="{Binding IsPrompt}"/>
            <ctrl:StatePanel Mode="Empty" Title="Sonuç yok" Message="Seçili kriterlere uygun veri bulunamadı."
                             IsVisible="{Binding IsEmptyResult}"/>
            <ctrl:StatePanel Mode="Error" Title="Rapor çalıştırılamadı" Message="{Binding LoadError}"
                             IsVisible="{Binding HasError}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0"
                   Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
