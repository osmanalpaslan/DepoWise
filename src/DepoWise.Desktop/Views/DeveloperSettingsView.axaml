<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="440"
             x:Class="DepoWise.Desktop.Views.DeveloperSettingsView"
             x:DataType="vm:DeveloperSettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">
        <ctrl:Toolbar Grid.Row="0" Title="Ayarlar — Geliştirici Modu"/>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
                <Expander Header="Geliştirici Modu" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <SelectableTextBlock Text="Geliştirici kodu girilince açılır → kullanıcı süper admin yetkilerine sahip olur. Çıkış yapınca otomatik kapanır." Classes="Helper" TextWrapping="Wrap"/>
                        <SelectableTextBlock Text="{Binding DeveloperStatusText}" Classes="Body" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !DeveloperActive}">
                            <ctrl:FormField Label="Geliştirici Kodu" Width="220">
                                <TextBox Classes="Field" Text="{Binding DeveloperCode}" PasswordChar="●"/>
                            </ctrl:FormField>
                            <Button Classes="Primary" Content="Aktif Et" VerticalAlignment="Bottom" Command="{Binding ActivateDeveloperCommand}"/>
                        </StackPanel>
                        <Button Classes="Danger" Content="Geliştirici Modunu Kapat" HorizontalAlignment="Left"
                                IsVisible="{Binding DeveloperActive}" Command="{Binding DeactivateDeveloperCommand}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <SelectableTextBlock Grid.Row="2" Text="{Binding Status}" Classes="Helper" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
