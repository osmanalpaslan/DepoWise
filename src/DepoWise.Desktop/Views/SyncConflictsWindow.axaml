<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DepoWise.Desktop.ViewModels"
        x:Class="DepoWise.Desktop.Views.SyncConflictsWindow"
        Width="900" Height="680" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Senkron Çakışmaları" Icon="/Assets/app-logo.ico"
        Background="{DynamicResource SurfaceBrush}">
    <!-- ⭐ FAZ 4.4 (kullanıcı isteği 2026-09-06) — SENKRON ÇAKIŞMA EKRANI.
         "Kimin kazandığı kimin kaybettiği belirtilmeli… Üzerine yazılan kaydı iptal edip istenen
         kaydı kazanan yapabilmeli." Her kart: kazanan/kaybeden + alan bazlı fark + çözüm düğmeleri. -->
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
        <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto">
            <SelectableTextBlock Grid.Row="0" Classes="PageTitle" Text="Senkron Çakışmaları"/>
            <SelectableTextBlock Grid.Row="1" Classes="Helper" Margin="0,4,0,12" TextWrapping="Wrap"
                Text="Bu kayıtlar aynı anda hem web'de hem masaüstünde değiştirildi. En son düzenleyen geçerli oldu. İsterseniz üzerine yazılan sürümü geri getirip kazanan yapabilirsiniz."/>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="0">
                        <SelectableTextBlock x:Name="StatusText" Classes="Helper" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="List">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CakismaSatiri">
                                    <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <SelectableTextBlock Text="{Binding Baslik}" FontWeight="SemiBold"/>
                                                <SelectableTextBlock Text="{Binding Tarih}" Classes="Helper"/>
                                            </StackPanel>
                                            <SelectableTextBlock Text="{Binding KazananMetni}" TextWrapping="Wrap"/>
                                            <SelectableTextBlock Text="{Binding KaybedenMetni}" TextWrapping="Wrap"
                                                                 Classes="Helper"/>
                                            <SelectableTextBlock Text="Üzerine yazılan sürümden farklar:" Classes="Helper"
                                                                 IsVisible="{Binding FarkVar}" Margin="0,4,0,0"/>
                                            <ItemsControl ItemsSource="{Binding Farklar}" x:CompileBindings="False"
                                                          IsVisible="{Binding FarkVar}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8,1,0,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <SelectableTextBlock Text="{Binding Not}" Classes="Helper"
                                                                 IsVisible="{Binding NotVar}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                                <Button Classes="Primary" Content="Üzerine Yazılanı Kazanan Yap"
                                                        IsVisible="{Binding CozebilirMi}"
                                                        Command="{Binding KazananYapCommand}" CommandParameter="{Binding}"/>
                                                <Button Classes="Secondary" Content="Kaydın Geçmişi"
                                                        IsVisible="{Binding GecmisVar}"
                                                        Command="{Binding GecmisCommand}" CommandParameter="{Binding}"/>
                                                <Button Classes="Ghost" Content="Gizle"
                                                        Command="{Binding GizleCommand}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="RefreshBtn" Classes="Secondary" Content="Yenile"/>
                <Button x:Name="CloseBtn" Classes="Primary" Content="Kapat" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
