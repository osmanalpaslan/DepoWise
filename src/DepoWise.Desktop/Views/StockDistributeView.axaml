<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:org="using:DepoWise.Infrastructure.Organization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.StockDistributeView"
             x:DataType="vm:StockDistributeViewModel">

    <!-- STK-08: ATANMAMIŞ stok dağıtımı. Bu ekran ÇEVRİMDIŞI çalışır — API çağrısı yoktur;
         liste ve dağıtım doğrudan yerel SQLite üzerinden yapılır. -->
    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Atanmamış Stok Dağıtımı">
            <ctrl:Toolbar.FilterContent>
                <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                    <TextBox Classes="Field" Width="200" Watermark="Kod / ad ara..." Text="{Binding Search}"/>
                    <Button Classes="Secondary" Content="Ara" Command="{Binding LoadCommand}"/>
                </WrapPanel>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- "Atanmamış" bir depo DEĞİLDİR: kullanıcı ne yaptığını anlamalı. -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0">
            <SelectableTextBlock TextWrapping="Wrap" Classes="Helper"
                Text="&quot;Atanmamış&quot; bir depo değildir — geçmişte hangi depoya girildiği yazılmamış stoktur. Hangi malzemeden ne kadarını hangi depoya aktaracağınızı siz belirlersiniz; sistem tahmin yapmaz. Her aktarım gerçek bir transfer hareketi olarak kaydedilir ve gerekirse iptal edilebilir."/>
        </Border>

        <Border Grid.Row="2" Classes="Panel" Margin="0,12,0,0">
            <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="14">
                <!-- TRH-01: İŞLEM TARİHİ (iş günü). Kayıt anı (log) bundan bağımsız, daima gerçek saat.
                     Geri/ileri tarih YETKİYE bağlı (btn-backdate): yetki yoksa alan kilitli. -->
                <ctrl:FormField Label="İşlem Tarihi" Width="280">
                    <DatePicker Classes="Field" SelectedDate="{Binding DocDate}" IsEnabled="{Binding CanBackDate}"
                                ToolTip.Tip="{Binding DocDateHint}"/>
                </ctrl:FormField>
                <ctrl:FormField Label="Hedef Depo / Şantiye" IsRequired="True" Width="260">
                    <!-- YALNIZ gerçek depolar; "Atanmamış" hedef olarak SUNULMAZ. -->
                    <ComboBox Classes="Field" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="org:BranchRow">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ctrl:FormField>
                <SelectableTextBlock Text="{Binding SummaryText}" VerticalAlignment="Bottom" Classes="Helper"/>
                <Button Classes="Primary" Content="Dağıtımı Kaydet" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding !Busy}" VerticalAlignment="Bottom"/>
            </WrapPanel>
        </Border>

        <!-- H-1: kaç kayıt VAR / kaç kayıt GÖSTERİLİYOR. Sığmayan kayıt varsa vurgulu (Warning) gösterilir
             ki kullanıcı listeyi "hepsi bu" sanıp dağıtılmamış stoğu gözden kaçırmasın. -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0" IsVisible="{Binding HasRows}">
            <!-- Kesilme YOKSA sade bilgi; VARSA aynı metin uyarı rengiyle (ayrı öğe — dönüştürücü gerekmez). -->
            <SelectableTextBlock Classes="Helper" TextWrapping="Wrap" Text="{Binding CountText}"
                                 IsVisible="{Binding !Truncated}"/>
            <SelectableTextBlock TextWrapping="Wrap" Text="{Binding CountText}"
                                 Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                                 IsVisible="{Binding Truncated}"/>
        </StackPanel>

        <!-- ⭐ DÜZELTME (görsel QA 2026-09-06) — İKİ AYRI HATA vardı ve ikisi de ölçüldü:
             1) MALZEME kolonu YILDIZ (*) genişlikteydi ve satır, ListBox öğesi içinde kendi istediği
                genişlikte yerleşiyordu. Uzun bir malzeme adı satırı büyütünce "DAĞITILACAK" alanı ve
                "Tümü" düğmesi ekranın DIŞINA itiliyordu (1366 px'te 106 ve 286 px dışarıda ölçüldü) —
                yani dağıtım miktarı GİRİLEMİYORDU.
             2) Başlık satırı sığdığı için kısalıyor, gövde satırı uzadığı için kaymıyordu → başlık ile
                değerler HİZALANMIYORDU (ATANMAMIŞ boş görünüp sayılar KALAN'ın altına düşüyordu).
             Çözüm, projedeki DİĞER tabloların (Stok Hareketleri · Malzemeler) zaten kullandığı kalıptır:
             tüm kolonlar sabit (Min=Max), tablo yatay kaydırıcı içinde, başlık ve gövde aynı kaydırıcıyı
             paylaşır. Böylece hiçbir hücre dışarı taşmaz ve hizalama her genişlikte korunur. -->
        <Border Grid.Row="4" Classes="Table" Margin="0,8,0,0" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <DockPanel HorizontalAlignment="Left">
                <Border Classes="TableHeader" DockPanel.Dock="Top">
                    <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <SelectableTextBlock Grid.Column="0" Text="KOD" MinWidth="110" MaxWidth="110"/>
                        <SelectableTextBlock Grid.Column="1" Text="MALZEME" MinWidth="260" MaxWidth="260"/>
                        <SelectableTextBlock Grid.Column="2" Text="ATANMAMIŞ" MinWidth="110" MaxWidth="110"/>
                        <SelectableTextBlock Grid.Column="3" Text="DAĞITILACAK" MinWidth="140" MaxWidth="140"/>
                        <SelectableTextBlock Grid.Column="4" Text="KALAN" MinWidth="100" MaxWidth="100"/>
                        <SelectableTextBlock Grid.Column="5" Text="" MinWidth="80" MaxWidth="80"/>
                    </Grid>
                </Border>
                <ListBox Classes="Table" ItemsSource="{Binding Lines}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:StockDistributeViewModel+UnassignedLineVm">
                            <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                <SelectableTextBlock Grid.Column="0" Text="{Binding Code}" MinWidth="110" MaxWidth="110" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Code}" />
                                <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" MinWidth="260" MaxWidth="260" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                <SelectableTextBlock Grid.Column="2" Text="{Binding AvailableText}" MinWidth="110" MaxWidth="110" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AvailableText}" />
                                <!-- Negatif kalan (ADR-086 devralınan eksik stok) dağıtılamaz → alan kapalı. -->
                                <NumericUpDown Grid.Column="3" Classes="Field" MinWidth="140" MaxWidth="140" Minimum="0"
                                               Maximum="{Binding Available}" Value="{Binding Amount, Mode=TwoWay}"
                                               FormatString="0.##" ShowButtonSpinner="False"
                                               IsEnabled="{Binding CanDistribute}"/>
                                <SelectableTextBlock Grid.Column="4" Text="{Binding RemainingText}" MinWidth="100" MaxWidth="100" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RemainingText}" />
                                <Button Grid.Column="5" Classes="Ghost" Content="Tümü" MinWidth="80"
                                        IsEnabled="{Binding CanDistribute}"
                                        Command="{Binding $parent[ItemsControl].((vm:StockDistributeViewModel)DataContext).FillAllCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
          </ScrollViewer>
        </Border>

        <SelectableTextBlock Grid.Row="4" IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                             Classes="Helper" Text="Dağıtılacak &quot;Atanmamış&quot; stok yok — tüm stok bir depoya bağlı görünüyor."/>

        <StackPanel Grid.Row="5" Margin="0,10,0,0" Spacing="4">
            <SelectableTextBlock Text="{Binding FormError}" IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="{DynamicResource DangerBrush}"/>
            <SelectableTextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="Helper"/>
        </StackPanel>
    </Grid>
</UserControl>
