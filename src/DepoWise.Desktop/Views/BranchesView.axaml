<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:org="using:DepoWise.Infrastructure.Organization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="660"
             x:Class="DepoWise.Desktop.Views.BranchesView"
             x:DataType="vm:BranchesViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Şube / Şantiye Tanım"
                      PrimaryActionText="Yeni Şube" PrimaryActionCommand="{Binding NewBranchCommand}">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- Yeni/Düzenle formu -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="{Binding FormTitle}" Classes="SectionTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Ad" IsRequired="True" Width="260">
                        <TextBox Classes="Field" Text="{Binding FormName}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Tür" Width="140">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding FormKind}"/>
                    </ctrl:FormField>
                </StackPanel>
                <ctrl:FormField Label="Üst Şube" Width="260" HelpText="Boş = en üst seviye.">
                    <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding ParentOptions}" SelectedItem="{Binding FormParent}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="org:BranchRow"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </ctrl:FormField>
                <TextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding CancelAddCommand}"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Liste + Detay -->
        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="*,360">
            <Panel Grid.Column="0">
                <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                    <DockPanel>
                        <Border Classes="TableHeader" DockPanel.Dock="Top">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="AD" MinWidth="180"/>
                                <TextBlock Grid.Column="1" Text="TÜR" MinWidth="90"/>
                                <TextBlock Grid.Column="2" Text="ÜST ŞUBE" MinWidth="140"/>
                                <TextBlock Grid.Column="3" Text="KULLANICI" MinWidth="80"/>
                            </Grid>
                        </Border>
                        <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="org:BranchRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" MinWidth="180" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding KindDisplay}" MinWidth="90" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ParentDisplay}" MinWidth="140" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding UserCount}" MinWidth="80" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                                 ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
                <ctrl:StatePanel Mode="Empty" Title="Şube yok" Message="Henüz şube/şantiye tanımlanmadı." IsVisible="{Binding IsEmpty}"/>
            </Panel>

            <!-- Detay: şubeye atanmış kullanıcılar -->
            <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding HasSelection}">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Selected.Name}" Classes="PageTitle" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="Secondary" Content="Düzenle" Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}"/>
                            <Button Classes="Danger" Content="Sil" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"/>
                        </StackPanel>
                        <Border Classes="Divider"/>
                        <TextBlock Text="ŞUBEDEKİ KULLANICILAR" Classes="SectionTitle"/>
                        <ItemsControl ItemsSource="{Binding BranchUsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="org:BranchUserRow">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FullName}" Classes="Body" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Username}" Classes="Helper"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Roles}" Classes="Helper" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Bu şubeye atanmış kullanıcı yok. Atama 'Kullanıcılar' ekranından yapılır."
                                   Classes="Helper" TextWrapping="Wrap" IsVisible="{Binding !BranchUsers.Count}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding !HasSelection}">
                <TextBlock Text="Detay için bir şube seçin." Classes="Helper" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
