<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             x:Class="DepoWise.Desktop.Views.ThemeSettingsView"
             x:DataType="vm:ThemeSettingsViewModel">
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}" Margin="24">
        <ctrl:Toolbar Grid.Row="0" Title="Tema"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Margin="0,12,0,0" MaxWidth="620" HorizontalAlignment="Left">
                <SelectableTextBlock Text="Uygulama temasını seçin. Seçim anında uygulanır ve bu makinede saklanır."
                           Classes="Helper" TextWrapping="Wrap"/>

                <!-- Görünüm (stil kütüphanesi) -->
                <SelectableTextBlock Text="Görünüm (Stil)" Classes="CardLabel" Margin="0,6,0,0"/>
                <ItemsControl ItemsSource="{Binding StyleOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StyleOption">
                            <Button Classes="Ghost" Padding="0" Margin="0,0,0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[ItemsControl].((vm:ThemeSettingsViewModel)DataContext).ChooseStyleCommand}"
                                    CommandParameter="{Binding Key}">
                                <Border Classes="Panel" Padding="16" BorderThickness="2"
                                        BorderBrush="{Binding IsSelected, Converter={x:Static vm:ThemeSelBrush.Instance}}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <SelectableTextBlock Grid.Column="0" Text="🎨" FontSize="20" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                                            <SelectableTextBlock Text="{Binding Name}" Classes="Body" FontWeight="SemiBold"/>
                                            <SelectableTextBlock Text="{Binding Desc}" Classes="Helper"/>
                                        </StackPanel>
                                        <SelectableTextBlock Grid.Column="2" Text="✓" FontSize="18" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsSelected}"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <SelectableTextBlock Text="Aydınlık / Karanlık" Classes="CardLabel" Margin="0,6,0,0"/>

                <!-- Koyu -->
                <Button Classes="Ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding ChooseCommand}" CommandParameter="Dark">
                    <Border Classes="Panel" Padding="16" BorderThickness="2"
                            BorderBrush="{Binding IsDark, Converter={x:Static vm:ThemeSelBrush.Instance}}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="🌙" FontSize="22" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                                <SelectableTextBlock Text="Koyu" Classes="Body" FontWeight="SemiBold"/>
                                <SelectableTextBlock Text="Göz yormayan koyu arayüz (varsayılan)." Classes="Helper"/>
                            </StackPanel>
                            <SelectableTextBlock Grid.Column="2" Text="✓" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsDark}"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- Açık -->
                <Button Classes="Ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding ChooseCommand}" CommandParameter="Light">
                    <Border Classes="Panel" Padding="16" BorderThickness="2"
                            BorderBrush="{Binding IsLight, Converter={x:Static vm:ThemeSelBrush.Instance}}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="☀️" FontSize="22" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                                <SelectableTextBlock Text="Açık" Classes="Body" FontWeight="SemiBold"/>
                                <SelectableTextBlock Text="Aydınlık ortamlar için beyaz arayüz." Classes="Helper"/>
                            </StackPanel>
                            <SelectableTextBlock Grid.Column="2" Text="✓" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsLight}"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- Sistem -->
                <Button Classes="Ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding ChooseCommand}" CommandParameter="System">
                    <Border Classes="Panel" Padding="16" BorderThickness="2"
                            BorderBrush="{Binding IsSystem, Converter={x:Static vm:ThemeSelBrush.Instance}}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="🖥️" FontSize="22" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                                <SelectableTextBlock Text="Sistem" Classes="Body" FontWeight="SemiBold"/>
                                <SelectableTextBlock Text="Windows tema ayarını otomatik izler." Classes="Helper"/>
                            </StackPanel>
                            <SelectableTextBlock Grid.Column="2" Text="✓" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsSystem}"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- Renk teması -->
                <SelectableTextBlock Text="Renk Teması" Classes="CardLabel" Margin="0,10,0,0"/>
                <SelectableTextBlock Text="Arayüzün ana rengini seçin." Classes="Helper"/>
                <ItemsControl ItemsSource="{Binding Accents}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccentOption">
                            <Button Classes="Ghost" Padding="0" Margin="0,0,14,14" Cursor="Hand"
                                    Command="{Binding $parent[ItemsControl].((vm:ThemeSettingsViewModel)DataContext).ChooseColorCommand}"
                                    CommandParameter="{Binding Key}">
                                <StackPanel Width="72" Spacing="4">
                                    <Border Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center"
                                            Background="{Binding Swatch}" BorderThickness="3"
                                            BorderBrush="{Binding IsSelected, Converter={x:Static vm:ThemeSelBrush.Instance}}">
                                        <SelectableTextBlock Text="✓" FontSize="18" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsSelected}"/>
                                    </Border>
                                    <SelectableTextBlock Text="{Binding Name}" Classes="Helper" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <SelectableTextBlock Text="{Binding Status}" Classes="Helper"
                           Foreground="{DynamicResource SuccessBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
