<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:DepoWise.Desktop.Controls"
        x:Class="DepoWise.Desktop.Views.MaterialQuickEditWindow"
        Width="560" SizeToContent="Height" MaxHeight="720" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Alpnex — Malzeme" Icon="/Assets/app-logo.ico"
        Background="{DynamicResource SurfaceBrush}">
    <!-- Çift-tık ile açılan hızlı düzenle penceresi (kullanıcı isteği 2026-07-19). "Düzelt"e basılana kadar
         alanlar KİLİTLİ (IsEnabled=false); basınca düzenlenir. Kod-arkası (DataContext bağlaması YOK) —
         ColumnPickerWindow ile aynı düşük-riskli desen. -->
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
        <StackPanel Margin="22" Spacing="10">
            <SelectableTextBlock x:Name="TitleText" Text="Malzeme" Classes="PageTitle"/>

            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" >
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Kod" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="CodeBox" Classes="Field" Margin="0,4,14,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ad" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="NameBox" Classes="Field" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tür" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="TypeBox" Classes="Field" HorizontalAlignment="Stretch" Margin="0,4,14,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Kategori" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <StackPanel Grid.Row="1" Grid.Column="3" Spacing="4" Margin="0,4,0,4">
                    <!-- İş #9: aranabilir ortak seçim (LookupBox). Eskiden düz ComboBox'tı → yüzlerce
                         kategori/marka/tedarikçi olan firmada kullanıcı arama yapamadan kaydırmak zorundaydı. -->
                    <ctrl:LookupBox x:Name="CatBox" HorizontalAlignment="Stretch" PlaceholderText="Kategori seç / ara..."/>
                    <ctrl:LookupBox x:Name="SubCatBox" HorizontalAlignment="Stretch" PlaceholderText="Alt kategori (opsiyonel)"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Birim" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ctrl:LookupBox Grid.Row="2" Grid.Column="1" x:Name="UnitBox" HorizontalAlignment="Stretch" Margin="0,4,14,4" PlaceholderText="Birim seç / ara..."/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Marka" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ctrl:LookupBox Grid.Row="2" Grid.Column="3" x:Name="BrandBox" HorizontalAlignment="Stretch" Margin="0,4,0,4" PlaceholderText="Marka seç / ara..."/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tedarikçi" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ctrl:LookupBox Grid.Row="3" Grid.Column="1" x:Name="SupBox" HorizontalAlignment="Stretch" Margin="0,4,14,4" PlaceholderText="Tedarikçi seç / ara..."/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Mevcut Stok" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <!-- madde 1.2: stok görüntülenebilir + (yetkiliyse) düzenlenebilir. Doğrudan değiştirilirse madde 1.3
                     güçlü uyarı + madde 1.4 log (kod-arkası). Yetki yoksa salt-okunur (IsEnabled=false). -->
                <NumericUpDown Grid.Row="3" Grid.Column="3" x:Name="StockBox" Classes="Field" FormatString="0.##" ShowButtonSpinner="False" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Min Stok" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="MinBox" Classes="Field" Minimum="0" FormatString="0.##" Margin="0,4,14,4"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Birim Fiyat" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <NumericUpDown Grid.Row="4" Grid.Column="3" x:Name="PriceBox" Classes="Field" Minimum="0" FormatString="0.##" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Açıklama" Classes="Body" VerticalAlignment="Top" Margin="0,8,10,6"/>
                <TextBox   Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="DescBox" Classes="Field" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" Margin="0,4,0,4"/>
            </Grid>

            <!-- Kritik stok paneli (S3) — stok minimum altındaysa uyarı + Talep Oluştur (taslak). -->
            <Border x:Name="CriticalPanel" IsVisible="False" Padding="12,10" CornerRadius="10"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <SelectableTextBlock x:Name="CriticalTitle" FontWeight="SemiBold"
                                             Foreground="{DynamicResource DangerBrush}" Text="Kritik seviye altında"/>
                        <SelectableTextBlock x:Name="CriticalDetail" Classes="Helper"/>
                    </StackPanel>
                    <Button x:Name="RequestBtn" Grid.Column="1" Classes="Primary" Content="Talep Oluştur"
                            VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <SelectableTextBlock x:Name="StatusText" Classes="Body" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="False"/>
            <SelectableTextBlock x:Name="HintText" Classes="Helper" TextWrapping="Wrap" IsVisible="False"
                Text="Fotoğraf, muadil ve uyumlu araçlar bu pencerede değişmez (korunur) — tam düzenleme için liste ekranındaki “Düzenle”yi kullanın."/>

            <!-- Son Hareketler (A3) — salt-okunur; malzemenin son 10 stok hareketi (giriş/çıkış/bakım). -->
            <SelectableTextBlock Text="Son Hareketler" Classes="CardLabel" Margin="0,6,0,0"/>
            <Border x:Name="MovesPanel" Classes="Panel" Padding="0" MaxHeight="176" IsVisible="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MovesList" x:CompileBindings="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                    <Grid ColumnDefinitions="86,*,Auto">
                                        <SelectableTextBlock Grid.Column="0" Text="{Binding DateStr}" Classes="Helper" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="1">
                                            <SelectableTextBlock Text="{Binding Label}" Classes="Body"/>
                                            <SelectableTextBlock Text="{Binding Reference}" Classes="Helper" IsVisible="{Binding HasRef}"/>
                                        </StackPanel>
                                        <SelectableTextBlock Grid.Column="2" Text="{Binding QtyStr}" FontWeight="SemiBold"
                                                             VerticalAlignment="Center" Foreground="{Binding QtyBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <SelectableTextBlock x:Name="NoMovesText" Text="Bu malzeme için hareket kaydı yok." Classes="Helper" IsVisible="False"/>

            <Grid>
                <SelectableTextBlock x:Name="DirtyText" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Classes="Helper" Foreground="{DynamicResource WarningBrush}" IsVisible="False"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Classes="Secondary" Content="Kapat" IsCancel="True"/>
                    <Button x:Name="DeleteBtn" Classes="Danger" Content="Sil"/>
                    <Button x:Name="EditBtn" Classes="Secondary" Content="Düzelt"/>
                    <Button x:Name="SaveBtn" Classes="Primary" Content="Kaydet" IsVisible="False"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
