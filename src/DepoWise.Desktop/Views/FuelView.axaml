<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:veh="using:DepoWise.Infrastructure.Vehicles"
             xmlns:op="using:DepoWise.Infrastructure.Operations"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="660"
             x:Class="DepoWise.Desktop.Views.FuelView"
             x:DataType="vm:FuelViewModel">

    <!-- ⭐ 2026-10-10 Yakıt Özeti — iOS tarzı yumuşak kart stilleri (yalnız bu ekran). Renkler tema
         fırçalarından gelir → açık/koyu temada kendiliğinden doğru. -->
    <UserControl.Styles>
        <Style Selector="Border.FuelKpi">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="BoxShadow" Value="0 2 10 0 #14000000"/>
        </Style>
        <Style Selector="TextBlock.FuelKpiLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="SelectableTextBlock.FuelKpiValue">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Border.FuelMonth">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="BoxShadow" Value="0 2 12 0 #12000000"/>
        </Style>
        <Style Selector="Border.FuelMonth.empty">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="Border.FuelMonth.current">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ToggleButton.FuelMonthHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.FuelMonthHeader:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.FuelMonthHeader:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.FuelMonthHeader:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.FuelMonthHeader TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.FuelChevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.FuelChevron.open">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>
        <Style Selector="Border.FuelPill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.FuelPill TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.FuelPill.info TextBlock"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></Style>
        <Style Selector="Border.FuelPill.success TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></Style>
        <Style Selector="Border.FuelPill.accent"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Style>
        <Style Selector="Border.FuelPill.accent TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
        <Style Selector="Border.FuelPanel">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style Selector="ProgressBar.FuelShare">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>
        <Style Selector="ProgressBar.FuelWeek">
            <Setter Property="Height" Value="10"/>
            <Setter Property="MinHeight" Value="10"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>
        <Style Selector="StackPanel.FuelDay TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="StackPanel.FuelDay.strong TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="*,Auto">
        <TabControl Grid.Row="0" Classes="NoHeader" SelectedIndex="{Binding SelectedTab}">

            <!-- ═══════════ YAKIT DAĞITIMLARI ═══════════ -->
            <TabItem Header="Yakıt Dağıtımları">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
                    <!-- ⭐ ARA İŞ 6: ShowSearch="False". Toolbar şablonu VARSAYILAN olarak bir arama
                         kutusu çizer; bu ekran onu hiçbir şeye bağlamamıştı → kutu görünüyor, yazı
                         yazılıyor, HİÇBİR ŞEY OLMUYORDU (kullanıcının "arama butonu çalışmıyor"
                         şikayeti tam olarak buydu). Gerçek arama artık aşağıdaki kendi filtre
                         çubuğundadır; şablonun ölü kutusu kapatıldı. -->
                    <ctrl:Toolbar Grid.Row="0" Title="Yakıt Dağıtımları" ShowSearch="False"
                                  PrimaryActionText="Yeni Dağıtım" PrimaryActionCommand="{Binding ToggleDistCommand}">
                        <ctrl:Toolbar.FilterContent>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
    <CheckBox Content="İptal edilenleri göster" IsChecked="{Binding ShowCancelled}" VerticalAlignment="Center"/>
                                <!-- Kullanıcı isteği (2026-09-02): yakıt kaydı düzeltilebilsin. Kayıt üzerine
                                     YAZILMAZ; eski kayıt iptal edilip düzeltilmiş kayıt oluşturulur (tek işlem). -->
                                <Button Classes="Secondary" Content="Düzenle" Margin="8,0,0,0"
                                        IsVisible="{Binding CanEditFuel}" Command="{Binding BeginEditDistributionCommand}"
                                        ToolTip.Tip="Seçili yakıt dağıtımını düzeltir: eski kayıt iptal edilip düzeltilmiş yeni kayıt oluşturulur; depo bakiyesi ve raporlar buna göre güncellenir."/>
                                <Button Classes="Danger" Content="Kaydı İptal Et" Margin="8,0,0,0"
                                        IsVisible="{Binding CanCancelFuel}" Command="{Binding CancelDistributionCommand}"
                                        ToolTip.Tip="Seçili yakıt dağıtımını iptal eder. Bakiye ve raporlardan çıkar; araç sayacı geri alınmaz."/>
                                <Button Classes="Secondary" Content="Yenile" Margin="8,0,0,0" Command="{Binding LoadCommand}"/>
                            </WrapPanel>
                        </ctrl:Toolbar.FilterContent>
                    </ctrl:Toolbar>

                    <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowDist}">
                        <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
                            <SelectableTextBlock Text="{Binding DistFormTitle}" Classes="SectionTitle"/>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <ctrl:FormField Label="Araç" IsRequired="True" Width="240">
                                    <ctrl:LookupBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding DistVehicle}"
                                                    DisplayMember="Display" PlaceholderText="İç kod / plaka seç / ara..."/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Önceki Sayaç" Width="140" HelpText="Araçtan otomatik.">
                                    <NumericUpDown Classes="Field" Value="{Binding DistPrevMeter}" IsEnabled="False"
                                                   FormatString="0.##" ShowButtonSpinner="False"/>
                                </ctrl:FormField>
                                <!-- 2026-09-30 (kullanıcı isteği): SALT OKUNUR — elle girilmez, güncel sayaçtan hesaplanır. -->
                                <ctrl:FormField Label="Sayaç Farkı" Width="140" HelpText="Otomatik hesaplanır.">
                                    <TextBox Classes="Field" Text="{Binding DistMeterDiffText, Mode=OneWay}" IsReadOnly="True"
                                             Focusable="False" ToolTip.Tip="Güncel sayaç − önceki sayaç"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Güncel Sayaç" Width="140" IsRequired="True">
                                    <NumericUpDown Classes="Field" Value="{Binding DistMeter}" Minimum="0"
                                                   FormatString="0.##" ShowButtonSpinner="False" PlaceholderText="Sayacı girin"/>
                                </ctrl:FormField>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <!-- TRH-01: İŞLEM TARİHİ (iş günü). Kayıt anı ayrıca loglanır; geri/ileri tarih yetkiye bağlı. -->
                                <ctrl:FormField Label="İşlem Tarihi" Width="150">
                                    <ctrl:TarihKutusu SelectedDate="{Binding DistDate}" IsEnabled="{Binding CanBackDate}"
                                                ToolTip.Tip="{Binding DocDateHint}"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Maliyet Merkezi" Width="190" IsVisible="{Binding CanPickCostCenter}"
                                                HelpText="Opsiyonel — maliyet bu merkeze yazılır.">
                                    <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding CostCenterOptions}" SelectedItem="{Binding DistCostCenter}"
                                                    PlaceholderText="Merkez seç... (boş olabilir)"/>
                                </ctrl:FormField>
                                <!-- ⭐ MUH-01b: irsaliye / fiş no. Depo girişindeki "Fatura/İrsaliye No"
                                     alanının dağıtım karşılığı; ön muhasebe gideri kaynak belgesine bağlar. -->
                                <ctrl:FormField Label="Fatura/İrsaliye No" Width="180"
                                                HelpText="Opsiyonel — elinizdeki belge numarası.">
                                    <TextBox Classes="Field" Text="{Binding DistInvoice}"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Litre" IsRequired="True" Width="140">
                                    <NumericUpDown Classes="Field" Value="{Binding DistLiters}" Minimum="0"
                                                   FormatString="0.##" ShowButtonSpinner="False"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Birim Fiyat (₺/L)" Width="160" HelpText="Varsayılan: güncel fiyat.">
                                    <NumericUpDown Classes="Field" Value="{Binding DistUnitPrice}" Minimum="0"
                                                   FormatString="0.##" ShowButtonSpinner="False"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Toplam" Width="140">
                                    <TextBox Classes="Field" Text="{Binding DistTotalText}" IsEnabled="False"/>
                                </ctrl:FormField>
                                <!-- Yakıtı Veren/Alan personel: aranabilir (madde 2.2, kullanıcı isteği 2026-08-06) — ortak AutoCompleteBox deseni. -->
                                <ctrl:FormField Label="Yakıtı Veren" Width="180">
                                    <ctrl:LookupBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding Personnel}" SelectedItem="{Binding DistPersonnel}"
                                              PlaceholderText="Personel seç / ara..."/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Yakıtı Alan" Width="180">
                                    <ctrl:LookupBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding Personnel}" SelectedItem="{Binding DistRecipient}"
                                              PlaceholderText="Personel seç / ara..."/>
                                </ctrl:FormField>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <Button Classes="Secondary" Content="Vazgeç" Command="{Binding ClearDistCommand}"/>
                                <Button Classes="Primary" Content="{Binding DistSaveText}" Command="{Binding SaveDistCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Panel Grid.Row="2" Margin="0,16,0,0">
                        <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasDist}">
                            <DockPanel>
                                <!-- ⭐ ARA İŞ 6 — ARAMA ÇUBUĞU (kullanıcı isteği 2026-09-04).
                                     Kullanıcı bu ekranda tarih ve araç bazlı arama yapamıyordu; bunu
                                     yalnız raporda yapabiliyordu ama RAPORDA DÜZENLEME YOK — kaydı
                                     bulup düzeltmesi gerekiyordu.
                                     ⚠ Sorgu YAZARKEN ÇALIŞMAZ: kullanıcının açık isteği "sadece bu
                                     buton ve enter tuşu ile" idi. Kutulardaki Enter ve Sorgula düğmesi
                                     AYNI komuta bağlıdır; kutular değişince hiçbir şey tetiklenmez. -->
                                <Border Classes="TableFilterRow" DockPanel.Dock="Top">
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10" VerticalAlignment="Center" Margin="10,8">
                                        <ctrl:FormField Label="Araç (kod / plaka)" Width="170">
                                            <TextBox Classes="Field" Text="{Binding AramaArac}" Watermark="ör. EKS-001">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding SorgulaCommand}"/>
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                        </ctrl:FormField>
                                        <ctrl:FormField Label="Başlangıç Tarihi" Width="150">
                                            <ctrl:TarihKutusu SelectedDate="{Binding AramaBaslangic}"/>
                                        </ctrl:FormField>
                                        <ctrl:FormField Label="Bitiş Tarihi" Width="150">
                                            <ctrl:TarihKutusu SelectedDate="{Binding AramaBitis}"/>
                                        </ctrl:FormField>
                                        <ctrl:FormField Label="Ara (kod / plaka / açıklama)" Width="220">
                                            <TextBox Classes="Field" Text="{Binding AramaMetni}" Watermark="Enter ile ara">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding SorgulaCommand}"/>
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                        </ctrl:FormField>
                                        <Button Classes="Primary" Content="Sorgula" VerticalAlignment="Bottom"
                                                Command="{Binding SorgulaCommand}"
                                                ToolTip.Tip="Yukarıdaki alanlara göre arar. Arama yalnız bu düğme ve Enter tuşu ile çalışır."/>
                                        <Button Classes="Secondary" Content="Temizle" VerticalAlignment="Bottom"
                                                Command="{Binding AramayiTemizleCommand}"
                                                ToolTip.Tip="Filtreleri temizler ve tüm kayıtlara döner."/>
                                    </WrapPanel>
                                </Border>

                                <!-- Sayfalama: liste artık TÜM kayıtları basmaz; seçilen sayfa boyutu kadar
                                     gösterir ve sayfalar arasında geçilir.
                                     ⚠ `TableFilterRow` sınıfı KULLANILMAZ: o sınıf başlık altındaki FİLTRE
                                     bandı içindir. Projedeki mevcut sayfalama satırları (DailyActivityView,
                                     VehiclesView) düz StackPanel'dir — aynı desen izlenir. -->
                                <StackPanel DockPanel.Dock="Bottom" Margin="10,8"
                                            Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <SelectableTextBlock Text="Sayfa boyutu" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}"
                                                  MinWidth="80" VerticalAlignment="Center"/>
                                        <Button Classes="Secondary" Content="‹" Command="{Binding PrevPageCommand}"
                                                IsEnabled="{Binding CanGoPrev}" ToolTip.Tip="Önceki sayfa"/>
                                        <ItemsControl ItemsSource="{Binding PageNumbers}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:Int32">
                                                    <Button Classes="Secondary" Content="{Binding}" MinWidth="34"
                                                            Command="{Binding $parent[ItemsControl].((vm:FuelViewModel)DataContext).GoToPageCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Classes="Secondary" Content="›" Command="{Binding NextPageCommand}"
                                                IsEnabled="{Binding CanGoNext}" ToolTip.Tip="Sonraki sayfa"/>
                                        <SelectableTextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                <Border Classes="TableHeader" DockPanel.Dock="Top">
                                    <Grid ctrl:ColumnRules.Enabled="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                            <!-- 2026-09-30 (kullanıcı isteği): SAYAÇ FARKI + ORT. TÜKETİM — LİTRE'nin hemen ardından. -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c9"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c10"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c6"/>
                                            <!-- ⭐ MUH-01b: BELGE NO kolonu -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c7"/>
                                            <!-- ⭐ DÜZELTME (kullanıcı bildirimi 2026-09-06): DURUM kolonunun ORTAK BOYUT
                                                 GRUBU YOKTU. Gövdedeki hücre yalnız iptal edilmiş kayıtta görünür
                                                 (IsVisible=IsCancelled); görünmeyince istediği genişlik 0 olur ve satır
                                                 ızgarası o ~102 px'i YILDIZ kolona geri verir. Sonuç: LİTRE'den sonraki
                                                 tüm değerler başlığa göre bir kolon SAĞA kayıyor, LİTRE başlığının altı
                                                 BOŞ görünüyordu. Ortak grup verilince iki ızgara da aynı genişliği
                                                 ayırır — hücre görünsün ya da görünmesin hizalama bozulmaz. -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="c8"/>
                                        </Grid.ColumnDefinitions>
                                        <SelectableTextBlock Grid.Column="0" Text="ARAÇ" MinWidth="100"/>
                                        <SelectableTextBlock Grid.Column="1" Text="SAYAÇ" MinWidth="140"/>
                                        <SelectableTextBlock Grid.Column="2" Text="LİTRE" MinWidth="80" TextAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="3" Text="SAYAÇ FARKI" MinWidth="100" TextAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="4" Text="ORT. TÜKETİM" MinWidth="110" TextAlignment="Center"
                                                             ToolTip.Tip="Litre / sayaç farkı (Yakıt Tüketim raporuyla aynı hesap)"/>
                                        <SelectableTextBlock Grid.Column="5" Text="BİRİM FİYAT" MinWidth="100" TextAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="6" Text="TOPLAM" MinWidth="100" TextAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="7" Text="TARİH" MinWidth="100" TextAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="8" Text="BELGE NO" MinWidth="110" Margin="14,0,0,0"/>
                                        <SelectableTextBlock Grid.Column="9" Text="DURUM" MinWidth="90" MaxWidth="90" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                                <ListBox Classes="Table" ItemsSource="{Binding Distributions}" SelectedItem="{Binding SelectedDistribution}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FuelRow">
                                            <Grid ctrl:ColumnRules.Enabled="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c9"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c10"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c6"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c7"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c8"/>
                                                </Grid.ColumnDefinitions>
                                                <SelectableTextBlock Grid.Column="0" Text="{Binding VehicleCode}" MinWidth="100" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VehicleCode}"/>
                                                <SelectableTextBlock Grid.Column="1" Text="{Binding MeterText}" MinWidth="140" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <SelectableTextBlock Grid.Column="2" Text="{Binding LitersText}" MinWidth="80" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                                                <SelectableTextBlock Grid.Column="3" Text="{Binding MeterDiffText}" MinWidth="100" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <SelectableTextBlock Grid.Column="4" Text="{Binding ConsumptionText}" MinWidth="110" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <SelectableTextBlock Grid.Column="5" Text="{Binding PriceText}" MinWidth="100" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <SelectableTextBlock Grid.Column="6" Text="{Binding TotalText}" MinWidth="100" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <SelectableTextBlock Grid.Column="7" Text="{Binding DateText}" MinWidth="100" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <SelectableTextBlock Grid.Column="8" Text="{Binding InvoiceDisplay}" MinWidth="110" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <SelectableTextBlock Grid.Column="9" Text="{Binding StatusText}" MinWidth="90" MaxWidth="90" Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsCancelled}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                                         ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
                        <ctrl:StatePanel Mode="Empty" Title="Dağıtım yok" Message="Henüz yakıt dağıtımı kaydı yok." IsVisible="{Binding DistEmpty}"/>
                    </Panel>
                </Grid>
            </TabItem>

            <!-- ═══════════ DEPO GİRİŞLERİ ═══════════ -->
            <TabItem Header="Depo Girişleri">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
                    <ctrl:Toolbar Grid.Row="0" Title="Depo Girişleri"
                                  PrimaryActionText="Yeni Giriş" PrimaryActionCommand="{Binding ToggleDepotCommand}">
                        <ctrl:Toolbar.FilterContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <CheckBox Content="İptal edilenleri göster" IsChecked="{Binding ShowCancelled}" VerticalAlignment="Center"/>
                                <Button Classes="Danger" Content="Kaydı İptal Et" Margin="8,0,0,0"
                                        IsVisible="{Binding CanCancelFuel}" Command="{Binding CancelDepotEntryCommand}"
                                        ToolTip.Tip="Seçili depo girişini iptal eder. Bakiyeyi eksiye düşürecekse engellenir."/>
                                <Button Classes="Secondary" Content="Yenile" Margin="8,0,0,0" Command="{Binding LoadCommand}"/>
                            </StackPanel>
                        </ctrl:Toolbar.FilterContent>
                    </ctrl:Toolbar>

                    <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowDepot}">
                        <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                            <SelectableTextBlock Text="YENİ DEPO GİRİŞİ" Classes="SectionTitle"/>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <!-- TRH-01: İŞLEM TARİHİ (iş günü). Kayıt anı ayrıca loglanır; geri/ileri tarih yetkiye bağlı. -->
                                <ctrl:FormField Label="İşlem Tarihi" Width="150">
                                    <ctrl:TarihKutusu SelectedDate="{Binding DepotDate}" IsEnabled="{Binding CanBackDate}"
                                                ToolTip.Tip="{Binding DocDateHint}"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Maliyet Merkezi" Width="190" IsVisible="{Binding CanPickCostCenter}"
                                                HelpText="Opsiyonel — maliyet bu merkeze yazılır.">
                                    <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding CostCenterOptions}" SelectedItem="{Binding DepotCostCenter}"
                                                    PlaceholderText="Merkez seç... (boş olabilir)"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Litre" IsRequired="True" Width="150">
                                    <NumericUpDown Classes="Field" Value="{Binding DepotLiters}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Birim Fiyat (₺/L)" IsRequired="True" Width="160">
                                    <NumericUpDown Classes="Field" Value="{Binding DepotPrice}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Toplam" Width="140">
                                    <TextBox Classes="Field" Text="{Binding DepotTotalText}" IsEnabled="False"/>
                                </ctrl:FormField>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <!-- Tedarikçi + "+" ekleme (madde 2.1, kullanıcı isteği 2026-08-06): Malzemeler ekranıyla AYNI desen. -->
                                <ctrl:FormField Label="Tedarikçi" Width="300">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding Suppliers}" SelectedItem="{Binding DepotSupplier}"
                                                              PlaceholderText="Tedarikçi seç / ara..."/>
                                            <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding [suppliers]}" Width="40" Margin="8,0,0,0"
                                                    ToolTip.Tip="Yeni tedarikçi" Command="{Binding StartAddSupplierCommand}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingSupplier}">
                                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewSupplierName}" PlaceholderText="Yeni tedarikçi adı"/>
                                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddSupplierCommand}"/>
                                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddSupplierCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Fatura/İrsaliye No" Width="200">
                                    <TextBox Classes="Field" Text="{Binding DepotInvoice}"/>
                                </ctrl:FormField>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <Button Classes="Secondary" Content="Vazgeç" Command="{Binding ClearDepotCommand}"/>
                                <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveDepotCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Panel Grid.Row="2" Margin="0,16,0,0">
                        <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasDepot}">
                            <DockPanel>
                                <!-- ARA İŞ 6: depo girişlerinde de aynı 200 tavanı vardı → sayfalanır.
                                     Filtre çubuğu dağıtımlar sekmesindedir; tarih ve serbest metin
                                     (fatura no) filtreleri bu sekmeye de uygulanır. -->
                                <StackPanel DockPanel.Dock="Bottom" Margin="10,8"
                                            Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Classes="Secondary" Content="‹" Command="{Binding DepoPrevPageCommand}"
                                            IsEnabled="{Binding DepoCanGoPrev}" ToolTip.Tip="Önceki sayfa"/>
                                    <SelectableTextBlock VerticalAlignment="Center"
                                                        Text="{Binding DepoPage, StringFormat='Sayfa {0}'}"/>
                                    <Button Classes="Secondary" Content="›" Command="{Binding DepoNextPageCommand}"
                                            IsEnabled="{Binding DepoCanGoNext}" ToolTip.Tip="Sonraki sayfa"/>
                                    <SelectableTextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Text="{Binding DepoTotalCount, StringFormat='{}{0} depo girişi'}"/>
                                </StackPanel>
                                <Border Classes="TableHeader" DockPanel.Dock="Top">
                                    <Grid ctrl:ColumnRules.Enabled="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="d2"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="d3"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="d4"/>
                                            <!-- DURUM: gövdedeki hücre IsVisible ile gizleniyor; ortak grup olmazsa
                                                 satır o genişliği yıldız kolona verir ve hizalama kayar (bkz. c8). -->
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="d5"/>
                                        </Grid.ColumnDefinitions>
                                        <SelectableTextBlock Grid.Column="0" Text="FATURA NO" MinWidth="140"/>
                                        <SelectableTextBlock Grid.Column="1" Text="LİTRE" MinWidth="90" TextAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="2" Text="BİRİM FİYAT" MinWidth="110" TextAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="3" Text="TARİH" MinWidth="100" TextAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="4" Text="DURUM" MinWidth="90" MaxWidth="90" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                                <ListBox Classes="Table" ItemsSource="{Binding DepotEntries}" SelectedItem="{Binding SelectedDepotEntry}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="op:FuelDepotRow">
                                            <Grid ctrl:ColumnRules.Enabled="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="d2"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="d3"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="d4"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="d5"/>
                                                </Grid.ColumnDefinitions>
                                                <SelectableTextBlock Grid.Column="0" Text="{Binding InvoiceDisplay}" MinWidth="140" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <SelectableTextBlock Grid.Column="1" Text="{Binding LitersText}" MinWidth="90" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                                                <SelectableTextBlock Grid.Column="2" Text="{Binding PriceText}" MinWidth="110" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <SelectableTextBlock Grid.Column="3" Text="{Binding DateText}" MinWidth="100" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <SelectableTextBlock Grid.Column="4" Text="{Binding StatusText}" MinWidth="90" MaxWidth="90" Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsCancelled}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <ctrl:StatePanel Mode="Empty" Title="Depo girişi yok" Message="Henüz depo girişi kaydı yok." IsVisible="{Binding DepotEmpty}"/>
                    </Panel>
                </Grid>
            </TabItem>

            <!-- ═══════════ ÖZET ═══════════ -->
            <TabItem Header="Özet">
                <!-- ⭐ 2026-10-10 (kullanıcı isteği) YENİ TASARIM — iOS tarzı yumuşak kartlar.
                     Eski sorun: ay açılınca haftalık ve günlük değerler AYNI "tarih — litre" listesi olarak
                     yan yana duruyordu, ayırt edilemiyordu. Artık:
                       • HAFTALAR → mavi oran çubukları ("1. Hafta", tarih aralığı, litre)
                       • GÜNLER   → yeşil takvim kutucukları (gün no + gün adı + litre; koyuluk = yoğunluk)
                     Her ay kartında, en yoğun aya göre ince bir oran çubuğu ve ortalamalar renkli etiketlerle. -->
                <ScrollViewer>
                <StackPanel Margin="0,16,0,8" Spacing="18" MaxWidth="1180" HorizontalAlignment="Stretch">
                    <!-- KPI kartları -->
                    <UniformGrid Columns="4" ColumnSpacing="14" RowSpacing="14">
                        <Border Classes="FuelKpi">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kalan Yakıt (Depo)" Classes="FuelKpiLabel"/>
                                </StackPanel>
                                <SelectableTextBlock Text="{Binding DepotBalanceText}" Classes="FuelKpiValue"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="FuelKpi">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Güncel Fiyat" Classes="FuelKpiLabel"/>
                                </StackPanel>
                                <SelectableTextBlock Text="{Binding CurrentPriceText}" Classes="FuelKpiValue"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="FuelKpi">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Toplam Alınan" Classes="FuelKpiLabel"/>
                                </StackPanel>
                                <SelectableTextBlock Text="{Binding TotalReceivedText}" Classes="FuelKpiValue"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="FuelKpi">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Toplam Dağıtılan" Classes="FuelKpiLabel"/>
                                </StackPanel>
                                <SelectableTextBlock Text="{Binding TotalDistributedText}" Classes="FuelKpiValue"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="Kalan = tüm alınan − tüm dağıtılan (fiziksel depo). Fiyatlar geçmişte snapshot saklanır."
                               Classes="Helper" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- Başlık + renk açıklaması -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Aylık Dağıtım" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="18" Height="8" CornerRadius="4" Background="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Haftalık" Classes="Helper" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Günlük" Classes="Helper" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="son 12 ay" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Bu dönemde dağıtım yok." Classes="Helper" IsVisible="{Binding !HasMonthly}"/>

                    <ItemsControl ItemsSource="{Binding MonthlySummary}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FuelMonthCard">
                                <Border Classes="FuelMonth" Classes.current="{Binding S.IsCurrentMonth}" Classes.empty="{Binding S.IsEmpty}">
                                    <StackPanel Spacing="12">
                                        <!-- Ay başlığı: tıklayınca açılır/kapanır -->
                                        <ToggleButton Classes="FuelMonthHeader" IsChecked="{Binding IsExpanded}" HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Haftalık ve günlük ayrıntıyı göster / gizle">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding S.MonthName}" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding S.YearText}" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <Border Classes="FuelPill accent" IsVisible="{Binding S.IsCurrentMonth}">
                                                        <TextBlock Text="Bu ay"/>
                                                    </Border>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center" ItemSpacing="8" LineSpacing="6">
                                                    <Border Classes="FuelPill info">
                                                        <TextBlock Text="{Binding S.WeeklyAverageText, StringFormat='Haftalık ort. {0}'}"/>
                                                    </Border>
                                                    <Border Classes="FuelPill success">
                                                        <TextBlock Text="{Binding S.DailyAverageText, StringFormat='Günlük ort. {0}'}"/>
                                                    </Border>
                                                    <Border Classes="FuelPill">
                                                        <TextBlock Text="{Binding S.CountText}"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding S.LitersText}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="⌄" FontSize="20" Margin="14,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Classes="FuelChevron"
                                                           Classes.open="{Binding IsExpanded}"/>
                                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Classes="FuelShare" Margin="0,10,0,0"
                                                             Minimum="0" Maximum="100" Value="{Binding Share}"
                                                             ToolTip.Tip="Son 12 ayın en yoğun ayına göre oran"/>
                                            </Grid>
                                        </ToggleButton>

                                        <!-- Ayrıntı: SOLDA haftalar (çubuk), SAĞDA günler (takvim kutucukları) -->
                                        <Grid ColumnDefinitions="5*,16,6*" IsVisible="{Binding IsExpanded}">
                                            <Border Grid.Column="0" Classes="FuelPanel">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="18" Height="8" CornerRadius="4" Background="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="HAFTALAR" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource InfoBrush}" LetterSpacing="1"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding S.WeekBars}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="op:FuelWeekBar">
                                                                <StackPanel Spacing="4">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding RangeText}" Margin="8,0" Classes="Helper"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding LitersText}" FontWeight="Bold"/>
                                                                    </Grid>
                                                                    <ProgressBar Classes="FuelWeek" Minimum="0" Maximum="100" Value="{Binding Percent}"
                                                                                 ToolTip.Tip="{Binding CountText}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Classes="FuelPanel">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="GÜNLER" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SuccessBrush}" LetterSpacing="1"/>
                                                        <TextBlock Text="(yalnız dağıtım olan günler · koyu = daha çok)" Classes="Helper"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding S.DayTiles}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="op:FuelDayTile">
                                                                <Panel Width="78" Height="72" ToolTip.Tip="{Binding FullText}">
                                                                    <Border CornerRadius="12" Background="{DynamicResource SuccessBrush}" Opacity="{Binding Opacity}"/>
                                                                    <StackPanel Margin="8,6" Spacing="0" Classes="FuelDay" Classes.strong="{Binding IsStrong}">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="{Binding DayNumber}" FontSize="18" FontWeight="Bold"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Weekday}" FontSize="11" VerticalAlignment="Center" Opacity="0.85"/>
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding LitersText}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Panel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <SelectableTextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
