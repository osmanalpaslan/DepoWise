<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:inf="using:DepoWise.Infrastructure.Vehicles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="680"
             x:Class="DepoWise.Desktop.Views.FuelView"
             x:DataType="vm:FuelViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <ctrl:Toolbar Grid.Row="0" Title="Yakıt">
            <ctrl:Toolbar.FilterContent>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="Secondary" Content="Depo Girişi" Command="{Binding ToggleDepotCommand}"/>
                    <Button Classes="Primary" Content="Dağıtım" Command="{Binding ToggleDistCommand}"/>
                </StackPanel>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- KPI -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Margin="0,16,0,0">
            <Border Classes="Kpi">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding DepotBalanceText}" Classes="KpiValue"/>
                    <TextBlock Text="Depo Bakiyesi" Classes="KpiLabel"/>
                </StackPanel>
            </Border>
            <Border Classes="Kpi">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding CurrentPriceText}" Classes="KpiValue"/>
                    <TextBlock Text="Güncel Fiyat" Classes="KpiLabel"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Formlar -->
        <StackPanel Grid.Row="2" Spacing="12" Margin="0,16,0,0">
            <!-- Depo girişi -->
            <Border Classes="Panel" IsVisible="{Binding ShowDepot}">
                <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="DEPO GİRİŞİ" Classes="SectionTitle"/>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ctrl:FormField Label="Litre" IsRequired="True" Width="180">
                            <NumericUpDown Classes="Field" Value="{Binding DepotLiters}" Minimum="0"
                                           FormatString="0.##" ShowButtonSpinner="False"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Birim Fiyat (₺/L)" IsRequired="True" Width="180">
                            <NumericUpDown Classes="Field" Value="{Binding DepotPrice}" Minimum="0"
                                           FormatString="0.##" ShowButtonSpinner="False"/>
                        </ctrl:FormField>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Classes="Secondary" Content="İptal" Command="{Binding ToggleDepotCommand}"/>
                        <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveDepotCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Dağıtım -->
            <Border Classes="Panel" IsVisible="{Binding ShowDist}">
                <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="ARACA DAĞITIM" Classes="SectionTitle"/>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ctrl:FormField Label="Araç" IsRequired="True" Width="240">
                            <ComboBox Classes="Field" ItemsSource="{Binding Vehicles}"
                                      SelectedItem="{Binding DistVehicle}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="inf:VehicleListRow">
                                        <TextBlock Text="{Binding InternalCode}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Litre" IsRequired="True" Width="150">
                            <NumericUpDown Classes="Field" Value="{Binding DistLiters}" Minimum="0"
                                           FormatString="0.##" ShowButtonSpinner="False"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Güncel Sayaç" Width="160" HelpText="Aracın yeni km/saat değeri.">
                            <NumericUpDown Classes="Field" Value="{Binding DistMeter}" Minimum="0"
                                           FormatString="0.##" ShowButtonSpinner="False"/>
                        </ctrl:FormField>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Classes="Secondary" Content="İptal" Command="{Binding ToggleDistCommand}"/>
                        <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveDistCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Dağıtım listesi -->
        <Panel Grid.Row="3" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ARAÇ" MinWidth="110"/>
                            <TextBlock Grid.Column="1" Text="SAYAÇ" MinWidth="140"/>
                            <TextBlock Grid.Column="2" Text="LİTRE" MinWidth="80" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="BİRİM FİYAT" MinWidth="110" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="TARİH" MinWidth="100" TextAlignment="Right"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FuelRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding VehicleCode}" MinWidth="110" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MeterText}" MinWidth="140" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LitersText}" MinWidth="80" VerticalAlignment="Center"
                                               TextAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="{Binding PriceText}" MinWidth="110" VerticalAlignment="Center"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DateText}" MinWidth="100" VerticalAlignment="Center"
                                               TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}"
                             IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Dağıtım yok"
                             Message="Henüz yakıt dağıtımı kaydı yok."
                             IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0"
                   Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
