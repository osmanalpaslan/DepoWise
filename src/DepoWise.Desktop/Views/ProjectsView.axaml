<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="660"
             x:Class="DepoWise.Desktop.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">

    <!-- PRJ-01 (ADR-164): Projeler — sunucu-otoriteli ekran (şubeler gibi). Yetki: branches modülü (PK-C4). -->
    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Projeler"
                      PrimaryActionText="Yeni Proje" PrimaryActionCommand="{Binding NewProjectCommand}">
            <ctrl:Toolbar.FilterContent>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBox Classes="Field" Width="230" Text="{Binding SearchText}" Watermark="Ara: ad / şantiye / sorumlu / konum"/>
                    <ComboBox Classes="Field" Width="130" ItemsSource="{Binding FilterStatusOptions}" SelectedItem="{Binding FilterStatus}"/>
                    <Button Classes="Secondary" Content="Ara / Yenile" Command="{Binding LoadCommand}"/>
                </StackPanel>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- Yeni/Düzenle formu -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                <SelectableTextBlock Text="{Binding FormTitle}" Classes="SectionTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Proje Adı" IsRequired="True" Width="260">
                        <TextBox Classes="Field" Text="{Binding FormName}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Durum" Width="140">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FormStatus}"/>
                    </ctrl:FormField>
                    <!-- Tarih alanları KEHRİBAR temadan gelir (DatePicker Field stili, TRH-01 standardı) -->
                    <ctrl:FormField Label="Başlangıç" Width="160">
                        <DatePicker Classes="Field" SelectedDate="{Binding FormStart}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Bitiş" Width="160">
                        <DatePicker Classes="Field" SelectedDate="{Binding FormEnd}"/>
                    </ctrl:FormField>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Bağlı Şantiye" Width="260" HelpText="Şimdilik tek şantiye bağlanır.">
                        <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding BranchOptions}" SelectedItem="{Binding FormBranch}"
                                        PlaceholderText="Şantiye seç / ara... (boş olabilir)"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Sorumlu Personel" Width="240">
                        <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding PersonnelOptions}" SelectedItem="{Binding FormManager}"
                                        PlaceholderText="Personel seç / ara... (boş olabilir)"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Konum / Adres" Width="240">
                        <TextBox Classes="Field" Text="{Binding FormLocation}"/>
                    </ctrl:FormField>
                </StackPanel>
                <ctrl:FormField Label="Açıklama" Width="740">
                    <TextBox Classes="Field" Text="{Binding FormDescription}" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                </ctrl:FormField>
                <SelectableTextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding CancelAddCommand}"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Liste + Detay -->
        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="*,340">
            <Panel Grid.Column="0">
                <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                    <DockPanel>
                        <Border Classes="TableHeader" DockPanel.Dock="Top">
                            <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                                <SelectableTextBlock Grid.Column="0" Text="PROJE" MinWidth="160"/>
                                <SelectableTextBlock Grid.Column="1" Text="DURUM" MinWidth="90" MaxWidth="90"/>
                                <SelectableTextBlock Grid.Column="2" Text="ŞANTİYE" MinWidth="140" MaxWidth="140"/>
                                <SelectableTextBlock Grid.Column="3" Text="SORUMLU" MinWidth="130" MaxWidth="130"/>
                                <SelectableTextBlock Grid.Column="4" Text="BAŞLANGIÇ" MinWidth="90" MaxWidth="90"/>
                                <SelectableTextBlock Grid.Column="5" Text="BİTİŞ" MinWidth="90" MaxWidth="90"/>
                            </Grid>
                        </Border>
                        <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectItemRow">
                                    <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                                        <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" MinWidth="160" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding StatusDisplay}" MinWidth="90" MaxWidth="90" VerticalAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="2" Text="{Binding BranchDisplay}" MinWidth="140" MaxWidth="140" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BranchDisplay}"/>
                                        <SelectableTextBlock Grid.Column="3" Text="{Binding ManagerName}" MinWidth="130" MaxWidth="130" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ManagerName}"/>
                                        <SelectableTextBlock Grid.Column="4" Text="{Binding StartDisplay}" MinWidth="90" MaxWidth="90" VerticalAlignment="Center"/>
                                        <SelectableTextBlock Grid.Column="5" Text="{Binding EndDisplay}" MinWidth="90" MaxWidth="90" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                                 ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
                <ctrl:StatePanel Mode="Empty" Title="Proje yok" Message="Henüz proje tanımlanmadı." IsVisible="{Binding IsEmpty}"/>
            </Panel>

            <!-- Detay -->
            <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding HasSelection}">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <SelectableTextBlock Text="{Binding Selected.Name}" Classes="PageTitle" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="Secondary" Content="Düzenle" Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}"/>
                            <Button Classes="Danger" Content="Sil" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"/>
                        </StackPanel>
                        <Border Classes="Divider"/>
                        <SelectableTextBlock Text="{Binding Selected.StatusDisplay}" Classes="Body"/>
                        <SelectableTextBlock Text="{Binding Selected.BranchDisplay}" Classes="Body"/>
                        <SelectableTextBlock Text="{Binding Selected.ManagerName}" Classes="Body"/>
                        <SelectableTextBlock Text="{Binding Selected.LocationDisplay}" Classes="Helper" TextWrapping="Wrap"/>
                        <SelectableTextBlock Text="{Binding Selected.Description}" Classes="Helper" TextWrapping="Wrap"
                                   IsVisible="{Binding Selected.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding !HasSelection}">
                <SelectableTextBlock Text="Detay için bir proje seçin." Classes="Helper" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <SelectableTextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
