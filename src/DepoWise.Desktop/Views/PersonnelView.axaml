<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:asg="using:DepoWise.Infrastructure.Assignments"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:org="using:DepoWise.Infrastructure.Org"
             xmlns:orgz="using:DepoWise.Infrastructure.Organization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.PersonnelView"
             x:DataType="vm:PersonnelViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Personel"
                      PrimaryActionText="Yeni Personel" PrimaryActionCommand="{Binding NewPersonnelCommand}">
            <ctrl:Toolbar.FilterContent>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                    <!-- ⭐ PRT-02: filtrelenmiş TÜM sonucu indirir (o anki sayfayı değil) — projenin
                         liste ekranı kuralı. Personel ekranı bu kuralın dışında kalmıştı. -->
                    <Button Classes="Secondary" Content="Excel'e Aktar" Command="{Binding ExportExcelCommand}"
                            IsVisible="{Binding CanExport}"
                            ToolTip.Tip="Aktif aramayla eşleşen TÜM personeli Excel olarak indirir."/>
                    <!-- ⭐ 2026-09-06 (kullanıcı isteği): YAZDIR. Excel ile aynı veriyi PDF üretir;
                         başlıkta firma/şube/kullanıcı/tarih, altta sayısal kolonların toplamı olur. -->
                    <Button Classes="Secondary" Content="Yazdır" Command="{Binding YazdirCommand}" IsVisible="{Binding CanExport}"
                            ToolTip.Tip="Ekrandaki filtrelenmiş listeyi PDF olarak kaydeder (imzalı çıktı için)."/>
                    <Button Classes="Secondary YenileDugme" Command="{Binding LoadCommand}" ToolTip.Tip="Yenile (F5)" AutomationProperties.Name="Yenile"><PathIcon Data="{DynamicResource IconSync}"/></Button>
                </WrapPanel>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- ⭐ LST-01: liste sunucuda 500 kayıtta kesiliyor. Eskiden bu SESSİZDİ — 500. kaydın
             ötesindeki personel "yokmuş" gibi görünüyordu. -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,-8"
                IsVisible="{Binding DahaFazlaVar}"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,8">
            <SelectableTextBlock Text="{Binding KesilmeUyarisi}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <Border Background="{DynamicResource AppBackgroundBrush}" BorderThickness="0" Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                <SelectableTextBlock Text="{Binding FormTitle}" Classes="IosBaslik"/>
                <SelectableTextBlock Text="Kimlik" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                        <ctrl:FormField Label="Ad Soyad" IsRequired="True" Width="240">
                            <TextBox Classes="Field" Text="{Binding FFullName}"/>
                        </ctrl:FormField>
                        <!-- Unvan: sabit tanım listesinden seçilir; "+" ile yeni tanım eklenir -->
                        <ctrl:FormField Label="Unvan" Width="220">
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="12">
                                <ComboBox Classes="Field" Width="180" ItemsSource="{Binding Titles}" SelectedItem="{Binding FTitle}"/>
                                <Button AutomationProperties.Name="Yeni unvan tanımı ekle" Classes="Secondary" Content="+" Width="34" Padding="0" HorizontalContentAlignment="Center" ToolTip.Tip="Yeni unvan tanımı ekle"
                                        Command="{Binding ToggleAddTitleCommand}" IsVisible="{Binding CanWrite}"/>
                            </WrapPanel>
                        </ctrl:FormField>
                    </WrapPanel>
                </StackPanel></Border>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowAddTitle}">
                    <TextBox Classes="Field" Width="200" PlaceholderText="Yeni unvan" Text="{Binding NewTitle}"/>
                    <Button Classes="Primary" Content="Ekle" Command="{Binding AddTitleCommand}"/>
                    <Button Classes="Secondary" Content="Vazgeç" Command="{Binding ToggleAddTitleCommand}"/>
                </StackPanel>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                        <ctrl:FormField Label="Telefon" Width="180">
                            <TextBox Classes="Field" Text="{Binding FPhone}"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Şube / Şantiye" Width="200">
                            <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}" SelectedItem="{Binding FBranch}"
                                            PlaceholderText="Şube seç / ara..."/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Aktif" Width="70">
                            <CheckBox IsChecked="{Binding FActive}" VerticalAlignment="Center"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Saha personeli" Width="130">
                            <CheckBox IsChecked="{Binding FFieldStaff}" VerticalAlignment="Center"
                                      ToolTip.Tip="İşaretlenirse bu kişi uygulamaya girmez; kullanıcı bağlanmadı uyarısı çıkmaz."/>
                        </ctrl:FormField>
                    </WrapPanel>
                </StackPanel></Border>
                <SelectableTextBlock Text="İletişim ve Konum" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                    <!-- Olası aynı kişi uyarısı (#6) -->
                    <Border Classes="Panel" Padding="10" IsVisible="{Binding FDupWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <SelectableTextBlock Text="{Binding FDupWarning}" Classes="Helper" TextWrapping="Wrap"
                                             Foreground="{DynamicResource WarningBrush}"/>
                    </Border>

                    <!-- Uygulama erişimi: MEVCUT kullanıcıyı bağla (hesap açma yok) -->
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding FHasAccount}">
                        <SelectableTextBlock Text="Bağlı uygulama hesabı:" Classes="Helper" VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="{Binding FAccountInfo}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Classes="Secondary" Content="Bağı kaldır" Command="{Binding RemoveAccountCommand}"
                                IsVisible="{Binding CanManageAccounts}"/>
                    </StackPanel>

                </StackPanel></Border>
                <SelectableTextBlock Text="Uygulama Erişimi" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                    <CheckBox Content="Mevcut kullanıcıyı bağla"
                              IsChecked="{Binding FGrantAccess}" IsVisible="{Binding ShowGrantToggle}"/>
                    <StackPanel Spacing="10" IsVisible="{Binding ShowAccountFields}">
                        <ctrl:FormField HorizontalAlignment="Left" Label="Bağlanacak Kullanıcı" IsRequired="True" Width="360"
                                        IsVisible="{Binding HasLinkableUsers}">
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding LinkableUsers}" SelectedItem="{Binding FLinkUser}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Yalnız Ad Soyad + şube (kullanıcı adı gizli — kullanıcı isteği) -->
                                        <TextBlock Text="{Binding Display}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ctrl:FormField>
                        <SelectableTextBlock Classes="Helper" TextWrapping="Wrap" IsVisible="{Binding !HasLinkableUsers}"
                                             Text="{Binding LinkableEmptyReason}"/>
                        <SelectableTextBlock Text="Yalnız henüz bir personele bağlı olmayan kullanıcılar listelenir. Ekran yetkileri 'Yetkiler' ekranından ayarlanır."
                                             Classes="Helper" TextWrapping="Wrap" IsVisible="{Binding HasLinkableUsers}"/>
                    </StackPanel>

                </StackPanel></Border>
                <SelectableTextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding CancelAddCommand}"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ⭐ iOS tasarım (2026-10-28): seçili kişi kartı — üstte simge + ad + unvan ve eylemler; altta belgeler, zimmetler ve
             tutanaklar açılır bölümlerde (önceden hepsi tek yatay şeritteydi). Komutlar ve koşullar aynı. -->
        <Border Grid.Row="2" Classes="IosKart" Margin="0,16,0,0" Padding="16,14" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" Classes="IkonKutu buyuk" Background="#30D158">
                        <PathIcon Data="{DynamicResource IconPersonnel}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <SelectableTextBlock Text="{Binding Selected.FullName}" FontSize="17" FontWeight="Bold"
                                             Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <SelectableTextBlock Text="{Binding Selected.Title}" Classes="Helper"
                                             IsVisible="{Binding Selected.Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" ItemSpacing="8" LineSpacing="8">
                        <Button Classes="Secondary" Content="Düzenle" Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}"/>
                        <!-- ⭐ M-47: zimmet tutanağı -->
                        <Button Classes="Secondary" Content="Zimmet Tutanağı" Command="{Binding TutanakOlusturCommand}" IsVisible="{Binding HasZimmet}"
                                ToolTip.Tip="Bu kişinin şu anki zimmetlerini donduran, imza alanlı tutanak PDF'i üretir; imzalı dönünce Kabul işaretlenir."/>
                        <Button Classes="Danger" Content="Sil" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"/>
                    </WrapPanel>
                </Grid>
                <!-- ⭐ M-56 (F-090): kayda bağlı belgeler -->
                <ctrl:KayitBelgeleri DataContext="{Binding Belgeler}"/>
                <WrapPanel ItemSpacing="12" LineSpacing="8">
                    <!-- ⭐ M-46: personelin zimmetleri -->
                    <Expander Classes="IosAcilir" Header="{Binding Zimmetleri.Count, StringFormat='Zimmetleri ({0})'}" IsExpanded="False"
                              IsVisible="{Binding HasZimmet}" MinWidth="320" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding Zimmetleri}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="asg:ZimmetIadesi">
                                    <SelectableTextBlock Text="{Binding Ozet}" Classes="Helper" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander Classes="IosAcilir" Header="{Binding Tutanaklar.Count, StringFormat='Tutanaklar ({0})'}" IsExpanded="False"
                              IsVisible="{Binding HasTutanak}" MinWidth="320" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding Tutanaklar}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="asg:ZimmetTutanagi">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SelectableTextBlock Text="{Binding Ozet}" Classes="Helper" VerticalAlignment="Center"/>
                                        <Button Classes="Ghost" Content="PDF" Command="{Binding $parent[ItemsControl].((vm:PersonnelViewModel)DataContext).TutanakPdfCommand}" CommandParameter="{Binding}"/>
                                        <Button Classes="Ghost" Content="Kabul" Command="{Binding $parent[ItemsControl].((vm:PersonnelViewModel)DataContext).TutanakKabulCommand}" CommandParameter="{Binding}"
                                                ToolTip.Tip="İmzalı tutanak döndü: kabul edildi olarak işaretle."/>
                                        <Button Classes="Ghost" Content="Ret" Command="{Binding $parent[ItemsControl].((vm:PersonnelViewModel)DataContext).TutanakRetCommand}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="3" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True">
                <DockPanel>
                    <TextBox Classes="Search" DockPanel.Dock="Top" Margin="0,0,0,8"
                             Text="{Binding Search}" PlaceholderText="Personel ara (ad / unvan / telefon)"/>
                    <Border Classes="TableHeader" ctrl:TableHeaderSync.Source="{Binding #TabloItems}" DockPanel.Dock="Top">
                        <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="*,*,Auto,Auto,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="AD SOYAD" MinWidth="180"/>
                            <SelectableTextBlock Grid.Column="1" Text="UNVAN" MinWidth="150"/>
                            <SelectableTextBlock Grid.Column="2" Text="ERİŞİM" MinWidth="180" MaxWidth="180"/>
                            <SelectableTextBlock Grid.Column="3" Text="TELEFON" MinWidth="130" MaxWidth="130"/>
                            <SelectableTextBlock Grid.Column="4" Text="DURUM" MinWidth="80" MaxWidth="80"/>
                        </Grid>
                    </Border>
                    <!-- Tek tık = seçim. Çift tık = düzenleme formu (Malzemeler/Araçlar ile AYNI davranış). -->
                    <ListBox x:Name="TabloItems" Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                             DoubleTapped="OnRowDoubleTapped">
                        <!-- ⭐ iOS tasarım (2026-10-28): satır SAĞ TIK menüsü — seçili kayıt işlemleri (ekrandaki düğmelerle aynı komut ve koşul) -->
                        <ListBox.ContextMenu>
                            <ContextMenu Classes="SatirMenusu">
                                <MenuItem Header="Düzenle" Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <MenuItem Header="Zimmet Tutanağı" Command="{Binding TutanakOlusturCommand}" IsVisible="{Binding HasZimmet}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <Separator/>
                                <MenuItem Header="Sil" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonnelRowVm">
                                <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="*,*,Auto,Auto,Auto">
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding FullName}" MinWidth="180" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Title}" MinWidth="150" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding AccessBadge}" MinWidth="180" MaxWidth="180" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AccessBadge}" />
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding Phone}" MinWidth="130" MaxWidth="130" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Phone}" />
                                    <SelectableTextBlock Grid.Column="4" MinWidth="80" MaxWidth="80" VerticalAlignment="Center"
                                               Text="{Binding IsActive, Converter={x:Static vm:ActiveTextConverter.Instance}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel ActionText="Yeni Personel" ActionCommand="{Binding NewPersonnelCommand}" Mode="Empty" Title="Personel yok" Message="Henüz personel yok.">
                <!-- ekleme formu açıkken gizli (form zaten açık; düğmesi küçük pencerede taşıyordu) -->
                <ctrl:StatePanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsEmpty"/>
                        <Binding Path="!ShowAdd"/>
                    </MultiBinding>
                </ctrl:StatePanel.IsVisible>
            </ctrl:StatePanel>
        </Panel>

        <SelectableTextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
