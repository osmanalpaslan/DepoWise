<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:org="using:DepoWise.Infrastructure.Org"
             xmlns:orgz="using:DepoWise.Infrastructure.Organization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.PersonnelView"
             x:DataType="vm:PersonnelViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Personel"
                      PrimaryActionText="Yeni Personel" PrimaryActionCommand="{Binding NewPersonnelCommand}">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                <SelectableTextBlock Text="{Binding FormTitle}" Classes="SectionTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Ad Soyad" IsRequired="True" Width="240">
                        <TextBox Classes="Field" Text="{Binding FFullName}"/>
                    </ctrl:FormField>
                    <!-- Unvan: sabit tanım listesinden seçilir; "+" ile yeni tanım eklenir -->
                    <ctrl:FormField Label="Unvan" Width="220">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox Classes="Field" Width="180" ItemsSource="{Binding Titles}" SelectedItem="{Binding FTitle}"/>
                            <Button Classes="Secondary" Content="+" Width="34" ToolTip.Tip="Yeni unvan tanımı ekle"
                                    Command="{Binding ToggleAddTitleCommand}" IsVisible="{Binding CanWrite}"/>
                        </StackPanel>
                    </ctrl:FormField>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowAddTitle}">
                    <TextBox Classes="Field" Width="200" PlaceholderText="Yeni unvan" Text="{Binding NewTitle}"/>
                    <Button Classes="Primary" Content="Ekle" Command="{Binding AddTitleCommand}"/>
                    <Button Classes="Secondary" Content="Vazgeç" Command="{Binding ToggleAddTitleCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Telefon" Width="180">
                        <TextBox Classes="Field" Text="{Binding FPhone}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Şube" Width="200">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}" SelectedItem="{Binding FBranch}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="orgz:BranchRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Aktif" Width="70">
                        <CheckBox IsChecked="{Binding FActive}" VerticalAlignment="Center"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Saha personeli" Width="130">
                        <CheckBox IsChecked="{Binding FFieldStaff}" VerticalAlignment="Center"
                                  ToolTip.Tip="İşaretlenirse bu kişi uygulamaya girmez; kullanıcı bağlanmadı uyarısı çıkmaz."/>
                    </ctrl:FormField>
                </StackPanel>
                <!-- Olası aynı kişi uyarısı (#6) -->
                <Border Classes="Panel" Padding="10" IsVisible="{Binding FDupWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <SelectableTextBlock Text="{Binding FDupWarning}" Classes="Helper" TextWrapping="Wrap"
                                         Foreground="{DynamicResource WarningBrush}"/>
                </Border>

                <!-- Uygulama erişimi: MEVCUT kullanıcıyı bağla (hesap açma yok) -->
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding FHasAccount}">
                    <SelectableTextBlock Text="Bağlı uygulama hesabı:" Classes="Helper" VerticalAlignment="Center"/>
                    <SelectableTextBlock Text="{Binding FAccountInfo}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Classes="Secondary" Content="Bağı kaldır" Command="{Binding RemoveAccountCommand}"
                            IsVisible="{Binding CanManageAccounts}"/>
                </StackPanel>

                <CheckBox Content="Mevcut kullanıcıyı bağla"
                          IsChecked="{Binding FGrantAccess}" IsVisible="{Binding ShowGrantToggle}"/>
                <StackPanel Spacing="10" IsVisible="{Binding ShowAccountFields}">
                    <ctrl:FormField Label="Bağlanacak Kullanıcı" IsRequired="True" Width="360"
                                    IsVisible="{Binding HasLinkableUsers}">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding LinkableUsers}" SelectedItem="{Binding FLinkUser}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Username}"/>
                                        <Run Text="{Binding FullName, StringFormat=' — {0}'}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ctrl:FormField>
                    <SelectableTextBlock Classes="Helper" TextWrapping="Wrap" IsVisible="{Binding !HasLinkableUsers}"
                                         Text="Bağlanabilir (henüz bir personele bağlı olmayan) kullanıcı yok. Önce 'Kullanıcılar' ekranından hesap açın."/>
                    <SelectableTextBlock Text="Yalnız henüz bir personele bağlı olmayan kullanıcılar listelenir. Ekran yetkileri 'Yetkiler' ekranından ayarlanır."
                                         Classes="Helper" TextWrapping="Wrap" IsVisible="{Binding HasLinkableUsers}"/>
                </StackPanel>

                <SelectableTextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding CancelAddCommand}"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding HasSelection}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <SelectableTextBlock Text="Seçili:" Classes="Helper" VerticalAlignment="Center"/>
                <SelectableTextBlock Text="{Binding Selected.FullName}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Classes="Secondary" Content="Düzenle" Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}"/>
                <Button Classes="Danger" Content="Sil" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"/>
            </StackPanel>
        </Border>

        <Panel Grid.Row="3" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True">
                <DockPanel>
                    <TextBox Classes="Search" DockPanel.Dock="Top" Margin="0,0,0,8"
                             Text="{Binding Search}" PlaceholderText="Personel ara (ad / unvan / telefon)"/>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="*,*,Auto,Auto,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="AD SOYAD" MinWidth="180"/>
                            <SelectableTextBlock Grid.Column="1" Text="UNVAN" MinWidth="150"/>
                            <SelectableTextBlock Grid.Column="2" Text="ERİŞİM" MinWidth="180"/>
                            <SelectableTextBlock Grid.Column="3" Text="TELEFON" MinWidth="130"/>
                            <SelectableTextBlock Grid.Column="4" Text="DURUM" MinWidth="80"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonnelRowVm">
                                <Grid ColumnDefinitions="*,*,Auto,Auto,Auto">
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding FullName}" MinWidth="180" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Title}" MinWidth="150" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding AccessBadge}" MinWidth="180" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding Phone}" MinWidth="130" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="4" MinWidth="80" VerticalAlignment="Center"
                                               Text="{Binding IsActive, Converter={x:Static vm:ActiveTextConverter.Instance}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Personel yok" Message="Henüz personel yok." IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
