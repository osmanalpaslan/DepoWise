<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DepoWise.Desktop.Views.ConfirmWindow"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="DepoWise" Icon="/Assets/app-logo.ico"
        Background="{DynamicResource SurfaceBrush}">
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
        <StackPanel Margin="24" Spacing="16">
            <TextBlock x:Name="TitleText" Classes="PageTitle"/>
            <TextBlock x:Name="MsgText" Classes="Body" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Classes="Secondary" IsCancel="True"/>
                <Button x:Name="OkBtn" Classes="Primary" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
