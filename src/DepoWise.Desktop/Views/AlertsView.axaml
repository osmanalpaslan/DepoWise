<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:rep="using:DepoWise.Application.Reports"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="DepoWise.Desktop.Views.AlertsView"
             x:DataType="vm:AlertsViewModel">
    <ScrollViewer Background="{DynamicResource AppBackgroundBrush}" Padding="24">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon Width="20" Height="20" VerticalAlignment="Center"
                          Foreground="{DynamicResource AccentBrush}" Data="{DynamicResource IconAlerts}"/>
                <SelectableTextBlock Text="Uyarılar" Classes="SectionTitle" VerticalAlignment="Center"/>
                <Button Classes="Secondary YenileDugme" Command="{Binding LoadCommand}" Margin="12,0,0,0" ToolTip.Tip="Yenile (F5)" AutomationProperties.Name="Yenile"><PathIcon Data="{DynamicResource IconSync}"/></Button>
            </StackPanel>
            <SelectableTextBlock Classes="Helper"
                Text="Aktif uyarılar kategori başlıkları altında (bakım, muayene/sigorta, stok, yakıt, evrak, iş emri, talep). 'Okundu' yalnız çan sayacını ve ana ekranı sakinleştirir — uyarı aktif olduğu sürece burada kalır, durumu kötüleşirse yeniden okunmamış olur."/>

            <!-- BLD-01: evrak bildirimleri sunucu-otoriteli — çevrimdışıyken not -->
            <Border IsVisible="{Binding HasRemoteNote}" Background="{DynamicResource SurfaceElevatedBrush}"
                    CornerRadius="{StaticResource Radius8}" Padding="14,10" HorizontalAlignment="Left">
                <SelectableTextBlock Text="{Binding RemoteNote}" Classes="Body"/>
            </Border>

            <!-- Kategori butonları (sayılı) — kullanıcı isteği 2026-07-25 -->
            <WrapPanel>
                <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding Filter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=material}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="material">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconMaterials}"/>
                        <TextBlock Text="Malzeme" VerticalAlignment="Center"/>
                        <Border Classes="adet"><TextBlock Text="{Binding MalzemeCount}"/></Border>
                    </StackPanel>
                </Button>
                <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding Filter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=maintenance}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="maintenance">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconMaintenance}"/>
                        <TextBlock Text="Bakım" VerticalAlignment="Center"/>
                        <Border Classes="adet"><TextBlock Text="{Binding BakimCount}"/></Border>
                    </StackPanel>
                </Button>
                <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding Filter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=inspection}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="inspection">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconWebAdmin}"/>
                        <TextBlock Text="Sigorta-Muayene" VerticalAlignment="Center"/>
                        <Border Classes="adet"><TextBlock Text="{Binding MuayeneCount}"/></Border>
                    </StackPanel>
                </Button>
                <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding Filter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=fuel}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="fuel">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconFuel}"/>
                        <TextBlock Text="Yakıt" VerticalAlignment="Center"/>
                        <Border Classes="adet"><TextBlock Text="{Binding YakitCount}"/></Border>
                    </StackPanel>
                </Button>
                <!-- BLD-01 (ADR-172): yeni kaynaklar + "Tümü" + tümünü okundu -->
                <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding Filter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=document}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="document">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconAudit}"/>
                        <TextBlock Text="Evrak" VerticalAlignment="Center"/>
                        <Border Classes="adet"><TextBlock Text="{Binding EvrakCount}"/></Border>
                    </StackPanel>
                </Button>
                <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding Filter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=work_order}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="work_order">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconRequests}"/>
                        <TextBlock Text="İş Emri" VerticalAlignment="Center"/>
                        <Border Classes="adet"><TextBlock Text="{Binding IsEmriCount}"/></Border>
                    </StackPanel>
                </Button>
                <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding Filter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=request}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="request">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconRequests}"/>
                        <TextBlock Text="Talep" VerticalAlignment="Center"/>
                        <Border Classes="adet"><TextBlock Text="{Binding TalepCount}"/></Border>
                    </StackPanel>
                </Button>
                <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding Filter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=announcement}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="announcement">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconAlerts}"/>
                        <TextBlock Text="Duyuru" VerticalAlignment="Center"/>
                        <Border Classes="adet"><TextBlock Text="{Binding DuyuruCount}"/></Border>
                    </StackPanel>
                </Button>
                <!-- 2026-10-10: kiralık araç kira bitişi uyarıları -->
                <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding Filter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=rental}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="rental">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconVehicles}"/>
                        <TextBlock Text="Kiralık" VerticalAlignment="Center"/>
                        <Border Classes="adet"><TextBlock Text="{Binding KiralikCount}"/></Border>
                    </StackPanel>
                </Button>
                <Button Classes="Cip" Margin="0,0,8,8" Classes.secili="{Binding Filter, Converter={x:Static vm:EsitMi.Instance}, ConverterParameter=all}"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="all">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Tümü" VerticalAlignment="Center"/>
                        <Border Classes="adet"><TextBlock Text="{Binding ToplamCount}"/></Border>
                    </StackPanel>
                </Button>
                <Button Classes="Secondary" Margin="0,0,8,8" CornerRadius="999" Padding="14,7"
                        Command="{Binding MarkAllReadCommand}" IsVisible="{Binding HasUnread}"
                        ToolTip.Tip="Tüm aktif uyarıları okundu işaretler — çan sayacı sıfırlanır; uyarılar bu ekranda kalır.">
                    <TextBlock Text="Tümünü Okundu Yap" VerticalAlignment="Center"/>
                </Button>
            </WrapPanel>

            <SelectableTextBlock Text="{Binding LoadError}" Foreground="{DynamicResource DangerBrush}"
                       IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}"/>

            <!-- ⭐ iOS tasarım (2026-10-28): uyarılar gruplu liste (ana ekranla aynı) -->
            <Border Classes="IosGrup" IsVisible="{Binding HasAlerts}">
            <ItemsControl ItemsSource="{Binding Alerts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="rep:DashboardAlert">
                        <Button Classes="IosSatir" Opacity="{Binding RowOpacity}"
                                Command="{Binding $parent[ItemsControl].((vm:AlertsViewModel)DataContext).OpenAlertCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="İlgili ekranı aç">
                            <Border Padding="16,10,12,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="0,Auto,*,Auto">
                                    <!-- renkli simge kutusu: kritik = kırmızı, yaklaşıyor = turuncu; simge uyarı TİPİNE göre -->
                                    <Border Grid.Column="1" Classes="IkonKutu" VerticalAlignment="Top"
                                            Background="{Binding IsCritical, Converter={x:Static vm:AlertBrush.Instance}}">
                                        <PathIcon Data="{Binding Kind, Converter={x:Static vm:AlertIcon.Instance}}"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                                        <SelectableTextBlock Text="{Binding Title}" Classes="Body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <SelectableTextBlock Text="{Binding Detail}" Classes="Helper" TextTrimming="CharacterEllipsis"/>
                                        <!-- 2026-10-04: bilgilendirme notu — uyarı neden sürüyor / ne yapılmalı -->
                                        <SelectableTextBlock Text="{Binding Note, StringFormat='ⓘ {0}'}" IsVisible="{Binding HasNote}" Classes="Helper"
                                                             Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <!-- BLD-01: okundu/okunmadı ayrımı + tek uyarıyı okundu işaretleme (satır tıklamasını tetiklemez) -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                                        <Border IsVisible="{Binding Read}" CornerRadius="999" Padding="8,2"
                                                Background="{DynamicResource SurfaceElevatedBrush}">
                                            <TextBlock Text="Okundu" FontSize="11" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Classes="Secondary" Content="Okundu işaretle" IsVisible="{Binding !Read}"
                                                ToolTip.Tip="Çan sayacından düşer; durumu kötüleşirse yeniden görünür."
                                                Command="{Binding $parent[ItemsControl].((vm:AlertsViewModel)DataContext).MarkReadCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Border>

            <!-- İlk açılış: kategori seçilmedi → yalnız yönlendirme ipucu (uyarı listelenmez). -->
            <Border IsVisible="{Binding ShowSelectPrompt}" Background="{DynamicResource SurfaceElevatedBrush}"
                    CornerRadius="{StaticResource Radius8}" Padding="14,10" HorizontalAlignment="Left">
                <SelectableTextBlock Text="Uyarıları görmek için yukarıdan bir kategori seçin." Classes="Body" VerticalAlignment="Center"/>
            </Border>

            <!-- Seçili kategori boş → o kategoride uyarı yok. -->
            <Border IsVisible="{Binding ShowEmptyCategory}" Background="{DynamicResource SurfaceElevatedBrush}"
                    CornerRadius="{StaticResource Radius8}" Padding="14,10" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource SuccessBrush}">
                        <PathIcon Width="13" Height="13" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="{DynamicResource IconCheck}"/>
                    </Border>
                    <SelectableTextBlock Text="Bu kategoride aktif uyarı yok." Classes="Body" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
