<!-- B-4 (PRT-01 Grup 3, 2026-08-10) — İPTAL GEREKÇESİ penceresi.
     ConfirmWindow yalnız evet/hayır döndürdüğü için gerekçe toplayamıyordu. İptal geri alınamaz bir işlem
     olduğundan uyarı metni ve gerekçe alanı TEK pencerede toplanır; kullanıcı fazladan tıklama yapmaz.
     ConfirmWindow'a dokunulmadı (çok sayıda çağıranı var, regresyon riski alınmadı). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DepoWise.Desktop.Views.ReasonWindow"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Alpnex" Icon="/Assets/app-logo.ico"
        Background="{DynamicResource SurfaceBrush}">
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
        <StackPanel Margin="24" Spacing="12">
            <SelectableTextBlock x:Name="TitleText" Classes="PageTitle"/>
            <SelectableTextBlock x:Name="MsgText" Classes="Body" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="LabelText" Classes="SectionTitle"/>
            <TextBox x:Name="ReasonBox" Classes="Field" MaxLength="200"
                     AcceptsReturn="False" TextWrapping="Wrap" Height="60"
                     PlaceholderText="Örn: Yanlış araca girildi"/>
            <SelectableTextBlock x:Name="ErrText" Classes="Helper" IsVisible="False"
                                 Text="İptal gerekçesi zorunlu." Foreground="{DynamicResource DangerBrush}"/>
            <SelectableTextBlock Classes="Helper" Text="Bu gerekçe kayıt geçmişine yazılır."/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Classes="Secondary" IsCancel="True"/>
                <Button x:Name="OkBtn" Classes="Danger" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
