<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="DepoWise.Desktop.Views.TrashView"
             x:DataType="vm:TrashViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Çöp Kutusu">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <Panel Grid.Row="1" Margin="0,16,0,0">
            <!-- G6-04: kilit ekranı — parola doğrulanana kadar liste hiç yüklenmez (web ile aynı akış). -->
            <Border Classes="Card" IsVisible="{Binding IsLocked}" MaxWidth="460" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Padding="24">
                <StackPanel Spacing="12">
                    <SelectableTextBlock Classes="SectionTitle" Text="🔒 Çöp Kutusu kilitli"/>
                    <SelectableTextBlock Classes="Body" TextWrapping="Wrap"
                                         Text="Bu ekran silinmiş kayıtları gösterir ve geri yükleme yapar. Güvenlik için parolanızı yeniden girmeniz gerekir."/>
                    <SelectableTextBlock Classes="Helper" Foreground="{DynamicResource DangerBrush}"
                                         Text="{Binding UnlockError}" IsVisible="{Binding UnlockError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="Primary" Content="Çöp Kutusunu Aç" HorizontalAlignment="Left"
                            Command="{Binding UnlockCommand}"/>
                </StackPanel>
            </Border>
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="Auto,*,Auto,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="TÜR" MinWidth="140" MaxWidth="140"/>
                            <SelectableTextBlock Grid.Column="1" Text="KAYIT" MinWidth="220"/>
                            <SelectableTextBlock Grid.Column="2" Text="SİLİNME" MinWidth="140" MaxWidth="140"/>
                            <SelectableTextBlock Grid.Column="3" Text="" MinWidth="100" MaxWidth="100"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrashRowVm">
                                <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="Auto,*,Auto,Auto">
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding TableText}" MinWidth="140" MaxWidth="140" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TableText}" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Label}" MinWidth="220" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding DateText}" MinWidth="140" MaxWidth="140" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DateText}" />
                                    <Button Grid.Column="3" Classes="Secondary" Content="↺ Geri Yükle" MinWidth="100"
                                            Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RestoreCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Çöp kutusu boş" Message="Silinmiş kayıt yok." IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
