<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="DepoWise.Desktop.Views.ServerBackupsView"
             x:DataType="vm:ServerBackupsViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Sunucu Yedekleri (Süper Admin)"/>

        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0">
            <StackPanel Spacing="12">
                <SelectableTextBlock Classes="Helper" TextWrapping="Wrap"
                    Text="Bu ekran nasıl dolar? Yedekler masaüstünde günde 1 kez otomatik + elle 'Yedek Al' ile alınır. Ayarlar › Sunucu Yedek altında sunucu adresi tanımlıysa her yedek buluta yüklenir ve burada görünür. Sunucu yüklenen yedekleri hiçbir zaman silmez; yerelde 30 günlük döngü işler. Liste boşsa henüz hiçbir makine sunucuya yükleme yapmamıştır (sunucu adresi tanımsız olabilir)."/>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <ctrl:FormField Label="Başlangıç" Width="150">
                        <ctrl:TarihKutusu SelectedDate="{Binding From}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Bitiş" Width="150">
                        <ctrl:TarihKutusu SelectedDate="{Binding To}"/>
                    </ctrl:FormField>
                    <Button Classes="Primary" Content="Listele" VerticalAlignment="Bottom"
                            Command="{Binding LoadCommand}" IsEnabled="{Binding !Busy}"/>
                    <Button Classes="Danger" Content="Seçili Aralığı Sil" VerticalAlignment="Bottom"
                            Command="{Binding DeleteRangeCommand}" IsEnabled="{Binding !Busy}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="Table" Margin="0,16,0,0" IsVisible="{Binding HasRows}">
            <DockPanel>
                <Border Classes="TableHeader" DockPanel.Dock="Top">
                    <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="*,*,Auto,Auto">
                        <SelectableTextBlock Grid.Column="0" Text="MAKİNE" MinWidth="160"/>
                        <SelectableTextBlock Grid.Column="1" Text="DOSYA" MinWidth="220"/>
                        <SelectableTextBlock Grid.Column="2" Text="TARİH" MinWidth="150" MaxWidth="150"/>
                        <SelectableTextBlock Grid.Column="3" Text="BOYUT" MinWidth="100" MaxWidth="100"/>
                    </Grid>
                </Border>
                <ListBox Classes="Table" ItemsSource="{Binding Items}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerBackupRowVm">
                            <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="*,*,Auto,Auto">
                                <SelectableTextBlock Grid.Column="0" Text="{Binding Machine}" MinWidth="160" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <SelectableTextBlock Grid.Column="1" Text="{Binding FileName}" MinWidth="220" VerticalAlignment="Center"/>
                                <SelectableTextBlock Grid.Column="2" Text="{Binding DateText}" MinWidth="150" MaxWidth="150" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DateText}" />
                                <SelectableTextBlock Grid.Column="3" Text="{Binding SizeText}" MinWidth="100" MaxWidth="100" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SizeText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <SelectableTextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
