<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:DepoWise.Desktop.Controls"
        x:Class="DepoWise.Desktop.Views.VehicleQuickEditWindow"
        Width="820" Height="720" MinWidth="640" MinHeight="520" CanResize="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Alpnex — Araç" Icon="/Assets/app-logo.ico"
        Background="{DynamicResource SurfaceBrush}">
    <!-- Çift-tık ile açılan araç hızlı düzenle penceresi (kullanıcı isteği 2026-07-19). "Düzelt"e basılana
         kadar alanlar KİLİTLİ. İç kod ve sayaç bu pencerede değişmez (sayaç geri gitme koruması). -->
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
        <DockPanel Margin="22">
            <SelectableTextBlock DockPanel.Dock="Top" x:Name="TitleText" Text="Araç" Classes="PageTitle" Margin="0,0,0,10"/>

            <!-- Alt butonlar sekmelerin DIŞINDA kalır: hangi sekmede olursanız olun Kaydet/Kapat görünür. -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelBtn" Classes="Secondary" Content="Kapat" IsCancel="True"/>
                <Button x:Name="DeleteBtn" Classes="Danger" Content="Sil"/>
                <Button x:Name="EditBtn" Classes="Secondary" Content="Düzelt"/>
                <Button x:Name="SaveBtn" Classes="Primary" Content="Kaydet" IsVisible="False"/>
            </StackPanel>
            <SelectableTextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Classes="Body"
                                 Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="False"/>
            <SelectableTextBlock DockPanel.Dock="Bottom" x:Name="HintText" Classes="Helper" TextWrapping="Wrap" IsVisible="False"
                Text="İç kod ve sayaç bu pencerede değişmez; fotoğraf eklemek/silmek için liste ekranındaki “Düzenle”yi kullanın."/>

            <TabControl x:Name="Tabs">
            <TabItem Header="Bilgi">
              <ScrollViewer>
                <StackPanel Spacing="10" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="İç Kod" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <SelectableTextBlock Grid.Row="0" Grid.Column="1" x:Name="CodeText" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,6,14,6"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Plaka" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="PlateBox" Classes="Field" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Durum" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="StatusBox" Classes="Field" HorizontalAlignment="Stretch" Margin="0,4,14,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Üretim Yılı" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <NumericUpDown Grid.Row="1" Grid.Column="3" x:Name="YearBox" Classes="Field" FormatString="0" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Durum Açıklaması" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="NoteBox" Classes="Field" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Makine Tipi" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <!-- İş #9: sabit tanım (lookup) alanları ana ekranlarla AYNI ortak bileşene geçirildi.
                     "Durum" 3 sabit değerdir → ComboBox olarak KALIR (lookup değil, enum). -->
                <ctrl:LookupBox Grid.Row="3" Grid.Column="1" x:Name="TypeBox" HorizontalAlignment="Stretch" Margin="0,4,14,4" PlaceholderText="Makine tipi seç / ara..."/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Kategori" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ctrl:LookupBox Grid.Row="3" Grid.Column="3" x:Name="CatBox" HorizontalAlignment="Stretch" Margin="0,4,0,4" PlaceholderText="Kategori seç / ara..."/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Marka" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ctrl:LookupBox Grid.Row="4" Grid.Column="1" x:Name="BrandBox" HorizontalAlignment="Stretch" Margin="0,4,14,4" PlaceholderText="Marka seç / ara..."/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Model" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ctrl:LookupBox Grid.Row="4" Grid.Column="3" x:Name="ModelBox" HorizontalAlignment="Stretch" Margin="0,4,0,4" PlaceholderText="Model seç / ara..."/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Şantiye / Şube" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ctrl:LookupBox Grid.Row="5" Grid.Column="1" x:Name="BranchBox" HorizontalAlignment="Stretch" Margin="0,4,14,4" PlaceholderText="Şube seç / ara..."/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="Sürücü" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <!-- İş #9: AutoCompleteBox → LookupBox. Sürücü seçimi artık diğer ekranlarla AYNI davranıyor
                     (tıkla-aç, 25'lik sayfalama, Türkçe-doğru arama). -->
                <ctrl:LookupBox Grid.Row="5" Grid.Column="3" x:Name="DriverBox" HorizontalAlignment="Stretch" Margin="0,4,0,4"
                                PlaceholderText="Personel seç / ara..."/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Şasi No" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <TextBox   Grid.Row="6" Grid.Column="1" x:Name="ChassisBox" Classes="Field" Margin="0,4,14,4"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="Motor No / Sayaç" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <StackPanel Grid.Row="6" Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                    <TextBox x:Name="EngineBox" Classes="Field" Width="120"/>
                    <SelectableTextBlock x:Name="MeterText" Classes="Body" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ⭐ FAZ 4.7: sağ bilgi panelindeki veriler EK SEKMELER olarak. İçerik salt-okunurdur;
                 ekleme/silme kendi ekranlarında yapılır (bu pencere bir GÖRÜNTÜLEME penceresidir). -->
            <TabItem Header="Uyumlu Malzemeler">
              <DockPanel>
                <SelectableTextBlock DockPanel.Dock="Top" x:Name="MaterialsEmpty" Classes="Helper" IsVisible="False"
                                     Text="Bu araca uyumlu malzeme tanımlanmamış." Margin="0,8,0,0"/>
                <ListBox x:Name="MaterialsList" Classes="Table" Margin="0,8,0,0"/>
              </DockPanel>
            </TabItem>

            <TabItem Header="Muayene / Sigorta">
              <DockPanel>
                <SelectableTextBlock DockPanel.Dock="Top" x:Name="InspectionsEmpty" Classes="Helper" IsVisible="False"
                                     Text="Bu araca ait muayene/sigorta kaydı yok." Margin="0,8,0,0"/>
                <ListBox x:Name="InspectionsList" Classes="Table" Margin="0,8,0,0"/>
              </DockPanel>
            </TabItem>

            <TabItem Header="Bakımlar">
              <DockPanel>
                <SelectableTextBlock DockPanel.Dock="Top" x:Name="MaintenancesEmpty" Classes="Helper" IsVisible="False"
                                     Text="Bu araca ait bakım kaydı yok." Margin="0,8,0,0"/>
                <ListBox x:Name="MaintenancesList" Classes="Table" Margin="0,8,0,0"/>
              </DockPanel>
            </TabItem>

            <TabItem Header="İşlem Geçmişi">
              <DockPanel>
                <SelectableTextBlock DockPanel.Dock="Top" x:Name="HistoryEmpty" Classes="Helper" IsVisible="False"
                                     Text="Bu araca ait işlem geçmişi yok." Margin="0,8,0,0"/>
                <ListBox x:Name="HistoryList" Classes="Table" Margin="0,8,0,0"/>
              </DockPanel>
            </TabItem>

            <!-- Kullanıcı isteği (2026-09-02): "başka makinede eklenen fotoğrafı çift tıkta göremiyorum."
                 Fotoğraflar SUNUCUDAN okunur (ADR-182) → hangi bilgisayardan eklendiği fark etmez.
                 Bu pencerede yalnız GÖRÜNTÜLENİR; ekleme/silme tam düzenleme formundadır. -->
            <TabItem Header="Fotoğraflar">
              <StackPanel x:Name="PhotoSection" Spacing="6" Margin="0,8,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PhotoPanel" Orientation="Horizontal" Spacing="8"/>
                </ScrollViewer>
                <SelectableTextBlock x:Name="PhotoNote" Classes="Helper" TextWrapping="Wrap" IsVisible="False"/>
              </StackPanel>
            </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
