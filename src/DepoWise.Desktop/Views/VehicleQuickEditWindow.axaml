<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DepoWise.Desktop.Views.VehicleQuickEditWindow"
        Width="600" SizeToContent="Height" MaxHeight="760" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="DepoWise — Araç" Icon="/Assets/app-logo.ico"
        Background="{DynamicResource SurfaceBrush}">
    <!-- Çift-tık ile açılan araç hızlı düzenle penceresi (kullanıcı isteği 2026-07-19). "Düzelt"e basılana
         kadar alanlar KİLİTLİ. İç kod ve sayaç bu pencerede değişmez (sayaç geri gitme koruması). -->
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
        <StackPanel Margin="22" Spacing="10">
            <SelectableTextBlock x:Name="TitleText" Text="Araç" Classes="PageTitle"/>

            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="İç Kod" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <SelectableTextBlock Grid.Row="0" Grid.Column="1" x:Name="CodeText" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,6,14,6"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Plaka" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="PlateBox" Classes="Field" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Durum" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="StatusBox" Classes="Field" HorizontalAlignment="Stretch" Margin="0,4,14,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Üretim Yılı" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <NumericUpDown Grid.Row="1" Grid.Column="3" x:Name="YearBox" Classes="Field" FormatString="0" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Durum Açıklaması" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="NoteBox" Classes="Field" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Makine Tipi" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="TypeBox" Classes="Field" HorizontalAlignment="Stretch" Margin="0,4,14,4"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Kategori" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ComboBox  Grid.Row="3" Grid.Column="3" x:Name="CatBox" Classes="Field" HorizontalAlignment="Stretch" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Marka" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="BrandBox" Classes="Field" HorizontalAlignment="Stretch" Margin="0,4,14,4"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Model" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ComboBox  Grid.Row="4" Grid.Column="3" x:Name="ModelBox" Classes="Field" HorizontalAlignment="Stretch" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Şantiye / Şube" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="BranchBox" Classes="Field" HorizontalAlignment="Stretch" Margin="0,4,14,4"/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="Sürücü" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <ComboBox  Grid.Row="5" Grid.Column="3" x:Name="DriverBox" Classes="Field" HorizontalAlignment="Stretch" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Şasi No" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <TextBox   Grid.Row="6" Grid.Column="1" x:Name="ChassisBox" Classes="Field" Margin="0,4,14,4"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="Motor No / Sayaç" Classes="Body" VerticalAlignment="Center" Margin="0,6,10,6"/>
                <StackPanel Grid.Row="6" Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                    <TextBox x:Name="EngineBox" Classes="Field" Width="120"/>
                    <SelectableTextBlock x:Name="MeterText" Classes="Body" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <SelectableTextBlock x:Name="StatusText" Classes="Body" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="False"/>
            <SelectableTextBlock x:Name="HintText" Classes="Helper" TextWrapping="Wrap" IsVisible="False"
                Text="İç kod ve sayaç bu pencerede değişmez; fotoğraflar için liste ekranındaki “Düzenle”yi kullanın."/>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Classes="Secondary" Content="Kapat" IsCancel="True"/>
                <Button x:Name="DeleteBtn" Classes="Danger" Content="Sil"/>
                <Button x:Name="EditBtn" Classes="Secondary" Content="Düzelt"/>
                <Button x:Name="SaveBtn" Classes="Primary" Content="Kaydet" IsVisible="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
