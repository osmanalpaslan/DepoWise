<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DepoWise.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="560"
        x:Class="DepoWise.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Width="880" Height="560" CanResize="False"
        Icon="/Assets/app-logo.ico"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="None"
        Title="Alpnex — Giriş">

    <Window.Background>
        <RadialGradientBrush Center="50%,-8%" GradientOrigin="50%,-8%" RadiusX="95%" RadiusY="80%">
            <GradientStop Color="#1B2436" Offset="0"/>
            <GradientStop Color="#101828" Offset="0.5"/>
            <GradientStop Color="#0A0F1B" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Styles>
        <Style Selector="Border.Field">
            <Setter Property="Background" Value="#0B111E"/>
            <Setter Property="BorderBrush" Value="#1E2A3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="13,0"/>
        </Style>
        <Style Selector="Border.Field:pointerover">
            <Setter Property="BorderBrush" Value="#2E4260"/>
        </Style>
        <!-- Aurora imzası: alana odaklanınca kehribar halka -->
        <Style Selector="Border.Field:focus-within">
            <Setter Property="BorderBrush" Value="#8CF5A623"/>
        </Style>
        <Style Selector="PathIcon.FieldIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="#6C7C93"/>
            <Setter Property="Margin" Value="0,0,11,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.Bare">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#EEF3F9"/>
            <Setter Property="CaretBrush" Value="#F5A623"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBox.Bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Bare:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- Adım 2 için koyu ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#0E1826"/>
            <Setter Property="BorderBrush" Value="#243750"/>
            <Setter Property="Foreground" Value="#EEF3F9"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="13,0"/>
        </Style>
        <Style Selector="TextBlock.Lbl">
            <Setter Property="Foreground" Value="#A9B6C8"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector="Button.Primary">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FBBF4A" Offset="0"/>
                        <GradientStop Color="#F0980D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#241703"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- İçerik sunucusu da tam ortalansın (tema padding'i yazıyı kaydırmasın) -->
        <Style Selector="Button.Primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F8B740"/>
            <Setter Property="Foreground" Value="#241703"/>
        </Style>
        <Style Selector="Button.Ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2B4162"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D3DCE8"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12203350"/>
            <Setter Property="Foreground" Value="#EAF0F7"/>
        </Style>
        <Style Selector="Button.Link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8FA0B6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Marka paneli madde satırı (FAZ M5) -->
        <Style Selector="Border.BrandPoint">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,8,11,8"/>
        </Style>
        <Style Selector="Border.BrandPointIcon">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#24F5A623"/>
            <Setter Property="BorderBrush" Value="#3DF5A623"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="46*,54*">

        <!-- ═══ SOL: marka paneli (FAZ M5) ═══ -->
        <Grid Grid.Column="0">
            <!-- İş makineleri görseli: artık GERÇEKTEN görünür (eskiden 0.10) -->
            <Image Source="/Assets/login-bg.png" Opacity="0.22" Stretch="UniformToFill"
                   VerticalAlignment="Bottom" IsHitTestVisible="False"/>
            <!-- Aurora ışıma katmanları (mevcut iki Border'ın taşınmış hâli) -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="18%,12%" GradientOrigin="18%,12%" RadiusX="80%" RadiusY="60%">
                        <GradientStop Color="#42F5A623" Offset="0"/>
                        <GradientStop Color="#00F5A623" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="90%,88%" GradientOrigin="90%,88%" RadiusX="75%" RadiusY="60%">
                        <GradientStop Color="#3A6366F1" Offset="0"/>
                        <GradientStop Color="#006366F1" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <!-- Karartma: görselin üstünde metin okunur kalsın -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#D60A0F1B" Offset="0"/>
                        <GradientStop Color="#EE0A0F1B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Sağ kenar çizgisi -->
            <Border Width="1" HorizontalAlignment="Right" Background="#14FFFFFF"/>

            <DockPanel Margin="32,30,32,24">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="11">
                    <Image Source="/Assets/app-icon-256.png" Width="42" Height="42" VerticalAlignment="Center"/>
                    <SelectableTextBlock Text="Alpnex" FontSize="19" FontWeight="Bold"
                                         Foreground="#EAEEF7" VerticalAlignment="Center"/>
                </StackPanel>

                <SelectableTextBlock DockPanel.Dock="Bottom" Text="© 2026 Alpnex"
                                     FontSize="11" Foreground="#5D6C88"/>

                <StackPanel VerticalAlignment="Center" Spacing="13">
                    <SelectableTextBlock Text="Depo, araç ve bakım tek panelde."
                                         FontSize="26" FontWeight="Bold" LineHeight="31"
                                         Foreground="#F4F7FC" TextWrapping="Wrap"/>
                    <SelectableTextBlock Text="Sahada girilen kayıt ofiste anında görünür. Bağlantı yokken de çalışır; bağlantı gelince eşitlenir."
                                         FontSize="12.5" LineHeight="20" Foreground="#9AA7C0" TextWrapping="Wrap"/>
                    <StackPanel Spacing="9" Margin="0,8,0,0">
                        <Border Classes="BrandPoint">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Border Classes="BrandPointIcon">
                                    <PathIcon Width="14" Height="14" Foreground="#FBBF4A"
                                              Data="M6.5 19a4.5 4.5 0 0 1-.4-9A6 6 0 0 1 18 10.2a3.9 3.9 0 0 1-.5 8.8h-11Z"/>
                                </Border>
                                <SelectableTextBlock Text="Sahada çevrimdışı çalışır, sonra eşitler"
                                                     FontSize="12.5" Foreground="#C3CCDD" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="BrandPoint">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Border Classes="BrandPointIcon">
                                    <PathIcon Width="14" Height="14" Foreground="#FBBF4A"
                                              Data="M12 5V2L8 6l4 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7Z"/>
                                </Border>
                                <SelectableTextBlock Text="Masaüstü ve web tek veritabanı"
                                                     FontSize="12.5" Foreground="#C3CCDD" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="BrandPoint">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Border Classes="BrandPointIcon">
                                    <PathIcon Width="14" Height="14" Foreground="#FBBF4A"
                                              Data="M12 2 4 5v6c0 5 3.4 9.2 8 11 4.6-1.8 8-6 8-11V5l-8-3Z"/>
                                </Border>
                                <SelectableTextBlock Text="Şube ve rol bazlı yetkilendirme"
                                                     FontSize="12.5" Foreground="#C3CCDD" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- ═══ SAĞ: mevcut form, olduğu gibi (adım panelleri değiştirilmedi) ═══ -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" MaxWidth="330" Margin="26,24" VerticalAlignment="Center">

                <!-- ADIM 1: kimlik -->
                <StackPanel Spacing="12" IsVisible="{Binding IsStep1}">
                    <StackPanel Spacing="7">
                        <TextBlock Classes="Lbl" Text="Kullanıcı Adı"/>
                        <Border Classes="Field">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Grid.Column="0" Classes="FieldIcon" Data="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-3.9 0-7 2.2-7 5v1h14v-1c0-2.8-3.1-5-7-5Z"/>
                                <TextBox Grid.Column="1" Classes="Bare" Text="{Binding Username}" Watermark="Kullanıcı adı"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="7">
                        <TextBlock Classes="Lbl" Text="Parola"/>
                        <Border Classes="Field">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Grid.Column="0" Classes="FieldIcon" Data="M17 9V7a5 5 0 0 0-10 0v2H5v12h14V9h-2Zm-8 0V7a3 3 0 0 1 6 0v2H9Z"/>
                                <TextBox Grid.Column="1" Classes="Bare" Text="{Binding Password}" PasswordChar="●" Watermark="••••••"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <CheckBox Content="Beni hatırla" IsChecked="{Binding RememberMe}" Foreground="#B7C2D2" Margin="0,2,0,0"/>

                    <SelectableTextBlock Text="{Binding Error}" Foreground="#FF9B9B" TextWrapping="Wrap"
                                         IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Button Classes="Primary" Command="{Binding ContinueCommand}" IsDefault="True"
                            IsEnabled="{Binding !IsBusy}" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="DEVAM" VerticalAlignment="Center"/>
                            <PathIcon Width="18" Height="18" Foreground="#241703"
                                      Data="M5 12h12l-4.5-4.5L14 6l7 7-7 7-1.5-1.5L17 14H5z"/>
                        </StackPanel>
                    </Button>

                    <!-- veya ayıracı -->
                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,8,0,0">
                        <Border Grid.Column="0" Height="1" Background="#243750" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="veya" Margin="12,0" Foreground="#6C7C93" FontSize="12" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Height="1" Background="#243750" VerticalAlignment="Center"/>
                    </Grid>

                    <Button Classes="Ghost" Command="{Binding OpenWebCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="17" Height="17" Foreground="#9FB0C6"
                                      Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-2.6a13 13 0 0 0-1.1-3.2A8 8 0 0 1 18.9 8ZM12 4c.8 0 1.9 1.5 2.4 4H9.6C10.1 5.5 11.2 4 12 4ZM4.3 14a8 8 0 0 1 0-4h3a18 18 0 0 0 0 4Zm.8 2h2.6c.3 1.2.7 2.3 1.1 3.2A8 8 0 0 1 5.1 16ZM9.6 16h4.8c-.5 2.5-1.6 4-2.4 4s-1.9-1.5-2.4-4Zm5.1 3.2c.4-.9.8-2 1.1-3.2h2.6a8 8 0 0 1-3.7 3.2ZM16.7 14a18 18 0 0 0 0-4h3a8 8 0 0 1 0 4Z"/>
                            <TextBlock Text="Web'de Giriş Yap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ADIM 4: İLK GİRİŞ şifre belirleme (yeni kullanıcı / admin-reset) -->
                <StackPanel Spacing="12" IsVisible="{Binding IsStepSetPassword}">
                    <SelectableTextBlock Text="Yeni Şifre Belirleyin" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#EEF3F9"/>
                    <SelectableTextBlock Text="Güvenlik için ilk girişte kendi şifrenizi oluşturmalısınız."
                                         Foreground="#9FB0C6" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <StackPanel Spacing="7">
                        <TextBlock Classes="Lbl" Text="Yeni Şifre"/>
                        <Border Classes="Field">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Grid.Column="0" Classes="FieldIcon" Data="M17 9V7a5 5 0 0 0-10 0v2H5v12h14V9h-2Zm-8 0V7a3 3 0 0 1 6 0v2H9Z"/>
                                <TextBox Grid.Column="1" Classes="Bare" Text="{Binding NewPassword}" PasswordChar="●" Watermark="En az 4 karakter"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="7">
                        <TextBlock Classes="Lbl" Text="Yeni Şifre (Tekrar)"/>
                        <Border Classes="Field">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Grid.Column="0" Classes="FieldIcon" Data="M17 9V7a5 5 0 0 0-10 0v2H5v12h14V9h-2Zm-8 0V7a3 3 0 0 1 6 0v2H9Z"/>
                                <TextBox Grid.Column="1" Classes="Bare" Text="{Binding NewPassword2}" PasswordChar="●" Watermark="••••••"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <SelectableTextBlock Text="{Binding Error}" Foreground="#FF9B9B" TextWrapping="Wrap"
                                         IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Button Classes="Primary" Command="{Binding SetPasswordCommand}" IsDefault="True"
                            IsEnabled="{Binding !IsBusy}" Margin="0,4,0,0" HorizontalAlignment="Stretch">
                        <TextBlock Text="ŞİFREYİ BELİRLE" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Classes="Ghost" Command="{Binding BackCommand}" HorizontalAlignment="Center">
                        <TextBlock Text="← Geri"/>
                    </Button>
                </StackPanel>

                <!-- ADIM 2: şube seçimi (mevcut akış korunur) -->
                <StackPanel Spacing="14" IsVisible="{Binding IsStep2}">
                    <SelectableTextBlock Text="{Binding CompanyName}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                         IsVisible="{Binding !IsSuperAdminMode}" Foreground="#EEF3F9"/>

                    <!-- B2/B3: çevrimdışı giriş bilgilendirmesi. Eskiden çevrimdışıyken şube adımı HİÇ
                         gösterilmiyor, makinenin önbellekteki şubesine sessizce giriliyordu. -->
                    <Border IsVisible="{Binding HasOfflineNotice}" Background="#3A2E16" CornerRadius="8" Padding="12,9">
                        <SelectableTextBlock Text="{Binding OfflineNotice}" TextWrapping="Wrap" Foreground="#F0C674"/>
                    </Border>

                    <StackPanel Spacing="10" IsVisible="{Binding IsSuperAdminMode}">
                        <SelectableTextBlock Text="Süper Admin — firma ve şube seçimi" HorizontalAlignment="Center"
                                             FontWeight="SemiBold" Foreground="#EEF3F9"/>
                        <CheckBox Content="{Binding MachineCompanyLabel}" IsChecked="{Binding UseMachineCompany}"
                                  IsVisible="{Binding HasMachineCompany}" Foreground="#B7C2D2"/>
                        <StackPanel Spacing="6" IsVisible="{Binding ShowCompanyPicker}">
                            <TextBlock Classes="Lbl" Text="Firma"/>
                            <ComboBox ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <CheckBox Content="{Binding MachineBranchLabel}" IsChecked="{Binding UseMachineBranch}"
                                  IsVisible="{Binding HasMachineBranch}" Foreground="#B7C2D2"/>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding ShowBranchSelector}">
                        <TextBlock Classes="Lbl" Text="Şube / Şantiye"/>
                        <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" HorizontalAlignment="Stretch"/>
                        <!-- ŞB-GİRİŞ: varsayılan kullanıcının kendi şubesidir; makine şubesi listede
                             🖥 ile işaretlidir ve istenirse seçilebilir. -->
                        <SelectableTextBlock Text="Varsayılan olarak kendi şubeniz seçilidir. 🖥 işaretli şube bu makinenin şubesidir."
                                             TextWrapping="Wrap" FontSize="12" Foreground="#8FA0B4"
                                             IsVisible="{Binding HasMachineBranchInList}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowBranchCode}">
                        <TextBlock Classes="Lbl" Text="Şube Kodu:"/>
                        <SelectableTextBlock Text="{Binding SelectedBranchCode}" FontWeight="SemiBold" Foreground="#EEF3F9"/>
                    </StackPanel>
                    <SelectableTextBlock Text="✓ Bu makinenin şubesi — şube şifresi gerekmez."
                                         IsVisible="{Binding SelectedIsMachineBranch}" Foreground="#5FD08A"/>
                    <StackPanel Spacing="7" IsVisible="{Binding ShowBranchPassword}">
                        <TextBlock Classes="Lbl" Text="Şube Şifresi"/>
                        <Border Classes="Field">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Grid.Column="0" Classes="FieldIcon" Data="M17 9V7a5 5 0 0 0-10 0v2H5v12h14V9h-2Zm-8 0V7a3 3 0 0 1 6 0v2H9Z"/>
                                <TextBox Grid.Column="1" Classes="Bare" Text="{Binding BranchPassword}" PasswordChar="●" Watermark="••••••"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <SelectableTextBlock Text="{Binding Error}" Foreground="#FF9B9B" TextWrapping="Wrap"
                                         IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Button Classes="Primary" Content="GİRİŞ YAP" Command="{Binding LoginCommand}" IsDefault="True"
                            IsEnabled="{Binding !IsBusy}" Margin="0,4,0,0"/>
                    <Button Classes="Link" Content="← Geri" Command="{Binding BackCommand}" IsEnabled="{Binding !IsBusy}"/>
                </StackPanel>

                <SelectableTextBlock Text="Web'de tanımlı kullanıcı bilgilerinizle giriş yapın." HorizontalAlignment="Center"
                                     Opacity="0.5" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                     Foreground="#8FA0B6" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
