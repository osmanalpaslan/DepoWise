<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DepoWise.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="460"
        x:Class="DepoWise.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Width="420" Height="600" CanResize="False"
        Icon="/Assets/app-logo.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brand.Surface.Brush}"
        Title="DepoWise — Giriş">

    <Border Background="{DynamicResource Brand.Surface.Brush}" Padding="32">
        <StackPanel Spacing="16" VerticalAlignment="Center">
            <!-- Masaüstü SEMBOL logosu (şeffaf PNG, arka plan YOK — yalnız logo). Kaynak 838px → net. -->
            <Image Source="/Assets/app-icon.png" Width="170" Height="170"
                   HorizontalAlignment="Center" Stretch="Uniform"/>
            <SelectableTextBlock Text="Depo ve Filo Yönetimi" HorizontalAlignment="Center" Opacity="0.6"
                       Foreground="{DynamicResource Brand.OnSurface.Brush}"/>

            <!-- ADIM 1: kimlik -->
            <StackPanel Spacing="16" IsVisible="{Binding IsStep1}">
                <StackPanel Spacing="4" Margin="0,6,0,0">
                    <SelectableTextBlock Text="Kullanıcı Adı" Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                    <TextBox Text="{Binding Username}" PlaceholderText="admin" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <SelectableTextBlock Text="Parola" Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                    <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="••••••" />
                </StackPanel>
                <CheckBox Content="Beni hatırla" IsChecked="{Binding RememberMe}"
                          Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                <SelectableTextBlock Text="{Binding Error}" Foreground="{DynamicResource Brand.Danger.Brush}"
                           TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Button Content="Devam" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,12" Margin="0,8,0,0"
                        Background="{DynamicResource Brand.Primary.Brush}"
                        Foreground="{DynamicResource Brand.OnPrimary.Brush}"
                        Command="{Binding ContinueCommand}" IsDefault="True"
                        IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>

            <!-- ADIM 2: şube seçimi -->
            <StackPanel Spacing="16" IsVisible="{Binding IsStep2}">
                <SelectableTextBlock Text="{Binding CompanyName}" HorizontalAlignment="Center" FontWeight="SemiBold"
                           IsVisible="{Binding !IsSuperAdminMode}"
                           Foreground="{DynamicResource Brand.OnSurface.Brush}"/>

                <!-- SÜPER ADMIN: makine firması/şubesi ile giriş VEYA firma+şube seç -->
                <StackPanel Spacing="10" IsVisible="{Binding IsSuperAdminMode}">
                    <SelectableTextBlock Text="Süper Admin — firma ve şube seçimi" HorizontalAlignment="Center"
                                         FontWeight="SemiBold" Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                    <CheckBox Content="{Binding MachineCompanyLabel}" IsChecked="{Binding UseMachineCompany}"
                              IsVisible="{Binding HasMachineCompany}"
                              Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                    <StackPanel Spacing="4" IsVisible="{Binding ShowCompanyPicker}">
                        <SelectableTextBlock Text="Firma" Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                        <ComboBox ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <CheckBox Content="{Binding MachineBranchLabel}" IsChecked="{Binding UseMachineBranch}"
                              IsVisible="{Binding HasMachineBranch}"
                              Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding ShowBranchSelector}">
                    <SelectableTextBlock Text="Şube / Şantiye" Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                    <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <!-- L1: seçilen şubenin kodu otomatik gösterilir -->
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowBranchCode}">
                    <SelectableTextBlock Text="Şube Kodu:" Foreground="{DynamicResource Brand.OnSurfaceVariant.Brush}"/>
                    <SelectableTextBlock Text="{Binding SelectedBranchCode}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                </StackPanel>
                <!-- L2: makinenin kendi şubesi seçiliyse şifre istenmeden girilebilir -->
                <SelectableTextBlock Text="✓ Bu makinenin şubesi — şube şifresi gerekmez."
                                     IsVisible="{Binding SelectedIsMachineBranch}"
                                     Foreground="{DynamicResource Brand.Success.Brush}"/>
                <StackPanel Spacing="4" IsVisible="{Binding ShowBranchPassword}">
                    <SelectableTextBlock Text="Şube Şifresi" Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
                    <TextBox Text="{Binding BranchPassword}" PasswordChar="•" PlaceholderText="••••••" />
                </StackPanel>
                <SelectableTextBlock Text="{Binding Error}" Foreground="{DynamicResource Brand.Danger.Brush}"
                           TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Button Content="Giriş Yap" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,12" Margin="0,8,0,0"
                        Background="{DynamicResource Brand.Primary.Brush}"
                        Foreground="{DynamicResource Brand.OnPrimary.Brush}"
                        Command="{Binding LoginCommand}" IsDefault="True"
                        IsEnabled="{Binding !IsBusy}"/>
                <Button Content="← Geri" HorizontalAlignment="Center" Background="Transparent"
                        Foreground="{DynamicResource Brand.OnSurface.Brush}"
                        Command="{Binding BackCommand}" IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>

            <SelectableTextBlock Text="Web'de tanımlı kullanıcı bilgilerinizle giriş yapın." HorizontalAlignment="Center"
                       Opacity="0.5" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource Brand.OnSurface.Brush}"/>
        </StackPanel>
    </Border>
</Window>
