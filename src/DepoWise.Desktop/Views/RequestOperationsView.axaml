<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:req="using:DepoWise.Infrastructure.Requests"
             xmlns:org="using:DepoWise.Infrastructure.Organization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="DepoWise.Desktop.Views.RequestOperationsView"
             x:DataType="vm:RequestOperationsViewModel">

    <!-- TALEP OPERASYONLARI (Faz 2): onaylanmış taleplerin operasyon süreci. Sol = liste, sağ = işlem paneli.
         Durum listesi YALNIZ izin verilen geçişleri gösterir (matris + yetki servistedir). -->
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <ctrl:Toolbar Grid.Row="0" Title="Talep Operasyonları">
            <ctrl:Toolbar.FilterContent>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <SelectableTextBlock Text="Operasyon durumu:" Classes="Caption" VerticalAlignment="Center"/>
                    <ComboBox Classes="Field" Width="220" ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}"/>
                    <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
                </StackPanel>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,0,0">

            <!-- Liste -->
            <Panel Grid.Column="0">
                <Border Classes="Table" IsVisible="{Binding HasRows}">
                    <DockPanel>
                        <Border Classes="TableHeader" DockPanel.Dock="Top">
                            <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="150,90,*,110,150,140">
                                <SelectableTextBlock Grid.Column="0" Text="BELGE NO"/>
                                <SelectableTextBlock Grid.Column="1" Text="TARİH"/>
                                <SelectableTextBlock Grid.Column="2" Text="TALEP EDEN / ŞUBE"/>
                                <SelectableTextBlock Grid.Column="3" Text="ÖNCELİK"/>
                                <SelectableTextBlock Grid.Column="4" Text="OPERASYON DURUMU"/>
                                <SelectableTextBlock Grid.Column="5" Text="GÖNDERİM"/>
                            </Grid>
                        </Border>
                        <ScrollViewer>
                            <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="req:RequestOperationRow">
                                        <Grid ctrl:ColumnRules.Enabled="True" ColumnDefinitions="150,90,*,110,150,140">
                                            <SelectableTextBlock Grid.Column="0" Text="{Binding DocNo}" VerticalAlignment="Center"/>
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding DateText}" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <SelectableTextBlock Grid.Column="2" Text="{Binding RequesterName}" VerticalAlignment="Center"
                                                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DescriptionDisplay}"/>
                                            <ctrl:StatusBadge Grid.Column="3" VerticalAlignment="Center"
                                                              Kind="{Binding PriorityColor, Converter={x:Static vm:OpsColorConverter.Instance}}"
                                                              Text="{Binding PriorityText}"/>
                                            <ctrl:StatusBadge Grid.Column="4" VerticalAlignment="Center"
                                                              Kind="{Binding OperationStatusColor, Converter={x:Static vm:OpsColorConverter.Instance}}"
                                                              Text="{Binding OperationStatusText}"/>
                                            <SelectableTextBlock Grid.Column="5" Text="{Binding ToBranchDisplay}" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                                 TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <ctrl:StatePanel Mode="Empty" Title="Operasyon kaydı yok"
                                 Message="Bu filtrede onaylanmış talep bulunmuyor. Operasyon süreci, talep ONAYLANDIĞINDA başlar."
                                 IsVisible="{Binding IsEmpty}"/>
                <ctrl:StatePanel Mode="Error" Title="Liste yüklenemedi" Message="{Binding LoadError}"
                                 IsVisible="{Binding HasError}"/>
            </Panel>

            <!-- İşlem paneli -->
            <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" Width="380" IsVisible="{Binding HasSelection}">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="{Binding Selected.DocNo}" Classes="PageTitle" VerticalAlignment="Center"/>
                            <ctrl:StatusBadge Grid.Column="1" Text="{Binding Selected.OperationStatusText}"
                                              Kind="{Binding Selected.OperationStatusColor, Converter={x:Static vm:OpsColorConverter.Instance}}"/>
                        </Grid>

                        <SelectableTextBlock Text="KALEMLER" Classes="SectionTitle"/>
                        <ItemsControl ItemsSource="{Binding DetailItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="req:RequestItemRow">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <SelectableTextBlock Grid.Column="0" Text="{Binding MaterialName}" Classes="Body"
                                                             TextTrimming="CharacterEllipsis"/>
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Quantity}" Classes="Body" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Gönderim bilgileri (şartname §6) -->
                        <SelectableTextBlock Text="GÖNDERİM BİLGİLERİ" Classes="SectionTitle"/>
                        <ctrl:FormField Label="Gönderen Şube / Şantiye">
                            <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}"
                                            SelectedItem="{Binding FromBranch}" PlaceholderText="Şube seç / ara..."/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Gönderilecek Şube / Şantiye">
                            <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}"
                                            SelectedItem="{Binding ToBranch}" PlaceholderText="Şube seç / ara..."/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Operasyon Notu">
                            <TextBox Classes="Field" Text="{Binding OpsNote}" AcceptsReturn="True" MaxHeight="80"/>
                        </ctrl:FormField>
                        <Button Classes="Secondary" HorizontalAlignment="Stretch" Content="Gönderim Bilgilerini Kaydet"
                                Command="{Binding SaveShipmentCommand}" IsVisible="{Binding CanEdit}"/>

                        <!-- Durum değiştirme: YALNIZ izin verilen geçişler listelenir -->
                        <SelectableTextBlock Text="DURUM DEĞİŞTİR" Classes="SectionTitle"/>
                        <ctrl:FormField Label="Yeni Durum" HelpText="Yalnız bu durumdan geçilebilecek adımlar listelenir (yetkinize göre).">
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding NextStates}"
                                      SelectedItem="{Binding NewStatus}"/>
                        </ctrl:FormField>
                        <Button Classes="Primary" HorizontalAlignment="Stretch" Content="Durumu Güncelle"
                                Command="{Binding ApplyStatusCommand}" IsEnabled="{Binding CanChangeStatus}"/>

                        <!-- İşlem geçmişi (şartname §13) -->
                        <SelectableTextBlock Text="İŞLEM GEÇMİŞİ" Classes="SectionTitle"/>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <SelectableTextBlock Text="{Binding}" Classes="Helper" TextWrapping="Wrap" Margin="0,2"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <SelectableTextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,10,0,0"
                             Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
