<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:inf="using:DepoWise.Infrastructure.Requests"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:veh="using:DepoWise.Infrastructure.Vehicles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="660"
             x:Class="DepoWise.Desktop.Views.RequestsView"
             x:DataType="vm:RequestsViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="*,Auto">
        <TabControl Grid.Row="0" Classes="NoHeader" SelectedIndex="{Binding SelectedTab}">

            <!-- ═══════════ TALEP FORMU ═══════════ -->
            <TabItem Header="Talep Formu">
                <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,12,0,0">
                    <ctrl:Toolbar Grid.Row="0" Title="Talep Formu"
                                  PrimaryActionText="Yeni Talep" PrimaryActionCommand="{Binding NewRequestCommand}"
                                  SearchText="{Binding Search, Mode=TwoWay}" SearchWatermark="Belge no / açıklama ara...">
                        <ctrl:Toolbar.FilterContent>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox Classes="Field" Width="160" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"/>
                                <Button Classes="Secondary" Content="🏢 Firma Logosu Ekle" Command="{Binding PickLogoCommand}"
                                        ToolTip.Tip="PDF başlığındaki firma logosu. Değiştirmedikçe seçili kalır."/>
                            </StackPanel>
                        </ctrl:Toolbar.FilterContent>
                    </ctrl:Toolbar>

                    <!-- Yeni talep formu -->
                    <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowForm}">
                        <ScrollViewer MaxHeight="440">
                        <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
                            <SelectableTextBlock Text="{Binding FormTitle}" Classes="SectionTitle"/>
                            <SelectableTextBlock Text="Belge no otomatik (TLP-YYYY-NNNN). Kaydedince talep yöneticiye iletilir; sonra düzenlenemez."
                                       Classes="Helper" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <ctrl:FormField Label="Şube / Şantiye" IsRequired="True" Width="280">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Sites}" SelectedItem="{Binding FormSite}">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Tarih" Width="180">
                                    <DatePicker Classes="Field" SelectedDate="{Binding FormDate}"/>
                                </ctrl:FormField>
                                <!-- B-2 (PRT-01 Grup 4): öncelik listede zaten gösteriliyordu ama hiçbir ekrandan
                                     SEÇİLEMİYORDU. Etiketler ortak RequestPriorityInfo'dan gelir → web ile aynı. -->
                                <ctrl:FormField Label="Öncelik" Width="160">
                                    <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding FormPriority}"/>
                                </ctrl:FormField>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <ctrl:FormField Label="Talep Eden" Width="240">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Personnel}" SelectedItem="{Binding FormRequester}"
                                              PlaceholderText="Personel seç / ara..."/>
                                        <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddRequesterCommand}"/>
                                    </Grid>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Depo Sorumlusu" Width="240">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Personnel}" SelectedItem="{Binding FormWarehouse}"
                                              PlaceholderText="Personel seç / ara..."/>
                                        <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddWarehouseCommand}"/>
                                    </Grid>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Onay Veren" Width="240">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Personnel}" SelectedItem="{Binding FormApprover}"
                                              PlaceholderText="Personel seç / ara..."/>
                                        <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddApproverCommand}"/>
                                    </Grid>
                                </ctrl:FormField>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingPersonnel}">
                                <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewPersonnelName}" PlaceholderText="Yeni personel adı"/>
                                <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddPersonnelCommand}"/>
                                <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddPersonnelCommand}"/>
                            </Grid>

                            <ctrl:FormField Label="Açıklama">
                                <TextBox Classes="Field" Text="{Binding FormDescription}" AcceptsReturn="True" Height="48"/>
                            </ctrl:FormField>

                            <!-- Kalemler -->
                            <SelectableTextBlock Text="TALEP KALEMLERİ" Classes="SectionTitle"/>
                            <Border Classes="Panel" Background="{DynamicResource SurfaceAltBrush}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <ctrl:FormField Label="Malzeme" Width="280">
                                            <TextBox Classes="Search" Text="{Binding MaterialSearch}" PlaceholderText="Malzeme ara (kod/ad)"/>
                                        </ctrl:FormField>
                                        <ctrl:FormField Label="Miktar" Width="110">
                                            <NumericUpDown Classes="Field" Value="{Binding NewItemQty}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                                        </ctrl:FormField>
                                        <ctrl:FormField Label="Araç (opsiyonel)" Width="220">
                                            <ctrl:LookupBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding NewItemVehicle}"
                                                             DisplayMember="Display" PlaceholderText="İç kod / plaka seç / ara..."/>
                                        </ctrl:FormField>
                                        <Button Classes="Primary" Content="Ekle" VerticalAlignment="Bottom" Command="{Binding AddItemCommand}"/>
                                    </StackPanel>

                                    <Border Classes="Table" MaxHeight="110" IsVisible="{Binding MaterialResults.Count}">
                                        <ScrollViewer>
                                            <ItemsControl ItemsSource="{Binding MaterialResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="m:MaterialRefRow">
                                                        <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                Content="{Binding Name}"
                                                                Command="{Binding $parent[ItemsControl].((vm:RequestsViewModel)DataContext).PickMaterialCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <SelectableTextBlock Text="{Binding ItemError}" Classes="Helper" Foreground="{DynamicResource DangerBrush}"
                                               IsVisible="{Binding ItemError, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                    <ItemsControl ItemsSource="{Binding FormItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ReqItemLine">
                                                <Grid ColumnDefinitions="*,150,120,Auto" Margin="0,2">
                                                    <SelectableTextBlock Grid.Column="0" Text="{Binding DisplayName}" Classes="Body" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <SelectableTextBlock Grid.Column="1" Text="{Binding VehicleText}" Classes="Helper" VerticalAlignment="Center"/>
                                                    <NumericUpDown Grid.Column="2" Classes="Field" Value="{Binding Quantity}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                                                    <Button Grid.Column="3" Classes="Ghost" Content="Kaldır" Margin="6,0,0,0"
                                                            Command="{Binding $parent[ItemsControl].((vm:RequestsViewModel)DataContext).RemoveItemCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <SelectableTextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                                       IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <Button Classes="Secondary" Content="İptal" Command="{Binding CancelFormCommand}"/>
                                <Button Classes="Primary" Content="Talebi Oluştur" Command="{Binding SaveRequestCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Liste + Detay -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,380" Margin="0,16,0,0">
                        <Panel Grid.Column="0">
                            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                                <DockPanel>
                                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                            <SelectableTextBlock Grid.Column="0" Text="BELGE NO" MinWidth="130"/>
                                            <SelectableTextBlock Grid.Column="1" Text="TARİH" MinWidth="90"/>
                                            <SelectableTextBlock Grid.Column="2" Text="KALEM" MinWidth="60"/>
                                            <SelectableTextBlock Grid.Column="3" Text="AÇIKLAMA" MinWidth="120"/>
                                            <SelectableTextBlock Grid.Column="4" Text="DURUM" MinWidth="110"/>
                                        </Grid>
                                    </Border>
                                    <!-- Tek tik = secim. Cift tik = duzenleme formu (Malzemeler/Araclar ile AYNI davranis). -->
                                    <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                                             DoubleTapped="OnRowDoubleTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RequestRow">
                                                <!-- Kolon 4: ONAY durumu · Kolon 5: OPERASYON durumu (Faz 1, madde 15-16).
                                                     İkisi AYRI rozettir; operasyon yoksa "—" görünür. -->
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                                                    <SelectableTextBlock Grid.Column="0" Text="{Binding DocNo}" MinWidth="130" VerticalAlignment="Center"/>
                                                    <SelectableTextBlock Grid.Column="1" Text="{Binding DateText}" MinWidth="90" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <SelectableTextBlock Grid.Column="2" Text="{Binding ItemCount}" MinWidth="60" VerticalAlignment="Center"/>
                                                    <SelectableTextBlock Grid.Column="3" Text="{Binding DescriptionDisplay}" MinWidth="120" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <ctrl:StatusBadge Grid.Column="4" MinWidth="90" VerticalAlignment="Center" Kind="{Binding PriorityKind}" Text="{Binding PriorityText}"
                                                                      ToolTip.Tip="Öncelik"/>
                                                    <ctrl:StatusBadge Grid.Column="5" MinWidth="110" VerticalAlignment="Center" Kind="{Binding StatusKind}" Text="{Binding StatusText}"
                                                                      ToolTip.Tip="Onay durumu"/>
                                                    <ctrl:StatusBadge Grid.Column="6" MinWidth="150" VerticalAlignment="Center" Kind="{Binding OperationStatusKind}" Text="{Binding OperationStatusText}"
                                                                      ToolTip.Tip="Operasyon durumu (talep onaylandıktan sonra başlar)"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
                            <ctrl:StatePanel Mode="Empty" Title="Talep yok" Message="Seçili filtreye uygun talep bulunamadı." IsVisible="{Binding IsEmpty}"/>
                        </Panel>

                        <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding HasSelection}">
                            <ContentControl Content="{Binding}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:RequestsViewModel">
                                        <ScrollViewer>
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Selected.DocNo}" Classes="PageTitle" VerticalAlignment="Center"/>
                                                    <ctrl:StatusBadge Grid.Column="1" Margin="0,0,6,0" Kind="{Binding Selected.PriorityKind}" Text="{Binding Selected.PriorityText}"
                                                                      ToolTip.Tip="Öncelik"/>
                                                    <ctrl:StatusBadge Grid.Column="2" Margin="0,0,6,0" Kind="{Binding Selected.StatusKind}" Text="{Binding Selected.StatusText}"
                                                                      ToolTip.Tip="Onay durumu"/>
                                                    <ctrl:StatusBadge Grid.Column="3" Kind="{Binding Selected.OperationStatusKind}" Text="{Binding Selected.OperationStatusText}"
                                                                      ToolTip.Tip="Operasyon durumu (talep onaylandıktan sonra başlar)"/>
                                                </Grid>
                                                <SelectableTextBlock Text="KALEMLER" Classes="SectionTitle"/>
                                                <ItemsControl ItemsSource="{Binding DetailItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="inf:RequestItemRow">
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                                <StackPanel Grid.Column="0">
                                                                    <SelectableTextBlock Text="{Binding MaterialName}" Classes="Body" TextTrimming="CharacterEllipsis"/>
                                                                    <SelectableTextBlock Text="{Binding MaterialCode}" Classes="Helper"/>
                                                                </StackPanel>
                                                                <SelectableTextBlock Grid.Column="1" Text="{Binding Quantity}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Classes="Divider"/>
                                                <SelectableTextBlock Text="DURUM GEÇMİŞİ" Classes="SectionTitle"/>
                                                <ItemsControl ItemsSource="{Binding History}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String"><SelectableTextBlock Text="{Binding}" Classes="Helper" Margin="0,2"/></DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <WrapPanel>
                                                    <Button Classes="Primary" Content="Düzenle" Margin="0,0,8,8" Command="{Binding BeginEditRequestCommand}" IsVisible="{Binding CanEditSelected}"/>
                                                    <Button Classes="Secondary" Content="PDF" Margin="0,0,8,8" Command="{Binding ExportPdfCommand}"/>
                                                    <Button Classes="Secondary" Content="Ekonomik PDF" Margin="0,0,8,8" Command="{Binding ExportEconomicPdfCommand}"/>
                                                    <Button Classes="Secondary" Content="İptal Et" Margin="0,0,8,8" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Border>
                        <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding !HasSelection}">
                            <SelectableTextBlock Text="Detay için bir talep seçin." Classes="Helper" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════ TALEP ONAYLAMA ═══════════ -->
            <TabItem Header="Talep Onaylama">
                <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                    <ctrl:Toolbar Grid.Row="0" Title="Talep Onaylama (Bekleyen)">
                        <ctrl:Toolbar.FilterContent>
                            <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
                        </ctrl:Toolbar.FilterContent>
                    </ctrl:Toolbar>

                    <Grid Grid.Row="1" ColumnDefinitions="*,380" Margin="0,16,0,0">
                        <Panel Grid.Column="0">
                            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasPending}">
                                <DockPanel>
                                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                            <SelectableTextBlock Grid.Column="0" Text="BELGE NO" MinWidth="130"/>
                                            <SelectableTextBlock Grid.Column="1" Text="TARİH" MinWidth="90"/>
                                            <SelectableTextBlock Grid.Column="2" Text="KALEM" MinWidth="60"/>
                                            <SelectableTextBlock Grid.Column="3" Text="AÇIKLAMA" MinWidth="120"/>
                                        </Grid>
                                    </Border>
                                    <ListBox Classes="Table" ItemsSource="{Binding PendingItems}" SelectedItem="{Binding Selected}"
                                             DoubleTapped="OnRowDoubleTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RequestRow">
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                                    <SelectableTextBlock Grid.Column="0" Text="{Binding DocNo}" MinWidth="130" VerticalAlignment="Center"/>
                                                    <SelectableTextBlock Grid.Column="1" Text="{Binding DateText}" MinWidth="90" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <SelectableTextBlock Grid.Column="2" Text="{Binding ItemCount}" MinWidth="60" VerticalAlignment="Center"/>
                                                    <SelectableTextBlock Grid.Column="3" Text="{Binding DescriptionDisplay}" MinWidth="120" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <ctrl:StatePanel Mode="Empty" Title="Bekleyen talep yok" Message="Onay bekleyen talep bulunmuyor." IsVisible="{Binding PendingEmpty}"/>
                        </Panel>

                        <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding HasSelection}">
                            <ScrollViewer>
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <SelectableTextBlock Grid.Column="0" Text="{Binding Selected.DocNo}" Classes="PageTitle" VerticalAlignment="Center"/>
                                        <ctrl:StatusBadge Grid.Column="1" Kind="{Binding Selected.StatusKind}" Text="{Binding Selected.StatusText}"/>
                                    </Grid>
                                    <SelectableTextBlock Text="KALEMLER" Classes="SectionTitle"/>
                                    <ItemsControl ItemsSource="{Binding DetailItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="inf:RequestItemRow">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                    <StackPanel Grid.Column="0">
                                                        <SelectableTextBlock Text="{Binding MaterialName}" Classes="Body" TextTrimming="CharacterEllipsis"/>
                                                        <SelectableTextBlock Text="{Binding MaterialCode}" Classes="Helper"/>
                                                    </StackPanel>
                                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Quantity}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="Divider"/>
                                    <ctrl:FormField Label="Ret Gerekçesi" HelpText="Reddetmek için zorunlu.">
                                        <TextBox Classes="Field" Text="{Binding RejectReason}"/>
                                    </ctrl:FormField>
                                    <WrapPanel>
                                        <Button Classes="Primary" Content="Onayla" Margin="0,0,8,8" Command="{Binding ApproveCommand}" IsVisible="{Binding CanApprove}"/>
                                        <Button Classes="Danger" Content="Reddet" Margin="0,0,8,8" Command="{Binding RejectCommand}" IsVisible="{Binding CanReject}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding !HasSelection}">
                            <SelectableTextBlock Text="Onaylamak için bir talep seçin." Classes="Helper" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <SelectableTextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
