<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:local="using:DepoWise.Desktop"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:mnt="using:DepoWise.Infrastructure.Maintenance"
             xmlns:inf="using:DepoWise.Infrastructure.Vehicles"
             xmlns:wo="using:DepoWise.Infrastructure.WorkOrders"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
             x:Class="DepoWise.Desktop.Views.VehiclesView"
             x:DataType="vm:VehiclesViewModel">

    <!-- Sayfalama araç ekranında tablonun ALTINDA (sol en altta) — kullanıcı isteği 2026-07-19. Bu yüzden
         tablo Row 2 (*), sayfalama Row 3 (Auto, en alt). -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <!-- ===== Toolbar: başlık + kolon ayarla + sayfa boyutu + Yeni Araç ===== -->
        <ctrl:Toolbar Grid.Row="0" Title="{Binding PageTitle}"
                      PrimaryActionText="{Binding AddButtonText}"
                      PrimaryActionCommand="{Binding ToggleAddCommand}">
            <ctrl:Toolbar.FilterContent>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center" IsVisible="{Binding !ShowAdd}">
                    <!-- ⭐ M-64 (Şablon B): tek ana düğme araç çubuğunda ("Yeni Araç"); sayfa boyutu alttaki ortak Pager'da -->
                    <!-- ⭐ iOS madde 4: hazır durum hapları ("Durum" sütun filtresine yazar) -->
                    <ListBox Classes="HapSecici" ItemsSource="{Binding DurumHaplari}" SelectedItem="{Binding SeciliDurumHapi}"
                             AutomationProperties.Name="Durum" ToolTip.Tip="Durum — tek tıkla listeyi süzer"/>
                    <Button Classes="Secondary" Content="Filtrele" Command="{Binding ApplyFiltersCommand}"/>
                    <Button Classes="Secondary" Content="Temizle" Command="{Binding ClearFiltersCommand}"/>
                    <!-- ⭐ 2026-09-06 (kullanıcı isteği): YAZDIR. Excel ile aynı veriyi PDF üretir;
                         başlıkta firma/şube/kullanıcı/tarih, altta sayısal kolonların toplamı olur. -->
                    <!-- ⭐ iOS tasarım (2026-10-28, kullanıcı onayı): seyrek kullanılan toplu işlem "…" menüsünde; seçili araca ait
                         QR Etiketi / Arıza Bildir / İş Emri Aç düğmeleri sağdaki ARAÇ KARTINA taşındı. -->
                    <Button Classes="Secondary" Content="•••" Padding="12,8" IsVisible="{Binding CanWrite}"
                            AutomationProperties.Name="Diğer işlemler" ToolTip.Tip="Diğer işlemler">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Excel'e Aktar" Command="{Binding ExportExcelCommand}" IsEnabled="{Binding !IsExporting}" ToolTip.Tip="Aktif filtrelerle eşleşen TÜM araçları (yalnız bu sayfayı değil) Excel dosyası olarak indirir"/>
                                <MenuItem Header="Yazdır" Command="{Binding YazdirCommand}" IsEnabled="{Binding !IsExporting}" ToolTip.Tip="Ekrandaki filtrelenmiş listeyi PDF olarak kaydeder (imzalı çıktı için)."/>
                                <Separator/>
                                <!-- ⭐ FAZ 4.1: geçmişte hatalı-yüksek sayaç yazılmış araçların toplu onarımı. -->
                                <MenuItem Header="Sayaçları Onar" Command="{Binding RecalcMetersCommand}"
                                          ToolTip.Tip="Araç sayaçlarını geçerli yakıt/bakım kayıtlarından yeniden hesaplar. Yanlış girilip sonradan düzeltilen sayaçlar bu işlemle toparlanır; hiçbir kayıt silinmez."/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </WrapPanel>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- ⭐ M-38: ARIZA DURUŞ SÜRESİ RAPORU (kiralık ekranı dışında; M-39 paneliyle aynı satırı paylaşır, ikisi aynı anda görünmez) -->
        <Expander Classes="IosAcilir" Grid.Row="1" Margin="0,12,0,0" Header="Arıza duruş süresi raporu" IsVisible="{Binding !IsRentalMode}">
            <StackPanel Spacing="6">
                <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8">
                    <ctrl:TarihKutusu SelectedDate="{Binding DurusBas}" Width="140" ToolTip.Tip="Dönem başlangıcı"/>
                    <ctrl:TarihKutusu SelectedDate="{Binding DurusBit}" Width="140" ToolTip.Tip="Dönem bitişi (dahil)"/>
                    <Button Classes="Secondary" Content="Hesapla" Command="{Binding DurusYukleCommand}"
                            ToolTip.Tip="Arıza iş emirlerinden: bildirimden tamamlanmaya kadar geçen süre. Açık arıza bugüne kadar sayılır; döneme taşan kısım kesilir. İptal edilen iş emri sayılmaz."/>
                    <SelectableTextBlock Text="{Binding DurusToplam}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding DurusRaporu}" MaxHeight="200">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="wo:DurusSatiri">
                            <SelectableTextBlock Text="{Binding Satir}" Classes="Helper" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>

        <!-- ⭐ M-39: KİRA BİTİŞ UYARILARI + DÖNEM MALİYET/GELİR (yalnız kiralık araçlar ekranında) -->
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,0" IsVisible="{Binding IsRentalMode}">
            <ItemsControl ItemsSource="{Binding KiraUyarilari}" IsVisible="{Binding HasKiraUyarisi}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="inf:KiraBitisUyarisi">
                        <SelectableTextBlock Text="{Binding Metin}" Classes="Helper" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Classes="IosAcilir" Header="Kira dönem maliyeti / geliri">
                <StackPanel Spacing="6">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8">
                        <ctrl:TarihKutusu SelectedDate="{Binding KiraBas}" Width="140" ToolTip.Tip="Dönem başlangıcı"/>
                        <ctrl:TarihKutusu SelectedDate="{Binding KiraBit}" Width="140" ToolTip.Tip="Dönem bitişi (dahil)"/>
                        <Button Classes="Secondary" Content="Hesapla" Command="{Binding KiraRaporuHesaplaCommand}"
                                ToolTip.Tip="Gün: dönemdeki gün sayısı · Ay: gün/30 · Saat: dönemdeki sayaç farkı × kira bedeli. Cari borç/alacak otomatik yazılmaz (faturayla girilir)."/>
                        <SelectableTextBlock Text="{Binding KiraToplam}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding KiraRaporu}" MaxHeight="200">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="inf:KiraDonemSatiri">
                                <SelectableTextBlock Text="{Binding Ozet}" Classes="Helper" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- Yeni Araç formu -->
        <!-- 2026-10-12: form, liste GİZLİYKEN listenin esneyen (*) satırını kullanır — ekranda boş alan kalırken
             500 px'lik kutuya sıkışıp kaydırılmasın (kullanıcı bulgusu). Sığmazsa kendi içinde kayar. -->
        <Border Grid.Row="2" Classes="Panel" Margin="0,16,0,0" VerticalAlignment="Top" IsVisible="{Binding ShowAdd}"
                Background="{DynamicResource AppBackgroundBrush}" BorderThickness="0" Padding="0,4,0,0">
            <Border.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}"/>
                <KeyBinding Gesture="Escape" Command="{Binding ClearCommand}"/>
            </Border.KeyBindings>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- ⭐ iOS tasarım (2026-10-28, kullanıcı onayı): solda gruplu form, sağda önizleme + zorunlu alan kontrol listesi -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" HorizontalAlignment="Left">
            <StackPanel Grid.Column="0" Spacing="14" MaxWidth="720">
                <SelectableTextBlock Text="{Binding FormTitle}" Classes="IosBaslik"/>

                <SelectableTextBlock Text="Şablon" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">

                <!-- Yeni kayıt: seçince alanlar dolar. Düzenleme: şablona BAĞLA/DEĞİŞTİR (alanları ezmez) —
                     "şablon-dışı" bir aracı sonradan şablona bağlayıp raporda "şablonlu"ya taşımak için. -->
                <ctrl:FormField Label="Şablon (Araç Genel Tanım)"
                                HelpText="Yeni kayıtta alanları önden doldurur; düzenlemede bu aracı şablona bağlar (alanları değiştirmez).">
                    <ctrl:LookupBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                              PlaceholderText="Şablon seç / ara..."/>
                </ctrl:FormField>

                </StackPanel></Border>

                <SelectableTextBlock Text="Tanım" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                    <ctrl:FormField Label="İç Kod" IsRequired="True" Width="180"
                                    HasError="{Binding HasCodeError}" ErrorText="{Binding CodeError}"
                                    HelpText="Benzersiz araç kodu.">
                        <TextBox Classes="Field" Text="{Binding NewCode}" TabIndex="0" IsEnabled="{Binding !IsEditMode}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Plaka" Width="180">
                        <TextBox Classes="Field" Text="{Binding NewPlate}" TabIndex="1"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Üretim Yılı" Width="140">
                        <NumericUpDown Classes="Field" Value="{Binding NewYear}" Minimum="0" Maximum="2100"
                                       FormatString="0" ShowButtonSpinner="False" TabIndex="2"/>
                    </ctrl:FormField>
                </WrapPanel>

                </StackPanel></Border>

                <!-- ⭐ 2026-10-10 KİRA BİLGİSİ (yalnız Kiralık Araçlar ekranında) -->
                <StackPanel Spacing="12" IsVisible="{Binding IsRentalMode}">
                <SelectableTextBlock Text="Kira Bilgisi" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                        <ctrl:FormField Label="Kiralayan Firma" IsRequired="True" Width="260"
                                        HelpText="Aracı kiraladığınız firma.">
                            <TextBox Classes="Field" Text="{Binding RentCompany}" MaxLength="200"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Kira Başlangıç" IsRequired="True" Width="150">
                            <ctrl:TarihKutusu SelectedDate="{Binding RentStart}"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Kira Bitiş" Width="150" HelpText="Belli değilse boş bırakın.">
                            <ctrl:TarihKutusu SelectedDate="{Binding RentEnd}"/>
                        </ctrl:FormField>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                        <ctrl:FormField Label="Kira Bedeli (TL)" Width="160" HelpText="İsteğe bağlı.">
                            <NumericUpDown Classes="Field" Value="{Binding RentPrice}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Bedel Birimi" Width="120">
                            <ComboBox Classes="Field" ItemsSource="{Binding RentPriceUnits}" SelectedItem="{Binding RentPriceUnitPick}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StatusPick"><SelectableTextBlock Text="{Binding Label}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ctrl:FormField>
                    </WrapPanel>
                    <!-- ARAÇ DEĞİŞİMİ: arızalanan kiralık aracın yerine gelen araç. Yalnız YENİ kayıtta;
                         kaydedince giden araç otomatik PASİFE alınır, kira bitişi bu aracın başlangıcı olur. -->
                    <CheckBox Content="Bu araç, arızalanıp iade edilen bir kiralık aracın YERİNE geldi (değişim kaydı)"
                              IsChecked="{Binding IsReplacement}" IsVisible="{Binding !IsEditMode}"/>
                    <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding ShowReplacementFields}">
                        <ctrl:FormField Label="Yerine Gelinen (İade Edilen) Araç" IsRequired="True" Width="300"
                                        HelpText="Kaydedince bu araç otomatik pasife alınır.">
                            <ctrl:LookupBox ItemsSource="{Binding ActiveRentals}" SelectedItem="{Binding ReplacedPick}"
                                            DisplayMember="Display" PlaceholderText="Aktif kiralık araç seç / ara..."/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Değişim Nedeni" Width="300">
                            <TextBox Classes="Field" Text="{Binding ReplacementReason}" PlaceholderText="Ör. motor arızası" MaxLength="500"/>
                        </ctrl:FormField>
                    </StackPanel>
                    <ctrl:FormField HorizontalAlignment="Left" Label="Değişim Nedeni" Width="300" IsVisible="{Binding IsEditMode}"
                                    HelpText="Bu araç bir değişim kaydıyla geldiyse nedeni düzeltilebilir.">
                        <TextBox Classes="Field" Text="{Binding ReplacementReason}" MaxLength="500"/>
                    </ctrl:FormField>
                </StackPanel></Border>
                </StackPanel>

                <SelectableTextBlock Text="Durum ve Sayaç" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                    <ctrl:FormField Label="Durum" Width="160">
                        <ComboBox Classes="Field" ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding NewStatusPick}" TabIndex="3" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatusPick"><SelectableTextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Sayaç" Width="160">
                        <NumericUpDown Classes="Field" Value="{Binding NewMeter}" Minimum="0"
                                       FormatString="0.##" ShowButtonSpinner="False" TabIndex="4"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Birim" Width="120">
                        <!-- 2026-09-03: kutuda Türkçe etiket ("saat"), kayda DB kodu ("hour") gider. -->
                        <ComboBox Classes="Field" ItemsSource="{Binding MeterUnits}"
                                  SelectedItem="{Binding NewMeterUnitPick}" TabIndex="5" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatusPick"><SelectableTextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ctrl:FormField>
                </WrapPanel>

                <!-- Durum açıklaması (yalnız Bakımda / Arızalı) -->
                <ctrl:FormField Label="Durum Açıklaması" IsVisible="{Binding IsNewMaintenance}"
                                HelpText="Yalnız 'Bakımda' / 'Arızalı' durumunda saklanır.">
                    <TextBox Classes="Field" Text="{Binding NewStatusNote}" AcceptsReturn="True" Height="56"/>
                </ctrl:FormField>

                </StackPanel></Border>

                <!-- Sınıflandırma (Tanımlar'dan; + ile yeni) -->
                <SelectableTextBlock Text="Sınıflandırma" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                <ctrl:FormField Label="Makine Tipi">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding VehicleTypes}" SelectedItem="{Binding SelVehicleType}"
                                      PlaceholderText="Makine tipi seç / ara..."/>
                            <Button AutomationProperties.Name="Yeni makine tipi ekle" Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding [vehicle_types]}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddTypeCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingType}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewTypeName}" PlaceholderText="Yeni makine tipi"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddTypeCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddTypeCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Kategori">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding VehicleCategories}" SelectedItem="{Binding SelCategory}"
                                      PlaceholderText="Kategori seç / ara..."/>
                            <Button AutomationProperties.Name="Yeni kategori ekle" Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding [vehicle_categories]}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddCatCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingCat}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewCatName}" PlaceholderText="Yeni kategori"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddCatCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddCatCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Marka">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding VehicleBrands}" SelectedItem="{Binding SelBrand}"
                                      PlaceholderText="Marka seç / ara..."/>
                            <Button AutomationProperties.Name="Yeni marka ekle" Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding [vehicle_brands]}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddBrandCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingBrand}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewBrandName}" PlaceholderText="Yeni marka"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddBrandCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddBrandCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Model">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding VehicleModels}" SelectedItem="{Binding SelModel}"
                                      PlaceholderText="Model seç / ara..."/>
                            <Button AutomationProperties.Name="Yeni model ekle" Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding [vehicle_models]}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddModelCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingModel}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewModelName}" PlaceholderText="Yeni model (önce marka seç)"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddModelCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddModelCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                </StackPanel></Border>

                <!-- Konum & Atama -->
                <SelectableTextBlock Text="Konum ve Atama" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                <ctrl:FormField Label="Şantiye / Şube" IsRequired="True">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Branches}" SelectedItem="{Binding SelBranch}"
                                      PlaceholderText="Şantiye / şube seç / ara..."/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Sürücü">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelDriver}"
                                      PlaceholderText="Sürücü seç / ara..."/>
                            <Button AutomationProperties.Name="Yeni sürücü ekle" Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0" Command="{Binding StartAddDriverCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingDriver}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewDriverName}" PlaceholderText="Yeni sürücü (personel)"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddDriverCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddDriverCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                </StackPanel></Border>

                <!-- Teknik -->
                <!-- iOS tasarım: isteğe bağlı teknik bilgiler açılır bölümde (yeni kayıtta kapalı, düzenlemede açık) -->
                <Expander Classes="IosAcilir" Header="Teknik (şasi no, motor no)" IsExpanded="{Binding IsEditMode, Mode=OneWay}">
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                    <ctrl:FormField Label="Şasi No" Width="240">
                        <TextBox Classes="Field" Text="{Binding NewChassisNo}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Motor No" Width="240">
                        <TextBox Classes="Field" Text="{Binding NewEngineNo}"/>
                    </ctrl:FormField>
                </WrapPanel>

                </StackPanel></Border>
                </Expander>

                <!-- Fotoğraflar -->
                <SelectableTextBlock Text="Fotoğraflar" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                <StackPanel Spacing="8">
                    <!-- ADR-182 (PK-F3): KAYITLI fotoğraflar yalnız burada (düzenleme formunda) ve SİLME
                         yetkisiyle silinebilir. Yeni kayıtta bu blok görünmez. -->
                    <SelectableTextBlock Text="Kayıtlı fotoğraflar" Classes="Hint" IsVisible="{Binding IsEditMode}"/>
                    <ItemsControl ItemsSource="{Binding DetailPhotos}" IsVisible="{Binding IsEditMode}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetailPhoto">
                                <Panel Margin="0,0,8,8" Width="84" Height="84">
                                    <Button AutomationProperties.Name="Büyüt" Classes="Ghost" Padding="0" Background="Transparent" Cursor="Hand" ToolTip.Tip="Büyüt"
                                            Command="{Binding $parent[UserControl].((vm:VehiclesViewModel)DataContext).OpenPhotoCommand}"
                                            CommandParameter="{Binding Image}">
                                        <Border CornerRadius="8" ClipToBounds="True">
                                            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                        </Border>
                                    </Button>
                                    <Button AutomationProperties.Name="Sil" Classes="Icon" Content="×" Width="24" Height="24"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Background="#99000000" ToolTip.Tip="Sil"
                                            IsVisible="{Binding $parent[UserControl].((vm:VehiclesViewModel)DataContext).CanDeletePhoto}"
                                            Command="{Binding $parent[UserControl].((vm:VehiclesViewModel)DataContext).DeleteDetailPhotoCommand}"
                                            CommandParameter="{Binding}"/>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="Secondary" Content="Foto Ekle" HorizontalAlignment="Left"
                            Command="{Binding AddPhotosCommand}"/>
                    <ItemsControl ItemsSource="{Binding Photos}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhotoStage">
                                <Border Margin="0,0,8,8" Width="84" Height="84" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource SurfaceElevatedBrush}">
                                    <Panel>
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                        <Button AutomationProperties.Name="Kaldır" Classes="Icon" Content="×" Width="24" Height="24"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Command="{Binding $parent[ItemsControl].((vm:VehiclesViewModel)DataContext).RemovePhotoCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                </StackPanel></Border>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding ClearCommand}" TabIndex="7"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding AddCommand}" TabIndex="6"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Width="300" Spacing="16" VerticalAlignment="Top" Margin="0,40,0,0">
                <Border Classes="IosKart" Padding="16">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Önizleme" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Araç listesinde böyle görünecek" Classes="Helper"/>
                        </StackPanel>
                        <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="12" Padding="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="IkonKutu buyuk" Background="#0A84FF">
                                    <PathIcon Data="{DynamicResource IconVehicles}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding NewCode}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               IsVisible="{Binding NewCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="İç kod girilmedi" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                               IsVisible="{Binding NewCode, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding SelVehicleType.Name, FallbackValue='Makine tipi seçilmedi', TargetNullValue='Makine tipi seçilmedi'}"
                                               Classes="Helper" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" Classes="Hap" IsVisible="{Binding NewStatusPick, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{Binding NewStatusPick.Label}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding NewPlate, StringFormat='Plaka: {0}'}" Classes="Helper"
                                       IsVisible="{Binding NewPlate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Grid.Column="0" Text="Plaka girilmedi" Classes="Helper"
                                       IsVisible="{Binding NewPlate, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelBrand.Name}" Classes="Helper"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="IosKart" Padding="16,14">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Kontrol listesi" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Panel Grid.Column="0" Classes="KontrolIsaret">
                                <Border Classes="tamam" IsVisible="{Binding NewCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <PathIcon Data="{DynamicResource IconCheck}"/>
                                </Border>
                                <Border Classes="eksik" IsVisible="{Binding NewCode, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                            </Panel>
                            <TextBlock Grid.Column="1" Text="İç Kod" Classes="Body" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Zorunlu" Classes="Helper" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Panel Grid.Column="0" Classes="KontrolIsaret">
                                <Border Classes="tamam" IsVisible="{Binding SelBranch, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <PathIcon Data="{DynamicResource IconCheck}"/>
                                </Border>
                                <Border Classes="eksik" IsVisible="{Binding SelBranch, Converter={x:Static ObjectConverters.IsNull}}"/>
                            </Panel>
                            <TextBlock Grid.Column="1" Text="Şantiye / Şube" Classes="Body" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Zorunlu" Classes="Helper" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding IsRentalMode}">
                            <Panel Grid.Column="0" Classes="KontrolIsaret">
                                <Border Classes="tamam" IsVisible="{Binding RentCompany, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <PathIcon Data="{DynamicResource IconCheck}"/>
                                </Border>
                                <Border Classes="eksik" IsVisible="{Binding RentCompany, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                            </Panel>
                            <TextBlock Grid.Column="1" Text="Kiralayan Firma" Classes="Body" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Zorunlu" Classes="Helper" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Panel Grid.Column="0" Classes="KontrolIsaret">
                                <Border Classes="istege" />
                            </Panel>
                            <TextBlock Grid.Column="1" Text="Fotoğraflar" Classes="Body" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Photos.Count, StringFormat='{}{0} eklendi'}" Classes="Helper" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- ⭐ M-64 (F-129 · Şablon B): ortak Pager — numaralı sayfalar (kullanıcı isteği 2026-07-18) + sayfa boyutu, SOL en altta
             (2026-07-19); durum metni sağında. -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,10,0,0" IsVisible="{Binding !ShowAdd}">
            <SelectableTextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ctrl:Pager Grid.Column="0" ShowPageNumbers="True" IsVisible="{Binding HasRows}"
                        PageSizes="{Binding PageSizes}" PageSize="{Binding PageSize, Mode=TwoWay}"
                        TotalCount="{Binding TotalCount}" Page="{Binding PagerPage}"/>
        </Grid>

        <!-- Liste + Detay -->
        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="*,360" IsVisible="{Binding !ShowAdd}">
          <Panel Grid.Column="0">
            <!-- Excel-benzeri: pencere küçülünce taşma/kayma OLMAZ; sığmazsa yatay kaydırma çıkar
                 (kullanıcı isteği 2026-07-18, madde 3). -->
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DockPanel HorizontalAlignment="Left" Classes="Modern">
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ctrl:ColumnRules.Enabled="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:SortHeader Grid.Column="0" Text="İÇ KOD" ColumnKey="internalCode" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=internalCode}"/>
                            <local:SortHeader Grid.Column="1" Text="PLAKA" ColumnKey="plate" MinWidth="120"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=plate}"/>
                            <local:SortHeader Grid.Column="2" Text="YIL" ColumnKey="productionYear" MinWidth="60"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=productionYear}"/>
                            <local:SortHeader Grid.Column="3" Text="SAYAÇ" ColumnKey="meter" MinWidth="110"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=meter}"/>
                            <local:SortHeader Grid.Column="4" Text="DURUM" ColumnKey="status" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=status}"/>
                            <local:SortHeader Grid.Column="5" Text="DURUM NOTU" ColumnKey="statusNote" MinWidth="120"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=statusNote}"/>
                            <local:SortHeader Grid.Column="6" Text="ARAÇ TİPİ" ColumnKey="vehicleType" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=vehicleType}"/>
                            <local:SortHeader Grid.Column="7" Text="KATEGORİ" ColumnKey="category" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=category}"/>
                            <local:SortHeader Grid.Column="8" Text="MARKA" ColumnKey="brand" MinWidth="90"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=brand}"/>
                            <local:SortHeader Grid.Column="9" Text="MODEL" ColumnKey="model" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=model}"/>
                            <local:SortHeader Grid.Column="10" Text="ŞUBE/ŞANTİYE" ColumnKey="branch" MinWidth="120"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=branch}"/>
                            <local:SortHeader Grid.Column="11" Text="SÜRÜCÜ" ColumnKey="driver" MinWidth="110"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=driver}"/>
                            <local:SortHeader Grid.Column="12" Text="ŞASE NO" ColumnKey="chassisNo" MinWidth="110"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=chassisNo}"/>
                            <local:SortHeader Grid.Column="13" Text="MOTOR NO" ColumnKey="engineNo" MinWidth="110"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=engineNo}"/>
                            <!-- ⭐ 2026-10-10 kira kolonları — yalnız Kiralık Araçlar ekranının kataloğunda seçilebilir. -->
                            <local:SortHeader Grid.Column="14" Text="KİRALAYAN FİRMA" ColumnKey="rentalCompany" MinWidth="120"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=rentalCompany}"/>
                            <local:SortHeader Grid.Column="15" Text="KİRA BAŞLANGIÇ" ColumnKey="rentalStart" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=rentalStart}"/>
                            <local:SortHeader Grid.Column="16" Text="KİRA BİTİŞ" ColumnKey="rentalEnd" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=rentalEnd}"/>
                            <local:SortHeader Grid.Column="17" Text="YERİNE GELDİĞİ" ColumnKey="replacedVehicle" MinWidth="110"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=replacedVehicle}"/>
                            <SelectableTextBlock Grid.Column="18" Text="BAKIM/MUAYENE" MinWidth="120" MaxWidth="120"/>
                        </Grid>
                    </Border>
                    <!-- Başlık-altı filtre satırı (kullanıcı isteği 2026-08-06, madde 4) — bkz. MaterialsView.axaml aynı yorum.
                         Kolon 14 (BAKIM/MUAYENE) hesaplanan uyarı rozetidir, ColumnKey/filtre YOK. -->
                    <Border Classes="TableFilterRow" DockPanel.Dock="Top">
                        <Grid ctrl:ColumnRules.Enabled="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="0" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=internalCode}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=internalCode}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=internalCode}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=internalCode}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="1" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=plate}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=plate}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=plate}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=plate}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="2" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=productionYear}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=productionYear}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=productionYear}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=productionYear}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="3" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=meter}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=meter}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=meter}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=meter}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="4" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=status}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=status}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=status}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=status}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="5" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=statusNote}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=statusNote}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=statusNote}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=statusNote}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="6" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=vehicleType}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=vehicleType}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=vehicleType}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=vehicleType}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="7" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=category}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=category}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=category}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=category}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="8" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=brand}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=brand}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=brand}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=brand}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="9" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=model}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=model}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=model}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=model}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="10" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=branch}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=branch}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=branch}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=branch}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="11" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=driver}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=driver}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=driver}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=driver}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="12" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=chassisNo}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=chassisNo}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=chassisNo}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=chassisNo}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="13" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=engineNo}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=engineNo}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=engineNo}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=engineNo}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="14" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalCompany}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalCompany}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=rentalCompany}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=rentalCompany}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="15" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalStart}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalStart}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=rentalStart}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=rentalStart}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="16" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalEnd}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalEnd}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=rentalEnd}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=rentalEnd}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="17" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=replacedVehicle}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=replacedVehicle}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=replacedVehicle}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=replacedVehicle}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:VehiclesViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </Border>
                    <!-- Tek tık = detay paneli (SelectedItem). Çift tık = ayrı Düzelt/Kaydet/Sil penceresi. -->
                    <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                             DoubleTapped="OnRowDoubleTapped">
                        <!-- ⭐ iOS tasarım (2026-10-28): satır SAĞ TIK menüsü — seçili kayıt işlemleri (ekrandaki düğmelerle aynı komut ve koşul) -->
                        <ListBox.ContextMenu>
                            <ContextMenu Classes="SatirMenusu">
                                <MenuItem Header="Düzenle" Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <MenuItem Header="Arıza Bildir" Command="{Binding ArizaBildirCommand}" IsVisible="{Binding CanOpenWorkOrder}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <MenuItem Header="İş Emri Aç" Command="{Binding AractanIsEmriCommand}" IsVisible="{Binding CanOpenWorkOrder}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <MenuItem Header="QR Etiketi" Command="{Binding QrLabelCommand}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <Separator/>
                                <MenuItem Header="Excel'e Aktar" Command="{Binding ExportExcelCommand}" IsEnabled="{Binding !IsExporting}" ToolTip.Tip="Aktif filtrelerle eşleşen TÜM araçları (yalnız bu sayfayı değil) Excel dosyası olarak indirir"/>
                                <MenuItem Header="Yazdır" Command="{Binding YazdirCommand}" IsEnabled="{Binding !IsExporting}" ToolTip.Tip="Ekrandaki filtrelenmiş listeyi PDF olarak kaydeder (imzalı çıktı için)."/>
                                <Separator/>
                                <MenuItem Classes="tehlike" Header="Sil" Command="{Binding RequestDeleteCommand}" IsVisible="{Binding CanDelete}" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VehicleRow">
                                <Grid ctrl:ColumnRules.Enabled="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Kolon 1,3-14: Min=Max ile ColWidths'e SIKI bağlı (kullanıcı isteği 2026-08-06, madde 1-3) —
                                         bkz. MaterialsView.axaml aynı yorum: küçültme + TextTrimming artık gerçekten çalışır. -->
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Code}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=internalCode}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=internalCode}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Code}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=internalCode}"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding PlateDisplay}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=plate}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=plate}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PlateDisplay}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=plate}"/>
                                    <!-- Sayısal sütun (ListColumns: IsNumeric) → sağa yaslı okunur. -->
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding YearDisplay}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=productionYear}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=productionYear}"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=productionYear}"/>
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding MeterDisplay}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=meter}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=meter}"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=meter}"/>
                                    <ctrl:StatusBadge Grid.Column="4" VerticalAlignment="Center"
                                                      MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=status}"
                                                      MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=status}"
                                                      Kind="{Binding StatusKind}" Text="{Binding StatusText}"
                                                      IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=status}"/>
                                    <SelectableTextBlock Grid.Column="5" Text="{Binding StatusNote}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=statusNote}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=statusNote}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusNote}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=statusNote}"/>
                                    <SelectableTextBlock Grid.Column="6" Text="{Binding VehicleType}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=vehicleType}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=vehicleType}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VehicleType}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=vehicleType}"/>
                                    <SelectableTextBlock Grid.Column="7" Text="{Binding Category}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=category}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=category}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Category}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=category}"/>
                                    <SelectableTextBlock Grid.Column="8" Text="{Binding Brand}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=brand}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=brand}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Brand}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=brand}"/>
                                    <SelectableTextBlock Grid.Column="9" Text="{Binding Model}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=model}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=model}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Model}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=model}"/>
                                    <SelectableTextBlock Grid.Column="10" Text="{Binding Branch, Converter={x:Static local:Conv.Atanmadi}}" Opacity="{Binding Branch, Converter={x:Static local:Conv.AtanmadiOpacity}}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=branch}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=branch}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Branch}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=branch}"/>
                                    <SelectableTextBlock Grid.Column="11" Text="{Binding Driver, Converter={x:Static local:Conv.Atanmadi}}" Opacity="{Binding Driver, Converter={x:Static local:Conv.AtanmadiOpacity}}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=driver}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=driver}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Driver}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=driver}"/>
                                    <SelectableTextBlock Grid.Column="12" Text="{Binding ChassisNo}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=chassisNo}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=chassisNo}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ChassisNo}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=chassisNo}"/>
                                    <SelectableTextBlock Grid.Column="13" Text="{Binding EngineNo}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=engineNo}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=engineNo}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EngineNo}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=engineNo}"/>
                                    <SelectableTextBlock Grid.Column="14" Text="{Binding RentalCompany}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalCompany}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalCompany}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RentalCompany}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=rentalCompany}"/>
                                    <SelectableTextBlock Grid.Column="15" Text="{Binding RentalStart}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalStart}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalStart}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RentalStart}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=rentalStart}"/>
                                    <SelectableTextBlock Grid.Column="16" Text="{Binding RentalEnd}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalEnd}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=rentalEnd}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RentalEnd}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=rentalEnd}"/>
                                    <SelectableTextBlock Grid.Column="17" Text="{Binding ReplacedVehicle}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=replacedVehicle}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=replacedVehicle}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReplacedVehicle}"
                                               IsVisible="{Binding $parent[ListBox].((vm:VehiclesViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=replacedVehicle}"/>
                                    <ctrl:StatusBadge Grid.Column="18" MinWidth="120" VerticalAlignment="Center"
                                                      Kind="{Binding AlertKind}" Text="{Binding AlertText}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
              </ScrollViewer>
            </Border>

            <ctrl:StatePanel Mode="Error" Title="Liste yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}"
                             IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel ActionText="{Binding AddButtonText}" ActionCommand="{Binding ToggleAddCommand}" Mode="Empty" Title="Araç yok"
                             Message="Arama kriterine uygun araç bulunamadı.">
                <!-- ekleme formu açıkken gizli (form zaten açık; düğmesi küçük pencerede taşıyordu) -->
                <ctrl:StatePanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsEmpty"/>
                        <Binding Path="!ShowAdd"/>
                    </MultiBinding>
                </ctrl:StatePanel.IsVisible>
            </ctrl:StatePanel>
          </Panel>

          <!-- Detay (salt okuma) / Düzenle / Sil -->
          <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding HasSelection}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                <!-- ⭐ iOS tasarım (2026-10-28): ilk fotoğraf kart başında; tümü açılır bölümde (varsayılan kapalı) → kart ferahlar -->
                <Expander Classes="IosAcilir" Header="{Binding DetailPhotos.Count, StringFormat='Fotoğraflar ({0})'}" IsExpanded="False"
                          IsVisible="{Binding KapakFotoVar}">
                <ItemsControl ItemsSource="{Binding DetailPhotos}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetailPhoto">
                            <Panel Margin="0,0,8,8" Width="72" Height="72">
                                <Button AutomationProperties.Name="Büyüt" Classes="Ghost" Padding="0" Background="Transparent" Cursor="Hand" ToolTip.Tip="Büyüt"
                                        Command="{Binding $parent[UserControl].((vm:VehiclesViewModel)DataContext).OpenPhotoCommand}"
                                        CommandParameter="{Binding Image}">
                                    <Border CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                    </Border>
                                </Button>
                                <!-- ADR-182 (PK-F3): SİLME DÜĞMESİ BURADAN KALDIRILDI — bu panel salt-okunur
                                     görüntülemedir; silme yalnız Düzenle formunda + SİLME yetkisiyle. -->
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Expander>
                <!-- çevrimdışı notu yalnız gösterilecek fotoğraf varken (fotoğrafsız araçta gereksiz kalabalık) -->
                <SelectableTextBlock Text="{Binding PhotosOfflineNote}" Classes="Hint" TextWrapping="Wrap">
                    <SelectableTextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="PhotosOffline"/>
                            <Binding Path="KapakFotoVar"/>
                        </MultiBinding>
                    </SelectableTextBlock.IsVisible>
                </SelectableTextBlock>
                <!-- ⭐ M-39: KİRA SÖZLEŞMESİ — kiralayan/kiracı cari + yön (K-19: borç/alacak faturayla) -->
                <StackPanel Spacing="4" IsVisible="{Binding IsRentalMode}">
                  <SelectableTextBlock Text="KİRA SÖZLEŞMESİ" Classes="Helper"/>
                  <ctrl:LookupBox ItemsSource="{Binding KiraCariSecenekleri}" SelectedItem="{Binding KiraCari}" PlaceholderText="Cari seç / ara..."
                                  ToolTip.Tip="Kiralayan (ya da kiraya verdiğimiz) firmanın cari kartı"/>
                  <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding KiraYonleri}" SelectedItem="{Binding KiraYon}"/>
                  <Button Classes="Secondary" Content="Sözleşmeyi Kaydet" Command="{Binding KiraSozlesmesiKaydetCommand}" IsVisible="{Binding CanEdit}"
                          ToolTip.Tip="Cari ve yönü kaydeder; dönem maliyet/gelir raporu bunları kullanır. Otomatik cari borç/alacak yazılmaz."/>
                </StackPanel>
                <!-- ⭐ 2026-10-10: Kiralamayı Bitir (araç kiralayan firmaya iade edildi) — yalnız aktif kiralık araçta. -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanEndRental}">
                  <ctrl:TarihKutusu SelectedDate="{Binding EndRentalDate}" Width="140"
                                    ToolTip.Tip="İade (kira bitiş) tarihi"/>
                  <Button Classes="Secondary" Content="Kiralamayı Bitir" Command="{Binding EndRentalCommand}"
                          ToolTip.Tip="Araç iade edildi: durum Pasif olur, kira bitişi seçilen gün yazılır. Geçmiş kayıtlar korunur."/>
                </StackPanel>
                <WrapPanel>
                  <!-- M-64: ekranın tek ana düğmesi araç çubuğunda; yıkıcı eylem en sonda. iOS tasarım (2026-10-28): "Düzenle" kart başındaki
                       yuvarlak eylem düğmelerine taşındı. -->
                  <Button Classes="Danger" Content="Sil"
                          Command="{Binding RequestDeleteCommand}" IsVisible="{Binding CanDelete}"/>
                </WrapPanel>
              </StackPanel>
              <DockPanel>
                <!-- ⭐ iOS tasarım (2026-10-28): kart başı — büyük simge, kod, plaka · marka model, durum; altında yuvarlak eylem düğmeleri. -->
                <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,12">
                  <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <!-- ⭐ iOS tasarım (2026-10-28): kapak — ilk eklenen fotoğraf (tıkla → büyüt); yoksa simge -->
                    <Panel Width="72" Height="72" HorizontalAlignment="Center">
                      <Border Classes="IkonKutu" Width="64" Height="64" CornerRadius="18" Background="#0A84FF" HorizontalAlignment="Center"
                              IsVisible="{Binding !KapakFotoVar}">
                        <PathIcon Width="32" Height="32" Data="{DynamicResource IconVehicles}"/>
                      </Border>
                      <Button Classes="KapakFoto" IsVisible="{Binding KapakFotoVar}" ToolTip.Tip="Fotoğrafı büyüt"
                              AutomationProperties.Name="Kapak fotoğrafını büyüt"
                              Command="{Binding $parent[UserControl].((vm:VehiclesViewModel)DataContext).OpenPhotoCommand}"
                              CommandParameter="{Binding KapakFoto}">
                        <Border CornerRadius="18" ClipToBounds="True" Width="72" Height="72">
                          <Image Source="{Binding KapakFoto}" Stretch="UniformToFill"/>
                        </Border>
                      </Button>
                    </Panel>
                    <SelectableTextBlock Text="{Binding Selected.Code}" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <SelectableTextBlock Text="{Binding Detail.Plate}" Classes="Helper" HorizontalAlignment="Center"/>
                    <ctrl:StatusBadge Kind="{Binding Selected.StatusKind}" Text="{Binding Selected.StatusText}" HorizontalAlignment="Center"/>
                  </StackPanel>
                  <UniformGrid Rows="1" ColumnSpacing="6">
                    <Button Classes="IosEylem" Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Aracı düzenle">
                      <StackPanel Spacing="6"><Border><PathIcon Data="{DynamicResource IconEdit}"/></Border><TextBlock Text="Düzenle"/></StackPanel>
                    </Button>
                    <!-- ⭐ M-35: araç kartından arıza bildir / iş emri aç -->
                    <Button Classes="IosEylem" Command="{Binding ArizaBildirCommand}" IsEnabled="{Binding HasSelection}" IsVisible="{Binding CanOpenWorkOrder}"
                            ToolTip.Tip="Seçili aracı &quot;Arızalı&quot; yapar ve taslak iş emri açar; iş emri tamamlanınca araç yeniden Aktif olur, arıza süresi ölçülür.">
                      <StackPanel Spacing="6"><Border><PathIcon Data="{DynamicResource IconWarning}"/></Border><TextBlock Text="Arıza Bildir"/></StackPanel>
                    </Button>
                    <Button Classes="IosEylem" Command="{Binding AractanIsEmriCommand}" IsEnabled="{Binding HasSelection}" IsVisible="{Binding CanOpenWorkOrder}"
                            ToolTip.Tip="Seçili araç için bakım/iş emri taslağı açar (bakım uyarısını işe dönüştürmek için); araç durumu değişmez.">
                      <StackPanel Spacing="6"><Border><PathIcon Data="{DynamicResource IconWorkOrders}"/></Border><TextBlock Text="İş Emri Aç"/></StackPanel>
                    </Button>
                    <Button Classes="IosEylem" Command="{Binding QrLabelCommand}" IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="Seçili aracın iç koduyla yazdırılabilir QR etiketi (PNG) üretir — Ctrl+K ile açılan aramada okutulunca bu kayıt bulunur">
                      <StackPanel Spacing="6"><Border><PathIcon Data="F0 M3 3h7v7H3Z M5 5v3h3V5Z M14 3h7v7h-7Z M16 5v3h3V5Z M3 14h7v7H3Z M5 16v3h3v-3Z M14 14h3v3h-3Z M18 14h3v3h-3Z M14 18h3v3h-3Z M18 18h3v3h-3Z"/></Border><TextBlock Text="QR Etiketi"/></StackPanel>
                    </Button>
                  </UniformGrid>
                </StackPanel>
                <TabControl Classes="IosSekme">
                  <!-- GENEL -->
                  <TabItem Header="Genel">
                    <ScrollViewer>
                      <StackPanel Spacing="12" Margin="0,10,0,0">
                        <!-- ⭐ iOS tasarım (2026-10-28, kullanıcı onayı): bakım / muayene / sigorta ilerleme çubukları -->
                        <StackPanel Spacing="10" IsVisible="{Binding HasBakimCubugu}">
                          <TextBlock Text="Bakım ve Muayene" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                          <ItemsControl ItemsSource="{Binding BakimCubuklari}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:BakimCubugu">
                                <StackPanel Spacing="5" Margin="0,0,0,10">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding Ad}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sag}" FontSize="12.5" Classes="BakimSag" Classes.gecikti="{Binding Gecikti}"/>
                                  </Grid>
                                  <ProgressBar Classes="IosCubuk" Minimum="0" Maximum="100" Value="{Binding Yuzde}" Foreground="{Binding Renk}"/>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="12" Padding="14,8">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              DataContext="{Binding Detail}">
                          <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Plaka" Classes="Helper" Margin="0,2,12,2"/>
                          <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Plate}" Classes="Body"/>
                          <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Makine Tipi" Classes="Helper" Margin="0,2,12,2"/>
                          <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VehicleTypeName}" Classes="Body"/>
                          <SelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Kategori" Classes="Helper" Margin="0,2,12,2"/>
                          <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CategoryName}" Classes="Body"/>
                          <SelectableTextBlock Grid.Row="3" Grid.Column="0" Text="Marka" Classes="Helper" Margin="0,2,12,2"/>
                          <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BrandName}" Classes="Body"/>
                          <SelectableTextBlock Grid.Row="4" Grid.Column="0" Text="Model" Classes="Helper" Margin="0,2,12,2"/>
                          <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding VehicleModelName}" Classes="Body"/>
                          <SelectableTextBlock Grid.Row="5" Grid.Column="0" Text="Şantiye" Classes="Helper" Margin="0,2,12,2"/>
                          <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BranchName}" Classes="Body"/>
                          <SelectableTextBlock Grid.Row="6" Grid.Column="0" Text="Sürücü" Classes="Helper" Margin="0,2,12,2"/>
                          <SelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DriverName}" Classes="Body"/>
                          <SelectableTextBlock Grid.Row="7" Grid.Column="0" Text="Üretim Yılı" Classes="Helper" Margin="0,2,12,2"/>
                          <SelectableTextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ProductionYear}" Classes="Body"/>
                          <SelectableTextBlock Grid.Row="8" Grid.Column="0" Text="Şasi No" Classes="Helper" Margin="0,2,12,2"/>
                          <SelectableTextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ChassisNo}" Classes="Body"/>
                          <SelectableTextBlock Grid.Row="9" Grid.Column="0" Text="Motor No" Classes="Helper" Margin="0,2,12,2"/>
                          <SelectableTextBlock Grid.Row="9" Grid.Column="1" Text="{Binding EngineNo}" Classes="Body"/>
                        </Grid>
                        </Border>
                        <StackPanel Spacing="2">
                          <SelectableTextBlock Text="Sayaç" Classes="Helper"/>
                          <SelectableTextBlock Text="{Binding Detail.MeterDisplay}" Classes="Metric"/>
                          <!-- ⭐ M-36: eski sayaç uyarısı -->
                          <SelectableTextBlock Text="{Binding EskiSayacUyarisi}" Classes="Helper" TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningBrush}"
                                               IsVisible="{Binding EskiSayacUyarisi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <!-- ⭐ M-36: SAYAÇ GEÇMİŞİ — yanlış okuma kayıt iptal edilmeden "geçersiz" sayılır -->
                        <!-- ⭐ iOS tasarım (2026-10-28): açılır bölüm (varsayılan kapalı) -->
                        <Expander Classes="IosAcilir" Header="Sayaç geçmişi" IsExpanded="False" IsVisible="{Binding HasSayacGecmisi}">
                        <StackPanel Spacing="2">
                          <ItemsControl ItemsSource="{Binding SayacGecmisi}" MaxHeight="220">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="inf:SayacOkumasi">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                  <SelectableTextBlock Grid.Column="0" Text="{Binding Satir}" Classes="Helper" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                  <Button Grid.Column="1" Classes="Ghost" Content="Geçersiz/Geçerli" Margin="6,0,0,0"
                                          Command="{Binding $parent[ItemsControl].((vm:VehiclesViewModel)DataContext).SayacGecersizSayCommand}"
                                          CommandParameter="{Binding}"
                                          IsVisible="{Binding $parent[ItemsControl].((vm:VehiclesViewModel)DataContext).CanVoidMeter}"
                                          ToolTip.Tip="Yanlış okunan sayacı hesaptan çıkarır (ya da geri alır); kayıt geçerli kalır."/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        </Expander>
                        <!-- ⭐ M-43: GÜNLÜK KONTROL LİSTESİ — uygun olmayan madde → isteğe bağlı arıza bildir. iOS tasarım: açılır bölüm (kapalı) -->
                        <Expander Classes="IosAcilir" Header="Günlük kontrol" IsExpanded="False" IsVisible="{Binding CanEdit}">
                        <StackPanel Spacing="4">
                          <ItemsControl ItemsSource="{Binding KontrolMaddeleri}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:KontrolMaddesiSatiri">
                                <StackPanel Spacing="2" Margin="0,1">
                                  <CheckBox IsChecked="{Binding Uygun}" Content="{Binding Madde}"/>
                                  <TextBox Classes="Field" Text="{Binding Not}" PlaceholderText="Uygun değil — kısa not" IsVisible="{Binding !Uygun}"/>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBox Classes="Field" Text="{Binding KontrolNotu}" PlaceholderText="Genel not (isteğe bağlı)"/>
                          <CheckBox IsChecked="{Binding KontrolArizaAc}" Content="Uygun olmayan varsa arıza bildir"
                                    ToolTip.Tip="İşaretliyse: araç Arızalı olur ve taslak arıza iş emri açılır (açık arıza zaten varsa yeni açılmaz)."/>
                          <Button Classes="Secondary" Content="Kontrolü Kaydet" Command="{Binding KontrolKaydetCommand}" HorizontalAlignment="Left"/>
                          <ItemsControl ItemsSource="{Binding GunlukKontroller}" MaxHeight="160" IsVisible="{Binding HasGunlukKontrol}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="inf:GunlukKontrol">
                                <SelectableTextBlock Text="{Binding Satir}" Classes="Helper" TextWrapping="Wrap"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        </Expander>
                        <StackPanel Spacing="2"
                                    IsVisible="{Binding Detail.StatusNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <SelectableTextBlock Text="Durum Açıklaması" Classes="Helper"/>
                          <SelectableTextBlock Text="{Binding Detail.StatusNote}" Classes="Body" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- ⭐ 2026-10-10 KİRA BİLGİSİ + değişim zinciri (kiralık araçta) -->
                        <Border Classes="Panel" Background="{DynamicResource SurfaceAltBrush}" Padding="10"
                                IsVisible="{Binding Detail.IsRental}">
                          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" DataContext="{Binding Detail}">
                            <SelectableTextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="KİRA BİLGİSİ" Classes="SectionTitle" Margin="0,0,0,6"/>
                            <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Kiralayan" Classes="Helper" Margin="0,2,12,2"/>
                            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RentalCompany}" Classes="Body" TextWrapping="Wrap"/>
                            <SelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Başlangıç" Classes="Helper" Margin="0,2,12,2"/>
                            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RentalStartText}" Classes="Body"/>
                            <SelectableTextBlock Grid.Row="3" Grid.Column="0" Text="Bitiş" Classes="Helper" Margin="0,2,12,2"/>
                            <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RentalEndText}" Classes="Body"/>
                            <SelectableTextBlock Grid.Row="4" Grid.Column="0" Text="Bedel" Classes="Helper" Margin="0,2,12,2"/>
                            <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RentalPriceText}" Classes="Body"/>
                            <SelectableTextBlock Grid.Row="5" Grid.Column="0" Text="Yerine geldiği" Classes="Helper" Margin="0,2,12,2"
                                                 IsVisible="{Binding ReplacedVehicleCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <SelectableTextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Classes="Body"
                                                 IsVisible="{Binding ReplacedVehicleCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <SelectableTextBlock.Text>
                                <MultiBinding StringFormat="{}{0} — {1}">
                                  <Binding Path="ReplacedVehicleCode"/>
                                  <Binding Path="ReplacementReason" FallbackValue="" TargetNullValue="neden yazılmadı"/>
                                </MultiBinding>
                              </SelectableTextBlock.Text>
                            </SelectableTextBlock>
                            <SelectableTextBlock Grid.Row="6" Grid.Column="0" Text="Yerine gelen" Classes="Helper" Margin="0,2,12,2"
                                                 IsVisible="{Binding ReplacedByCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <SelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ReplacedByCode}" Classes="Body"
                                                 IsVisible="{Binding ReplacedByCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </TabItem>
                  <!-- UYUMLU MALZEMELER -->
                  <TabItem Header="Uyumlu Malzemeler">
                    <ScrollViewer>
                      <StackPanel>
                      <!-- 2026-09-30: bağımlı Ana → Alt kategori filtresi (hızlı düzenleme penceresiyle aynı). -->
                      <WrapPanel Margin="0,8,0,0" ItemSpacing="10" LineSpacing="8">
                        <StackPanel Spacing="4"><SelectableTextBlock Text="Ana Kategori" Classes="Helper"/>
                          <ComboBox Width="200" ItemsSource="{Binding MatTopOptions}" SelectedItem="{Binding SelectedMatTop}"/></StackPanel>
                        <StackPanel Spacing="4"><SelectableTextBlock Text="Alt Kategori / Tanım" Classes="Helper"/>
                          <ComboBox Width="200" ItemsSource="{Binding MatSubOptions}" SelectedItem="{Binding SelectedMatSub}"/></StackPanel>
                        <Button Classes="Primary" Content="Sorgula" Command="{Binding ApplyMatFilterCommand}" VerticalAlignment="Bottom"/>
                        <Button Classes="Secondary" Content="Filtreleri Temizle" Command="{Binding ClearMatFilterCommand}" VerticalAlignment="Bottom"/>
                      </WrapPanel>
                      <!-- Kategori grupları (kullanıcı isteği 2026-09-30): her kategori açılır başlık; içinde kod/ad/stok. -->
                      <ItemsControl ItemsSource="{Binding VehicleMaterials}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="m:MaterialStockGroup">
                            <Expander Classes="IosAcilir" Header="{Binding Header}" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                              <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="m:MaterialStock">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                      <SelectableTextBlock Grid.Column="0" Text="{Binding Code}" Classes="Helper" MinWidth="90" VerticalAlignment="Center"/>
                                      <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" Classes="Body" VerticalAlignment="Center"/>
                                      <SelectableTextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='Stok: {0:0.##}'}" Classes="Helper" VerticalAlignment="Center"/>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Expander>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </TabItem>
                  <!-- MUAYENE / SİGORTA -->
                  <TabItem Header="Muayene/Sigorta">
                    <ScrollViewer>
                      <ItemsControl ItemsSource="{Binding VehicleInspections}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="mnt:InspectionRow">
                            <Border Classes="Divider" Padding="0,4">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="1">
                                  <SelectableTextBlock Text="{Binding DocTypeText}" Classes="Body" FontWeight="SemiBold"/>
                                  <SelectableTextBlock Text="{Binding NextText, StringFormat='Sonraki: {0}'}" Classes="Helper"/>
                                </StackPanel>
                                <SelectableTextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="Helper" VerticalAlignment="Center"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </TabItem>
                  <!-- BAKIM TAKİBİ -->
                  <TabItem Header="Bakım Takibi">
                    <ScrollViewer>
                      <ItemsControl ItemsSource="{Binding VehicleMaintenances}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="mnt:MaintenanceRow">
                            <Border Classes="Divider" Padding="0,4">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="1">
                                  <SelectableTextBlock Text="{Binding DefinitionName}" Classes="Body" FontWeight="SemiBold"/>
                                  <SelectableTextBlock Text="{Binding PerformedDisplay, StringFormat='Yapılan: {0}'}" Classes="Helper"/>
                                  <SelectableTextBlock Text="{Binding NextDueDisplay, StringFormat='Sonraki: {0}'}" Classes="Helper"/>
                                </StackPanel>
                                <SelectableTextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="Helper" VerticalAlignment="Center"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </TabItem>
                  <!-- İŞLEM GEÇMİŞİ (madde 4/5, kullanıcı isteği 2026-08-06): Günlük Faaliyet hareketleri +
                       sistem olayları (oluşturma/transfer/güncelleme/sayaç) birleşik, kronolojik. Çift tık →
                       salt-okunur detay + (varsa) "Kaydı Görüntüle". -->
                  <!-- ⭐ M-56 (F-090): kayda bağlı belgeler -->
                  <TabItem Header="Belgeler">
                    <ctrl:KayitBelgeleri DataContext="{Binding Belgeler}" Margin="0,8,0,0"/>
                  </TabItem>
                  <TabItem Header="İşlem Geçmişi">
                    <ScrollViewer>
                      <ListBox x:Name="HistoryList" ItemsSource="{Binding VehicleMovements}" Margin="0,8,0,0"
                               DoubleTapped="OnHistoryDoubleTapped">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:MovementDisplay">
                            <Border Classes="Divider" Padding="0,4">
                              <Grid ColumnDefinitions="Auto,Auto,*">
                                <SelectableTextBlock Grid.Column="0" Text="{Binding DateText}" Classes="Helper" MinWidth="90" VerticalAlignment="Center"/>
                                <SelectableTextBlock Grid.Column="1" Text="{Binding Kind}" Classes="Body" FontWeight="SemiBold" MinWidth="80" VerticalAlignment="Center"/>
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Description}" Classes="Body" TextWrapping="Wrap" VerticalAlignment="Center"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </ScrollViewer>
                  </TabItem>
                </TabControl>
              </DockPanel>
            </DockPanel>
          </Border>

          <!-- Seçim yokken ipucu -->
          <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding !HasSelection}">
            <SelectableTextBlock Text="Detay/düzenleme için bir araç seçin." Classes="Helper"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>

    </Grid>
</UserControl>
