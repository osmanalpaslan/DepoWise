<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             x:Class="DepoWise.Desktop.Views.FieldSettingsView"
             x:DataType="vm:FieldSettingsViewModel">

    <!-- ALAN AYARLARI (kullanıcı isteği 2026-09-03): formlardaki opsiyonel alanlar firma bazında
         zorunlu yapılır. Sistem zorunluları kilitli gösterilir; ayar diğer firmaları etkilemez. -->
    <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource AppBackgroundBrush}" Margin="24">
        <ctrl:Toolbar Grid.Row="0" Title="Alan Ayarları">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <SelectableTextBlock Grid.Row="1" Classes="Helper" Margin="0,10,0,0" TextWrapping="Wrap"
            Text="{Binding Status}"/>

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
          <StackPanel>
            <!-- ⭐ M-30 (AR-GE 2026-10-18): DÖNEM KİLİDİ (ay kapanışı) — yalnız yönetici; kayıt sunucuda yapılır. -->
            <Border Background="{DynamicResource SurfaceElevatedBrush}" Padding="12,6" CornerRadius="6"
                    MaxWidth="640" HorizontalAlignment="Left">
                <SelectableTextBlock Text="DÖNEM KİLİDİ (AY KAPANIŞI)" Classes="SectionTitle"/>
            </Border>
            <SelectableTextBlock Classes="Helper" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,6"
                Text="Seçilen gün dahil öncesine fatura, para, stok, yakıt ve bakım kaydı girilemez; o dönemin kayıtları iptal edilemez. Kapanmış ayın raporu böylece sonradan değişmez. Ayar için internet bağlantısı gerekir."/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4" MaxWidth="640" HorizontalAlignment="Left">
                <CalendarDatePicker Classes="Field" Width="180" SelectedDate="{Binding DonemKilidiTarihi}"
                                    IsEnabled="{Binding DonemKilidiDuzenlenebilir}"
                                    ToolTip.Tip="Kapatılacak dönemin son günü (bu gün DAHİL öncesi kilitlenir)."/>
                <Button Classes="Primary" Content="Kilitle" Command="{Binding DonemKilidiKaydetCommand}"
                        IsVisible="{Binding DonemKilidiDuzenlenebilir}"
                        ToolTip.Tip="Seçilen gün dahil öncesini kapatır (tüm kullanıcılar ve bilgisayarlar için)."/>
                <Button Classes="Secondary" Content="Kilidi Kaldır" Command="{Binding DonemKilidiKaldirCommand}"
                        IsVisible="{Binding DonemKilidiDuzenlenebilir}"
                        ToolTip.Tip="Dönem kilidini kaldırır; geçmiş tarihlere yeniden kayıt girilebilir."/>
            </StackPanel>
            <SelectableTextBlock Classes="Helper" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,16"
                Text="{Binding DonemKilidiDurumu}"/>

            <!-- ⭐ M-28: SAYIM FARK TOLERANSI — yalnız yönetici; kayıt sunucuda. -->
            <Border Background="{DynamicResource SurfaceElevatedBrush}" Padding="12,6" CornerRadius="6"
                    MaxWidth="640" HorizontalAlignment="Left">
                <SelectableTextBlock Text="SAYIM FARK TOLERANSI" Classes="SectionTitle"/>
            </Border>
            <SelectableTextBlock Classes="Helper" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,6"
                Text="Sayımda bir malzemenin farkı sistem miktarının bu yüzdesini aşarsa sayımı yalnız ters kayıt yetkisi olan kişi kesinleştirir; diğerleri taslak kaydeder. Boş bırakılırsa kontrol yapılmaz. Ayar için internet bağlantısı gerekir."/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4" MaxWidth="640" HorizontalAlignment="Left">
                <NumericUpDown Classes="Field" Width="120" Value="{Binding SayimToleransi}" Minimum="0" Maximum="100" FormatString="0.##"
                               ShowButtonSpinner="False" IsEnabled="{Binding DonemKilidiDuzenlenebilir}"
                               ToolTip.Tip="Yüzde (ör. 5 = %5). Boş = kontrol yok."/>
                <Button Classes="Primary" Content="Kaydet" Command="{Binding SayimToleransKaydetCommand}"
                        IsVisible="{Binding DonemKilidiDuzenlenebilir}" ToolTip.Tip="Toleransı firmanın tüm kullanıcıları için kaydeder."/>
            </StackPanel>
            <SelectableTextBlock Classes="Helper" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,16"
                Text="{Binding SayimToleransDurumu}"/>

            <!-- ⭐ FAZ 4.6 (kullanıcı isteği 2026-09-06): hangi sabit tanımın yanında "+" (satır içi
                 hızlı ekleme) çıkacağı firma bazında seçilir. Kapatmak tanımı SİLMEZ ve "Tanım
                 Düzenle" ekranından eklemeyi engellemez — yalnız formlardaki kısayolu kaldırır. -->
            <Border Background="{DynamicResource SurfaceElevatedBrush}" Padding="12,6" CornerRadius="6"
                    MaxWidth="640" HorizontalAlignment="Left">
                <SelectableTextBlock Text="SATIR İÇİ &quot;+&quot; (HIZLI TANIM EKLEME)" Classes="SectionTitle"/>
            </Border>
            <SelectableTextBlock Classes="Helper" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,6"
                Text="Kapatılan tanımın yanında &quot;+&quot; görünmez; kullanıcı o tanımı formdan ekleyemez. Tanım, &quot;Tanım Düzenle&quot; ekranından her zaman eklenebilir. Bu ayar yalnız sizin firmanızı etkiler."/>
            <Border Classes="Table" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,16">
                <ItemsControl ItemsSource="{Binding ArtiAyarlari}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArtiAyarSatiri">
                            <Grid ColumnDefinitions="220,120,*" Height="36" Margin="12,0">
                                <SelectableTextBlock Grid.Column="0" Text="{Binding Etiket}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Content="&quot;+&quot; açık" VerticalAlignment="Center"
                                          IsChecked="{Binding Acik}"
                                          IsEnabled="{Binding $parent[ItemsControl].((vm:FieldSettingsViewModel)DataContext).ArtiDuzenlenebilir}"
                                          ToolTip.Tip="Kapatılırsa bu tanımın yanındaki + düğmesi hiç çizilmez ve hızlı ekleme sunucuda da reddedilir."/>
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Ekran}" Classes="Helper" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FieldSettingGroup">
                        <StackPanel Margin="0,0,0,14" MaxWidth="640" HorizontalAlignment="Left">
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" Padding="12,6" CornerRadius="6">
                                <SelectableTextBlock Text="{Binding Title}" Classes="SectionTitle"/>
                            </Border>
                            <Border Classes="Table" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FieldSettingRow">
                                            <Grid ColumnDefinitions="220,140,*" Height="36" Margin="12,0">
                                                <SelectableTextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" Content="Zorunlu" VerticalAlignment="Center"
                                                          IsChecked="{Binding Required}"
                                                          IsEnabled="{Binding !SystemRequired}"
                                                          ToolTip.Tip="İşaretlenirse bu firmadaki tüm kullanıcılar için alan doldurulmadan kayıt yapılamaz."/>
                                                <SelectableTextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="Helper" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
