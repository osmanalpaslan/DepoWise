<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
             x:Class="DepoWise.Desktop.Views.StockMovementsView"
             x:DataType="vm:StockMovementsViewModel">
    <!-- Stok Hareketleri — ayrı ekran (kullanıcı isteği 2026-08-05): tarih aralığı + metin araması. Salt-okunur. -->
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <!-- Filtre satırı -->
        <Border Grid.Row="0" Classes="Panel" Padding="14,12">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ctrl:FormField Label="Başlangıç" Width="160">
                    <DatePicker Classes="Field" SelectedDate="{Binding FromDate}"/>
                </ctrl:FormField>
                <ctrl:FormField Label="Bitiş" Width="160">
                    <DatePicker Classes="Field" SelectedDate="{Binding ToDate}"/>
                </ctrl:FormField>
                <ctrl:FormField Label="Ara (kod, malzeme, not, belge no)" Width="280">
                    <TextBox Classes="Search" Text="{Binding Search}" PlaceholderText="Ara...">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                </ctrl:FormField>
                <!-- STK-10b-4: LOKASYON filtresi (web'de vardı, masaüstünde yoktu — parite eksiği).
                     "🌐 Tüm Şubeler" = filtre yok · "📦 Atanmamış" = lokasyonu bilinmeyen hareketler
                     (gerçek bir depo DEĞİLDİR). Filtre SUNUCU/SQL tarafında, LIMIT'ten önce uygulanır. -->
                <ctrl:FormField Label="Depo / Şantiye" Width="200">
                    <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MovementLocationPick">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ctrl:FormField>
                <Button Classes="Primary" Content="Filtrele" Command="{Binding LoadCommand}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                <Button Classes="Secondary" Content="Temizle" Command="{Binding ClearCommand}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            </StackPanel>
        </Border>

        <!-- Hareket tablosu -->
        <Border Grid.Row="1" Classes="Table" Margin="0,16,0,0" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
            <DockPanel>
                <Border Classes="TableHeader" DockPanel.Dock="Top">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,*,Auto">
                        <SelectableTextBlock Grid.Column="0" Text="TARİH" MinWidth="130"/>
                        <SelectableTextBlock Grid.Column="1" Text="TİP" MinWidth="90"/>
                        <SelectableTextBlock Grid.Column="2" Text="KOD" MinWidth="90"/>
                        <SelectableTextBlock Grid.Column="3" Text="MALZEME" MinWidth="160"/>
                        <SelectableTextBlock Grid.Column="4" Text="YÖN" MinWidth="60"/>
                        <SelectableTextBlock Grid.Column="5" Text="MİKTAR" MinWidth="100"/>
                        <SelectableTextBlock Grid.Column="6" Text="BİRİM" MinWidth="70"/>
                        <SelectableTextBlock Grid.Column="7" Text="DEPO / ŞANTİYE" MinWidth="150"/>
                        <SelectableTextBlock Grid.Column="8" Text="NOT / BELGE" MinWidth="120"/>
                        <SelectableTextBlock Grid.Column="9" Text="DURUM" MinWidth="90"/>
                    </Grid>
                </Border>
                <ListBox Classes="Table" ItemsSource="{Binding Movements}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:StockMovementRow">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,*,Auto">
                                <SelectableTextBlock Grid.Column="0" Text="{Binding DateText}" MinWidth="130" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <SelectableTextBlock Grid.Column="1" Text="{Binding TypeText}" MinWidth="90" VerticalAlignment="Center"/>
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Code}" MinWidth="90" VerticalAlignment="Center"/>
                                <SelectableTextBlock Grid.Column="3" Text="{Binding Name}" MinWidth="160" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <SelectableTextBlock Grid.Column="4" Text="{Binding DirectionText}" MinWidth="60" VerticalAlignment="Center"/>
                                <SelectableTextBlock Grid.Column="5" Text="{Binding QtyText}" MinWidth="100" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <SelectableTextBlock Grid.Column="6" Text="{Binding Unit}" MinWidth="70" VerticalAlignment="Center"/>
                                <SelectableTextBlock Grid.Column="7" Text="{Binding LocationFlowText}" MinWidth="150" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <SelectableTextBlock Grid.Column="8" Text="{Binding NoteText}" MinWidth="120" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <SelectableTextBlock Grid.Column="9" Text="{Binding StatusText}" MinWidth="90" VerticalAlignment="Center" Classes="Helper" IsVisible="{Binding IsReversed}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <SelectableTextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
