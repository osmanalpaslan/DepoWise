<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:inf="using:DepoWise.Infrastructure.Maintenance"
             xmlns:veh="using:DepoWise.Infrastructure.Vehicles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="660"
             x:Class="DepoWise.Desktop.Views.InspectionView"
             x:DataType="vm:InspectionViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Muayene / Sigorta"
                      PrimaryActionText="Yeni Kayıt" PrimaryActionCommand="{Binding NewRecordCommand}">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                <SelectableTextBlock Text="YENİ BELGE" Classes="SectionTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Araç" IsRequired="True" Width="240">
                        <AutoCompleteBox ItemsSource="{Binding Vehicles}" AsyncPopulator="{Binding VehiclePopulator}" SelectedItem="{Binding FVehicle}"
                                         MinimumPrefixLength="0" PlaceholderText="İç kod / plaka ara..."
                                         ValueMemberBinding="{Binding Display}">
                            <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="veh:VehicleListRow"><SelectableTextBlock Text="{Binding Display}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Belge Tipi" Width="160">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding DocTypeOptions}" SelectedItem="{Binding FDocType}"/>
                    </ctrl:FormField>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Son Tarih" Width="160">
                        <DatePicker Classes="Field" SelectedDate="{Binding FLastDate}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Sonraki Tarih" Width="160">
                        <DatePicker Classes="Field" SelectedDate="{Binding FNextDate}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Yer / Kurum" Width="200">
                        <TextBox Classes="Field" Text="{Binding FPlace}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Sonuç" Width="150" IsVisible="{Binding IsInspectionType}">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding ResultOptions}" SelectedItem="{Binding FResult}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Erteleme Tarihi" Width="170" IsRequired="True" IsVisible="{Binding IsPostponed}">
                        <DatePicker Classes="Field" SelectedDate="{Binding FPostponeDate}"/>
                    </ctrl:FormField>
                </StackPanel>
                <ctrl:FormField Label="Açıklama">
                    <TextBox Classes="Field" Text="{Binding FNote}" AcceptsReturn="True" Height="44"/>
                </ctrl:FormField>
                <SelectableTextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding CancelAddCommand}"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="2" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,*,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="ARAÇ" MinWidth="150"/>
                            <SelectableTextBlock Grid.Column="1" Text="BELGE" MinWidth="100"/>
                            <SelectableTextBlock Grid.Column="2" Text="SON" MinWidth="100"/>
                            <SelectableTextBlock Grid.Column="3" Text="SONRAKİ" MinWidth="100"/>
                            <SelectableTextBlock Grid.Column="4" Text="YER" MinWidth="120"/>
                            <SelectableTextBlock Grid.Column="5" Text="DURUM" MinWidth="110"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="inf:InspectionRow">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,*,Auto">
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding VehicleText}" MinWidth="150" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding DocTypeText}" MinWidth="100" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding LastText}" MinWidth="100" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding NextText}" MinWidth="100" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="4" Text="{Binding Place}" MinWidth="120" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <SelectableTextBlock Grid.Column="5" Text="{Binding StatusText}" MinWidth="110" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Belge yok" Message="Henüz muayene/sigorta kaydı yok." IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
