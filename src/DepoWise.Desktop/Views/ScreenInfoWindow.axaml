<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DepoWise.Desktop.Views.ScreenInfoWindow"
        Width="860" Height="640" MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Ekran Bilgisi" Icon="/Assets/app-logo.ico"
        Background="{DynamicResource SurfaceBrush}">
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
        <Grid Margin="18" RowDefinitions="Auto,*,Auto">
            <SelectableTextBlock Grid.Row="0" x:Name="TitleText" Classes="PageTitle" Margin="0,0,0,12"/>
            <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="2">
                <TextBox x:Name="InfoBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Top" Background="Transparent" BorderThickness="0"/>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
                <SelectableTextBlock x:Name="CopiedText" Text="Kopyalandı ✓" Classes="Helper" VerticalAlignment="Center" IsVisible="False"/>
                <Button x:Name="CopyBtn" Classes="Secondary" >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconDailyActivity}"/>
                        <TextBlock Text="Tümünü Kopyala" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CloseBtn" Classes="Primary" Content="Kapat" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
