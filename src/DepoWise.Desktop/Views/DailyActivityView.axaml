<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:local="using:DepoWise.Desktop"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:org="using:DepoWise.Infrastructure.Organization"
             xmlns:veh="using:DepoWise.Infrastructure.Vehicles"
             xmlns:op="using:DepoWise.Infrastructure.Operations"
             xmlns:inf="using:DepoWise.Infrastructure.Maintenance"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="DepoWise.Desktop.Views.DailyActivityView"
             xmlns:conv="using:DepoWise.Desktop.Converters"
             x:DataType="vm:DailyActivityViewModel">

    <UserControl.Resources>
        <conv:FormUstSiniriConverter x:Key="FormUstSiniri"/>
    </UserControl.Resources>

    <!-- Sayfalama tablonun ALTINDA (sol) — kullanıcı isteği 2026-07-19 (tüm tablolu ekranlar). Tablo Row 2 (*),
         sayfalama Row 3 (Auto), durum Row 4. -->
    <Grid x:Name="KokYerlesim" Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Günlük Faaliyet"
                      PrimaryActionText="Yeni Kayıt Oluştur" PrimaryActionCommand="{Binding NewRecordCommand}"/>

        <!-- ⭐ DÜZELTME (kullanıcı bildirimi 2026-09-06): FAZ 4.9 filtreleri Toolbar'ın İÇİNE
             konmuştu. Toolbar tek satırlık bir grid (başlık · arama · filtre · birincil düğme);
             filtreler büyüyünce satır taştı ve "Yeni Kayıt Oluştur" düğmesi görünür alanın DIŞINDA
             kaldı — kullanıcı yeni kayıt açamadı. Filtreler artık başlığın ALTINDA kendi satırında ve
             WrapPanel içinde: dar ekranda alt satıra sarar, hiçbir şeyi ekran dışına itmez. -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,12,0,0" Padding="12,10">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                <!-- ⭐ FAZ 4.9 (kullanıcı isteği 2026-09-06): TARİH ARALIĞI + ÇOKLU ARAÇ.
                     Tarih aralığı servis tarafında zaten destekleniyordu; ekranda alanı yoktu.
                     Ağır sorgu "Filtrele"ye basılmadan çalışmaz; tablo üstündeki kolon filtreleri
                     bu aralığın İÇİNDE çalışmaya devam eder. -->
                <SelectableTextBlock Text="Tarih:" Classes="Caption" VerticalAlignment="Center"/>
                <ctrl:TarihKutusu SelectedDate="{Binding GunBaslangic}" Width="145"/>
                <SelectableTextBlock Text="—" Classes="Caption" VerticalAlignment="Center"/>
                <ctrl:TarihKutusu SelectedDate="{Binding GunBitis}" Width="145"/>
                <Button Classes="Primary" Content="Tarihe Göre Getir" Command="{Binding TarihUygulaCommand}"
                        ToolTip.Tip="Seçilen tarih aralığındaki faaliyetleri getirir (bitiş günü dahildir). Seçili araç varsa yalnız o araçlar listelenir."/>
                <Button Classes="Secondary" Content="Tarihi Temizle" Command="{Binding TarihTemizleCommand}"/>

                <!-- Çoklu araç: seçim aramada korunur; boş bırakılırsa tüm araçlar gelir. -->
                <ComboBox Width="200" PlaceholderText="Araç seç (çoklu)"
                          ToolTip.Tip="Birden fazla araç seçebilirsiniz. Hiçbiri seçili değilse tüm araçlar listelenir.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AracSecim">
                            <CheckBox Content="{Binding Etiket}" IsChecked="{Binding Secili}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemsSource>
                        <Binding Path="AracSecenekleri"/>
                    </ComboBox.ItemsSource>
                </ComboBox>
                <SelectableTextBlock Text="{Binding SeciliAracSayisi, StringFormat='{}{0} araç seçili'}"
                                     Classes="Caption" VerticalAlignment="Center"
                                     IsVisible="{Binding AracSecimiVar}"/>

                <CheckBox Content="İptal edilenleri göster" IsChecked="{Binding ShowCancelled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <SelectableTextBlock Text="Sayfa boyutu:" Classes="Caption" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize, Mode=TwoWay}" Width="80"/>
                <Button Classes="Primary" Content="Filtrele" Command="{Binding ApplyFiltersCommand}"/>
                <Button Classes="Secondary" Content="Temizle" Command="{Binding ClearFiltersCommand}"/>
                <!-- 2. tur madde 5 (2026-10-29): seyrek işlemler (Excel, Yazdır) "•••" menüsünde + satır sağ tık menüsünde — çubuk sade -->
                <Button Classes="Secondary" Content="•••" Padding="12,8" AutomationProperties.Name="Diğer işlemler" ToolTip.Tip="Diğer işlemler">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Excel'e Aktar" Command="{Binding ExportExcelCommand}" IsEnabled="{Binding !IsExporting}" ToolTip.Tip="Aktif filtrelerle eşleşen TÜM faaliyetleri (yalnız bu sayfayı değil) Excel dosyası olarak indirir"/>
                            <MenuItem Header="Yazdır" Command="{Binding YazdirCommand}" IsEnabled="{Binding !IsExporting}" ToolTip.Tip="Ekrandaki filtrelenmiş listeyi PDF olarak kaydeder (imzalı çıktı için)."/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!-- ⭐ 2026-09-06 (kullanıcı isteği): YAZDIR. Excel ile aynı veriyi PDF üretir;
                     başlıkta firma/şube/kullanıcı/tarih, altta sayısal kolonların toplamı olur. -->
                </WrapPanel>
        </Border>



        <!-- ⭐ 2026-10-25: düzenlenemeyen kayıt için UYARI BANDI (nedenini söyler) -->
        <ctrl:InfoBar Grid.Row="2" Kind="Warning" Title="Kayıt düzenlenemez" Message="{Binding DuzenlemeUyarisi}" VerticalAlignment="Top" Margin="0,16,0,0"
                      IsVisible="{Binding DuzenlemeUyarisi, Converter={x:Static ObjectConverters.IsNotNull}}"/>

        <!-- İş #5: metadata düzenleme paneli — yalnız yan etkisiz alanlar. -->
        <Border Grid.Row="2" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowMetaEdit}">
            <StackPanel Spacing="10" MaxWidth="620" HorizontalAlignment="Left">
                <SelectableTextBlock Text="FAALİYET KAYDINI DÜZENLE" Classes="SectionTitle"/>
                <SelectableTextBlock Classes="Helper"
                    Text="Yalnız açıklama, operatör ve süre düzeltilebilir. Stok veya araç durumu değişecekse kaydı iptal edip yeniden girin."/>
                <ctrl:FormField Label="Açıklama">
                    <TextBox Classes="Field" Text="{Binding MetaDescription}"/>
                </ctrl:FormField>
                <ctrl:FormField Label="Operatör / Şoför">
                    <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding Personnel}" SelectedItem="{Binding MetaOperator}"
                                    PlaceholderText="Personel seç / ara..."/>
                </ctrl:FormField>
                <ctrl:FormField Label="Süre (gün)">
                    <NumericUpDown Classes="Field" Value="{Binding MetaDuration}" Minimum="0" FormatString="0"/>
                </ctrl:FormField>
                <SelectableTextBlock Classes="Error" Text="{Binding MetaError}"
                                     IsVisible="{Binding MetaError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="Ghost" Content="Vazgeç" Command="{Binding CancelMetaEditCommand}"/>   <!-- M-61 (K-10): İptal … Kaydet — birincil en sağda -->
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveMetaEditCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tek form — Kayıt Tipi'ne göre alanlar değişir -->
        <Border Background="{DynamicResource AppBackgroundBrush}" BorderThickness="0" Grid.Row="2" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowForm}">
            <!-- 2026-10-12: form yüksekliği SABİT piksel değil — ekran yüksekliğinin oranı (FormListeOrani, Depo Giriş ile aynı);
                 büyük ekranda form büyür, sığmazsa kendi içinde kayar, altta liste görünür kalır. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="{Binding #KokYerlesim.Bounds.Height, Converter={StaticResource FormUstSiniri}}">
            <StackPanel Spacing="14" MaxWidth="860" HorizontalAlignment="Left">
                <SelectableTextBlock Text="{Binding FormBaslik}" Classes="IosBaslik"/>
                <SelectableTextBlock Text="Faaliyet" Classes="IosFormBaslik"/>
                <Border Classes="IosFormGrup"><StackPanel Spacing="12">
                    <!-- ⭐ 2026-10-25 tam düzenleme: araç devri kaydında kilitli alan notu -->
                    <ctrl:InfoBar Kind="Warning" Message="{Binding KilitliAlanNotu}"
                                  IsVisible="{Binding KilitliAlanNotu, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                        <ctrl:FormField Label="Kayıt Tipi" Width="160">
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding FormKind}"
                                      IsEnabled="{Binding TurSecilebilir}" ToolTip.Tip="Düzeltmede kayıt tipi değişmez (tip değişecekse kaydı iptal edip yeniden girin)."/>
                        </ctrl:FormField>
                        <!-- Araç: Depo Çıkışı'nda OPSİYONEL (malzeme çıkışı aracsız da olabilir), diğerlerinde zorunlu. -->
                        <ctrl:FormField Label="Araç" IsRequired="{Binding !IsStockExit}" Width="240">
                            <ctrl:LookupBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding FormVehicle}"
                                            DisplayMember="Display" PlaceholderText="İç kod / plaka seç / ara..."
                                            IsEnabled="{Binding AracSecilebilir}"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Tarih" Width="150">
                            <ctrl:TarihKutusu SelectedDate="{Binding FormDate}"/>
                        </ctrl:FormField>
                    </WrapPanel>

                    <!-- ===== HAREKET / TRANSFER ===== -->
                    <StackPanel Spacing="14" IsVisible="{Binding IsMovement}">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                            <!-- "+" seçim standardı (kullanıcı isteği 2026-08-06, madde 5): arama-yazılabilir seçici. -->
                            <ctrl:FormField Label="Kaynak Şube / Şantiye" Width="220">
                                <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}" SelectedItem="{Binding FormFrom}"
                                                PlaceholderText="Şube / şantiye seç / ara..."/>
                            </ctrl:FormField>
                            <ctrl:FormField Label="Hedef Şube / Şantiye" Width="220">
                                <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}" SelectedItem="{Binding FormTo}"
                                                PlaceholderText="Şube / şantiye seç / ara..."/>
                            </ctrl:FormField>
                            <ctrl:FormField Label="Operatör / Şoför" Width="200">
                                <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding Personnel}" SelectedItem="{Binding FormOperator}"
                                          PlaceholderText="Personel seç / ara..."/>
                            </ctrl:FormField>
                            <ctrl:FormField Label="Süre (gün)" Width="120">
                                <NumericUpDown Classes="Field" Value="{Binding FormDuration}" Minimum="0" FormatString="0" ShowButtonSpinner="False"/>
                            </ctrl:FormField>
                        </WrapPanel>
                        <SelectableTextBlock Text="Transfer: araç otomatik PASİF duruma alınır." Classes="Helper" IsVisible="{Binding IsTransfer}"/>
                    </StackPanel>

                    <!-- ===== BAKIM (+ İlave Yağ/İlave Filtre/Tamir — kullanıcı isteği 2026-07-19: AYNI alanlar,
                         yalnız Bakım Tanımı/Alt Bakım bu 3 yeni türde YOK) ===== -->
                    <StackPanel Spacing="14" IsVisible="{Binding IsMaintenance}">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsRealMaintenance}">
                                <ctrl:FormField Label="Bakım Tanımı" IsRequired="True" Width="220">
                                    <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding MaintDefs}" SelectedItem="{Binding MDef}"
                                                    PlaceholderText="Bakım tanımı seç / ara..."/>
                                </ctrl:FormField>
                                <ctrl:FormField Label="Alt Bakım" Width="240">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ctrl:LookupBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding MaintSubDefs}" SelectedItem="{Binding MSubDef}"
                                                            PlaceholderText="Alt bakım seç / ara..."/>
                                            <Button AutomationProperties.Name="Yeni alt bakım" Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0" ToolTip.Tip="Yeni alt bakım" Command="{Binding StartAddSubCommand}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingSub}">
                                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewSubName}" PlaceholderText="Yeni alt bakım adı"/>
                                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddSubCommand}"/>
                                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddSubCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </ctrl:FormField>
                            </StackPanel>
                            <ctrl:FormField Label="Teknisyen" Width="200">
                                <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding Personnel}" SelectedItem="{Binding MTechnician}"
                                          PlaceholderText="Personel seç / ara..."/>
                            </ctrl:FormField>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                            <!-- 2026-10-04: TEK sayaç alanı — türü seçilen aracın sayacı; Bakımda zorunlu. -->
                            <ctrl:FormField Label="{Binding MMeterLabel}" HelpText="{Binding MMeterHint}" Width="170">
                                <NumericUpDown Classes="Field" Value="{Binding MMeter}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"
                                               IsEnabled="{Binding MMeterEnabled}"/>
                            </ctrl:FormField>
                        </WrapPanel>
                        <!-- BKM-04 / KARAR-9: malzemenin çekildiği depo. Varsayılan oturum şubesi, kullanıcı
                             değiştirebilir. "Atanmamış" seçenek olarak sunulmaz. Liste yereldendir (çevrimdışı). -->
                        <ctrl:FormField HorizontalAlignment="Left" Label="Malzemenin çekildiği depo" Width="280"
                                        HelpText="Stok bu depodan düşülür. Varsayılan, giriş yaptığınız şubedir."
                                        IsVisible="{Binding !MntHasNoLocation}">
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Branches}" SelectedItem="{Binding MntLocation}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="org:BranchRow"><TextBlock Text="{Binding Name}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ctrl:FormField>
                        <SelectableTextBlock IsVisible="{Binding MntHasNoLocation}" TextWrapping="Wrap" Classes="Helper"
                                             Foreground="{DynamicResource WarningBrush}"
                                             Text="Firmanızda tanımlı depo/şantiye yok. Kayıt yine de oluşturulur; malzemeler &quot;Atanmamış&quot; olarak düşülür."/>

                        <ctrl:FormField Label="Malzemeler (stoktan düşülür)">
                            <StackPanel Spacing="6">
                                <SelectableTextBlock Text="{Binding MntLocationText, StringFormat='Düşülecek depo: {0}'}"
                                                     Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Classes="Search" Text="{Binding MntMaterialSearch}" PlaceholderText="Malzeme ara (kod/ad)"/>
                                <Border Classes="Table" MaxHeight="110" IsVisible="{Binding MntMaterialResults.Count}">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding MntMaterialResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:MaterialRefRow">
                                                    <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Display}"
                                                            Command="{Binding $parent[ItemsControl].((vm:DailyActivityViewModel)DataContext).AddMntMaterialCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <ItemsControl ItemsSource="{Binding MntLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MntMaterialLine">
                                            <!-- Bakım ekranıyla AYNI davranış (kullanıcı isteği 2026-08-08): işaretliyse
                                                 malzeme kayda girer + maliyete dâhil olur, merkez depodan düşülmez. -->
                                            <StackPanel Spacing="2" Margin="0,2">
                                                <Grid ColumnDefinitions="*,120,Auto">
                                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Display}" Classes="Body" VerticalAlignment="Center"/>
                                                    <NumericUpDown Grid.Column="1" Classes="Field" Value="{Binding Quantity}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                                                    <Button Grid.Column="2" Classes="Ghost" Content="Kaldır" Margin="6,0,0,0"
                                                            Command="{Binding $parent[ItemsControl].((vm:DailyActivityViewModel)DataContext).RemoveMntLineCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                                <CheckBox Content="Bakım Ekibi Stoğundan Kullanıldı" IsChecked="{Binding FromTeamStock, Mode=TwoWay}"
                                                          ToolTip.Tip="İşaretlenirse merkez depo stoklarından düşülmez."/>
                                                <SelectableTextBlock Text="İşaretlenirse merkez depo stoklarından düşülmez."
                                                                     Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ctrl:FormField>
                    </StackPanel>

                    <!-- ===== DEPO ÇIKIŞI (MALZEME) — Giriş-Çıkış ile AYNI ortak servis (kullanıcı isteği 2026-08-07) ===== -->
                    <StackPanel Spacing="14" IsVisible="{Binding IsStockExit}">
                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="12">
                            <ctrl:FormField Label="Çıkış Türü" Width="150">
                                <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding ExitScopeOptions}" SelectedItem="{Binding ExitScope}"/>
                            </ctrl:FormField>
                            <ctrl:FormField Label="Çıkacak Miktar" IsRequired="True" Width="140">
                                <NumericUpDown Classes="Field" Value="{Binding ExitQuantity}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                            </ctrl:FormField>
                            <ctrl:FormField Label="Hedef Şube / Şantiye" IsRequired="True" Width="200" IsVisible="{Binding ShowExitTargetBranch}">
                                <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}" SelectedItem="{Binding ExitToBranch}"
                                                PlaceholderText="Şube seç / ara..."/>
                            </ctrl:FormField>
                            <ctrl:FormField Label="Teslim Alan (Personel)" Width="220" IsVisible="{Binding ShowExitPersonnel}">
                                <ctrl:LookupBox HorizontalAlignment="Stretch" ItemsSource="{Binding Personnel}" SelectedItem="{Binding ExitPersonnel}"
                                          PlaceholderText="Personel seç / ara..."/>
                            </ctrl:FormField>
                        </WrapPanel>
                        <ctrl:FormField Label="Malzeme" IsRequired="True">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Classes="Search" Text="{Binding ExitMaterialSearch}" PlaceholderText="Malzeme ara (kod/ad)"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding ExitBalanceText}" Classes="Helper" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <Border Classes="Table" MaxHeight="130" IsVisible="{Binding ExitMaterialResults.Count}">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding ExitMaterialResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:MaterialRefRow">
                                                    <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Content="{Binding Display}"
                                                            Command="{Binding $parent[ItemsControl].((vm:DailyActivityViewModel)DataContext).PickExitMaterialCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ctrl:FormField>
                    </StackPanel>

                    <ctrl:FormField Label="{Binding DescriptionLabel}">
                        <TextBox Classes="Field" Text="{Binding FormDescription}" AcceptsReturn="True" Height="44"/>
                    </ctrl:FormField>
                </StackPanel></Border>
                <SelectableTextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding CancelFormCommand}"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Numaralı sayfalama + kayıt bilgisi — EN SOLDA, tablonun ÜSTÜNDE (kullanıcı isteği 2026-07-18/19). -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasRows}">
                <Button AutomationProperties.Name="Önceki sayfa" Classes="Secondary" Content="‹" Padding="10,4"
                        Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}"/>
                <ItemsControl ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Padding="10,4"
                                    Classes="Secondary"
                                    Command="{Binding $parent[ItemsControl].((vm:DailyActivityViewModel)DataContext).GoToPageCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button AutomationProperties.Name="Sonraki sayfa" Classes="Secondary" Content="›" Padding="10,4"
                        Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
            </StackPanel>
        </StackPanel>

        <!-- Liste -->
        <Panel Grid.Row="3" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DockPanel HorizontalAlignment="Left" Classes="Modern">
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ctrl:ColumnRules.Enabled="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:SortHeader Grid.Column="0" Text="TARİH" ColumnKey="date" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=date}"/>
                            <local:SortHeader Grid.Column="1" Text="KAYIT TİPİ" ColumnKey="type" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=type}"/>
                            <local:SortHeader Grid.Column="2" Text="ARAÇ" ColumnKey="vehicle" MinWidth="150"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=vehicle}"/>
                            <local:SortHeader Grid.Column="3" Text="ROTA" ColumnKey="route" MinWidth="170"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=route}"/>
                            <local:SortHeader Grid.Column="4" Text="PERSONEL" ColumnKey="operator" MinWidth="130"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=operator}"/>
                            <local:SortHeader Grid.Column="5" Text="SÜRE" ColumnKey="duration" MinWidth="80"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=duration}"/>
                            <local:SortHeader Grid.Column="6" Text="MALZEME MİKTARI" ColumnKey="materialQty" MinWidth="110"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=materialQty}"/>
                            <!-- 2026-09-30 (kullanıcı isteği): KULLANILAN MALZEMELER — ayrı ayrı "Ad (Kod) Miktar Birim". -->
                            <local:SortHeader Grid.Column="7" Text="KULLANILAN MALZEMELER" ColumnKey="materials" MinWidth="260"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=materials}"/>
                            <local:SortHeader Grid.Column="8" Text="AÇIKLAMA" ColumnKey="description" MinWidth="160"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=description}"/>
                            <SelectableTextBlock Grid.Column="9" Text="" MinWidth="70" MaxWidth="70"/>
                        </Grid>
                    </Border>
                    <!-- Başlık-altı filtre satırı (kullanıcı isteği 2026-08-06, madde 4) — bkz. MaterialsView.axaml
                         aynı yorum. Kolon 0 (TARİH) bilinçli olarak filtresiz (yalnız başlığa tıklayarak sıralanır);
                         kolon 7 (Sil butonu) filtrelenemez. -->
                    <Border Classes="TableFilterRow" DockPanel.Dock="Top">
                        <Grid ctrl:ColumnRules.Enabled="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Kolon 0 (TARİH) filtresizdir ama YER TUTMALIDIR: aksi halde filtre satırı diğer iki
                                 satırla hizalanmaz (2026-08-08). Boş ama tarih kolonu genişliğine sabitlenmiş kutu. -->
                            <Border Grid.Column="0" Margin="4,0" Background="Transparent"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=date}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=date}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=date}"/>
                            <ContentControl Grid.Column="1" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=type}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=type}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=type}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=type}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:DailyActivityViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="2" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=vehicle}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=vehicle}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=vehicle}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=vehicle}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:DailyActivityViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="3" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=route}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=route}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=route}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=route}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:DailyActivityViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="4" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=operator}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=operator}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=operator}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=operator}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:DailyActivityViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="5" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=duration}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=duration}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=duration}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=duration}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:DailyActivityViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="6" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=materialQty}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=materialQty}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=materialQty}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=materialQty}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:DailyActivityViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="7" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=materials}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=materials}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=materials}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=materials}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:DailyActivityViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="8" Padding="0,0,8,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=description}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=description}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=description}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=description}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <ctrl:HucreFiltre ApplyCommand="{Binding $parent[ContentControl].((vm:DailyActivityViewModel)DataContext).ApplyFiltersCommand}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="op:DailyActivityGridRow">
                                <Grid ctrl:ColumnRules.Enabled="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Kolon 0,1,2,4,5,6: Min=Max ile ColWidths'e SIKI bağlı (kullanıcı isteği 2026-08-06,
                                         madde 1-3) — bkz. MaterialsView.axaml aynı yorum. Kolon 3 (ROTA) "*" (esnek), dokunulmadı. -->
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding DateText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                               MinWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=date}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=date}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=date}"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding TypeText}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=type}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=type}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=type}"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding VehicleText}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=vehicle}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=vehicle}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VehicleText}"
                                               IsVisible="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=vehicle}"/>
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding RouteText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                               MinWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=route}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=route}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RouteText}"
                                               IsVisible="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=route}"/>
                                    <SelectableTextBlock Grid.Column="4" Text="{Binding OperatorText, Converter={x:Static local:Conv.Atanmadi}}" Opacity="{Binding OperatorText, Converter={x:Static local:Conv.AtanmadiOpacity}}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=operator}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=operator}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OperatorText}"
                                               IsVisible="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=operator}"/>
                                    <SelectableTextBlock Grid.Column="5" Text="{Binding DurationText}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=duration}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=duration}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=duration}"/>
                                    <SelectableTextBlock Grid.Column="6" Text="{Binding MaterialQtyText}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=materialQty}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=materialQty}"
                                               IsVisible="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=materialQty}"/>
                                    <SelectableTextBlock Grid.Column="7" Text="{Binding MaterialsText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               MinWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=materials}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=materials}"
                                               ToolTip.Tip="{Binding MaterialsText}"
                                               IsVisible="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=materials}"/>
                                    <SelectableTextBlock Grid.Column="8" Text="{Binding DescriptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               MinWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=description}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=description}"
                                               ToolTip.Tip="{Binding DescriptionText}"
                                               IsVisible="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=description}"/>
                                    <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- İş #5: yalnız YAN ETKİSİZ alanlar (açıklama/operatör/süre).
                                             Stok veya araç durumu değişecekse "İptal Et" + yeniden giriş. -->
                                        <!-- ⭐ 2026-10-25: TAM düzenleme (malzeme/miktar/sayaç dahil); sorunlu kayıtta uyarı bandı -->
                                        <Button Classes="Ghost" Content="Düzenle" MinWidth="70"
                                                Command="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).BeginEditCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="Ghost" Content="İptal Et" MinWidth="80"
                                                Command="{Binding $parent[ListBox].((vm:DailyActivityViewModel)DataContext).DeleteActivityCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
              </ScrollViewer>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel ActionText="Yeni Kayıt Oluştur" ActionCommand="{Binding NewRecordCommand}" Mode="Empty" Title="Faaliyet yok" Message="Filtre kriterine uygun faaliyet bulunamadı." IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="5" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
