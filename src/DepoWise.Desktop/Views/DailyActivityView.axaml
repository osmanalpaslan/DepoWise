<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:org="using:DepoWise.Infrastructure.Organization"
             xmlns:veh="using:DepoWise.Infrastructure.Vehicles"
             xmlns:op="using:DepoWise.Infrastructure.Operations"
             xmlns:inf="using:DepoWise.Infrastructure.Maintenance"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="DepoWise.Desktop.Views.DailyActivityView"
             x:DataType="vm:DailyActivityViewModel">

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24" RowDefinitions="Auto,Auto,*,Auto">
        <ctrl:Toolbar Grid.Row="0" Title="Günlük Faaliyet"
                      PrimaryActionText="Yeni Kayıt Oluştur" PrimaryActionCommand="{Binding NewRecordCommand}">
            <ctrl:Toolbar.FilterContent>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox Classes="Field" Width="160" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"/>
                    <DatePicker Classes="Field" SelectedDate="{Binding FilterDate}" ToolTip.Tip="Gün filtresi"/>
                    <Button Classes="Secondary" Content="Yenile" Command="{Binding LoadCommand}"/>
                </StackPanel>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- Tek form — Kayıt Tipi'ne göre alanlar değişir -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowForm}">
            <ScrollViewer MaxHeight="440">
            <StackPanel Spacing="14" MaxWidth="860" HorizontalAlignment="Left">
                <SelectableTextBlock Text="YENİ KAYIT" Classes="SectionTitle"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Kayıt Tipi" Width="160">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding FormKind}"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Araç" IsRequired="True" Width="240">
                        <AutoCompleteBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding FormVehicle}"
                                         FilterMode="Contains" MinimumPrefixLength="0" PlaceholderText="İç kod / plaka ara..."
                                         ValueMemberBinding="{Binding Display}">
                            <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="veh:VehicleListRow"><SelectableTextBlock Text="{Binding Display}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Tarih" Width="160">
                        <DatePicker Classes="Field" SelectedDate="{Binding FormDate}"/>
                    </ctrl:FormField>
                </StackPanel>

                <!-- ===== HAREKET / TRANSFER ===== -->
                <StackPanel Spacing="14" IsVisible="{Binding IsMovement}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ctrl:FormField Label="Kaynak Şube / Şantiye" Width="220">
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}" SelectedItem="{Binding FormFrom}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="org:BranchRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Hedef Şube / Şantiye" Width="220">
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Branches}" SelectedItem="{Binding FormTo}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="org:BranchRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Operatör / Şoför" Width="200">
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Personnel}" SelectedItem="{Binding FormOperator}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Süre (gün)" Width="120">
                            <NumericUpDown Classes="Field" Value="{Binding FormDuration}" Minimum="0" FormatString="0" ShowButtonSpinner="False"/>
                        </ctrl:FormField>
                    </StackPanel>
                    <SelectableTextBlock Text="Transfer: araç otomatik PASİF duruma alınır." Classes="Helper" IsVisible="{Binding IsTransfer}"/>
                </StackPanel>

                <!-- ===== BAKIM (+ İlave Yağ/İlave Filtre/Tamir — kullanıcı isteği 2026-07-19: AYNI alanlar,
                     yalnız Bakım Tanımı/Alt Bakım bu 3 yeni türde YOK) ===== -->
                <StackPanel Spacing="14" IsVisible="{Binding IsMaintenance}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsRealMaintenance}">
                            <ctrl:FormField Label="Bakım Tanımı" IsRequired="True" Width="220">
                                <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding MaintDefs}" SelectedItem="{Binding MDef}">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="inf:MaintenanceDefinitionRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </ctrl:FormField>
                            <ctrl:FormField Label="Alt Bakım" Width="240">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding MaintSubDefs}" SelectedItem="{Binding MSubDef}">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="inf:MaintenanceDefinitionRow"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0" ToolTip.Tip="Yeni alt bakım" Command="{Binding StartAddSubCommand}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingSub}">
                                        <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewSubName}" PlaceholderText="Yeni alt bakım adı"/>
                                        <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddSubCommand}"/>
                                        <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddSubCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </ctrl:FormField>
                        </StackPanel>
                        <ctrl:FormField Label="Teknisyen" Width="200">
                            <ComboBox Classes="Field" HorizontalAlignment="Stretch" ItemsSource="{Binding Personnel}" SelectedItem="{Binding MTechnician}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </ctrl:FormField>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ctrl:FormField Label="Yapılma KM" Width="140">
                            <NumericUpDown Classes="Field" Value="{Binding MKm}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                        </ctrl:FormField>
                        <ctrl:FormField Label="Yapılma Saat" Width="140">
                            <NumericUpDown Classes="Field" Value="{Binding MHour}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                        </ctrl:FormField>
                    </StackPanel>
                    <ctrl:FormField Label="Malzemeler (stoktan düşülür)">
                        <StackPanel Spacing="6">
                            <TextBox Classes="Search" Text="{Binding MntMaterialSearch}" PlaceholderText="Malzeme ara (kod/ad)"/>
                            <Border Classes="Table" MaxHeight="110" IsVisible="{Binding MntMaterialResults.Count}">
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding MntMaterialResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:MaterialRefRow">
                                                <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding Name}"
                                                        Command="{Binding $parent[ItemsControl].((vm:DailyActivityViewModel)DataContext).AddMntMaterialCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <ItemsControl ItemsSource="{Binding MntLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MntMaterialLine">
                                        <Grid ColumnDefinitions="*,120,Auto" Margin="0,2">
                                            <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" Classes="Body" VerticalAlignment="Center"/>
                                            <NumericUpDown Grid.Column="1" Classes="Field" Value="{Binding Quantity}" Minimum="0" FormatString="0.##" ShowButtonSpinner="False"/>
                                            <Button Grid.Column="2" Classes="Ghost" Content="Kaldır" Margin="6,0,0,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:DailyActivityViewModel)DataContext).RemoveMntLineCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctrl:FormField>
                </StackPanel>

                <ctrl:FormField Label="Açıklama">
                    <TextBox Classes="Field" Text="{Binding FormDescription}" AcceptsReturn="True" Height="44"/>
                </ctrl:FormField>
                <SelectableTextBlock Text="{Binding FormError}" Classes="Body" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding CancelFormCommand}"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Liste -->
        <Panel Grid.Row="2" Margin="0,16,0,0">
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="Auto,Auto,*,*,Auto,Auto,*,Auto">
                            <SelectableTextBlock Grid.Column="0" Text="TARİH" MinWidth="100"/>
                            <SelectableTextBlock Grid.Column="1" Text="TİP" MinWidth="90"/>
                            <SelectableTextBlock Grid.Column="2" Text="ARAÇ" MinWidth="140"/>
                            <SelectableTextBlock Grid.Column="3" Text="GÜZERGAH" MinWidth="160"/>
                            <SelectableTextBlock Grid.Column="4" Text="OPERATÖR" MinWidth="120"/>
                            <SelectableTextBlock Grid.Column="5" Text="SÜRE" MinWidth="70"/>
                            <SelectableTextBlock Grid.Column="6" Text="AÇIKLAMA" MinWidth="120"/>
                            <SelectableTextBlock Grid.Column="7" Text="" MinWidth="70"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="op:DailyActivityListRow">
                                <Grid ColumnDefinitions="Auto,Auto,*,*,Auto,Auto,*,Auto">
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding DateText}" MinWidth="100" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding TypeText}" MinWidth="90" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding VehicleText}" MinWidth="140" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding RouteText}" MinWidth="160" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <SelectableTextBlock Grid.Column="4" Text="{Binding OperatorText}" MinWidth="120" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="5" Text="{Binding DurationText}" MinWidth="70" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="6" Text="{Binding DescriptionText}" MinWidth="120" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="7" Classes="Ghost" Content="Sil" MinWidth="70" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:DailyActivityViewModel)DataContext).DeleteActivityCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ctrl:StatePanel Mode="Error" Title="Yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}" IsVisible="{Binding HasError}"/>
            <ctrl:StatePanel Mode="Empty" Title="Faaliyet yok" Message="Henüz günlük faaliyet kaydı yok." IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <SelectableTextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
