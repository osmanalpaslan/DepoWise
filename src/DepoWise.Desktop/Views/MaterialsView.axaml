<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:local="using:DepoWise.Desktop"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
             x:Class="DepoWise.Desktop.Views.MaterialsView"
             x:DataType="vm:MaterialsViewModel">

    <!-- Sayfalama tablonun ALTINDA (sol en altta) — kullanıcı isteği 2026-07-19 (tüm tablolu ekranlar).
         Tablo Row 3 (*), sayfalama Row 4 (Auto, en alt). -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <!-- ===== Toolbar: başlık + kolon ayarla + sayfa boyutu + Yeni Malzeme ===== -->
        <ctrl:Toolbar Grid.Row="0" Title="Malzemeler"
                      PrimaryActionText="{Binding AddButtonText}"
                      PrimaryActionCommand="{Binding ToggleAddCommand}">
            <ctrl:Toolbar.FilterContent>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !ShowAdd}">
                    <Button Classes="Secondary" Content="Kolonları Ayarla" Command="{Binding OpenColumnPickerCommand}"/>
                    <SelectableTextBlock Text="Sayfa boyutu:" Classes="Caption" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize, Mode=TwoWay}" Width="80"/>
                    <Button Classes="Primary" Content="Filtrele" Command="{Binding ApplyFiltersCommand}"/>
                    <Button Classes="Secondary" Content="Temizle" Command="{Binding ClearFiltersCommand}"/>
                    <Button Classes="Secondary" Content="Excel'e Aktar" Command="{Binding ExportExcelCommand}" IsEnabled="{Binding !IsExporting}"
                            ToolTip.Tip="Aktif filtrelerle eşleşen TÜM malzemeleri (yalnız bu sayfayı değil) Excel dosyası olarak indirir"/>
                </StackPanel>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>


        <!-- ===== Yeni Kayıt formu (gruplu) ===== -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}"/>
                <KeyBinding Gesture="Escape" Command="{Binding ClearCommand}"/>
            </Border.KeyBindings>
            <ScrollViewer MaxHeight="470">
            <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
                <SelectableTextBlock Text="{Binding FormTitle}" Classes="SectionTitle"/>

                <!-- Malzeme şablonu kaldırıldı (kullanıcı isteği 2026-08-05): malzemelerde şablon kullanılmıyor. -->

                <!-- Grup 1: Tanım -->
                <SelectableTextBlock Text="Tanım" Classes="CardLabel"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Kod" IsRequired="True" Width="170"
                                    HasError="{Binding HasCodeError}" ErrorText="{Binding CodeError}">
                        <TextBox Classes="Field" Text="{Binding NewCode}" TabIndex="0"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Ad" IsRequired="True" Width="300"
                                    HasError="{Binding HasNameError}" ErrorText="{Binding NameError}">
                        <TextBox Classes="Field" Text="{Binding NewName}" TabIndex="1"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Tür" Width="160">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding NewType}"/>
                    </ctrl:FormField>
                </StackPanel>

                <!-- Grup 2: Sınıflandırma (Tanımlar'dan beslenir; + ile yeni eklenir) -->
                <SelectableTextBlock Text="Sınıflandırma" Classes="CardLabel"/>

                <ctrl:FormField Label="Kategori">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <AutoCompleteBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Categories}" AsyncPopulator="{Binding CategoryPopulator}" SelectedItem="{Binding SelectedCategory}"
                                      MinimumPrefixLength="0" PlaceholderText="Kategori ara..."
                                      ValueMemberBinding="{Binding Name}">
                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                            <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0"
                                    ToolTip.Tip="Yeni kategori" Command="{Binding StartAddCategoryCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingCategory}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewCategoryName}" PlaceholderText="Yeni kategori adı"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddCategoryCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddCategoryCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Alt Kategori">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <AutoCompleteBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding SubCategories}" AsyncPopulator="{Binding SubCategoryPopulator}" SelectedItem="{Binding SelectedSubCategory}"
                                      MinimumPrefixLength="0" PlaceholderText="Alt kategori ara..."
                                      ValueMemberBinding="{Binding Name}">
                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                            <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0"
                                    ToolTip.Tip="Yeni alt kategori" Command="{Binding StartAddSubCategoryCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingSubCategory}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewSubCategoryName}" PlaceholderText="Yeni alt kategori adı"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddSubCategoryCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddSubCategoryCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Birim" IsRequired="True"
                                HasError="{Binding HasUnitError}" ErrorText="{Binding UnitError}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <AutoCompleteBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Units}" AsyncPopulator="{Binding UnitPopulator}" SelectedItem="{Binding SelectedUnit}"
                                      MinimumPrefixLength="0" PlaceholderText="Birim ara..."
                                      ValueMemberBinding="{Binding Name}">
                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                            <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0"
                                    ToolTip.Tip="Yeni birim" Command="{Binding StartAddUnitCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingUnit}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewUnitName}" PlaceholderText="Yeni birim (adet, litre...)"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddUnitCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddUnitCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Marka">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <AutoCompleteBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Brands}" AsyncPopulator="{Binding BrandPopulator}" SelectedItem="{Binding SelectedBrand}"
                                      MinimumPrefixLength="0" PlaceholderText="Marka ara..."
                                      ValueMemberBinding="{Binding Name}">
                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                            <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0"
                                    ToolTip.Tip="Yeni marka" Command="{Binding StartAddBrandCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingBrand}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewBrandName}" PlaceholderText="Yeni marka adı"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddBrandCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddBrandCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Tedarikçi">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <AutoCompleteBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Suppliers}" AsyncPopulator="{Binding SupplierPopulator}" SelectedItem="{Binding SelectedSupplier}"
                                      MinimumPrefixLength="0" PlaceholderText="Tedarikçi ara..."
                                      ValueMemberBinding="{Binding Name}">
                                <AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><SelectableTextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                            <Button Grid.Column="1" Classes="Secondary" Content="+" IsVisible="{Binding CanAddLookup}" Width="40" Margin="8,0,0,0"
                                    ToolTip.Tip="Yeni tedarikçi" Command="{Binding StartAddSupplierCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingSupplier}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewSupplierName}" PlaceholderText="Yeni tedarikçi adı"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddSupplierCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddSupplierCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <!-- Grup: İlişkiler (uyumlu araç + muadil) -->
                <SelectableTextBlock Text="İlişkiler" Classes="CardLabel"/>
                <ctrl:FormField Label="Uyumlu Araçlar" HelpText="Bu malzemenin takıldığı araçlar (çoklu seçim).">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Classes="Search" Text="{Binding VehicleSearch}" PlaceholderText="Araç ara (kod/plaka)"/>
                            <Button Grid.Column="1" Classes="Secondary" Content="Tümünü Seç" Margin="8,0,0,0" Command="{Binding SelectAllVehiclesCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Temizle" Margin="6,0,0,0" Command="{Binding ClearVehiclesCommand}"/>
                        </Grid>
                        <Border Classes="Table" MaxHeight="160">
                            <ListBox ItemsSource="{Binding FilteredVehiclePicks}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VehiclePick">
                                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Display}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Muadil Malzeme" HelpText="Mevcut malzemelerden ara/ekle (çoklu); boş arama=tümü.">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Classes="Search" Text="{Binding EquivalentSearch}" PlaceholderText="Kod/ad ara (boş=tümü)"/>
                            <Button Grid.Column="1" Classes="Secondary" Content="Tümünü Seç" Margin="8,0,0,0" Command="{Binding SelectAllEquivalentsCommand}"/>
                        </Grid>
                        <Border Classes="Table" MaxHeight="160">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding EquivalentResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MaterialRow">
                                            <Button Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Content="{Binding Name}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MaterialsViewModel)DataContext).AddEquivalentPickCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ChosenEquivalents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MaterialRow">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" Classes="Body" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="Ghost" Content="Kaldır"
                                                Command="{Binding $parent[ItemsControl].((vm:MaterialsViewModel)DataContext).RemoveEquivalentPickCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctrl:FormField>

                <!-- Fotoğraflar -->
                <SelectableTextBlock Text="Fotoğraflar" Classes="CardLabel"/>
                <StackPanel Spacing="8">
                    <Button Classes="Secondary" Content="Foto Ekle" HorizontalAlignment="Left"
                            Command="{Binding AddPhotosCommand}"/>
                    <ItemsControl ItemsSource="{Binding Photos}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhotoStage">
                                <Border Margin="0,0,8,8" Width="84" Height="84" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource SurfaceElevatedBrush}">
                                    <Panel>
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                        <Button Classes="Icon" Content="×" Width="24" Height="24"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Command="{Binding $parent[ItemsControl].((vm:MaterialsViewModel)DataContext).RemovePhotoCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Grup 3: Fiyat & Stok -->
                <SelectableTextBlock Text="Fiyat &amp; Stok" Classes="CardLabel"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Birim Fiyat (TRY)" Width="160">
                        <NumericUpDown Classes="Field" Value="{Binding NewUnitPrice}" Minimum="0"
                                       FormatString="0.##" ShowButtonSpinner="False" TabIndex="2"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Min Stok" Width="150" HelpText="Düşük stok eşiği.">
                        <NumericUpDown Classes="Field" Value="{Binding NewMinStock}" Minimum="0"
                                       FormatString="0.##" ShowButtonSpinner="False" TabIndex="3"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Açılış Stok" Width="150" HelpText="0 dışında ise stok hareketi (eksi olabilir)." IsVisible="{Binding !IsEditMode}">
                        <NumericUpDown Classes="Field" Value="{Binding NewOpeningStock}"
                                       FormatString="0.##" ShowButtonSpinner="False" TabIndex="4"/>
                    </ctrl:FormField>
                </StackPanel>

                <ctrl:FormField Label="Açıklama">
                    <TextBox Classes="Field" Text="{Binding NewDescription}" AcceptsReturn="True" Height="56"/>
                </ctrl:FormField>

                <!-- Eylemler -->
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding ClearCommand}" TabIndex="6"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding AddCommand}" TabIndex="5"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Numaralı sayfalama + kayıt bilgisi — EN SOLDA, tablonun ÜSTÜNDE (kullanıcı isteği 2026-07-18). -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding !ShowAdd}">
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasRows}">
                <Button Classes="Secondary" Content="‹" Padding="10,4"
                        Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}"/>
                <ItemsControl ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Padding="10,4"
                                    Classes="Secondary"
                                    Command="{Binding $parent[ItemsControl].((vm:MaterialsViewModel)DataContext).GoToPageCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="Secondary" Content="›" Padding="10,4"
                        Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
            </StackPanel>
            <SelectableTextBlock Text="{Binding Status}"
                       Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ===== Liste + Detay ===== -->
        <Grid Grid.Row="3" Margin="0,16,0,0" ColumnDefinitions="*,360" IsVisible="{Binding !ShowAdd}">
          <Panel Grid.Column="0">
            <!-- Tablo (satır varsa) — Excel-benzeri: pencere küçülünce taşma/kayma OLMAZ; sığmazsa yatay
                 kaydırma çıkar (kullanıcı isteği 2026-07-18, madde 3). -->
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DockPanel HorizontalAlignment="Left">
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c6"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c7"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c8"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c9"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c10"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c11"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c12"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c13"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c14"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c15"/>
                            </Grid.ColumnDefinitions>
                            <local:SortHeader Grid.Column="0" Text="KOD" ColumnKey="code" MinWidth="90"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=code}"/>
                            <local:SortHeader Grid.Column="1" Text="AD" ColumnKey="name" MinWidth="140"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=name}"/>
                            <local:SortHeader Grid.Column="2" Text="TÜR" ColumnKey="type" MinWidth="90"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=type}"/>
                            <local:SortHeader Grid.Column="3" Text="KATEGORİ" ColumnKey="category" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=category}"/>
                            <local:SortHeader Grid.Column="4" Text="BİRİM" ColumnKey="unit" MinWidth="80"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=unit}"/>
                            <local:SortHeader Grid.Column="5" Text="MARKA" ColumnKey="brand" MinWidth="90"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=brand}"/>
                            <local:SortHeader Grid.Column="6" Text="TEDARİKÇİ" ColumnKey="supplier" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=supplier}"/>
                            <local:SortHeader Grid.Column="7" Text="BİRİM FİYAT" ColumnKey="unitPrice" MinWidth="100"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=unitPrice}"/>
                            <local:SortHeader Grid.Column="8" Text="PARA" ColumnKey="currency" MinWidth="56"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=currency}"/>
                            <local:SortHeader Grid.Column="9" Text="MİN STOK" ColumnKey="minStock" MinWidth="84"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=minStock}"/>
                            <local:SortHeader Grid.Column="10" Text="STOK" ColumnKey="stock" MinWidth="72"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=stock}"/>
                            <local:SortHeader Grid.Column="11" Text="DURUM" ColumnKey="status" MinWidth="104"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=status}"/>
                            <local:SortHeader Grid.Column="12" Text="AÇIKLAMA" ColumnKey="description" MinWidth="140"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=description}"/>
                            <local:SortHeader Grid.Column="13" Text="UYUMLU ARAÇLAR" ColumnKey="compatibleVehicles" MinWidth="140"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=compatibleVehicles}"/>
                            <local:SortHeader Grid.Column="14" Text="MUADİL MALZEME" ColumnKey="equivalents" MinWidth="140"
                                       IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=equivalents}"/>
                        </Grid>
                    </Border>
                    <!-- Başlık-altı filtre satırı (kullanıcı isteği 2026-08-06, madde 4): her kolonun TAM ALTINDA
                         kendi filtre kutusu — header ile AYNI SharedSizeGroup'ta, ColWidths'ten Min=Max okur.
                         ContentControl+DataTemplate: hücrenin DataContext'i o kolonun ColumnFilterItem nesnesi
                         (Text=Value TwoWay); dış Min/Max/IsVisible ise ContentControl'ün KENDİ DataContext'i
                         (VM) üzerinden okunur — iki kapsam KARIŞMAZ (derlenmiş bağlama güvenli kalır). -->
                    <Border Classes="TableHeader" Padding="0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c6"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c7"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c8"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c9"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c10"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c11"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c12"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c13"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c14"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c15"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="0" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=code}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=code}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=code}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=code}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="1" Margin="4,0" HorizontalContentAlignment="Stretch"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=name}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=name}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="2" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=type}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=type}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=type}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=type}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="3" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=category}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=category}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=category}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=category}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="4" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=unit}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=unit}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=unit}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=unit}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="5" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=brand}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=brand}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=brand}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=brand}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="6" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=supplier}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=supplier}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=supplier}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=supplier}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="7" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=unitPrice}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=unitPrice}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=unitPrice}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=unitPrice}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="8" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=currency}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=currency}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=currency}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=currency}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="9" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=minStock}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=minStock}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=minStock}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=minStock}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="10" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=stock}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=stock}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=stock}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=stock}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="11" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=status}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=status}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=status}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=status}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="12" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=description}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=description}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=description}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=description}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="13" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=compatibleVehicles}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=compatibleVehicles}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=compatibleVehicles}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=compatibleVehicles}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <ContentControl Grid.Column="14" Margin="4,0" HorizontalContentAlignment="Stretch"
                                MinWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=equivalents}"
                                MaxWidth="{Binding ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=equivalents}"
                                IsVisible="{Binding VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=equivalents}"
                                Content="{Binding FilterFieldsByKey, Converter={x:Static local:Conv.FilterItem}, ConverterParameter=equivalents}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ColumnFilterItem">
                                        <TextBox Classes="Search" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Label}" ToolTip.Tip="{Binding Hint}">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[ContentControl].((vm:MaterialsViewModel)DataContext).ApplyFiltersCommand}"/></TextBox.KeyBindings>
                                        </TextBox>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </Border>
                    <!-- Tek tık = detay paneli (SelectedItem). Çift tık = ayrı Düzelt/Kaydet/Sil penceresi. -->
                    <ListBox Classes="Table" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                             DoubleTapped="OnRowDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MaterialRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c6"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c7"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c8"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c9"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c10"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c11"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c12"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c13"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c14"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c15"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Kolon 2-15: Min=Max ile ColWidths'e SIKI bağlı (kullanıcı isteği 2026-08-06, madde 1-3) —
                                         header'ın sürükleyerek ayarladığı genişlik satır hücrelerini de ANINDA sınırlar; böylece
                                         (a) sütun tekrar küçültülebilir (uzun içerik artık genişliği zorlayamaz), (b) TextTrimming
                                         gerçekten devreye girer (taşma olmaz). Önceden yalnız statik MinWidth vardı; tavan yoktu. -->
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Code}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=code}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=code}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Code}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=code}"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" MinWidth="140" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=name}"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding TypeDisplay}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=type}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=type}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TypeDisplay}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=type}"/>
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding Category}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=category}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=category}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Category}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=category}"/>
                                    <SelectableTextBlock Grid.Column="4" Text="{Binding Unit}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=unit}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=unit}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Unit}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=unit}"/>
                                    <SelectableTextBlock Grid.Column="5" Text="{Binding Brand}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=brand}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=brand}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Brand}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=brand}"/>
                                    <SelectableTextBlock Grid.Column="6" Text="{Binding Supplier}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=supplier}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=supplier}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Supplier}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=supplier}"/>
                                    <SelectableTextBlock Grid.Column="7" Text="{Binding UnitPrice}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=unitPrice}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=unitPrice}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=unitPrice}"/>
                                    <SelectableTextBlock Grid.Column="8" Text="{Binding Currency}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=currency}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=currency}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=currency}"/>
                                    <SelectableTextBlock Grid.Column="9" Text="{Binding MinStock}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=minStock}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=minStock}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=minStock}"/>
                                    <SelectableTextBlock Grid.Column="10" Text="{Binding Stock}" VerticalAlignment="Center" FontWeight="SemiBold"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=stock}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=stock}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=stock}"/>
                                    <ctrl:StatusBadge Grid.Column="11" VerticalAlignment="Center"
                                                      MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=status}"
                                                      MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=status}"
                                                      Kind="{Binding StockKind}" Text="{Binding StockDisplay}"
                                                      IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=status}"/>
                                    <SelectableTextBlock Grid.Column="12" Text="{Binding Description}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=description}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=description}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=description}"/>
                                    <SelectableTextBlock Grid.Column="13" Text="{Binding CompatibleVehicles}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=compatibleVehicles}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=compatibleVehicles}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CompatibleVehicles}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=compatibleVehicles}"/>
                                    <SelectableTextBlock Grid.Column="14" Text="{Binding Equivalents}" VerticalAlignment="Center"
                                               MinWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=equivalents}"
                                               MaxWidth="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).ColWidths, Converter={x:Static local:Conv.ColWidth}, ConverterParameter=equivalents}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Equivalents}"
                                               IsVisible="{Binding $parent[ListBox].((vm:MaterialsViewModel)DataContext).VisibleColumns, Converter={x:Static local:Conv.ColumnVisible}, ConverterParameter=equivalents}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
              </ScrollViewer>
            </Border>

            <!-- Hata -->
            <ctrl:StatePanel Mode="Error" Title="Liste yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}"
                             IsVisible="{Binding HasError}"/>
            <!-- Boş -->
            <ctrl:StatePanel Mode="Empty" Title="Kayıt yok"
                             Message="Arama kriterine uygun malzeme bulunamadı."
                             IsVisible="{Binding IsEmpty}"/>
          </Panel>

          <!-- Detay (satır seçince tüm alanlar) -->
          <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding HasSelection}">
            <DockPanel>
              <!-- Eylemler (VM bağlamı) -->
              <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                <SelectableTextBlock Text="FOTOĞRAFLAR" Classes="SectionTitle"/>
                <ItemsControl ItemsSource="{Binding DetailPhotos}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetailPhoto">
                            <Panel Margin="0,0,8,8" Width="72" Height="72">
                                <Button Classes="Ghost" Padding="0" Background="Transparent" Cursor="Hand" ToolTip.Tip="Büyüt"
                                        Command="{Binding $parent[ItemsControl].((vm:MaterialsViewModel)DataContext).OpenPhotoCommand}"
                                        CommandParameter="{Binding Image}">
                                    <Border CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                    </Border>
                                </Button>
                                <Button Classes="Icon" Content="×" Width="22" Height="22"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Background="#99000000" ToolTip.Tip="Sil"
                                        IsVisible="{Binding $parent[ItemsControl].((vm:MaterialsViewModel)DataContext).CanEdit}"
                                        Command="{Binding $parent[ItemsControl].((vm:MaterialsViewModel)DataContext).DeleteDetailPhotoCommand}"
                                        CommandParameter="{Binding}"/>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel>
                  <Button Classes="Primary" Content="Düzenle" Margin="0,0,8,0"
                          Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}"/>
                  <Button Classes="Danger" Content="Sil"
                          Command="{Binding RequestDeleteCommand}" IsVisible="{Binding CanDelete}"/>
                </WrapPanel>
              </StackPanel>
              <ScrollViewer>
              <StackPanel Spacing="10" DataContext="{Binding Detail}">
                <SelectableTextBlock Text="{Binding Name}" Classes="PageTitle" TextWrapping="Wrap"/>
                <SelectableTextBlock Text="{Binding Code}" Classes="Helper"/>
                <Border Classes="Divider"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" >
                  <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Tür" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Type}" Classes="Body"/>
                  <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Kategori" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CategoryName}" Classes="Body"/>
                  <SelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Birim" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UnitName}" Classes="Body"/>
                  <SelectableTextBlock Grid.Row="3" Grid.Column="0" Text="Marka" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BrandName}" Classes="Body"/>
                  <SelectableTextBlock Grid.Row="4" Grid.Column="0" Text="Tedarikçi" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SupplierName}" Classes="Body"/>
                  <SelectableTextBlock Grid.Row="5" Grid.Column="0" Text="Min / Stok" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="5" Grid.Column="1" Classes="Body" Text="{Binding MinStock, StringFormat='{}{0} (min)'}"/>
                  <SelectableTextBlock Grid.Row="6" Grid.Column="0" Text="Birim Fiyat" Classes="Helper" Margin="0,2,12,2"/>
                  <SelectableTextBlock Grid.Row="6" Grid.Column="1" Classes="Body" Text="{Binding UnitPrice}"/>
                </Grid>

                <StackPanel Spacing="2">
                    <SelectableTextBlock Text="Mevcut Stok" Classes="Helper"/>
                    <SelectableTextBlock Text="{Binding Stock}" Classes="Metric"/>
                </StackPanel>

                <StackPanel IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Spacing="2">
                    <SelectableTextBlock Text="Açıklama" Classes="Helper"/>
                    <SelectableTextBlock Text="{Binding Description}" Classes="Body" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Classes="Divider"/>
                <SelectableTextBlock Text="MUADİLLER" Classes="SectionTitle"/>
                <ItemsControl ItemsSource="{Binding Equivalents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:MaterialRefRow">
                            <Button Classes="Ghost" Padding="4,2" Margin="0,1" HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left" Cursor="Hand"
                                    ToolTip.Tip="Malzeme detayını aç"
                                    Content="{Binding Name, StringFormat='• {0}'}"
                                    Command="{Binding $parent[UserControl].((vm:MaterialsViewModel)DataContext).OpenMaterialCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <SelectableTextBlock Text="UYUMLU ARAÇLAR" Classes="SectionTitle"/>
                <ItemsControl ItemsSource="{Binding CompatibleVehicles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:MaterialRefRow">
                            <Button Classes="Ghost" Padding="4,2" Margin="0,1" HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left" Cursor="Hand"
                                    ToolTip.Tip="Araç ekranında aç"
                                    Content="{Binding Code, StringFormat='• {0}'}"
                                    Command="{Binding $parent[UserControl].((vm:MaterialsViewModel)DataContext).OpenVehicleCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- İşlem Geçmişi (madde 4, kullanıcı isteği 2026-08-06): TÜM stok hareketleri, kronolojik.
                     Çift tık → salt-okunur detay + "Kaydı Görüntüle" (madde 5). -->
                <SelectableTextBlock Text="İŞLEM GEÇMİŞİ" Classes="SectionTitle"/>
                <ListBox x:Name="HistoryList" ItemsSource="{Binding $parent[UserControl].((vm:MaterialsViewModel)DataContext).MaterialHistory}" MaxHeight="220"
                         DoubleTapped="OnHistoryDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:MaterialMovementRow">
                            <Grid ColumnDefinitions="86,*,Auto" Margin="0,2">
                                <SelectableTextBlock Grid.Column="0" Text="{Binding DateText}" Classes="Helper" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="1">
                                    <SelectableTextBlock Text="{Binding Label}" Classes="Body"/>
                                    <SelectableTextBlock Text="{Binding Reference}" Classes="Helper"
                                               IsVisible="{Binding Reference, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <SelectableTextBlock Grid.Column="2" Text="{Binding QtyText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Classes="Panel" Margin="16,0,0,0" IsVisible="{Binding !HasSelection}">
            <SelectableTextBlock Text="Detay için bir malzeme seçin." Classes="Helper"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>
    </Grid>
</UserControl>
