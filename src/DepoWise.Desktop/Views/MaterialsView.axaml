<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:m="using:DepoWise.Infrastructure.Materials"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
             x:Class="DepoWise.Desktop.Views.MaterialsView"
             x:DataType="vm:MaterialsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}" Margin="24">

        <!-- ===== Toolbar: başlık + arama + Ara + Yeni Malzeme ===== -->
        <ctrl:Toolbar Grid.Row="0" Title="Malzemeler"
                      SearchText="{Binding Search, Mode=TwoWay}"
                      SearchWatermark="Kod / ad ara..."
                      PrimaryActionText="{Binding AddButtonText}"
                      PrimaryActionCommand="{Binding ToggleAddCommand}">
            <ctrl:Toolbar.FilterContent>
                <Button Classes="Secondary" Content="Ara" Command="{Binding LoadCommand}"/>
            </ctrl:Toolbar.FilterContent>
        </ctrl:Toolbar>

        <!-- ===== Yeni Kayıt formu (gruplu) ===== -->
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" IsVisible="{Binding ShowAdd}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}"/>
                <KeyBinding Gesture="Escape" Command="{Binding ClearCommand}"/>
            </Border.KeyBindings>
            <ScrollViewer MaxHeight="470">
            <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="YENİ MALZEME" Classes="SectionTitle"/>

                <!-- Grup 1: Tanım -->
                <TextBlock Text="Tanım" Classes="CardLabel"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Kod" IsRequired="True" Width="170"
                                    HasError="{Binding HasCodeError}" ErrorText="{Binding CodeError}">
                        <TextBox Classes="Field" Text="{Binding NewCode}" TabIndex="0"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Ad" IsRequired="True" Width="300"
                                    HasError="{Binding HasNameError}" ErrorText="{Binding NameError}">
                        <TextBox Classes="Field" Text="{Binding NewName}" TabIndex="1"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Tür" Width="160">
                        <ComboBox Classes="Field" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding NewType}"/>
                    </ctrl:FormField>
                </StackPanel>

                <!-- Grup 2: Sınıflandırma (Tanımlar'dan beslenir; + ile yeni eklenir) -->
                <TextBlock Text="Sınıflandırma" Classes="CardLabel"/>

                <ctrl:FormField Label="Kategori">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Classes="Secondary" Content="+" Width="40" Margin="8,0,0,0"
                                    ToolTip.Tip="Yeni kategori" Command="{Binding StartAddCategoryCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingCategory}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewCategoryName}" PlaceholderText="Yeni kategori adı"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddCategoryCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddCategoryCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Alt Kategori">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding SubCategories}" SelectedItem="{Binding SelectedSubCategory}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Classes="Secondary" Content="+" Width="40" Margin="8,0,0,0"
                                    ToolTip.Tip="Yeni alt kategori" Command="{Binding StartAddSubCategoryCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingSubCategory}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewSubCategoryName}" PlaceholderText="Yeni alt kategori adı"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddSubCategoryCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddSubCategoryCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Birim" IsRequired="True"
                                HasError="{Binding HasUnitError}" ErrorText="{Binding UnitError}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Classes="Secondary" Content="+" Width="40" Margin="8,0,0,0"
                                    ToolTip.Tip="Yeni birim" Command="{Binding StartAddUnitCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingUnit}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewUnitName}" PlaceholderText="Yeni birim (adet, litre...)"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddUnitCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddUnitCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Marka">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Classes="Secondary" Content="+" Width="40" Margin="8,0,0,0"
                                    ToolTip.Tip="Yeni marka" Command="{Binding StartAddBrandCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingBrand}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewBrandName}" PlaceholderText="Yeni marka adı"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddBrandCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddBrandCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <ctrl:FormField Label="Tedarikçi">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0" Classes="Field" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="m:LookupItem"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Classes="Secondary" Content="+" Width="40" Margin="8,0,0,0"
                                    ToolTip.Tip="Yeni tedarikçi" Command="{Binding StartAddSupplierCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsAddingSupplier}">
                            <TextBox Grid.Column="0" Classes="Field" Text="{Binding NewSupplierName}" PlaceholderText="Yeni tedarikçi adı"/>
                            <Button Grid.Column="1" Classes="Primary" Content="Ekle" Margin="8,0,0,0" Command="{Binding ConfirmAddSupplierCommand}"/>
                            <Button Grid.Column="2" Classes="Ghost" Content="Vazgeç" Margin="6,0,0,0" Command="{Binding CancelAddSupplierCommand}"/>
                        </Grid>
                    </StackPanel>
                </ctrl:FormField>

                <!-- Grup 3: Fiyat & Stok -->
                <TextBlock Text="Fiyat &amp; Stok" Classes="CardLabel"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ctrl:FormField Label="Birim Fiyat (TRY)" Width="160">
                        <NumericUpDown Classes="Field" Value="{Binding NewUnitPrice}" Minimum="0"
                                       FormatString="0.##" ShowButtonSpinner="False" TabIndex="2"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Min Stok" Width="150" HelpText="Düşük stok eşiği.">
                        <NumericUpDown Classes="Field" Value="{Binding NewMinStock}" Minimum="0"
                                       FormatString="0.##" ShowButtonSpinner="False" TabIndex="3"/>
                    </ctrl:FormField>
                    <ctrl:FormField Label="Açılış Stok" Width="150" HelpText="&gt;0 ise stok hareketi.">
                        <NumericUpDown Classes="Field" Value="{Binding NewOpeningStock}" Minimum="0"
                                       FormatString="0.##" ShowButtonSpinner="False" TabIndex="4"/>
                    </ctrl:FormField>
                </StackPanel>

                <ctrl:FormField Label="Açıklama">
                    <TextBox Classes="Field" Text="{Binding NewDescription}" AcceptsReturn="True" Height="56"/>
                </ctrl:FormField>

                <!-- Eylemler -->
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Content="İptal" Command="{Binding ClearCommand}" TabIndex="6"/>
                    <Button Classes="Primary" Content="Kaydet" Command="{Binding AddCommand}" TabIndex="5"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== Liste / durumlar ===== -->
        <Panel Grid.Row="2" Margin="0,16,0,0">
            <!-- Tablo (satır varsa) -->
            <Border Classes="Table" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasRows}">
                <DockPanel>
                    <Border Classes="TableHeader" DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c6"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c7"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c8"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="KOD" MinWidth="90"/>
                            <TextBlock Grid.Column="1" Text="AD" MinWidth="140"/>
                            <TextBlock Grid.Column="2" Text="TÜR" MinWidth="90"/>
                            <TextBlock Grid.Column="3" Text="BİRİM FİYAT" MinWidth="100"/>
                            <TextBlock Grid.Column="4" Text="PARA" MinWidth="56"/>
                            <TextBlock Grid.Column="5" Text="MİN STOK" MinWidth="84"/>
                            <TextBlock Grid.Column="6" Text="STOK" MinWidth="72"/>
                            <TextBlock Grid.Column="7" Text="DURUM" MinWidth="104"/>
                        </Grid>
                    </Border>
                    <ListBox Classes="Table" ItemsSource="{Binding Items}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MaterialRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c6"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c7"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="c8"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Code}" MinWidth="90" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" MinWidth="140" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TypeDisplay}" MinWidth="90" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TypeDisplay}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding UnitPrice}" MinWidth="100" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Currency}" MinWidth="56" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding MinStock}" MinWidth="84" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Stock}" MinWidth="72" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ctrl:StatusBadge Grid.Column="7" MinWidth="104" VerticalAlignment="Center"
                                                      Kind="{Binding StockKind}" Text="{Binding StockText}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Hata -->
            <ctrl:StatePanel Mode="Error" Title="Liste yüklenemedi" Message="{Binding LoadError}"
                             ActionText="Tekrar Dene" ActionCommand="{Binding LoadCommand}"
                             IsVisible="{Binding HasError}"/>
            <!-- Boş -->
            <ctrl:StatePanel Mode="Empty" Title="Kayıt yok"
                             Message="Arama kriterine uygun malzeme bulunamadı."
                             IsVisible="{Binding IsEmpty}"/>
        </Panel>

        <!-- Durum satırı -->
        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0"
                   Classes="Helper" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
