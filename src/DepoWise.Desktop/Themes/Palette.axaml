<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      DepoWise tasarım sistemi — semantik RENK token'ları. Artık AÇIK + KOYU tema duyarlı
      (ThemeDictionaries). Ekranlar DynamicResource ile bu brush'ları kullanır; sabit renk yazmaz.
      Tema Ayarlar → Tema ekranından değiştirilir (RequestedThemeVariant Light/Dark).
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ============ KOYU ============ -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#12161E"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1B212C"/>
            <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#1B212C"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#282F3A"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#303743"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2E3744"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#394250"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#2F6FD5"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D7FE5"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F7FA"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB7C4"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#929DAD"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#2CBF6D"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#D8A617"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#E24A3B"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#3AA0E0"/>
            <SolidColorBrush x:Key="OverlayHoverBrush" Color="#16FFFFFF"/>
            <SolidColorBrush x:Key="OverlaySelectedBrush" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#382F6FD5"/>
            <SolidColorBrush x:Key="SelectedRowBrush" Color="#26000000"/>
        </ResourceDictionary>

        <!-- ============ AÇIK ============ -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6FA"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#F7F9FC"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDF1F7"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#D8DEE7"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#2F6FD5"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#255FC0"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B2430"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A5666"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7686"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#1F9D57"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#B4860F"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#D23B2C"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#2E86C4"/>
            <SolidColorBrush x:Key="OverlayHoverBrush" Color="#0F000000"/>
            <SolidColorBrush x:Key="OverlaySelectedBrush" Color="#18000000"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F2F6FD5"/>
            <SolidColorBrush x:Key="SelectedRowBrush" Color="#142F6FD5"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
