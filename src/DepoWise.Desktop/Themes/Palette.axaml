<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Alpnex tasarım sistemi — semantik RENK token'ları. AURORA paleti.
      Anahtar adları DEĞİŞMEDİ; yalnız değerler yenilendi. Ekranlar DynamicResource ile
      bu brush'ları kullanır, sabit renk yazmaz. Tema Ayarlar → Tema'dan değişir.

      Aurora: lacivert taban (#0D1220 ailesi) + kehribar marka aksanı. Web tarafıyla aynı dil.
      Not: AccentBrush/AccentHoverBrush/AccentSoftBrush değerlerini ThemeService.ApplyAccent
      çalışma zamanında ÜST SEVİYEDE ezer (kullanıcının seçtiği renk). Buradakiler yalnız
      ilk boyama içindir.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ============ KOYU (Aurora) ============ -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0E15"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#10141D"/>
            <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#0B0E15"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#151A25"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#1B2130"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#242B3C"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#262E40"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#F5A524"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFB547"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAEEF7"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9B1C2"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8C94A7"/>
            <!-- 2026-10-01: tablo sütun ayırıcısı — soluk yazı renginin %45 saydam hâli (kullanıcı: çizgi belirgin olsun). -->
            <SolidColorBrush x:Key="ColumnRuleBrush" Color="#737B8AA6"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#3DD47A"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#F5A623"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#FF6B61"/>   <!-- M-59: 4,03 → ≥5,29:1 (yükseltilmiş yüzeyde) -->
            <SolidColorBrush x:Key="InfoBrush" Color="#818CF8"/>     <!-- M-59: 3,59 → ≥5,38:1 -->
            <!-- ⭐ M-59 (F-061/F-125) yeni token'lar: aksan YAZISI, birincil düğme yazısı, form/tablo sınırı (≥3:1), odak halkası -->
            <SolidColorBrush x:Key="AccentTextBrush" Color="#F5B54A"/>
            <SolidColorBrush x:Key="OnAccentBrush" Color="#241703"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#66728F"/>
            <SolidColorBrush x:Key="FocusRingBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="OverlayHoverBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="OverlaySelectedBrush" Color="#20FFFFFF"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#29F5A524"/>
            <SolidColorBrush x:Key="SelectedRowBrush" Color="#24F5A524"/>

            <!-- M7 (2a) — tablo baslik bandi: kehribar yuzey. Saydamlik KULLANILMAZ: Border.Table'in zemini
                 ne olursa olsun bant her ekranda ayni gorunsun diye katmanlar duzlestirilmis haldedir.
                 Bu alti firca SABIT kehribardir; ThemeService.ApplyAccent onlari ezmez (AmberBar* ile ayni ilke) —
                 kullanicinin sectigi aksan rengi SIRALANAN kolonda ve DOLU filtrede gorunur. -->
            <LinearGradientBrush x:Key="TableHeaderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#1D2333" Offset="0"/>
                <GradientStop Color="#1A1F2D" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="TableHeaderEdgeBrush"      Color="#262E40"/>
            <SolidColorBrush x:Key="TableHeaderTextBrush"      Color="#A9B1C2"/>
            <SolidColorBrush x:Key="TableFilterRowBrush"       Color="#121620"/>
            <SolidColorBrush x:Key="CellFilterBackgroundBrush" Color="#1B2130"/>
            <SolidColorBrush x:Key="CellFilterBorderBrush"     Color="#2C3448"/>

            <!-- TRH-01: tarih alanı vurgusu. Sabit kehribar (marka) — ThemeService.ApplyAccent EZMEZ, çünkü
                 amaç "bu alan tarihtir" işaretidir, kullanıcının seçtiği aksan rengi değil. -->
            <SolidColorBrush x:Key="DateFieldBackgroundBrush" Color="#1E2436"/>
            <SolidColorBrush x:Key="DateFieldBorderBrush"     Color="#6A5220"/>

            <!-- ═══ FAZ 2 (ADR-221) — MENÜ HİYERARŞİ RENK AİLELERİ ═══
                 Aile ÜST GRUPTAN gelir, ekrana hardcode EDİLMEZ (bkz. MenuPalette).
                 Kenar menüsü zemini #0F1524 → bu tonlar 3:1 kontrast şartını sağlar
                 (MenuRenkTests kontrastı ÖLÇER, göz kararı değildir).
                 ⚠️ Marka aksanı (AccentBrush, kehribar) BİLEREK aile olarak kullanılmadı:
                 o renk "seçili" durumunu anlatır; aile rengiyle karışmamalı. -->
            <SolidColorBrush x:Key="MenuFamilyStockBrush"      Color="#2DD4BF"/>
            <SolidColorBrush x:Key="MenuFamilyOperationsBrush" Color="#60A5FA"/>
            <SolidColorBrush x:Key="MenuFamilyFinanceBrush"    Color="#4ADE80"/>
            <SolidColorBrush x:Key="MenuFamilyReportsBrush"    Color="#A78BFA"/>
            <SolidColorBrush x:Key="MenuFamilyCorporateBrush"  Color="#F472B6"/>
            <SolidColorBrush x:Key="MenuFamilySystemBrush"     Color="#FB923C"/>
            <SolidColorBrush x:Key="MenuFamilyNeutralBrush"    Color="#94A3B8"/>
        </ResourceDictionary>

        <!-- ============ AÇIK (Aurora) ============ -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2F2F7"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FAFAFC"/>
            <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#F2F2F7"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#F4F4F7"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EBEBF0"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E2E8"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#C07C0C"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#A66A08"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#14171C"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6474"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#636E7E"/>   <!-- M-59: 4,34 → ≥4,66:1 -->
            <!-- 2026-10-01: tablo sütun ayırıcısı — soluk yazı renginin %45 saydam hâli (kullanıcı: çizgi belirgin olsun). -->
            <SolidColorBrush x:Key="ColumnRuleBrush" Color="#736B7686"/>
            <!-- ⭐ M-59 (F-061): açık temada durum renkleri yazı/rozet olarak ≥4,5:1 (eski 3,10 / 3,30 / 4,60 / 5,92) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7A43"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#8A6508"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#4338CA"/>
            <SolidColorBrush x:Key="AccentTextBrush" Color="#8A5A06"/>
            <SolidColorBrush x:Key="OnAccentBrush" Color="#241703"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#7E879A"/>
            <SolidColorBrush x:Key="FocusRingBrush" Color="#14171C"/>
            <SolidColorBrush x:Key="OverlayHoverBrush" Color="#0D000000"/>
            <SolidColorBrush x:Key="OverlaySelectedBrush" Color="#16000000"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#24C07C0C"/>
            <SolidColorBrush x:Key="SelectedRowBrush" Color="#18C07C0C"/>

            <!-- M7 (2a) — tablo baslik bandi: kehribar yuzey. Saydamlik KULLANILMAZ: Border.Table'in zemini
                 ne olursa olsun bant her ekranda ayni gorunsun diye katmanlar duzlestirilmis haldedir.
                 Bu alti firca SABIT kehribardir; ThemeService.ApplyAccent onlari ezmez (AmberBar* ile ayni ilke) —
                 kullanicinin sectigi aksan rengi SIRALANAN kolonda ve DOLU filtrede gorunur. -->
            <LinearGradientBrush x:Key="TableHeaderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F7F7FA" Offset="0"/>
                <GradientStop Color="#F3F3F7" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="TableHeaderEdgeBrush"      Color="#E2E2E8"/>
            <SolidColorBrush x:Key="TableHeaderTextBrush"      Color="#5B6170"/>
            <SolidColorBrush x:Key="TableFilterRowBrush"       Color="#FAFAFC"/>
            <SolidColorBrush x:Key="CellFilterBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CellFilterBorderBrush"     Color="#DCE1EA"/>

            <!-- TRH-01: tarih alanı vurgusu. Sabit kehribar (marka) — ThemeService.ApplyAccent EZMEZ, çünkü
                 amaç "bu alan tarihtir" işaretidir, kullanıcının seçtiği aksan rengi değil. -->
            <SolidColorBrush x:Key="DateFieldBackgroundBrush" Color="#FFF8EC"/>
            <SolidColorBrush x:Key="DateFieldBorderBrush"     Color="#E0B96A"/>

            <!-- ═══ FAZ 2 (ADR-221) — MENÜ HİYERARŞİ RENK AİLELERİ (AÇIK TEMA) ═══
                 Aynı aileler, açık zeminde (#F1F3F8) okunacak koyulukta. Anahtar adları
                 koyu temayla AYNI → çizim kodu tema bilmez, yalnız aileyi bilir. -->
            <SolidColorBrush x:Key="MenuFamilyStockBrush"      Color="#0F766E"/>
            <SolidColorBrush x:Key="MenuFamilyOperationsBrush" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="MenuFamilyFinanceBrush"    Color="#15803D"/>
            <SolidColorBrush x:Key="MenuFamilyReportsBrush"    Color="#6D28D9"/>
            <SolidColorBrush x:Key="MenuFamilyCorporateBrush"  Color="#BE185D"/>
            <SolidColorBrush x:Key="MenuFamilySystemBrush"     Color="#C2410C"/>
            <SolidColorBrush x:Key="MenuFamilyNeutralBrush"    Color="#475569"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
