<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="using:DepoWise.Desktop.Controls">
    <!--
      DepoWise ortak bileşen ControlTheme'leri (Faz 5).
      Yeni TemplatedControl'ler için varsayılan tema (x:Key={x:Type ...}). Renkler tema kaynağından.
    -->

    <!-- ============ StatusBadge / Chip ============ -->
    <ControlTheme x:Key="{x:Type ctrl:StatusBadge}" TargetType="ctrl:StatusBadge">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Bg" CornerRadius="999" Padding="9,3"
                        Background="{DynamicResource SurfaceElevatedBrush}">
                    <TextBlock x:Name="PART_Text" Text="{TemplateBinding Text}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:success /template/ Border#PART_Bg"><Setter Property="Background" Value="#222CBF6D"/></Style>
        <Style Selector="^:success /template/ TextBlock#PART_Text"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></Style>
        <Style Selector="^:warning /template/ Border#PART_Bg"><Setter Property="Background" Value="#22D8A617"/></Style>
        <Style Selector="^:warning /template/ TextBlock#PART_Text"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
        <Style Selector="^:danger /template/ Border#PART_Bg"><Setter Property="Background" Value="#22E24A3B"/></Style>
        <Style Selector="^:danger /template/ TextBlock#PART_Text"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
        <Style Selector="^:info /template/ Border#PART_Bg"><Setter Property="Background" Value="#223AA0E0"/></Style>
        <Style Selector="^:info /template/ TextBlock#PART_Text"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></Style>
    </ControlTheme>

    <!-- ============ FormField ============ -->
    <ControlTheme x:Key="{x:Type ctrl:FormField}" TargetType="ctrl:FormField">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="5">
                    <!-- Etiket + zorunlu işareti -->
                    <StackPanel Orientation="Horizontal" Spacing="3"
                                IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Label}" FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="{StaticResource FontCardLabel}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="*" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold"
                                   IsVisible="{TemplateBinding IsRequired}"/>
                    </StackPanel>
                    <!-- Giriş kontrolü -->
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch"/>
                    <!-- Yardım metni (hata yokken) -->
                    <TextBlock x:Name="PART_Help" Text="{TemplateBinding HelpText}"
                               FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontHelper}"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding HelpText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <!-- Hata metni -->
                    <TextBlock x:Name="PART_Error" Text="{TemplateBinding ErrorText}"
                               FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontHelper}"
                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               IsVisible="False"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <!-- Hata durumunda: hata metni görünür, yardım gizlenir -->
        <Style Selector="^:error /template/ TextBlock#PART_Error"><Setter Property="IsVisible" Value="True"/></Style>
        <Style Selector="^:error /template/ TextBlock#PART_Help"><Setter Property="IsVisible" Value="False"/></Style>
    </ControlTheme>

    <!-- ============ SectionHeader ============ -->
    <ControlTheme x:Key="{x:Type ctrl:SectionHeader}" TargetType="ctrl:SectionHeader">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Title}" FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="{StaticResource FontPageTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{TemplateBinding Subtitle}" FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="{StaticResource FontHelper}" Foreground="{DynamicResource TextMutedBrush}"
                                   IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Actions}" VerticalContentAlignment="Center"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ============ Toolbar ============ -->
    <ControlTheme x:Key="{x:Type ctrl:Toolbar}" TargetType="ctrl:Toolbar">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- ⭐ DÜZELTME (final QA ölçümü 2026-09-06): eskiden bu şablon TEK SATIRLIK bir
                     Grid'di (*,Auto,Auto,Auto). Auto sütunlar içeriği kadar yer aldığı için pencere
                     daraldığında yıldız sütun sıfıra iniyor, kalanlar PENCERE DIŞINA taşıyordu.
                     UI Automation ile ölçüldü: 1084 px pencerede "Yeni Malzeme" 137 px, 934 px'te
                     287 px dışarıda kalıyordu — düğmeye TIKLANAMIYORDU. (Kullanıcı aynı hatayı
                     Günlük Faaliyet ekranında elle bulmuştu; kök neden buymuş.)

                     ARTIK: başlık Auto (uzunsa kısaltılır), geri kalan her şey YILDIZ sütundaki bir
                     WrapPanel'dedir. Yıldız sütun kullanılabilir genişlikle SINIRLI olduğu için
                     WrapPanel gerçekten sarar: dar pencerede araç çubuğu ikinci satıra iner,
                     hiçbir şey pencere dışına çıkmaz. Geniş pencerede görünüm AYNI kalır. -->
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="{TemplateBinding Title}" VerticalAlignment="Center"
                               MaxWidth="420" TextTrimming="CharacterEllipsis"
                               FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontPageTitle}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBox Classes="Search" Width="240" VerticalAlignment="Center"
                                 PlaceholderText="{TemplateBinding SearchWatermark}"
                                 IsVisible="{TemplateBinding ShowSearch}"
                                 Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                        <ContentPresenter Content="{TemplateBinding FilterContent}"
                                          VerticalContentAlignment="Center"/>
                        <Button Classes="Primary" VerticalAlignment="Center"
                                Content="{TemplateBinding PrimaryActionText}"
                                Command="{TemplateBinding PrimaryActionCommand}"
                                IsVisible="{TemplateBinding PrimaryActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </WrapPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ============ StatePanel (Empty / Error / Loading) ============ -->
    <ControlTheme x:Key="{x:Type ctrl:StatePanel}" TargetType="ctrl:StatePanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="360">
                    <!-- ⭐ M-60: gri daire yer tutucu yerine durum simgesi (boş · hata · çevrimdışı · yetki yok) -->
                    <!-- ⭐ iOS tasarım (2026-10-29): daha büyük, yuvarlak köşeli simge kutusu -->
                    <Border x:Name="PART_Icon" Width="64" Height="64" CornerRadius="18"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource SurfaceElevatedBrush}">
                        <PathIcon x:Name="PART_Glyph" Width="28" Height="28" Data="{DynamicResource IconInbox}"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                    </Border>
                    <!-- Yükleme göstergesi -->
                    <ProgressBar x:Name="PART_Spinner" IsIndeterminate="True" Width="180" Height="4"
                                 HorizontalAlignment="Center" IsVisible="False"
                                 Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                               FontFamily="{StaticResource AppFontFamily}" FontSize="17"
                               FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{TemplateBinding Message}" HorizontalAlignment="Center" TextAlignment="Center"
                               FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontHelper}"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <!-- ⭐ iOS tasarım (2026-10-29, madde 1): boş listede eylem ANA düğme (turuncu) — "ilk kaydı ekle" yönlendirmesi;
                         hata durumunda ("Tekrar Dene") sade düğme. Görünürlük: eylem metni varsa. -->
                    <Panel HorizontalAlignment="Center" Margin="0,4,0,0"
                           IsVisible="{TemplateBinding ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Button x:Name="PART_Action" Classes="Primary" HorizontalAlignment="Center"
                                Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"/>
                        <Button x:Name="PART_ActionSade" Classes="Secondary" HorizontalAlignment="Center" IsVisible="False"
                                Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"/>
                    </Panel>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <!-- Yükleme: ikon gizli, spinner görünür -->
        <Style Selector="^:loading /template/ Border#PART_Icon"><Setter Property="IsVisible" Value="False"/></Style>
        <Style Selector="^:loading /template/ ProgressBar#PART_Spinner"><Setter Property="IsVisible" Value="True"/></Style>
        <!-- Hata: ikon kırmızı tonu -->
        <Style Selector="^:error /template/ Border#PART_Icon"><Setter Property="Background" Value="#22E24A3B"/></Style>
        <Style Selector="^:error /template/ PathIcon#PART_Glyph">
            <Setter Property="Data" Value="{DynamicResource IconWarning}"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="^:offline /template/ PathIcon#PART_Glyph">
            <Setter Property="Data" Value="{DynamicResource IconCloudOff}"/><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style Selector="^:nopermission /template/ PathIcon#PART_Glyph"><Setter Property="Data" Value="{DynamicResource IconLock}"/></Style>
        <Style Selector="^:error /template/ Button#PART_Action, ^:offline /template/ Button#PART_Action, ^:nopermission /template/ Button#PART_Action">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^:error /template/ Button#PART_ActionSade, ^:offline /template/ Button#PART_ActionSade, ^:nopermission /template/ Button#PART_ActionSade">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </ControlTheme>

    <!-- ============ ⭐ M-60 Pager — tek sayfalama biçimi (tablonun altında, SOLDA — kullanıcı isteği 2026-07-19 "sol en altta") ============ -->
    <ControlTheme x:Key="{x:Type ctrl:Pager}" TargetType="ctrl:Pager">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" ItemSpacing="10" LineSpacing="6">
                    <TextBlock Text="{TemplateBinding Summary}" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontHelper}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="Secondary" Content="‹" Padding="10,4" AutomationProperties.Name="Önceki sayfa"
                                Command="{Binding PreviousCommand, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding CanPrevious}"/>
                        <TextBlock Text="{TemplateBinding PageText}" VerticalAlignment="Center" MinWidth="90" TextAlignment="Center"
                                   FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontBody}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" IsVisible="{Binding !ShowPageNumbers, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!-- ⭐ M-64: numaralı sayfa düğmeleri (ShowPageNumbers) — bulunulan sayfa birincil renkte -->
                        <ItemsControl ItemsSource="{TemplateBinding PageNumbers}" IsVisible="{TemplateBinding ShowPageNumbers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ctrl:Pager+SayfaNo">
                                    <Button Content="{Binding No}" Padding="10,4" MinWidth="34" Classes.Secondary="{Binding !Aktif}" Classes.Primary="{Binding Aktif}"
                                            AutomationProperties.Name="{Binding No, StringFormat='Sayfa {0}'}"
                                            Command="{Binding $parent[ctrl:Pager].GoToCommand}" CommandParameter="{Binding No}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="Secondary" Content="›" Padding="10,4" AutomationProperties.Name="Sonraki sayfa"
                                Command="{Binding NextCommand, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding CanNext}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{TemplateBinding ShowPageSize}">
                        <TextBlock Text="Sayfa boyutu" VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontHelper}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox Classes="Field" MinWidth="76" AutomationProperties.Name="Sayfa boyutu"
                                  ItemsSource="{TemplateBinding PageSizes}"
                                  SelectedItem="{Binding PageSize, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                    </StackPanel>
                </WrapPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ============ ⭐ M-65 SideSheet — kısa tanım formu sağdan açılır, liste görünür kalır ============ -->
    <ControlTheme x:Key="{x:Type ctrl:SideSheet}" TargetType="ctrl:SideSheet">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="ZIndex" Value="10"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Width="{TemplateBinding SheetWidth}" Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius16}"
                        BoxShadow="{StaticResource ShadowMd}" Padding="20">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ============ ⭐ M-60 SelectionBar — seçim varken görünen bağlamsal komut çubuğu ============ -->
    <ControlTheme x:Key="{x:Type ctrl:SelectionBar}" TargetType="ctrl:SelectionBar">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius8}" Padding="12,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{TemplateBinding Text}" VerticalAlignment="Center" Margin="0,0,14,0"
                                   FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Classes="Ghost" Content="Seçimi kaldır" VerticalAlignment="Center"
                                Command="{TemplateBinding ClearCommand}"
                                IsVisible="{TemplateBinding ClearCommand, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:has-selection"><Setter Property="IsVisible" Value="True"/></Style>
    </ControlTheme>

    <!-- ============ ⭐ M-60 InfoBar — sayfa içi bilgi / uyarı / hata / başarı bandı ============ -->
    <ControlTheme x:Key="{x:Type ctrl:InfoBar}" TargetType="ctrl:InfoBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Bg" CornerRadius="{StaticResource Radius8}" Padding="12,8" BorderThickness="1"
                        Background="#1A3AA0E0" BorderBrush="{DynamicResource InfoBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <PathIcon x:Name="PART_Glyph" Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                  Data="{DynamicResource IconInfo}" Foreground="{DynamicResource InfoBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontBody}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{TemplateBinding Message}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontBody}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="Secondary" Margin="10,0,0,0" VerticalAlignment="Center"
                                Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"
                                IsVisible="{TemplateBinding ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Button Grid.Column="3" Classes="Icon" Content="✕" Margin="6,0,0,0" VerticalAlignment="Center"
                                AutomationProperties.Name="Uyarıyı kapat" Command="{Binding CloseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                IsVisible="{TemplateBinding IsClosable}"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:success /template/ Border#PART_Bg"><Setter Property="Background" Value="#1A2CBF6D"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/></Style>
        <Style Selector="^:success /template/ PathIcon#PART_Glyph"><Setter Property="Data" Value="{DynamicResource IconCheck}"/><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></Style>
        <Style Selector="^:warning /template/ Border#PART_Bg"><Setter Property="Background" Value="#1AF5A623"/><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></Style>
        <Style Selector="^:warning /template/ PathIcon#PART_Glyph"><Setter Property="Data" Value="{DynamicResource IconWarning}"/><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
        <Style Selector="^:danger /template/ Border#PART_Bg"><Setter Property="Background" Value="#1AE24A3B"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/></Style>
        <Style Selector="^:danger /template/ PathIcon#PART_Glyph"><Setter Property="Data" Value="{DynamicResource IconWarning}"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
    </ControlTheme>
</ResourceDictionary>
