<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base">
    <!--
      Alpnex tasarım sistemi — boşluk, köşe, tipografi, elevation ölçekleri. AURORA.
      Anahtar adları DEĞİŞMEDİ. Değişenler:
        · Köşe yarıçapları büyütüldü (Aurora yumuşak köşe dili: 6/8/11/14).
        · Radius16/Radius20 EKLENDİ (büyük kart/dialog). Eskiler duruyor → hiçbir ekran bozulmaz.
        · Font: Plus Jakarta Sans öne alındı. Font DOSYASI gömülmediyse sistem Segoe UI Variable'a
          düşer ve hiçbir şey bozulmaz (aşağıdaki nota bak).
    -->

    <!-- Boşluk ölçeği (px) -->
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space20">20</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>

    <!-- Hazır padding (Thickness) -->
    <Thickness x:Key="PadCard">16</Thickness>
    <Thickness x:Key="PadPage">24</Thickness>
    <Thickness x:Key="PadTopBar">24,14</Thickness>

    <!-- Köşe yarıçapı ölçeği (Aurora: daha yumuşak) -->
    <CornerRadius x:Key="Radius4">6</CornerRadius>
    <CornerRadius x:Key="Radius6">8</CornerRadius>
    <CornerRadius x:Key="Radius8">11</CornerRadius>
    <CornerRadius x:Key="Radius12">14</CornerRadius>
    <CornerRadius x:Key="Radius16">16</CornerRadius>
    <CornerRadius x:Key="Radius20">20</CornerRadius>

    <!-- Tipografi ölçeği (font boyutları) -->
    <sys:Double x:Key="FontPageTitle">20</sys:Double>
    <sys:Double x:Key="FontSectionTitle">13</sys:Double>
    <sys:Double x:Key="FontCardLabel">12</sys:Double>
    <sys:Double x:Key="FontMetric">28</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontHelper">11</sys:Double>

    <!--
      FONT — iki seçenek:
      (A) Şu anki hâl: font dosyası GÖMÜLMEZ. "Plus Jakarta Sans" kurulu değilse sistem
          Segoe UI Variable'a düşer. Hiçbir şey bozulmaz, sadece web ile birebir aynı olmaz.
      (B) Web ile birebir aynı görünüm istiyorsan:
          1. PlusJakartaSans-*.ttf dosyalarını src/DepoWise.Desktop/Assets/Fonts/ altına koy
          2. .csproj'a  <AvaloniaResource Include="Assets/Fonts/*.ttf" />  ekle
          3. Aşağıdaki satırı şununla değiştir:
             <FontFamily x:Key="AppFontFamily">avares://DepoWise.Desktop/Assets/Fonts#Plus Jakarta Sans</FontFamily>
    -->
    <FontFamily x:Key="AppFontFamily">Plus Jakarta Sans, Segoe UI Variable, Segoe UI, Aptos, Inter, sans-serif</FontFamily>

    <!-- Elevation — Aurora daha yumuşak ve derin -->
    <media:BoxShadows x:Key="ShadowSm">0 2 6 0 #2E000000</media:BoxShadows>
    <media:BoxShadows x:Key="ShadowMd">0 8 24 0 #45000000</media:BoxShadows>
</ResourceDictionary>
