<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      ⭐ iOS TARZI PARÇALAR (2026-10-28, kullanıcı onayı — örnek sayfa: claude.ai/artifact/V2VJyFZTCZoH3RAaPjPeEw).
      Yalnız MASAÜSTÜ (web bugünkü görünümünde kalır — kullanıcı kararı). Tüm seçiciler sınıfla kapsanır (opt-in);
      sınıfsız kontroller ETKİLENMEZ. Renkler tema token'ından (DynamicResource) → koyu/açık temada birlikte değişir.
        Border.IosKart     — zemin üstündeki kart (18 köşe, ince kenar, hafif gölge)
        Border.IosGrup     — iOS "gruplu liste" kabı (14 köşe); içindeki satırları Border.IosAyrac ayırır
        Border.IkonKutu    — renkli simge kutusu (zemini kullanım yerinde verilir, simge beyaz)
        Border.Hap         — küçük yuvarlak etiket (.basari/.uyari/.tehlike/.bilgi/.notr)
        Button.Cip         — hap biçimli seçim düğmesi (.secili = dolu aksan)
        Button.IosSatir    — gruplu listede tıklanan satır (zeminsiz, üzerine gelince hafif yüzey)
        TextBlock.IosBaslik / IosUstBaslik / IosDipnot — bölüm başlığı, grup üst başlığı, grup altı açıklaması
    -->

    <Style Selector="Border.IosKart">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius16}"/>
        <Setter Property="BoxShadow" Value="{StaticResource ShadowSm}"/>
    </Style>
    <Style Selector="Border.IosGrup">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius12}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.IosAyrac">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="Margin" Value="58,0,0,0"/>
    </Style>
    <Style Selector="Border.IkonKutu">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.IkonKutu PathIcon">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.IkonKutu.buyuk">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.IkonKutu.buyuk PathIcon">
        <Setter Property="Width" Value="21"/>
        <Setter Property="Height" Value="21"/>
    </Style>

    <!-- Hap etiket: yarı saydam durum zemini + durum rengi yazı (yazı renkleri TemaKontrastTests ile ≥4,5:1) -->
    <Style Selector="Border.Hap">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="Border.Hap > TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Border.Hap.basari"><Setter Property="Background" Value="#2930D158"/></Style>
    <Style Selector="Border.Hap.basari > TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></Style>
    <Style Selector="Border.Hap.uyari"><Setter Property="Background" Value="#2EFF9F0A"/></Style>
    <Style Selector="Border.Hap.uyari > TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
    <Style Selector="Border.Hap.tehlike"><Setter Property="Background" Value="#29FF453A"/></Style>
    <Style Selector="Border.Hap.tehlike > TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
    <Style Selector="Border.Hap.bilgi"><Setter Property="Background" Value="#290A84FF"/></Style>
    <Style Selector="Border.Hap.bilgi > TextBlock"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></Style>

    <!-- Hap biçimli seçim düğmesi (ana ekran uyarı kategorileri vb.) -->
    <Style Selector="Button.Cip">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="12,6,7,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.Cip /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="999"/>
    </Style>
    <Style Selector="Button.Cip:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="Button.Cip PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.Cip Border.adet">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="Button.Cip Border.adet > TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.Cip.secili /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.Cip.secili">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>

    <!-- ⭐ Madde 4 (2026-10-29): ListBox.HapSecici — liste üstü HAZIR FİLTRE hapları. Açılır listenin (ComboBox) yerine geçer:
         aynı ItemsSource + SelectedItem/SelectedValue bağlantısı (görünüm modeli değişmez); seçenekler tek tıkla görünür.
         Görünüm Button.Cip ile aynı: seçili hap dolu aksan (Alpnex turuncu). -->
    <Style Selector="ListBox.HapSecici">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SelectionMode" Value="AlwaysSelected"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.HapSecici ListBoxItem">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBox.HapSecici ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ListBox.HapSecici ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="ListBox.HapSecici ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.HapSecici ListBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style Selector="ListBox.HapSecici ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style Selector="Button.Cip.secili PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style Selector="Button.Cip.secili TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style Selector="Button.Cip.secili Border.adet">
        <Setter Property="Background" Value="#2E000000"/>
    </Style>

    <!-- Gruplu listede tıklanan satır / kutucuk -->
    <Style Selector="Button.IosSatir">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.IosSatir:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource OverlayHoverBrush}"/>
    </Style>
    <Style Selector="Button.IosSatir:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource OverlaySelectedBrush}"/>
    </Style>
    <!-- Kart biçimli tıklanabilir düğme (hızlı işlem kutucuğu, KPI kartı): içerik Border.IosKart -->
    <Style Selector="Button.IosKartDugme">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.IosKartDugme:pointerover /template/ ContentPresenter, Button.IosKartDugme:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.IosKartDugme:pointerover Border.IosKart">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    </Style>

    <!-- Kart başı yuvarlak eylem düğmesi (iOS kişi kartı gibi): üstte yumuşak aksan daire + simge, altta etiket -->
    <Style Selector="Button.IosEylem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,4"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.IosEylem:pointerover /template/ ContentPresenter, Button.IosEylem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.IosEylem Border">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.IosEylem:pointerover Border">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.IosEylem PathIcon">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.IosEylem:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style Selector="Button.IosEylem TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.IosEylem:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- İlerleme çubuğu (bakım / muayene / sigorta): 8 px yuvarlak, iz rengi sessiz -->
    <Style Selector="ProgressBar.IosCubuk">
        <Setter Property="Height" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="TextBlock.BakimSag">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.BakimSag.gecikti">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Kart içi sekmeler: büyük Fluent başlıkları yerine küçük hap sekmeler (seçili = dolu yüzey) -->
    <Style Selector="TabControl.IosSekme TabItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TabControl.IosSekme TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource OverlayHoverBrush}"/>
    </Style>
    <Style Selector="TabControl.IosSekme TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="TabControl.IosSekme TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TabControl.IosSekme TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Form grubu (iOS ayarlar listesi gibi): zeminden ayrışan yuvarlak kutu; üstünde küçük sessiz başlık -->
    <Style Selector="Border.IosFormGrup">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius12}"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style Selector=":is(TextBlock).IosFormBaslik">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.3"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="6,6,0,-6"/>
    </Style>
    <!-- Kontrol listesi işareti: tamam = yeşil dolu daire + tik, eksik = turuncu halka, isteğe bağlı = sessiz halka -->
    <Style Selector="Panel.KontrolIsaret">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Panel.KontrolIsaret > Border">
        <Setter Property="CornerRadius" Value="11"/>
    </Style>
    <Style Selector="Panel.KontrolIsaret > Border.tamam">
        <Setter Property="Background" Value="#30D158"/>
    </Style>
    <Style Selector="Panel.KontrolIsaret > Border.tamam PathIcon">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Panel.KontrolIsaret > Border.eksik">
        <Setter Property="BorderBrush" Value="#FF9F0A"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Panel.KontrolIsaret > Border.istege">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <!-- Üst çubuk hapı (eşitleme durumu, bildirim, ekran araçları): firma/şube kutusuyla aynı yükseklik ve dil -->
    <Style Selector="Button.UstHap">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="19"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.UstHap /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="19"/>
    </Style>
    <Style Selector="Button.UstHap:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    </Style>

    <!-- Sol menü altındaki kullanıcı kartı -->
    <Style Selector="Button.KullaniciKarti">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.KullaniciKarti /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Button.KullaniciKarti:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    </Style>

    <!-- Kayıt kartı kapak fotoğrafı düğmesi (zeminsiz; üzerine gelince hafif büyür) -->
    <Style Selector="Button.KapakFoto">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.KapakFoto:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.04)"/>
    </Style>
    <Style Selector="Button.KapakFoto:pointerover /template/ ContentPresenter, Button.KapakFoto:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Yenile: yazı yerine simgeli kare düğme (iOS gibi sade; F5 kısayolu aynı işi yapar) -->
    <Style Selector="Button.YenileDugme">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.YenileDugme PathIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- Açılır bölüm (Expander.IosAcilir): iOS gruplu kart; başlık kalın, ok sağda. Fluent'in başlık/içerik fırçaları token'a bağlanır. -->
    <Style Selector="Expander.IosAcilir">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Expander.IosAcilir /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Expander.IosAcilir /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>

    <!-- Detay kartlarında kayıt başlığı iOS "büyük başlık" gibi: daha iri ve kalın (tüm liste ekranlarının sağ kartı) -->
    <Style Selector="Border.Panel :is(TextBlock).PageTitle">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="LetterSpacing" Value="-0.4"/>
    </Style>

    <!-- Ekran düzeyi sekmeler (Zimmet, Stok Sayımı, Giriş-Çıkış): büyük Fluent çizgili başlık yerine hap sekme (seçili = dolu yüzey) -->
    <Style Selector="TabControl.EkranSekme > TabItem">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="0,0,6,8"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TabControl.EkranSekme > TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource OverlayHoverBrush}"/>
    </Style>
    <Style Selector="TabControl.EkranSekme > TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="TabControl.EkranSekme > TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TabControl.EkranSekme > TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Tipografi -->
    <Style Selector=":is(TextBlock).IosBaslik">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="-0.2"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).IosUstBaslik">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="16,0,0,8"/>
    </Style>
    <Style Selector=":is(TextBlock).IosDipnot">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="16,8,16,0"/>
    </Style>
    <!-- KPI kartı alt yazısı: sessiz; .uyari = dikkat isteyen durum (düşük stok, gecikmiş iş emri) -->
    <Style Selector="TextBlock.KpiAlt">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.KpiAlt.uyari">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).IosBuyukSayi">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="LetterSpacing" Value="-0.6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ═══ 2. TUR MADDE 2 (2026-10-29, kullanıcı isteği): iOS ALANLAR — tüm ekranlar ═══
         Alan: 44 px, 12 köşe, DOLGULU zemin, durgunken çerçevesiz (iOS); üzerine gelince zemin açılır, odakta turuncu çerçeve,
         hata kırmızı. Tarih alanının kehribar vurgusu (TRH-01, kullanıcı isteği) KORUNUR — yalnız ölçü/köşe uyar.
         Açılır liste öğeleri ŞEFFAF ("arkada renk ya da seçim kutusu olmasın"): üzerine gelince hafif turuncu ton + 3 px kayma
         (120 ms); seçili = turuncu yazı + sağda ✓. Liste kabı 14 köşeli kart. Bu blok Components.axaml'dan SONRA yüklenir. -->
    <Style Selector="TextBox.Field, ComboBox.Field, NumericUpDown.Field, DatePicker.Field">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="TextBox.Field">
        <Setter Property="Padding" Value="13,11"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.Field /template/ Border#PART_BorderElement">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    </Style>
    <Style Selector="TextBox.Field:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="TextBox.Field:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    </Style>
    <Style Selector="TextBox.Field.error /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="TextBox.Field:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    </Style>

    <Style Selector="ComboBox.Field">
        <Setter Property="Padding" Value="13,10"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox.Field /template/ Border#Background">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox.Field:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="ComboBox.Field:focus /template/ Border#Background, ComboBox.Field:dropdownopen /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="NumericUpDown.Field">
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="NumericUpDown.Field /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="NumericUpDown.Field:focus-within /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.LookupField">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="13,10"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.12"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.LookupField:pointerover">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>

    <!-- Açılır liste KABI (ComboBox açılır listesi + aramalı seçim kutusu) -->
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <Style Selector="Border.dw-lookup-popup">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>

    <!-- Açılır liste ÖĞESİ (tüm ComboBox'lar): şeffaf; şablon yalnız sağa ✓ eklemek için (içerik sunucusu aynı adla kalır) -->
    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="translateX(0px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="IosOgeArka" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <PathIcon Name="IosTik" DockPanel.Dock="Right" Width="12" Height="12" Margin="10,0,0,0" IsVisible="False"
                                  Data="{DynamicResource IconCheck}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <ContentPresenter Name="PART_ContentPresenter" Background="Transparent"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <!-- Fluent seçili/üzerine gelme/basılı/odak durumlarında İÇERİK SUNUCUSUNA zemin verir (yazının arkasında mavi kutu) →
         her durumda açıkça şeffaf; ton yalnız öğe kabında (IosOgeArka). -->
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:focus /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="RenderTransform" Value="translateX(3px)"/>
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ PathIcon#IosTik">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Aramalı seçim kutusu (LookupBox) listesi: aynı dil -->
    <Style Selector="ListBox.IosSecimListesi">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.IosSecimListesi ListBoxItem">
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="translateX(0px)"/>
        <Setter Property="Transitions">
            <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.IosSecimListesi ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.12"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.IosSecimListesi ListBoxItem:pointerover">
        <Setter Property="RenderTransform" Value="translateX(3px)"/>
    </Style>
    <Style Selector="ListBox.IosSecimListesi ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>

    <!-- ⭐ Madde 5 (2026-10-29): YUMUŞAK GEÇİŞLER — skill alpnex-arayuz-hareket: hareket yalnız "tıklamam işledi mi?" sorusuna
         cevap; 120 ms ease-out (vurgu süresi), yalnız RenderTransform/fırça (düzen yeniden hesaplanmaz). Tablo/liste SATIRLARINA ve
         ekran geçişine hareket YOK (büyük listede kekemelik). Basılınca iOS'taki gibi hafif küçülme; bırakınca geri döner. -->
    <Style Selector="Button.Cip /template/ ContentPresenter, Button.IosSatir /template/ ContentPresenter, Button.IosKartDugme /template/ ContentPresenter, Button.IosEylem /template/ ContentPresenter, ListBox.HapSecici ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="TabControl.EkranSekme > TabItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Cip, Button.IosEylem, Button.IosKartDugme, ListBox.HapSecici ListBoxItem, Button.Primary, Button.Secondary">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.Cip:pressed, Button.IosEylem:pressed, ListBox.HapSecici ListBoxItem:pressed, Button.Primary:pressed, Button.Secondary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>
    <Style Selector="Button.IosKartDugme:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <!-- ⭐ Madde 2 (2026-10-29): "İşlem tamam" bildirimi iOS kartı — tema yüzeyi, yuvarlak köşe, renkli üst şerit YOK;
         içerik (yeşil onay kutusu + başlık + mesaj) MainWindow.BildirimIcerik'te. Kartın kapanma animasyonu Fluent temasında kalır. -->
    <Style Selector="NotificationCard.IosBildirim">
        <Setter Property="Width" Value="340"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius16}"/>
    </Style>
    <Style Selector="NotificationCard.IosBildirim /template/ Panel#PART_HeaderBar">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.IosBildirimIcerik">
        <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style Selector="Border.IosBildirimIcerik TextBlock.Baslik">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Border.IosBildirimIcerik TextBlock.Mesaj">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- ═══ 2. TUR MADDE 5 (2026-10-29, kullanıcı isteği): iOS MENÜLER — sağ tık, "•••" ve tüm açılır menüler ═══
         Kart: yüzey rengi, 14 köşe, ince kenar, 6 px iç boşluk. Öğe: 8 köşe, rahat satır; üzerine gelince hafif turuncu ton
         (120 ms). Ayırıcı ince çizgi. Silme/iptal öğeleri (MenuItem.tehlike) kırmızı. -->
    <Style Selector="ContextMenu, MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="MinWidth" Value="220"/>
    </Style>
    <Style Selector="ContextMenu MenuItem, MenuFlyoutPresenter MenuItem">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ContextMenu MenuItem /template/ Border#PART_LayoutRoot, MenuFlyoutPresenter MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.12"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="ContextMenu MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuFlyoutPresenter MenuItem:pointerover /template/ Border#PART_LayoutRoot, ContextMenu MenuItem:selected /template/ Border#PART_LayoutRoot, MenuFlyoutPresenter MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="MenuItem.tehlike">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="ContextMenu Separator, MenuFlyoutPresenter Separator">
        <Setter Property="Margin" Value="10,4"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
    </Style>
</Styles>
