<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DepoWise.Application\DepoWise.Application.csproj" />
    <ProjectReference Include="..\DepoWise.Domain\DepoWise.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!-- BAR-01 (ADR-177): QR etiket üretimi — saf yönetilen C#, MIT, native bağımlılık yok
         (PngByteQRCode System.Drawing kullanmaz → masaüstü/Linux sunucuda aynı çalışır). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="QuestPDF" Version="2026.6.1" />
    <!-- Foto optimizasyonu (resize/JPEG) — ImageSharp lisans maliyeti yerine ücretsiz SkiaSharp.
         Linux (Fly aspnet:8.0 Debian) için native NoDependencies (fontconfig gerektirmez). -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
