@using DepoWise.Application.Security
@inject AuthState Auth
@implements IDisposable

<MudNavMenu>
    @if (Auth.IsAuthenticated)
    {
        <div class="px-3 py-2">
            <MudTextField @ref="_aramaKutusu" @bind-Value="_q" Immediate="true" Placeholder="Ekran ara..." Margin="Margin.Dense"
                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
        </div>

        @* MNU: menü artık firmanın DÜZEN tercihleriyle çizilir (ad · üst menü · sıra).
           Tercih yoksa MenuLayoutSet.Empty gelir ve sonuç katalogdakiyle BİREBİR aynıdır. *@
        var gruplar = BuildGroups();

        @if (!string.IsNullOrWhiteSpace(_q))
        {
            @foreach (var (g, e) in Filtered(gruplar))
            {
                <MudNavLink Href="@e.Screen.WebRoute">@g.Title › @e.Label</MudNavLink>
            }
        }
        else
        {
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Ana Ekran</MudNavLink>

            @* SEC (2026-08-19): menü artık ÜÇ seviyeli olabilir — ÜST GRUP → ÜST MENÜ → EKRAN.
               Üst grup tanımlanmamışsa her düğüm tek üst menü taşır ve çıktı BUGÜNKÜYLE BİREBİR AYNIDIR. *@
            @foreach (var node in Agac())
            {
                if (node.IsSection)
                {
                    <MudNavGroup Title="@node.Title" Icon="@Icons.Material.Filled.FolderOpen">
                        @foreach (var g in node.Groups) { @GrupCiz(g) }
                    </MudNavGroup>
                }
                else
                {
                    @GrupCiz(node.Groups[0])
                }
            }
        }
    }
    else
    {
        <MudNavLink Href="login" Icon="@Icons.Material.Filled.Login">Giriş</MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() => Auth.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnChanged;

    private string _q = "";
    private MudTextField<string>? _aramaKutusu;

    /// <summary>Sekme şeridindeki "Yeni Sekme" düğmesi buraya bağlanır (kullanıcı tasarımı 2026-09-04):
    /// boş sekme yaratılamaz — sekme ancak bir EKRAN açılınca oluşur — bu yüzden kullanıcı ekran
    /// seçebileceği tek yere getirilir. Önceki aramanın kalıntısı temizlenir.</summary>
    public async Task AramayaOdaklanAsync()
    {
        _q = "";
        StateHasChanged();
        if (_aramaKutusu is not null)
        {
            try { await _aramaKutusu.FocusAsync(); } catch { /* odak alınamazsa akış bozulmaz */ }
        }
    }

    private bool Visible(string perm) => perm switch
    {
        null or "" => true,
        "@admin" => Auth.IsAdmin,
        "@super" => Auth.IsSuperAdmin,
        // Yalnız Süper Admin + Kısıtlı Süper Admin (kullanıcı isteği 2026-07-26: Yedek Yönetimi).
        "@superr" => Auth.IsSuperAdmin || Auth.IsRestrictedSuperAdmin,
        _ => Auth.CanView(perm),
    };

    // ═══ G2/G6 (2026-08-12) + MNU (2026-08-18): MENÜ MERKEZİ KATALOGDAN ÜRETİLİR ═══
    // Eskiden burada 46 bağlantı ELLE yazılıydı; G2/G6 bunu AppScreens'e taşıdı. MNU ise sıralama
    // ve etiket çözümlemesini MenuLayout.Build'e devretti → masaüstü menüsü (ShellViewModel) ile
    // TAM AYNI kod. İki menü artık ne katalogda ne düzende ayrışabilir.
    //
    // ERİŞİM = PLATFORM_AKTİF && YETKİ_VAR — bu karar (isOpen) burada kalır; MenuLayout erişime
    // karışmaz. Görünür ekranı kalmayan grup listeye girmez (eski davranışın aynısı).
    private IReadOnlyList<MenuGroupView> BuildGroups()
        => MenuLayout.Build(ScreenPlatform.Web, Auth.MenuLayout,
            sc => Visible(sc.WebPermKey) && Auth.PlatformOpen(sc.Key));

    /// <summary>SEC — üç seviyeli ağaç. Üst grup yoksa her düğüm tek grup taşır (bugünkü çıktı).</summary>
    private IReadOnlyList<MenuNodeView> Agac()
        => MenuLayout.BuildTree(ScreenPlatform.Web, Auth.MenuLayout,
            sc => Visible(sc.WebPermKey) && Auth.PlatformOpen(sc.Key));

    /// <summary>Tek bir üst menüyü çizer. Hem en üst seviyede hem de bir ÜST GRUBUN içinde
    /// kullanılır → çizim kuralı tek yerde kalır, iki dal ayrışamaz.</summary>
    private RenderFragment GrupCiz(MenuGroupView g) => @<MudNavGroup Title="@g.Title" Icon="@WebIcon(g.Key)"
                                                                    Expanded="@(g.Key == "Web Yönetimi")">
        @foreach (var e in g.Entries) { <MudNavLink Href="@e.Screen.WebRoute">@e.Label</MudNavLink> }
    </MudNavGroup>;

    private IEnumerable<(MenuGroupView G, MenuEntry E)> Filtered(IReadOnlyList<MenuGroupView> gruplar)
    {
        var q = _q.Trim();
        foreach (var g in gruplar)
            foreach (var e in g.Entries)
                if (e.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    g.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
                    yield return (g, e);
    }

    /// <summary>Grup ikonu — MudBlazor sabitleri yalnız web projesinde çözülebildiği için eşleme
    /// BURADA durur (Application katmanı MudBlazor'a bağımlı olmasın). Eşleme grup ADINA değil
    /// değişmez grup ANAHTARINA bakar → yönetici grubu yeniden adlandırınca ikon KAYBOLMAZ.
    /// Kullanıcının oluşturduğu gruplar nötr ikon alır.</summary>
    /// <remarks>Sekme şeridi de (MainLayout) bunu kullanır: sekme, ekranın AİT OLDUĞU GRUBUN
    /// ikonunu alır — menüde ne görülüyorsa sekmede de o görülür (kullanıcı tasarımı 2026-09-04).</remarks>
    public static string WebIcon(string groupKey) => groupKey switch
    {
        "Uyarılar" => Icons.Material.Filled.NotificationsActive,
        "Malzemeler" => Icons.Material.Filled.Inventory2,
        "Araçlar" => Icons.Material.Filled.LocalShipping,
        "Personel" => Icons.Material.Filled.Badge,
        "Günlük Faaliyet" => Icons.Material.Filled.EventNote,
        "Bakım Takibi" => Icons.Material.Filled.Build,
        "Yakıt" => Icons.Material.Filled.LocalGasStation,
        "Yönetim" => Icons.Material.Filled.ManageAccounts,
        "Talepler" => Icons.Material.Filled.Description,
        "Raporlar" => Icons.Material.Filled.BarChart,
        "Yönetici Raporları" => Icons.Material.Filled.Assessment,
        "İmport / Export" => Icons.Material.Filled.SwapHoriz,
        "Ön Muhasebe" => Icons.Material.Filled.ReceiptLong,
        "Kullanıcı" => Icons.Material.Filled.People,
        "Ayarlar" => Icons.Material.Filled.Settings,
        "Web Yönetimi" => Icons.Material.Filled.AdminPanelSettings,
        "Çöp Kutusu" => Icons.Material.Filled.DeleteSweep,
        _ => Icons.Material.Filled.Folder,
    };
}
