@using DepoWise.Application.Security
@inject AuthState Auth
@implements IDisposable

<MudNavMenu>
    @if (Auth.IsAuthenticated)
    {
        <div class="px-3 py-2">
            <MudTextField @ref="_aramaKutusu" @bind-Value="_q" Immediate="true" Placeholder="Ekran ara..." Margin="Margin.Dense"
                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
        </div>

        @* MNU: menü artık firmanın DÜZEN tercihleriyle çizilir (ad · üst menü · sıra).
           Tercih yoksa MenuLayoutSet.Empty gelir ve sonuç katalogdakiyle BİREBİR aynıdır. *@
        var gruplar = BuildGroups();

        @if (!string.IsNullOrWhiteSpace(_q))
        {
            @foreach (var (g, e) in Filtered(gruplar))
            {
                <MudNavLink Href="@e.Screen.WebRoute" Icon="@EkranIkonu(e.Screen.Key)">@g.Title › @e.Label</MudNavLink>
            }
        }
        else
        {
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Ana Ekran</MudNavLink>

            @* SEC (2026-08-19): menü artık ÜÇ seviyeli olabilir — ÜST GRUP → ÜST MENÜ → EKRAN.
               Üst grup tanımlanmamışsa her düğüm tek üst menü taşır ve çıktı BUGÜNKÜYLE BİREBİR AYNIDIR. *@
            @foreach (var node in Agac())
            {
                if (node.IsSection)
                {
                    <MudNavGroup Title="@node.Title" Icon="@BolumIkonu(node.Title)" Class="@BolumAilesi(node.Title)">
                        @foreach (var g in node.Groups) { @GrupCiz(g) }
                    </MudNavGroup>
                }
                else
                {
                    @GrupCiz(node.Groups[0])
                }
            }
        }
    }
    else
    {
        <MudNavLink Href="login" Icon="@Icons.Material.Filled.Login">Giriş</MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() => Auth.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnChanged;

    private string _q = "";
    private MudTextField<string>? _aramaKutusu;

    /// <summary>Sekme şeridindeki "Yeni Sekme" düğmesi buraya bağlanır (kullanıcı tasarımı 2026-09-04):
    /// boş sekme yaratılamaz — sekme ancak bir EKRAN açılınca oluşur — bu yüzden kullanıcı ekran
    /// seçebileceği tek yere getirilir. Önceki aramanın kalıntısı temizlenir.</summary>
    public async Task AramayaOdaklanAsync()
    {
        _q = "";
        StateHasChanged();
        if (_aramaKutusu is not null)
        {
            try { await _aramaKutusu.FocusAsync(); } catch { /* odak alınamazsa akış bozulmaz */ }
        }
    }

    private bool Visible(string perm) => perm switch
    {
        null or "" => true,
        "@admin" => Auth.IsAdmin,
        "@super" => Auth.IsSuperAdmin,
        // Yalnız Süper Admin + Kısıtlı Süper Admin (kullanıcı isteği 2026-07-26: Yedek Yönetimi).
        "@superr" => Auth.IsSuperAdmin || Auth.IsRestrictedSuperAdmin,
        _ => Auth.CanView(perm),
    };

    // ═══ G2/G6 (2026-08-12) + MNU (2026-08-18): MENÜ MERKEZİ KATALOGDAN ÜRETİLİR ═══
    // Eskiden burada 46 bağlantı ELLE yazılıydı; G2/G6 bunu AppScreens'e taşıdı. MNU ise sıralama
    // ve etiket çözümlemesini MenuLayout.Build'e devretti → masaüstü menüsü (ShellViewModel) ile
    // TAM AYNI kod. İki menü artık ne katalogda ne düzende ayrışabilir.
    //
    // ERİŞİM = PLATFORM_AKTİF && YETKİ_VAR — bu karar (isOpen) burada kalır; MenuLayout erişime
    // karışmaz. Görünür ekranı kalmayan grup listeye girmez (eski davranışın aynısı).
    private IReadOnlyList<MenuGroupView> BuildGroups()
        => MenuLayout.Build(ScreenPlatform.Web, Auth.MenuLayout,
            sc => Visible(sc.WebPermKey) && Auth.PlatformOpen(sc.Key));

    /// <summary>SEC — üç seviyeli ağaç. Üst grup yoksa her düğüm tek grup taşır (bugünkü çıktı).</summary>
    private IReadOnlyList<MenuNodeView> Agac()
        => MenuLayout.BuildTree(ScreenPlatform.Web, Auth.MenuLayout,
            sc => Visible(sc.WebPermKey) && Auth.PlatformOpen(sc.Key));

    /// <summary>Tek bir üst menüyü çizer. Hem en üst seviyede hem de bir ÜST GRUBUN içinde
    /// kullanılır → çizim kuralı tek yerde kalır, iki dal ayrışamaz.</summary>
    private RenderFragment GrupCiz(MenuGroupView g) => @<MudNavGroup Title="@g.Title" Icon="@WebIcon(g.Key)"
                                                                    Class="@GrupAilesi(g.Key)"
                                                                    Expanded="@(g.Key == "Web Yönetimi")">
        @* ⭐ MNU-IKON (2026-09-05): alt menülerde ikon EKLENDİ. Eskiden hiçbirinde ikon yoktu —
           eksik kalmış değil, hiç tanımlanmamıştı. Kullanıcı şartı: simgesiz menü kalmayacak.
           ⭐ FAZ 2 (ADR-221): ekran, üst menüsünün RENK AİLESİNİ miras alır — burada renk YAZILMAZ. *@
        @foreach (var e in g.Entries)
        {
            <MudNavLink Href="@e.Screen.WebRoute" Icon="@EkranIkonu(e.Screen.Key)"
                        Class="@EkranAilesi(e.Screen.Key)">@e.Label</MudNavLink>
        }
    </MudNavGroup>;

    // ═══ FAZ 2 (ADR-221) — RENK AİLESİ SINIFLARI ═══════════════════════════════════════════
    //
    // Hangi menünün hangi aileyi kullandığı ORTAK katmandadır (MenuPalette); burada yalnız
    // "aile → CSS sınıfı" çevirisi var. Masaüstündeki karşılığı DesktopMenuColors'tır.
    //
    // ⚠️ Renk YETKİDEN BAĞIMSIZDIR: bu sınıflar hiçbir görünürlük kararı vermez. Menüde ne
    // görüneceğini yalnız yetki belirler (BuildGroups/Agac içindeki Visible süzgeci).
    //
    // ⚠️ Performans: MenuPalette çözümü sözlük araması + katalog taramasıdır; menü zaten her
    // çizimde yeniden kuruluyor ve sonuç saf string olduğu için ek maliyet ölçülebilir değildir.

    private static string SinifAdi(string aile, DepoWise.Application.Security.MenuPalette.Level seviye)
        => "dw-fam dw-fam-" + aile + " dw-fam-" + seviye switch
        {
            DepoWise.Application.Security.MenuPalette.Level.Section => "section",
            DepoWise.Application.Security.MenuPalette.Level.Group => "group",
            _ => "screen",
        };

    /// <summary>Üst grup (section) — ailenin en güçlü tonu.</summary>
    private static string BolumAilesi(string sectionTitle)
        => SinifAdi(DepoWise.Application.Security.MenuPalette.ForSection(sectionTitle), DepoWise.Application.Security.MenuPalette.Level.Section);

    /// <summary>Üst menü — üst grubundan MİRAS.</summary>
    private static string GrupAilesi(string groupKey)
        => SinifAdi(DepoWise.Application.Security.MenuPalette.ForGroup(groupKey), DepoWise.Application.Security.MenuPalette.Level.Group);

    /// <summary>Ekran — üst menüsünden MİRAS. Ekranın kendi rengi yoktur.</summary>
    private static string EkranAilesi(string screenKey)
        => SinifAdi(DepoWise.Application.Security.MenuPalette.ForScreen(screenKey), DepoWise.Application.Security.MenuPalette.Level.Screen);

    private IEnumerable<(MenuGroupView G, MenuEntry E)> Filtered(IReadOnlyList<MenuGroupView> gruplar)
    {
        var q = _q.Trim();
        foreach (var g in gruplar)
            foreach (var e in g.Entries)
                if (e.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    g.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
                    yield return (g, e);
    }

    /// <summary>
    /// ⭐ MNU-IKON (2026-09-05) — grup ikonu artık KAVRAM üzerinden çözülür.
    ///
    /// <b>Eskiden:</b> bu <c>switch</c> grup BAŞLIKLARINI doğrudan içeriyordu ve tablo katalogla
    /// birlikte güncellenmediği için <b>beş anahtar eskimişti</b> ("Personel", "Yönetim",
    /// "Raporlar", "İmport / Export", "Kullanıcı"). Karşılığı olmayan gruplar sessizce genel
    /// klasör ikonuna düşüyordu — hata vermiyordu, yalnız ikon kayboluyordu. Ekipman, Zimmet,
    /// Satın Alma, İş Emirleri, Takvim, Evrak, Duyurular, Denetim gibi gruplar da hiç eklenmemişti.
    ///
    /// <b>Artık:</b> hangi grubun hangi KAVRAMI kullandığı ortak katmanda
    /// (<see cref="MenuIcons"/>); burada yalnız <b>kavram → MudBlazor sabiti</b> çevirisi var.
    /// Katalog değişince tek yer güncellenir ve eksik kavram <c>MenuIkonTests</c> ile yakalanır.
    /// Application katmanı MudBlazor'a bağımlı olmaz (kavramlar düz string'dir).
    /// </summary>
    /// <remarks>Sekme şeridi de (MainLayout) bunu kullanır: sekme, ekranın AİT OLDUĞU GRUBUN
    /// ikonunu alır — menüde ne görülüyorsa sekmede de o görülür (kullanıcı tasarımı 2026-09-04).</remarks>
    public static string WebIcon(string groupKey) => KavramIkonu(DepoWise.Application.Security.MenuIcons.ForGroup(groupKey));

    /// <summary>Ekran (alt menü) ikonu — kullanıcı isteği 2026-09-05: simgesiz menü kalmayacak.</summary>
    public static string EkranIkonu(string screenKey) => KavramIkonu(DepoWise.Application.Security.MenuIcons.ForScreen(screenKey));

    /// <summary>Üst grup (section) ikonu. Eskiden HEPSİ aynı <c>FolderOpen</c> ikonunu alıyordu.</summary>
    public static string BolumIkonu(string sectionTitle) => KavramIkonu(DepoWise.Application.Security.MenuIcons.ForSection(sectionTitle));

    /// <summary>Kavram → MudBlazor sabiti. Bilinmeyen kavram nötr bir ikon alır; menü öğesi
    /// ASLA ikonsuz kalmaz.</summary>
    private static string KavramIkonu(string kavram) => kavram switch
    {
        // ── üst menüler ──
        "alerts" => Icons.Material.Filled.NotificationsActive,
        "materials" => Icons.Material.Filled.Inventory2,
        "vehicles" => Icons.Material.Filled.LocalShipping,
        "equipment" => Icons.Material.Filled.Construction,
        "assignments" => Icons.Material.Filled.AssignmentInd,
        "purchasing" => Icons.Material.Filled.ShoppingCart,
        "work-orders" => Icons.Material.Filled.Assignment,
        "calendar" => Icons.Material.Filled.CalendarMonth,
        "daily-activity" => Icons.Material.Filled.EventNote,
        "maintenance" => Icons.Material.Filled.Build,
        "fuel" => Icons.Material.Filled.LocalGasStation,
        "requests" => Icons.Material.Filled.Description,
        "accounting" => Icons.Material.Filled.ReceiptLong,
        "reports" => Icons.Material.Filled.BarChart,
        "reports-manager" => Icons.Material.Filled.Assessment,
        "branches" => Icons.Material.Filled.Apartment,
        "users" => Icons.Material.Filled.People,
        "documents" => Icons.Material.Filled.FolderCopy,
        "announcements" => Icons.Material.Filled.Campaign,
        "audit" => Icons.Material.Filled.FactCheck,
        "web-admin" => Icons.Material.Filled.AdminPanelSettings,
        "backup" => Icons.Material.Filled.Backup,
        "trash" => Icons.Material.Filled.DeleteSweep,
        "settings" => Icons.Material.Filled.Settings,

        // ── alt menüler (ekranlar) ──
        "list" => Icons.Material.Filled.FormatListBulleted,
        "new" => Icons.Material.Filled.AddCircleOutline,
        "stock-entry" => Icons.Material.Filled.SwapVert,
        "movements" => Icons.Material.Filled.History,
        "count" => Icons.Material.Filled.Checklist,
        "template" => Icons.Material.Filled.ContentCopy,
        "distribute" => Icons.Material.Filled.CallSplit,
        "inspection" => Icons.Material.Filled.VerifiedUser,
        "definition" => Icons.Material.Filled.Tune,
        "fuel-depot" => Icons.Material.Filled.Storage,
        "summary" => Icons.Material.Filled.Summarize,
        "request-form" => Icons.Material.Filled.PostAdd,
        "approve" => Icons.Material.Filled.TaskAlt,
        "operations" => Icons.Material.Filled.ManageSearch,
        "invoice" => Icons.Material.Filled.ReceiptLong,
        "finance" => Icons.Material.Filled.AccountBalance,
        "payment" => Icons.Material.Filled.Payments,
        "cost-center" => Icons.Material.Filled.PieChart,
        "designer" => Icons.Material.Filled.DesignServices,
        "projects" => Icons.Material.Filled.Foundation,
        "personnel" => Icons.Material.Filled.Badge,
        "teams" => Icons.Material.Filled.Groups,
        "permissions" => Icons.Material.Filled.Key,
        "log" => Icons.Material.Filled.ManageHistory,
        "companies" => Icons.Material.Filled.Business,
        "update" => Icons.Material.Filled.SystemUpdateAlt,
        "machine" => Icons.Material.Filled.Computer,
        "server" => Icons.Material.Filled.Dns,
        "quota" => Icons.Material.Filled.DataUsage,
        "delete" => Icons.Material.Filled.DeleteForever,
        "reset" => Icons.Material.Filled.RestartAlt,
        "screens" => Icons.Material.Filled.ViewQuilt,
        "field-settings" => Icons.Material.Filled.EditNote,
        "excel" => Icons.Material.Filled.SwapHoriz,
        "developer" => Icons.Material.Filled.Code,
        "theme" => Icons.Material.Filled.Palette,
        "info" => Icons.Material.Filled.Info,

        // ── üst gruplar (section) ──
        "section-stock" => Icons.Material.Filled.Warehouse,
        "section-operations" => Icons.Material.Filled.PrecisionManufacturing,
        "section-finance" => Icons.Material.Filled.AccountBalanceWallet,
        "section-reports" => Icons.Material.Filled.Analytics,
        "section-corporate" => Icons.Material.Filled.CorporateFare,
        "section-system" => Icons.Material.Filled.SettingsApplications,

        // ── nötrler: eşleşme bulunamazsa da ikon VARDIR ──
        "screen" => Icons.Material.Filled.ChevronRight,
        _ => Icons.Material.Filled.Folder,
    };
}
