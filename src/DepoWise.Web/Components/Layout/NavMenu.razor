@inject AuthState Auth
@implements IDisposable

<MudNavMenu>
    @if (Auth.IsAuthenticated)
    {
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Ana Ekran</MudNavLink>

        @foreach (var g in Groups)
        {
            var links = g.Links.Where(l => Visible(l.Perm)).ToList();
            if (links.Count == 0) { continue; }
            <MudNavGroup Title="@g.Title" Icon="@g.Icon" Expanded="false">
                @foreach (var l in links) { <MudNavLink Href="@l.Route">@l.Label</MudNavLink> }
            </MudNavGroup>
        }
    }
    else
    {
        <MudNavLink Href="login" Icon="@Icons.Material.Filled.Login">Giriş</MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() => Auth.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnChanged;

    private bool Visible(string perm) => string.IsNullOrEmpty(perm) || Auth.CanView(perm);

    private sealed record Link(string Label, string Perm, string Route);
    private sealed record Group(string Title, string Icon, Link[] Links);

