@using DepoWise.Application.Security
@inject AuthState Auth
@implements IDisposable

<MudNavMenu>
    @if (Auth.IsAuthenticated)
    {
        <div class="px-3 py-2">
            <MudTextField @bind-Value="_q" Immediate="true" Placeholder="Ekran ara..." Margin="Margin.Dense"
                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_q))
        {
            @foreach (var (g, l) in FilteredLinks())
            {
                <MudNavLink Href="@l.Route">@g.Title › @l.Label</MudNavLink>
            }
        }
        else
        {
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Ana Ekran</MudNavLink>

            @foreach (var g in Groups)
            {
                @* G5: yetki VE platform birlikte — ERİŞİM = PLATFORM_AKTİF && YETKİ_VAR *@
                var links = g.Links.Where(l => Visible(l.Perm) && Auth.PlatformOpenForRoute(l.Route)).ToList();
                if (links.Count == 0) { continue; }
                <MudNavGroup Title="@g.Title" Icon="@g.Icon" Expanded="@(g.Title == "Web Yönetimi")">
                    @foreach (var l in links) { <MudNavLink Href="@l.Route">@l.Label</MudNavLink> }
                </MudNavGroup>
            }
        }
    }
    else
    {
        <MudNavLink Href="login" Icon="@Icons.Material.Filled.Login">Giriş</MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() => Auth.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnChanged;

    private string _q = "";

    private bool Visible(string perm) => perm switch
    {
        null or "" => true,
        "@admin" => Auth.IsAdmin,
        "@super" => Auth.IsSuperAdmin,
        // Yalnız Süper Admin + Kısıtlı Süper Admin (kullanıcı isteği 2026-07-26: Yedek Yönetimi).
        "@superr" => Auth.IsSuperAdmin || Auth.IsRestrictedSuperAdmin,
        _ => Auth.CanView(perm),
    };

    private IEnumerable<(Group G, Link L)> FilteredLinks()
    {
        var q = _q.Trim();
        foreach (var g in Groups)
            foreach (var l in g.Links)
                if (Visible(l.Perm) && Auth.PlatformOpenForRoute(l.Route) &&
                    (l.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                     g.Title.Contains(q, StringComparison.OrdinalIgnoreCase)))
                    yield return (g, l);
    }

    private sealed record Link(string Label, string Perm, string Route);
    private sealed record Group(string Title, string Icon, Link[] Links);

    // ═══ G2/G6 (2026-08-12): MENÜ ARTIK MERKEZİ KATALOGDAN ÜRETİLİR ═══
    // Eskiden burada 46 bağlantı ELLE yazılıydı ve dosyanın kendi yorumu "Masaüstü BuildGroups ile
    // BİREBİR" diyordu — ama sayılar zaten ayrışmıştı (web 46 · masaüstü 40). Artık iki menü de
    // AppScreens'ten türetilir → yeni ekran TEK satırla iki platforma birden gelir.
    // Grup sırası, başlıklar ve bağlantı sırası AppScreens'te BİREBİR korunmuştur.
    private static readonly Group[] Groups =
        AppScreens.GroupsFor(ScreenPlatform.Web)
            .Select(g => new Group(g.Title, WebIcon(g.Title),
                AppScreens.ScreensOf(g.Title, ScreenPlatform.Web)
                    .Select(s => new Link(s.Label, s.WebPermKey, s.WebRoute!)).ToArray()))
            .ToArray();

    /// <summary>Grup ikonu — MudBlazor sabitleri yalnız web projesinde çözülebildiği için eşleme
    /// BURADA durur (Application katmanı MudBlazor'a bağımlı olmasın). Bilinmeyen grup nötr ikon alır.</summary>
    private static string WebIcon(string groupTitle) => groupTitle switch
    {
        "Uyarılar" => Icons.Material.Filled.NotificationsActive,
        "Malzemeler" => Icons.Material.Filled.Inventory2,
        "Araçlar" => Icons.Material.Filled.LocalShipping,
        "Personel" => Icons.Material.Filled.Badge,
        "Günlük Faaliyet" => Icons.Material.Filled.EventNote,
        "Bakım Takibi" => Icons.Material.Filled.Build,
        "Yakıt" => Icons.Material.Filled.LocalGasStation,
        "Yönetim" => Icons.Material.Filled.ManageAccounts,
        "Talepler" => Icons.Material.Filled.Description,
        "Raporlar" => Icons.Material.Filled.BarChart,
        "Yönetici Raporları" => Icons.Material.Filled.Assessment,
        "İmport / Export" => Icons.Material.Filled.SwapHoriz,
        "Kullanıcı" => Icons.Material.Filled.People,
        "Ayarlar" => Icons.Material.Filled.Settings,
        "Web Yönetimi" => Icons.Material.Filled.AdminPanelSettings,
        "Çöp Kutusu" => Icons.Material.Filled.DeleteSweep,
        _ => Icons.Material.Filled.Circle,
    };
}
