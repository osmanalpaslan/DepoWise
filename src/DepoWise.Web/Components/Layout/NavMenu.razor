@inject AuthState Auth
@implements IDisposable

<MudNavMenu>
    @if (Auth.IsAuthenticated)
    {
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Panel</MudNavLink>

        @foreach (var g in Groups)
        {
            var mods = g.Keys.Where(k => Auth.CanView(k)).ToList();
            if (mods.Count == 0) { continue; }
            <MudNavGroup Title="@g.Title" Icon="@g.Icon" Expanded="false">
                @foreach (var key in mods)
                {
                    var (route, ready) = Map(key);
                    <MudNavLink Href="@route">@Label(key)@(ready ? "" : " •")</MudNavLink>
                }
            </MudNavGroup>
        }
    }
    else
    {
        <MudNavLink Href="login" Icon="@Icons.Material.Filled.Login">Giriş</MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() => Auth.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnChanged;

    private sealed record Grp(string Icon, string Title, string[] Keys);

    private static readonly Grp[] Groups =
    {
        new(Icons.Material.Filled.Inventory2, "Malzemeler", new[] { "materials", "stock" }),
        new(Icons.Material.Filled.LocalShipping, "Araçlar", new[] { "vehicles", "maintenance", "inspection", "fuel", "daily_activity" }),
        new(Icons.Material.Filled.Badge, "Personel", new[] { "personnel" }),
        new(Icons.Material.Filled.Description, "Talepler", new[] { "requests" }),
        new(Icons.Material.Filled.BarChart, "Raporlar", new[] { "reports" }),
        new(Icons.Material.Filled.SwapHoriz, "İçe / Dışa Aktarım", new[] { "import_export", "files" }),
        new(Icons.Material.Filled.Category, "Tanımlar", new[] { "definitions" }),
        new(Icons.Material.Filled.People, "Kullanıcılar & Yetki", new[] { "users", "permissions", "permission_templates" }),
        new(Icons.Material.Filled.Shield, "Yönetim", new[] { "companies", "releases", "branches", "machines", "audit", "backup", "server_backups" }),
        new(Icons.Material.Filled.Settings, "Ayarlar", new[] { "settings", "about" }),
    };

    private static string Label(string key) => key switch
    {
        "materials" => "Malzemeler", "stock" => "Stok İşlemleri",
        "vehicles" => "Araçlar", "maintenance" => "Bakım", "inspection" => "Muayene / Sigorta",
        "fuel" => "Yakıt", "daily_activity" => "Günlük Faaliyet", "personnel" => "Personel",
        "requests" => "Malzeme Talep", "reports" => "Raporlar", "import_export" => "İmport / Export",
        "files" => "Dosya / Fotoğraf", "definitions" => "Tanımlar", "users" => "Kullanıcılar",
        "permissions" => "Yetkiler", "permission_templates" => "Yetki Şablonları",
        "companies" => "Firmalar", "releases" => "Güncelleme Yönetimi", "branches" => "Şube / Şantiye",
        "machines" => "Makine Yönetimi", "audit" => "Sistem Logu", "backup" => "Yedekleme",
        "server_backups" => "Sunucu Yedekleri", "settings" => "Ayarlar", "about" => "Hakkında",
        _ => key,
    };

    private static (string Route, bool Ready) Map(string key) => key switch
    {
        "companies" => ("companies", true),
        "machines" => ("machines", true),
        "releases" => ("releases", true),
        "users" => ("users", true),
        "branches" => ("branches", true),
        "personnel" => ("personnel", true),
        "materials" => ("materials", true),
        "vehicles" => ("vehicles", true),
        "stock" => ("stock", true),
        "maintenance" => ("maintenance", true),
        "inspection" => ("inspection", true),
        "fuel" => ("fuel", true),
        "daily_activity" => ("daily", true),
        "requests" => ("requests", true),
        "definitions" => ("definitions", true),
        _ => ($"soon/{key}", false),
    };
}
