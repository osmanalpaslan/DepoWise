@inject AuthState Auth
@implements IDisposable

<MudNavMenu>
    @if (Auth.IsAuthenticated)
    {
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Panel</MudNavLink>

        @* Operasyonel modüller (masaüstüyle aynı isim/işlev) *@
        @foreach (var g in Operational)
        {
            var items = g.Items.Where(i => Auth.CanView(i.Key)).ToList();
            if (items.Count == 0) { continue; }
            <MudNavGroup Title="@g.Title" Icon="@g.Icon" Expanded="false">
                @foreach (var i in items) { <MudNavLink Href="@Route(i.Key)">@i.Label</MudNavLink> }
            </MudNavGroup>
        }

        @* Web'e özel yönetim ekranları — ayrı menü + alt menüler *@
        @if (WebAdmin.Any(s => s.Items.Any(i => Auth.CanView(i.Key))))
        {
            <MudDivider Class="my-2" />
            <MudNavGroup Title="Web Yönetimi" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                @foreach (var s in WebAdmin)
                {
                    var items = s.Items.Where(i => Auth.CanView(i.Key)).ToList();
                    if (items.Count == 0) { continue; }
                    <MudNavGroup Title="@s.Title" Icon="@s.Icon" Expanded="false">
                        @foreach (var i in items) { <MudNavLink Href="@Route(i.Key)">@i.Label</MudNavLink> }
                    </MudNavGroup>
                }
            </MudNavGroup>
        }
    }
    else
    {
        <MudNavLink Href="login" Icon="@Icons.Material.Filled.Login">Giriş</MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() => Auth.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnChanged;

    private sealed record Item(string Key, string Label);
    private sealed record Group(string Title, string Icon, Item[] Items);

    // Masaüstü isimleriyle birebir.
    private static readonly Group[] Operational =
    {
        new("Malzemeler", Icons.Material.Filled.Inventory2, new[] { new Item("materials", "Malzemeler"), new Item("stock", "Stok İşlemleri") }),
        new("Araçlar", Icons.Material.Filled.LocalShipping, new[] { new Item("vehicles", "Araçlar"), new Item("maintenance", "Bakım"), new Item("inspection", "Muayene / Sigorta"), new Item("fuel", "Yakıt"), new Item("daily_activity", "Günlük Faaliyet") }),
        new("Personel", Icons.Material.Filled.Badge, new[] { new Item("personnel", "Personel") }),
        new("Talepler", Icons.Material.Filled.Description, new[] { new Item("requests", "Malzeme Talep") }),
        new("Raporlar", Icons.Material.Filled.BarChart, new[] { new Item("reports", "Raporlar") }),
        new("Tanımlar", Icons.Material.Filled.Category, new[] { new Item("definitions", "Tanımlar"), new Item("users", "Kullanıcılar") }),
        new("Yönetim", Icons.Material.Filled.ManageAccounts, new[] { new Item("branches", "Şube / Şantiye"), new Item("permissions", "Yetkiler"), new Item("audit", "Sistem Logu"), new Item("backup", "Yedek Yönetimi") }),
        new("Ayarlar", Icons.Material.Filled.Settings, new[] { new Item("permission_templates", "Yetki Şablonları"), new Item("settings", "Ayarlar"), new Item("about", "Hakkında") }),
    };

    // Web'e özel (platform) ekranlar — ayrı menü altında alt menüler.
    private static readonly Group[] WebAdmin =
    {
        new("Firmalar & Dağıtım", Icons.Material.Filled.Business, new[] { new Item("companies", "Firma Tanım"), new Item("releases", "Güncelleme Yönetimi"), new Item("machines", "Makine Yönetimi") }),
        new("Sunucu", Icons.Material.Filled.Dns, new[] { new Item("server_backups", "Sunucu Yedekleri") }),
    };

    private static string Route(string key) => key switch
    {
        "companies" => "companies", "machines" => "machines", "releases" => "releases",
        "users" => "users", "branches" => "branches", "personnel" => "personnel",
        "materials" => "materials", "vehicles" => "vehicles", "stock" => "stock",
        "maintenance" => "maintenance", "inspection" => "inspection", "fuel" => "fuel",
        "daily_activity" => "daily", "requests" => "requests", "definitions" => "definitions",
        "permissions" => "permissions", "permission_templates" => "permission-templates",
        "audit" => "audit", "backup" => "backup", "reports" => "reports",
        _ => $"soon/{key}",
    };
}
