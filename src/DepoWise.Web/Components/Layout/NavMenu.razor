@inject AuthState Auth
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">DepoWise Yönetim</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @if (Auth.IsAuthenticated)
        {
            <div class="nav-item px-3"><NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span class="bi bi-house-door-fill-nav-menu"></span> Panel</NavLink></div>

            @foreach (var m in Auth.Modules)
            {
                if (m.Key == "dashboard" || m.Key == "about") { continue; }
                var (route, ready) = Map(m.Key);
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@route">
                        <span class="bi bi-list-nested-nav-menu"></span> @m.Label @(ready ? "" : "•")
                    </NavLink>
                </div>
            }
        }
        else
        {
            <div class="nav-item px-3"><NavLink class="nav-link" href="login"><span class="bi bi-person-badge-nav-menu"></span> Giriş</NavLink></div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized() => Auth.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnChanged;

    // Modül anahtarı → web rotası. Yapılmış olanlar gerçek sayfaya, diğerleri "yakında"ya gider.
    private static (string Route, bool Ready) Map(string key) => key switch
    {
        "companies" => ("companies", true),
        "machines" => ("machines", true),
        "releases" => ("releases", true),
        _ => ($"soon/{key}", false),
    };
}
