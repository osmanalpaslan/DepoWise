@using System.Text.Json
@implements IAsyncDisposable
@inject ApiClient Api
@inject AuthState Auth
@inject IJSRuntime JS
@inject DepoWise.Web.Services.WebSesServisi Ses

@*
    ═══ UYGULAMA İÇİ SOHBET — WEB ═══ (kullanıcı isteği 2026-09-06)

    Masaüstündeki tasarımın birebir karşılığı:
      · Sohbet düğmesi ekranın SAĞ ALT köşesinde SABİT durur (masaüstünde alt barın en sağı).
      · Açık konuşmalar onun solunda birer SEKME olur; sekmeye tıklamak pencereyi açar/kapatır,
        ✕ sekmeyi kaldırır.
      · Pencereler position:fixed ile çizilir → sayfa yerleşimine girmez, "ekranda fazladan yer
        işgal etmez" (kullanıcının açık şartı).

    Yoklama: pencere açıkken 3 sn, kapalıyken 20 sn (yalnız okunmamış rozeti). Sunucuya
    ulaşılamazsa sohbet "çevrimdışı" gösterir; sahte veri üretmez.

    Yetki: KULLANICI KARARI 2026-10-29: sohbet bir işlem değil → yetkiye BAĞLI DEĞİL, giriş yapan her kullanıcıda açık. Firma sınırı servistedir (yalnız aynı firmadaki kişiler).
    Giriş yapılmamışsa bileşen çizilmez ve istek atılmaz.
*@

@if (Auth.IsAuthenticated)
{
    <div class="dw-chat-dock">

        @* ── Açık konuşma pencereleri ── *@
        @foreach (var k in _konusmalar.Where(x => x.Acik))
        {
            <MudPaper Class="dw-chat-window" Elevation="8">
                <div class="dw-chat-head">
                    <MudAvatar Size="Size.Small" Color="Color.Primary">@k.Initial</MudAvatar>
                    <div class="dw-chat-head-text">
                        <div class="dw-chat-name">@k.Display</div>
                        <div class="dw-chat-status">
                            <span class="dw-dot @(k.Online ? "on" : "off")"></span>
                            @(k.Online ? "Çevrim içi" : "Çevrim dışı")
                        </div>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                   OnClick="@(() => PencereAcKapa(k))" Title="Pencereyi kapat (sekme kalır)" />
                </div>

                <div class="dw-chat-body" id="@KaydirmaKimligi(k)">
                    @foreach (var m in k.Mesajlar)
                    {
                        <div class="dw-msg @(m.Mine ? "mine" : "theirs")">
                            <div class="dw-msg-body">@m.Body</div>
                            <div class="dw-msg-time">@m.Saat</div>
                        </div>
                    }
                    @if (k.GorulduMetni is { Length: > 0 } gm)
                    {
                        @* 2026-10-29 (kullanıcı isteği): son mesaj benimse altında "Görüldü 14:32" / "İletildi" — masaüstüyle aynı kural. *@
                        <div class="dw-msg-goruldu">@gm</div>
                    }
                    @if (k.Mesajlar.Count == 0)
                    {
                        <div class="dw-chat-empty">Henüz mesaj yok. İlk mesajı siz yazın.</div>
                    }
                </div>

                <div class="dw-chat-foot">
                    @if (!string.IsNullOrEmpty(k.Hata))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@k.Hata</MudText>
                    }
                    @* 2026-10-30 (kullanıcı isteği): EMOJİ seçici + kısayollar (:) <3 (y) :kamyon:) — masaüstüyle aynı EmojiKatalogu. *@
                    @if (k.EmojiAcik)
                    {
                        <div class="dw-emoji-panel" role="dialog" aria-label="Emoji seç">
                            <input class="dw-emoji-ara" type="search" placeholder="Emoji ara (ör. kamyon, tamam)" aria-label="Emoji ara"
                                   value="@k.EmojiArama" @oninput="@(e => k.EmojiArama = e.Value?.ToString() ?? "")" />
                            <div class="dw-emoji-liste">
                                @foreach (var kat in EmojiKategorileri(k))
                                {
                                    <div class="dw-emoji-kat">@kat.Ad</div>
                                    <div class="dw-emoji-izgara">
                                        @foreach (var o in kat.Ogeler)
                                        {
                                            <button type="button" class="dw-emoji-sec" title="@o.Ipucu" aria-label="@o.Ad" @onclick="@(() => EmojiEkle(k, o))">@o.Emoji</button>
                                        }
                                    </div>
                                }
                                @if (!EmojiKategorileri(k).Any())
                                {
                                    <div class="dw-emoji-kat">Sonuç yok</div>
                                }
                            </div>
                        </div>
                    }
                    <div class="dw-chat-input">
                        <button type="button" class="dw-emoji-dugme" aria-label="Emoji ekle" aria-expanded="@k.EmojiAcik"
                                title="Emoji ekle — kısayollar da çalışır: :)  :D  <3  (y)  :kamyon:  :tamam:"
                                @onclick="@(() => k.EmojiAcik = !k.EmojiAcik)">🙂</button>
                        <MudTextField Value="k.Taslak" ValueChanged="@((string v) => TaslakDegisti(k, v))" Placeholder="Mesaj yazın…" Margin="Margin.Dense"
                                      Variant="Variant.Outlined" Immediate="true"
                                      OnKeyDown="@(e => EnterIleGonder(e, k))" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => Gonder(k))">Gönder</MudButton>
                    </div>
                </div>
            </MudPaper>
        }

        @* ── Kişi listesi ── *@
        @if (_panelAcik)
        {
            <MudPaper Class="dw-chat-window dw-chat-users" Elevation="8">
                <div class="dw-chat-head">
                    <div class="dw-chat-head-text"><div class="dw-chat-name">Kullanıcılar</div></div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                   OnClick="@(() => { _panelAcik = false; })" Title="Kapat" />
                </div>
                <div class="dw-chat-search">
                    <MudTextField @bind-Value="_arama" Placeholder="Kullanıcı ara…" Margin="Margin.Dense"
                                  Variant="Variant.Outlined" Immediate="true" />
                </div>
                <div class="dw-chat-body">
                    @if (_cevrimdisi)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="ma-2">
                            Sunucuya ulaşılamıyor. Sohbet yalnız çevrimiçiyken çalışır.
                        </MudAlert>
                    }
                    @* ⭐ 2026-09-06 (kullanıcı isteği): kişiler ÇEVRİM İÇİ / ÇEVRİM DIŞI olarak
                       GRUPLANIR ve her grubun sayısı yazılır. Kullanıcının çizdiği tasarım budur ve
                       çevrimdışı kişilerin listede olduğu böylece tartışmasız görünür. Çevrimdışı
                       birine de mesaj atılabilir; karşı taraf çevrimiçi olunca mesajı görür. *@
                    @foreach (var grup in Gruplar())
                    {
                        <div class="dw-chat-group">@grup.Baslik (@grup.Kisiler.Count)</div>
                        @foreach (var k in grup.Kisiler)
                        {
                        <div class="dw-chat-person" @onclick="@(() => KisiyiAc(k))">
                            <MudAvatar Size="Size.Small" Color="Color.Default">@k.Initial</MudAvatar>
                            <div class="dw-chat-person-text">
                                <div class="dw-chat-name">@k.Display</div>
                                <div class="dw-chat-status">
                                    <span class="dw-dot @(k.Online ? "on" : "off")"></span>
                                    @(k.Online ? "Çevrim içi" : "Çevrim dışı")
                                </div>
                            </div>
                            @if (k.Unread > 0)
                            {
                                <span class="dw-chat-tab-badge">@k.Unread</span>
                            }
                        </div>
                        }
                    }
                    @if (!Gorunenler().Any() && !_cevrimdisi)
                    {
                        <div class="dw-chat-empty">Bu firmada başka kullanıcı yok.</div>
                    }
                </div>
            </MudPaper>
        }

        @* ── Alt şerit: konuşma sekmeleri + sabit sohbet düğmesi ── *@
        <div class="dw-chat-bar">
            @foreach (var k in _konusmalar)
            {
                <div class="dw-chat-tab">
                    <span class="dw-dot @(k.Online ? "on" : "off")"></span>
                    <span class="dw-chat-tab-label" @onclick="@(() => PencereAcKapa(k))">@k.Display</span>
                    @if (k.Okunmamis > 0) { <span class="dw-chat-tab-badge">@k.Okunmamis</span> }
                    <span class="dw-chat-tab-close" @onclick="@(() => _konusmalar.Remove(k))" title="Sekmeyi kaldır">✕</span>
                </div>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Chat"
                       OnClick="@(() => { _panelAcik = !_panelAcik; if (_panelAcik) _ = Yokla(); })">
                Sohbet@(_toplamOkunmamis > 0 ? $" ({_toplamOkunmamis})" : "")
            </MudButton>
        </div>
    </div>
}

@code {
    // ⭐ 2026-10-30 — ANLIK SOHBET (kullanıcı isteği; masaüstü ChatViewModel.AnlikDinle ile AYNI): yeni mesaj / okundu olayı sunucunun
    // /api/chat/wait ucundan ANINDA gelir. Aşağıdaki aralıklı yoklama artık YEDEKTİR (eskiden açıkken 3 sn / kapalıyken 20 sn).
    /// <summary>Pencere açıkken yedek yoklama (sn).</summary>
    private const int AcikSaniye = 15;
    /// <summary>Kapalıyken yedek yoklama (sn) — yalnız okunmamış rozeti için.</summary>
    private const int KapaliSaniye = 60;
    /// <summary>Bekleme ucunda en fazla bekleme (sn) — web'in API istemci süresi 30 sn olduğu için 25 değil 20.</summary>
    private const int AnlikBekleSaniye = 20;
    /// <summary>Bekleme ucuna ulaşılamayınca yeniden deneme (sn).</summary>
    private const int AnlikYenidenDeneSaniye = 10;

    private long _anlikSurum;
    private bool _anlikCalisiyor, _birakildi, _bekleyenYoklama;

    private sealed class Kisi
    {
        public string UserId = "", Username = "", Display = "";
        public bool Online;
        public int Unread;
        public long? KarsiOkuduAt;   // 2026-10-29 "Görüldü": karşı tarafın benim mesajlarımı en son okuduğu an
        public string Initial => string.IsNullOrWhiteSpace(Display) ? "?" : Display.Trim()[..1].ToUpperInvariant();
    }

    private sealed class Mesaj
    {
        public string Id = "", Body = "";
        public bool Mine;
        public long CreatedAt;
        public long? ReadAt;
        public string Saat => DateTimeOffset.FromUnixTimeMilliseconds(CreatedAt).LocalDateTime.ToString("HH:mm");
    }

    private sealed class Konusma
    {
        public string UserId = "", Display = "";
        public bool Online, Acik = true;
        public int Okunmamis;
        public string Taslak = "", Hata = "";
        public bool EmojiAcik;
        public string EmojiArama = "";
        public long? SonZaman;
        public long? KarsiOkuduAt;
        public List<Mesaj> Mesajlar = new();
        /// <summary>Masaüstü ChatKisi.GorulduDurumu ile AYNI kural: son mesaj benimse okunduysa "Görüldü HH:mm", değilse "İletildi".</summary>
        public string GorulduMetni
        {
            get
            {
                var son = Mesajlar.Count > 0 ? Mesajlar[^1] : null;
                if (son is null || !son.Mine) return "";
                var okundu = son.ReadAt is { } r && (KarsiOkuduAt is null || r > KarsiOkuduAt) ? r : KarsiOkuduAt;
                if (okundu is { } o && o >= son.CreatedAt)
                {
                    var z = DateTimeOffset.FromUnixTimeMilliseconds(o).LocalDateTime;
                    return "Görüldü " + (z.Date == DateTime.Today ? z.ToString("HH:mm") : z.ToString("dd.MM HH:mm"));
                }
                return "İletildi";
            }
        }
        public string Initial => string.IsNullOrWhiteSpace(Display) ? "?" : Display.Trim()[..1].ToUpperInvariant();
    }

    private readonly List<Kisi> _kisiler = new();
    private readonly List<Konusma> _konusmalar = new();
    private bool _panelAcik, _cevrimdisi, _yoklamaCalisiyor;
    private int _toplamOkunmamis;
    private string _arama = "";
    private Timer? _zamanlayici;

    protected override void OnInitialized()
    {
        // Yetki bilgisi (menü paketi) girişten SONRA, ayrı bir çağrıyla gelir. Bu bileşen giriş
        // anında zaten çizilmiş olabileceği için yetkiye BİR KEZ bakmak yetmez: AuthState değişince
        // yeniden değerlendirilir. Aksi hâlde sohbet ancak sayfa yenilenince görünürdü.
        Auth.Changed += YetkiDegisti;
        ZamanlayiciyiKurGerekirse();
    }

    private void YetkiDegisti()
    {
        ZamanlayiciyiKurGerekirse();
        // AuthState olayı BAŞKA bir devreden de tetiklenebilir; bu devre kapanmışsa StateHasChanged
        // fırlatır ve olay yayıcısına sızarak zincirdeki diğer aboneleri de düşürürdü.
        _ = InvokeAsync(StateHasChanged).ContinueWith(_ => { }, TaskContinuationOptions.OnlyOnFaulted);
    }

    /// <summary>Yetki varsa yoklamayı başlatır. Yetkisiz kullanıcıda tek istek bile atılmaz.</summary>
    private void ZamanlayiciyiKurGerekirse()
    {
        if (_zamanlayici is not null || !Auth.IsAuthenticated) return;
        // ⭐ 2026-09-07 — ZAMANLAYICI GERI CAGRISI HATA SIZDIRMAZ.
        // Timer geri cagrisi async void'dir; buradan kacan bir hata YAKALANAMAZ ve Blazor
        // devresini (circuit) oldurur. Devre olunce SAYFADAKI HICBIR DUGME calismaz:
        // kullanici mesaj gonderemez, geleni goremez, pencereyi KAPATAMAZ. Kullanicinin
        // bildirdigi uc belirti de tam olarak budur. Bu yuzden geri cagri komple sarilir.
        _zamanlayici = new Timer(async _ => { try { await Yokla(); } catch { } }, null,
            TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(KapaliSaniye));
        if (!_anlikCalisiyor) { _anlikCalisiyor = true; _ = AnlikDinle(); }
    }

    /// <summary>Anlık dinleyici: sunucu "yeni sohbet olayı var" deyince HEMEN bir yoklama turu. Hata sızdırmaz (devreyi öldürmesin).</summary>
    private async Task AnlikDinle()
    {
        while (!_birakildi && Auth.IsAuthenticated)
        {
            try
            {
                var e = await Api.GetObjectAsync($"/api/chat/wait?since={_anlikSurum}&sure={AnlikBekleSaniye}");
                if (_birakildi) return;
                _anlikSurum = L(e, "version");
                if (B(e, "changed")) await Yokla();
            }
            catch
            {
                if (_birakildi) return;
                try { await Task.Delay(TimeSpan.FromSeconds(AnlikYenidenDeneSaniye)); } catch { return; }
            }
        }
        _anlikCalisiyor = false;
    }

    private IEnumerable<Kisi> Gorunenler()
    {
        var q = (_arama ?? "").Trim();
        return q.Length == 0
            ? _kisiler
            : _kisiler.Where(k => k.Display.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private sealed record Grup(string Baslik, List<Kisi> Kisiler);

    /// <summary>
    /// Kişiler ÇEVRİM İÇİ / ÇEVRİM DIŞI olarak gruplanır (kullanıcının çizdiği tasarım).
    /// BOŞ grup çizilmez — "Çevrim İçi (0)" başlığı bilgi vermez, yer kaplar.
    /// </summary>
    private List<Grup> Gruplar()
    {
        var gorunen = Gorunenler().ToList();
        var liste = new List<Grup>();
        var ici = gorunen.Where(k => k.Online).ToList();
        var disi = gorunen.Where(k => !k.Online).ToList();
        if (ici.Count > 0) liste.Add(new Grup("Çevrim İçi", ici));
        if (disi.Count > 0) liste.Add(new Grup("Çevrim Dışı", disi));
        return liste;
    }

    private void AraligiAyarla()
    {
        var hizli = _panelAcik || _konusmalar.Any(k => k.Acik);
        var sn = hizli ? AcikSaniye : KapaliSaniye;
        try { _zamanlayici?.Change(TimeSpan.FromSeconds(sn), TimeSpan.FromSeconds(sn)); } catch { }
    }

    private async Task Yokla()
    {
        // Tur sürerken gelen anlık işaret KAYBOLMASIN: tur bitince bir tur daha atılır.
        if (_yoklamaCalisiyor) { _bekleyenYoklama = true; return; }
        _yoklamaCalisiyor = true;
        try
        {
            var arr = await Api.GetArrayAsync("/api/chat/users");
            _cevrimdisi = false;
            _kisiler.Clear();
            foreach (var e in arr)
            {
                _kisiler.Add(new Kisi
                {
                    UserId = S(e, "userId"),
                    Username = S(e, "username"),
                    Display = S(e, "display"),
                    Online = B(e, "online"),
                    Unread = I(e, "unread"),
                    KarsiOkuduAt = e.TryGetProperty("karsiOkuduAt", out var ko) && ko.ValueKind == System.Text.Json.JsonValueKind.Number ? ko.GetInt64() : null,
                });
            }
            _kisiler.Sort((a, b) => a.Online == b.Online
                ? string.Compare(a.Display, b.Display, StringComparison.OrdinalIgnoreCase)
                : (a.Online ? -1 : 1));
            _toplamOkunmamis = _kisiler.Sum(k => k.Unread);

            foreach (var kon in _konusmalar)
            {
                var k = _kisiler.FirstOrDefault(x => x.UserId == kon.UserId);
                if (k is null) continue;
                kon.Online = k.Online;
                kon.KarsiOkuduAt = k.KarsiOkuduAt;
                if (!kon.Acik) kon.Okunmamis = k.Unread;
            }

            foreach (var kon in _konusmalar.Where(x => x.Acik).ToList())
                await KonusmayiTazele(kon);
        }
        catch { _cevrimdisi = true; }
        finally
        {
            _yoklamaCalisiyor = false;
            if (_bekleyenYoklama && !_birakildi) { _bekleyenYoklama = false; _ = Yokla(); }
            // Devre kapandiysa StateHasChanged FIRLATIR; bu hata catch'in DISINDAYDI ve disari
            // sizip devreyi olduruyordu. Artik burada da yutulur (yenileme yapilamamasi olumcul degil).
            try { await InvokeAsync(StateHasChanged); } catch { }
        }
    }

    /// <param name="sesCal">
    /// ⭐ SES: yalnız YOKLAMA turunda true. Konuşmayı AÇARKEN (KisiyiAc) geçmiş yüklenir ve o
    /// mesajların hepsi "yeni" görünür — kullanıcının şartı gereği ("mevcut olanlar için değil")
    /// orada ses ÇALMAZ. Bu ayrım olmadan her pencere açılışında mesaj sesi duyulurdu.
    /// </param>
    private async Task KonusmayiTazele(Konusma kon, bool sesCal = true)
    {
        var yol = $"/api/chat/messages?withUserId={Uri.EscapeDataString(kon.UserId)}"
                  + (kon.SonZaman is { } t ? $"&since={t}" : "");
        var arr = await Api.GetArrayAsync(yol);
        var yeniGeldi = false;
        foreach (var e in arr)
        {
            var id = S(e, "id");
            if (kon.Mesajlar.Any(m => m.Id == id)) continue;
            var m = new Mesaj { Id = id, Body = S(e, "body"), Mine = B(e, "mine"), CreatedAt = L(e, "createdAt"),
                    ReadAt = e.TryGetProperty("readAt", out var ra) && ra.ValueKind == System.Text.Json.JsonValueKind.Number ? ra.GetInt64() : null };
            kon.Mesajlar.Add(m);
            _kaydirilacak.Add(KaydirmaKimligi(kon));   // yeni mesaj eklendi → dibe kaydır
            if (m.CreatedAt > (kon.SonZaman ?? 0)) kon.SonZaman = m.CreatedAt;
            if (!m.Mine) yeniGeldi = true;
        }
        // Pencere açıkken gelen mesaj OKUNMUŞ sayılır (kullanıcı ekrana bakıyor).
        if (yeniGeldi)
        {
            await Api.PostAsync("/api/chat/seen", new { withUserId = kon.UserId });
            kon.Okunmamis = 0;
            // ⭐ SES: YENİ gelen mesaj. Turda kaç mesaj gelirse gelsin TEK ses — 15 mesaj birden
            // düştüğünde 15 kez çalmak kullanılamaz olurdu.
            if (sesCal) await Ses.CalAsync(DepoWise.Application.Notifications.SesTuru.MesajGelen);
        }
    }

    private async Task KisiyiAc(Kisi kisi)
    {
        var kon = _konusmalar.FirstOrDefault(k => k.UserId == kisi.UserId);
        if (kon is null)
        {
            kon = new Konusma { UserId = kisi.UserId, Display = kisi.Display, Online = kisi.Online };
            _konusmalar.Add(kon);
        }
        kon.Acik = true;
        _panelAcik = false;
        AraligiAyarla();

        kon.Mesajlar.Clear();
        kon.SonZaman = null;
        // ⭐ 2026-09-07 — AĞ HATASI DEVREYİ ÖLDÜRMEZ.
        // Blazor Server'da bileşen kodundan KAÇAN her hata devreyi (circuit) kapatır ve sayfadaki
        // HİÇBİR düğme çalışmaz: mesaj gönderilemez, gelen görünmez, pencere KAPANMAZ. Kullanıcının
        // bildirdiği üç belirti de budur. Sohbetin hiçbir işlemi bu riski taşımamalı.
        try
        {
            await KonusmayiTazele(kon, sesCal: false);   // ⭐ SES: geçmiş yükleniyor, ses YOK
            await Api.PostAsync("/api/chat/seen", new { withUserId = kon.UserId });
            kon.Okunmamis = 0;
            await Yokla();
        }
        catch { kon.Hata = ErisimHatasi; }
    }

    /// <summary>Ağ/sunucu erişilemediğinde konuşma penceresinde gösterilen tek metin.</summary>
    private const string ErisimHatasi = "Sohbet sunucuya ulaşamadı. Bağlantı gelince kendiliğinden yenilenir.";

    private void PencereAcKapa(Konusma kon)
    {
        // KAPATMA HER ZAMAN ÇALIŞIR: durum önce değiştirilir, ağ işi sonra ve HATASIZ yapılır.
        kon.Acik = !kon.Acik;
        if (kon.Acik)
        {
            kon.Okunmamis = 0;
            // Eskiden beklenmeyen (fire-and-forget) çağrıydı; içinden kaçan hata yakalanamıyor ve
            // devreyi öldürüyordu → pencere bir daha kapanmıyordu.
            _ = TazeleGuvenli(kon);
        }
        AraligiAyarla();
    }

    /// <summary>Konuşmayı yeniler; hata DIŞARI SIZMAZ (devre korunur), kullanıcıya pencerede söylenir.</summary>
    private async Task TazeleGuvenli(Konusma kon)
    {
        try { await KonusmayiTazele(kon); }
        catch { kon.Hata = ErisimHatasi; }
        finally { try { await InvokeAsync(StateHasChanged); } catch { } }
    }

    /// <summary>
    /// Enter ile gönderme. NOT (2026-09-07): tarayıcı otomasyonuyla yapılan denemede Enter
    /// çalışmıyor GÖRÜNDÜ; ölçünce sebebin uygulamada değil ARAÇTA olduğu anlaşıldı — aracın
    /// ürettiği tuş olayında <c>key</c> alanı BOŞ geliyordu. <c>key='Enter'</c> taşıyan gerçek bir
    /// olayla mesaj sorunsuz gönderildi. Bu yüzden burada değişiklik YAPILMADI.
    /// </summary>
    private async Task EnterIleGonder(KeyboardEventArgs e, Konusma kon)
    {
        if (e.Key == "Enter") await Gonder(kon);
    }

    // ═══ 2026-10-30 EMOJİ — kural ve liste DepoWise.Application.Ui.EmojiKatalogu (masaüstüyle ortak) ═══

    /// <summary>Son seçilen emojiler — BU OTURUMA özel (bileşen alanı; web tek süreçte tüm kullanıcılara hizmet ettiği için static DEĞİL).</summary>
    private readonly List<DepoWise.Application.Ui.EmojiOgesi> _sonEmojiler = new();

    private IReadOnlyList<DepoWise.Application.Ui.EmojiKategori> EmojiKategorileri(Konusma k)
    {
        var bulunan = DepoWise.Application.Ui.EmojiKatalogu.Ara(k.EmojiArama);
        if (!string.IsNullOrWhiteSpace(k.EmojiArama) || _sonEmojiler.Count == 0) return bulunan;
        return new[] { new DepoWise.Application.Ui.EmojiKategori("Son kullanılanlar", _sonEmojiler.ToList()) }.Concat(bulunan).ToList();
    }

    /// <summary>Yazarken BİTEN kısayol (arkasından boşluk) anında emojiye döner.</summary>
    private void TaslakDegisti(Konusma k, string v)
        => k.Taslak = DepoWise.Application.Ui.EmojiKatalogu.Donustur(v ?? "", sonDahil: false);

    private void EmojiEkle(Konusma k, DepoWise.Application.Ui.EmojiOgesi o)
    {
        var t = k.Taslak ?? "";
        k.Taslak = t + (t.Length > 0 && !char.IsWhiteSpace(t[^1]) ? " " : "") + o.Emoji;
        _sonEmojiler.Remove(o);
        _sonEmojiler.Insert(0, o);
        if (_sonEmojiler.Count > 12) _sonEmojiler.RemoveAt(12);
    }

    private async Task Gonder(Konusma kon)
    {
        // Gönderirken metnin SONUNDAKİ kısayol da döner ("tamam :)" + Enter → "tamam 🙂").
        var metin = DepoWise.Application.Ui.EmojiKatalogu.Donustur((kon.Taslak ?? "").Trim(), sonDahil: true);
        kon.EmojiAcik = false;
        if (metin.Length == 0) return;
        kon.Hata = "";
        try
        {
            var err = await Api.PostAsync("/api/chat/messages", new { toUserId = kon.UserId, body = metin });
            if (err is not null) { kon.Hata = err; return; }
            kon.Taslak = "";
            // ⭐ SES: gönderim ONAYLANDIKTAN sonra — "gitti" geri bildirimi. Hatada ses çıkmaz.
            await Ses.CalAsync(DepoWise.Application.Notifications.SesTuru.MesajGiden);
            // Kendi mesajımız geri gelirken GELEN sesi çalmasın: aşağıdaki tur "Mine" mesajlar için
            // zaten ses çıkarmaz (yeniGeldi yalnız karşı tarafın mesajıyla true olur).
            await KonusmayiTazele(kon);
        }
        catch { kon.Hata = ErisimHatasi; }
    }

    // ═══ YENİ MESAJA OTOMATİK KAYDIRMA (kullanıcı isteği 2026-09-07) ═══
    // Konuşma uzayınca yeni mesaj görünmeyen alana düşüyordu; kullanıcı "mesaj gelmedi" sanıyordu.
    // Kaydırma, mesaj EKLENDİĞİ turda ve YALNIZ bir kez yapılır (her çizimde değil).
    private readonly HashSet<string> _kaydirilacak = new();

    private static string KaydirmaKimligi(Konusma k) => "dwchat-" + k.UserId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_kaydirilacak.Count == 0) return;
        var kimlikler = _kaydirilacak.ToArray();
        _kaydirilacak.Clear();
        // JS çağrısı da hata sızdırmamalı: devre kapanırken InvokeVoidAsync fırlatır ve buradan
        // kaçan hata TÜM SAYFAYI öldürür (sohbetin asıl hastalığı buydu).
        foreach (var id in kimlikler)
            try { await JS.InvokeVoidAsync("dwChatScroll", id); } catch { }
    }

    private static string S(JsonElement o, string k)
        => o.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
    private static bool B(JsonElement o, string k)
        => o.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.True;
    private static int I(JsonElement o, string k)
        => o.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetInt32(out var n) ? n : 0;
    private static long L(JsonElement o, string k)
        => o.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetInt64(out var n) ? n : 0L;

    public async ValueTask DisposeAsync()
    {
        // Kapanış da hata sızdırmamalı: burada fırlayan bir hata sayfadan çıkışı bozar.
        _birakildi = true;   // anlık dinleyici bir sonraki dönüşte durur
        try { Auth.Changed -= YetkiDegisti; } catch { }
        try { if (_zamanlayici is not null) await _zamanlayici.DisposeAsync(); } catch { }
    }
}
