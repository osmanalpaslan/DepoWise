    /// <summary>Kullanıcı baş harfleri — üst bardaki avatar rozeti (W2, Aurora Cam v4).
    /// Ad boşsa "K" döner; tek kelimeyse ilk harf, çok kelimeyse ilk + son kelimenin baş harfi.</summary>
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "K";
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 1 ? p[0][..1].ToUpperInvariant()
                             : (p[0][..1] + p[^1][..1]).ToUpperInvariant();
    }
