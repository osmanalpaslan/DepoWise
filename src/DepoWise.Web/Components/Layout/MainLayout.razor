@inherits LayoutComponentBase
@inject AuthState Auth
@inject NavigationManager Nav
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (Auth.IsAuthenticated)
            {
                <span class="me-3">@Auth.CompanyId@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</span>
                <a href="#" @onclick="SignOut" @onclick:preventDefault>Çıkış</a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Beklenmeyen bir hata oluştu.
    <a href="" class="reload">Yeniden yükle</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Guard();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => Guard();

    // Giriş yapılmadıysa login ekranına yönlendir (site açılınca ilk ekran login).
    private void Guard()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        if (!Auth.IsAuthenticated && !string.Equals(path, "/login", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/login");
    }

    private void SignOut()
    {
        Auth.SignOut();
        Nav.NavigateTo("/login");
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
