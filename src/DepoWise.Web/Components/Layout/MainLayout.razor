    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _authInit) return;
        _authInit = true; // yeniden giriş koruması (Auth.Loaded artık restore BİTİNCE set edilir)
        try
        {
            // Kayıtlı tema modunu yükle ve uygula
            try
            {
                var t = await LocalStorage.GetAsync<string>("dw_theme");
                Theme.Mode = t.Success && !string.IsNullOrEmpty(t.Value) ? t.Value : DepoWise.Web.Services.ThemeState.Dark;
                var tc = await LocalStorage.GetAsync<string>("dw_theme_color");
                if (tc.Success && !string.IsNullOrEmpty(tc.Value)) Theme.Color = tc.Value;
                var ts = await LocalStorage.GetAsync<string>("dw_theme_style");
                if (ts.Success && !string.IsNullOrEmpty(ts.Value)) Theme.Style = ts.Value;
            }
            catch { }
            // Kayıtlı kenar menü tercihi (FAZ 6) — temadan bağımsız, kendi try/catch'i var.
            try
            {
                var dr = await LocalStorage.GetAsync<bool>("dw_drawer");
                if (dr.Success) _drawerOpen = dr.Value;
            }
            catch { }
            await ApplyThemeAsync();

            // Yeni sürüm yayınlandıysa: oturumu kapat + taze kodla tam yeniden yükle (manuel CTRL+SHIFT+R gerekmez).
            var ver = await LocalStorage.GetAsync<string>("dw_ver");
            if (ver.Success && !string.IsNullOrEmpty(ver.Value) && ver.Value != DepoWise.Web.AppVersion.Value)
            {
                await LocalStorage.DeleteAsync("dw_auth");
                await LocalStorage.SetAsync("dw_ver", DepoWise.Web.AppVersion.Value);
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }
            await LocalStorage.SetAsync("dw_ver", DepoWise.Web.AppVersion.Value);

            var r = await LocalStorage.GetAsync<string>("dw_auth");
            if (r.Success && !string.IsNullOrEmpty(r.Value))
            {
                var p = r.Value.Split('|');
                if (p.Length >= 4 && !string.IsNullOrEmpty(p[0]))
                {
                    Auth.SignIn(p[0], p[1], p[2], p[3] == "True",
                        p.Length > 4 ? (string.IsNullOrEmpty(p[4]) ? null : p[4]) : null,
                        p.Length > 5 ? (string.IsNullOrEmpty(p[5]) ? null : p[5]) : null,
                        p.Length > 6 ? (string.IsNullOrEmpty(p[6]) ? null : p[6]) : null);
                    await Api.RefreshMenuAsync();
                    await LoadCompaniesAsync();   // üst bar "Aktif Firma" seçicisi (yalnız süper admin)
                    // Kullanıcıya ÖZEL tema (sunucudan) — cihazdan bağımsız, her kullanıcı kendi teması
                    try
                    {
                        var ut = await Api.GetUserThemeAsync();
                        Theme.Mode = ut.Mode; Theme.Color = ut.Color; Theme.Style = ut.Style;
                        await ApplyThemeAsync();
                    }
                    catch { }
                }
            }
        }
        catch { }

        // Oturum geri yükleme TAMAMLANDI → sayfalar artık render edilebilir (token hazır).
        Auth.Loaded = true;

        // Boşta kalma: 20 dk etkileşim olmazsa otomatik çıkış (boş circuit'ler sunucuyu yormasın).
        try
        {
            _idleRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("dwIdle.start", _idleRef, 20 * 60 * 1000);
        }
        catch { }

        Guard();
        await LoadAlertCountAsync();   // BLD-01: oturum hazır → çan sayacı bir kez yüklenir
        await SekmeleriYukleAsync();   // 2026-09-03: açık ekran sekmeleri (sessionStorage'dan) geri gelir
        StateHasChanged();
    }

    // ═══ ARA-01 (ADR-174) — üst bar global arama ═══
    private string _searchQ = "";
    private bool _searchOpen;
    private System.Text.Json.JsonElement[]? _searchGroups;
    // BAR-01: Ctrl+K kısayolunun hedeflediği input id'si (App.razor'daki dinleyiciyle eşleşir).
    private static readonly Dictionary<string, object?> _searchBoxAttrs = new() { ["id"] = "dw-global-search" };

    private async Task RunSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQ) || _searchQ.Trim().Length < 2) { _searchGroups = Array.Empty<System.Text.Json.JsonElement>(); _searchOpen = true; return; }
        var q = _searchQ.Trim();
        _searchGroups = null; _searchOpen = true;
        try { _searchGroups = await Api.GetArrayAsync("/api/search?q=" + Uri.EscapeDataString(q)); }
        catch { _searchGroups = Array.Empty<System.Text.Json.JsonElement>(); }

        // ═══ BAR-01 (ADR-177, PK-O4) — TARA→BUL→GİT: sonuç TAM ve TEK eşleşmeyse (USB okuyucu kodu yazıp
        // Enter basar) panel yerine doğrudan ekrana gidilir. Kural, masaüstündeki
        // SearchService.TekTamEslesme'nin JSON üzerindeki BİREBİR karşılığıdır — kural değişirse İKİSİ
        // birlikte değişir: HasMore'lu grup varsa açılmaz (kırpılan satırlarda ikinci tam eşleşme
        // gizlenmiş olabilir); birden çok tam eşleşme / yalnız kısmi / sıfır sonuç → mevcut panel AYNEN.
        if (_searchGroups is { Length: > 0 } && !_searchGroups.Any(HasMoreG))
        {
            System.Text.Json.JsonElement? tek = null;
            foreach (var h in _searchGroups.SelectMany(SHits))
            {
                var tam = string.Equals(SStr(h, "label"), q, StringComparison.CurrentCultureIgnoreCase)
                          || (!string.IsNullOrEmpty(SStr(h, "subLabel"))
                              && string.Equals(SStr(h, "subLabel"), q, StringComparison.CurrentCultureIgnoreCase));
                if (!tam) continue;
                if (tek is not null) { tek = null; break; }   // ikinci tam eşleşme → otomatik açılış YOK
                tek = h;
            }
            // Kutu temizlenir ki bir SONRAKİ tarama eski kodun ucuna eklenmesin.
            if (tek is { } hit) { _searchQ = ""; OpenSearchHit(SStr(hit, "navigateKey")); }
        }
    }

    private static bool HasMoreG(System.Text.Json.JsonElement g)
        => g.TryGetProperty("hasMore", out var hm) && hm.ValueKind == System.Text.Json.JsonValueKind.True;

    private void OpenSearchHit(string navigateKey)
    {
        _searchOpen = false;
        if (string.IsNullOrEmpty(navigateKey)) return;
        // Bildirimlerle AYNI dönüşüm: masaüstü anahtarı → web rotası ("work_orders"→"work-orders").
        Nav.NavigateTo("/" + navigateKey.Replace(":", "/").Replace("_", "-"));
    }

    private static string SStr(System.Text.Json.JsonElement e, string k)
        => e.ValueKind == System.Text.Json.JsonValueKind.Object && e.TryGetProperty(k, out var v)
           && v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetString() ?? "" : "";
    private static IEnumerable<System.Text.Json.JsonElement> SHits(System.Text.Json.JsonElement g)
        => g.TryGetProperty("hits", out var v) && v.ValueKind == System.Text.Json.JsonValueKind.Array
            ? v.EnumerateArray() : Enumerable.Empty<System.Text.Json.JsonElement>();

    // ═══ BLD-01 (ADR-172) — üst bar bildirim sayacı ═══
    private int _unreadAlerts;
    private string _lastPath = "";

    private async Task LoadAlertCountAsync()
    {
        if (!Auth.IsAuthenticated) { _unreadAlerts = 0; return; }
        try
        {
            var d = await Api.GetObjectAsync("/api/alerts/count");
            _unreadAlerts = d.TryGetProperty("unread", out var u) && u.ValueKind == System.Text.Json.JsonValueKind.Number
                ? u.GetInt32() : 0;
        }
        catch { _unreadAlerts = 0; }
    }

