@inherits LayoutComponentBase
@inject AuthState Auth
@inject ApiClient Api
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject DepoWise.Web.Services.ThemeState Theme
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage LocalStorage
@implements IDisposable

<MudThemeProvider @ref="_mud" Theme="_theme" IsDarkMode="Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        @* Logo — şeffaf, arka plan YOK (yalnız logo). *@
        <img src="logo.png" alt="DepoWise" style="height:48px;width:auto;display:block;margin-right:12px;" />
        <MudText Typo="Typo.h6">DepoWise Yönetim</MudText>
        <MudSpacer />
        @if (Auth.IsAuthenticated)
        {
            <MudTooltip Text="Ekran + tanım bilgisi (ad · kod · ID)">
                <MudIconButton Icon="@Icons.Material.Outlined.Info" Color="Color.Inherit" OnClick="ShowScreenInfo" />
            </MudTooltip>
            <div class="dw-userchip">
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" />
                <div class="dw-userchip-meta">
                    <span class="dw-userchip-name">@(string.IsNullOrEmpty(Auth.UserName) ? "Kullanıcı" : Auth.UserName)</span>
                    <span class="dw-userchip-sub">@Auth.CompanyDisplay@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</span>
                </div>
            </div>
            <MudButton Color="Color.Inherit" Class="dw-logout ml-2" StartIcon="@Icons.Material.Filled.Logout" OnClick="SignOut">Çıkış</MudButton>
        }
    </MudAppBar>
    <MudDrawer Open="true" Elevation="2" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
            @* Oturum tarayıcı deposundan yüklenmeden sayfa render EDİLMEZ. Aksi halde F5/doğrudan URL'de
               sayfalar token'sız API çağrısı yapıp yanlış "kayıt yok" / "yetkisiz" gösteriyordu. *@
            @if (Auth.Loaded)
            {
                @Body
            }
            else
            {
                <div class="d-flex justify-center align-center" style="height:60vh">
                    <MudProgressCircular Indeterminate="true" />
                </div>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudTheme _theme = BuildTheme("#2563eb");

    private static MudTheme BuildTheme(string primary) => new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = primary,
            AppbarBackground = "#1e293b",
            Background = "#0f172a",
            Surface = "#1e293b",
            DrawerBackground = "#111827",
            DrawerText = "#cbd5e1",
        },
        PaletteLight = new PaletteLight
        {
            Primary = primary,
            AppbarBackground = primary,
            AppbarText = "#ffffff",
        },
    };

    private MudThemeProvider _mud = default!;
    private bool _authInit; // OnAfterRenderAsync ilk-çalışma koruması

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Theme.Changed += ApplyThemeAsync;
    }

    /// <summary>Seçili moda göre MudThemeProvider'ı günceller (system → OS tercihi) ve localStorage'a yazar.</summary>
    private async Task ApplyThemeAsync()
    {
        try
        {
            Theme.IsDark = Theme.Mode switch
            {
                DepoWise.Web.Services.ThemeState.Light => false,
                DepoWise.Web.Services.ThemeState.Dark => true,
                _ => await _mud.GetSystemDarkModeAsync(), // system: OS tercihi
            };
            _theme = BuildTheme(Theme.CurrentHex); // seçili renk temasını uygula
            try { await JS.InvokeVoidAsync("dwSetStyle", Theme.Style); } catch { } // görünüm stili (body sınıfı)
            await LocalStorage.SetAsync("dw_theme", Theme.Mode);      // hızlı/çevrimdışı önbellek
            await LocalStorage.SetAsync("dw_theme_color", Theme.Color);
            await LocalStorage.SetAsync("dw_theme_style", Theme.Style);
            // Giriş yapıldıysa kullanıcı hesabına da yaz (her cihazda seninle gelir).
            if (Auth.IsAuthenticated)
                try { await Api.SaveUserThemeAsync(Theme.Mode, Theme.Color, Theme.Style); } catch { }
        }
        catch { }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _authInit) return;
        _authInit = true; // yeniden giriş koruması (Auth.Loaded artık restore BİTİNCE set edilir)
        try
        {
            // Kayıtlı tema modunu yükle ve uygula
            try
            {
                var t = await LocalStorage.GetAsync<string>("dw_theme");
                Theme.Mode = t.Success && !string.IsNullOrEmpty(t.Value) ? t.Value : DepoWise.Web.Services.ThemeState.Dark;
                var tc = await LocalStorage.GetAsync<string>("dw_theme_color");
                if (tc.Success && !string.IsNullOrEmpty(tc.Value)) Theme.Color = tc.Value;
                var ts = await LocalStorage.GetAsync<string>("dw_theme_style");
                if (ts.Success && !string.IsNullOrEmpty(ts.Value)) Theme.Style = ts.Value;
            }
            catch { }
            await ApplyThemeAsync();

            // Yeni sürüm yayınlandıysa: oturumu kapat + taze kodla tam yeniden yükle (manuel CTRL+SHIFT+R gerekmez).
            var ver = await LocalStorage.GetAsync<string>("dw_ver");
            if (ver.Success && !string.IsNullOrEmpty(ver.Value) && ver.Value != DepoWise.Web.AppVersion.Value)
            {
                await LocalStorage.DeleteAsync("dw_auth");
                await LocalStorage.SetAsync("dw_ver", DepoWise.Web.AppVersion.Value);
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }
            await LocalStorage.SetAsync("dw_ver", DepoWise.Web.AppVersion.Value);

            var r = await LocalStorage.GetAsync<string>("dw_auth");
            if (r.Success && !string.IsNullOrEmpty(r.Value))
            {
                var p = r.Value.Split('|');
                if (p.Length >= 4 && !string.IsNullOrEmpty(p[0]))
                {
                    Auth.SignIn(p[0], p[1], p[2], p[3] == "True",
                        p.Length > 4 ? (string.IsNullOrEmpty(p[4]) ? null : p[4]) : null,
                        p.Length > 5 ? (string.IsNullOrEmpty(p[5]) ? null : p[5]) : null,
                        p.Length > 6 ? (string.IsNullOrEmpty(p[6]) ? null : p[6]) : null);
                    await Api.RefreshMenuAsync();
                    // Kullanıcıya ÖZEL tema (sunucudan) — cihazdan bağımsız, her kullanıcı kendi teması
                    try
                    {
                        var ut = await Api.GetUserThemeAsync();
                        Theme.Mode = ut.Mode; Theme.Color = ut.Color; Theme.Style = ut.Style;
                        await ApplyThemeAsync();
                    }
                    catch { }
                }
            }
        }
        catch { }

        // Oturum geri yükleme TAMAMLANDI → sayfalar artık render edilebilir (token hazır).
        Auth.Loaded = true;

        // Boşta kalma: 20 dk etkileşim olmazsa otomatik çıkış (boş circuit'ler sunucuyu yormasın).
        try
        {
            _idleRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("dwIdle.start", _idleRef, 20 * 60 * 1000);
        }
        catch { }

        Guard();
        StateHasChanged();
    }

    private DotNetObjectReference<MainLayout>? _idleRef;

    /// <summary>JS idle izleyici 20 dk hareketsizlikte çağırır → çıkış + login (circuit tam kapanır, sunucu rahatlar).</summary>
    [JSInvokable]
    public async Task OnIdleTimeout()
    {
        if (!Auth.IsAuthenticated) return;
        try { await JS.InvokeVoidAsync("dwIdle.stop"); } catch { }
        Auth.SignOut();
        try { await LocalStorage.DeleteAsync("dw_auth"); } catch { }
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => Guard();

    private void Guard()
    {
        if (!Auth.Loaded) return;
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        if (!Auth.IsAuthenticated && !string.Equals(path, "/login", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/login");
    }

    // Route → ekran adı eşlemesi (ilk segment). "Kod" = ham route.
    private static readonly Dictionary<string, string> ScreenLabels = new()
    {
        ["materials"] = "Malzemeler", ["stock"] = "Stok Giriş-Çıkış / Sayım", ["vehicles"] = "Araçlar",
        ["vehicle-templates"] = "Araç Genel Tanım", ["inspection"] = "Muayene / Sigorta",
        ["personnel"] = "Personel", ["daily"] = "Günlük Faaliyet", ["maintenance"] = "Bakım Takibi",
        ["fuel"] = "Yakıt", ["requests"] = "Talepler", ["reports"] = "Raporlar", ["definitions"] = "Tanım Düzenle",
        ["users"] = "Kullanıcılar", ["permissions"] = "Yetkiler", ["permission-templates"] = "Yetki Şablonları",
        ["branches"] = "Şube / Şantiye", ["audit"] = "Sistem Logu", ["backup"] = "Yedek Yönetimi",
        ["developer"] = "Geliştirici Modu", ["companies"] = "Firma Tanım", ["releases"] = "Güncelleme Yönetimi",
        ["machines"] = "Makine Yönetimi", ["server-backups"] = "Sunucu Yedekleri", ["dashboard"] = "Ana Ekran",
    };

    private async Task ShowScreenInfo()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/');
        var seg = string.IsNullOrEmpty(path) ? "dashboard" : path.Split('/')[0];
        var name = ScreenLabels.TryGetValue(seg, out var l) ? l : seg;
        var parms = new DialogParameters
        {
            ["ScreenName"] = name,
            ["ScreenCode"] = "/" + path,
        };
        await DialogService.ShowAsync<ScreenInfoDialog>("Ekran Bilgisi", parms,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
    }

    private async Task SignOut()
    {
        Auth.SignOut();
        try { await LocalStorage.DeleteAsync("dw_auth"); } catch { }
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Theme.Changed -= ApplyThemeAsync;
        _idleRef?.Dispose();
    }
}
