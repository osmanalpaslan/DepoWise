@inherits LayoutComponentBase
@inject AuthState Auth
@inject ApiClient Api
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject DepoWise.Web.Services.ThemeState Theme
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage LocalStorage
@implements IDisposable

<MudThemeProvider @ref="_mud" Theme="_theme" IsDarkMode="Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudTooltip Text="Menüyü aç / kapat">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                           Edge="Edge.Start" OnClick="ToggleDrawer" />
        </MudTooltip>
        @* Logo — şeffaf, arka plan YOK (yalnız logo). *@
        @* Yükseklik/çerçeve app.css §3'ten gelir (üst barda okunur plaka). *@
        <img src="logo.png" alt="Alpnex" />
        <MudText Typo="Typo.h6">Alpnex Yönetim</MudText>
        <MudSpacer />
        @if (Auth.IsAuthenticated)
        {
            @* AKTİF FİRMA (yalnız süper admin) — oturumun firmasını değiştirir; tüm ekranlar bu firmada çalışır.
               Firma kimliği ekranlardan DEĞİL, sunucunun verdiği oturumdan gelir (CLAUDE.md §4). *@
            @if (Auth.IsSuperAdmin && _companies.Count > 0)
            {
                <MudTooltip Text="Aktif firma — tüm ekranlar seçtiğiniz firmada çalışır">
                    <MudSelect T="string" Value="Auth.CompanyId" ValueChanged="SwitchCompany" Dense="true" Margin="Margin.Dense"
                               Variant="Variant.Outlined" Class="dw-companyswitch mr-2" Style="min-width:210px;"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Business" Disabled="_switching">
                        @foreach (var c in _companies) { <MudSelectItem T="string" Value="@c.Id">@c.Name</MudSelectItem> }
                    </MudSelect>
                </MudTooltip>
            }
            @* ⭐ ARA-01 (ADR-174) — GLOBAL ARAMA: Enter ile arar (anlık öneri yok, min 2 karakter).
               Yeni yetki modülü YOK — sonuçlar SUNUCUDA kaynak modül yetkisi + kapsamdan süzülür. *@
            @* ⭐ MOB-W (2026-09-04) — TELEFONDA ÜST BARDA DEĞİL, MENÜDE.
               Arama kutusu 180 px sabittir ve tek başına bildirim/araçlar/kullanıcı/çıkış
               düğmelerini ekran dışına itiyordu. Daraltıp "dokununca açılan" bir kutuya çevirmek
               denendi ve BAŞARISIZ oldu (kutu 44 px'te kalıyordu) — üstelik 44 px'lik bir kutuya
               yazmak zaten kullanışlı değil. Bu yüzden telefonda arama, MENÜNÜN İÇİNE tam
               genişlikte taşındı (aşağıdaki MudDrawer bloğu). İşlev kaybı YOK, aksine kullanılır.
               Geniş ekranda hiçbir şey değişmez.

               ⚠ Görünürlük CSS medya sorgusuyla yapılır, `MudHidden` ile DEĞİL: MudHidden kırılım
               noktasını JavaScript'ten öğrenir; denemede geniş ekranda arama kutusunu TAMAMEN
               kaybettirdi (kırılım bilgisi güncellenmeyince "gizli" varsayıyor). Medya sorgusu
               tarayıcının kendi ölçüsüdür, şaşmaz. İki kopya da DOM'da durur, aynı anda yalnız
               biri görünür; ikisi de aynı `_searchQ` alanına bağlıdır. *@
            <div class="dw-appbar-search" style="position:relative;margin-right:8px;">
                @* BAR-01: input id'si Ctrl+K odak kısayolu içindir (App.razor'daki dinleyici bu id'ye odaklanır). *@
                <MudTextField T="string" @bind-Value="_searchQ" Placeholder="Ara… (Enter)" Margin="Margin.Dense"
                              Variant="Variant.Outlined" Class="dw-companyswitch" Style="min-width:180px;"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              UserAttributes="_searchBoxAttrs"
                              Immediate="true" OnKeyUp="@(async e => { if (e.Key == "Enter") await RunSearch(); })" />
                @if (_searchOpen)
                {
                    <MudPaper Elevation="8" Class="pa-2"
                              Style="position:absolute;top:44px;right:0;width:380px;max-height:60vh;overflow-y:auto;z-index:1400;">
                        @if (_searchGroups is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
                        else if (_searchGroups.Length == 0) { <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">Sonuç yok.</MudText> }
                        else
                        {
                            @foreach (var g in _searchGroups)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary px-2 mt-1" Style="font-weight:600;">@SStr(g, "moduleDisplay")</MudText>
                                @foreach (var h in SHits(g))
                                {
                                    <MudButton FullWidth="true" Class="justify-start px-2" Size="Size.Small"
                                               OnClick="@(() => OpenSearchHit(SStr(h, "navigateKey")))">
                                        <MudText Typo="Typo.body2">@SStr(h, "label")@(string.IsNullOrEmpty(SStr(h, "subLabel")) ? "" : $" · {SStr(h, "subLabel")}")</MudText>
                                    </MudButton>
                                }
                                @if (g.TryGetProperty("hasMore", out var hm) && hm.ValueKind == System.Text.Json.JsonValueKind.True)
                                {
                                    <MudButton FullWidth="true" Class="justify-start px-2" Size="Size.Small" Color="Color.Primary"
                                               OnClick="@(() => OpenSearchHit(SStr(g, "navigateKey")))">Daha fazlası için ekrana git…</MudButton>
                                }
                            }
                        }
                        <MudButton FullWidth="true" Size="Size.Small" Class="mt-1" OnClick="@(() => _searchOpen = false)">Kapat</MudButton>
                    </MudPaper>
                }
            </div>
            @* ⭐ BLD-01 (ADR-172) — BİLDİRİM ÇANI: aktif VE okunmamış bildirim sayısı; tıkla → Uyarılar.
               Sayaç her sayfa geçişinde DEĞİL, oturum başında + Uyarılar ekranından dönünce tazelenir. *@
            <MudTooltip Text="Bildirimler — okunmamış uyarı sayısı">
                <MudBadge Content="@_unreadAlerts" Visible="@(_unreadAlerts > 0)" Color="Color.Error" Overlap="true" Class="mr-1">
                    <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit"
                                   OnClick="@(() => Nav.NavigateTo("/alerts"))" />
                </MudBadge>
            </MudTooltip>
            @* ⭐ LOG-01 (kullanıcı isteği 2026-08-27) — EKRAN ARAÇLARI.
               Aktif ekrana ÖZEL işlemler tek menüde: kayıt geçmişi (log) + ekran bilgisi.
               Eskiden tek başına duran "i" düğmesi buraya taşındı. *@
            <MudTooltip Text="Bu ekrana ait araçlar: kayıt geçmişi ve ekran bilgisi">
                <MudMenu Icon="@Icons.Material.Outlined.Tune" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight" Dense="true">
                    @if (CanShowScreenLog)
                    {
                        <MudMenuItem Icon="@Icons.Material.Outlined.History" OnClick="ShowScreenLog">
                            Kayıt Geçmişi — @CurrentScreenName
                        </MudMenuItem>
                        <MudDivider />
                    }
                    <MudMenuItem Icon="@Icons.Material.Outlined.Info" OnClick="ShowScreenInfo">Ekran Bilgisi</MudMenuItem>
                </MudMenu>
            </MudTooltip>
            <div class="dw-userchip">
                @* W2 (Aurora Cam v4): genel kullanıcı ikonu yerine baş harf rozeti. *@
                <span class="dw-avatar">@Initials(Auth.UserName)</span>
                <div class="dw-userchip-meta">
                    <span class="dw-userchip-name">@(string.IsNullOrEmpty(Auth.UserName) ? "Kullanıcı" : Auth.UserName)</span>
                    <span class="dw-userchip-sub">@Auth.CompanyDisplay@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</span>
                </div>
            </div>
            <MudButton Color="Color.Inherit" Class="dw-logout ml-2" StartIcon="@Icons.Material.Filled.Logout" OnClick="SignOut">Çıkış</MudButton>
        }
    </MudAppBar>
    @* ⭐ MOB-W (2026-09-04) — MENÜ DAR EKRANDA ÜSTE BİNER, İÇERİĞİ İTMEZ.
       Eskiden `Persistent`ti: menü açıkken içeriği YANA İTİYORDU. Telefonda (~390 px) menü 240 px
       yer kapladığı için ekranda içeriğe ~150 px kalıyordu — yani menü açıkken ekran kullanılamazdı.
       `Responsive`: geniş ekranda bugünkü davranış AYNEN sürer (yan yana, içerik iter);
       `Breakpoint.Md` altında menü içeriğin ÜSTÜNE açılan bir katman olur ve seçim yapınca kapanır. *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always">
        @* MOB-W: telefonda GLOBAL ARAMA burada — üst barda yer yok (yukarıdaki nota bakın).
           Menü zaten içeriğin üstüne açılan bir katman olduğu için tam genişlikte kullanılabilir.
           Geniş ekranda CSS ile gizlenir (app.css §18.3) — MudHidden KULLANILMAZ, gerekçe üst bardaki notta. *@
        <div class="dw-mobil-arama px-3 pt-3">
                <MudTextField T="string" @bind-Value="_searchQ" Placeholder="Kayıtlarda ara… (Enter)"
                              Margin="Margin.Dense" Variant="Variant.Outlined" FullWidth="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              OnKeyUp="@(async e => { if (e.Key == "Enter") await RunSearch(); })" />
                @if (_searchOpen)
                {
                    <MudPaper Elevation="0" Class="pa-1 mt-1"
                              Style="max-height:46vh;overflow-y:auto;background:var(--dw-surface-2);">
                        @if (_searchGroups is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
                        else if (_searchGroups.Length == 0) { <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">Sonuç yok.</MudText> }
                        else
                        {
                            @foreach (var g in _searchGroups)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary px-2 mt-1" Style="font-weight:600;">@SStr(g, "moduleDisplay")</MudText>
                                @foreach (var h in SHits(g))
                                {
                                    <MudButton FullWidth="true" Class="justify-start px-2" Size="Size.Small"
                                               OnClick="@(() => OpenSearchHit(SStr(h, "navigateKey")))">
                                        <MudText Typo="Typo.body2">@SStr(h, "label")@(string.IsNullOrEmpty(SStr(h, "subLabel")) ? "" : $" · {SStr(h, "subLabel")}")</MudText>
                                    </MudButton>
                                }
                                @if (g.TryGetProperty("hasMore", out var hm2) && hm2.ValueKind == System.Text.Json.JsonValueKind.True)
                                {
                                    <MudButton FullWidth="true" Class="justify-start px-2" Size="Size.Small" Color="Color.Primary"
                                               OnClick="@(() => OpenSearchHit(SStr(g, "navigateKey")))">Daha fazlası için ekrana git…</MudButton>
                                }
                            }
                        }
                        <MudButton FullWidth="true" Size="Size.Small" Class="mt-1" OnClick="@(() => _searchOpen = false)">Kapat</MudButton>
                    </MudPaper>
                }
        </div>
        <NavMenu @ref="_navMenu" />
    </MudDrawer>
    <MudMainContent>
        @* ═══ AÇIK EKRAN SEKMELERİ — ŞERİT ÜSTTE (kullanıcı tasarımı 2026-09-04) ═══
           Şerit 2026-09-03'te sayfanın ALTINDA sabitti; kullanıcının çizdiği tasarımda üst başlığın
           HEMEN ALTINDA. Buraya taşındı ve `sticky` yapıldı → sayfa kaydırılınca da görünür kalır
           (eski "hep görünür" davranışı korunur, yalnız yeri değişti).
           Görünüm masaüstü şeridiyle BİREBİR aynı dildedir: grup ikonu + etiket + ✕, aktif sekmede
           kehribar yazı/ikon ve İÇERİĞE BAKAN kenarda 2 px çizgi (webde şerit üstte olduğu için ALT kenar).
           Liste yine sessionStorage'da: sayfa yenilemede kalır, tarayıcı sekmesi kapanınca sıfırlanır. *@
        @if (Auth.Loaded && Auth.IsAuthenticated && _ekranSekmeleri.Count > 0)
        {
            <div class="dw-sekme-serit">
                @foreach (var sekme in _ekranSekmeleri)
                {
                    var aktif = SekmeAktifMi(sekme);
                    var yerel = sekme;
                    <div class="@($"dw-sekme{(aktif ? " dw-sekme-aktif" : "")}")">
                        <button type="button" class="dw-sekme-ana" title="Bu ekrana dön"
                                @onclick="@(() => SekmeyeGit(yerel))">
                            <MudIcon Icon="@SekmeIkon(yerel)" Class="dw-sekme-ikon" />
                            <span class="dw-sekme-yazi">@yerel.Label</span>
                        </button>
                        <button type="button" class="dw-sekme-kapat"
                                title="Sekmeyi kaldır (ekran verisi silinmez)"
                                @onclick="@(() => SekmeKapat(yerel))">✕</button>
                    </div>
                }
                @* ⭐ "Yeni Sekme" düğmesi KALDIRILDI (kullanıcı isteği 2026-09-06):
                   "yeni sekme alanını tamamen kaldıralım". Masaüstünde de kaldırıldı — iki şerit
                   AYNI parçaları taşımak zorundadır (bkz. SekmeSeridiTests SEK4). Yaptığı tek iş
                   soldaki ekran aramasına odaklanmaktı; o kutu menüde zaten duruyor. *@
            </div>
        }

        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
            @* Oturum tarayıcı deposundan yüklenmeden sayfa render EDİLMEZ. Aksi halde F5/doğrudan URL'de
               sayfalar token'sız API çağrısı yapıp yanlış "kayıt yok" / "yetkisiz" gösteriyordu. *@
            @* ⭐ BAG-01 (denetim 2026-08-26) — SUNUCUYA ULAŞILAMIYOR UYARISI.
               Sunucu kapalıyken ekran boş kalıyor ve kullanıcıya SEBEP söylenmiyordu ("uygulama bozuldu"
               sanılıyordu). Bayrak YALNIZ taşıma katmanı hatasında (bağlantı yok / zaman aşımı) yanar;
               401/403/500 gibi GERÇEK sunucu yanıtları bunu tetiklemez → yetki hatası ile ağ hatası
               karışmaz. Oturuma dokunulmaz: burada çıkış YAPTIRILMAZ. *@
            @if (Api.SunucuyaUlasilamiyor)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                    <div class="d-flex align-center" style="gap:12px;flex-wrap:wrap">
                        <span>
                            <b>Sunucuya ulaşılamıyor.</b>
                            İnternet bağlantınızı kontrol edin. Oturumunuz açık kalmaya devam ediyor;
                            bağlantı gelince kaldığınız yerden devam edebilirsiniz.
                        </span>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                   OnClick="TekrarDene">TEKRAR DENE</MudButton>
                    </div>
                </MudAlert>
            }

            @if (Auth.Loaded)
            {
                @* ═══ G5 — DEEP-LINK KORUMASI (2026-08-12) ═══
                   Menüden gizlemek YETMEZ: kullanıcı adresi elle yazarak ekranı açmaya çalışabilir.
                   Platform kapalıysa sayfa RENDER EDİLMEZ. Mesaj, yetkisizlik mesajıyla AYNI tondadır
                   (bilgi sızıntısı yapmamak için "böyle bir ekran var ama kapalı" ayrıntısına girilmez). *@
                @if (!Auth.PlatformOpenForRoute(CurrentRoute()))
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-6">
                        Bu ekran bu uygulamada kullanıma kapatılmış. Yöneticinize başvurun.
                    </MudAlert>
                }
                else
                {
                    @Body
                }
            }
            else
            {
                <div class="d-flex justify-center align-center" style="height:60vh">
                    <MudProgressCircular Indeterminate="true" />
                </div>
            }
        </MudContainer>

    </MudMainContent>

    @* ⭐ 2026-09-06 (kullanıcı isteği): uygulama içi sohbet. MainLayout'ta durur ki HER SAYFADA
       erişilebilsin ve sayfa değişince kaybolmasın. Kendisi position:fixed olduğu için sayfa
       yerleşimine girmez — "ekranda fazladan yer işgal etmemeli" şartı bu şekilde karşılanır.
       Yetkisi olmayan kullanıcıda bileşen hiç çizilmez. *@
    <ChatDock />
</MudLayout>

@code {
    // ── AKTİF FİRMA seçici (yalnız süper admin) ──────────────────────────────────────────────
    private List<ApiClient.Opt> _companies = new();
    private bool _switching;

    /// <summary>Süper adminin firma listesini yükler (üst bar seçicisi). Diğer roller için hiç çağrılmaz.</summary>
    private async Task LoadCompaniesAsync()
    {
        if (!Auth.IsSuperAdmin) { _companies = new(); return; }
        try { _companies = await Api.OptionsAsync("/api/companies/options", "id", "name"); } catch { _companies = new(); }
    }

    /// <summary>Aktif firmayı değiştirir: sunucu YENİ bir oturum jetonu (token) üretir → firma artık güvenilir
    /// oturum bilgisinden gelir. Şube bağlamı sıfırlanır (şubeler firmaya özeldir) ve sayfa tazelenir.</summary>
    private async Task SwitchCompany(string? companyId)
    {
        if (string.IsNullOrEmpty(companyId) || companyId == Auth.CompanyId || _switching) return;
        var name = _companies.FirstOrDefault(c => c.Id == companyId)?.Name ?? companyId;
        if (!await DialogService.Confirm(
                $"Aktif firma '{name}' olarak değiştirilsin mi?\n\nTüm ekranlar bu firmada çalışacak; kayıtlar bu firmaya yazılır.",
                okText: "Evet, Geç")) return;
        _switching = true;
        try
        {
            var (err, data) = await Api.SelectCompanyAsync(Auth.Token!, companyId);
            if (err is not null || data is null)
            {
                Snackbar.Add("Firma değiştirilemedi: " + (err ?? "bilinmeyen hata"), Severity.Error);
                return;
            }
            // Şube DAİMA sıfırlanır: eski firmanın şubesi yeni firmada geçersizdir (yanlış şubeye kayıt riski).
            Auth.SignIn(data.Token, data.UserId, data.CompanyId, data.IsSuperAdmin,
                branchId: null, companyName: data.CompanyName, userName: Auth.UserName);
            try
            {
                await LocalStorage.SetAsync("dw_auth",
                    $"{Auth.Token}|{Auth.UserId}|{Auth.CompanyId}|{Auth.IsSuperAdmin}||{Auth.CompanyName}|{Auth.UserName}");
            }
            catch { }
            await Api.RefreshMenuAsync();
            // Açık ekranı yeni firmayla baştan yükle (eski firmanın listeleri ekranda kalmasın).
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        finally { _switching = false; }
    }

    private MudTheme _theme = BuildTheme("#F5A623");   // Aurora markası: kehribar (kullanıcı Tema'dan değiştirebilir)

    // Aurora paleti. Primary kullanıcının Tema ekranından seçtiği renktir (varsayılan kehribar).
    private static MudTheme BuildTheme(string primary) => new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = primary,
            Background = "#0D1220",
            BackgroundGray = "#0A0F1B",
            Surface = "#151B2B",
            AppbarBackground = "#111828",
            AppbarText = "#EAEEF7",
            DrawerBackground = "#0F1524",
            DrawerText = "#C3CCDD",
            DrawerIcon = "#7B8AA6",
            TextPrimary = "#EAEEF7",
            TextSecondary = "#8B98B2",
            TextDisabled = "#5D6C88",
            ActionDefault = "#8B98B2",
            ActionDisabled = "#4E5C78",
            Divider = "rgba(255,255,255,0.08)",
            DividerLight = "rgba(255,255,255,0.05)",
            LinesDefault = "rgba(255,255,255,0.08)",
            LinesInputs = "rgba(255,255,255,0.14)",
            TableLines = "rgba(255,255,255,0.07)",
            Success = "#2CBF6D",
            Warning = "#F5A623",
            Error = "#E24A3B",
            Info = "#3AA0E0",
        },
        PaletteLight = new PaletteLight
        {
            Primary = primary,
            Background = "#F7F8FB",
            BackgroundGray = "#EEF1F6",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",   // artık primary DEĞİL: beyaz cam üst bar
            AppbarText = "#14171C",
            DrawerBackground = "#F1F3F8",
            DrawerText = "#3A4152",
            DrawerIcon = "#6B7385",
            TextPrimary = "#14171C",
            TextSecondary = "#5B6474",
            Divider = "#E3E6ED",
            DividerLight = "#EDEFF4",
            LinesDefault = "#E3E6ED",
            LinesInputs = "#D5D9E2",
            TableLines = "#EBEDF3",
            Success = "#12A85C",
            Warning = "#D2870A",
            Error = "#D0392B",
            Info = "#2A85C8",
        },
    };

    private MudThemeProvider _mud = default!;
    private bool _authInit; // OnAfterRenderAsync ilk-çalışma koruması

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Theme.Changed += ApplyThemeAsync;
        Api.BaglantiDurumuDegisti += BaglantiDegisti;   // BAG-01 (Dispose'ta çözülür)
    }

    /// <summary>G5 — adres çubuğundaki route (baştaki '/' ve sorgu dizesi olmadan).
    /// <c>AppScreens.ByWebRoute</c> bu biçimi bekler.</summary>
    private string CurrentRoute()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri);
        var q = rel.IndexOfAny(new[] { '?', '#' });
        return q < 0 ? rel : rel[..q];
    }

    /// <summary>Seçili moda göre MudThemeProvider'ı günceller (system → OS tercihi) ve localStorage'a yazar.</summary>
    private async Task ApplyThemeAsync()
    {
        try
        {
            Theme.IsDark = Theme.Mode switch
            {
                DepoWise.Web.Services.ThemeState.Light => false,
                DepoWise.Web.Services.ThemeState.Dark => true,
                _ => await _mud.GetSystemDarkModeAsync(), // system: OS tercihi
            };
            _theme = BuildTheme(Theme.CurrentHex); // seçili renk temasını uygula
            try { await JS.InvokeVoidAsync("dwSetStyle", Theme.Style); } catch { } // görünüm stili (body sınıfı)
            await LocalStorage.SetAsync("dw_theme", Theme.Mode);      // hızlı/çevrimdışı önbellek
            await LocalStorage.SetAsync("dw_theme_color", Theme.Color);
            await LocalStorage.SetAsync("dw_theme_style", Theme.Style);
            // Giriş yapıldıysa kullanıcı hesabına da yaz (her cihazda seninle gelir).
            if (Auth.IsAuthenticated)
                try { await Api.SaveUserThemeAsync(Theme.Mode, Theme.Color, Theme.Style); } catch { }
        }
        catch { }
        StateHasChanged();
    }

    // ── Kenar menü açık/kapalı (kullanıcı tercihi, cihaz bazlı) ──────────────
    private bool _drawerOpen = true;

