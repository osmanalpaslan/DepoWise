    // ═══ AÇIK EKRAN SEKMELERİ (kullanıcı isteği 2026-09-03) ══════════════════════════════════════

    private NavMenu? _navMenu;

    /// <summary>Sekmenin ikonu — ekranın AİT OLDUĞU GRUBUN menü ikonu (kullanıcı tasarımı 2026-09-04).
    /// Sekmede ayrı bir ikon seti tutulmaz: menüde ne görülüyorsa sekmede de o görülür. Eşleme
    /// <see cref="NavMenu.WebIcon"/>'da tek yerde durur → iki liste ayrışamaz. Rota katalogda
    /// yoksa nötr klasör ikonu gelir (sekme ikonsuz kalmaz).</summary>
    private static string SekmeIkon(EkranSekmesi sekme)
        => NavMenu.WebIcon(DepoWise.Application.Security.AppScreens.ByWebRoute(sekme.Route)?.Group ?? "");

    private sealed record EkranSekmesi(string Route, string Label);
    private List<EkranSekmesi> _ekranSekmeleri = new();
    private bool _sekmelerYuklendi;

    /// <summary>Gezinilen rota → sekme. Rota tam eşleşmezse İLK PARÇASIYLA ekran aranır (ör.
    /// "maintenance/records" → "maintenance"); katalogda olmayan rota (login, ana ekran) sekme OLMAZ.</summary>
    private void SekmeEkle(string route)
    {
        if (!Auth.Loaded || !Auth.IsAuthenticated) return;
        route = route.Trim('/');
        if (route.Length == 0 || route.StartsWith("login", StringComparison.OrdinalIgnoreCase)) return;
        var ekran = DepoWise.Application.Security.AppScreens.ByWebRoute(route)
                 ?? DepoWise.Application.Security.AppScreens.ByWebRoute(route.Split('/')[0]);
        if (ekran is null || !ekran.OnWeb || string.IsNullOrEmpty(ekran.WebRoute)) return;
        if (_ekranSekmeleri.Any(t => t.Route == ekran.WebRoute)) return;
        _ekranSekmeleri.Add(new EkranSekmesi(ekran.WebRoute!, ekran.Label));
        _ = SekmeleriSaklaAsync();
    }

    private bool SekmeAktifMi(EkranSekmesi sekme)
    {
        var r = CurrentRoute().Trim('/');
        return r == sekme.Route || r.StartsWith(sekme.Route + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void SekmeyeGit(EkranSekmesi sekme) => Nav.NavigateTo("/" + sekme.Route);

    private void SekmeKapat(EkranSekmesi sekme)
    {
        _ekranSekmeleri.Remove(sekme);
        _ = SekmeleriSaklaAsync();
        // Aktif sekme kapatıldıysa kullanıcı boşlukta kalmaz: son sekmeye, o da yoksa ana ekrana.
        if (SekmeAktifMi(sekme))
            Nav.NavigateTo(_ekranSekmeleri.Count > 0 ? "/" + _ekranSekmeleri[^1].Route : "/");
    }

    /// <summary>Sekmeler sessionStorage'da durur: sayfa yenilemede (forceLoad dahil) KAYBOLMAZ,
    /// tarayıcı sekmesi kapanınca kendiliğinden SIFIRLANIR. Hata sessizdir — şerit süs, veri değil.</summary>
    private async Task SekmeleriSaklaAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", "dwEkranSekmeleri",
                System.Text.Json.JsonSerializer.Serialize(_ekranSekmeleri.Select(t => t.Route).ToList()));
        }
        catch { }
    }

    private async Task SekmeleriYukleAsync()
    {
        if (_sekmelerYuklendi) return;
        _sekmelerYuklendi = true;
        try
        {
            var ham = await JS.InvokeAsync<string?>("sessionStorage.getItem", "dwEkranSekmeleri");
            if (string.IsNullOrEmpty(ham)) { SekmeEkle(CurrentRoute()); return; }
            foreach (var rota in System.Text.Json.JsonSerializer.Deserialize<List<string>>(ham!) ?? new())
                SekmeEkle(rota);   // katalogda doğrulanarak eklenir (bozuk/eski değer sessizce elenir)
            SekmeEkle(CurrentRoute());
            StateHasChanged();
        }
        catch { }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Guard();
        SekmeEkle(CurrentRoute());   // kullanıcı isteği 2026-09-03: açılan ekran alt şeride eklenir
        _searchOpen = false;   // ARA-01: sayfa değişince sonuç paneli kapanır
        // BLD-01: Uyarılar ekranından AYRILINCA sayaç tazelenir (okundu işaretleri yansısın);
        // diğer sayfa geçişlerinde API ÇAĞRILMAZ (performans kuralı).
        var p = CurrentRoute();
        if (_lastPath.StartsWith("alerts", StringComparison.Ordinal) && !p.StartsWith("alerts", StringComparison.Ordinal))
            _ = InvokeAsync(async () => { await LoadAlertCountAsync(); StateHasChanged(); });
        _lastPath = p;
    }

    private void Guard()
    {
        if (!Auth.Loaded) return;
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        if (!Auth.IsAuthenticated && !string.Equals(path, "/login", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/login");
    }

