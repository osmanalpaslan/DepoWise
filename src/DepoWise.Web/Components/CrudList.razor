@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">@Title</MudText>

    @if (CanCreate)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Style="max-width:460px;">
            <MudTextField @bind-Value="_new" Placeholder="@($"Yeni {Title}")" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" />
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Add" Disabled="_busy">Ekle</MudButton>
        </MudStack>
    }
    @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mb-2">@_msg</MudAlert> }

    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Kayıt yok.</MudText> }
    else
    {
        <MudTable Items="_rows" Dense="true" Hover="true" Striped="true">
            <HeaderContent><MudTh>Ad</MudTh>@if (CanDelete) { <MudTh Style="width:80px" /> }</HeaderContent>
            <RowTemplate>
                <MudTd>@Name(context)</MudTd>
                @if (CanDelete)
                {
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => Del(Id(context))" />
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string ListPath { get; set; } = "";
    [Parameter, EditorRequired] public string ModuleKey { get; set; } = "";
    [Parameter] public string CreatePath { get; set; } = "";
    [Parameter] public string DeletePrefix { get; set; } = "";
    [Parameter] public string CreateField { get; set; } = "name";
    [Parameter] public string NameField { get; set; } = "name";

    private JsonElement[]? _rows;
    private string _new = "";
    private string? _msg; private bool _ok; private bool _busy;

    private bool CanCreate => !string.IsNullOrEmpty(CreatePath) && Auth.CanCreate(ModuleKey);
    private bool CanDelete => !string.IsNullOrEmpty(DeletePrefix) && Auth.CanDelete(ModuleKey);

    protected override async Task OnInitializedAsync() { if (Auth.IsAuthenticated) await Load(); }

    private async Task Load()
    {
        try { _rows = await Api.GetArrayAsync(ListPath); }
        catch (Exception ex) { _msg = "Yüklenemedi: " + ex.Message; _ok = false; _rows = Array.Empty<JsonElement>(); }
    }

    private async Task Add()
    {
        _msg = null;
        if (string.IsNullOrWhiteSpace(_new)) return;
        if (!await Dialog.Confirm($"\"{_new.Trim()}\" eklensin mi?")) return;
        _busy = true;
        try
        {
            var err = await Api.PostAsync(CreatePath, new Dictionary<string, string> { [CreateField] = _new.Trim() });
            _ok = err is null; _msg = err ?? "Eklendi.";
            if (_ok) { _new = ""; await Load(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task Del(string id)
    {
        if (string.IsNullOrEmpty(id)) return;
        _msg = null;
        if (!await Dialog.Confirm("Bu kayıt silinsin mi?", "Evet, Sil", danger: true)) return;
        var err = await Api.DeleteAsync($"{DeletePrefix}/{id}");
        _ok = err is null; _msg = err ?? "Silindi.";
        if (_ok) await Load();
    }

    private string Name(JsonElement r) => Get(r, NameField);
    private static string Id(JsonElement r) => r.ValueKind == JsonValueKind.Object && r.TryGetProperty("id", out var v) ? v.GetString() ?? "" : "";
    private string Get(JsonElement r, string f) => r.ValueKind == JsonValueKind.Object && r.TryGetProperty(f, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
}
