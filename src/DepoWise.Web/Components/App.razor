@*  ============================================================================
    App.razor — TEK KRİTİK DEĞİŞİKLİK: stil yükleme SIRASI.

    ⚠ ÖNCEKİ SÜRÜMDEKİ HATA:
        app.css, MudBlazor.min.css'ten ÖNCE yükleniyordu. CSS'te eşit özgüllükte
        (specificity) son gelen kural kazandığı için app.css'teki .mud-* kuralları
        MudBlazor'ın kendi kurallarına yeniliyordu. Sonuç: yalnız kendi <style>
        bloğunu taşıyan Login ekranı değişti, diğer 39 ekran eski haliyle kaldı.

    ✅ DÜZELTME: app.css ve DepoWise.Web.styles.css artık MudBlazor.min.css'ten
        SONRA yükleniyor. Başka hiçbir şey değişmedi — script'ler, HeadOutlet,
        Routes, dwKillAutofill, dwReadColWidths, dwDownload, dwSetStyle, dwIdle
        birebir aynı.
    ============================================================================ *@
<!DOCTYPE html>
<html lang="tr" translate="no">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <meta http-equiv="Content-Language" content="tr" />
    <base href="/" />

    @* 1) Temel/harici stiller ÖNCE *@
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    @* 2) BİZİM stillerimiz EN SON — MudBlazor'ı ezebilmesi için (kritik) *@
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="DepoWise.Web.styles.css" />

    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="apple-touch-icon" href="favicon.png" />
    <style>
        /* ===== Görünüm Stilleri (Tema → Görünüm Stili) — Aurora tabanı =====
           Sınıf adları SABİT: dwSetStyle ve ThemeState.Styles bunlara bağlı. */

        /* Yumuşak: daha yuvarlak + ferah */
        body.dw-soft .mud-paper, body.dw-soft .mud-card { border-radius: 20px !important; }
        body.dw-soft .mud-navmenu .mud-nav-link { border-radius: 13px; min-height: 40px; }
        body.dw-soft .mud-button-root { border-radius: 13px; }
        body.dw-soft .mud-table { border-radius: 18px; }
        body.dw-soft .dw-panel { border-radius: 20px; }
        body.dw-soft .mud-input.mud-input-outlined .mud-input-outlined-border { border-radius: 13px !important; }

        /* Canlı: kehribar ışımalı üst bar + belirgin vurgu */
        body.dw-gradient .mud-appbar {
            background-image: linear-gradient(90deg,
                color-mix(in srgb, var(--mud-palette-primary) 26%, transparent) 0%,
                color-mix(in srgb, var(--mud-palette-primary) 7%, transparent) 55%,
                transparent 100%) !important;
        }
        body.dw-gradient .mud-button-filled.mud-button-filled-primary {
            box-shadow: 0 10px 26px color-mix(in srgb, var(--mud-palette-primary) 36%, transparent) !important;
        }
        body.dw-gradient .mud-navmenu .mud-nav-link.active,
        body.dw-gradient .mud-navmenu .mud-nav-link.mud-nav-link-active { box-shadow: inset 3px 0 0 0 var(--mud-palette-primary); }

        /* Kompakt: sık + ince (bilgi yoğun ekranlar) */
        body.dw-compact .mud-paper, body.dw-compact .mud-card { border-radius: 10px !important; }
        body.dw-compact .mud-navmenu .mud-nav-link { min-height: 32px; padding-top: 5px; padding-bottom: 5px; }
        body.dw-compact .mud-table-cell { padding-top: 4px !important; padding-bottom: 4px !important; font-size: .8rem; }
        body.dw-compact .dw-grid th, body.dw-compact .dw-grid td { height: 28px; padding: 3px 7px; }
        body.dw-compact .pa-6 { padding: 14px !important; }
        body.dw-compact .pa-4 { padding: 10px !important; }
        body.dw-compact .mud-appbar .mud-toolbar { min-height: 54px; }
        body.dw-compact .dw-page-head { margin-bottom: 12px; }
    </style>
    <HeadOutlet @rendermode="new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false)" />
</head>

<body class="notranslate">
    <Routes @rendermode="new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        // Tarayıcı otomatik-doldurmasını (Chrome/Edge "reklam", "'" vb.) kesin kapat:
        // autocomplete=off + name/id rastgeleleştir + parola yöneticisi ignore işaretleri.
        window.dwKillAutofill = () => {
            const fix = el => {
                if (!el || (el.tagName !== 'INPUT' && el.tagName !== 'TEXTAREA')) return;
                if (el.dataset.nofillDone) return;
                el.setAttribute('autocomplete', 'off');
                el.setAttribute('data-lpignore', 'true');
                el.setAttribute('data-1p-ignore', '');
                el.setAttribute('data-form-type', 'other');
                if (el.type !== 'password') el.setAttribute('name', 'nf_' + Math.random().toString(36).slice(2));
                el.dataset.nofillDone = '1';
            };
            document.querySelectorAll('input,textarea').forEach(fix);
            try {
                const obs = new MutationObserver(muts => {
                    for (const m of muts) for (const n of m.addedNodes) {
                        if (n.nodeType !== 1) continue;
                        if (n.matches && (n.matches('input') || n.matches('textarea'))) fix(n);
                        if (n.querySelectorAll) n.querySelectorAll('input,textarea').forEach(fix);
                    }
                });
                obs.observe(document.documentElement, { childList: true, subtree: true });
            } catch (e) { }
        };
        document.addEventListener('DOMContentLoaded', () => window.dwKillAutofill());
        window.addEventListener('load', () => window.dwKillAutofill());

        // Excel-benzeri grid: kullanıcı başlıkları sürükleyip genişlettikten sonra her kolonun
        // güncel piksel genişliğini (data-key → width) okur — "Genişlikleri kaydet" bunu sunucuya yollar.
        window.dwReadColWidths = (tableId) => {
            const t = document.getElementById(tableId);
            if (!t) return {};
            const out = {};
            t.querySelectorAll('thead th[data-key]').forEach(th => {
                const k = th.getAttribute('data-key');
                if (k) out[k] = Math.round(th.getBoundingClientRect().width);
            });
            return out;
        };

        window.dwDownload = (name, b64, mime) => {
            const bin = atob(b64); const len = bin.length; const bytes = new Uint8Array(len);
            for (let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
            const blob = new Blob([bytes], { type: mime || 'application/octet-stream' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url; a.download = name; document.body.appendChild(a); a.click();
            document.body.removeChild(a); setTimeout(() => URL.revokeObjectURL(url), 1500);
        };

        // Görünüm stili: body'ye dw-<stil> sınıfı ekler (classic = sınıfsız).
        window.dwSetStyle = function (name) {
            var b = document.body;
            b.classList.remove('dw-soft', 'dw-gradient', 'dw-compact');
            if (name && name !== 'classic') b.classList.add('dw-' + name);
        };

        // Boşta kalma (idle) izleyici: belirtilen süre boyunca etkileşim olmazsa .NET'e OnIdleTimeout çağrılır.
        window.dwIdle = (function () {
            let timer = null, ref = null, ms = 1200000;
            const evts = ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click', 'wheel'];
            function fire() { if (ref) { try { ref.invokeMethodAsync('OnIdleTimeout'); } catch (e) { } } }
            function reset() { if (timer) clearTimeout(timer); if (ref) timer = setTimeout(fire, ms); }
            return {
                start: function (dotnet, millis) {
                    ref = dotnet; ms = millis || 1200000;
                    evts.forEach(e => document.addEventListener(e, reset, { passive: true }));
                    reset();
                },
                stop: function () {
                    if (timer) clearTimeout(timer); timer = null; ref = null;
                    evts.forEach(e => document.removeEventListener(e, reset));
                }
            };
        })();
    </script>
</body>

</html>
