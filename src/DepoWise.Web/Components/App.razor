<body class="notranslate">
    <Routes @rendermode="new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        // Kullanıcı isteği (2026-09-02): bilgi panelindeki "Tam Düzenleme" YENİ SEKMEDE açılsın.
        // true → yeni sekme açıldı · false → engellendi (çağıran aynı sekmede açarak geri düşer).
        window.dwOpenInNewTab = (url) => {
            // NOT: 'noopener' pencere-özelliği olarak verilirse window.open ŞARTNAME GEREĞİ null döner;
            // o zaman "engellendi" sanıp aynı sekmede de açardık (çift açılma). Bu yüzden özellik olarak
            // verilmez, opener referansı sonradan koparılır.
            try {
                const w = window.open(url, '_blank');
                if (!w) return false;
                try { w.opener = null; } catch (e) { }
                return true;
            } catch (e) { return false; }
        };

        // Tarayıcı otomatik-doldurmasını (Chrome/Edge "reklam", "'" vb.) kesin kapat:
        // autocomplete=off + name/id rastgeleleştir + parola yöneticisi ignore işaretleri.
        window.dwKillAutofill = () => {
            const fix = el => {
                if (!el || (el.tagName !== 'INPUT' && el.tagName !== 'TEXTAREA')) return;
                if (el.dataset.nofillDone) return;
                el.setAttribute('autocomplete', 'off');
                el.setAttribute('data-lpignore', 'true');
                el.setAttribute('data-1p-ignore', '');
                el.setAttribute('data-form-type', 'other');
                if (el.type !== 'password') el.setAttribute('name', 'nf_' + Math.random().toString(36).slice(2));
                el.dataset.nofillDone = '1';
            };
            document.querySelectorAll('input,textarea').forEach(fix);
            try {
                const obs = new MutationObserver(muts => {
                    for (const m of muts) for (const n of m.addedNodes) {
                        if (n.nodeType !== 1) continue;
                        if (n.matches && (n.matches('input') || n.matches('textarea'))) fix(n);
                        if (n.querySelectorAll) n.querySelectorAll('input,textarea').forEach(fix);
                    }
                });
                obs.observe(document.documentElement, { childList: true, subtree: true });
            } catch (e) { }
        };
        document.addEventListener('DOMContentLoaded', () => window.dwKillAutofill());
        window.addEventListener('load', () => window.dwKillAutofill());

        // Sütun genişletme (kullanıcı isteği 2026-08-08): .dw-col-grip tutamağı sürüklenince ilgili <th>'in
        // genişliğini CANLI ayarlar (table-layout:fixed → kolon takip eder). DELEGE edilmiş tek dinleyici →
        // Blazor yeniden render'ıyla çatışmaz, dinamik satırlar/raporlar için de çalışır. Genişlik OTURUM-İÇİDİR
        // (kaydedilmez; her login standart). CSS 'resize' table-cell'de çalışmadığından bu yöntem kullanılır.
        // ⚠️ DÜZELTME 2026-08-26 — genişlik <th>'e DEĞİL, <col>'a yazılır.
        // Eskiden th.style.width ayarlanıyordu ama hücrelerde metni "…" ile kesmek için kullanılan
        // 'max-width: 0' kuralı bu genişliği sıfıra kırpıyordu → tarayıcı kolon genişliklerini yok
        // sayıp tabloyu eşit bölüyordu. Sonuç: tutamak sürükleniyor, HİÇBİR ŞEY değişmiyordu.
        // <col> genişliği 'max-width'ten etkilenmez ve fixed düzende kolonun TEK belirleyicisidir.
        document.addEventListener('pointerdown', function (e) {
            const grip = e.target && e.target.closest ? e.target.closest('.dw-col-grip') : null;
            if (!grip) return;
            const th = grip.closest('th');
            const table = th && th.closest('table');
            if (!th || !table) return;
            // Bu başlık kaçıncı sütun? Aynı sıradaki <col> onun genişliğini taşır.
            const sira = Array.prototype.indexOf.call(th.parentElement.children, th);
            const col = table.querySelectorAll('col')[sira];
            if (!col) return;
            e.preventDefault(); e.stopPropagation();
            const startX = e.clientX, startW = th.offsetWidth;
            try { grip.setPointerCapture(e.pointerId); } catch (_) { }
            function onMove(ev) { col.style.width = Math.max(60, Math.min(700, startW + (ev.clientX - startX))) + 'px'; }
            function onUp() {
                document.removeEventListener('pointermove', onMove);
                document.removeEventListener('pointerup', onUp);
            }
            document.addEventListener('pointermove', onMove);
            document.addEventListener('pointerup', onUp);
        }, true);

        // BAR-01 (ADR-177): Ctrl+K → üst bar global arama kutusuna odak (USB barkod/QR okuyucuyla
        // taramadan önce tek tuş). Tarayıcının kendi Ctrl+K davranışı geçersiz kılınır; kutu yoksa
        // (giriş ekranı) hiçbir şey yapılmaz. Metin seçilir → yeni tarama eskisini ezer.
        document.addEventListener('keydown', e => {
            if ((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey && (e.key === 'k' || e.key === 'K')) {
                const el = document.getElementById('dw-global-search');
                if (el) { e.preventDefault(); el.focus(); if (el.select) el.select(); }
            }
        });

        window.dwDownload = (name, b64, mime) => {
            const bin = atob(b64); const len = bin.length; const bytes = new Uint8Array(len);
            for (let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
            const blob = new Blob([bytes], { type: mime || 'application/octet-stream' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url; a.download = name; document.body.appendChild(a); a.click();
            document.body.removeChild(a); setTimeout(() => URL.revokeObjectURL(url), 1500);
        };

        // Görünüm stili: body'ye dw-<stil> sınıfı ekler (classic = sınıfsız).
        window.dwSetStyle = function (name) {
            var b = document.body;
            b.classList.remove('dw-soft', 'dw-gradient', 'dw-compact');
            if (name && name !== 'classic') b.classList.add('dw-' + name);
        };

        // Boşta kalma (idle) izleyici: belirtilen süre boyunca etkileşim olmazsa .NET'e OnIdleTimeout çağrılır.
        window.dwIdle = (function () {
            let timer = null, ref = null, ms = 1200000;
            const evts = ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click', 'wheel'];
            function fire() { if (ref) { try { ref.invokeMethodAsync('OnIdleTimeout'); } catch (e) { } } }
            function reset() { if (timer) clearTimeout(timer); if (ref) timer = setTimeout(fire, ms); }
            return {
                start: function (dotnet, millis) {
                    ref = dotnet; ms = millis || 1200000;
                    evts.forEach(e => document.addEventListener(e, reset, { passive: true }));
                    reset();
                },
                stop: function () {
                    if (timer) clearTimeout(timer); timer = null; ref = null;
                    evts.forEach(e => document.removeEventListener(e, reset));
                }
            };
        })();
    </script>
</body>

</html>

@code {
    /// <summary>
    /// Stil dosyalarının önbellek etiketi. Derlemenin ÜRETİM ZAMANINDAN türetilir: her yeni yayın
    /// yeni bir değer üretir, aynı yayın içinde ise sabit kalır (böylece önbellek işini yapmaya
    /// devam eder). Elle güncellenmesi gereken bir sürüm numarası DEĞİLDİR — unutulamaz.
    /// </summary>
    private static readonly string StilSurumu =
        System.IO.File.GetLastWriteTimeUtc(typeof(App).Assembly.Location).Ticks.ToString("x");
}