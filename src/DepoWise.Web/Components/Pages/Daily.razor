@page "/daily"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@* BKM-04: malzemenin çekildiği depo seçenekleri *@
@inject LocationOptions Locations
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Günlük Faaliyet</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

@if (Auth.CanCreate("daily_activity"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:880px;">
        @* E1.3/ZB-6: bölüm başlığı ortak forma dili (.dw-formsection). *@
        <div class="dw-formsection" style="border-top:none; margin-top:0; padding-top:0;">YENİ KAYIT</div>
        <MudGrid Spacing="2">
            <MudItem xs="6" md="3">
                @* 2026-09-03 (kullanıcı isteği): seçenekler YETKİYE göre süzülür (/api/daily/allowed-types;
                   asıl liste süzmesi serviste — yan kapı yok). Hiç tip anahtarı verilmemiş kullanıcı
                   hepsini görür (geçiş güvenli). "Depo Çıkışı" tip değildir → daima listelenir. *@
                <MudSelect T="string" @bind-Value="_kind" Label="Kayıt Tipi" Margin="Margin.Dense" Variant="Variant.Outlined">
                    @foreach (var secenek in _kindOptions)
                    {
                        <MudSelectItem T="string" Value="@secenek">@secenek</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="ApiClient.Opt" Label="@(_kind == "Depo Çıkışı" ? "Araç (opsiyonel)" : "Araç *")" @bind-Value="_vehicle" SearchFunc="SearchVehicle"
                                 ToStringFunc="@(o => o?.Name ?? "")" Placeholder="İç kod / plaka ara..." Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true" />
            </MudItem>
            <MudItem xs="6" md="3"><MudDatePicker @bind-Date="_date" Label="Tarih" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>

        @if (_kind == "Hareket" || _kind == "Transfer")
        {
            <MudGrid Spacing="2">
                <MudItem xs="6" md="3"><LookupSelect Label="Kaynak Şube / Şantiye" @bind-Value="_from" Items="_branches" /></MudItem>
                <MudItem xs="6" md="3"><LookupSelect Label="Hedef Şube / Şantiye" @bind-Value="_to" Items="_branches" /></MudItem>
                <MudItem xs="6" md="3"><LookupSelect Label="Operatör / Şoför" @bind-Value="_operator" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" /></MudItem>
                <MudItem xs="6" md="3"><MudNumericField T="int?" @bind-Value="_duration" Label="Süre (gün)" Min="0" Format="0" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
            @if (_kind == "Transfer") { <MudText Typo="Typo.caption" Class="mud-text-secondary">Transfer: araç otomatik PASİF duruma alınır.</MudText> }
        }
        else if (_kind == "Depo Çıkışı")
        {
            @* Depo Çıkışı (MALZEME) — Giriş-Çıkış ile AYNI ortak servis (/api/stock/issue|transfer). Şube İçi =
               çıkış, Şube Dışı = transfer. Araç faaliyet "Transfer"inden (yukarıda) BAĞIMSIZ. (kullanıcı 2026-08-07) *@
            <MudRadioGroup T="string" @bind-Value="_exitScope" Class="mb-1 ml-1">
                <MudRadio T="string" Value="@("Şube İçi")" Color="Color.Secondary" Dense="true">Şube İçi Çıkış</MudRadio>
                <MudRadio T="string" Value="@("Şube Dışı")" Color="Color.Secondary" Dense="true">Şube Dışı Çıkış (Transfer)</MudRadio>
            </MudRadioGroup>
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" md="6"><MudAutocomplete T="ApiClient.Opt" Label="Malzeme *" @bind-Value="_exitMaterial" SearchFunc="SearchMaterial" ToStringFunc="@(o => o?.Name ?? "")" Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true" /></MudItem>
                <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_exitQty" Label="Çıkacak Miktar" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                @if (_exitScope == "Şube Dışı")
                {
                    <MudItem xs="6" md="3"><LookupSelect Label="Hedef Şube / Şantiye *" @bind-Value="_exitTo" Items="_branches" /></MudItem>
                }
                else
                {
                    <MudItem xs="6" md="3"><LookupSelect Label="Teslim Alan (Personel)" @bind-Value="_exitPersonnel" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" /></MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudGrid Spacing="2">
                @if (_kind == "Bakım")
                {
                    <MudItem xs="6" md="4"><LookupSelect Label="Bakım Tanımı *" @bind-Value="_mDefId" Items="_defOpts" /></MudItem>
                    <MudItem xs="6" md="4"><LookupSelect Label="Alt Bakım" @bind-Value="_mSubId" Items="_mSubOpts" CreatePath="/api/maintenance/definitions" CreateField="name" ExtraField="parentDefId" ExtraValue="@_mDefId" OnAdded="ReloadMSub" Disabled="@(string.IsNullOrEmpty(_mDefId))" /></MudItem>
                }
                <MudItem xs="6" md="4"><LookupSelect Label="Teknisyen" @bind-Value="_mTech" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" /></MudItem>
                <MudItem xs="6" md="3"><MudNumericField T="decimal?" @bind-Value="_mKm" Label="Yapılma KM" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="3"><MudNumericField T="decimal?" @bind-Value="_mHour" Label="Yapılma Saat" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Malzemeler (varsayılan: merkez depo stoğundan düşülür)</MudText>
            @* BKM-04 / KARAR-9: malzemenin çekildiği depo. Varsayılan giriş şubesi, kullanıcı değiştirebilir
               ve seçimi korunur. "Atanmamış" yeni yazma hedefi olarak SUNULMAZ. *@
            <MudGrid Spacing="2" Class="align-center mb-1">
                @if (_mLocations.Count > 0)
                {
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_mLocationId" Label="Malzemenin çekildiği depo" Margin="Margin.Dense" Variant="Variant.Outlined"
                                   HelperText="Stok bu depodan düşülür. Varsayılan, giriş yaptığınız şubedir.">
                            @foreach (var lo in _mLocations) { <MudSelectItem T="string" Value="@lo.Id">@lo.Name</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Firmanızda tanımlı depo/şantiye yok. Kayıt yine de oluşturulur; malzemeler <b>"Atanmamış"</b> olarak düşülür.
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" md="6"><MudAutocomplete T="ApiClient.Opt" Label="Malzeme ara (kod/ad)" @bind-Value="_matSel" SearchFunc="SearchMaterial" ToStringFunc="@(o => o?.Name ?? "")" Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true" /></MudItem>
                <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_matQty" Label="Miktar" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="3"><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddMaterial">Ekle</MudButton></MudItem>
            </MudGrid>
            @if (_lines.Count > 0)
            {
                @* E1.3/ZB-4: kalem listesi kart içinde, başlık bandıyla. *@
                <MudPaper Elevation="0" Class="dw-card mt-2" Style="max-width:520px;">
                    <div class="dw-card-head">EKLENEN MALZEMELER</div>
                <MudSimpleTable Dense="true" Style="max-width:520px;">
                    <tbody>
                        @foreach (var l in _lines)
                        {
                            <tr>
                                <td>@l.Name</td>
                                <td>@l.Qty</td>
                                <td>
                                    @* Bakım ekranıyla AYNI seçenek (2026-08-08). *@
                                    <MudCheckBox T="bool" Value="l.FromTeamStock" ValueChanged="@((bool v) => l.FromTeamStock = v)"
                                                 Dense="true" Label="Bakım Ekibi Stoğundan Kullanıldı" />
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block" Style="margin-left:32px;">
                                        İşaretlenirse merkez depo stoklarından düşülmez.
                                    </MudText>
                                </td>
                                <td><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _lines.Remove(l))" /></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                </MudPaper>
            }
        }

        @* İlave Yağ/Filtre/Tamir arıza-onarım türleridir → "Açıklama" bu türlerde "Arıza Açıklaması" olarak
           gösterilir (kullanıcı isteği 2026-07-19). Aynı alana (description) yazılır; şema değişmez. *@
        <MudGrid Spacing="2" Class="mt-1"><MudItem xs="12"><MudTextField @bind-Value="_desc" Label="@DescLabel" Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem></MudGrid>

        <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="Clear">İptal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_busy">Kaydet</MudButton>
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

<MudPaper Class="pa-4" Elevation="2">
    <div @oncontextmenu="OpenColumnPicker" @oncontextmenu:preventDefault="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6">Faaliyetler</MudText>
            <MudTooltip Text="Kolonları ayarla (bu alanda sağ tık da açar) — yalnız sizin için geçerlidir">
                <MudIconButton Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" OnClick="OpenColumnPicker" />
            </MudTooltip>
            <MudSpacer />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Sayfa boyutu</MudText>
            <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true" Style="max-width:90px">
                @foreach (var sz in PageSizes) { <MudSelectItem T="int" Value="@sz">@sz</MudSelectItem> }
            </MudSelect>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="ApplyFilters">Filtrele</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearFilters">Temizle</MudButton>
            <MudTooltip Text="Aktif filtrelerle eşleşen TÜM faaliyetleri (yalnız bu sayfayı değil) Excel dosyası olarak indirir">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                           Disabled="@_exporting" OnClick="ExportExcel">Excel'e Aktar</MudButton>
            </MudTooltip>
            @* K3: iptal edilen faaliyetler varsayılan GİZLİ — masaüstüyle aynı. *@
            <MudCheckBox T="bool" Value="_showCancelled" ValueChanged="ToggleCancelled" Label="İptal edilenleri göster" Dense="true" />
        </MudStack>
    </div>

    @* İş #5: yalnız YAN ETKİSİZ alanlar. Stok/araç durumu değişecekse iptal edip yeniden girin. *@
@if (_editId is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:620px;">
        <MudText Typo="Typo.subtitle1" Class="mb-1">FAALİYET KAYDINI DÜZENLE</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
            Yalnız açıklama, operatör ve süre düzeltilebilir. Stok veya araç durumu değişecekse kaydı iptal edip yeniden girin.
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12"><MudTextField @bind-Value="_editDescription" Label="Açıklama" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><LookupSelect Label="Operatör / Şoför" @bind-Value="_editOperator" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int?" @bind-Value="_editDuration" Label="Süre (gün)" Min="0" Format="0" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        @if (_editError is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_editError</MudAlert> }
        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEdit">Kaydet</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => _editId = null)">Vazgeç</MudButton>
        </MudStack>
    </MudPaper>
}

@if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Filtre kriterine uygun faaliyet bulunamadı.</MudText> }
    else
    {
        <div style="overflow-x:auto;">
        <table id="daily-grid" class="dw-grid">
            @* Sütun genişliği <col>'dan gelir (düzeltme 2026-08-26). Hücreye "width" yazmak İŞE YARAMIYORDU:
               hücrelerde metni "…" ile kesmek için gereken max-width:0, o genişliği sıfıra kırpıyordu. *@
            <colgroup>
                @foreach (var key in _visibleColumns)
                {
                    <col data-key="@key" style="width:140px" />
                }
                <col style="width:70px" />   @* islem kolonu — basliktaki ek sutunun karsiligi *@
            </colgroup>
            <thead><tr>
                @foreach (var key in _visibleColumns)
                {
                    @* ⠿ tutamağı sürükle = kolonu taşı; başlık metnine tıkla = sırala; sağ kenar = genişlik. *@
                    <th data-key="@key" style="@ThStyle(key)"
                        @ondragover:preventDefault="true" @ondrop="@(() => OnDropColumn(key))">
                        <div class="dw-th">
                            <span title="Sürükleyerek kolonu taşı" draggable="true"
                                  @ondragstart="@(() => _dragKey = key)"
                                  style="cursor:grab;opacity:.45;margin-right:4px;user-select:none;">⠿</span>
                            <span style="cursor:pointer;flex:1 1 auto;" @onclick="@(() => ToggleSort(key))">@Label(key).ToUpperInvariant()</span>
                            <span class="dw-sort">@SortArrow(key)</span>
                        </div>
                        <span class="dw-col-grip"></span>@* sağ kenardan sürükle = genişlet/daralt (oturum-içi) *@
                    </th>
                }
                <th style="width:70px;"><div class="dw-th" style="cursor:default;"></div></th>
            </tr>
            <!-- Başlık-altı filtre satırı (kullanıcı isteği 2026-08-06, madde 4) — bkz. Materials.razor aynı yorum.
                 "Tarih" bilinçli olarak filtresiz (boş hücre; yalnız başlığa tıklayarak sıralanır). -->
            <tr>
                @foreach (var key in _visibleColumns)
                {
                    @if (key == DailyActivityListColumns.Date)
                    {
                        <th style="@ThStyle(key)" class="dw-filter-th"></th>
                    }
                    else
                    {
                        <th style="@ThStyle(key)" class="dw-filter-th">
                            <MudTooltip Text="İçerir araması">
                                <MudTextField T="string" Value="@GetFilter(key)" ValueChanged="@((string v) => SetFilter(key, v))"
                                              Placeholder="içerir…"
                                              Immediate="false" OnKeyUp="OnFilterKey"
                                              Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" />
                            </MudTooltip>
                        </th>
                    }
                }
                <th style="width:70px;" class="dw-filter-th"></th>
            </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    var cancelled = Bool(row, "isCancelled");
                    <tr style="@(cancelled ? "opacity:.55;text-decoration:line-through;" : "")">
                        @foreach (var key in _visibleColumns) { <td title="@CellText(row, key)">@Dash(CellText(row, key))</td> }
                        <td>
                            @if (cancelled)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">İptal edildi</MudChip>
                            }
                            else if (Auth.CanDelete("daily_activity"))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => BeginEdit(row))">Düzenle</MudButton>
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => Delete(row))">İptal Et</MudButton>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        @* Sayfalama TABLONUN ALTINDA, SOLDA (kullanıcı isteği 2026-07-19: tüm tablolu ekranlar). *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap" Justify="Justify.FlexStart">
            <MudPagination Count="@_totalPages" Selected="@_page" SelectedChanged="OnPageChanged"
                           BoundaryCount="1" MiddleCount="3" ShowFirstButton="true" ShowLastButton="true" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_totalCount kayıt — sayfa @_page / @_totalPages</MudText>
        </MudStack>
    }
</MudPaper>

@code {
    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };

    private string _kind = "Hareket";

    /// <summary>2026-09-03 — Kayıt Tipi seçenekleri (yetkiye göre). Sunucudan gelen izinli anahtarlar
    /// Türkçe etikete çevrilir; okunamzsa TÜM seçenekler gösterilir (görünürlük süsü — asıl kapı serviste).</summary>
    private List<string> _kindOptions = new() { "Hareket", "Transfer", "Bakım", "İlave Yağ", "İlave Filtre", "Tamir", "Depo Çıkışı" };

    private async Task LoadKindOptions()
    {
        try
        {
            var izinli = (await Api.GetArrayAsync("/api/daily/allowed-types"))
                .Select(e => e.GetString() ?? "").Where(x => x.Length > 0)
                .ToHashSet(StringComparer.Ordinal);
            var secenekler = new List<string>();
            foreach (var (key, label) in DepoWise.Application.Ui.DailyActivityTypeOptions.All)
                if (izinli.Contains(key)) secenekler.Add(label);
            secenekler.Add("Depo Çıkışı");   // tip değil (stok işlemi) → daima listede
            _kindOptions = secenekler;
            if (!_kindOptions.Contains(_kind)) _kind = _kindOptions[0];
        }
        catch { /* liste okunamadı → tüm seçenekler; asıl süzme serviste */ }
    }
    private ApiClient.Opt? _vehicle;
    private DateTime? _date;
    private string _desc = "";
    private string DescLabel => _kind is "İlave Yağ" or "İlave Filtre" or "Tamir" ? "Arıza Açıklaması" : "Açıklama";
    // movement
    private string? _from, _to, _operator;
    private int? _duration;
    // Depo Çıkışı (malzeme) — Giriş-Çıkış ile aynı ortak servis
    private string _exitScope = "Şube İçi";
    private ApiClient.Opt? _exitMaterial;
    private decimal _exitQty;
    private string? _exitTo, _exitPersonnel;
    // maintenance
    private string? _mDefId, _mSubId, _mTech;
    private decimal? _mKm, _mHour;
    private ApiClient.Opt? _matSel; private decimal _matQty;
    private readonly List<Line> _lines = new();
    // ── BKM-04 / KARAR-9: malzemenin çekildiği depo (bakım + İlave Yağ/Filtre/Tamir) ─────────────
    /// <summary>Yazma hedefleri — YALNIZ gerçek depolar ("Atanmamış"/"Tüm Şubeler" burada YOK).</summary>
    private IReadOnlyList<LocationOption> _mLocations = Array.Empty<LocationOption>();
    /// <summary>Kullanıcının seçtiği depo; varsayılan oturum şubesidir ama sonradan <c>Auth.BranchId</c>
    /// ile EZİLMEZ — kullanıcının değişikliği olduğu gibi sunucuya gider (KARAR-9).</summary>
    private string? _mLocationId;
    private string? DefaultLocationId() => _mLocations.Any(x => x.Id == Auth.BranchId) ? Auth.BranchId : null;
    private string LocationText => string.IsNullOrEmpty(_mLocationId)
        ? "Atanmamış (depo seçilmedi)"
        : _mLocations.FirstOrDefault(x => x.Id == _mLocationId)?.Name ?? _mLocationId!;
    /// <summary>FromTeamStock = "Bakım Ekibi Stoğundan Kullanıldı" (2026-08-08): Bakım ekranıyla AYNI davranış —
    /// kayda girer + maliyete dâhil olur, merkez depodan düşülmez.</summary>
    private sealed record Line(string Id, string Name, decimal Qty) { public bool FromTeamStock { get; set; } }

    private List<ApiClient.Opt> _branches = new(), _personnel = new(), _defOpts = new(), _mSubOpts = new();
    private string? _msg; private bool _ok; private bool _busy;

    // ── Faaliyet Listesi — kolon bazlı filtre + sayfalama + sıralama (kullanıcı isteği 2026-07-19,
    // ADR-087/088/089 deseninin AYNISI — bkz. Materials.razor/Vehicles.razor). ──
    private static readonly int[] PageSizes = { 25, 50, 100, 200 };
    private List<string> _visibleColumns = DailyActivityListColumns.DefaultVisible.ToList();
    private readonly Dictionary<string, string> _filters = new();
    private JsonElement[]? _rows;
    private int _page = 1, _pageSize = 25, _totalCount, _totalPages = 1;
    private string? _sortColumn; private bool _sortDesc;
    // Kolon genişliği KALICI DEĞİL (kullanıcı isteği 2026-08-08): standart 140px; oturum-içi JS tutamağıyla resize.
    private bool _exporting;

    private string GetFilter(string key) => _filters.TryGetValue(key, out var v) ? v : "";
    private void SetFilter(string key, string v) => _filters[key] = v ?? "";
    private static string Label(string key) => DailyActivityListColumns.All.FirstOrDefault(c => c.Key == key)?.Label ?? key;
    private static string CellText(JsonElement row, string key) => Str(row, key switch
    {
        DailyActivityListColumns.Date => "dateText",
        DailyActivityListColumns.Type => "type",
        DailyActivityListColumns.Vehicle => "vehicle",
        DailyActivityListColumns.Route => "route",
        DailyActivityListColumns.Operator => "operator",
        DailyActivityListColumns.Duration => "duration",
        DailyActivityListColumns.MaterialQty => "materialQtyText",
        _ => "description",
    });

    private string ThStyle(string key) => "width:140px;";   // standart; JS tutamağı oturum-içi override eder
    private string SortArrow(string key) => _sortColumn == key ? (_sortDesc ? "▼" : "▲") : "";
    private async Task ToggleSort(string key)
    {
        if (_sortColumn != key) { _sortColumn = key; _sortDesc = false; }
        else if (!_sortDesc) { _sortDesc = true; }
        else { _sortColumn = null; _sortDesc = false; }
        _page = 1; await Load();
    }
    private async Task ApplyFilters() { _page = 1; await Load(); }
    private async Task ClearFilters() { _filters.Clear(); _page = 1; await Load(); }
    private async Task OnFilterKey(KeyboardEventArgs e) { if (e.Key == "Enter") await ApplyFilters(); }
    private async Task OnPageChanged(int p) { _page = p; await Load(); }
    private async Task OnPageSizeChanged(int sz) { _pageSize = sz; _page = 1; await Api.SavePageSizeAsync("daily_activity", sz); await Load(); }

    private async Task OpenColumnPicker()
    {
        var parameters = new DialogParameters { ["Available"] = DailyActivityListColumns.All.ToList(), ["Selected"] = _visibleColumns };
        var dlg = await Dialog.ShowAsync<ColumnPickerDialog>("Kolonları Ayarla", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dlg.Result;
        if (result is null || result.Canceled || result.Data is not List<string> chosen) return;
        _visibleColumns = chosen;
        await Api.SaveListColumnsAsync("daily_activity", _visibleColumns);
        await Load();
    }

    // Kolon sürükle-taşıma: başlık ⠿ tutamağı sürüklenip başka bir başlığa bırakılınca sıra değişir + kalıcı kaydolur.
    private string? _dragKey;
    private async Task OnDropColumn(string targetKey)
    {
        var src = _dragKey; _dragKey = null;
        if (string.IsNullOrEmpty(src) || src == targetKey) return;
        var from = _visibleColumns.IndexOf(src);
        if (from < 0) return;
        _visibleColumns.RemoveAt(from);
        var to = _visibleColumns.IndexOf(targetKey);
        _visibleColumns.Insert(to < 0 ? _visibleColumns.Count : to, src);   // hedef kolonun ÖNÜNE bırak
        await Api.SaveListColumnsAsync("daily_activity", _visibleColumns);
    }

    private async Task Load()
    {
        _rows = null;
        var qs = new List<string> { $"page={_page}", $"pageSize={_pageSize}" };
        qs.AddRange(BuildFilterSortQs());
        if (_showCancelled) qs.Add("includeCancelled=true");
        var grid = await Api.GetGridAsync("/api/daily/grid?" + string.Join("&", qs));
        _rows = grid.Items; _totalCount = grid.TotalCount; _page = grid.Page; _pageSize = grid.PageSize; _totalPages = grid.TotalPages;
    }

    /// <summary>Sıralama + kolon filtreleri — sayfalamasız (Load VE ExportExcel PAYLAŞIR).</summary>
    private List<string> BuildFilterSortQs()
    {
        var qs = new List<string>();
        if (_sortColumn is not null) { qs.Add($"sort={_sortColumn}"); qs.Add($"desc={(_sortDesc ? "true" : "false")}"); }
        // Kolon anahtarı ile API parametre adı her zaman aynı değildir (C# ayrılmış sözcük /
        // adlandırma farkı) → eşleme burada TEK yerde yapılır.
        static string ParamAdi(string key) => key switch
        {
            DailyActivityListColumns.Operator => "operatorText",   // "operator" C#'ta ayrılmış sözcük
            _ => key,                                              // diğerlerinde anahtar = parametre adı
        };
        foreach (var (k, v) in _filters)
            if (!string.IsNullOrWhiteSpace(v)) qs.Add($"{ParamAdi(k)}={Uri.EscapeDataString(v.Trim())}");
        return qs;
    }

    /// <summary>"Excel'e Aktar" (kullanıcı isteği 2026-07-19): AKTİF filtrelerle eşleşen TÜM sonuçları indirir.</summary>
    private async Task ExportExcel()
    {
        // Deny-by-default: dışa aktarım ayrı yetki (2026-07-26). API da 403 döner; butonda uyarı + işlem yok.
        if (!Auth.CanView("export")) { Snackbar.Add("Dışa aktarım (export) yetkiniz yok.", Severity.Warning); return; }
        if (_exporting) return;
        _exporting = true;
        try
        {
            var parts = BuildFilterSortQs();
            if (_showCancelled) parts.Add("includeCancelled=true");   // ekranda ne görünüyorsa Excel'de de o
            var qs = string.Join("&", parts);
            var (bytes, fileName) = await Api.GetFileAsync("/api/daily/grid/export" + (qs.Length > 0 ? "?" + qs : ""), "GunlukFaaliyet.xlsx");
            if (bytes is not null)
                await JS.InvokeVoidAsync("dwDownload", fileName, Convert.ToBase64String(bytes),
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _exporting = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadKindOptions();   // 2026-09-03: kayıt tipi seçenekleri yetkiye göre
        if (Auth.CanCreate("daily_activity"))
        {
            _branches = await Api.OptionsAsync("/api/branches", "id", "name");
            _personnel = await Api.OptionsAsync("/api/personnel", "id", "fullName");
            _defOpts = await Api.OptionsAsync("/api/maintenance/definitions", "id", "name");
            // BKM-04: yazma hedefleri (yalnız gerçek depolar) + varsayılan oturum şubesi. Tek indirme.
            try { _mLocations = await Locations.WriteTargets(); } catch { _mLocations = Array.Empty<LocationOption>(); }
            _mLocationId = DefaultLocationId();
        }
        var saved = await Api.GetListColumnsAsync("daily_activity");
        // İş #10: kaydedilmiş tercih KATALOĞA göre süzülür — masaüstüyle aynı kural (hayalet kolon çizilmesin).
        if (saved is { Count: > 0 }) _visibleColumns = DailyActivityListColumns.Sanitize(saved).ToList();
        var (ps, _) = await Api.GetListPrefsAsync("daily_activity");
        if (ps is > 0) _pageSize = ps.Value;   // genişlik yüklenmez (kalıcı değil)
        await Load();
    }

    private string? _lastMDef;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_mDefId != _lastMDef)
        {
            _lastMDef = _mDefId; _mSubId = null;
            _mSubOpts = string.IsNullOrEmpty(_mDefId) ? new() : await Api.OptionsAsync($"/api/maintenance/definitions?parentDefId={_mDefId}", "id", "name");
            StateHasChanged();
        }
    }
    private async Task ReloadMSub(string _) { if (!string.IsNullOrEmpty(_mDefId)) _mSubOpts = await Api.OptionsAsync($"/api/maintenance/definitions?parentDefId={_mDefId}", "id", "name"); }

    private async Task<IEnumerable<ApiClient.Opt>> SearchVehicle(string? t, CancellationToken ct)
    {
        var r = await Api.OptionsAsync("/api/vehicles" + (string.IsNullOrWhiteSpace(t) ? "" : $"?search={Uri.EscapeDataString(t)}"), "id", "display");
        return string.IsNullOrWhiteSpace(t) ? r.Take(DepoWise.Web.Services.FieldChecks.MaxUnfilteredOptions) : r;
    }
    private async Task<IEnumerable<ApiClient.Opt>> SearchMaterial(string? t, CancellationToken ct)
    {
        var r = await Api.MaterialOptionsAsync("/api/materials" + (string.IsNullOrWhiteSpace(t) ? "" : $"?search={Uri.EscapeDataString(t)}"));
        return string.IsNullOrWhiteSpace(t) ? r.Take(DepoWise.Web.Services.FieldChecks.MaxUnfilteredOptions) : r;
    }

    private void AddMaterial() { if (_matSel is null || _matQty <= 0) return; _lines.Add(new Line(_matSel.Id, _matSel.Name, _matQty)); _matSel = null; _matQty = 0; }

    // 🔴 GUI hatası (2026-08-12): Kind=Local tarihte eski desen istisna atıyordu (Reports'ta
    // "tarih seçmeden Sorgula" akışında gerçekten patladı). TEK kaynağa taşındı.
    private static long? Ms(DateTime? d) => DepoWise.Web.Services.FieldChecks.ToUnixMs(d);

    private async Task Save()
    {
        _msg = null;

        // Depo Çıkışı (kullanıcı isteği 2026-08-07): Giriş-Çıkış ile AYNI ortak servis (/api/stock/issue|transfer).
        // Araç OPSİYONEL → araç zorunluluk kontrolünün ÖNÜNDE ele alınır.
        if (_kind == "Depo Çıkışı")
        {
            if (!await Dialog.RequireBranchAsync(Auth, "Günlük Faaliyet — Depo Çıkışı")) return;
            if (_exitMaterial is null) { _msg = "Malzeme seçin."; _ok = false; return; }
            if (_exitQty <= 0) { _msg = "Miktar sıfırdan büyük olmalı."; _ok = false; return; }
            var inBranch = _exitScope == "Şube İçi";
            if (inBranch && string.IsNullOrEmpty(_exitPersonnel)) { _msg = "Personel (teslim alan) zorunludur."; _ok = false; return; }
            if (!inBranch)
            {
                if (string.IsNullOrEmpty(_exitTo)) { _msg = "Hedef şube seçin."; _ok = false; return; }
                if (Auth.BranchId == _exitTo) { _msg = "Hedef şube, kendi şubenizden farklı olmalı."; _ok = false; return; }
            }
            if (!await Dialog.Confirm(inBranch ? "Şube içi çıkış kaydedilsin mi? (stok AZALIR)" : "Şube dışı çıkış (transfer) kaydedilsin mi?", "Evet, Kaydet")) return;
            _busy = true;
            try
            {
                string? exErr = inBranch
                    ? await Api.PostAsync("/api/stock/issue", new
                    {
                        materialId = _exitMaterial.Id, quantity = _exitQty, branchId = Auth.BranchId,
                        personnelId = Empty(_exitPersonnel), vehicleId = _vehicle?.Id, note = Empty(_desc)
                    })
                    : await Api.PostAsync("/api/stock/transfer", new
                    {
                        materialId = _exitMaterial.Id, quantity = _exitQty, fromBranchId = Auth.BranchId, toBranchId = _exitTo,
                        personnelId = (string?)null, vehicleId = _vehicle?.Id, note = Empty(_desc)
                    });
                _ok = exErr is null;
                _msg = exErr ?? (inBranch ? "Şube içi çıkış kaydedildi (Stok Hareketleri'nde görünür)." : "Şube dışı çıkış (transfer) kaydedildi.");
                if (_ok) { Clear(); await Load(); }
            }
            catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
            finally { _busy = false; }
            return;
        }

        if (_vehicle is null) { _msg = "Araç seçin."; _ok = false; return; }
        _busy = true;
        try
        {
            string? err;
            if (_kind == "Bakım")
            {
                if (string.IsNullOrEmpty(_mDefId)) { _msg = "Bakım tanımı seçin."; _ok = false; _busy = false; return; }
                // Masaüstüyle (DailyActivityViewModel) birebir aynı metin — parite.
                if (!await Dialog.Confirm(_lines.Count == 0 ? "Bakım kaydı eklensin mi?"
                        : $"Bakım kaydı eklensin mi?\n\nMalzemeler şu depodan düşülecek: {LocationText}")) { _busy = false; return; }
                err = await Api.PostAsync("/api/daily/maintenance", new
                {
                    vehicleId = _vehicle.Id, definitionId = _mDefId, subDefinitionId = _mSubId, technicianId = _mTech,
                    description = Empty(_desc), performedKm = _mKm, performedHour = _mHour, performedDate = Ms(_date),
                    materials = _lines.Select(l => new { materialId = l.Id, quantity = l.Qty, fromTeamStock = l.FromTeamStock }).ToList(),
                    branchId = _mLocationId   // BKM-04: kullanıcının seçtiği depo
                });
            }
            else if (_kind is "İlave Yağ" or "İlave Filtre" or "Tamir")
            {
                // Masaüstüyle birebir aynı metin — parite.
                if (!await Dialog.Confirm(_lines.Count == 0 ? $"{_kind} kaydı eklensin mi?"
                        : $"{_kind} kaydı eklensin mi?\n\nMalzemeler şu depodan düşülecek: {LocationText}")) { _busy = false; return; }
                err = await Api.PostAsync("/api/daily/extra", new
                {
                    type = ExtraTypeCode(_kind), vehicleId = _vehicle.Id, technicianId = _mTech,
                    description = Empty(_desc), performedKm = _mKm, performedHour = _mHour, performedDate = Ms(_date),
                    materials = _lines.Select(l => new { materialId = l.Id, quantity = l.Qty, fromTeamStock = l.FromTeamStock }).ToList(),
                    branchId = _mLocationId   // BKM-04: kullanıcının seçtiği depo
                });
            }
            else
            {
                var isTransfer = _kind == "Transfer";
                if (!await Dialog.Confirm(isTransfer ? "Transfer kaydedilsin mi? (araç otomatik PASİF'e alınır)" : "Hareket kaydı oluşturulsun mu?")) { _busy = false; return; }
                err = await Api.PostAsync("/api/daily/movement", new
                {
                    movementKind = isTransfer ? "transfer" : "movement", vehicleId = _vehicle.Id,
                    fromLocationId = _from, toLocationId = _to, operatorId = _operator, durationDays = _duration,
                    description = Empty(_desc), activityDate = Ms(_date)
                });
            }
            _ok = err is null; _msg = err ?? "Kaydedildi.";
            if (_ok) { Clear(); await Load(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    // ── İş #5: metadata düzenleme (yan etkisiz alanlar) ─────────────────────────────────────
    private string? _editId, _editOperator, _editError, _editDescription;
    private int? _editDuration;
    private long _editVersion;

    private void BeginEdit(JsonElement row)
    {
        if (Bool(row, "isCancelled")) { _msg = "İptal edilmiş kayıt düzenlenemez."; _ok = false; return; }
        _editId = Str(row, "id");
        _editVersion = row.TryGetProperty("version", out var v) && v.ValueKind == JsonValueKind.Number ? v.GetInt64() : 0L;
        _editDescription = Str(row, "description");
        _editOperator = NullS(row, "operatorId");
        _editDuration = row.TryGetProperty("durationDays", out var d) && d.ValueKind == JsonValueKind.Number ? d.GetInt32() : null;
        _editError = null;
    }

    private async Task SaveEdit()
    {
        if (_editId is null) return;
        _editError = null;
        var err = await Api.PutAsync($"/api/daily/{_editId}/metadata", new
        {
            description = _editDescription, operatorId = _editOperator,
            durationDays = _editDuration, version = _editVersion,
        });
        if (err is not null) { _editError = err; return; }
        _editId = null; _msg = "Faaliyet kaydı güncellendi."; _ok = true;
        await Load();
    }

    private async Task Delete(JsonElement row)
    {
        var id = Str(row, "id");
        if (string.IsNullOrEmpty(id)) return;
        // Masaüstüyle parite (DeleteActivity): bağlı bakım + malzeme çıkışı varsa kullanıcı NE OLACAĞINI görür.
        // Kullanıcı kararı K1/K4 (2026-08-09): bağlı kayıtlar da AYNI atomik işlemde iptal edilir.
        var typeText = Str(row, "type");
        var msg = $"{(string.IsNullOrEmpty(typeText) ? "Faaliyet" : typeText)} kaydı iptal edilecek.";
        try
        {
            var imp = await Api.GetObjectAsync($"/api/daily/{id}/cancel-impact");
            if (imp.ValueKind == JsonValueKind.Object && Bool(imp, "hasMaintenance"))
            {
                var qty = Dec(imp, "totalQuantity");
                msg = "Bu faaliyet kaydına bağlı bakım kaydı" + (qty > 0 ? $" ve {qty:0.##} adet malzeme çıkışı" : "") +
                      " bulunmaktadır.\n\nFaaliyeti iptal ederseniz bağlı kayıtlar da iptal edilecek ve malzemeler " +
                      "stoğa geri eklenecektir. Araç sayacı geri alınmaz. İşlem geri alınamaz.";
            }
        }
        catch { /* etki okunamadıysa sade metinle devam */ }
        if (!await Dialog.Confirm(msg + "\n\nDevam etmek istiyor musunuz?", "Evet, İptal Et", danger: true)) return;
        var err = await Api.DeleteAsync($"/api/daily/{id}");
        _msg = err ?? "Faaliyet iptal edildi."; _ok = err is null;
        await Load();
    }

    private void Clear()
    {
        _vehicle = null; _date = null; _desc = "";
        _from = _to = _operator = null; _duration = null;
        _mDefId = _mSubId = _mTech = null; _mKm = _mHour = null; _matSel = null; _matQty = 0; _lines.Clear();
        _mLocationId = DefaultLocationId();   // BKM-04: yeni kayıt varsayılan depoyla açılır
        _exitScope = "Şube İçi"; _exitMaterial = null; _exitQty = 0; _exitTo = _exitPersonnel = null;
    }

    /// <summary>"Kayıt Tipi" görünen adı → sunucunun activity_type kodu (kullanıcı isteği 2026-07-19).</summary>
    private static string ExtraTypeCode(string kind) => kind switch
    {
        "İlave Yağ" => "extra_oil", "İlave Filtre" => "extra_filter", "Tamir" => "repair",
        _ => throw new ArgumentException("Geçersiz kayıt tipi."),
    };

    private static string? Empty(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
    private static string Dash(string s) => string.IsNullOrEmpty(s) ? "—" : s;
    /// <summary>K3: iptal edilen faaliyetler varsayılan GİZLİ; kutu işaretlenince görünür (masaüstüyle aynı).</summary>
    private bool _showCancelled;
    private async Task ToggleCancelled(bool v) { _showCancelled = v; await Load(); }

    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static bool Bool(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.True;

    private static decimal Dec(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0m;

    private static string? NullS(JsonElement row, string key) { var s = Str(row, key); return string.IsNullOrEmpty(s) ? null : s; }
}
