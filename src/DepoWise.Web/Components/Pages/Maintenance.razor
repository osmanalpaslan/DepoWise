@page "/maintenance"
@page "/maintenance/{Section}"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@* BKM-04: malzemenin çekildiği depo seçenekleri (oturumda tek indirme, önbellekli) *@
@inject LocationOptions Locations
@* Uyarı → bakım kaydı köprüsü (kullanıcı isteği 2026-09-02) *@
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Bakım Takibi — @SecTitle</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

@* "Tüm Şubeler" modunda bu ekranda İŞLEM yapılamaz (kayıt hangi şubeye yazılacağı belli değil) — okuma serbest. *@
@if (Auth.IsAllBranches())
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">@DepoWise.Web.Services.BranchGuard.Banner</MudAlert>
}

    @* ═══════════ BAKIM TANIMLARI ═══════════ *@
    @if (_sec == "defs")
    {
        @if (Auth.CanCreate("maintenance"))
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:720px;">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@(_defEditId is null ? "YENİ BAKIM TANIMI" : "BAKIM TANIMI DÜZENLE")</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_defName" Label="Tanım Adı *" Error="_defErr && string.IsNullOrWhiteSpace(_defName)" ErrorText="Tanım adı zorunlu." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_defInterval" Label="Periyot" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3">
                        <MudSelect T="string" @bind-Value="_defUnit" Label="Birim" Margin="Margin.Dense" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("km")">km</MudSelectItem>
                            <MudSelectItem T="string" Value="@("hour")">saat</MudSelectItem>
                            <MudSelectItem T="string" Value="@("day")">gün</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_defDesc" Label="Açıklama" Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
                    <MudItem xs="12">
                        @* İş A: sunucu-taraflı aramalı çoklu seçim (bkz. SearchableMultiSelect). *@
                        <SearchableMultiSelect Label="İlişkili Araçlar (periyodik takip)" ItemNoun="araç"
                                               HelperText="Seçilen araçlar bu bakım için periyodik takip edilir."
                                               SearchLabel="Araç ara (iç kod / plaka)"
                                               SearchPath="/api/vehicles" NameField="display"
                                               SelectedValues="_defVehicles" SelectedValuesChanged="@(v => _defVehicles = v)" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="ClearDef">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDef" Disabled="_busy">Kaydet</MudButton>
                </MudStack>
                @if (_defMsg is not null) { <MudAlert Severity="@(_defOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_defMsg</MudAlert> }
            </MudPaper>
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2"><MudText Typo="Typo.h6">Bakım Tanımları</MudText><MudSpacer />
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadDefs">Yenile</MudButton></MudStack>
                    @if (_defs is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
                    else if (_defs.Length == 0) { <MudText Class="mud-text-secondary">Henüz bakım tanımı eklenmedi.</MudText> }
                    else
                    {
                        <MudTable Items="_defs" Dense="true" Hover="true" Striped="true" OnRowClick="@(e => OpenDef(Str(e.Item, "id")))" T="JsonElement">
                            <HeaderContent><MudTh>BAKIM TANIMI</MudTh><MudTh>PERİYOT</MudTh></HeaderContent>
                            <RowTemplate><MudTd>@Str(context, "name")</MudTd><MudTd>@Str(context, "intervalDisplay")</MudTd></RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4" Elevation="0" Style="min-height:160px;">
                    @if (_defDetail is null) { <MudText Class="mud-text-secondary">Detay/alt bakım için bir tanım seçin.</MudText> }
                    else
                    {
                        var dd = _defDetail.Value;
                        <MudText Typo="Typo.h6">@Str(dd, "name")</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@Str(dd, "intervalDisplay")</MudChip>
                        @if (!string.IsNullOrEmpty(Str(dd, "description"))) { <MudText Typo="Typo.body2" Class="mt-1">@Str(dd, "description")</MudText> }
                        <MudText Typo="Typo.subtitle2" Class="mt-2">ALT BAKIM TANIMLARI</MudText>
                        @foreach (var sd in _subDefs)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">@Str(sd, "name")</MudText>
                                @if (Auth.CanDelete("maintenance")) { <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => DeleteSubDef(Str(sd, "id")))">Sil</MudButton> }
                            </MudStack>
                        }
                        @if (Auth.CanCreate("maintenance"))
                        {
                            <MudStack Row="true" Class="mt-1" Spacing="2">
                                <MudTextField @bind-Value="_newSubName" Placeholder="Yeni alt bakım adı" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="AddSubDef">Ekle</MudButton>
                            </MudStack>
                        }
                        <MudStack Row="true" Class="mt-3" Spacing="2">
                            @if (Auth.CanEdit("maintenance")) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BeginEditDef">Düzenle</MudButton> }
                            @if (Auth.CanDelete("maintenance")) { <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteDef">Sil</MudButton> }
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    @* ═══════════ ARAÇ BAKIMLARI ═══════════ *@
    @if (_sec == "records")
    {
        @* ⭐ 7b (PK-F9, ADR-191) — HEDEF SEÇİMİ. Araç akışı HİÇ DEĞİŞMEDİ; "Ekipman" seçilince
           ekipman bakım uçları kullanılır. Yeni ekran/route/AppScreen AÇILMADI: hedef bu ekranın
           içindedir (masaüstünde aynı iş sekme ile yapılır). *@
        <MudToggleGroup T="string" @bind-Value="_hedef" Class="mb-4" SelectionMode="SelectionMode.SingleSelection">
            <MudToggleItem T="string" Value="@("vehicle")" Text="Araç" />
            <MudToggleItem T="string" Value="@("equipment")" Text="Ekipman" />
        </MudToggleGroup>
    }

    @if (_sec == "records" && _hedef == "equipment")
    {
        @if (_eqmHata is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_eqmHata</MudAlert>
        }
        @if (Auth.CanCreate("maintenance"))
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:820px;">
                <MudText Typo="Typo.subtitle1" Class="mb-2">YENİ EKİPMAN BAKIM KAYDI</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_eqmEquipmentId" Label="Ekipman *" Margin="Margin.Dense" Variant="Variant.Outlined">
                            @foreach (var e in _eqmEquipment)
                            {
                                <MudSelectItem T="string" Value="@e.Id">@e.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_eqmDefId" Label="Bakım Tanımı *" Margin="Margin.Dense" Variant="Variant.Outlined">
                            @foreach (var d in _defOpts)
                            {
                                <MudSelectItem T="string" Value="@d.Id">@d.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_eqmDescription" Label="Açıklama" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" />
                    </MudItem>
                    @* ⭐ MUH-01a: ekipman bakımı da maliyet merkezine yazılabilir (araç bakımıyla aynı
                       hak). Araç sekmesindeki alandan AYRI seçimdir — biri diğerine yapışmaz.
                       Sunucu ucu bu alanı ZATEN bekliyordu; gönderen bir arayüz yoktu. *@
                    @if (Auth.CanEdit("cost_centers") && _costCenters.Count > 0)
                    {
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" @bind-Value="_eqmCostCenterId" Label="Maliyet Merkezi" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                                       HelperText="Opsiyonel — maliyet bu merkeze yazılır.">
                                @foreach (var cc in _costCenters) { <MudSelectItem T="string" Value="@cc.Id">@cc.Name</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                    }
                    @* ⭐ MUH-01b: ekipman bakımının belge numarası (araç sekmesinden AYRI). *@
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_eqmInvoiceNo" Label="Fatura/Servis Fişi No"
                                      HelperText="Opsiyonel — dış serviste alınan belge numarası."
                                      Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" />
                    </MudItem>
                </MudGrid>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                    Ekipmanda sayaç takibi yoktur; bakım tarih bazlı kaydedilir.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Disabled="_eqmBusy" OnClick="EqmKaydet">Kaydet</MudButton>
            </MudPaper>
        }

        <MudPaper Class="pa-4" Elevation="0">
            <MudText Typo="Typo.subtitle1" Class="mb-2">EKİPMAN BAKIM KAYITLARI</MudText>
            @if (_eqmRows.Count == 0)
            {
                <MudText Typo="Typo.body2">Kayıt yok.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true">
                    <thead><tr><th>Ekipman</th><th>Bakım</th><th>Yapılan</th><th>Durum</th></tr></thead>
                    <tbody>
                        @foreach (var r in _eqmRows)
                        {
                            <tr>
                                <td>@r.EquipmentCode</td>
                                <td>@r.DefinitionName</td>
                                <td>@r.Performed</td>
                                <td>@r.Status</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    }

    @if (_sec == "records" && _hedef == "vehicle")
    {
        @* İNCELEME MODU (kullanıcı isteği 2026-09-02): uyarıdan yeni sekmede açılan kayıt.
           Yeni kayıt formu GİZLENİR — aksi hâlde ekran "yeni kayıt formu" gibi açılıyordu. *@
        @if (_viewMode)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Visibility">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%;">
                    <span>İnceleme modu — bakım uyarısından açılan kayıt sağdaki panelde gösteriliyor.</span>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               OnClick="@(() => Nav.NavigateTo("/maintenance/records"))">İncelemeden Çık</MudButton>
                </MudStack>
            </MudAlert>
        }
        @if (Auth.CanCreate("maintenance") && !_viewMode)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:820px;">
                <MudText Typo="Typo.subtitle1" Class="mb-2">YENİ BAKIM KAYDI</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudAutocomplete T="ApiClient.Opt" Label="Araç *" @bind-Value="_mVehicle" SearchFunc="SearchVehicle" ToStringFunc="@(o => o?.Name ?? "")" Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true" />
                    </MudItem>
                    <MudItem xs="6" md="4"><LookupSelect Label="Bakım Tanımı *" @bind-Value="_mDefId" Items="_defOpts" /></MudItem>
                    <MudItem xs="6" md="4"><LookupSelect Label="Alt Bakım" @bind-Value="_mSubId" Items="_mSubOpts" CreatePath="/api/maintenance/definitions" CreateField="name" ExtraField="parentDefId" ExtraValue="@_mDefId" OnAdded="ReloadMSub" Disabled="@(string.IsNullOrEmpty(_mDefId))" /></MudItem>
                    @* Teknisyen yanına "+" Personel (madde 5.2, kullanıcı isteği 2026-08-06): eklenen kişi
                       otomatik "Saha Personeli" işaretlenir — /api/personnel'e isFieldStaff:true ile POST. *@
                    <MudItem xs="6" md="3">
                        <div class="d-flex align-center" style="gap:4px;">
                            <div style="flex:1 1 auto;"><LookupSelect Label="Teknisyen" @bind-Value="_mTech" Items="_technicians" SearchPath="/api/personnel" NameField="fullName" /></div>
                            @if (Auth.CanCreate("personnel"))
                            {
                                <MudTooltip Text="Yeni personel (Saha Personeli olarak eklenir)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="AddTechnician" />
                                </MudTooltip>
                            }
                        </div>
                    </MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal?" @bind-Value="_mKm" Label="Yapılma KM" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal?" @bind-Value="_mHour" Label="Yapılma Saat" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><MudDatePicker @bind-Date="_mDate" Label="Tarih" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="3">
                @* MLY-01: opsiyonel maliyet merkezi — bağ sunucuda kayıt sonrası yazılır. *@
                @if (Auth.CanEdit("cost_centers") && _costCenters.Count > 0)
                {
                    <MudSelect T="string" @bind-Value="_mCostCenterId" Label="Maliyet Merkezi" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var cc in _costCenters) { <MudSelectItem T="string" Value="@cc.Id">@cc.Name</MudSelectItem> }
                    </MudSelect>
                    @* ⭐ MUH-01b: dış servis faturası / servis fişi no (opsiyonel). *@
                    <MudTextField @bind-Value="_mInvoiceNo" Label="Fatura/Servis Fişi No" Class="mt-2"
                                  HelperText="Opsiyonel — dış serviste alınan belge numarası."
                                  Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" />
                }
            </MudItem>

                    <MudItem xs="12"><MudTextField @bind-Value="_mDesc" Label="Açıklama" Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>

                    @* ARAÇ DURUMU (kullanıcı isteği 2026-07-16): bakım kaydı açarken aracı "Arızalı" vb.
                       işaretleyebilmek için. BOŞ bırakılırsa aracın durumuna DOKUNULMAZ. *@
                    <MudItem xs="6" md="4">
                        <MudSelect T="string" @bind-Value="_mVehStatus" Label="Araç Durumu (değiştir)" Clearable="true"
                                   Margin="Margin.Dense" Variant="Variant.Outlined"
                                   HelperText="Boş = aracın durumu değişmez.">
                            @foreach (var st in DepoWise.Web.Services.VehicleStatus.All)
                            {
                                <MudSelectItem T="string" Value="@st.Code">@st.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    @if (DepoWise.Web.Services.VehicleStatus.NeedsNote(_mVehStatus))
                    {
                        <MudItem xs="6" md="8">
                            <MudTextField @bind-Value="_mVehStatusNote" Label="Araç Durum Açıklaması" Margin="Margin.Dense"
                                          Variant="Variant.Outlined" UserAttributes="_noAuto"
                                          HelperText="Arıza/bakım sebebi (araç kartına yazılır)." />
                        </MudItem>
                    }
                </MudGrid>

                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Malzemeler (stoktan düşülür)</MudText>
                @* ── BKM-04 / KARAR-9: MALZEMENİN ÇEKİLDİĞİ DEPO ────────────────────────────────────
                   Varsayılan giriş yapılan şubedir, kullanıcı değiştirebilir ve değiştirdiği seçim
                   KORUNUR (hiçbir yerde Auth.BranchId ile yeniden ezilmez). Seçenekler yalnız gerçek
                   depolardır — "Atanmamış" yeni stok yazma hedefi olarak SUNULMAZ (WriteTargets). *@
                <MudGrid Spacing="2" Class="align-center mb-1">
                    @if (_mLocations.Count > 0)
                    {
                        <MudItem xs="12" md="6">
                            <MudSelect T="string" @bind-Value="_mLocationId" Label="Malzemenin çekildiği depo" Margin="Margin.Dense" Variant="Variant.Outlined"
                                       HelperText="Stok bu depodan düşülür. Varsayılan, giriş yaptığınız şubedir; gerekirse değiştirin.">
                                @foreach (var lo in _mLocations) { <MudSelectItem T="string" Value="@lo.Id">@lo.Name</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                Firmanızda tanımlı depo/şantiye yok. Bakım kaydı yine de oluşturulur; malzemeler
                                <b>"Atanmamış"</b> olarak düşülür. Şubeler ekranından depo ekleyip sonra dağıtabilirsiniz.
                            </MudAlert>
                        </MudItem>
                    }
                </MudGrid>
                <MudGrid Spacing="2" Class="align-center">
                    <MudItem xs="12" md="6"><MudAutocomplete T="ApiClient.Opt" Label="Malzeme ara (kod/ad)" @bind-Value="_matSel" SearchFunc="SearchMaterial" ToStringFunc="@(o => o?.Name ?? "")" Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true" /></MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_matQty" Label="Miktar" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddMaterial">Ekle</MudButton></MudItem>
                </MudGrid>
                @if (_lines.Count > 0)
                {
                    <MudSimpleTable Dense="true" Class="mt-1" Style="max-width:520px;">
                        <tbody>
                            @foreach (var l in _lines)
                            {
                                <tr>
                                    <td>@l.Name</td>
                                    <td>@l.Qty</td>
                                    <td>
                                        @* Masaüstüyle AYNI seçenek (2026-08-08): işaretliyse merkez depodan düşülmez. *@
                                        <MudCheckBox T="bool" Value="l.FromTeamStock" ValueChanged="@((bool v) => l.FromTeamStock = v)"
                                                     Dense="true" Label="Bakım Ekibi Stoğundan Kullanıldı" />
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block" Style="margin-left:32px;">
                                            İşaretlenirse merkez depo stoklarından düşülmez.
                                        </MudText>
                                    </td>
                                    <td><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _lines.Remove(l))" /></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }

                <MudStack Row="true" Class="mt-3" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="ClearMnt">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveMnt" Disabled="_busy">Kaydet</MudButton>
                </MudStack>
                @if (_mMsg is not null) { <MudAlert Severity="@(_mOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_mMsg</MudAlert> }
            </MudPaper>
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2"><MudText Typo="Typo.h6">Araç Bakımları</MudText><MudSpacer />
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadMaint">Yenile</MudButton></MudStack>
                    @if (_maint is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
                    else if (_maint.Length == 0) { <MudText Class="mud-text-secondary">Henüz bakım kaydı girilmedi.</MudText> }
                    else
                    {
                        <MudTable Items="_maint" Dense="true" Hover="true" Striped="true" OnRowClick="@(e => OpenMaint(e.Item))" T="JsonElement">
                            <HeaderContent><MudTh>ARAÇ</MudTh><MudTh>BAKIM</MudTh><MudTh>YAPILMA</MudTh><MudTh>SONRAKİ</MudTh><MudTh>DURUM</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd>@Str(context, "vehicleCode")</MudTd>
                                <MudTd>@Str(context, "definitionName")</MudTd>
                                <MudTd>@Str(context, "performedDisplay")</MudTd>
                                <MudTd>@Str(context, "nextDueDisplay")</MudTd>
                                <MudTd>@Str(context, "statusText")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="0" Style="min-height:160px;">
                    @if (_selMaint is null) { <MudText Class="mud-text-secondary">Detay için bir bakım kaydı seçin.</MudText> }
                    else
                    {
                        var sm = _selMaint.Value;
                        <MudText Typo="Typo.h6">@Str(sm, "definitionName")</MudText>
                        <MudSimpleTable Dense="true" Bordered="false" Style="background:transparent">
                            <tbody>
                                <tr><td>Araç</td><td>@Str(sm, "vehicleCode")</td></tr>
                                <tr><td>Alt Bakım</td><td>@Str(sm, "subDisplay")</td></tr>
                                <tr><td>Yapılma</td><td>@Str(sm, "performedDisplay")</td></tr>
                                <tr><td>Sonraki</td><td>@Str(sm, "nextDueDisplay")</td></tr>
                            </tbody>
                        </MudSimpleTable>
                        <MudText Typo="Typo.subtitle2" Class="mt-2">KULLANILAN MALZEMELER</MudText>
                        @foreach (var mm in _maintMaterials)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">
                                    @Str(mm, "name")
                                    @* Kaynak: merkez depo mu, bakım ekibi stoğu mu (2026-08-08) *@
                                    @if (Bool(mm, "fromTeamStock"))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ml-1">Bakım ekibi stoğu</MudChip>
                                    }
                                </MudText>
                                <MudText Typo="Typo.body2"><b>@Str(mm, "quantity")</b></MudText>
                            </MudStack>
                        }
                        @if (!Bool(sm, "isCancelled"))
                        {
                            @* Masaüstüyle parite (MaintenanceViewModel.CancelReason): iptal gerekçesi ZORUNLU
                               ve gerçek denetim kaydına (audit) girer — önceden burada sabit "Kayıt silme"
                               metni gönderiliyordu, kullanıcının yazdığı gerekçe hiç alınmıyordu. *@
                            @if (Auth.CanDelete("maintenance"))
                            {
                                <MudTextField @bind-Value="_cancelReason" Label="İptal Gerekçesi" Margin="Margin.Dense" Variant="Variant.Outlined" Class="mt-2" />
                            }
                            @* İş #5: YAN ETKİSİZ alanlar (açıklama/alt not/teknisyen). Malzeme veya sayaç
                               değişecekse "Düzelt" (iptal + yeniden gir) kullanılır. *@
                            @if (_metaEdit)
                            {
                                <MudPaper Class="pa-3 mt-2" Elevation="1">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                                        Yalnız açıklama, alt bakım notu ve teknisyen düzeltilebilir. Malzeme veya sayaç değişecekse "Düzelt" kullanın.
                                    </MudText>
                                    <MudTextField @bind-Value="_metaDesc" Label="Açıklama" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                    <MudTextField @bind-Value="_metaNote" Label="Alt Bakım Notu" Margin="Margin.Dense" Variant="Variant.Outlined" Class="mt-2" />
                                    <div class="mt-2"><LookupSelect Label="Teknisyen" @bind-Value="_metaTech" Items="_technicians" SearchPath="/api/personnel" NameField="fullName" /></div>
                                    @if (_metaError is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_metaError</MudAlert> }
                                    <MudStack Row="true" Spacing="2" Class="mt-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveMetaEdit">Kaydet</MudButton>
                                        <MudButton Variant="Variant.Text" OnClick="@(() => _metaEdit = false)">Vazgeç</MudButton>
                                    </MudStack>
                                </MudPaper>
                            }
                            <MudStack Row="true" Class="mt-2" Spacing="2">
                                @if (Auth.CanEdit("maintenance")) { <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="BeginMetaEdit">Bilgileri Düzenle</MudButton> }
                                @if (Auth.CanEdit("maintenance")) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EditMaint">Düzelt</MudButton> }
                                @if (Auth.CanDelete("maintenance")) { <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="CancelMaint">Sil</MudButton> }
                            </MudStack>
                        }
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    @* ═══════════ UYARILAR ═══════════ *@
    @if (_sec == "alerts")
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2"><MudText Typo="Typo.h6">Periyodik Bakım Uyarıları</MudText><MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadAlerts">Yenile</MudButton></MudStack>
        @if (_alerts is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
        else if (_alerts.Length == 0) { <MudText Class="mud-text-secondary">Aktif periyodik bakım uyarısı bulunmuyor.</MudText> }
        else
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1">Satıra tıklayın: ilgili araç bakım kaydı açılır.</MudText>
            <MudTable Items="_alerts" Dense="true" Hover="true" Striped="true" T="JsonElement"
                      OnRowClick="@(e => OpenAlert(e.Item))" Style="cursor:pointer;">
                <HeaderContent><MudTh>ARAÇ KODU</MudTh><MudTh>PLAKA</MudTh><MudTh>BAKIM TANIMI</MudTh><MudTh>İLERLEME</MudTh><MudTh>TÜKETİLEN / PERİYOT</MudTh><MudTh>DURUM</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@Str(context, "vehicleCode")</MudTd>
                    <MudTd>@Str(context, "plate")</MudTd>
                    <MudTd>@Str(context, "definition")</MudTd>
                    <MudTd>@Str(context, "progressText")</MudTd>
                    <MudTd>@Str(context, "consumedText")</MudTd>
                    <MudTd>@Str(context, "levelText")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    }


@code {
    [Parameter] public string? Section { get; set; }

    /// <summary>İNCELEME MODU (kullanıcı isteği 2026-09-02): <c>/maintenance/records?view=&lt;bakımId&gt;</c>.
    /// Bakım uyarısı YENİ SEKMEDE bu adresi açar; sayfa yeni kayıt formunu göstermez, ilgili kaydı seçer.</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? ViewId { get; set; }
    private bool _viewMode => !string.IsNullOrWhiteSpace(ViewId);
    private string? _uygulananView;   // aynı kaydı iki kez seçmeye çalışma
    private string _sec => (Section ?? "records").ToLowerInvariant();
    private string SecTitle => _sec switch { "defs" => "Bakım Tanımları", "alerts" => "Uyarılar", _ => "Araç Bakımları" };

    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };

    // ── 7b (PK-F9, ADR-191): EKİPMAN hedefi. Araç alanlarına DOKUNULMADI. ────────────────────
    private sealed record EqmRow(string EquipmentCode, string DefinitionName, string Performed, string Status);
    private string _hedef = "vehicle";
    private List<ApiClient.Opt> _eqmEquipment = new();
    private List<EqmRow> _eqmRows = new();
    private string? _eqmEquipmentId, _eqmDefId, _eqmHata;
    /// <summary>⭐ MUH-01a: EKİPMAN bakımının maliyet merkezi — araç formundaki `_mCostCenterId`den
    /// AYRI tutulur; ortak alan, araç için seçilen merkezin ekipman kaydına sessizce yapışması olurdu.</summary>
    private string? _eqmCostCenterId;
    private string _eqmDescription = "";
    private bool _eqmBusy;

    /// <summary>Ekipman listesi + ekipman bakım kayıtları (yalnız hedef "Ekipman" iken çağrılır).</summary>
    private async Task EqmYukle()
    {
        try
        {
            _eqmEquipment = await Api.OptionsAsync("/api/equipment", "id", "code", "name");
            _eqmRows = (await Api.GetArrayAsync("/api/equipment-maintenance"))
                .Where(e => e.ValueKind == System.Text.Json.JsonValueKind.Object)
                .Select(e => new EqmRow(
                    Str(e, "equipmentCode"), Str(e, "definitionName"),
                    Str(e, "performedDisplay"), Str(e, "statusText")))
                .ToList();
            _eqmHata = null;
        }
        catch { _eqmHata = "Ekipman bakım verisi alınamadı."; }
    }

    private async Task EqmKaydet()
    {
        if (string.IsNullOrWhiteSpace(_eqmEquipmentId)) { _eqmHata = "Ekipman seçin."; return; }
        if (string.IsNullOrWhiteSpace(_eqmDefId)) { _eqmHata = "Bakım tanımı seçin."; return; }
        _eqmBusy = true;
        try
        {
            // Firma gövdeye KONMAZ; sunucu oturumdan alır. Ekipman sahipliği serviste doğrulanır.
            var hata = await Api.PostAsync("/api/equipment-maintenance", new
            {
                equipmentId = _eqmEquipmentId,
                definitionId = _eqmDefId,
                description = string.IsNullOrWhiteSpace(_eqmDescription) ? null : _eqmDescription.Trim(),
                performedDate = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                costCenterId = Empty(_eqmCostCenterId),   // ⭐ MUH-01a
                invoiceNo = Empty(_eqmInvoiceNo),         // ⭐ MUH-01b
            });
            _eqmHata = hata;
            if (hata is null) { _eqmDescription = ""; _eqmCostCenterId = null; _eqmInvoiceNo = ""; }
        }
        finally { _eqmBusy = false; }
        await EqmYukle();
    }

    private List<ApiClient.Opt> _defOpts = new(), _mSubOpts = new(), _technicians = new();

    // Tab 1: definitions
    private string? _defEditId;
    // B-1: düzenleme kilidi jetonu — form açılırken listeden okunur, kaydederken geri gönderilir.
    // 0 = yeni kayıt veya sürüm bilinmiyor → sunucu kilit kontrolü yapmaz.
    private long _defVersion;
    private string _defName = "", _defDesc = "", _defUnit = "km";
    private decimal _defInterval;
    private IReadOnlyCollection<string> _defVehicles = new HashSet<string>();
    private JsonElement[]? _defs;
    private JsonElement? _defDetail;
    private JsonElement[] _subDefs = Array.Empty<JsonElement>();
    private string _newSubName = "";
    private string? _defMsg; private bool _defOk; private bool _defErr;

    // Tab 2: maintenance
    private ApiClient.Opt? _mVehicle, _matSel;
    private string? _mDefId, _mSubId, _mTech;
    private decimal? _mKm, _mHour; private DateTime? _mDate; private string _mDesc = "";
    // Bakım ekranından araç durumu değiştirme (boş = dokunma).
    private string? _mVehStatus; private string _mVehStatusNote = "";
    private decimal _matQty;
    // ── BKM-04 / KARAR-9: malzemenin çekildiği depo ──────────────────────────────────────────────
    /// <summary>Yazma hedefleri — YALNIZ gerçek depolar; "Atanmamış" ve "Tüm Şubeler" burada YOKTUR.</summary>
    private IReadOnlyList<LocationOption> _mLocations = Array.Empty<LocationOption>();
    /// <summary>Kullanıcının seçtiği depo. Varsayılan olarak oturum şubesiyle DOLDURULUR; sonrasında
    /// kullanıcının seçimi KORUNUR — <c>Auth.BranchId</c> ile bir daha ezilmez (KARAR-9 kırmızı çizgisi).</summary>
    private string? _mLocationId;
    private readonly List<Line> _lines = new();
    /// <summary>FromTeamStock = "Bakım Ekibi Stoğundan Kullanıldı" (2026-08-08): kayda girer + maliyete dâhil,
    /// merkez depodan düşülmez. Masaüstündeki MntMaterialLine ile AYNI davranış.</summary>
    private sealed record Line(string Id, string Name, decimal Qty) { public bool FromTeamStock { get; set; } }
    private JsonElement[]? _maint;
    private JsonElement? _selMaint;
    private JsonElement[] _maintMaterials = Array.Empty<JsonElement>();
    private string _cancelReason = "";
    private string? _mMsg; private bool _mOk;

    // Tab 3
    private JsonElement[]? _alerts;

    private bool _busy;

    private string? _mCostCenterId;
    /// <summary>⭐ MUH-01b (2026-09-04): ARAÇ bakımının dış servis faturası / servis fişi numarası.</summary>
    private string _mInvoiceNo = "";
    /// <summary>⭐ MUH-01b: EKİPMAN bakımının belge numarası — maliyet merkezindeki gibi AYRI alan.</summary>
    private string _eqmInvoiceNo = "";
    // MLY-01
    private List<ApiClient.Opt> _costCenters = new();
    private async Task LoadCostCenters()
    { try { _costCenters = await Api.OptionsAsync("/api/cost-centers/options", "id", "name"); } catch { } }

    protected override async Task OnInitializedAsync()
    {
        await LoadCostCenters();
        _defOpts = await Api.OptionsAsync("/api/maintenance/definitions", "id", "name");
        _technicians = await Api.OptionsAsync("/api/personnel", "id", "fullName");
        await LoadLocations();
        await LoadDefs(); await LoadMaint(); await LoadAlerts();
        await EqmYukle();   // 7b: ekipman hedefi verisi (araç yüklemeleri değişmedi)
        await ViewParametresiniUygula();
    }

    /// <summary>Adreste <c>?view=</c> varsa o bakım kaydını seçer (inceleme modu). Kayıt listede yoksa
    /// kullanıcı sessiz bırakılmaz — silinmiş/yetki dışı olabileceği söylenir.</summary>
    private async Task ViewParametresiniUygula()
    {
        if (!_viewMode || _uygulananView == ViewId) return;
        _uygulananView = ViewId;
        _hedef = "vehicle";                     // 7b ekipman hedefi açıksa araç hedefine dön
        if (_maint is null) await LoadMaint();
        var hit = (_maint ?? Array.Empty<JsonElement>()).FirstOrDefault(m => Str(m, "id") == ViewId);
        if (hit.ValueKind != JsonValueKind.Undefined) await OpenMaint(hit);
        else Snackbar.Add("Bakım kaydı bulunamadı (silinmiş veya yetki dışı olabilir).", Severity.Warning);
    }

    protected override async Task OnParametersSetAsync() => await ViewParametresiniUygula();

    /// <summary>BKM-04: depo seçenekleri (oturumda TEK indirme — LocationOptions önbellekli, N+1 yok)
    /// + varsayılanın oturum şubesine ayarlanması. Varsayılan YALNIZ burada, bir kez atanır.</summary>
    private async Task LoadLocations()
    {
        try { _mLocations = await Locations.WriteTargets(); } catch { _mLocations = Array.Empty<LocationOption>(); }
        // Oturum şubesi listede varsa varsayılan olur; yoksa sistem rastgele bir depo TAHMİN ETMEZ.
        _mLocationId = _mLocations.Any(x => x.Id == Auth.BranchId) ? Auth.BranchId : null;
    }

    /// <summary>Onay/uyarı metinlerinde gösterilecek depo adı.</summary>
    private string LocationText => string.IsNullOrEmpty(_mLocationId)
        ? "Atanmamış (depo seçilmedi)"
        : _mLocations.FirstOrDefault(x => x.Id == _mLocationId)?.Name ?? _mLocationId!;

    // ── Tanımlar ──
    private async Task LoadDefs() { _defs = null; try { _defs = await Api.GetArrayAsync("/api/maintenance/definitions"); } catch { _defs = Array.Empty<JsonElement>(); } _defOpts = await Api.OptionsAsync("/api/maintenance/definitions", "id", "name"); }

    private async Task OpenDef(string id)
    {
        if (string.IsNullOrEmpty(id)) return;
        _defDetail = _defs?.FirstOrDefault(d => Str(d, "id") == id);
        try { _subDefs = await Api.GetArrayAsync($"/api/maintenance/definitions?parentDefId={id}"); } catch { _subDefs = Array.Empty<JsonElement>(); }
    }

    private async Task SaveDef()
    {
        _defErr = true; _defMsg = null;
        if (string.IsNullOrWhiteSpace(_defName)) { _defMsg = "Tanım adı zorunlu."; _defOk = false; return; }
        if (!await Dialog.Confirm(_defEditId is null ? "Bakım tanımı eklensin mi?" : "Bakım tanımı güncellensin mi?")) return;
        _busy = true;
        try
        {
            // B-1: version yalnız DÜZENLEMEde anlamlı; yeni kayıtta 0 gider ve sunucu kilit kontrolü yapmaz.
            var body = new { name = _defName.Trim(), intervalValue = _defInterval, intervalUnit = _defUnit, parentDefId = (string?)null, description = Empty(_defDesc), vehicleIds = _defVehicles.ToList(), version = _defEditId is null ? 0L : _defVersion };
            var err = _defEditId is null ? await Api.PostAsync("/api/maintenance/definitions", body) : await Api.PutAsync($"/api/maintenance/definitions/{_defEditId}", body);
            _defOk = err is null; _defMsg = err ?? "Kaydedildi.";
            if (_defOk) { ClearDef(); await LoadDefs(); }
        }
        catch (Exception ex) { _defOk = false; _defMsg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task BeginEditDef()
    {
        if (_defDetail is null) return;
        var d = _defDetail.Value;
        _defEditId = Str(d, "id"); _defName = Str(d, "name"); _defDesc = Str(d, "description");
        _defVersion = d.TryGetProperty("version", out var dv) && dv.ValueKind == JsonValueKind.Number ? dv.GetInt64() : 0L;
        _defUnit = string.IsNullOrEmpty(Str(d, "intervalUnit")) ? "km" : Str(d, "intervalUnit");
        _defInterval = Dec(d, "intervalValue");
        try { var arr = await Api.GetArrayAsync($"/api/maintenance/definitions/{_defEditId}/vehicles"); _defVehicles = new HashSet<string>(arr.Select(e => e.GetString() ?? "").Where(x => x != "")); }
        catch { _defVehicles = new HashSet<string>(); }
    }

    private async Task DeleteDef()
    {
        if (_defDetail is null) return;
        var id = Str(_defDetail.Value, "id");
        if (!await Dialog.Confirm("Bu bakım tanımı silinsin mi?", "Evet, Sil", danger: true)) return;
        await Api.DeleteAsync($"/api/maintenance/definitions/{id}");
        _defDetail = null; await LoadDefs();
    }

    private async Task AddSubDef()
    {
        if (_defDetail is null || string.IsNullOrWhiteSpace(_newSubName)) return;
        var parent = Str(_defDetail.Value, "id");
        await Api.PostAsync("/api/maintenance/definitions", new { name = _newSubName.Trim(), intervalValue = 0m, intervalUnit = "km", parentDefId = parent, description = (string?)null, vehicleIds = new List<string>() });
        _newSubName = ""; await OpenDef(parent);
    }

    private async Task DeleteSubDef(string id)
    {
        if (!await Dialog.Confirm("Bu alt bakım silinsin mi?", "Evet, Sil", danger: true)) return;
        await Api.DeleteAsync($"/api/maintenance/definitions/{id}");
        if (_defDetail is not null) await OpenDef(Str(_defDetail.Value, "id"));
    }

    private void ClearDef() { _defErr = false; _defEditId = null; _defName = _defDesc = ""; _defUnit = "km"; _defInterval = 0; _defVehicles = new HashSet<string>(); }

    // ── Araç Bakımları ──
    private async Task LoadMaint() { _maint = null; try { _maint = await Api.GetArrayAsync("/api/maintenance"); } catch { _maint = Array.Empty<JsonElement>(); } }

    private string? _lastMDef;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_mDefId != _lastMDef)
        {
            _lastMDef = _mDefId; _mSubId = null;
            _mSubOpts = string.IsNullOrEmpty(_mDefId) ? new() : await Api.OptionsAsync($"/api/maintenance/definitions?parentDefId={_mDefId}", "id", "name");
            StateHasChanged();
        }
    }

    private async Task ReloadMSub(string _) { if (!string.IsNullOrEmpty(_mDefId)) _mSubOpts = await Api.OptionsAsync($"/api/maintenance/definitions?parentDefId={_mDefId}", "id", "name"); }

    /// <summary>Teknisyen yanındaki "+" (madde 5.2): Personeller modülündeki NameInputDialog'u yeniden kullanır,
    /// /api/personnel'e doğrudan POST eder — LookupSelect'in genel CreatePath yolu yalnız TEK metin alanı
    /// destekler, isFieldStaff BOOLEAN alanı için uygun değil.</summary>
    private async Task AddTechnician()
    {
        var dlg = await Dialog.ShowAsync<NameInputDialog>("Yeni Personel",
            new DialogParameters { ["Label"] = "Ad Soyad" },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var res = await dlg.Result;
        if (res is null || res.Canceled || res.Data is not string raw) return;
        var name = raw.Trim();
        if (name.Length == 0) return;

        var err = await Api.PostAsync("/api/personnel", new { fullName = name, isFieldStaff = true });
        if (err is null)
        {
            _technicians = await Api.OptionsAsync("/api/personnel", "id", "fullName");
            var added = _technicians.FirstOrDefault(o => DepoWise.Web.Services.FieldChecks.TrCompare.Compare(o.Name ?? "", name, System.Globalization.CompareOptions.IgnoreCase) == 0);
            if (added is not null) _mTech = added.Id;
        }
        else await Dialog.Confirm("Eklenemedi: " + err, okText: "Tamam", cancelText: "");
    }

    private async Task<IEnumerable<ApiClient.Opt>> SearchVehicle(string? t, CancellationToken ct)
    {
        var r = await Api.OptionsAsync("/api/vehicles" + (string.IsNullOrWhiteSpace(t) ? "" : $"?search={Uri.EscapeDataString(t)}"), "id", "display");
        return string.IsNullOrWhiteSpace(t) ? r.Take(DepoWise.Web.Services.FieldChecks.MaxUnfilteredOptions) : r;
    }
    private async Task<IEnumerable<ApiClient.Opt>> SearchMaterial(string? t, CancellationToken ct)
    {
        var r = await Api.OptionsAsync("/api/materials" + (string.IsNullOrWhiteSpace(t) ? "" : $"?search={Uri.EscapeDataString(t)}"), "id", "name");
        return string.IsNullOrWhiteSpace(t) ? r.Take(DepoWise.Web.Services.FieldChecks.MaxUnfilteredOptions) : r;
    }

    private void AddMaterial() { if (_matSel is null || _matQty <= 0) return; _lines.Add(new Line(_matSel.Id, _matSel.Name, _matQty)); _matSel = null; _matQty = 0; }

    private async Task OpenMaint(JsonElement row)
    {
        _selMaint = row; _cancelReason = ""; var id = Str(row, "id");
        try { _maintMaterials = await Api.GetArrayAsync($"/api/maintenance/{id}/materials"); } catch { _maintMaterials = Array.Empty<JsonElement>(); }
    }

    /// <summary>
    /// Uyarı → bakım kaydı köprüsü (kullanıcı isteği 2026-09-02, 2026-09-02'de DÜZELTİLDİ).
    ///
    /// ⚠️ İlk sürüm aynı sekmede <c>/maintenance/records</c>'a gidiyordu; o bölümün EN ÜSTÜ "YENİ BAKIM
    /// KAYDI" formudur → ekran "yeni kayıt formu" gibi açılıyordu (kullanıcı bildirimi). Ayrıca kayıt
    /// (araç + bakım ADI) ile aranıyor, bulunamazsa aracın başka bir bakımına düşüyordu.
    ///
    /// Artık: uyarı, dayandığı kaydın KİMLİĞİNİ taşır (<c>maintenanceId</c>) ve kayıt
    /// <b>YENİ SEKMEDE, İNCELEME MODUNDA</b> açılır (<c>?view=</c>). Kimlik yoksa hiçbir kayıt açılmaz.
    /// </summary>
    private async Task OpenAlert(JsonElement alert)
    {
        var mid = Str(alert, "maintenanceId");
        var def = Str(alert, "definition");
        var code = Str(alert, "vehicleCode");

        if (string.IsNullOrWhiteSpace(mid))
        {
            Snackbar.Add($"{code} · \"{def}\" için henüz bakım kaydı yok (ilk bakım bekliyor).", Severity.Info);
            return;
        }

        var url = $"/maintenance/records?view={Uri.EscapeDataString(mid)}";
        try
        {
            if (await JS.InvokeAsync<bool>("dwOpenInNewTab", url)) return;
        }
        catch { /* JS erişilemedi → aynı sekmede aç */ }
        Nav.NavigateTo(url);   // yeni sekme engellendiyse güvenli dönüş (yine inceleme modu)
    }

    private async Task SaveMnt()
    {
        _mMsg = null;
        if (!await Dialog.RequireBranchAsync(Auth, "Bakım Takibi")) return;   // "Tüm Şubeler" modunda işlem yok
        if (_mVehicle is null) { _mMsg = "Araç seçin."; _mOk = false; return; }
        if (string.IsNullOrEmpty(_mDefId)) { _mMsg = "Bakım tanımı seçin."; _mOk = false; return; }

        // madde 5.3: yetersiz stok ENGELLENMEZ. Eksik varsa uyarı + opsiyonel "Taslak Talep Oluştur"; her iki
        // durumda da bakım kaydı DEVAM eder. Bakiye API'den okunur (web'in doğrudan stok erişimi yok).
        // "Bakım ekibi stoğu" işaretli satırlar merkez depodan DÜŞÜLMEYECEĞİ için stok yetersizliği
        // kontrolüne de GİRMEZ (2026-08-08) — aksi halde gereksiz "stok yetersiz" uyarısı çıkardı.
        // BKM-04: uyarı SEÇİLEN DEPONUN stoğuna bakar (firma geneline değil). Aksi hâlde "yeterli var"
        // deyip o depodan eksiye düşerdik — STK-04'te düzeltilen aynı hata sınıfı.
        var shortfalls = new List<(string Id, string Name, decimal Shortfall)>();
        foreach (var l in _lines)
        {
            if (l.FromTeamStock) continue;
            decimal bal = 0m;
            try
            {
                var d = await Api.GetObjectAsync(
                    $"/api/stock/balance/{l.Id}/location?locationId={Uri.EscapeDataString(_mLocationId ?? "")}");
                bal = Dec(d, "balance");
            }
            catch { }
            if (l.Qty > bal) shortfalls.Add((l.Id, l.Name, l.Qty - bal));
        }
        if (shortfalls.Count > 0)
        {
            var canRequest = Auth.CanCreate("requests");
            var detail = string.Join("\n", shortfalls.Select(x => $"• {x.Name}: eksik {x.Shortfall:0.##}"));
            var baseMsg = "İlgili malzeme için yeterli stok bulunmamaktadır. İşleme devam edebilirsiniz." +
                (canRequest ? " İsterseniz bu işlem için otomatik bir malzeme talebi oluşturabilirsiniz." : "") +
                "\n\n" + detail;
            if (canRequest)
            {
                var makeDraft = await Dialog.Confirm(baseMsg, okText: "Taslak Talep Oluştur ve Devam Et", cancelText: "Talepsiz Devam Et");
                if (makeDraft)
                {
                    var body = new
                    {
                        items = shortfalls.Select(x => new { materialId = x.Id, quantity = x.Shortfall, vehicleId = (string?)null, note = (string?)null }).ToList(),
                        branchId = (string?)null, requesterId = (string?)null, warehouseId = (string?)null, approverId = (string?)null,
                        description = (string?)null, requestDate = (long?)null, submitImmediately = false   // TASLAK
                    };
                    var rErr = await Api.PostAsync("/api/requests", body);
                    _mOk = rErr is null;
                    _mMsg = rErr is null ? "Talep taslak olarak oluşturuldu. Talepler ekranından düzenleyerek gönderebilirsiniz."
                                         : "Taslak talep oluşturulamadı: " + rErr + " (bakım kaydı yine de sürüyor)";
                }
            }
            else if (!await Dialog.Confirm(baseMsg, okText: "Devam Et", cancelText: "Vazgeç", danger: true))
                return;
        }
        else if (!await Dialog.Confirm(_lines.Count == 0 ? "Bakım kaydı eklensin mi?"
                     : $"Bakım kaydı eklensin mi?\n\nMalzemeler şu depodan düşülecek: {LocationText}")) return;
        _busy = true;
        try
        {
            var err = await Api.PostAsync("/api/maintenance", new
            {
                vehicleId = _mVehicle.Id, definitionId = _mDefId, subDefinitionId = _mSubId, technicianId = _mTech,
                description = Empty(_mDesc), performedKm = _mKm, performedHour = _mHour,
                performedDate = DepoWise.Web.Services.FieldChecks.ToUnixMs(_mDate),
                materials = _lines.Select(l => new { materialId = l.Id, quantity = l.Qty, fromTeamStock = l.FromTeamStock }).ToList(),
                // BKM-04: KULLANICININ SEÇTİĞİ depo. Auth.BranchId yalnız VARSAYILANI belirledi;
                // burada tekrar okunmaz — kullanıcının değişikliği sessizce ezilemez (KARAR-9).
                branchId = _mLocationId,
                costCenterId = Empty(_mCostCenterId),   // MLY-01
                invoiceNo = Empty(_mInvoiceNo)          // ⭐ MUH-01b
            });
            // Araç durumu seçildiyse aracı da güncelle. Bakım kaydı BAŞARILI olduysa yapılır; durum
            // güncellenemezse bakım kaydı GERİ ALINMAZ (ayrı işlem) — kullanıcıya açıkça söylenir.
            if (err is null && !string.IsNullOrEmpty(_mVehStatus))
            {
                var sErr = await Api.PostAsync($"/api/vehicles/{_mVehicle.Id}/status",
                    new { status = _mVehStatus, statusNote = Empty(_mVehStatusNote) });
                if (sErr is not null)
                {
                    _mOk = false;
                    _mMsg = $"Bakım kaydedildi ANCAK araç durumu güncellenemedi: {sErr} (Araçlar ekranından elle değiştirin.)";
                    ClearMnt(); await LoadMaint(); await LoadAlerts();
                    return;
                }
            }
            _mOk = err is null;
            _mMsg = err ?? (string.IsNullOrEmpty(_mVehStatus)
                ? "Bakım kaydedildi."
                : $"Bakım kaydedildi; araç durumu '{DepoWise.Web.Services.VehicleStatus.Label(_mVehStatus)}' olarak güncellendi.");
            if (_mOk) { ClearMnt(); await LoadMaint(); await LoadAlerts(); }
        }
        catch (Exception ex) { _mOk = false; _mMsg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task CancelMaint()
    {
        if (_selMaint is null) return;
        // Masaüstüyle parite: iptal gerekçesi zorunlu (audit kaydına gerçek sebep girer).
        if (string.IsNullOrWhiteSpace(_cancelReason)) { _mMsg = "İptal gerekçesi zorunlu."; _mOk = false; return; }
        var id = Str(_selMaint.Value, "id");
        if (!await Dialog.Confirm("Bu bakım kaydı silinsin mi? (kullanılan malzeme stoğu geri alınır)", "Evet, Sil", danger: true)) return;
        await Api.PostAsync("/api/maintenance/cancel", new { id, reason = _cancelReason.Trim() });
        _cancelReason = ""; _selMaint = null; await LoadMaint();
    }

    // Düzelt: eski kaydı sil (stok geri al) + araç/tanımı forma taşı → düzeltilmiş kayıt gir
    // ── İş #5: metadata düzenleme (yan etkisiz alanlar) ─────────────────────────────────────
    private bool _metaEdit;
    private string? _metaDesc, _metaNote, _metaTech, _metaError;
    private long _metaVersion;

    private void BeginMetaEdit()
    {
        if (_selMaint is null) return;
        var sm = _selMaint.Value;
        _metaDesc = Str(sm, "description");
        _metaNote = Str(sm, "subDefinitionNote");
        var t = Str(sm, "technicianId"); _metaTech = string.IsNullOrEmpty(t) ? null : t;
        _metaVersion = sm.TryGetProperty("version", out var v) && v.ValueKind == JsonValueKind.Number ? v.GetInt64() : 0L;
        _metaError = null; _metaEdit = true;
    }

    private async Task SaveMetaEdit()
    {
        if (_selMaint is null) return;
        _metaError = null;
        var err = await Api.PutAsync($"/api/maintenance/{Str(_selMaint.Value, "id")}/metadata", new
        {
            description = _metaDesc, subDefinitionNote = _metaNote,
            technicianId = _metaTech, version = _metaVersion,
        });
        if (err is not null) { _metaError = err; return; }
        _metaEdit = false; _selMaint = null; await LoadMaint();
    }

    private async Task EditMaint()
    {
        if (_selMaint is null) return;
        var sm = _selMaint.Value;
        if (!await Dialog.Confirm("Düzeltme için bu kayıt silinip bilgileri forma taşınacak. Devam edilsin mi?")) return;
        await Api.PostAsync("/api/maintenance/cancel", new { id = Str(sm, "id"), reason = "Düzeltme" });
        var vid = Str(sm, "vehicleId");
        if (!string.IsNullOrEmpty(vid)) _mVehicle = new ApiClient.Opt(vid, Str(sm, "vehicleCode"));
        var defName = Str(sm, "definitionName");
        _mDefId = _defOpts.FirstOrDefault(o => o.Name == defName)?.Id;
        _selMaint = null; await LoadMaint();
    }

    // BKM-04: YENİ kayıt varsayılan depoyla açılır (bir önceki kaydın seçimi taşınmaz).
    private void ClearMnt() { _mVehicle = null; _mDefId = _mSubId = _mTech = null; _mKm = _mHour = null; _mDate = null; _mDesc = ""; _matSel = null; _matQty = 0; _lines.Clear(); _mVehStatus = null; _mVehStatusNote = ""; _mLocationId = _mLocations.Any(x => x.Id == Auth.BranchId) ? Auth.BranchId : null; _mInvoiceNo = ""; _mCostCenterId = null; }

    // ── Uyarılar ──
    private async Task LoadAlerts() { _alerts = null; try { _alerts = await Api.GetArrayAsync("/api/maintenance/alerts"); } catch { _alerts = Array.Empty<JsonElement>(); } }

    private static string? Empty(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static bool Bool(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.True;
    private static decimal Dec(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0;
}
