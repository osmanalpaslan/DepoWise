@page "/alerts"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Uyarılar — Alpnex</PageTitle>

<div class="d-flex align-center mb-4">
    <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Warning" Class="mr-2" />
    <MudText Typo="Typo.h5" Class="dw-pagetitle">Uyarılar</MudText>
    <MudSpacer />
    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Yenile</MudButton>
</div>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
    Tüm aktif uyarılar (bakım, muayene/sigorta, düşük stok, yakıt, evrak geçerlilik, geciken iş emri, bekleyen talep, duyurular).
    "Okundu" yalnız çan sayacını ve ana ekranı sakinleştirir — uyarı aktif olduğu sürece burada kalır, durumu kötüleşirse yeniden okunmamış olur.
</MudText>

@if (_alerts is null)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
}
else if (_alerts.Count == 0)
{
    <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="0" Style="border:1px dashed var(--mud-palette-lines-default);border-radius:16px;">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
        <MudText Typo="Typo.body1" Class="mt-2">Aktif uyarı yok.</MudText>
    </MudPaper>
}
else
{
    @* Kategori butonları (sayılı) — kullanıcı isteği 2026-07-25. Tıkla → yalnız o kategori; tekrar tıkla → Tümü. *@
    <div class="d-flex flex-wrap gap-2 mb-4">
        <MudButton Variant="@(_filter == "LowStock" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Inventory2" OnClick="@(() => Toggle("LowStock"))">Malzeme (@CountOf("LowStock"))</MudButton>
        <MudButton Variant="@(_filter == "Maintenance" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Build" OnClick="@(() => Toggle("Maintenance"))">Bakım (@CountOf("Maintenance"))</MudButton>
        <MudButton Variant="@(_filter == "Inspection" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.VerifiedUser" OnClick="@(() => Toggle("Inspection"))">Sigorta-Muayene (@CountOf("Inspection"))</MudButton>
        <MudButton Variant="@(_filter == "Fuel" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.LocalGasStation" OnClick="@(() => Toggle("Fuel"))">Yakıt (@CountOf("Fuel"))</MudButton>
        @* BLD-01 (ADR-172): yeni kaynaklar + "Tümü" görünümü + tümünü okundu. *@
        <MudButton Variant="@(_filter == "Document" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Folder" OnClick="@(() => Toggle("Document"))">Evrak (@CountOf("Document"))</MudButton>
        <MudButton Variant="@(_filter == "WorkOrder" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Assignment" OnClick="@(() => Toggle("WorkOrder"))">İş Emri (@CountOf("WorkOrder"))</MudButton>
        <MudButton Variant="@(_filter == "Request" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Description" OnClick="@(() => Toggle("Request"))">Talep (@CountOf("Request"))</MudButton>
        <MudButton Variant="@(_filter == "Announcement" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Campaign" OnClick="@(() => Toggle("Announcement"))">Duyuru (@CountOf("Announcement"))</MudButton>
        <MudButton Variant="@(_filter == "ALL" ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.ListAlt" OnClick="@(() => Toggle("ALL"))">Tümü (@(_alerts?.Count ?? 0))</MudButton>
        <MudSpacer />
        @if (_alertsSafe.Any(a => !a.Read))
        {
            <MudTooltip Text="Tüm aktif uyarıları okundu işaretler — çan sayacı sıfırlanır; uyarılar bu ekranda kalır.">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.DoneAll" OnClick="MarkAllRead" Disabled="_busy">Tümünü Okundu Yap</MudButton>
            </MudTooltip>
        }
    </div>

    @if (_filter is null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Uyarıları görmek için yukarıdan bir kategori seçin.</MudText>
    }
    else if (Filtered.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Bu kategoride aktif uyarı yok.</MudText>
    }
    <MudStack Spacing="2">
        @foreach (var a in Filtered)
        {
            <MudPaper Elevation="2" Class="pa-3" Style="@($"border-radius:14px;cursor:pointer;border-left:5px solid {(a.IsCritical ? "var(--mud-palette-error)" : "var(--mud-palette-warning)")};{(a.Read ? "opacity:0.6;" : "")}")"
                      @onclick="@(() => Open(a.NavigateKey))">
                <div class="d-flex align-center">
                    <MudAvatar Color="@(a.IsCritical ? Color.Error : Color.Warning)" Variant="Variant.Outlined" Class="mr-3">
                        <MudIcon Icon="@IconFor(a.Kind)" />
                    </MudAvatar>
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.body1"><b>@a.Title</b></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@a.Detail</MudText>
                    </div>
                    @if (a.IsCritical) { <MudChip T="string" Size="Size.Small" Color="Color.Error">Kritik</MudChip> }
                    @* BLD-01: okundu/okunmadı ayrımı + tek uyarıyı okundu işaretleme (satır tıklamasını tetiklemez). *@
                    @if (a.Read)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Okundu</MudChip>
                    }
                    else
                    {
                        <div @onclick:stopPropagation="true">
                            <MudTooltip Text="Okundu işaretle — çan sayacından düşer; durumu kötüleşirse yeniden görünür.">
                                <MudIconButton Icon="@Icons.Material.Filled.Done" Size="Size.Small" OnClick="@(() => MarkRead(a))" Disabled="_busy" />
                            </MudTooltip>
                        </div>
                    }
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="mud-text-secondary" />
                </div>
            </MudPaper>
        }
    </MudStack>
}

@code {
    // BLD-01: Read + Key + Signature eklendi (okundu işaretleme bu ekrandan da yapılır).
    private sealed record Alert(string Kind, string Title, string Detail, string NavigateKey, bool IsCritical,
        bool Read, string Key, string Signature);
    private List<Alert> _alertsSafe => _alerts ?? new();
    private List<Alert>? _alerts;
    private bool _busy;
    // null → henüz kategori seçilmedi (ipucu, 2026-07-26 isteği korunur); "ALL" → Tümü (BLD-01); aksi halde Kind.
    private string? _filter;

    private List<Alert> Filtered =>
        _filter is null ? new()
        : _filter == "ALL" ? _alertsSafe
        : _alertsSafe.Where(a => a.Kind == _filter).ToList();

    private int CountOf(string kind) => _alerts?.Count(a => a.Kind == kind) ?? 0;

    private void Toggle(string kind) => _filter = _filter == kind ? null : kind;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _alerts = null;
        try
        {
            var doc = await Api.GetObjectAsync("/api/dashboard");
            var list = new List<Alert>();
            if (doc.TryGetProperty("alerts", out var arr) && arr.ValueKind == JsonValueKind.Array)
                foreach (var a in arr.EnumerateArray())
                    list.Add(new Alert(
                        a.GetProperty("kind").GetString() ?? "",
                        a.GetProperty("title").GetString() ?? "",
                        a.TryGetProperty("detail", out var d) ? d.GetString() ?? "" : "",
                        a.TryGetProperty("navigateKey", out var n) ? n.GetString() ?? "" : "",
                        a.TryGetProperty("isCritical", out var c) && c.ValueKind == JsonValueKind.True,
                        a.TryGetProperty("read", out var rd) && rd.ValueKind == JsonValueKind.True,
                        a.TryGetProperty("key", out var k) ? k.GetString() ?? "" : "",
                        a.TryGetProperty("signature", out var sg) ? sg.GetString() ?? "" : ""));
            _alerts = list;
        }
        catch { _alerts = new(); }
    }

    private static string IconFor(string kind) => kind switch
    {
        "Maintenance" => Icons.Material.Filled.Build,
        "Inspection" => Icons.Material.Filled.VerifiedUser,
        "LowStock" => Icons.Material.Filled.Inventory2,
        "Fuel" => Icons.Material.Filled.LocalGasStation,
        "Document" => Icons.Material.Filled.Folder,       // BLD-01
        "WorkOrder" => Icons.Material.Filled.Assignment,  // BLD-01
        "Request" => Icons.Material.Filled.Description,   // BLD-01
        "Announcement" => Icons.Material.Filled.Campaign, // DYR-01
        _ => Icons.Material.Filled.Warning,
    };

    private void Open(string navigateKey)
    {
        if (string.IsNullOrEmpty(navigateKey)) return;
        // BLD-01: masaüstü nav anahtarı "work_orders" → web rotası "work-orders"; mevcut anahtarlarda
        // alt çizgi yok → dönüşüm eski davranışı değiştirmez.
        Nav.NavigateTo("/" + navigateKey.Replace(":", "/").Replace("_", "-"));
    }

    // ═══ BLD-01 (ADR-172) — okundu işaretleme ═══

    private async Task MarkRead(Alert a)
    {
        _busy = true;
        try { await Api.PostAsync("/api/alerts/read", new { key = a.Key, signature = a.Signature }); await Load(); }
        catch { }
        finally { _busy = false; }
    }

    private async Task MarkAllRead()
    {
        _busy = true;
        try { await Api.PostAsync("/api/alerts/read-all", new { }); await Load(); }
        catch { }
        finally { _busy = false; }
    }
}
