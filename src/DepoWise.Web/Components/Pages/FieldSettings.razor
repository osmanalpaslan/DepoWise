@page "/field-settings"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

@* ═══ ALAN AYARLARI (kullanıcı isteği 2026-09-03) — masaüstü FieldSettingsView'in web karşılığı ═══
   Formlardaki OPSİYONEL alanlar firma bazında ZORUNLU yapılır; sistem zorunluları kilitli görünür.
   Ayar diğer firmaları ETKİLEMEZ. Doğrulama/kilit servistedir (FieldRequirementService) — arayüz
   yalnız gösterim + tek tık kaydetmedir. *@

<MudText Typo="Typo.h5" GutterBottom="true" Class="dw-pagetitle">Alan Ayarları</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    <b>@Auth.CompanyDisplay</b> — zorunlu yaptığınız alanlar bu firmadaki TÜM kullanıcılar için geçerli olur; diğer firmalar etkilenmez.
</MudText>

@if (!Auth.CanView("field_settings"))
{
    <MudAlert Severity="Severity.Warning">Bu ekran için «Alan Ayarları» yetkisi gerekir.</MudAlert>
}
else if (_rows is null)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
}
else
{
    @* ⭐ M-30 (AR-GE 2026-10-18) — DÖNEM KİLİDİ (ay kapanışı); masaüstüyle aynı yer/aynı kural. Kayıt sunucuda,
       yalnız yönetici. Kontrolün kendisi servistedir (DonemKilidi.Dogrula) — burası yalnız ayar ekranıdır. *@
    <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:680px;">
        <MudText Typo="Typo.h6" Class="mb-1">Dönem kilidi (ay kapanışı)</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
            Seçilen gün dahil öncesine fatura, para, stok, yakıt ve bakım kaydı girilemez; o dönemin kayıtları iptal edilemez.
            Kapanmış ayın raporu böylece sonradan değişmez.
        </MudText>
        <div class="d-flex flex-wrap align-center gap-2">
            <MudDatePicker @bind-Date="_kilitTarihi" Label="Kapanış günü" Style="max-width:200px"
                           ReadOnly="@(!Auth.IsAdmin)" title="Kapatılacak dönemin son günü (bu gün DAHİL öncesi kilitlenir)." />
            @if (Auth.IsAdmin)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="KilitKaydet"
                           title="Seçilen gün dahil öncesini kapatır (tüm kullanıcılar ve bilgisayarlar için).">Kilitle</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="KilitKaldir"
                           title="Dönem kilidini kaldırır; geçmiş tarihlere yeniden kayıt girilebilir.">Kilidi Kaldır</MudButton>
            }
        </div>
        <MudText Typo="Typo.caption" Color="@(_kilitHata ? Color.Error : Color.Default)" Class="mud-text-secondary">@_kilitMesaj</MudText>
        @if (!Auth.IsAdmin) { <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Bu ayarı yalnız firma yöneticisi değiştirebilir.</MudText> }
    </MudPaper>

    @* ⭐ M-28 (AR-GE 2026-10-18) — SAYIM FARK TOLERANSI; masaüstüyle aynı kart. *@
    <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:680px;">
        <MudText Typo="Typo.h6" Class="mb-1">Sayım fark toleransı</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
            Sayımda bir malzemenin farkı sistem miktarının bu yüzdesini aşarsa sayımı yalnız ters kayıt yetkisi olan kişi kesinleştirir;
            diğerleri taslak kaydeder. Boş bırakılırsa kontrol yapılmaz.
        </MudText>
        <div class="d-flex flex-wrap align-center gap-2">
            <MudNumericField T="decimal?" @bind-Value="_tolerans" Label="Tolerans (%)" Min="0m" Max="100m" Format="0.##" HideSpinButtons="true"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:160px" ReadOnly="@(!Auth.IsAdmin)" />
            @if (Auth.IsAdmin)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ToleransKaydet">Kaydet</MudButton>
            }
        </div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_toleransMesaj</MudText>
    </MudPaper>

    @* ⭐ FAZ 4.6 (kullanıcı isteği 2026-09-06) — SATIR İÇİ "+" YÖNETİMİ (masaüstüyle aynı yer/aynı kural).
       Kapatılan tanımın yanında "+" görünmez; hızlı ekleme sunucuda da reddedilir. Tanım, "Tanım Düzenle"
       ekranından her zaman eklenebilir → firma kendi tanımını ekleyemez duruma DÜŞMEZ. *@
    <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:680px;">
        <MudText Typo="Typo.h6" Class="mb-1">Satır içi "+" (hızlı tanım ekleme)</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
            Kapatılan tanımın yanında "+" görünmez; kullanıcı o tanımı formdan ekleyemez.
            Tanım, "Tanım Düzenle" ekranından her zaman eklenebilir. Bu ayar yalnız sizin firmanızı etkiler.
        </MudText>
        @if (_artiSatirlar is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
        else
        {
            <MudSimpleTable Dense="true" Bordered="false" Style="background:transparent">
                <tbody>
                @foreach (var a in _artiSatirlar)
                {
                    <tr>
                        <td style="width:240px">@a.Label</td>
                        <td style="width:150px">
                            <MudCheckBox T="bool" Dense="true" Label="&quot;+&quot; açık" Value="@a.Enabled"
                                         ReadOnly="@(!Auth.IsAdmin)"
                                         ValueChanged="@(async (bool v) => await ArtiDegistir(a, v))" />
                        </td>
                        <td class="mud-text-secondary">@a.Screen</td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
            @if (!Auth.IsAdmin) { <MudText Typo="Typo.caption" Class="mud-text-secondary">Bu ayarı yalnız firma yöneticisi değiştirebilir.</MudText> }
            @if (_artiMesaj is not null) { <MudText Typo="Typo.caption" Color="@(_artiOk ? Color.Success : Color.Error)">@_artiMesaj</MudText> }
        }
    </MudPaper>

    @foreach (var ekran in _rows.GroupBy(r => Str(r, "screenLabel")))
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:680px;">
            <MudText Typo="Typo.h6" Class="mb-2">@ekran.Key</MudText>
            <MudSimpleTable Dense="true" Bordered="false" Style="background:transparent">
                <thead><tr><th style="width:220px">Alan</th><th style="width:120px">Zorunlu</th><th>Durum</th></tr></thead>
                <tbody>
                    @foreach (var r in ekran)
                    {
                        var sKey = Str(r, "screenKey"); var fKey = Str(r, "fieldKey");
                        var sistem = Bool(r, "systemRequired");
                        <tr>
                            <td>@Str(r, "label")</td>
                            <td>
                                <MudCheckBox T="bool" Dense="true" Value="@Bool(r, "required")"
                                             ReadOnly="@(sistem || !Auth.CanEdit("field_settings"))"
                                             ValueChanged="@(v => Kaydet(sKey, fKey, v))" />
                            </td>
                            <td class="mud-text-secondary">@Str(r, "statusText")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
    @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Style="max-width:680px">@_msg</MudAlert> }
}

@code {
    private JsonElement[]? _rows;
    private string? _msg; private bool _ok;

    protected override async Task OnInitializedAsync() { await Load(); await ArtiYukle(); await KilitYukle(); await ToleransYukle(); }

    // ═══ M-28 — SAYIM FARK TOLERANSI ═══
    private decimal? _tolerans;
    private string _toleransMesaj = "";

    private async Task ToleransYukle()
    {
        try
        {
            var o = await Api.GetObjectAsync("/api/stock/count-tolerance");
            _tolerans = o.TryGetProperty("tolerance", out var t) && t.ValueKind == JsonValueKind.Number ? t.GetDecimal() : null;
            _toleransMesaj = _tolerans is { } v ? $"Tolerans %{v:0.##}: farkı bunu aşan sayımı yalnız ters kayıt yetkisi olan kişi kesinleştirir." : "Tolerans yok: her sayım doğrudan kesinleşir.";
        }
        catch { _toleransMesaj = "Tolerans okunamadı."; }
    }

    private async Task ToleransKaydet()
    {
        var hata = await Api.PutAsync("/api/stock/count-tolerance", new { tolerance = _tolerans });
        if (hata is not null) { _toleransMesaj = hata; return; }
        await ToleransYukle();
    }

    // ═══ M-30 — DÖNEM KİLİDİ ═══
    private DateTime? _kilitTarihi;
    private long? _kilit;
    private string _kilitMesaj = "";
    private bool _kilitHata;

    private async Task KilitYukle()
    {
        try
        {
            var o = await Api.GetObjectAsync("/api/company/period-lock");
            KilitGoster(o.TryGetProperty("tarih", out var t) && t.ValueKind == JsonValueKind.Number ? t.GetInt64() : null);
        }
        catch { _kilitMesaj = "Dönem kilidi okunamadı."; _kilitHata = true; }
    }

    private void KilitGoster(long? k)
    {
        _kilit = k; _kilitHata = false;
        _kilitTarihi = k is { } kk ? DateTimeOffset.FromUnixTimeMilliseconds(kk).UtcDateTime.Date : null;
        _kilitMesaj = k is { } g
            ? $"Kilitli: {DateTimeOffset.FromUnixTimeMilliseconds(g).UtcDateTime:dd.MM.yyyy} dahil öncesine kayıt girilemez, o dönemin kayıtları iptal edilemez."
            : "Kilit yok: tüm tarihlere kayıt girilebilir.";
    }

    private async Task KilitKaydet()
    {
        if (_kilitTarihi is null) { _kilitMesaj = "Önce kapanış gününü seçin."; _kilitHata = true; return; }
        var ms = DepoWise.Web.Services.FieldChecks.ToUnixMs(_kilitTarihi);
        if (!await Dialog.Confirm($"{_kilitTarihi:dd.MM.yyyy} dahil öncesi kapatılsın mı? Bu tarihlere hiçbir kullanıcı kayıt giremez, " +
                                  "o dönemin kayıtları iptal edilemez (kilidi sonradan kaldırabilirsiniz).", "Kilitle")) return;
        var hata = await Api.PutAsync("/api/company/period-lock", new { tarih = ms });
        if (hata is not null) { _kilitMesaj = hata; _kilitHata = true; return; }
        await KilitYukle();
    }

    private async Task KilitKaldir()
    {
        if (_kilit is null) { _kilitMesaj = "Zaten kilit yok."; _kilitHata = false; return; }
        if (!await Dialog.Confirm("Dönem kilidi kaldırılsın mı? Geçmiş tarihlere yeniden kayıt girilebilir.", "Kaldır")) return;
        var hata = await Api.PutAsync("/api/company/period-lock", new { tarih = (long?)null });
        if (hata is not null) { _kilitMesaj = hata; _kilitHata = true; return; }
        await KilitYukle();
    }

    // ═══ FAZ 4.6 (kullanıcı isteği 2026-09-06) — SATIR İÇİ "+" AYARI ════════════════════════════
    private sealed class ArtiSatir { public string Table = ""; public string Label = ""; public string Screen = ""; public bool Enabled = true; }

    private List<ArtiSatir>? _artiSatirlar;
    private string? _artiMesaj;
    private bool _artiOk;

    private async Task ArtiYukle()
    {
        try
        {
            var arr = await Api.GetArrayAsync("/api/lookup-plus");
            _artiSatirlar = arr.Select(x => new ArtiSatir
            {
                Table = Str(x, "table"), Label = Str(x, "label"), Screen = Str(x, "screen"),
                Enabled = !x.TryGetProperty("enabled", out var e) || e.ValueKind != JsonValueKind.False,
            }).ToList();
        }
        catch { _artiSatirlar = new(); }
    }

    private async Task ArtiDegistir(ArtiSatir satir, bool acik)
    {
        if (!Auth.IsAdmin) return;
        var hata = await Api.PostAsync($"/api/lookup-plus/{satir.Table}", new { enabled = acik });
        _artiOk = hata is null;
        if (_artiOk)
        {
            satir.Enabled = acik;
            _artiMesaj = acik
                ? $"«{satir.Label}» için satır içi \"+\" açıldı."
                : $"«{satir.Label}» için satır içi \"+\" kapatıldı (tanım, Tanım Düzenle ekranından eklenebilir).";
        }
        else _artiMesaj = hata;
    }

    private async Task Load()
    {
        try { _rows = await Api.GetArrayAsync("/api/field-requirements/manage"); }
        catch { _rows = Array.Empty<JsonElement>(); }
    }

    private async Task Kaydet(string screenKey, string fieldKey, bool required)
    {
        _msg = null;
        var err = await Api.PostAsync("/api/field-requirements", new { screenKey, fieldKey, required });
        _ok = err is null;
        _msg = err ?? (required ? "Alan ZORUNLU yapıldı." : "Alan opsiyonele döndürüldü.");
        await Load();   // sunucudaki etkin durumu geri oku (hatalı istekte kutu eski hâline döner)
    }

    private static string Str(JsonElement e, string p) => e.TryGetProperty(p, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
    private static bool Bool(JsonElement e, string p) => e.TryGetProperty(p, out var v) && v.ValueKind == JsonValueKind.True;
}
