@page "/soon/{Area}"

<MudText Typo="Typo.h5" GutterBottom="true" Class="dw-pagetitle">@Title</MudText>

@* E6.8/ZB-5: uyarı kutusu yerine boş durum deseni (Home'daki kesikli çerçeveyle aynı dil).
   Labels sözlüğü ve route DEĞİŞMEDİ; yalnız görünüm. *@
<MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center justify-center"
          Style="border:1px dashed var(--mud-palette-lines-default); border-radius:16px; background:transparent;">
    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Color="Color.Primary" Style="font-size:44px;" />
    <MudText Typo="Typo.h6" Class="mt-3">@Title yakında</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1" Align="Align.Center">
        Bu ekran masaüstüyle birebir olacak şekilde web'e ekleniyor.
    </MudText>
</MudPaper>

@code {
    [Parameter] public string Area { get; set; } = "";

    private string Title => Labels.TryGetValue(Area, out var v) ? v : Area;

    // Masaüstü menü isimleriyle birebir (AppModules ile aynı).
    private static readonly Dictionary<string, string> Labels = new(StringComparer.OrdinalIgnoreCase)
    {
        ["reports"] = "Raporlar", ["definitions"] = "Tanımlar", ["users"] = "Kullanıcılar",
        ["permissions"] = "Yetkiler", ["permission_templates"] = "Yetki Şablonları",
        ["audit"] = "Sistem Logu", ["backup"] = "Yedek Yönetimi", ["settings"] = "Ayarlar",
        ["about"] = "Hakkında", ["server_backups"] = "Sunucu Yedekleri", ["branches"] = "Şube / Şantiye",
        ["personnel"] = "Personel", ["stock"] = "Stok İşlemleri", ["maintenance"] = "Bakım",
        ["inspection"] = "Muayene / Sigorta", ["fuel"] = "Yakıt", ["daily_activity"] = "Günlük Faaliyet",
        ["requests"] = "Malzeme Talep", ["vehicles"] = "Araçlar",
        ["stock_count"] = "Stok Sayım", ["vehicle_templates"] = "Şablonlar (Araç Genel Tanım)",
        ["trash"] = "Çöp Kutusu", ["import_export"] = "Excel Merkezi", ["developer"] = "Geliştirici Modu",
    };
}
