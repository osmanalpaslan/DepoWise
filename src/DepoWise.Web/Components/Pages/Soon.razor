@page "/soon/{Area}"

<MudText Typo="Typo.h5" GutterBottom="true">@Title</MudText>
<MudAlert Severity="Severity.Info">Bu ekran masaüstü uygulamasındaki ile birebir olacak şekilde web'e ekleniyor.</MudAlert>

@code {
    [Parameter] public string Area { get; set; } = "";

    private string Title => Labels.TryGetValue(Area, out var v) ? v : Area;

    // Masaüstü menü isimleriyle birebir (AppModules ile aynı).
    private static readonly Dictionary<string, string> Labels = new(StringComparer.OrdinalIgnoreCase)
    {
        ["reports"] = "Raporlar", ["definitions"] = "Tanımlar", ["users"] = "Kullanıcılar",
        ["permissions"] = "Yetkiler", ["permission_templates"] = "Yetki Şablonları",
        ["audit"] = "Sistem Logu", ["backup"] = "Yedek Yönetimi", ["settings"] = "Ayarlar",
        ["about"] = "Hakkında", ["server_backups"] = "Sunucu Yedekleri", ["branches"] = "Şube / Şantiye",
        ["personnel"] = "Personel", ["stock"] = "Stok İşlemleri", ["maintenance"] = "Bakım",
        ["inspection"] = "Muayene / Sigorta", ["fuel"] = "Yakıt", ["daily_activity"] = "Günlük Faaliyet",
        ["requests"] = "Malzeme Talep", ["vehicles"] = "Araçlar",
        ["stock_count"] = "Stok Sayım", ["vehicle_templates"] = "Şablonlar (Araç Genel Tanım)",
        ["trash"] = "Çöp Kutusu", ["import_export"] = "İmport / Export", ["developer"] = "Geliştirici Modu",
    };
}
