@page "/requests"
@page "/requests/{Section}"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@inject IJSRuntime JS

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Malzeme Talep — @SecTitle</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>



    @* ═══════════ TALEP FORMU ═══════════ *@
    @if (_sec == "form")
    {
        @if (Auth.CanCreate("requests"))
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:920px;">
                <MudText Typo="Typo.subtitle1">@(_editId is null ? "YENİ TALEP" : "TALEP DÜZENLE")</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">Belge no otomatik (TLP-YYYY-NNNN). Kaydedince talep yöneticiye iletilir; sonra düzenlenemez.</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6"><LookupSelect Label="Şube / Şantiye *" @bind-Value="_branch" Items="_branches" OnAdded="ReloadBranches" /></MudItem>
                    <MudItem xs="6" md="3"><MudDatePicker @bind-Date="_date" Label="Tarih" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    @* B-2: öncelik listede zaten gösteriliyordu ama hiçbir ekrandan SEÇİLEMİYORDU (tüm talepler
                       kalıcı olarak "Normal" kalıyordu). Etiketler ortak RequestPriorityInfo'dan gelir → masaüstüyle aynı. *@
                    <MudItem xs="6" md="3">
                        <MudSelect T="string" @bind-Value="_priority" Label="Öncelik" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true">
                            @foreach (var p in DepoWise.Application.Requests.RequestPriorityInfo.All)
                            {
                                <MudSelectItem T="string" Value="@DepoWise.Application.Requests.RequestPriorityInfo.ToDb(p)">
                                    @DepoWise.Application.Requests.RequestPriorityInfo.Label(p)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4"><LookupSelect Label="Talep Eden" @bind-Value="_requester" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" CreatePath="/api/personnel" CreateField="fullName" OnAdded="ReloadPersonnel" /></MudItem>
                    <MudItem xs="12" md="4"><LookupSelect Label="Depo Sorumlusu" @bind-Value="_warehouse" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" CreatePath="/api/personnel" CreateField="fullName" OnAdded="ReloadPersonnel" /></MudItem>
                    <MudItem xs="12" md="4"><LookupSelect Label="Onay Veren" @bind-Value="_approver" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" CreatePath="/api/personnel" CreateField="fullName" OnAdded="ReloadPersonnel" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_desc" Label="Açıklama" Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">TALEP KALEMLERİ</MudText>
                <MudGrid Spacing="2" Class="align-center">
                    <MudItem xs="12" md="5"><MudAutocomplete T="ApiClient.Opt" Label="Malzeme ara (kod/ad)" @bind-Value="_matSel" SearchFunc="SearchMaterial" ToStringFunc="@(o => o?.Name ?? "")" Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true" /></MudItem>
                    <MudItem xs="4" md="2"><MudNumericField T="decimal" @bind-Value="_matQty" Label="Miktar" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    @* 2026-10-10 (kullanıcı isteği): bir malzeme BİRDEN FAZLA araç için istenebilir — her seçim
                       aşağıdaki çip listesine eklenir, kutu bir sonraki araç için boşalır. *@
                    <MudItem xs="8" md="3"><MudAutocomplete T="ApiClient.Opt" Label="Araçlar (opsiyonel, çoklu)" Value="_matVehicle" ValueChanged="OnVehiclePicked" SearchFunc="SearchVehicle" ToStringFunc="@(o => o?.Name ?? "")" Placeholder="İç kod / plaka — her seçim eklenir" Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="false" /></MudItem>
                    <MudItem xs="12" md="2"><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddItem">Kalemi Ekle</MudButton></MudItem>
                </MudGrid>
                @if (_matVehicles.Count > 0)
                {
                    <div class="d-flex flex-wrap mt-1" style="gap:4px;">
                        @foreach (var v in _matVehicles.ToList())
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" OnClose="@(_ => _matVehicles.Remove(v))">@v.Name</MudChip>
                        }
                    </div>
                }
                @if (_itemErr is not null) { <MudText Typo="Typo.caption" Color="Color.Error">@_itemErr</MudText> }
                @if (_items.Count > 0)
                {
                    <MudSimpleTable Dense="true" Class="mt-1" Style="max-width:880px;">
                        <thead><tr><th style="text-align:center">KOD</th><th style="text-align:center">MALZEME</th><th style="text-align:center">ARAÇLAR</th><th style="text-align:center">MİKTAR</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var it in _items)
                            {
                                <tr>
                                    <td><b>@it.Code</b></td>
                                    <td>@it.Name</td>
                                    <td>@(it.Vehicles.Count == 0 ? "—" : string.Join(", ", it.Vehicles.Select(x => x.Name)))</td>
                                    <td style="width:120px"><MudNumericField T="decimal" @bind-Value="it.Qty" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></td>
                                    <td><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _items.Remove(it))">Kaldır</MudButton></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }

                <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="Clear">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_busy">@(_editId is null ? "Talebi Oluştur" : "Değişiklikleri Kaydet")</MudButton>
                </MudStack>
                @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
            </MudPaper>
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudText Typo="Typo.h6">Talepler</MudText><MudSpacer />
                        @* B-1: Immediate zorunlu — MudTextField varsayılanı "change/blur"da bağlar, bu yüzden
                           yazıp doğrudan Enter'a basıldığında arama metni sunucuya HİÇ ulaşmıyordu (tarayıcı
                           QA'sinde görüldü: kutu dolu, liste eski). Her tuşta bağlanır, Enter güncel değeri gönderir. *@
                        <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Belge no / açıklama ara..." Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:200px" OnKeyUp="OnSearchKey" />
                        @* B-1: durum değişince listeyi SUNUCUDAN yeniden çek (istemci tarafı süzme kaldırıldı). *@
                        <MudSelect T="string" Value="_filter" ValueChanged="OnFilterChanged" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:150px" Dense="true">
                            @foreach (var f in _filters) { <MudSelectItem T="string" Value="@f">@f</MudSelectItem> }
                        </MudSelect>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadList">Yenile</MudButton>
                    </MudStack>
                    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
                    else
                    {
                        var filtered = Filtered();
                        @if (filtered.Count == 0) { <MudText Class="mud-text-secondary">Seçili filtreye uygun talep bulunamadı.</MudText> }
                        else
                        {
                            <MudTable Items="filtered" Dense="true" Hover="true" Striped="true" OnRowClick="@(e => OpenDetail(e.Item))" T="JsonElement">
                                @* ÖNCELİK + ONAY DURUMU + OPERASYON DURUMU (Faz 1, madde 15-16). Metin ve renk
                                   sunucudan (ortak kaynak RequestOperationStatusInfo) gelir → masaüstüyle birebir aynı. *@
                                <HeaderContent><MudTh>BELGE NO</MudTh><MudTh>TARİH</MudTh><MudTh>KALEM</MudTh><MudTh>AÇIKLAMA</MudTh><MudTh>ÖNCELİK</MudTh><MudTh>ONAY DURUMU</MudTh><MudTh>OPERASYON DURUMU</MudTh></HeaderContent>
                                <RowTemplate>
                                    <MudTd>@Str(context, "docNo")</MudTd>
                                    <MudTd>@Date(context, "requestDate")</MudTd>
                                    <MudTd>@Str(context, "itemCount")</MudTd>
                                    <MudTd>@Str(context, "description")</MudTd>
                                    <MudTd><MudChip T="string" Size="Size.Small" Color="@OpsColor(Str(context,"priorityColor"))" Variant="Variant.Text">@Str(context, "priorityText")</MudChip></MudTd>
                                    <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(Int(context,"status"))" Variant="Variant.Text">@StatusTr(Int(context, "status"))</MudChip></MudTd>
                                    <MudTd><MudChip T="string" Size="Size.Small" Color="@OpsColor(Str(context,"operationStatusColor"))" Variant="Variant.Text">@Str(context, "operationStatusText")</MudChip></MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="0" Style="min-height:160px;">
                    @if (_detail is null) { <MudText Class="mud-text-secondary">Detay için bir talep seçin.</MudText> }
                    else
                    {
                        var dd = _detail.Value; var st = Int(dd, "status");
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">@Str(dd, "docNo")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(st)" Variant="Variant.Text">@StatusTr(st)</MudChip>
                        </MudStack>
                        <MudText Typo="Typo.subtitle2" Class="mt-2">KALEMLER</MudText>
                        @foreach (var it in _detailItems)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <div><MudText Typo="Typo.body2">@Str(it, "materialName")</MudText><MudText Typo="Typo.caption" Class="mud-text-secondary">@Str(it, "materialCode")</MudText>@if (!string.IsNullOrEmpty(Str(it, "vehiclesText"))) { <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Araç: @Str(it, "vehiclesText")</MudText> }</div>
                                <MudText Typo="Typo.body2"><b>@Str(it, "quantity")</b></MudText>
                            </MudStack>
                        }
                        <MudText Typo="Typo.subtitle2" Class="mt-2">DURUM GEÇMİŞİ</MudText>
                        @foreach (var h in _history) { <MudText Typo="Typo.caption" Class="mud-text-secondary">@h</MudText> }
                        <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-3" Spacing="2">
                            @if (Auth.CanEdit("requests") && (st == 0 || st == 1)) { <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => BeginEdit(Str(dd,"id")))">Düzenle</MudButton> }
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => DownloadPdf(Str(dd,"id"), false))">PDF</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => DownloadPdf(Str(dd,"id"), true))">Ekonomik PDF</MudButton>
                            @if (Auth.CanDelete("requests") && (st == 0 || st == 1)) { <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => CancelReq(Str(dd,"id")))">Talebi İptal Et</MudButton> }
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    @* ═══════════ TALEP ONAYLAMA ═══════════ *@
    @if (_sec == "approve")
    {
        <MudGrid Spacing="2">
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2"><MudText Typo="Typo.h6">Talep Onaylama (Bekleyen)</MudText><MudSpacer />
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadList">Yenile</MudButton></MudStack>
                    @{ var pending = (_rows ?? Array.Empty<JsonElement>()).Where(r => Int(r, "status") == 1).ToList(); }
                    @if (pending.Count == 0) { <MudText Class="mud-text-secondary">Onay bekleyen talep bulunmuyor.</MudText> }
                    else
                    {
                        <MudTable Items="pending" Dense="true" Hover="true" Striped="true" OnRowClick="@(e => OpenDetail(e.Item))" T="JsonElement">
                            <HeaderContent><MudTh>BELGE NO</MudTh><MudTh>TARİH</MudTh><MudTh>KALEM</MudTh><MudTh>AÇIKLAMA</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd>@Str(context, "docNo")</MudTd><MudTd>@Date(context, "requestDate")</MudTd><MudTd>@Str(context, "itemCount")</MudTd><MudTd>@Str(context, "description")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="0" Style="min-height:160px;">
                    @if (_detail is null || Int(_detail.Value, "status") != 1) { <MudText Class="mud-text-secondary">Onaylamak için bekleyen bir talep seçin.</MudText> }
                    else
                    {
                        var dd = _detail.Value;
                        <MudText Typo="Typo.h6">@Str(dd, "docNo")</MudText>
                        <MudText Typo="Typo.subtitle2" Class="mt-1">KALEMLER</MudText>
                        @foreach (var it in _detailItems)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <div><MudText Typo="Typo.body2">@Str(it, "materialName")</MudText><MudText Typo="Typo.caption" Class="mud-text-secondary">@Str(it, "materialCode")</MudText>@if (!string.IsNullOrEmpty(Str(it, "vehiclesText"))) { <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Araç: @Str(it, "vehiclesText")</MudText> }</div>
                                <MudText Typo="Typo.body2"><b>@Str(it, "quantity")</b></MudText>
                            </MudStack>
                        }
                        <MudTextField @bind-Value="_rejectReason" Label="Ret Gerekçesi" HelperText="Reddetmek için zorunlu." Margin="Margin.Dense" Variant="Variant.Outlined" Class="mt-2" />
                        <MudStack Row="true" Class="mt-1" Spacing="2">
                            @if (Auth.CanEdit("request_approval")) { <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => Approve(Str(dd,"id")))">Onayla</MudButton> }
                            @if (Auth.CanEdit("request_approval")) { <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => Reject(Str(dd,"id")))">Reddet</MudButton> }
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }


@code {
    [Parameter] public string? Section { get; set; }
    private string _sec => (Section ?? "form").ToLowerInvariant();
    private string SecTitle => _sec == "approve" ? "Talep Onaylama" : "Talep Formu";

    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };
    // B-6: "Taslak" seçeneği kaldırıldı — hiçbir zaman sonuç üretemiyordu (talepler daima
    // submitImmediately ile oluşturulur). Taslak DURUMU kaldırılmadı: eski/dış kaynaklı bir taslak
    // kaydı varsa "Tümü"de görünmeye ve StatusTr ile "Taslak" olarak etiketlenmeye devam eder.
    private static readonly string[] _filters = { "Tümü", "Beklemede", "Onaylı", "Reddedildi", "İptal" };

    private string? _editId, _branch, _requester, _warehouse, _approver;
    /// <summary>DÜZENLEME KİLİDİ: formun açıldığı andaki talep sürümü; kaydederken geri gönderilir (0 = yeni kayıt).</summary>
    private long _editVersion;
    private DateTime? _date;
    /// <summary>B-2: talep önceliği (db anahtarı). Varsayılan "normal" → mevcut davranış korunur.</summary>
    private string _priority = "normal";
    private string _desc = "";
    private ApiClient.Opt? _matSel, _matVehicle;
    private decimal _matQty;
    private readonly List<Item> _items = new();
    /// <summary>Şu an eklenmekte olan kalemin araçları (çip listesi). 2026-10-10: bir kalemde birden fazla araç.</summary>
    private readonly List<ApiClient.Opt> _matVehicles = new();
    private string? _itemErr;
    private sealed class Item { public string MaterialId = ""; public string Code = ""; public string Name = ""; public decimal Qty; public List<ApiClient.Opt> Vehicles = new(); }

    private List<ApiClient.Opt> _branches = new(), _personnel = new();
    private JsonElement[]? _rows;
    private JsonElement? _detail;
    private JsonElement[] _detailItems = Array.Empty<JsonElement>();
    private List<string> _history = new();
    private string _search = "", _filter = "Tümü", _rejectReason = "";
    private string? _msg; private bool _ok; private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CanCreate("requests"))
        {
            _branches = await Api.OptionsAsync("/api/branches", "id", "name");
            _personnel = await Api.OptionsAsync("/api/personnel", "id", "fullName");
        }
        await LoadList();
    }

    /// <summary>B-1: durum ve arama artık SUNUCUYA gönderilir. Eskiden parametresiz çağrılıyor, en yeni 200
    /// kayıt geliyor ve süzme istemcide yapılıyordu → 200'den eski talepler hiç bulunamıyordu.</summary>
    private async Task LoadList()
    {
        _rows = null;
        var q = new List<string>();
        if (_sec == "approve")
        {
            // ONAYLAMA sekmesi HER ZAMAN bekleyenleri ister; formdaki durum seçimi buraya sızmamalı.
            // (Yan fayda: bekleyen talepler artık "en yeni 200" penceresiyle sınırlı değil.)
            q.Add("status=pending");
        }
        else if (StatusKey(_filter) is { } st) q.Add("status=" + st);
        if (!string.IsNullOrWhiteSpace(_search)) q.Add("search=" + Uri.EscapeDataString(_search.Trim()));
        var url = "/api/requests" + (q.Count == 0 ? "" : "?" + string.Join("&", q));
        try { _rows = await Api.GetArrayAsync(url); } catch { _rows = Array.Empty<JsonElement>(); }
    }

    /// <summary>Ekrandaki Türkçe durum adı → API'nin beklediği db anahtarı ("Tümü" → null = filtre yok).</summary>
    private static string? StatusKey(string filter) => filter switch
    {
        "Taslak" => "draft", "Beklemede" => "pending", "Onaylı" => "approved",
        "Reddedildi" => "rejected", "İptal" => "cancelled", _ => null,
    };

    private async Task OnFilterChanged(string v) { _filter = v; await LoadList(); }
    private async Task ReloadBranches(string _) => _branches = await Api.OptionsAsync("/api/branches", "id", "name");
    private async Task ReloadPersonnel(string _) => _personnel = await Api.OptionsAsync("/api/personnel", "id", "fullName");

    /// <summary>B-1: süzme artık SUNUCUDA yapılıyor; burada yeniden süzmek eksik sonuç üretirdi
    /// (sunucu tüm veriyi tarar, istemci yalnız gelen sayfayı görürdü).</summary>
    private List<JsonElement> Filtered() => _rows is null ? new() : _rows.ToList();

    private async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") { await LoadList(); } }

    private async Task<IEnumerable<ApiClient.Opt>> SearchMaterial(string? t, CancellationToken ct)
    {
        // 2026-10-10 (kullanıcı isteği): seçerken malzeme KODU görünmeli → "KOD — AD" (masaüstüyle aynı biçim).
        var r = await Api.MaterialOptionsAsync("/api/materials" + (string.IsNullOrWhiteSpace(t) ? "" : $"?search={Uri.EscapeDataString(t)}"));
        return string.IsNullOrWhiteSpace(t) ? r.Take(DepoWise.Web.Services.FieldChecks.MaxUnfilteredOptions) : r;
    }
    private async Task<IEnumerable<ApiClient.Opt>> SearchVehicle(string? t, CancellationToken ct)
    {
        var r = await Api.OptionsAsync("/api/vehicles" + (string.IsNullOrWhiteSpace(t) ? "" : $"?search={Uri.EscapeDataString(t)}"), "id", "display");
        return string.IsNullOrWhiteSpace(t) ? r.Take(DepoWise.Web.Services.FieldChecks.MaxUnfilteredOptions) : r;
    }

    private const int MaxVehiclesPerItem = 50;   // RequestService.MaxVehiclesPerItem ile aynı

    /// <summary>Araç kutusunda seçim → çip listesine ekle, kutuyu bir sonraki araç için boşalt.</summary>
    private void OnVehiclePicked(ApiClient.Opt? v)
    {
        _itemErr = null;
        if (v is not null)
        {
            if (_matVehicles.Count >= MaxVehiclesPerItem) _itemErr = $"Bir kalemde en fazla {MaxVehiclesPerItem} araç seçilebilir.";
            else if (_matVehicles.All(x => x.Id != v.Id)) _matVehicles.Add(v);
        }
        _matVehicle = null;
    }

    private void AddItem()
    {
        _itemErr = null;
        if (_matSel is null) { _itemErr = "Önce bir malzeme seçin."; return; }
        if (_matQty <= 0) { _itemErr = "Geçerli bir miktar girin."; return; }
        // "KOD — AD" metni koda ve ada ayrılır (tabloda ayrı sütunlar).
        var parca = _matSel.Name.Split(" — ", 2);
        _items.Add(new Item
        {
            MaterialId = _matSel.Id, Code = parca.Length == 2 ? parca[0] : "", Name = parca.Length == 2 ? parca[1] : _matSel.Name,
            Qty = _matQty, Vehicles = _matVehicles.ToList(),
        });
        _matSel = null; _matQty = 0; _matVehicle = null; _matVehicles.Clear();
    }

    private async Task OpenDetail(JsonElement row)
    {
        _detail = row; var id = Str(row, "id");
        try { _detailItems = await Api.GetArrayAsync($"/api/requests/{id}/items"); } catch { _detailItems = Array.Empty<JsonElement>(); }
        try { _history = (await Api.GetArrayAsync($"/api/requests/{id}/history")).Select(e => e.GetString() ?? "").ToList(); } catch { _history = new(); }
    }

    // 🔴 GUI hatası (2026-08-12): Kind=Local tarihte eski desen istisna atıyordu (Reports'ta
    // "tarih seçmeden Sorgula" akışında gerçekten patladı). TEK kaynağa taşındı.
    private static long? Ms(DateTime? d) => DepoWise.Web.Services.FieldChecks.ToUnixMs(d);

    private async Task Save()
    {
        _msg = null;
        if (_items.Count == 0) { _msg = "En az bir kalem ekleyin."; _ok = false; return; }
        if (string.IsNullOrEmpty(_branch)) { _msg = "Şantiye seçin."; _ok = false; return; }
        if (!await Dialog.Confirm(_editId is null ? "Talep oluşturulsun mu?" : "Talep güncellensin mi?")) return;
        _busy = true;
        try
        {
            var body = new
            {
                items = _items.Select(i => new { materialId = i.MaterialId, quantity = i.Qty, vehicleId = i.Vehicles.FirstOrDefault()?.Id, note = (string?)null, vehicleIds = i.Vehicles.Select(v => v.Id).ToList() }).ToList(),
                branchId = _branch, requesterId = _requester, warehouseId = _warehouse, approverId = _approver,
                description = Empty(_desc), requestDate = Ms(_date), submitImmediately = _editId is null,
                priority = _priority,   // B-2: DTO'da zaten vardı, web göndermiyordu

                // version: DÜZENLEME KİLİDİ — düzenlemede geri gönderilir; talep arada değiştiyse sunucu 409 döner.
                version = _editId is not null && _editVersion > 0 ? (long?)_editVersion : null
            };
            var err = _editId is null ? await Api.PostAsync("/api/requests", body) : await Api.PutAsync($"/api/requests/{_editId}", body);
            _ok = err is null; _msg = err ?? (_editId is null ? "Talep oluşturuldu." : "Güncellendi.");
            if (_ok) { Clear(); await LoadList(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task BeginEdit(string id)
    {
        // ⭐ FAZ 4.2: standart işlem onayı (kullanıcı isteği 2026-09-06).
        if (!await Dialog.ConfirmEdit()) return;
        try
        {
            var d = await Api.GetObjectAsync($"/api/requests/{id}/edit");
            _editVersion = d.TryGetProperty("version", out var rv) && rv.ValueKind == JsonValueKind.Number ? rv.GetInt64() : 0; // düzenleme kilidi
            _editId = id; _branch = NullS(d, "branchId"); _requester = NullS(d, "requesterId"); _warehouse = NullS(d, "warehouseId"); _approver = NullS(d, "approverId");
            var pr = Str(d, "priorityDb"); _priority = string.IsNullOrWhiteSpace(pr) ? "normal" : pr;   // B-2
            _desc = Str(d, "description");
            _items.Clear();
            if (d.TryGetProperty("items", out var its) && its.ValueKind == JsonValueKind.Array)
                foreach (var it in its.EnumerateArray())
                {
                    // 2026-10-10: kalemin TÜM araçları (eski kayıtta yalnız tek araç alanı dolu olabilir).
                    var araclar = new List<ApiClient.Opt>();
                    if (it.TryGetProperty("vehicles", out var vs) && vs.ValueKind == JsonValueKind.Array)
                        foreach (var v in vs.EnumerateArray()) araclar.Add(new ApiClient.Opt(Str(v, "id"), Str(v, "display")));
                    else if (NullS(it, "vehicleId") is { } vid) araclar.Add(new ApiClient.Opt(vid, Str(it, "vehicleCode")));
                    _items.Add(new Item { MaterialId = Str(it, "materialId"), Code = Str(it, "code"), Name = Str(it, "name"), Qty = Dec(it, "quantity"), Vehicles = araclar });
                }
            _msg = null;
        }
        catch (Exception ex) { _msg = "Düzenlemeye alınamadı: " + ex.Message; _ok = false; }
    }

    private async Task Approve(string id) { if (!await Dialog.Confirm("Talep onaylansın mı?")) return; var e = await Api.PostAsync($"/api/requests/{id}/approve", new { }); _msg = e ?? "Onaylandı."; _ok = e is null; _detail = null; await LoadList(); }
    private async Task Reject(string id)
    {
        if (string.IsNullOrWhiteSpace(_rejectReason)) { _msg = "Ret gerekçesi zorunlu."; _ok = false; return; }
        if (!await Dialog.Confirm("Talep reddedilsin mi?", "Evet, Reddet", danger: true)) return;
        var e = await Api.PostAsync($"/api/requests/{id}/reject", new { id, reason = _rejectReason.Trim() }); _msg = e ?? "Reddedildi."; _ok = e is null; _rejectReason = ""; _detail = null; await LoadList();
    }
    private async Task CancelReq(string id)
    {
        // B-4: gerekçe artık sabit "Kullanıcı iptali" DEĞİL — kullanıcıdan alınır ve denetim kaydına yazılır.
        // Grup 3'te eklenen ortak ReasonInputDialog/AskReason yeniden kullanılıyor; boş bırakılırsa diyalog
        // kapanmaz ve HİÇBİR istek gönderilmez (vazgeçildiğinde null döner).
        var reason = await Dialog.AskReason(
            "Talep iptal edilecek. İptal edilen talep işleme alınamaz ve bu işlem geri alınamaz.");
        if (reason is null) return;
        var e = await Api.PostAsync($"/api/requests/{id}/cancel", new { id, reason }); _msg = e ?? "İptal edildi."; _ok = e is null; _detail = null; await LoadList();
    }

    private async Task DownloadPdf(string id, bool economic)
    {
        var (bytes, name) = await Api.GetFileAsync($"/api/requests/{id}/pdf?economic={economic.ToString().ToLowerInvariant()}", $"{id}.pdf");
        if (bytes is null) { _msg = "PDF üretilemedi."; _ok = false; return; }
        await JS.InvokeVoidAsync("dwDownload", name, Convert.ToBase64String(bytes), "application/pdf");
    }

    private void Clear()
    {
        _editId = null; _editVersion = 0; _branch = _requester = _warehouse = _approver = null; _date = null; _desc = "";
        _priority = "normal";   // B-2: yeni talep varsayılanı
        _items.Clear(); _matSel = null; _matVehicle = null; _matVehicles.Clear(); _matQty = 0; _itemErr = null;
    }

    private static string StatusTr(int s) => s switch { 0 => "Taslak", 1 => "Beklemede", 2 => "Onaylı", 3 => "Reddedildi", 4 => "İptal", _ => "?" };
    private static Color StatusColor(int s) => s switch { 2 => Color.Success, 3 => Color.Error, 1 => Color.Warning, 4 => Color.Default, _ => Color.Default };

    /// <summary>Ortak renk anahtarı (sunucudan: neutral|info|warning|primary|success|danger) → MudBlazor rengi.
    /// Masaüstü aynı anahtarı kendi rozet türüne eşler → iki platformda AYNI renk mantığı (madde 16).</summary>
    private static Color OpsColor(string key) => key switch
    {
        "success" => Color.Success,
        "warning" => Color.Warning,
        "danger" => Color.Error,
        "info" => Color.Info,
        "primary" => Color.Primary,
        _ => Color.Default,
    };

    private static string? Empty(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static string? NullS(JsonElement row, string key) { var s = Str(row, key); return string.IsNullOrEmpty(s) ? null : s; }
    private static int Int(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetInt32() : -1;
    private static decimal Dec(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0;
    private static string Date(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number
            ? DateTimeOffset.FromUnixTimeMilliseconds(v.GetInt64()).LocalDateTime.ToString("dd.MM.yyyy") : "—";
}
