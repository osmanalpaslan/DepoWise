@page "/"
@inject AuthState Auth
@inject ApiClient Api
@implements IDisposable

<PageTitle>DepoWise Yönetim</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">DepoWise — Yönetim Paneli</MudText>

@if (Auth.IsAuthenticated)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        Giriş yapıldı — Firma: <b>@Auth.CompanyId</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")
    </MudAlert>

    <MudCard Class="mb-4" Style="max-width:680px;">
        <MudCardContent>
            <MudText Typo="Typo.h6">Masaüstü Uygulaması</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Kurulum aracını indirin. Çalıştırınca uygulamayı sunucudan indirir, kurar ve bağlantı ayarlarını otomatik yapar.
            </MudText>
            <MudButton Href="@Api.SetupDownloadUrl" Target="_blank" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download">Masaüstü Kurulum Aracını İndir</MudButton>
        </MudCardContent>
    </MudCard>

    @if (Auth.IsSuperAdmin)
    {
        <MudText Typo="Typo.subtitle1">Hızlı Erişim</MudText>
        <MudStack Row="true" Spacing="2" Class="mt-2">
            <MudButton Href="/machines" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Devices">Makine Yönetimi</MudButton>
            <MudButton Href="/releases" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SystemUpdate">Güncelleme Yönetimi</MudButton>
            <MudButton Href="/companies" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Business">Firma Tanım</MudButton>
        </MudStack>
    }
}

@code {
    protected override void OnInitialized() => Auth.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnChanged;
}
