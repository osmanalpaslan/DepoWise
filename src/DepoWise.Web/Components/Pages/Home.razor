@page "/"
@using System.Text.Json
@inject AuthState Auth
@inject ApiClient Api
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Alpnex Yönetim</PageTitle>

@if (Auth.IsAuthenticated)
{
    <MudText Typo="Typo.h4" GutterBottom="true">Yönetim Paneli</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Firma: <b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")
    </MudText>

    <MudGrid Spacing="4">
        <!-- Sol: Kritik Uyarılar -->
        <MudItem xs="12" md="7">
            <div class="d-flex align-center mb-2">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Warning" Class="mr-2" />
                <MudText Typo="Typo.h6">Kritik Uyarılar</MudText>
            </div>
            @if (_alerts is null)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else if (_alerts.Count == 0)
            {
                <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="0" Style="border:1px dashed var(--mud-palette-lines-default); border-radius:16px;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                    <MudText Typo="Typo.body1" Class="mt-2">Aktif kritik uyarı yok.</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Bakım, muayene/sigorta ve stok durumu güncel.</MudText>
                </MudPaper>
            }
            else
            {
                @* Kategori butonları (sayılı) — kullanıcı isteği 2026-07-25. Tıkla → yalnız o kategori; tekrar tıkla → Tümü. *@
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <MudButton Variant="@(_filter == "LowStock" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Inventory2" OnClick="@(() => Toggle("LowStock"))">Malzeme (@CountOf("LowStock"))</MudButton>
                    <MudButton Variant="@(_filter == "Maintenance" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Build" OnClick="@(() => Toggle("Maintenance"))">Bakım (@CountOf("Maintenance"))</MudButton>
                    <MudButton Variant="@(_filter == "Inspection" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.VerifiedUser" OnClick="@(() => Toggle("Inspection"))">Sigorta-Muayene (@CountOf("Inspection"))</MudButton>
                    <MudButton Variant="@(_filter == "Fuel" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.LocalGasStation" OnClick="@(() => Toggle("Fuel"))">Yakıt (@CountOf("Fuel"))</MudButton>
                </div>
                @if (_filter is null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Uyarıları görmek için yukarıdan bir kategori seçin.</MudText>
                }
                else if (Filtered.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Bu kategoride aktif uyarı yok.</MudText>
                }
                <MudStack Spacing="2">
                    @foreach (var a in Filtered)
                    {
                        <MudPaper Elevation="2" Class="pa-3" Style="@($"border-radius:14px;cursor:pointer;border-left:5px solid {(a.IsCritical ? "var(--mud-palette-error)" : "var(--mud-palette-warning)")};")"
                                  @onclick="@(() => Open(a.NavigateKey))">
                            <div class="d-flex align-center">
                                <MudAvatar Color="@(a.IsCritical ? Color.Error : Color.Warning)" Variant="Variant.Outlined" Class="mr-3">
                                    <MudIcon Icon="@IconFor(a.Kind)" />
                                </MudAvatar>
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.body1"><b>@a.Title</b></MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@a.Detail</MudText>
                                </div>
                                <div @onclick:stopPropagation="true" @onclick="@(() => {})">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                               StartIcon="@Icons.Material.Filled.DoneAll"
                                               OnClick="@(() => MarkRead(a))">okundu</MudButton>
                                </div>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="mud-text-secondary" />
                            </div>
                        </MudPaper>
                    }
                </MudStack>
            }
            @if (_conflicts is { Count: > 0 })
            {
                <div class="d-flex align-center mb-2 mt-6">
                    <MudIcon Icon="@Icons.Material.Filled.SyncProblem" Color="Color.Error" Class="mr-2" />
                    <MudText Typo="Typo.h6">Senkron Çakışmaları</MudText>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                    Bu kayıtlar aynı anda hem web'de (siz) hem masaüstünde değiştirildi. En son düzenleyen geçerli oldu;
                    kayıt tekrar düzenlenene kadar bu geçerlidir.
                </MudText>
                <MudStack Spacing="2">
                    @foreach (var cf in _conflicts)
                    {
                        <MudPaper Elevation="2" Class="pa-3" Style="border-radius:14px;border-left:5px solid var(--mud-palette-error);">
                            <div class="d-flex align-center">
                                <MudAvatar Color="Color.Error" Variant="Variant.Outlined" Class="mr-3"><MudIcon Icon="@Icons.Material.Filled.SyncProblem" /></MudAvatar>
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.body1"><b>@Str(cf, "entityLabel")</b> — @Str(cf, "winnerText")</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        Web'de düzenleyen: @(string.IsNullOrEmpty(Str(cf, "adminName")) ? "—" : Str(cf, "adminName"))
                                    </MudText>
                                </div>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" OnClick="@(() => ResolveConflict(Str(cf, "id")))">Gizle</MudButton>
                            </div>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudItem>

        <!-- Sağ: Masaüstü kurulum (modern hero) -->
        <MudItem xs="12" md="5">
            <MudPaper Elevation="4" Class="pa-6"
                      Style="border-radius:20px;color:#fff;background:linear-gradient(135deg,#2563eb 0%,#1e293b 100%);">
                <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Size="Size.Large" Style="font-size:3rem;opacity:.9;" />
                <MudText Typo="Typo.h5" Class="mt-2" Style="color:#fff;">Masaüstü Uygulaması</MudText>
                <MudText Typo="Typo.body2" Class="mt-1" Style="color:rgba(255,255,255,.85);">
                    Kurulum aracını indirin. Çalıştırınca uygulamayı sunucudan indirir, kurar ve bağlantı
                    ayarlarını otomatik yapar. Güncellemeler otomatik gelir.
                </MudText>
                <MudButton Href="@Api.SetupDownloadUrl" Target="_blank" Variant="Variant.Filled"
                           Class="mt-4" Style="background:#fff;color:#1e293b;font-weight:600;border-radius:12px;"
                           StartIcon="@Icons.Material.Filled.Download" Size="Size.Large">
                    Kurulum Aracını İndir
                </MudButton>
                <MudText Typo="Typo.caption" Class="d-block mt-3" Style="color:rgba(255,255,255,.7);">
                    Windows · giriş için web kullanıcı bilgilerinizi kullanın
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private sealed record Alert(string Kind, string Title, string Detail, string NavigateKey, bool IsCritical, string Key, string Signature);
    private List<Alert>? _alerts;
    private string? _filter;   // null → Tümü; aksi halde Kind

    // İlk açılışta (kategori seçilmeden) hiçbir uyarı listelenmez — yalnız butonlar+sayılar (kullanıcı isteği 2026-07-26).
    private List<Alert> Filtered =>
        _filter is null ? new() : (_alerts ?? new()).Where(a => a.Kind == _filter).ToList();

    private int CountOf(string kind) => _alerts?.Count(a => a.Kind == kind) ?? 0;

    private void Toggle(string kind) => _filter = _filter == kind ? null : kind;
    private List<JsonElement>? _conflicts;
    private bool _loading;

    protected override void OnInitialized() => Auth.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        // Not: yalnızca `first` render'a bağlanmıyoruz — oturum tarayıcı deposundan render'dan SONRA
        // yüklendiği için ilk render'da IsAuthenticated=false olabilir; o durumda spinner sonsuza kalıyordu.
        // Artık auth hazır ve veri henüz çekilmemişse her render'da bir kez yükleme denenir.
        if (!Auth.IsAuthenticated || _alerts is not null || _loading) return;
        _loading = true;
        try
        {
            var doc = await Api.GetObjectAsync("/api/dashboard");
            var list = new List<Alert>();
            if (doc.TryGetProperty("alerts", out var arr) && arr.ValueKind == JsonValueKind.Array)
                foreach (var a in arr.EnumerateArray())
                {
                    // #18: okunmuş uyarılar ana ekranda gösterilmez (imza uyuşuyorsa).
                    if (a.TryGetProperty("read", out var rd) && rd.ValueKind == JsonValueKind.True) continue;
                    list.Add(new Alert(
                        a.GetProperty("kind").GetString() ?? "",
                        a.GetProperty("title").GetString() ?? "",
                        a.TryGetProperty("detail", out var d) ? d.GetString() ?? "" : "",
                        a.TryGetProperty("navigateKey", out var n) ? n.GetString() ?? "" : "",
                        a.TryGetProperty("isCritical", out var c) && c.ValueKind == JsonValueKind.True,
                        a.TryGetProperty("key", out var k) ? k.GetString() ?? "" : "",
                        a.TryGetProperty("signature", out var sg) ? sg.GetString() ?? "" : ""));
                }
            _alerts = list;
            StateHasChanged();
        }
        catch { _alerts = new(); }

        try
        {
            var arr = await Api.GetArrayAsync("/api/sync/conflicts");
            _conflicts = new List<JsonElement>(arr);
            StateHasChanged();
        }
        catch { _conflicts = new(); }
        _loading = false;
    }

    private static string Str(JsonElement e, string k)
        => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(k, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ToString()) : "";

    private async Task ResolveConflict(string id)
    {
        if (string.IsNullOrEmpty(id)) return;
        try { await Api.PostAsync($"/api/sync/conflicts/{id}/resolve", new { }); } catch { }
        _conflicts = _conflicts?.FindAll(c => Str(c, "id") != id);
        StateHasChanged();
    }

    private static string IconFor(string kind) => kind switch
    {
        "Maintenance" => Icons.Material.Filled.Build,
        "Inspection" => Icons.Material.Filled.VerifiedUser,
        "LowStock" => Icons.Material.Filled.Inventory2,
        "Fuel" => Icons.Material.Filled.LocalGasStation,
        _ => Icons.Material.Filled.Warning,
    };

    // #18: uyarıyı okundu işaretle → ana ekrandan kaldır (ilgili modül ekranında kalmaya devam eder).
    private async Task MarkRead(Alert a)
    {
        try { await Api.PostAsync("/api/alerts/read", new { key = a.Key, signature = a.Signature }); } catch { }
        _alerts = _alerts?.FindAll(x => x.Key != a.Key);
        StateHasChanged();
    }

    private void Open(string navigateKey)
    {
        if (string.IsNullOrEmpty(navigateKey)) return;
        Nav.NavigateTo("/" + navigateKey.Replace(":", "/"));
    }

    // Auth yüklenince/değişince yeniden render → OnAfterRenderAsync tekrar çalışır ve uyarıları yükler.
    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Changed -= OnChanged;
}
