@page "/"
@inject AuthState Auth

<PageTitle>DepoWise Yönetim</PageTitle>

<h1>DepoWise — Yönetim Konsolu</h1>
<p class="text-muted">Bu arayüz, masaüstüyle aynı .NET backend'i (DepoWise.Api) HTTP üzerinden kullanır. İş kuralları API'dedir.</p>

@if (Auth.IsAuthenticated)
{
    <div class="alert alert-success">
        Giriş yapıldı — Firma: <strong>@Auth.CompanyId</strong>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")
    </div>
    <ul>
        <li><a href="/machines">Makine Yönetimi</a></li>
        <li><a href="/releases">Sürümler / Güncelleme</a></li>
    </ul>
}
else
{
    <div class="alert alert-info">Başlamak için <a href="/login">giriş yapın</a>.</div>
}
