@page "/"
@using System.Text.Json
@inject AuthState Auth
@inject ApiClient Api
@inject NavigationManager Nav
@implements IDisposable

@*  ============================================================================
    Ana Ekran — Aurora görünümü.
    API DEĞİŞİKLİĞİ YOK: veri hâlâ yalnız /api/dashboard ve /api/sync/conflicts.
    Davranış aynı: kategori seçilmeden uyarı listelenmez (2026-07-26 isteği),
    aynı kategoriye tekrar tıklamak seçimi kaldırır, "okundu" aynı uca gider.
    Değişen: 4 kategori düğmesi → 4 sayılı KPI/filtre kartı; uyarı satırları
    daha okunur; masaüstü kartı ve senkron çakışmaları yeniden düzenlendi.
    ============================================================================ *@

<PageTitle>Alpnex Yönetim</PageTitle>

@if (Auth.IsAuthenticated)
{
    <div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
        <div>
            <MudText Typo="Typo.h4">Yönetim Paneli</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                <b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "") · @DateTime.Now.ToString("dd MMMM yyyy")
            </MudText>
        </div>
        @if (_alerts is { Count: > 0 })
        {
            <MudChip T="string" Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Warning" Variant="Variant.Outlined">
                @_alerts.Count aktif uyarı
            </MudChip>
        }
    </div>

    @if (_alerts is null)
    {
        <div class="dw-kpis mb-6">
            <div class="dw-kpi-skeleton"></div>
            <div class="dw-kpi-skeleton"></div>
            <div class="dw-kpi-skeleton"></div>
            <div class="dw-kpi-skeleton"></div>
        </div>
    }

    @* ── Sayılı KPI/filtre kartları — tıklayınca o kategori listelenir.
       Uyarı sayısı 0 olsa da gösterilir: "0 · uyarı yok" da bir bilgidir ve
       kartların yeri sabit kalır (filtre düğmesi görevi görüyorlar). ────────── *@
    @if (_alerts is not null)
    {
        <div class="dw-kpis mb-6">
            @foreach (var k in Kinds)
            {
                var active = _filter == k.Kind;
                <div class="dw-kpi @(active ? "active" : "")" @onclick="@(() => Toggle(k.Kind))">
                    <div class="dw-kpi-top">
                        <span class="dw-kpi-label">@k.Label</span>
                        <MudIcon Icon="@k.Icon" Size="Size.Small" Class="dw-kpi-icon" />
                    </div>
                    <div class="dw-kpi-value">@CountOf(k.Kind)</div>
                    <div class="dw-kpi-unit">@(CountOf(k.Kind) == 0 ? "uyarı yok" : "aktif uyarı")</div>
                </div>
            }
        </div>
    }

    <MudGrid Spacing="4">
        <!-- Sol: Kritik Uyarılar -->
        <MudItem xs="12" md="7">
            <div class="d-flex align-center mb-3">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Warning" Class="mr-2" />
                <MudText Typo="Typo.h6">Kritik Uyarılar</MudText>
            </div>
            @if (_alerts is null)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else if (_alerts.Count == 0)
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="0"
                          Style="border:1px dashed var(--mud-palette-lines-default); border-radius:16px;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                    <MudText Typo="Typo.body1" Class="mt-2">Aktif kritik uyarı yok.</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Bakım, muayene/sigorta ve stok durumu güncel.</MudText>
                </MudPaper>
            }
            else
            {
                @if (_filter is null)
                {
                    <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="0"
                              Style="border:1px dashed var(--mud-palette-lines-default); border-radius:16px;">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Color="Color.Default" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Uyarıları görmek için yukarıdaki kartlardan birini seçin.</MudText>
                    </MudPaper>
                }
                else if (Filtered.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Bu kategoride aktif uyarı yok.</MudText>
                }
                <MudStack Spacing="2">
                    @foreach (var a in Filtered)
                    {
                        <MudPaper Elevation="0" Class=@("dw-alert " + (a.IsCritical ? "crit" : "warn")) @onclick="@(() => Open(a.NavigateKey))">
                            <div class="dw-alert-ico"><MudIcon Icon="@IconFor(a.Kind)" Size="Size.Small" /></div>
                            <div class="flex-grow-1" style="min-width:0;">
                                <MudText Typo="Typo.body1" Style="font-weight:600;">@a.Title</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@a.Detail</MudText>
                            </div>
                            <div @onclick:stopPropagation="true">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           StartIcon="@Icons.Material.Filled.DoneAll"
                                           OnClick="@(() => MarkRead(a))">okundu</MudButton>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="mud-text-secondary" />
                        </MudPaper>
                    }
                </MudStack>
            }

            @if (_conflicts is { Count: > 0 })
            {
                <div class="d-flex align-center mb-2 mt-8">
                    <MudIcon Icon="@Icons.Material.Filled.SyncProblem" Color="Color.Error" Class="mr-2" />
                    <MudText Typo="Typo.h6">Senkron Çakışmaları</MudText>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                    Bu kayıtlar aynı anda hem web'de (siz) hem masaüstünde değiştirildi. En son düzenleyen geçerli oldu;
                    kayıt tekrar düzenlenene kadar bu geçerlidir.
                </MudText>
                <MudStack Spacing="2">
                    @foreach (var cf in _conflicts)
                    {
                        <MudPaper Elevation="0" Class="dw-alert crit">
                            <div class="dw-alert-ico"><MudIcon Icon="@Icons.Material.Filled.SyncProblem" Size="Size.Small" /></div>
                            <div class="flex-grow-1" style="min-width:0;">
                                <MudText Typo="Typo.body1" Style="font-weight:600;">@Str(cf, "entityLabel") — @Str(cf, "winnerText")</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    Web'de düzenleyen: @(string.IsNullOrEmpty(Str(cf, "adminName")) ? "—" : Str(cf, "adminName"))
                                </MudText>
                            </div>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" OnClick="@(() => ResolveConflict(Str(cf, "id")))">Gizle</MudButton>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudItem>

        <!-- Sağ: Masaüstü kurulum -->
        <MudItem xs="12" md="5">
            <MudPaper Elevation="0" Class="pa-6 dw-hero">
                <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Size="Size.Large" Style="font-size:2.6rem;color:var(--mud-palette-primary);" />
                <MudText Typo="Typo.h5" Class="mt-3">Masaüstü Uygulaması</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2" Style="line-height:1.6;">
                    Kurulum aracını indirin. Çalıştırınca uygulamayı sunucudan indirir, kurar ve bağlantı
                    ayarlarını otomatik yapar. Güncellemeler otomatik gelir.
                </MudText>
                <MudButton Href="@Api.SetupDownloadUrl" Target="_blank" Variant="Variant.Filled" Color="Color.Primary"
                           Class="mt-5" FullWidth="true" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Download">
                    Kurulum Aracını İndir
                </MudButton>
                <MudText Typo="Typo.caption" Class="d-block mt-3 mud-text-secondary">
                    Windows · giriş için web kullanıcı bilgilerinizi kullanın
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<style>

/* ── KPI / filtre kartları ────────────────────────────────────────────────── */
.dw-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
}
@@media (max-width: 1100px) { .dw-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@@media (max-width: 600px)  { .dw-kpis { grid-template-columns: 1fr; } }

.dw-kpi {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    padding: 15px 17px 16px;
    cursor: pointer;
    user-select: none;
    background: color-mix(in srgb, var(--mud-palette-text-primary) 4%, transparent);
    border: 1px solid var(--mud-palette-lines-default);
    transition: background-color .16s ease, border-color .16s ease, transform .16s cubic-bezier(.22,1,.36,1), box-shadow .18s ease;
    animation: dwKpiIn .34s cubic-bezier(.22,1,.36,1) both;
}
.dw-kpi:nth-child(2) { animation-delay: .05s; }
.dw-kpi:nth-child(3) { animation-delay: .10s; }
.dw-kpi:nth-child(4) { animation-delay: .15s; }
@@keyframes dwKpiIn { from { opacity: 0; transform: translate3d(0, 10px, 0); } to { opacity: 1; transform: none; } }

.dw-kpi:hover {
    background: color-mix(in srgb, var(--mud-palette-text-primary) 7%, transparent);
    border-color: color-mix(in srgb, var(--mud-palette-primary) 26%, var(--mud-palette-lines-default));
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(4,8,16,.16);
}
.dw-kpi:active { transform: translateY(0); }
.dw-kpi:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: 2px; }

/* Seçili kart — alt kenarda dolu marka çubuğu + ışıklı yüzey */
.dw-kpi.active {
    background: linear-gradient(150deg,
        color-mix(in srgb, var(--mud-palette-primary) 18%, transparent),
        color-mix(in srgb, var(--mud-palette-primary) 4%, transparent));
    border-color: color-mix(in srgb, var(--mud-palette-primary) 34%, transparent);
    box-shadow: 0 10px 26px color-mix(in srgb, var(--mud-palette-primary) 16%, transparent);
}
.dw-kpi.active::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px;
    background: linear-gradient(90deg, var(--mud-palette-primary), color-mix(in srgb, var(--mud-palette-primary) 25%, transparent));
}

.dw-kpi-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.dw-kpi-label {
    font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: var(--mud-palette-text-secondary);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: color .16s ease;
}
.dw-kpi.active .dw-kpi-label { color: var(--mud-palette-primary); }

/* İkon artık çıplak değil — kendi plakasında durur */
.dw-kpi-icon {
    flex: none;
    width: 30px; height: 30px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--mud-palette-text-primary) 6%, transparent);
    border: 1px solid var(--mud-palette-lines-default);
    color: var(--mud-palette-text-secondary);
    transition: background-color .16s ease, color .16s ease, border-color .16s ease;
}
.dw-kpi:hover .dw-kpi-icon { color: var(--mud-palette-text-primary); }
.dw-kpi.active .dw-kpi-icon {
    background: color-mix(in srgb, var(--mud-palette-primary) 18%, transparent);
    border-color: color-mix(in srgb, var(--mud-palette-primary) 30%, transparent);
    color: var(--mud-palette-primary);
}

.dw-kpi-value {
    font-size: 2rem; font-weight: 800; letter-spacing: -.035em; line-height: 1.05;
    margin-top: 10px;
    font-variant-numeric: tabular-nums;
    color: var(--mud-palette-text-primary);
}
/* Sıfır, "veri yok" değil "sorun yok" demektir — sessizleştirilir, gizlenmez */
.dw-kpi-value:has(+ .dw-kpi-unit) { color: var(--mud-palette-text-primary); }
.dw-kpi-unit { font-size: .73rem; color: var(--mud-palette-text-secondary); margin-top: 3px; }

/* Yükleniyor iskeleti (yalnız FAZ 5.2 uygulanırsa görünür) */
.dw-kpi-skeleton {
    border-radius: 16px; height: 104px;
    border: 1px solid var(--mud-palette-lines-default);
    background: linear-gradient(90deg,
        color-mix(in srgb, var(--mud-palette-text-primary) 4%, transparent) 0%,
        color-mix(in srgb, var(--mud-palette-text-primary) 9%, transparent) 50%,
        color-mix(in srgb, var(--mud-palette-text-primary) 4%, transparent) 100%);
    background-size: 220% 100%;
    animation: dwKpiShimmer 1.25s linear infinite;
}
.dw-kpi-skeleton:nth-child(2n) { animation-delay: .12s; }
@@keyframes dwKpiShimmer { from { background-position: -180% 0; } to { background-position: 180% 0; } }

/* ── Uyarı satırı ─────────────────────────────────────────────────────────── */
.dw-alert {
    position: relative;
    display: flex; align-items: center; gap: 13px;
    padding: 12px 15px 12px 17px;
    border-radius: 14px;
    cursor: pointer;
    transition: background-color .15s ease, transform .15s cubic-bezier(.22,1,.36,1), border-color .15s ease;
    animation: dwAlertIn .3s cubic-bezier(.22,1,.36,1) both;
}
.dw-alert:nth-child(2) { animation-delay: .04s; }
.dw-alert:nth-child(3) { animation-delay: .08s; }
.dw-alert:nth-child(4) { animation-delay: .12s; }
.dw-alert:nth-child(n+5) { animation-delay: .16s; }
@@keyframes dwAlertIn { from { opacity: 0; transform: translate3d(-6px, 0, 0); } to { opacity: 1; transform: none; } }

.dw-alert:hover { transform: translateX(3px); }

/* Sol kenarda durum çubuğu — renk körlüğünde de ayırt edilir (kalınlık + ikon) */
.dw-alert::before {
    content: ""; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px;
    border-radius: 0 999px 999px 0;
}
.dw-alert.crit {
    background: color-mix(in srgb, var(--mud-palette-error) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--mud-palette-error) 26%, transparent);
}
.dw-alert.crit::before { background: var(--mud-palette-error); }
.dw-alert.crit:hover {
    background: color-mix(in srgb, var(--mud-palette-error) 14%, transparent);
    border-color: color-mix(in srgb, var(--mud-palette-error) 40%, transparent);
}
.dw-alert.warn {
    background: color-mix(in srgb, var(--mud-palette-warning) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--mud-palette-warning) 24%, transparent);
}
.dw-alert.warn::before { background: var(--mud-palette-warning); }
.dw-alert.warn:hover {
    background: color-mix(in srgb, var(--mud-palette-warning) 14%, transparent);
    border-color: color-mix(in srgb, var(--mud-palette-warning) 38%, transparent);
}

.dw-alert-ico {
    width: 36px; height: 36px; flex: 0 0 auto; border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
}
.dw-alert.crit .dw-alert-ico {
    background: color-mix(in srgb, var(--mud-palette-error) 18%, transparent);
    color: var(--mud-palette-error);
}
.dw-alert.warn .dw-alert-ico {
    background: color-mix(in srgb, var(--mud-palette-warning) 20%, transparent);
    color: var(--mud-palette-warning);
}
/* Satır sonundaki ok — imleç satırın üstündeyken hafifçe ilerler */
.dw-alert .mud-icon-root:last-child { transition: transform .18s cubic-bezier(.22,1,.36,1); }
.dw-alert:hover .mud-icon-root:last-child { transform: translateX(3px); }
/* "okundu" butonu sessiz durur, gerektiğinde belirir */
.dw-alert .mud-button-root { opacity: .62; transition: opacity .15s ease; }
.dw-alert:hover .mud-button-root { opacity: 1; }

/* ── Masaüstü kurulum kartı ───────────────────────────────────────────────── */
.dw-hero {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--mud-palette-lines-default);
    background:
        radial-gradient(460px 280px at 88% 4%, color-mix(in srgb, var(--mud-palette-primary) 20%, transparent) 0%, transparent 68%),
        color-mix(in srgb, var(--mud-palette-text-primary) 4%, transparent);
}
.dw-hero::before {
    content: ""; position: absolute; left: 24px; right: 24px; top: -1px; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--mud-palette-primary) 55%, transparent), transparent);
}

/* ── Hareket azaltma tercihi ──────────────────────────────────────────────── */
@@media (prefers-reduced-motion: reduce) {
    .dw-kpi, .dw-alert { animation: none; }
    .dw-kpi-skeleton { animation: none; }
    .dw-kpi:hover, .dw-alert:hover { transform: none; }
}
</style>

@code {
    private sealed record Alert(string Kind, string Title, string Detail, string NavigateKey, bool IsCritical, string Key, string Signature);
    private List<Alert>? _alerts;
    private string? _filter;   // null → hiçbiri seçili değil; aksi halde Kind

    // KPI/filtre kartlarının tanımı — Kind değerleri API'den gelen kind'larla AYNI.
    private sealed record KindDef(string Kind, string Label, string Icon);
    private static readonly KindDef[] Kinds =
    {
        new("LowStock",    "Malzeme",          Icons.Material.Filled.Inventory2),
        new("Maintenance", "Bakım",            Icons.Material.Filled.Build),
        new("Inspection",  "Sigorta-Muayene",  Icons.Material.Filled.VerifiedUser),
        new("Fuel",        "Yakıt",            Icons.Material.Filled.LocalGasStation),
    };

    // İlk açılışta (kategori seçilmeden) hiçbir uyarı listelenmez — yalnız kartlar+sayılar (kullanıcı isteği 2026-07-26).
    private List<Alert> Filtered =>
        _filter is null ? new() : (_alerts ?? new()).Where(a => a.Kind == _filter).ToList();

    private int CountOf(string kind) => _alerts?.Count(a => a.Kind == kind) ?? 0;

    private void Toggle(string kind) => _filter = _filter == kind ? null : kind;
    private List<JsonElement>? _conflicts;
    private bool _loading;

    protected override void OnInitialized() => Auth.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        // Not: yalnızca `first` render'a bağlanmıyoruz — oturum tarayıcı deposundan render'dan SONRA
        // yüklendiği için ilk render'da IsAuthenticated=false olabilir; o durumda spinner sonsuza kalıyordu.
        // Artık auth hazır ve veri henüz çekilmemişse her render'da bir kez yükleme denenir.
        if (!Auth.IsAuthenticated || _alerts is not null || _loading) return;
        _loading = true;
        try
        {
            var doc = await Api.GetObjectAsync("/api/dashboard");
            var list = new List<Alert>();
            if (doc.TryGetProperty("alerts", out var arr) && arr.ValueKind == JsonValueKind.Array)
                foreach (var a in arr.EnumerateArray())
                {
                    // #18: okunmuş uyarılar ana ekranda gösterilmez (imza uyuşuyorsa).
                    if (a.TryGetProperty("read", out var rd) && rd.ValueKind == JsonValueKind.True) continue;
                    list.Add(new Alert(
                        a.GetProperty("kind").GetString() ?? "",
                        a.GetProperty("title").GetString() ?? "",
                        a.TryGetProperty("detail", out var d) ? d.GetString() ?? "" : "",
                        a.TryGetProperty("navigateKey", out var n) ? n.GetString() ?? "" : "",
                        a.TryGetProperty("isCritical", out var c) && c.ValueKind == JsonValueKind.True,
                        a.TryGetProperty("key", out var k) ? k.GetString() ?? "" : "",
                        a.TryGetProperty("signature", out var sg) ? sg.GetString() ?? "" : ""));
                }
            _alerts = list;
            StateHasChanged();
        }
        catch { _alerts = new(); }

        try
        {
            var arr = await Api.GetArrayAsync("/api/sync/conflicts");
            _conflicts = new List<JsonElement>(arr);
            StateHasChanged();
        }
        catch { _conflicts = new(); }
        _loading = false;
    }

    private static string Str(JsonElement e, string k)
        => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(k, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ToString()) : "";

    private async Task ResolveConflict(string id)
    {
        if (string.IsNullOrEmpty(id)) return;
        try { await Api.PostAsync($"/api/sync/conflicts/{id}/resolve", new { }); } catch { }
        _conflicts = _conflicts?.FindAll(c => Str(c, "id") != id);
        StateHasChanged();
    }

    private static string IconFor(string kind) => kind switch
    {
        "Maintenance" => Icons.Material.Filled.Build,
        "Inspection" => Icons.Material.Filled.VerifiedUser,
        "LowStock" => Icons.Material.Filled.Inventory2,
        "Fuel" => Icons.Material.Filled.LocalGasStation,
        _ => Icons.Material.Filled.Warning,
    };

    // #18: uyarıyı okundu işaretle → ana ekrandan kaldır (ilgili modül ekranında kalmaya devam eder).
    private async Task MarkRead(Alert a)
    {
        try { await Api.PostAsync("/api/alerts/read", new { key = a.Key, signature = a.Signature }); } catch { }
        _alerts = _alerts?.FindAll(x => x.Key != a.Key);
        StateHasChanged();
    }

    private void Open(string navigateKey)
    {
        if (string.IsNullOrEmpty(navigateKey)) return;
        Nav.NavigateTo("/" + navigateKey.Replace(":", "/"));
    }

    // Auth yüklenince/değişince yeniden render → OnAfterRenderAsync tekrar çalışır ve uyarıları yükler.
    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Changed -= OnChanged;
}
