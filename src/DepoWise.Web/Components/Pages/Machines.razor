@page "/machines"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Makineler — DepoWise</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Makine Yönetimi</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Kayıtlı makineleri onaylayın / pasife alın. (Süper Admin)</MudText>

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Yenile</MudButton>
    </MudStack>
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    @if (_machines is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_machines.Count == 0) { <MudText Class="mud-text-secondary">Kayıtlı makine yok (enrollment sonrası listelenir).</MudText> }
    else
    {
        <MudTable Items="_machines" Dense="true" Hover="true" Striped="true">
            <HeaderContent><MudTh>Bağlantı</MudTh><MudTh>Makine</MudTh><MudTh>Durum</MudTh><MudTh>Son Görülme</MudTh><MudTh>Kayıt</MudTh><MudTh /></HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="@(context.Online ? Color.Success : Color.Default)" />
                        <MudText Typo="Typo.caption">@(context.Online ? "Bağlı" : "Çevrimdışı")</MudText>
                    </MudStack>
                </MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.StatusText</MudTd>
                <MudTd>@context.LastSeenText</MudTd>
                <MudTd>@context.CreatedText</MudTd>
                <MudTd>
                    @if (context.CanActivate) { <MudButton Size="Size.Small" Color="Color.Primary" OnClick="() => Approve(context.Id)">Aktifleştir</MudButton> }
                    @if (context.Status == "revoked") { <MudButton Size="Size.Small" Color="Color.Success" OnClick="() => Reactivate(context.Id)">Yeniden Aktifleştir</MudButton> }
                    @if (context.IsActive) { <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => Revoke(context.Id)">Pasife Al</MudButton> }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<MachineDto>? _machines;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsAuthenticated) await Load();
    }

    private async Task Load()
    {
        _error = null;
        try { _machines = await Api.GetMachinesAsync(); }
        catch (Exception ex) { _error = "Yüklenemedi: " + ex.Message; }
    }

    private async Task Approve(string id) { try { await Api.ApproveMachineAsync(id); await Load(); } catch (Exception ex) { _error = ex.Message; } }
    private async Task Revoke(string id) { try { await Api.RevokeMachineAsync(id); await Load(); } catch (Exception ex) { _error = ex.Message; } }
    private async Task Reactivate(string id) { try { await Api.ReactivateMachineAsync(id); await Load(); } catch (Exception ex) { _error = ex.Message; } }
}
