@page "/machines"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IDialogService Dialog

<PageTitle>Makineler — Alpnex</PageTitle>

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Makine Yönetimi</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Firmayı seçip <b>Sorgula</b>ya basın — <b>şube seçmezseniz o firmanın TÜM makineleri</b> listelenir. Şube seçerseniz yalnız o şubedekiler gelir. Şubesi hiç atanmamış makineler için <b>Kayıtsız Makineler</b> görünümünü kullanın.</MudText>

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2" Wrap="Wrap.Wrap">
        <MudSelect T="string" @bind-Value="_mode" Label="Görünüm" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true" Style="min-width:190px">
            <MudSelectItem T="string" Value="@("byBranch")">Firma + Şube</MudSelectItem>
            <MudSelectItem T="string" Value="@("unassigned")">Kayıtsız Makineler (şubesiz)</MudSelectItem>
        </MudSelect>

        @if (_mode == "byBranch")
        {
            @if (Auth.IsSuperAdmin)
            {
                <MudSelect T="string" Value="_companyId" ValueChanged="OnCompanyChanged" Label="Firma" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Style="min-width:200px" Dense="true">
                    @foreach (var co in _companies) { <MudSelectItem T="string" Value="@co.Id">@co.Name</MudSelectItem> }
                </MudSelect>
            }
            <MudSelect T="string" @bind-Value="_branchId" Label="Şube / Şantiye" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Style="min-width:200px" Dense="true"
                       Disabled="@(Auth.IsSuperAdmin && string.IsNullOrEmpty(_companyId))">
                @foreach (var b in _branches) { <MudSelectItem T="string" Value="@b.Id">@b.Name</MudSelectItem> }
            </MudSelect>
            @* ⭐ MKN-1 (2026-08-20, kullanıcı bulgusu "makineleri listeleyemiyorum"): "Sorgula" ŞUBE
               SEÇİLENE KADAR KAPALIYDI. Süper admin firmayı seçse bile düğme gri kalıyor, seçse bile
               yalnız O ŞUBENİN makinelerini görüyordu — 9 şubeli firmada makineyi bulmak imkânsıza
               yakındı. Artık şube İSTEĞE BAĞLI: boş bırakılırsa firmanın TÜM makineleri listelenir
               (API zaten branchId olmadan çalışıyor). *@
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="Query"
                       Disabled="@(Auth.IsSuperAdmin && string.IsNullOrEmpty(_companyId))">Sorgula</MudButton>
            @if (Auth.IsSuperAdmin && !string.IsNullOrEmpty(_companyId))
            {
                <MudNumericField T="int" @bind-Value="_quota" Label="Makine Kotası" Min="1" Max="999" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:140px" />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveQuota">Kotayı Kaydet</MudButton>
            }
        }
        else
        {
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="Query">Kayıtsız Makineleri Getir</MudButton>
        }

        <MudSpacer />
        @if (_machines is not null) { <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Query">Yenile</MudButton> }
    </MudStack>

    @if (_msg is not null) { <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">@_msg</MudAlert> }
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }

    @if (_loading) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_machines is null) { <MudText Class="mud-text-secondary">Sorgulamak için firma + şube seçip "Sorgula"ya basın, ya da "Kayıtsız Makineler"i getirin.</MudText> }
    else if (_machines.Count == 0) { <MudText Class="mud-text-secondary">Bu seçimde makine yok. Şube seçiliyse kaldırıp tekrar sorgulayın — firmanın tüm makineleri listelenir.</MudText> }
    else
    {
        @* Makine adı arama kutusu (kullanıcı isteği 2026-07-19) *@
        <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Makine adı ara…" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" Variant="Variant.Outlined"
                      Clearable="true" Class="mb-2" Style="max-width:320px" />
        <MudTable Items="_machines" Filter="new Func<MachineDto,bool>(FilterMachine)" Dense="true" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Bağlantı</MudTh>
                @if (Auth.IsSuperAdmin) { <MudTh>Firma (değiştir)</MudTh> }
                <MudTh>Makine</MudTh><MudTh>İl</MudTh><MudTh>Şube (atama)</MudTh><MudTh>IPv4</MudTh><MudTh>IPv6</MudTh><MudTh>Durum</MudTh><MudTh>Son Görülme</MudTh><MudTh>Kayıt</MudTh><MudTh /></HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="@(context.Online ? Color.Success : Color.Default)" />
                        <MudText Typo="Typo.caption">@(context.Online ? "Bağlı" : "Çevrimdışı")</MudText>
                    </MudStack>
                </MudTd>
                @if (Auth.IsSuperAdmin)
                {
                    <MudTd>
                        <MudSelect T="string" Value="@context.CompanyId" ValueChanged="@(v => AssignCompany(context, v))"
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                   Placeholder="Firma seç…" Style="min-width:170px">
                            @foreach (var co in _companies) { <MudSelectItem T="string" Value="@co.Id">@co.Name</MudSelectItem> }
                        </MudSelect>
                    </MudTd>
                }
                <MudTd>@context.Name</MudTd>
                <MudTd>@(string.IsNullOrEmpty(context.Province) ? "—" : context.Province)</MudTd>
                <MudTd>
                    <MudSelect T="string" Value="@context.BranchId" ValueChanged="@(v => AssignBranch(context, v))"
                               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                               Placeholder="Şube seç…" Style="min-width:160px">
                        @foreach (var b in BranchesFor(context.CompanyId)) { <MudSelectItem T="string" Value="@b.Id">@b.Name</MudSelectItem> }
                    </MudSelect>
                </MudTd>
                <MudTd><code style="font-size:12px">@context.Ipv4</code></MudTd>
                <MudTd><code style="font-size:12px">@context.Ipv6</code></MudTd>
                <MudTd>@context.StatusText</MudTd>
                <MudTd>@context.LastSeenText</MudTd>
                <MudTd>@context.CreatedText</MudTd>
                <MudTd>
                    @if (context.CanActivate && context.Status == "pending") { <MudButton Size="Size.Small" Color="Color.Primary" OnClick="() => Approve(context.Id)">Onayla</MudButton> }
                    @if (context.Status == "revoked") { <MudButton Size="Size.Small" Color="Color.Success" OnClick="() => Reactivate(context.Id)">Yeniden Aktifleştir</MudButton> }
                    @if (context.IsActive) { <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => Revoke(context.Id)">Pasife Al</MudButton> }
                    @if (Auth.IsSuperAdmin)
                    {
                        <MudTooltip Text="Bu makineyi TÜM firmalardan koparır (veri silinmez) — bir sonraki girişte makine yeniden tanımlanır">
                            <MudButton Size="Size.Small" Color="Color.Warning" OnClick="() => ResetMachine(context)">Tanımı Sıfırla</MudButton>
                        </MudTooltip>
                    }
                    <MudTooltip Text="Sil"><MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Delete" OnClick="() => Delete(context)" /></MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<MachineDto>? _machines;   // null = henüz sorgulanmadı
    private string _search = "";
    private bool FilterMachine(MachineDto m) => string.IsNullOrWhiteSpace(_search) || (m.Name ?? "").Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase);
    private bool _loading;
    private string _mode = "byBranch";
    private List<ApiClient.Opt> _companies = new();
    private List<ApiClient.Opt> _branches = new();                       // seçili firmanın (veya kendi firmasının) şubeleri
    private readonly Dictionary<string, List<ApiClient.Opt>> _branchesByCompany = new(); // atama açılır-listesi için
    private string? _companyId;
    private string? _branchId;
    private int _quota = 3;
    private string? _error, _msg;

    private List<ApiClient.Opt> BranchesFor(string companyId)
        => _branchesByCompany.TryGetValue(companyId, out var list) ? list : new();

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;
        // ⭐ Korumasız bırakılmaz: sunucu 401/500 dönerse istisna render sırasında patlar ve Blazor
        // devresi tamamen düşer (bembeyaz ekran). Aynı düzeltme YET-C4'te üç ekrana uygulanmıştı.
        try
        {
            if (Auth.IsSuperAdmin)
                _companies = await Api.OptionsAsync("/api/companies", "id", "name");
            else if (!string.IsNullOrEmpty(Auth.CompanyId))
            {
                _branches = await Api.GetBranchOptionsAsync(Auth.CompanyId);   // normal admin: kendi firması
                _branchesByCompany[Auth.CompanyId] = _branches;
            }
        }
        catch (Exception ex) { _error = "Ekran yüklenemedi: " + ex.Message; }
        // Makineler burada YÜKLENMEZ (lazy) — kullanıcı seçim yapıp Sorgula'ya basınca çekilir.
    }

    private async Task OnCompanyChanged(string? companyId)
    {
        _companyId = companyId;
        _branchId = null;
        _branches = string.IsNullOrEmpty(companyId) ? new() : await Api.GetBranchOptionsAsync(companyId);
        if (!string.IsNullOrEmpty(companyId)) _branchesByCompany[companyId] = _branches;
        SyncQuota();
    }

    private void SyncQuota()
    {
        var m = _machines?.FirstOrDefault(x => x.CompanyId == _companyId);
        if (m is not null) _quota = m.Quota;
    }

    private async Task Query()
    {
        _error = _msg = null; _loading = true;
        try
        {
            if (_mode == "unassigned")
                _machines = await Api.GetMachinesAsync(unassigned: true);
            else
            {
                var company = Auth.IsSuperAdmin ? _companyId : Auth.CompanyId;
                _machines = await Api.GetMachinesAsync(company, _branchId);
            }
            SyncQuota();
            await LoadBranchesForMachines();
        }
        catch (Exception ex) { _error = "Yüklenemedi: " + ex.Message; }
        finally { _loading = false; }
    }

    // Listedeki makinelerin firmalarına ait şubeleri (atama açılır-listesi için) yükle.
    private async Task LoadBranchesForMachines()
    {
        if (_machines is null) return;
        foreach (var cid in _machines.Select(m => m.CompanyId).Where(c => !string.IsNullOrEmpty(c)).Distinct())
            if (!_branchesByCompany.ContainsKey(cid))
                _branchesByCompany[cid] = await Api.GetBranchOptionsAsync(cid);
    }

    private async Task AssignBranch(MachineDto m, string? branchId)
    {
        _msg = _error = null;
        var err = await Api.AssignMachineBranchAsync(m.Id, branchId);
        if (err is null)
        {
            var bname = string.IsNullOrEmpty(branchId) ? null : BranchesFor(m.CompanyId).FirstOrDefault(b => b.Id == branchId)?.Name;
            _msg = string.IsNullOrEmpty(branchId) ? $"'{m.Name}' makinesinin şube ataması kaldırıldı." : $"'{m.Name}' → '{bname}' şubesine atandı.";
            await Query();
        }
        else _error = err;
    }

    // Süper admin makinenin firmasını değiştirir (şube ataması otomatik kalkar). Makine yeni firmaya taşınır.
    private async Task AssignCompany(MachineDto m, string? companyId)
    {
        _msg = _error = null;
        if (string.IsNullOrEmpty(companyId) || companyId == m.CompanyId) return;
        var cname = _companies.FirstOrDefault(c => c.Id == companyId)?.Name ?? companyId;
        if (!await Dialog.Confirm($"'{m.Name}' makinesi '{cname}' firmasına taşınsın mı? Mevcut şube ataması kaldırılacaktır.", "Evet, Değiştir", danger: true)) return;
        var err = await Api.AssignMachineCompanyAsync(m.Id, companyId);
        if (err is null) { _msg = $"'{m.Name}' makinesi '{cname}' firmasına taşındı (şube ataması kaldırıldı)."; await Query(); }
        else _error = err;
    }

    private async Task SaveQuota()
    {
        _msg = _error = null;
        if (string.IsNullOrEmpty(_companyId)) return;
        var err = await Api.SetMachineQuotaAsync(_companyId, _quota);
        if (err is null) { _msg = $"Kota {_quota} olarak kaydedildi."; }
        else _error = err;
    }

    private async Task Approve(string id) { try { await Api.ApproveMachineAsync(id); await Query(); } catch (Exception ex) { _error = ex.Message; } }
    private async Task Revoke(string id) { try { await Api.RevokeMachineAsync(id); await Query(); } catch (Exception ex) { _error = ex.Message; } }
    private async Task Reactivate(string id) { try { await Api.ReactivateMachineAsync(id); await Query(); } catch (Exception ex) { _error = ex.Message; } }
    private async Task Delete(MachineDto m)
    {
        if (!await Dialog.Confirm($"'{m.Name}' makine kaydı kalıcı olarak silinsin mi?", "Evet, Sil", danger: true)) return;
        try { await Api.DeleteMachineAsync(m.Id); await Query(); } catch (Exception ex) { _error = ex.Message; }
    }

    // ADR-085 — makine adı firmalar arası bir anahtardır: bu makinenin TÜM firmalardaki kaydı silinir
    // (veri etkilenmez); masaüstü bir sonraki girişte bunu görüp kendi yerel makine önbelleğini temizler
    // ve login ekranına döner — sonraki giriş yapan kullanıcı makineyi yeniden tanımlar.
    private async Task ResetMachine(MachineDto m)
    {
        _msg = _error = null;
        if (!await Dialog.Confirm(
            $"'{m.Name}' makinesinin tanımı SIFIRLANSIN mı?\n\nBu makine tüm firmalardan koparılır (iş verisi etkilenmez). " +
            "Makine bir sonraki girişte firma/şube seçimini yeniden yapacaktır.",
            "Evet, Sıfırla", danger: true)) return;
        var err = await Api.RequestMachineResetAsync(m.Name);
        if (err is null) { _msg = $"'{m.Name}' makinesinin tanımı sıfırlandı — bir sonraki girişte yeniden tanımlanacak."; await Query(); }
        else _error = err;
    }
}
