@page "/theme"
@inject DepoWise.Web.Services.ThemeState ThemeSvc

<PageTitle>Tema — Alpnex</PageTitle>

<MudText Typo="Typo.h5" Class="dw-pagetitle">Tema</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Web arayüzü temasını seçin. Seçim anında uygulanır ve hesabınızla birlikte gelir.
    (Web'e özel — masaüstünden bağımsızdır.)
</MudText>

<MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Görünüm Modu</MudText>
<div style="max-width:620px;margin-top:10px;">
    @foreach (var o in Options)
    {
        var selected = ThemeSvc.Mode == o.Mode;
        <div class="@("dw-theme-card" + (selected ? " sel" : ""))" @onclick="@(() => Choose(o.Mode))">
            <MudIcon Icon="@o.Icon" Size="Size.Large" Color="@(selected ? Color.Primary : Color.Default)" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.h6">@o.Title</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@o.Desc</MudText>
            </div>
            @if (selected) { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" /> }
        </div>
    }
</div>

<MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-8">Görünüm Stili</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Menü, üst bar ve panellerin dokusunu seçin. Anında canlı önizlenir.</MudText>
<div style="max-width:620px;">
    @foreach (var st in DepoWise.Web.Services.ThemeState.Styles)
    {
        var sel = ThemeSvc.Style == st.Key;
        <div class="@("dw-theme-card" + (sel ? " sel" : ""))" @onclick="@(() => ChooseStyle(st.Key))">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Color="@(sel ? Color.Primary : Color.Default)" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1"><b>@st.Name</b></MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@st.Desc</MudText>
            </div>
            @if (sel) { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" /> }
        </div>
    }
</div>

<MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-8">Renk Teması</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Arayüzün ana rengini seçin. Her kutu o rengin üst bar ve menüde nasıl duracağını gösterir.</MudText>
<div class="dw-theme-swatches" style="max-width:620px;">
    @foreach (var p in DepoWise.Web.Services.ThemeState.Palettes)
    {
        var sel = ThemeSvc.Color == p.Key;
        <div class="@("dw-swatch" + (sel ? " sel" : ""))" style="@($"--dw-c:{p.Hex};")" @onclick="@(() => ChooseColor(p.Key))">
            <div class="dw-swatch-mini"><i></i><i></i><i></i></div>
            <div class="dw-swatch-name">@p.Name</div>
        </div>
    }
</div>

@code {
    private sealed record Opt(string Mode, string Title, string Desc, string Icon);

    private static readonly Opt[] Options =
    {
        new(DepoWise.Web.Services.ThemeState.Dark, "Koyu", "Göz yormayan koyu arayüz.", Icons.Material.Filled.DarkMode),
        new(DepoWise.Web.Services.ThemeState.Light, "Açık", "Aydınlık ortamlar için beyaz arayüz.", Icons.Material.Filled.LightMode),
        new(DepoWise.Web.Services.ThemeState.System, "Sistem", "İşletim sistemi/tarayıcı tercihini izler.", Icons.Material.Filled.SettingsBrightness),
    };

    private async Task Choose(string mode) => await ThemeSvc.SetModeAsync(mode);
    private async Task ChooseColor(string key) => await ThemeSvc.SetColorAsync(key);
    private async Task ChooseStyle(string key) => await ThemeSvc.SetStyleAsync(key);
}
