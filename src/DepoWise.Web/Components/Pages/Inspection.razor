@page "/inspection"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@inject IJSRuntime JS   // PRT-02: Excel indirme (dwDownload)

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Muayene / Sigorta</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

@* "Tüm Şubeler" modunda bu ekranda İŞLEM yapılamaz (kayıt hangi şubeye yazılacağı belli değil) — okuma serbest. *@
@if (Auth.IsAllBranches())
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">@DepoWise.Web.Services.BranchGuard.Banner</MudAlert>
}

@if (Auth.CanCreate("inspection"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:820px;">
        <MudText Typo="Typo.subtitle1" Class="mb-2">YENİ BELGE</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudAutocomplete T="ApiClient.Opt" Label="Araç *" @bind-Value="_vehicle" SearchFunc="SearchVehicle"
                                 ToStringFunc="@(o => o?.Name ?? "")" Placeholder="İç kod / plaka ara..." Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="_docType" Label="Belge Tipi" Margin="Margin.Dense" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("inspection")">Muayene</MudSelectItem>
                    <MudSelectItem T="string" Value="@("insurance")">Sigorta</MudSelectItem>
                    <MudSelectItem T="string" Value="@("kasko")">Kasko</MudSelectItem>
                    <MudSelectItem T="string" Value="@("calibration")">Kalibrasyon</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="3"><MudDatePicker @bind-Date="_lastDate" Label="Son Tarih" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="3"><MudDatePicker @bind-Date="_nextDate" Label="Sonraki Tarih" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="3"><MudTextField @bind-Value="_place" Label="Yer / Kurum" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            @if (_docType == "inspection")
            {
                <MudItem xs="6" md="3">
                    <MudSelect T="string" @bind-Value="_result" Label="Sonuç" Margin="Margin.Dense" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("Geçti")">Geçti</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Kaldı")">Kaldı</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Ertelendi")">Ertelendi</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (_result == "Ertelendi")
                {
                    <MudItem xs="6" md="3"><MudDatePicker @bind-Date="_postponeDate" Label="Erteleme Tarihi *" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                }
            }
            <MudItem xs="12"><MudTextField @bind-Value="_note" Label="Açıklama" Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
        </MudGrid>
        <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="Clear">İptal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_busy">Kaydet</MudButton>
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">Belgeler</MudText><MudSpacer />
        @* ⭐ PRT-02: liste ekranı kuralı — TÜM sonuç Excel'e aktarılabilir. *@
        <MudTooltip Text="Listedeki TÜM muayene/sigorta kayıtlarını Excel dosyası olarak indirir.">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ExportExcel">Excel'e Aktar</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="Yazdir">Yazdır</MudButton>
        </MudTooltip>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadList">Yenile</MudButton>
    </MudStack>
    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    @* ⭐ FAZ K §13: yüklenemeyen listeye "kayıt yok" demek YANLIŞ bilgidir — muayene/sigorta
       tarihleri kaçırılırsa yasal sonucu vardır; boş ekran sessizce yanlış güven verir. *@
    else if (_listeHatasi is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="my-2">
            Muayene/sigorta listesi yüklenemedi (@_listeHatasi). Bu, kayıtların olmadığı anlamına GELMEZ.
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="LoadList" Class="ml-2">Tekrar dene</MudButton>
        </MudAlert>
    }
    else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Henüz muayene/sigorta kaydı yok.</MudText> }
    else
    {
        <MudTable Items="_rows" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="55vh">
            <HeaderContent><MudTh>ARAÇ</MudTh><MudTh>BELGE</MudTh><MudTh>SON</MudTh><MudTh>SONRAKİ</MudTh><MudTh>YER</MudTh><MudTh>DURUM</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@Str(context, "vehicleText")</MudTd>
                <MudTd>@Str(context, "docTypeText")</MudTd>
                <MudTd>@Str(context, "lastText")</MudTd>
                <MudTd>@Str(context, "nextText")</MudTd>
                <MudTd>@Str(context, "place")</MudTd>
                <MudTd>@Str(context, "statusText")</MudTd>
                @* B-5: belge iptali — fiziksel silme YOK. Gerekçe ortak AskReason penceresiyle alınır
                   (Grup 3/4'te eklenen bileşen; yeni dialog sistemi kurulmadı). *@
                <MudTd Style="text-align:right">
                    @if (Auth.CanEdit("inspection"))
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                   OnClick="@(() => CancelDoc(Str(context, "id"), Long(context, "version")))">İptal Et</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };
    private ApiClient.Opt? _vehicle;
    private string _docType = "inspection", _result = "Geçti", _place = "", _note = "";
    private DateTime? _lastDate, _nextDate, _postponeDate;
    private JsonElement[]? _rows;
    private string? _msg; private bool _ok; private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadList();


    /// <summary>⭐ PRT-02 (2026-09-04): Excel'e aktar — listedeki TÜM muayene/sigorta kayıtları
    /// (projenin liste ekranı kuralı). Desen /api/assignments/export ile aynı.</summary>
    private async Task ExportExcel()
    {
        var (bytes, name) = await Api.GetFileAsync("/api/inspection/export", "Muayene.xlsx");
        if (bytes is null) { _msg = "Excel indirilemedi (dışa aktarım yetkiniz olmayabilir)."; _ok = false; return; }
        await JS.InvokeVoidAsync("dwDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    // ⭐ 2026-09-06 (kullanıcı isteği "A grubu"): YAZDIR. Excel ile AYNI uç ve AYNI süzgeçler;
    // yalnız format=pdf eklenir → iki çıktı asla ayrışmaz. Masaüstündeki "Yazdır" düğmesinin karşılığı.
    private async Task Yazdir()
    {
        var (bytes, name) = await Api.GetFileAsync($"/api/inspection/export?format=pdf", "Muayene.pdf");
        if (bytes is null) { _msg = "PDF indirilemedi (dışa aktarım yetkiniz olmayabilir)."; _ok = false; return; }
        await JS.InvokeVoidAsync("dwDownload", name, Convert.ToBase64String(bytes),
            "application/pdf");
    }
    /// <summary>FAZ K §13: liste yüklenemediğinde sebebi. null = hata yok (boş liste GERÇEKTEN boş).</summary>
    private string? _listeHatasi;

    private async Task LoadList()
    {
        _rows = null; _listeHatasi = null;
        try { _rows = await Api.GetArrayAsync("/api/inspection"); }
        // ⭐ FAZ K §13: hata YUTULMAZ — sebep saklanır ve kullanıcıya gösterilir.
        catch (Exception ex)
        {
            _rows = Array.Empty<JsonElement>();
            _listeHatasi = ex is HttpRequestException ? "sunucuya ulaşılamadı" : "beklenmeyen hata";
        }
    }

    /// <summary>
    /// B-5: belge iptali. Kayıt SİLİNMEZ — sunucuda <c>is_deleted=1</c> olur, gerekçe denetim kaydına yazılır,
    /// geçmiş korunur. Gerekçe boş bırakılırsa pencere kapanmaz ve HİÇBİR istek gönderilmez; sunucu da boş
    /// gerekçeyi 400 ile reddeder (çift kapı). Ortak <c>AskReason</c> yeniden kullanıldı.
    /// </summary>
    private async Task CancelDoc(string id, long version)
    {
        if (string.IsNullOrEmpty(id)) return;
        var reason = await Dialog.AskReason(
            "Bu belge iptal edilecek. İptal edilen belge listede görünmez ve araç uyarılarında dikkate " +
            "alınmaz. Kayıt geçmişte saklanır. İşlem geri alınamaz.");
        if (reason is null) return;
        _busy = true;
        try
        {
            var err = await Api.PostAsync($"/api/inspection/{id}/cancel", new { reason, version });
            _ok = err is null; _msg = err ?? "Belge iptal edildi.";
            if (_ok) await LoadList();
        }
        finally { _busy = false; }
    }

    private async Task<IEnumerable<ApiClient.Opt>> SearchVehicle(string? t, CancellationToken ct)
    {
        var r = await Api.OptionsAsync("/api/vehicles" + (string.IsNullOrWhiteSpace(t) ? "" : $"?search={Uri.EscapeDataString(t)}"), "id", "display");
        return string.IsNullOrWhiteSpace(t) ? r.Take(DepoWise.Web.Services.FieldChecks.MaxUnfilteredOptions) : r;
    }

    // 🔴 GUI hatası (2026-08-12): Kind=Local tarihte eski desen istisna atıyordu (Reports'ta
    // "tarih seçmeden Sorgula" akışında gerçekten patladı). TEK kaynağa taşındı.
    private static long? Ms(DateTime? d) => DepoWise.Web.Services.FieldChecks.ToUnixMs(d);
    private string DocLabel => _docType switch { "inspection" => "Muayene", "insurance" => "Sigorta", "kasko" => "Kasko", "calibration" => "Kalibrasyon", _ => _docType };

    private async Task Save()
    {
        _msg = null;
        if (!await Dialog.RequireBranchAsync(Auth, "Muayene / Sigorta")) return;   // "Tüm Şubeler" modunda işlem yok
        if (_vehicle is null) { _msg = "Araç seçin."; _ok = false; return; }
        var isInspection = _docType == "inspection";
        if (isInspection && _result == "Ertelendi" && _postponeDate is null) { _msg = "Ertelendi seçildi: erteleme tarihi zorunlu."; _ok = false; return; }
        // Tarih mantığı uyarıları (madde 5+9) — kullanıcı onaylarsa engellenmez.
        var nextForCheck = isInspection && _result == "Ertelendi" ? _postponeDate : _nextDate;
        if (_lastDate is not null && nextForCheck is not null && nextForCheck < _lastDate
            && !await Dialog.Confirm("Sonraki tarih, son tarihten ÖNCE görünüyor (mantıksız olabilir). Yine de kaydedilsin mi?", "Evet, Kaydet")) return;
        if (nextForCheck is not null && nextForCheck.Value.Date < DateTime.Today
            && !await Dialog.Confirm("Sonraki tarih geçmişte kalıyor. Yine de kaydedilsin mi?", "Evet, Kaydet")) return;
        if (!await Dialog.Confirm($"{DocLabel} belgesi kaydedilsin mi?")) return;
        _busy = true;
        try
        {
            // Sonuç yalnız Muayene'de; Ertelendi ise sonraki tarih = erteleme tarihi
            var next = isInspection && _result == "Ertelendi" ? _postponeDate : _nextDate;
            var err = await Api.PostAsync("/api/inspection", new
            {
                vehicleId = _vehicle.Id, docType = _docType, lastDate = Ms(_lastDate), nextDate = Ms(next),
                result = isInspection ? _result : null, place = Empty(_place), note = Empty(_note)
            });
            _ok = err is null; _msg = err ?? "Kaydedildi.";
            if (_ok) { Clear(); await LoadList(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private void Clear()
    {
        _vehicle = null; _docType = "inspection"; _result = "Geçti"; _place = _note = "";
        _lastDate = _nextDate = _postponeDate = null; _msg = null;
    }

    private static string? Empty(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
    /// <summary>B-5: düzenleme kilidi jetonu. Eksikse 0 → sunucu kilit kontrolü yapmaz (geriye uyumlu).</summary>
    private static long Long(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetInt64() : 0;

    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
}
