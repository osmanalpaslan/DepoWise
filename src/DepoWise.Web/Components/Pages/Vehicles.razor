    {
        if (_isNew && Auth.CanCreate("vehicles"))
        {
            _types = await Api.OptionsAsync("/api/lookups/vehicle_types", "id", "name");
            _cats = await Api.OptionsAsync("/api/lookups/vehicle_categories", "id", "name");
            _brands = await Api.OptionsAsync("/api/lookups/vehicle_brands", "id", "name");
            _branches = await Api.OptionsAsync("/api/branches", "id", "name");
            _drivers = await Api.OptionsAsync("/api/personnel", "id", "fullName");
            await LoadTemplates();
            var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
            if (q.TryGetValue("edit", out var eid) && !string.IsNullOrEmpty(eid))
            {
                try { _detail = await Api.GetObjectAsync($"/api/vehicles/{eid}"); await BeginEdit(); } catch { }
            }
        }
        if (!_isNew)
        {
            var saved = await Api.GetListColumnsAsync("vehicles");
            // İş #10: kaydedilmiş tercih KATALOĞA göre süzülür — masaüstüyle aynı kural (hayalet kolon çizilmesin).
            if (saved is { Count: > 0 }) _visibleColumns = VehicleListColumns.Sanitize(saved).ToList();
            var (ps, _) = await Api.GetListPrefsAsync("vehicles");
            if (ps is > 0) _pageSize = ps.Value;   // genişlik yüklenmez (kalıcı değil)
            await Load();
        }
    }

