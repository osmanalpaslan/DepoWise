    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_brand != _lastBrand)
        {
            _lastBrand = _brand;
            if (!_suppressModelReset) _model = null;
            _suppressModelReset = false;
            _models = string.IsNullOrEmpty(_brand) ? new() : await Api.OptionsAsync($"/api/vehicles/models/{_brand}", "id", "name");
            StateHasChanged();
        }
        if (_template != _lastTemplate)
        {
            _lastTemplate = _template;
            await ApplyTemplate();
        }
