    private async Task BeginEdit()
    {
        if (_detail is null) return;
        var d = _detail.Value;
        _editId = Str(d, "id");
        _editVersion = d.TryGetProperty("version", out var vv) && vv.ValueKind == JsonValueKind.Number ? vv.GetInt64() : 0; // düzenleme kilidi
        _template = NullS(d, "templateId"); _lastTemplate = _template;   // mevcut şablon bağı (diff prefill tetiklemesin)
        _code = Str(d, "internalCode"); _plate = Str(d, "plate"); _status = string.IsNullOrEmpty(Str(d, "status")) ? "active" : Str(d, "status");
        _meterUnit = string.IsNullOrEmpty(Str(d, "meterUnit")) ? "km" : Str(d, "meterUnit"); _meter = Dec(d, "currentMeter");
        _year = d.TryGetProperty("productionYear", out var y) && y.ValueKind == JsonValueKind.Number ? y.GetInt32() : null;
        _statusNote = Str(d, "statusNote"); _chassis = Str(d, "chassisNo"); _engine = Str(d, "engineNo");
        _type = NullS(d, "vehicleTypeId"); _cat = NullS(d, "categoryId"); _brand = NullS(d, "brandId");
        _lastBrand = _brand; _suppressModelReset = true;
        _models = string.IsNullOrEmpty(_brand) ? new() : await Api.OptionsAsync($"/api/vehicles/models/{_brand}", "id", "name");
        _model = NullS(d, "vehicleModelId"); _branch = NullS(d, "branchId"); _driver = NullS(d, "driverPersonnelId");
        _msg = null;
        await LoadHistoryAsync(_editId);
    }

    // İşlem Geçmişi (madde 4, 2026-08-06): Günlük Faaliyet hareketleri + sistem olayları (oluşturma/transfer/
    // güncelleme/sayaç) TEK kronolojik listede birleşir. Salt-okunur.
    private sealed record HistoryItem(long Date, string DateText, string Kind, string Description, string? OpenUrl);
    private List<HistoryItem>? _history;

    private async Task LoadHistoryAsync(string? id)
    {
        _history = null;
        if (string.IsNullOrEmpty(id)) return;
        var items = new List<HistoryItem>();
        try
        {
            foreach (var mv in await Api.GetArrayAsync($"/api/vehicles/{id}/movements"))
            {
                var date = mv.TryGetProperty("activityDate", out var ad) && ad.TryGetInt64(out var ms) ? ms : 0L;
                var kind = Str(mv, "movementKind") == "transfer" ? "Transfer" : "Hareket";
                items.Add(new HistoryItem(date, DateTimeOffset.FromUnixTimeMilliseconds(date).LocalDateTime.ToString("dd.MM.yyyy"),
                    kind, Str(mv, "description"), "/daily"));
            }
        }
        catch { }
        try
        {
            foreach (var h in await Api.GetArrayAsync($"/api/vehicles/{id}/history?take=100"))
            {
                var date = h.TryGetProperty("date", out var dd) && dd.TryGetInt64(out var ms) ? ms : 0L;
                var label = Str(h, "label");
                var detail = Str(h, "detail");
                items.Add(new HistoryItem(date, Str(h, "dateText"), "Sistem",
                    string.IsNullOrEmpty(detail) ? label : $"{label} ({detail})", null));
            }
        }
        catch { }
        _history = items.OrderByDescending(x => x.Date).ToList();
    }

