    private async Task Save()
    {
        _err = true; _msg = null;
        if (!await Dialog.RequireBranchAsync(Auth, "Araçlar")) return;   // "Tüm Şubeler" modunda işlem yok
        if (string.IsNullOrWhiteSpace(_code)) { _msg = "İç kod zorunlu."; _ok = false; return; }
        // Zorunlu: şantiye/şube (madde 8).
        if (string.IsNullOrWhiteSpace(_branch)) { _msg = "Şantiye / şube seçimi zorunludur."; _ok = false; return; }
        // Yumuşak uyarı: plaka Türk biçimine uymuyorsa (iş makinesi/plakasız için kullanıcı yine de geçebilir — madde 2).
        if (!DepoWise.Web.Services.FieldChecks.PlateLooksTurkish(_plate)
            && !await Dialog.Confirm("Plaka standart Türk plaka biçimine (34 ABC 123) uymuyor. İş makinesi/plakasız araç ise geçebilirsiniz.\n\nYine de kaydedilsin mi?", "Evet, Kaydet")) return;
        // Yumuşak uyarı: sayaç çok büyük (yanlış giriş olabilir — madde 7).
        if (DepoWise.Web.Services.FieldChecks.IsSuspiciouslyLarge(_meter)
            && !await Dialog.Confirm($"Sayaç değeri çok büyük görünüyor ({_meter:0.##}). Emin misiniz?", "Evet, Doğru")) return;
        // Şablon dışı kayıt uyarısı (yalnız yeni kayıt + şablon seçilmemişse) — tek tip kayıt için.
        if (_editId is null && string.IsNullOrEmpty(_template))
        {
            if (!await Dialog.Confirm("Ana Yetkiliye Bilgi verilmelidir! Şablon dışı kayıt girmektesiniz!\n\nYine de devam edilsin mi?", "Evet, Devam Et", danger: true)) return;
        }
        else if (!await Dialog.Confirm(_editId is null ? "Araç kaydedilsin mi?" : "Araç güncellensin mi?")) return;
        _busy = true;
        try
        {
            var body = new
            {
                internalCode = _code.Trim(), plate = Empty(_plate), productionYear = _year, currentMeter = _meter, meterUnit = _meterUnit,
                branchId = _branch, driverPersonnelId = _driver, chassisNo = Empty(_chassis), engineNo = Empty(_engine),
                status = _status, statusNote = DepoWise.Web.Services.VehicleStatus.NeedsNote(_status) ? Empty(_statusNote) : null,
                vehicleTypeId = _type, categoryId = _cat, brandId = _brand, vehicleModelId = _model,
                templateId = _template,   // create'te bağlar; düzenlemede mevcut bağı korur/değiştirir
                // DÜZENLEME KİLİDİ: kayıt biz açtıktan sonra değiştiyse sunucu 409 döner, üzerine yazılmaz.
                version = _editId is not null && _editVersion > 0 ? (long?)_editVersion : null
            };
            string? err; string? savedId;
            if (_editId is null) (err, savedId) = await Api.CreateAsync("/api/vehicles", body);
            else { err = await Api.PutAsync($"/api/vehicles/{_editId}", body); savedId = _editId; }
            if (err is null && savedId is not null && _staged.Count > 0)
                await Api.UploadFilesAsync($"/api/vehicles/{savedId}/photos", _staged.Select(p => (p.Name, p.Bytes, p.Mime)));
            _ok = err is null; _msg = err ?? (_editId is null ? "Araç eklendi." : "Araç güncellendi.");
            if (_ok) { Clear(); Nav.NavigateTo("/vehicles"); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private void Clear()
    {
        _err = false; _editId = null; _editVersion = 0; _template = null; _lastTemplate = null;
        _code = _plate = ""; _status = "active"; _meterUnit = "km"; _statusNote = _chassis = _engine = "";
        _type = _cat = _brand = _model = _branch = _driver = null; _year = null; _meter = 0;
        _staged.Clear();
        _history = null;
    }

