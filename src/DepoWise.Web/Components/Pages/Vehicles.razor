@page "/vehicles"
@page "/vehicles/{Section}"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">@(_isNew ? "Araç — Yeni Kayıt" : "Araç Listesi")</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
    @* E1.2/ZB-1: birincil eylem sağda. forceLoad ZORUNLU — /vehicles ile /vehicles/new AYNI bileşendir. *@
    @if (!_isNew && Auth.CanCreate("vehicles"))
    {
        <div class="dw-pagehead-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Nav.NavigateTo("/vehicles/new", forceLoad: true))">
                Yeni Araç
            </MudButton>
        </div>
    }
</div>

@* "Tüm Şubeler" modunda bu ekranda İŞLEM yapılamaz (kayıt hangi şubeye yazılacağı belli değil) — okuma serbest. *@
@if (Auth.IsAllBranches())
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">@DepoWise.Web.Services.BranchGuard.Banner</MudAlert>
}

@if (_isNew && Auth.CanCreate("vehicles"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:760px;">
        <MudText Typo="Typo.h6" Class="mb-2">@(_editId is null ? "YENİ ARAÇ" : "ARAÇ DÜZENLE")</MudText>

        @if (_templates.Count > 0)
        {
            @* Yeni kayıt: seçince alanlar dolar. Düzenleme: şablona BAĞLA/DEĞİŞTİR (alanları ezmez) —
               "şablon-dışı" bir aracı sonradan şablona bağlayıp raporda "şablonlu"ya taşımak için. *@
            <MudSelect T="string" @bind-Value="_template"
                       Label="@(_editId is null ? "Şablon (Araç Genel Tanım)" : "Şablon (bağla / değiştir)")"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                       HelperText="@(_editId is null ? "Seçince Tip/Kategori/Marka/Model/Yıl ve iç kod otomatik dolar." : "Bu aracı bir şablona bağlar (alanları değiştirmez). Boş bırakırsanız şablon-dışı olur.")" >
                @foreach (var t in _templates) { <MudSelectItem T="string" Value="@t.Id">@t.Name</MudSelectItem> }
            </MudSelect>
        }

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Tanım</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="6" md="4"><MudTextField @bind-Value="_code" Label="İç Kod *" Disabled="@(_editId is not null)" Error="_err && string.IsNullOrWhiteSpace(_code)" ErrorText="İç kod zorunlu." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="6" md="4"><MudTextField @bind-Value="_plate" Label="Plaka" Placeholder="34 ABC 123" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="6" md="4"><MudNumericField T="int?" @bind-Value="_year" Label="Üretim Yılı" Min="@DepoWise.Web.Services.FieldChecks.MinVehicleYear" Max="@DepoWise.Web.Services.FieldChecks.MaxVehicleYear" Format="0" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Durum &amp; Sayaç</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="6" md="4">
                @* Durum listesi ORTAK kaynaktan (VehicleStatus) — yeni durum eklenince burası kendiliğinden doğrudur. *@
                <MudSelect T="string" @bind-Value="_status" Label="Durum" Margin="Margin.Dense" Variant="Variant.Outlined">
                    @* Değişken adı "code" OLAMAZ: Razor onu @@code direktifi sanar. *@
                    @foreach (var st in DepoWise.Web.Services.VehicleStatus.All)
                    {
                        <MudSelectItem T="string" Value="@st.Code">@st.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @* V-1 (PRT-01 Grup 5, 2026-08-11): DÜZENLEMEDE sayaç SALT-OKUNUR.
               Sunucuda güncelleme yolu (UpdateVehicle / PUT) sayaca BİLEREK dokunmaz — sayaç yalnız
               ayrı SetMeter mekanizmasından değişir (geriye alma koruması: MeterBackwardException).
               Alan düzenlenebilir kaldığında kullanıcı değeri değiştirip "Araç güncellendi." mesajı
               alıyor ama sayaç DEĞİŞMİYORDU (sessiz yok sayma + yanlış başarı mesajı).
               VehicleEditDialog sayacı zaten salt-okunur gösteriyor; tam form ona hizalandı.
               YENİ KAYITTA düzenlenebilir kalır — orada Create sayacı gerçekten yazar. *@
            <MudItem xs="6" md="4">
                <MudNumericField T="decimal" @bind-Value="_meter" Label="Sayaç" Min="0" Format="0.##"
                                 Margin="Margin.Dense" Variant="Variant.Outlined"
                                 ReadOnly="@(_editId is not null)" Disabled="@(_editId is not null)"
                                 HelperText="@(_editId is null ? null : "Sayaç bu formdan değiştirilemez; yakıt/bakım kayıtlarıyla veya masaüstü araç formundan güncellenir.")" />
            </MudItem>
            <MudItem xs="6" md="4">
                <MudSelect T="string" @bind-Value="_meterUnit" Label="Birim" Margin="Margin.Dense" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("km")">km</MudSelectItem>
                    <MudSelectItem T="string" Value="@("hour")">hour</MudSelectItem>
                </MudSelect>
            </MudItem>
            @* Durum açıklaması Bakımda VE Arızalı durumunda anlamlıdır (ortak kural: VehicleStatus.NeedsNote). *@
            @if (DepoWise.Web.Services.VehicleStatus.NeedsNote(_status))
            {
                <MudItem xs="12"><MudTextField @bind-Value="_statusNote" Label="Durum Açıklaması" HelperText="Yalnız 'Bakımda' / 'Arızalı' durumunda saklanır." Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            }
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Sınıflandırma</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><LookupSelect Label="Makine Tipi" @bind-Value="_type" Items="_types" AddTable="vehicle_types" OnAdded="ReloadTypes" /></MudItem>
            <MudItem xs="12" md="6"><LookupSelect Label="Kategori" @bind-Value="_cat" Items="_cats" AddTable="vehicle_categories" OnAdded="ReloadCats" /></MudItem>
            <MudItem xs="12" md="6"><LookupSelect Label="Marka" @bind-Value="_brand" Items="_brands" AddTable="vehicle_brands" OnAdded="ReloadBrands" /></MudItem>
            <MudItem xs="12" md="6"><LookupSelect Label="Model" @bind-Value="_model" Items="_models" CreatePath="/api/vehicles/models" CreateField="name" ExtraField="brandId" ExtraValue="@_brand" OnAdded="ReloadModels" Disabled="@(string.IsNullOrEmpty(_brand))" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Konum &amp; Atama</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><LookupSelect Label="Şantiye / Şube *" @bind-Value="_branch" Items="_branches" OnAdded="ReloadBranches" /></MudItem>
            <MudItem xs="12" md="6"><LookupSelect Label="Sürücü" @bind-Value="_driver" Items="_drivers" SearchPath="/api/personnel" NameField="fullName" CreatePath="/api/personnel" CreateField="fullName" OnAdded="ReloadDrivers" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Teknik</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_chassis" Label="Şasi No" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_engine" Label="Motor No" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Fotoğraflar</MudText>
        <InputFile OnChange="OnFiles" multiple accept=".jpg,.jpeg,.png" />
        @if (_uploadWarning is not null) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_uploadWarning</MudAlert> }
        @if (_staged.Count > 0)
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-2">
                @foreach (var p in _staged)
                {
                    <div style="position:relative;width:84px;height:84px;margin:0 8px 8px 0;">
                        <MudImage Src="@p.Preview" Width="84" Height="84" ObjectFit="ObjectFit.Cover" Style="border-radius:8px;" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Style="position:absolute;top:0;right:0;" OnClick="@(() => _staged.Remove(p))" />
                    </div>
                }
            </MudStack>
        }

        @* İşlem Geçmişi (madde 4/5, kullanıcı isteği 2026-08-06) — salt-okunur; tıklayınca detay + (varsa) "Kaydı Görüntüle". *@
        @if (_editId is not null && _history is not null)
        {
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">İşlem Geçmişi</MudText>
            @if (_history.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Bu araç için hareket kaydı yok.</MudText>
            }
            else
            {
                <div style="border:1px solid var(--mud-palette-lines-default);border-radius:12px;overflow:hidden;max-height:280px;overflow-y:auto;">
                    @foreach (var h in _history)
                    {
                        <div class="d-flex align-center" style="gap:10px;padding:8px 12px;border-bottom:1px solid var(--mud-palette-lines-default);cursor:pointer;"
                             @onclick="@(() => OpenHistoryDetail(h))">
                            <span class="mud-text-secondary" style="width:82px;font-size:.8rem;flex:0 0 auto;">@h.DateText</span>
                            <span style="font-weight:600;width:70px;flex:0 0 auto;font-size:.8rem;">@h.Kind</span>
                            <span style="font-size:.86rem;flex-grow:1;min-width:0;">@h.Description</span>
                        </div>
                    }
                </div>
            }
        }

        <MudStack Row="true" Class="mt-3" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="Clear">İptal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_busy">
                @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                @(_busy ? "Kaydediliyor…" : "Kaydet")
            </MudButton>
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

@if (!_isNew)
{
    @* E1.2/ZB-3: özet şeridi. Üç sayı da GERÇEK kapsamı yansıtır: toplam araç sunucudan gelen
       toplam kayıt sayısıdır, uyarı sayıları /api/vehicles/alerts firma kapsamının tamamını döndüğü
       için sayfa-bağımsızdır. Bu yüzden "bu sayfada" ibaresine gerek yok — yanıltma yok. *@
    @if (_rows is not null)
    {
        <div class="dw-summary">
            <div class="dw-summary-box">
                <span class="dw-summary-num">@_totalCount.ToString("N0")</span>
                <span class="dw-summary-cap">toplam<br />araç</span>
            </div>
            <div class="dw-summary-box">
                <span class="dw-summary-num">@UyariSayisi("Bakım")</span>
                <span class="dw-summary-cap">bakım<br />uyarısı</span>
            </div>
            <div class="dw-summary-box">
                <span class="dw-summary-num">@UyariSayisi("Muayene")</span>
                <span class="dw-summary-cap">muayene<br />uyarısı</span>
            </div>
        </div>
    }
<MudGrid Spacing="2">
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <div @oncontextmenu="OpenColumnPicker" @oncontextmenu:preventDefault="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6">Araç Listesi</MudText>
                    <MudTooltip Text="Hangi sütunların görüneceğini seçin — bu alanda sağ tık da açar. Yalnız sizin için geçerlidir.">
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.Tune"
                                   OnClick="OpenColumnPicker">Kolonlar</MudButton>
                    </MudTooltip>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Sayfa boyutu</MudText>
                    <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true" Style="max-width:90px">
                        @foreach (var sz in PageSizes) { <MudSelectItem T="int" Value="@sz">@sz</MudSelectItem> }
                    </MudSelect>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="ApplyFilters">Filtrele</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearFilters">Temizle</MudButton>
                    <MudTooltip Text="Aktif filtrelerle eşleşen TÜM araçları (yalnız bu sayfayı değil) Excel dosyası olarak indirir">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@_exporting" OnClick="ExportExcel">Excel'e Aktar</MudButton>
                    </MudTooltip>
                </MudStack>
            </div>

            @if (_rows is null)
            {
                <div style="overflow-x:auto;">
                <table class="dw-grid">
                    @* Yukleme iskeleti de ayni kolon genisliklerini kullanir (aksi halde tablo daralir). *@
                    <colgroup>
                        @foreach (var key in _visibleColumns)
                        {
                            <col style="width:140px" />
                        }
                        <col style="width:130px" />
                    </colgroup>
                    <thead><tr>
                        @foreach (var key in _visibleColumns)
                        {
                            <th style="@ThStyle(key)"><div class="dw-th" style="cursor:default;"><span>@Label(key).ToUpperInvariant()</span></div></th>
                        }
                        <th style="width:130px;"><div class="dw-th" style="cursor:default;"><span>BAKIM/MUAYENE</span></div></th>
                    </tr></thead>
                    <tbody class="dw-skeleton">
                        @for (var i = 0; i < 8; i++)
                        {
                            <tr>
                                @foreach (var key in _visibleColumns) { <td></td> }
                                <td></td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Filtre kriterine uygun araç bulunamadı.</MudText> }
            else
            {
                <div style="overflow-x:auto;">
                <table id="vehicles-grid" class="dw-grid">
                    @* Sütun genişliği <col>'dan gelir (düzeltme 2026-08-26). Hücreye "width" yazmak İŞE YARAMIYORDU:
                       hücrelerde metni "…" ile kesmek için gereken max-width:0, o genişliği sıfıra kırpıyordu. *@
                    <colgroup>
                        @foreach (var key in _visibleColumns)
                        {
                            <col data-key="@key" style="width:140px" />
                        }
                                        <col style="width:130px" />   @* BAKIM/MUAYENE kolonu — basliktaki ek sutunun karsiligi *@
                    </colgroup>
                    <thead><tr>
                        @foreach (var key in _visibleColumns)
                        {
                            @* ⠿ tutamağı sürükle = kolonu taşı; başlık metnine tıkla = sırala; sağ kenar = genişlik. *@
                            <th data-key="@key" style="@ThStyle(key)" class="@(IsNumeric(key) ? "dw-num" : null)"
                                @ondragover:preventDefault="true" @ondrop="@(() => OnDropColumn(key))">
                                <div class="dw-th">
                                    <span title="Sürükleyerek kolonu taşı" draggable="true"
                                          @ondragstart="@(() => _dragKey = key)"
                                          style="cursor:grab;opacity:.45;margin-right:4px;user-select:none;">⠿</span>
                                    <span style="cursor:pointer;flex:1 1 auto;" @onclick="@(() => ToggleSort(key))">@Label(key).ToUpperInvariant()</span>
                                    <span class="dw-sort">@SortArrow(key)</span>
                                </div>
                                <span class="dw-col-grip"></span>@* sağ kenardan sürükle = genişlet/daralt (oturum-içi) *@
                            </th>
                        }
                        <th style="width:130px;"><div class="dw-th" style="cursor:default;"><span>BAKIM/MUAYENE</span></div></th>
                    </tr>
                    <!-- Başlık-altı filtre satırı (kullanıcı isteği 2026-08-06, madde 4) — bkz. Materials.razor aynı yorum. -->
                    <tr>
                        @foreach (var key in _visibleColumns)
                        {
                            <th style="@ThStyle(key)" class="@(IsNumeric(key) ? "dw-filter-th dw-num" : "dw-filter-th")">
                                <MudTooltip Text="@(IsNumeric(key) ? "Tam sayı: 5 · Karşılaştırma: >5  <5  >=5  <=5 · Aralık: 5-10" : "İçerir araması")">
                                    <MudTextField T="string" Value="@GetFilter(key)" ValueChanged="@((string v) => SetFilter(key, v))"
                                                  Placeholder="@(IsNumeric(key) ? "5, >5, 5-10…" : "içerir…")"
                                                  Immediate="false" OnKeyUp="OnFilterKey"
                                                  Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" />
                                </MudTooltip>
                            </th>
                        }
                        <th style="width:130px;" class="dw-filter-th"></th>
                    </tr>
                    </thead>
                    <tbody>
                        @* Tek tık = sağdaki detay paneli (mevcut davranış korunur). Çift tık = ayrı düzenle/kaydet/sil penceresi. *@
                        @foreach (var row in _rows)
                        {
                            @* Çift tık = ayrı Düzelt/Kaydet/Sil penceresi (yan detay paneli kaldırıldı — tablo tam genişlik). *@
                            <tr @ondblclick="@(() => OpenQuickEdit(Str(row, "id")))" style="cursor:pointer;">
                                @foreach (var key in _visibleColumns)
                                {
                                    <td title="@CellText(row, key)" class="@(IsNumeric(key) ? "dw-num" : null)">
                                        @if (key == "status")
                                        {
                                            <span class="dw-badge @StatusBadgeClass(Str(row, "status"))"><span>@Dash(CellText(row, key))</span></span>
                                        }
                                        else
                                        {
                                            @Dash(CellText(row, key))
                                        }
                                    </td>
                                }
                                @* E1.2/ZB-8: uyarı metni rozete döner. Uç yalnız "uyarı var mı" bilgisini
                                   verir (Bakım / Muayene); GECİKEN ile YAKLAŞAN ayrımı veride YOKTUR →
                                   böyle bir ayrım UYDURULMADI, tek seviye "uyarı" rozeti kullanılır. *@
                                <td>
                                    @{ var uyari = Alert(Str(row, "id")); }
                                    @if (uyari == "—") { <span class="mud-text-secondary">—</span> }
                                    else { <span class="dw-badge dw-badge-warn"><span>@uyari</span></span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>

                @* Sayfa numaraları + kayıt bilgisi araç ekranında TABLONUN ALTINDA, SOLDA (kullanıcı isteği 2026-07-19). *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap" Justify="Justify.FlexStart">
                    <MudPagination Count="@_totalPages" Selected="@_page" SelectedChanged="OnPageChanged"
                                   BoundaryCount="1" MiddleCount="3" ShowFirstButton="true" ShowLastButton="true" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@_totalCount kayıt — sayfa @_page / @_totalPages</MudText>
                </MudStack>
            }
        </MudPaper>
    </MudItem>

</MudGrid>
}

@code {
    [Parameter] public string? Section { get; set; }
    private bool _isNew => string.Equals(Section, "new", StringComparison.OrdinalIgnoreCase);
    /// <summary>
    /// ARC-01 (PRT-01 Grup 5): araç TAM düzenleme formuna geçiş. Hızlı düzenleme penceresindeki
    /// "Tam Düzenleme" düğmesinden çağrılır — eskiden bu metodun HİÇBİR çağıranı yoktu, dolayısıyla
    /// şablon bağlama, birim, fotoğraflar ve araç geçmişi web'den erişilemiyordu (masaüstünde çalışıyordu).
    ///
    /// Ekstra onay YOK: kullanıcı zaten açıkça "Tam Düzenleme" dedi (G2-01'de alınan karar).
    ///
    /// ⚠️ <c>forceLoad: true</c> ZORUNLU: <c>/vehicles</c> ile <c>/vehicles/new</c> AYNI bileşene
    /// yönlendiği için Blazor bileşeni yeniden oluşturmaz — <c>OnInitializedAsync</c> çalışmaz ve
    /// <c>?edit=</c> okunmadan boş form açılırdı (malzemede birebir aynı tuzağa düşülmüştü).
    /// </summary>
    private Task EditNav(string id)
    {
        Nav.NavigateTo($"/vehicles/new?edit={id}", forceLoad: true);
        return Task.CompletedTask;
    }

    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };

    private string? _editId;
    private long _editVersion; // DÜZENLEME KİLİDİ: düzenlemeye başlarken okunan sürüm
    private string _code = "", _plate = "", _status = "active", _meterUnit = "km", _statusNote = "", _chassis = "", _engine = "";
    private string? _type, _cat, _brand, _model, _branch, _driver, _template;
    private int? _year;
    private decimal _meter;
    private readonly List<Staged> _staged = new();
    private readonly List<PhotoRef> _detailPhotos = new();
    private string? _uploadWarning;
    // Sunucu yalnız JPEG/PNG kabul eder (magic-byte doğrulaması) — bkz. Materials.razor aynı not.
    private static readonly HashSet<string> AllowedPhotoExt = new(StringComparer.OrdinalIgnoreCase) { ".jpg", ".jpeg", ".png" };
    private const string SupportedPhotoFormatsText = "JPEG (.jpg, .jpeg), PNG (.png)";
    private sealed record Staged(string Name, byte[] Bytes, string Mime, string Preview);
    private sealed record PhotoRef(string Id, string Url);

    private List<ApiClient.Opt> _types = new(), _cats = new(), _brands = new(), _models = new(), _branches = new(), _drivers = new();
