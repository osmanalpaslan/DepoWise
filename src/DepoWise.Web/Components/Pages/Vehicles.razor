    private string? _lastTemplate;
    private async Task ApplyTemplate()
    {
        var t = _templates.FirstOrDefault(x => x.Id == _template);
        if (t is null) return;
        if (_editId is not null) return;   // DÜZENLEME: yalnız BAĞLA — mevcut alanları EZME (yeni kayıtta önden doldurur)
        _type = t.VehicleTypeId; _cat = t.CategoryId; _year = t.ProductionYear;
        _brand = t.BrandId; _lastBrand = t.BrandId;
        _models = string.IsNullOrEmpty(_brand) ? new() : await Api.OptionsAsync($"/api/vehicles/models/{_brand}", "id", "name");
        _model = t.VehicleModelId;
        if (string.IsNullOrWhiteSpace(_code) && !string.IsNullOrWhiteSpace(t.InternalCode))
        {
            try { var o = await Api.GetObjectAsync($"/api/vehicles/next-code?baseCode={Uri.EscapeDataString(t.InternalCode)}"); _code = o.TryGetProperty("code", out var cc) ? cc.GetString() ?? "" : ""; }
            catch { }
        }
        StateHasChanged();
    }

    private async Task Load()
    {
        _rows = null;
        var qs = new List<string> { $"page={_page}", $"pageSize={_pageSize}" };
        qs.AddRange(BuildFilterSortQs());
        var grid = await Api.GetGridAsync("/api/vehicles/grid?" + string.Join("&", qs));
        _rows = grid.Items; _totalCount = grid.TotalCount; _page = grid.Page; _pageSize = grid.PageSize; _totalPages = grid.TotalPages;
        try
        {
            _alerts.Clear();
            foreach (var a in await Api.GetArrayAsync("/api/vehicles/alerts")) _alerts[Str(a, "vehicleId")] = Str(a, "text");
        }
        catch { }
    }

    /// <summary>Sıralama + kolon filtreleri — sayfalamasız (Load VE ExportExcel PAYLAŞIR).</summary>
    private List<string> BuildFilterSortQs()
    {
        var qs = new List<string>();
        if (_sortColumn is not null) { qs.Add($"sort={_sortColumn}"); qs.Add($"desc={(_sortDesc ? "true" : "false")}"); }
        foreach (var (k, v) in _filters)
            if (!string.IsNullOrWhiteSpace(v)) qs.Add($"{k}={Uri.EscapeDataString(v.Trim())}");
        return qs;
    }

