@page "/audit"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService DialogService

@if (!Auth.CanView("audit"))
{
    <MudAlert Severity="Severity.Error">Bu ekran için yetkiniz yok (Sistem Logu / Audit).</MudAlert>
}
else
{
<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Sistem Logu</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

<MudPaper Class="pa-4" Elevation="2">
    @* Tarih Aralığı + kayıt sayısı (madde 4, kullanıcı isteği 2026-08-06): sunucu tarafında filtrelenir —
       performans için kayıt sayısı seçilen değerle sınırlanır (varsayılan 300, en fazla 5000). *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap" Spacing="2">
        <MudText Typo="Typo.h6">Log Kayıtları</MudText><MudSpacer />
        <MudDatePicker @bind-Date="_from" Label="Başlangıç" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:170px" Clearable="true" />
        <MudDatePicker @bind-Date="_to" Label="Bitiş" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:170px" Clearable="true" />
        <MudSelect T="int" @bind-Value="_limit" Label="Kayıt Sayısı" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:140px" Dense="true">
            @foreach (var n in _limitOptions) { <MudSelectItem T="int" Value="@n">@n</MudSelectItem> }
        </MudSelect>
        <MudSelect T="string" @bind-Value="_entity" Label="Kayıt (ekran)" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Style="max-width:200px" Dense="true">
            @foreach (var e in _entities) { <MudSelectItem T="string" Value="@e">@e</MudSelectItem> }
        </MudSelect>
        <MudSelect T="string" @bind-Value="_user" Label="Kullanıcı" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Style="max-width:200px" Dense="true">
            @foreach (var u in _users) { <MudSelectItem T="string" Value="@u">@u</MudSelectItem> }
        </MudSelect>
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="Load">Filtrele</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ClearFilters">Temizle</MudButton>
    </MudStack>
    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else
    {
        var filtered = Filtered();
        @if (filtered.Count == 0) { <MudText Class="mud-text-secondary">Henüz sistem log kaydı yok.</MudText> }
        else
        {
            @* ⭐ FAZ 4.3 (kullanıcı isteği 2026-09-06) — GÜNLERE AYRILMIŞ + NE DEĞİŞTİĞİ YAZAN LOG.
               Eskiden yalnız "kim / ne zaman / hangi tip / hangi işlem" vardı; hangi alanın neye
               döndüğü hiç görünmüyordu. "Geçmiş" düğmesi o kaydın KENDİ log ekranını açar. *@
            <MudTable Items="filtered" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="62vh" T="JsonElement"
                      GroupBy="_gunGrubu" GroupHeaderStyle="background-color:var(--mud-palette-background-grey)">
                <HeaderContent>
                    <MudTh>SAAT</MudTh><MudTh>KULLANICI</MudTh><MudTh>KAYIT</MudTh><MudTh>İŞLEM</MudTh>
                    <MudTh>NE DEĞİŞTİ</MudTh><MudTh></MudTh>
                </HeaderContent>
                <GroupHeaderTemplate>
                    <MudTh Class="mud-table-cell-custom-group" colspan="6"><b>@GunBasligi(context.Key?.ToString() ?? "")</b>
                        <span class="mud-text-secondary" style="margin-left:10px">@context.Items.Count() işlem</span></MudTh>
                </GroupHeaderTemplate>
                <RowTemplate>
                    <MudTd>@Str(context, "timeText")</MudTd>
                    <MudTd>@Str(context, "userText")</MudTd>
                    <MudTd>@Str(context, "entityLabel")</MudTd>
                    <MudTd>@Str(context, "actionText")</MudTd>
                    <MudTd>
                        @if (Str(context, "changeSummary") is { Length: > 0 } ozet) { @ozet }
                        else { <span class="mud-text-secondary">—</span> }
                    </MudTd>
                    <MudTd>
                        @if (Str(context, "entityId").Length > 0)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       OnClick="@(() => KayitGecmisi(context))">Geçmiş</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@filtered.Count / @_rows.Length kayıt</MudText>
        }
    }
</MudPaper>
}

@code {
    private JsonElement[]? _rows;
    private string? _entity, _user;
    private List<string> _entities = new(), _users = new();
    // Tarih Aralığı + kayıt sayısı (madde 4, kullanıcı isteği 2026-08-06) — StockMovements.razor ile AYNI desen.
    private DateTime? _from, _to;
    private readonly int[] _limitOptions = { 100, 300, 500, 1000, 2000, 5000 };
    private int _limit = 300;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _rows = null;
        try
        {
            var qs = new List<string> { $"limit={_limit}" };
            if (_from is { } f) qs.Add($"from={DepoWise.Web.Services.FieldChecks.ToUnixMs(f)}");
            if (_to is { } t) qs.Add($"to={DepoWise.Web.Services.FieldChecks.ToUnixMs(t, endOfDay: true)}");
            _rows = await Api.GetArrayAsync("/api/audit?" + string.Join("&", qs));
        }
        catch { _rows = Array.Empty<JsonElement>(); }
        _entities = _rows.Select(r => Str(r, "entityType")).Where(x => x != "").Distinct().OrderBy(x => x).ToList();
        _users = _rows.Select(r => Str(r, "userText")).Where(x => x != "" && x != "—").Distinct().OrderBy(x => x).ToList();
    }

    private async Task ClearFilters() { _from = _to = null; _limit = 300; _entity = _user = null; await Load(); }

    private List<JsonElement> Filtered()
    {
        IEnumerable<JsonElement> q = _rows ?? Array.Empty<JsonElement>();
        if (!string.IsNullOrEmpty(_entity)) q = q.Where(r => Str(r, "entityType") == _entity);
        if (!string.IsNullOrEmpty(_user)) q = q.Where(r => Str(r, "userText") == _user);
        return q.ToList();
    }

    // ⭐ FAZ 4.3 — gün gruplaması ("bugün bunu, ertesi gün şunu yapmış").
    private readonly TableGroupDefinition<JsonElement> _gunGrubu = new()
    {
        Indentation = false, Expandable = false,
        Selector = r => Str(r, "dayText"),
    };

    private static string GunBasligi(string gun)
    {
        if (!DateTime.TryParseExact(gun, "dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var t)) return gun;
        if (t.Date == DateTime.Today) return "Bugün · " + gun;
        if (t.Date == DateTime.Today.AddDays(-1)) return "Dün · " + gun;
        return t.DayOfWeek switch
        {
            DayOfWeek.Monday => "Pazartesi", DayOfWeek.Tuesday => "Salı", DayOfWeek.Wednesday => "Çarşamba",
            DayOfWeek.Thursday => "Perşembe", DayOfWeek.Friday => "Cuma", DayOfWeek.Saturday => "Cumartesi",
            _ => "Pazar",
        } + " · " + gun;
    }

    /// <summary>⭐ FAZ 4.3 — seçilen satırdaki kaydın KENDİ log ekranı.</summary>
    private async Task KayitGecmisi(JsonElement r)
    {
        var parms = new DialogParameters
        {
            ["Title"] = "Kayıt Geçmişi — " + Str(r, "entityLabel"),
            ["EntityType"] = Str(r, "entityType"),
            ["EntityId"] = Str(r, "entityId"),
            ["KayitBaglantisi"] = false,
        };
        await DialogService.ShowAsync<AuditHistoryDialog>("Kayıt Geçmişi", parms,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
}
