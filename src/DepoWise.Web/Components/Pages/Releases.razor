@page "/releases"
@inject ApiClient Api
@inject AuthState Auth
@rendermode InteractiveServer

<PageTitle>Sürümler — DepoWise</PageTitle>

<h3>Güncelleme / Sürümler</h3>
<p class="text-muted">Masaüstü için en güncel yayınlanan sürüm.</p>

@if (!Auth.IsAuthenticated)
{
    <div class="alert alert-warning">Giriş yapmalısınız. <a href="/login">Giriş</a></div>
}
else
{
    <button class="btn btn-outline-secondary btn-sm mb-2" @onclick="Load">Yenile</button>
    @if (_error is not null) { <div class="alert alert-danger">@_error</div> }

    @if (_release is null) { <p class="text-muted">Yayınlanmış sürüm yok.</p> }
    else
    {
        <table class="table table-sm">
            <tbody>
                <tr><th>Sürüm</th><td>@_release.Version</td></tr>
                <tr><th>İmzalı</th><td>@(_release.Signed ? "Evet" : "Hayır")</td></tr>
                <tr><th>Notlar</th><td>@(_release.ReleaseNotes ?? "—")</td></tr>
                <tr><th>İndirme</th><td>@(_release.DownloadUrl ?? "— (paket yüklenmemiş)")</td></tr>
            </tbody>
        </table>
    }
    @if (Auth.IsSuperAdmin)
    {
        <hr />
        <h5>Yeni Sürüm Yayınla</h5>
        <div class="row g-2" style="max-width:640px;">
            <div class="col-4">
                <label class="form-label">Sürüm (X.Y.Z)</label>
                <input class="form-control" @bind="_pubVersion" placeholder="1.0.3" />
            </div>
            <div class="col-8">
                <label class="form-label">Notlar</label>
                <input class="form-control" @bind="_pubNotes" />
            </div>
            <div class="col-12">
                <label class="form-label">Paket dosyası</label>
                <InputFile class="form-control" OnChange="OnFile" />
            </div>
            <div class="col-12">
                <button class="btn btn-success" @onclick="Publish" disabled="@_busy">
                    @(_busy ? "Yayınlanıyor…" : "Yayınla")
                </button>
            </div>
        </div>
        @if (_pubMsg is not null) { <div class="alert @(_pubOk ? "alert-success" : "alert-danger") mt-2">@_pubMsg</div> }
    }
}

@code {
    private ReleaseDto? _release;
    private string? _error;

    private string _pubVersion = "";
    private string _pubNotes = "";
    private IBrowserFile? _file;
    private string? _pubMsg;
    private bool _pubOk;
    private bool _busy;

    protected override async Task OnInitializedAsync() { if (Auth.IsAuthenticated) await Load(); }

    private async Task Load()
    {
        _error = null;
        try { _release = await Api.GetLatestReleaseAsync(); }
        catch (Exception ex) { _error = "Yüklenemedi: " + ex.Message; }
    }

    private void OnFile(InputFileChangeEventArgs e) => _file = e.File;

    private async Task Publish()
    {
        _pubMsg = null;
        if (string.IsNullOrWhiteSpace(_pubVersion)) { _pubMsg = "Sürüm girin."; _pubOk = false; return; }
        if (_file is null) { _pubMsg = "Paket dosyası seçin."; _pubOk = false; return; }
        _busy = true;
        try
        {
            using var ms = new MemoryStream();
            await _file.OpenReadStream(maxAllowedSize: 500L * 1024 * 1024).CopyToAsync(ms);
            var err = await Api.PublishReleaseAsync(_pubVersion.Trim(), _pubNotes, _file.Name, ms.ToArray());
            _pubOk = err is null;
            _pubMsg = err ?? $"Yayınlandı: {_pubVersion.Trim()}";
            if (_pubOk) { _pubVersion = ""; _pubNotes = ""; _file = null; await Load(); }
        }
        catch (Exception ex) { _pubOk = false; _pubMsg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }
}
