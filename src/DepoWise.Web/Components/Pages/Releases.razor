@page "/releases"
@inject ApiClient Api
@inject AuthState Auth

<PageTitle>Sürümler — DepoWise</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Güncelleme Yönetimi</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:640px;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">En Güncel Sürüm</MudText><MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Yenile</MudButton>
    </MudStack>
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    @if (_release is null) { <MudText Class="mud-text-secondary">Yayınlanmış sürüm yok.</MudText> }
    else
    {
        <MudSimpleTable Dense="true" Bordered="false" Striped="true">
            <tbody>
                <tr><td><b>Sürüm</b></td><td>@_release.Version</td></tr>
                <tr><td><b>İmzalı</b></td><td>@(_release.Signed ? "Evet" : "Hayır")</td></tr>
                <tr><td><b>Notlar</b></td><td>@(_release.ReleaseNotes ?? "—")</td></tr>
                <tr><td><b>İndirme</b></td><td>@(_release.DownloadUrl ?? "— (paket yüklenmemiş)")</td></tr>
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@if (Auth.IsSuperAdmin)
{
    <MudPaper Class="pa-4" Elevation="2" Style="max-width:640px;">
        <MudText Typo="Typo.h6" Class="mb-2">Yeni Sürüm Yayınla</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="4"><MudTextField @bind-Value="_pubVersion" Label="Sürüm (X.Y.Z)" Placeholder="1.0.4" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="8"><MudTextField @bind-Value="_pubNotes" Label="Notlar" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><InputFile OnChange="OnFile" /></MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Publish" Disabled="_busy">@(_busy ? "Yayınlanıyor…" : "Yayınla")</MudButton>
            </MudItem>
        </MudGrid>
        @if (_pubMsg is not null) { <MudAlert Severity="@(_pubOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_pubMsg</MudAlert> }
    </MudPaper>
}

@code {
    private ReleaseDto? _release;
    private string? _error;

    private string _pubVersion = "";
    private string _pubNotes = "";
    private IBrowserFile? _file;
    private string? _pubMsg;
    private bool _pubOk;
    private bool _busy;

    protected override async Task OnInitializedAsync() { if (Auth.IsAuthenticated) await Load(); }

    private async Task Load()
    {
        _error = null;
        try { _release = await Api.GetLatestReleaseAsync(); }
        catch (Exception ex) { _error = "Yüklenemedi: " + ex.Message; }
    }

    private void OnFile(InputFileChangeEventArgs e) => _file = e.File;

    private async Task Publish()
    {
        _pubMsg = null;
        if (string.IsNullOrWhiteSpace(_pubVersion)) { _pubMsg = "Sürüm girin."; _pubOk = false; return; }
        if (_file is null) { _pubMsg = "Paket dosyası seçin."; _pubOk = false; return; }
        _busy = true;
        try
        {
            using var ms = new MemoryStream();
            await _file.OpenReadStream(maxAllowedSize: 500L * 1024 * 1024).CopyToAsync(ms);
            var err = await Api.PublishReleaseAsync(_pubVersion.Trim(), _pubNotes, _file.Name, ms.ToArray());
            _pubOk = err is null;
            _pubMsg = err ?? $"Yayınlandı: {_pubVersion.Trim()}";
            if (_pubOk) { _pubVersion = ""; _pubNotes = ""; _file = null; await Load(); }
        }
        catch (Exception ex) { _pubOk = false; _pubMsg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }
}
