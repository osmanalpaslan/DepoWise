    private async Task OnFiles(InputFileChangeEventArgs e)
    {
        _uploadWarning = null;
        var rejected = new List<string>();
        foreach (var f in e.GetMultipleFiles(10))
        {
            if (!AllowedPhotoExt.Contains(Path.GetExtension(f.Name))) { rejected.Add(f.Name); continue; }
            using var ms = new MemoryStream();
            await f.OpenReadStream(8 * 1024 * 1024).CopyToAsync(ms);
            var bytes = ms.ToArray();
            var mime = f.ContentType;
            if (string.IsNullOrEmpty(mime) || mime == "application/octet-stream") mime = GuessMime(f.Name);
            _staged.Add(new Staged(f.Name, bytes, mime, $"data:{mime};base64,{Convert.ToBase64String(bytes)}"));
        }
        if (rejected.Count > 0)
            _uploadWarning = $"Desteklenmeyen biçim, eklenmedi: {string.Join(", ", rejected)}. Desteklenen biçimler: {SupportedPhotoFormatsText}.";
    }

