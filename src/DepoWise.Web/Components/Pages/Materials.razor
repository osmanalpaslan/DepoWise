@page "/materials"
@page "/materials/{Section}"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        @* G2-01: düzenlemede "Yeni Kayıt" yazıyordu (yalnız _isNew'e bakıyordu) — kart içi başlık doğru
           olduğu hâlde sayfa başlığı yanlıştı. Artık yeni kayıt / düzenleme ayrımı başlığa da yansıyor. *@
        <MudText Typo="Typo.h5">@(_isNew ? (_isEditRoute ? "Malzeme — Düzenle" : "Malzeme — Yeni Kayıt") : "Malzeme Listesi")</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

@* "Tüm Şubeler" modunda bu ekranda İŞLEM yapılamaz (kayıt hangi şubeye yazılacağı belli değil) — okuma serbest. *@
@if (Auth.IsAllBranches())
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">@DepoWise.Web.Services.BranchGuard.Banner</MudAlert>
}

@if (_isNew && CanUseForm)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:760px;">
        <MudText Typo="Typo.h6" Class="mb-2">@(_editId is null ? "YENİ MALZEME" : "MALZEME DÜZENLE")</MudText>

        @* Malzeme şablonu kaldırıldı (kullanıcı isteği 2026-08-05): malzemelerde şablon kullanılmıyor. *@

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-1 mb-1">Tanım</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="6" md="3"><MudTextField @bind-Value="_code" Label="Kod *" Error="_err && string.IsNullOrWhiteSpace(_code)" ErrorText="Kod zorunlu." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_name" Label="Ad *" Error="_err && string.IsNullOrWhiteSpace(_name)" ErrorText="Ad zorunlu." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="_type" Label="Tür" Margin="Margin.Dense" Variant="Variant.Outlined">
                    @foreach (var t in _types) { <MudSelectItem T="string" Value="@t">@t</MudSelectItem> }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Sınıflandırma</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><LookupSelect Label="Kategori" @bind-Value="_cat" Items="_cats" AddTable="material_categories" OnAdded="ReloadCats" /></MudItem>
            <MudItem xs="12" md="6">
                @* Alt Kategori: seçili KATEGORİYE bağlı; "+" ile o kategoriye alt kategori eklenir (parent_id=_cat).
                   Kategori seçilene kadar pasif; seçilince o kategorinin alt kategorileri listelenir. *@
                <LookupSelect Label="Alt Kategori" @bind-Value="_subCat" Items="_subCats"
                              CreatePath="/api/materials/subcategories" CreateField="name"
                              ExtraField="parentId" ExtraValue="@_cat"
                              Disabled="@string.IsNullOrEmpty(_cat)" OnAdded="ReloadSubCats" />
                @if (string.IsNullOrEmpty(_cat)) { <MudText Typo="Typo.caption" Class="mud-text-secondary">Önce kategori seçin.</MudText> }
            </MudItem>
            <MudItem xs="12" md="6">
                <LookupSelect Label="Birim *" @bind-Value="_unit" Items="_units" AddTable="units" OnAdded="ReloadUnits" />
                @if (_err && string.IsNullOrEmpty(_unit)) { <MudText Typo="Typo.caption" Color="Color.Error">Birim seçin.</MudText> }
            </MudItem>
            <MudItem xs="12" md="6"><LookupSelect Label="Marka" @bind-Value="_brand" Items="_brands" AddTable="brands" OnAdded="ReloadBrands" /></MudItem>
            <MudItem xs="12" md="6"><LookupSelect Label="Tedarikçi" @bind-Value="_sup" Items="_sups" AddTable="suppliers" OnAdded="ReloadSups" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">İlişkiler</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                @* İş A: sunucu-taraflı aramalı çoklu seçim — /api/vehicles sayfalıdır (en fazla 200),
                   filo büyüdüğünde aramasız liste geri kalanı gösteremezdi. *@
                <SearchableMultiSelect Label="Uyumlu Araçlar" ItemNoun="araç"
                                       HelperText="Bu malzemenin takıldığı araçlar (çoklu seçim)."
                                       SearchLabel="Araç ara (iç kod / plaka)"
                                       SearchPath="/api/vehicles" NameField="display"
                                       SelectedValues="_vehicleSel" SelectedValuesChanged="@(v => _vehicleSel = v)" />
            </MudItem>
            <MudItem xs="12">
                <MudAutocomplete T="ApiClient.Opt" Label="Muadil Malzeme" SearchFunc="SearchMaterial" @bind-Value="_eqPick"
                                 ToStringFunc="@(o => o?.Name ?? "")" Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true"
                                 HelperText="Mevcut malzemelerden ara/ekle (çoklu)." />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Class="mt-1" OnClick="AddEquivalent">Muadil Ekle</MudButton>
                @if (_equivalents.Count > 0)
                {
                    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-1">
                        @foreach (var e in _equivalents)
                        {
                            <MudChip T="string" OnClose="@(() => _equivalents.Remove(e))" Size="Size.Small">@e.Name</MudChip>
                        }
                    </MudStack>
                }
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Fiyat &amp; Stok</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="6" md="4"><MudNumericField T="decimal" @bind-Value="_price" Label="Birim Fiyat (TRY)" Margin="Margin.Dense" Variant="Variant.Outlined" Min="0" Format="0.##" /></MudItem>
            <MudItem xs="6" md="4"><MudNumericField T="decimal" @bind-Value="_min" Label="Min Stok" Margin="Margin.Dense" Variant="Variant.Outlined" Min="0" Format="0.##" /></MudItem>
            @if (_editId is null)
            {
                <MudItem xs="6" md="4"><MudNumericField T="decimal" @bind-Value="_opening" Label="Açılış Stok" HelperText="0 dışında ise stok hareketi (eksi olabilir)." Margin="Margin.Dense" Variant="Variant.Outlined" Format="0.##" /></MudItem>
                @* STK-04: açılış stoğu bir DEPOYA aittir. Eskiden hiç sorulmuyordu → tüm açılışlar
                   "Atanmamış" kovasına düşüyordu (canlıdaki 664 lokasyonsuz açılışın sebebi budur). *@
                @if (_opening != 0)
                {
                    <MudItem xs="6" md="4">
                        @if (Auth.IsAllBranches())
                        {
                            <MudSelect T="string" @bind-Value="_openingLocation" Label="Açılış Deposu *" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                                       HelperText="Bu stok hangi depoda duruyor?">
                                @foreach (var b in _openingBranches) { <MudSelectItem T="string" Value="@b.Id">@b.Name</MudSelectItem> }
                            </MudSelect>
                        }
                        else
                        {
                            <MudTextField Value="@_openingLocationName" Label="Açılış Deposu (Şubeniz)" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" />
                        }
                    </MudItem>
                }
            }
            <MudItem xs="12"><MudTextField @bind-Value="_desc" Label="Açıklama" Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Fotoğraflar</MudText>
        <InputFile OnChange="OnFiles" multiple accept=".jpg,.jpeg,.png" />
        @if (_uploadWarning is not null) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_uploadWarning</MudAlert> }
        @if (_staged.Count > 0)
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-2">
                @foreach (var p in _staged)
                {
                    <div style="position:relative;width:84px;height:84px;margin:0 8px 8px 0;">
                        <MudImage Src="@p.Preview" Width="84" Height="84" ObjectFit="ObjectFit.Cover" Style="border-radius:8px;" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                       Style="position:absolute;top:0;right:0;" OnClick="@(() => _staged.Remove(p))" />
                    </div>
                }
            </MudStack>
        }

        @* STK-04 — LOKASYON KIRILIMI: malzeme kartı FİRMA GENELİdir, stok DEPO BAZLIdır.
           "Toplam" tüm depoların toplamıdır; altındaki satırlar hangi depoda ne kadar olduğunu gösterir.
           Kart açılırken TEK istek atılır (liste satırlarında kırılım çağrılmaz → N+1 yok). *@
        @if (_editId is not null && _locations is { Count: > 0 })
        {
            <MudPaper Class="pa-3 mt-3" Elevation="0" Outlined="true">
                <div class="d-flex align-center justify-space-between flex-wrap" style="gap:8px;">
                    <MudText Typo="Typo.subtitle2">Stok — depo kırılımı</MudText>
                    <MudText Typo="Typo.subtitle2"><b>Toplam: @_stock.ToString("0.##")</b></MudText>
                </div>
                <MudSimpleTable Dense="true" Striped="true" Class="mt-1" Style="overflow-x:auto;">
                    <tbody>
                        @foreach (var l in _locations)
                        {
                            <tr>
                                <td style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@l.Name">
                                    @if (l.Id.Length == 0)
                                    {
                                        <MudTooltip Text="@DepoWise.Web.Services.LocationOptions.UnassignedHelp">
                                            <span class="mud-text-secondary">@l.Name</span>
                                        </MudTooltip>
                                    }
                                    else { @l.Name }
                                </td>
                                <td style="text-align:right;width:120px;font-weight:600;">@l.Quantity.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }

        @* Kritik stok paneli (S3) — stok minimum altında/eşitse uyarı + Talep Oluştur (taslak). *@
        @if (_editId is not null && _min > 0 && _stock <= _min)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true" Icon="@Icons.Material.Filled.Warning">
                <div class="d-flex align-center justify-space-between flex-wrap" style="gap:8px;">
                    <span><b>Kritik seviye altında</b> — Stok: @_stock.ToString("0.##") · Minimum: @_min.ToString("0.##")</span>
                    @if (Auth.CanCreate("requests"))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                   OnClick="CreateRequestForMaterial" Disabled="_reqBusy">Talep Oluştur</MudButton>
                    }
                </div>
            </MudAlert>
        }

        @* İşlem Geçmişi (A3 + madde 4/5, 2026-08-06) — salt-okunur; tıklayınca detay + "Kaydı Görüntüle". *@
        @if (_editId is not null && _movements is not null)
        {
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">İşlem Geçmişi</MudText>
            @if (_movements.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Bu malzeme için hareket kaydı yok.</MudText>
            }
            else
            {
                <div style="border:1px solid var(--mud-palette-lines-default);border-radius:12px;overflow:hidden;max-height:280px;overflow-y:auto;">
                    @foreach (var m in _movements)
                    {
                        var qty = MvQty(m);
                        <div class="d-flex align-center" style="gap:10px;padding:8px 12px;border-bottom:1px solid var(--mud-palette-lines-default);cursor:pointer;"
                             @onclick="@(() => OpenMovementDetail(m))">
                            <span class="mud-text-secondary" style="width:82px;font-size:.8rem;flex:0 0 auto;">@MvDate(m)</span>
                            <div class="flex-grow-1" style="min-width:0;">
                                <div style="font-size:.86rem;">@Str2(m, "label")</div>
                                @if (!string.IsNullOrEmpty(Str2(m, "reference")))
                                {
                                    <div class="mud-text-secondary" style="font-size:.75rem;">@Str2(m, "reference")</div>
                                }
                            </div>
                            <span style="font-weight:600;flex:0 0 auto;color:@(qty < 0 ? "var(--mud-palette-error)" : "var(--mud-palette-success)");">@(qty >= 0 ? "+" : "")@qty.ToString("0.##")</span>
                        </div>
                    }
                </div>
            }
        }

        <MudStack Row="true" Class="mt-3" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
            @if (_editId is not null && DirtyCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.Edit" Class="mr-auto">@DirtyCount kaydedilmemiş değişiklik</MudChip>
            }
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">İptal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_busy">@(_busy ? "…" : "Kaydet")</MudButton>
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

@if (!_isNew)
{
<MudGrid Spacing="2">
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <div @oncontextmenu="OpenColumnPicker" @oncontextmenu:preventDefault="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6">Malzeme Listesi</MudText>
                    <MudTooltip Text="Kolonları ayarla (bu alanda sağ tık da açar) — yalnız sizin için geçerlidir">
                        <MudIconButton Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" OnClick="OpenColumnPicker" />
                    </MudTooltip>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Sayfa boyutu</MudText>
                    <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true" Style="max-width:90px">
                        @foreach (var sz in PageSizes) { <MudSelectItem T="int" Value="@sz">@sz</MudSelectItem> }
                    </MudSelect>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="ApplyFilters">Filtrele</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearFilters">Temizle</MudButton>
                    <MudTooltip Text="Yalnız stok, minimum stoğun altına düşmüş (kritik) malzemeleri gösterir">
                        <MudButton Size="Size.Small" Variant="@(_criticalOnly ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Error" StartIcon="@Icons.Material.Filled.WarningAmber"
                                   OnClick="ToggleCritical">Yalnız kritik</MudButton>
                    </MudTooltip>
                    <MudTooltip Text="Aktif filtrelerle eşleşen TÜM malzemeleri (yalnız bu sayfayı değil) Excel dosyası olarak indirir">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@_exporting" OnClick="ExportExcel">Excel'e Aktar</MudButton>
                    </MudTooltip>
                </MudStack>
            </div>

            @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
            else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Filtre kriterine uygun malzeme bulunamadı.</MudText> }
            else
            {
                @* Excel-benzeri: sabit tablo düzeni + yatay kaydırma (pencere küçülünce taşma/kayma OLMAZ) +
                   başlığı sürükleyerek kolon genişliği (CSS resize). Başlığa tıklama = sırala. *@
                <div style="overflow-x:auto;">
                <table id="materials-grid" class="dw-grid">
                    @* Sütun genişliği <col>'dan gelir (düzeltme 2026-08-26). Hücreye "width" yazmak İŞE YARAMIYORDU:
                       hücrelerde metni "…" ile kesmek için gereken max-width:0, o genişliği sıfıra kırpıyordu. *@
                    <colgroup>
                        @foreach (var key in _visibleColumns)
                        {
                            <col data-key="@key" style="width:140px" />
                        }
                    </colgroup>
                    <thead><tr>
                        @foreach (var key in _visibleColumns)
                        {
                            @* ⠿ tutamağı sürükle = kolonu taşı; başlık metnine tıkla = sırala; sağ kenar = genişlik (CSS). *@
                            <th data-key="@key" style="@ThStyle(key)"
                                @ondragover:preventDefault="true" @ondrop="@(() => OnDropColumn(key))">
                                <div class="dw-th">
                                    <span title="Sürükleyerek kolonu taşı" draggable="true"
                                          @ondragstart="@(() => _dragKey = key)"
                                          style="cursor:grab;opacity:.45;margin-right:4px;user-select:none;">⠿</span>
                                    <span style="cursor:pointer;flex:1 1 auto;" @onclick="@(() => ToggleSort(key))">@Label(key).ToUpperInvariant()</span>
                                    <span class="dw-sort">@SortArrow(key)</span>
                                </div>
                                <span class="dw-col-grip"></span>@* sağ kenardan sürükle = genişlet/daralt (oturum-içi) *@
                            </th>
                        }
                    </tr>
                    <!-- Başlık-altı filtre satırı (kullanıcı isteği 2026-08-06, madde 4): her kolonun TAM ALTINDA
                         kendi filtre kutusu — table-layout:fixed sayesinde header'la otomatik hizalı, ayrı bir
                         hizalama mekanizması gerekmez. Filtreleme mantığı (GetFilter/SetFilter/OnFilterKey)
                         AYNEN korunur; yalnız konumu değişti. -->
                    <tr>
                        @foreach (var key in _visibleColumns)
                        {
                            <th style="@ThStyle(key)" class="dw-filter-th">
                                <MudTooltip Text="@(IsNumeric(key) ? "Tam sayı: 5 · Karşılaştırma: >5  <5  >=5  <=5 · Aralık: 5-10" : "İçerir araması")">
                                    <MudTextField T="string" Value="@GetFilter(key)" ValueChanged="@((string v) => SetFilter(key, v))"
                                                  Placeholder="@(IsNumeric(key) ? "5, >5, 5-10…" : "içerir…")"
                                                  Immediate="false" OnKeyUp="OnFilterKey"
                                                  Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" />
                                </MudTooltip>
                            </th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                        @* Tek tık = sağdaki detay paneli (mevcut davranış korunur). Çift tık = ayrı düzenle/kaydet/sil penceresi. *@
                        @foreach (var row in _rows)
                        {
                            @* Çift tık = ayrı Düzelt/Kaydet/Sil penceresi (yan detay paneli kaldırıldı — tablo tam genişlik). *@
                            <tr @ondblclick="@(() => OpenQuickEdit(Str(row, "id")))" style="cursor:pointer;">
                                @foreach (var key in _visibleColumns) { <td title="@Str(row, key)">@Str(row, key)</td> }
                            </tr>
                        }
                    </tbody>
                </table>
                </div>

                @* Sayfa numaraları + kayıt bilgisi TABLONUN ALTINDA, SOLDA (kullanıcı isteği 2026-07-19: tüm tablolu ekranlarda). *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap" Justify="Justify.FlexStart">
                    <MudPagination Count="@_totalPages" Selected="@_page" SelectedChanged="OnPageChanged"
                                   BoundaryCount="1" MiddleCount="3" ShowFirstButton="true" ShowLastButton="true" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@_totalCount kayıt — sayfa @_page / @_totalPages</MudText>
                </MudStack>
            }
        </MudPaper>
    </MudItem>

</MudGrid>
}

@code {
    [Parameter] public string? Section { get; set; }
    private bool _isNew => string.Equals(Section, "new", StringComparison.OrdinalIgnoreCase);

    // ── G2-01: tam düzenleme formunun GİRİŞ YOLU + YETKİ KAPISI ───────────────────────────────
    // Form kodda hep vardı ama onu açan hiçbir kontrol yoktu (bu metot ölüydü). Artık hızlı düzenleme
    // penceresindeki "Tam Düzenleme" düğmesinden çağrılıyor. Ekstra onay YOK: kullanıcı zaten açıkça
    // o düğmeye bastı; ikinci bir "emin misiniz" gürültü olurdu.
    /// ⚠️ <c>forceLoad: true</c> ZORUNLU: <c>/materials</c> ile <c>/materials/new</c> AYNI bileşene
    /// bağlıdır (`@page "/materials"` + `@page "/materials/{Section}"`). Blazor bileşeni yeniden
    /// oluşturmaz, yalnız parametreyi günceller → <c>OnInitializedAsync</c> TEKRAR ÇALIŞMAZ ve form
    /// boş açılırdı. Tam sayfa yüklemesi başlangıç akışını (tanımlar + kaydı yükle) yeniden çalıştırır.
    private void EditNav(string id) => Nav.NavigateTo($"/materials/new?edit={id}", forceLoad: true);

    /// <summary>URL'de <c>?edit=</c> var mı — yani form YENİ KAYIT için mi, DÜZENLEME için mi açıldı.
    /// İlk render'dan ÖNCE (OnInitializedAsync'in ilk await'inden önce) belirlenir; <c>_editId</c> o anda
    /// henüz set edilmemiş olabileceği için yetki kapısı buna bakar, <c>_editId</c>'ye değil.</summary>
    private bool _isEditRoute;

    /// <summary>YETKİ KAPISI (G2-01): yeni kayıt <b>Create</b>, mevcut kaydı düzenleme <b>Edit</b> ister.
    /// Eskiden ikisi de <c>CanCreate</c>'e bağlıydı → düzenleme yetkisi olup oluşturma yetkisi olmayan
    /// kullanıcı bomboş sayfa görüyordu. Masaüstündeki ayrımın aynısı (MaterialsViewModel.CanWrite/CanEdit).</summary>
    private bool CanUseForm => _isEditRoute ? Auth.CanEdit("materials") : Auth.CanCreate("materials");

    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };
    private static readonly string[] _types = { "Yedek Parça", "Sarf Malzeme", "Hammadde", "Lastik", "Diğer" };

    private string? _editId;
    private string? _templateId;
    private List<ApiClient.Opt> _templates = new();
    private string _code = "", _name = "", _type = "Yedek Parça";
    private string? _cat, _subCat, _unit, _brand, _sup;
