    private async Task BeginEdit()
    {
        if (_detail is null) return;
        var d = _detail.Value;
        _editId = Str(d, "id");
        _v = Long(d, "version");   // G2-02: düzenleme kilidi — formun açıldığı andaki sürüm
        await LoadMovementsAsync(_editId);   // Son Hareketler paneli (A3)
        _templateId = NullId(d, "templateId");   // mevcut şablon bağını yükle → normal düzenleme bağı korur, değiştirilebilir
        _code = Str(d, "code"); _name = Str(d, "name");
        // G2-07 (2026-08-10): MEVCUT kaydın türü BOŞ ise "Diğer" gösterilir (yeni kayıt varsayılanı
        // "Yedek Parça" olarak KALIR). Gerekçe: "Yedek Parça" gerçek bir türdür; kullanıcı hiçbir şey
        // değiştirmeden kaydettiğinde boş veri sessizce o sınıfa yazılıyordu. Aşağıdaki _snap bu değerden
        // SONRA alınır → değişiklik sayacı tutarlı kalır; kaydetmede de aynı değer gider.
        _type = string.IsNullOrEmpty(Str(d, "type")) ? "Diğer" : Str(d, "type");
        _unit = NullId(d, "unitId"); _brand = NullId(d, "brandId"); _sup = NullId(d, "supplierId");
        await ResolveEditCategory(NullId(d, "categoryId"));   // alt-kategorili malzemede kategori+alt kutulara dağıt (madde 6)
        _min = Dec(d, "minStock"); _price = Dec(d, "unitPrice"); _desc = Str(d, "description");
        _stock = Dec(d, "stock");   // Kritik stok paneli (S3) için mevcut bakiye (FİRMA GENELİ toplam)
        await LoadLocationBreakdown();   // STK-04: hangi depoda ne kadar (tek istek)
        _snap = (_code, _name, _type, _cat, _unit, _brand, _sup, _min, _price, _desc ?? "", _templateId);   // S2: değişiklik sayacı referansı
        _vehicleSel = new HashSet<string>(Arr(d, "compatibleVehicles").Select(v => Str(v, "id")).Where(x => x != ""));
        _equivalents.Clear();
        foreach (var e in Arr(d, "equivalents")) _equivalents.Add(new ApiClient.Opt(Str(e, "id"), Str(e, "name")));
        _msg = null;
        await Task.CompletedTask;
