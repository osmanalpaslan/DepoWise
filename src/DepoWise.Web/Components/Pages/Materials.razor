    // Kolon sürükle-taşıma: başlık ⠿ tutamağı sürüklenip başka bir başlığa bırakılınca sıra değişir + kalıcı kaydolur.
    // Veri yeniden çekilmez (yalnız kolon SIRASI değişir; tablo _visibleColumns'tan yeniden render edilir).
    private string? _dragKey;
    private async Task OnDropColumn(string targetKey)
    {
        var src = _dragKey; _dragKey = null;
        if (string.IsNullOrEmpty(src) || src == targetKey) return;
        var from = _visibleColumns.IndexOf(src);
        if (from < 0) return;
        _visibleColumns.RemoveAt(from);
        var to = _visibleColumns.IndexOf(targetKey);
        _visibleColumns.Insert(to < 0 ? _visibleColumns.Count : to, src);   // hedef kolonun ÖNÜNE bırak
        await Api.SaveListColumnsAsync("materials", _visibleColumns);
    }

    protected override async Task OnInitializedAsync()
    {
        // G2-01: kapıyı belirleyen bilgi İLK AWAIT'TEN ÖNCE hesaplanır → ilk render'da da doğru.
        var q0 = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        _isEditRoute = q0.TryGetValue("edit", out var e0) && !string.IsNullOrEmpty(e0);

        if (_isNew && CanUseForm)
        {
            _cats = await Api.OptionsAsync("/api/materials/subcategories", "id", "name");
            _units = await Api.OptionsAsync("/api/lookups/units", "id", "name");
            _brands = await Api.OptionsAsync("/api/lookups/brands", "id", "name");
            _sups = await Api.OptionsAsync("/api/lookups/suppliers", "id", "name");
            try { _templates = await Api.OptionsAsync("/api/material-templates", "id", "name"); } catch { }
            // Hızlı düzenleme penceresindeki "Tam Düzenleme" ile gelindiyse (?edit=id) kaydı forma yükle
            if (_isEditRoute)
            {
                try { _detail = await Api.GetObjectAsync($"/api/materials/{e0}"); await BeginEdit(); } catch { }
            }
        }
        if (!_isNew)
        {
            var saved = await Api.GetListColumnsAsync("materials");
            // İş #10: kaydedilmiş tercih KATALOĞA göre süzülür — masaüstüyle aynı kural (hayalet kolon çizilmesin).
            if (saved is { Count: > 0 }) _visibleColumns = MaterialListColumns.Sanitize(saved).ToList();
            var (ps, _) = await Api.GetListPrefsAsync("materials");
            if (ps is > 0) _pageSize = ps.Value;               // değiştirmediyse null → 25 kalır (genişlik yüklenmez)
            await Load();
        }
    }

    // Düzenlemede mevcut category_id üst-seviye mi alt kategori mi? kutulara doğru dağıt (madde 6).
    // _suppressSub: reaktif _lastCat mekanizması _subCat'ı temizlemesin (kategoriyi programatik ayarlıyoruz).
    private async Task ResolveEditCategory(string? catId)
    {
        _subCat = null;
        if (string.IsNullOrEmpty(catId)) { _cat = null; return; }
        if (_cats.Any(o => o.Id == catId)) { _cat = catId; return; }   // üst-seviye kategori
        foreach (var top in _cats)                                     // alt kategori: parent'ı tara
        {
            var subs = await Api.OptionsAsync($"/api/materials/subcategories?parentId={top.Id}", "id", "name");
            if (subs.Any(x => x.Id == catId)) { _cat = top.Id; _subCat = catId; _suppressSub = true; break; }
        }
    }

    private string? _lastCat;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_cat != _lastCat)
        {
            _lastCat = _cat; if (_suppressSub) { _suppressSub = false; }
            else _subCat = null;
            _subCats = string.IsNullOrEmpty(_cat) ? new()
                : await Api.OptionsAsync($"/api/materials/subcategories?parentId={_cat}", "id", "name");
            StateHasChanged();
        }
    }
    private bool _suppressSub;

    private async Task Load()
    {
        _rows = null;
        var qs = new List<string> { $"page={_page}", $"pageSize={_pageSize}" };
        qs.AddRange(BuildFilterSortQs());
        var grid = await Api.GetGridAsync("/api/materials/grid?" + string.Join("&", qs));
        _rows = grid.Items; _totalCount = grid.TotalCount; _page = grid.Page; _pageSize = grid.PageSize; _totalPages = grid.TotalPages;
    }

    /// <summary>Sıralama + kolon filtreleri — sayfalamasız (Load VE ExportExcel PAYLAŞIR; ikisi de AYNI
    /// aktif filtrelerle çalışsın istiyoruz, kullanıcı isteği 2026-07-19).</summary>
    private List<string> BuildFilterSortQs()
    {
        var qs = new List<string>();
        if (_sortColumn is not null) { qs.Add($"sort={_sortColumn}"); qs.Add($"desc={(_sortDesc ? "true" : "false")}"); }
        if (_criticalOnly) qs.Add("criticalOnly=true");   // A1 (Aurora): yalnız stok≤min. Load+Export paylaşır.
        foreach (var (k, v) in _filters)
            if (!string.IsNullOrWhiteSpace(v)) qs.Add($"{k}={Uri.EscapeDataString(v.Trim())}");
        return qs;
    }

    // A1 (Aurora): "Yalnız kritik" geçişi — açıkken listede/Excel'de yalnız kritik seviye altı malzemeler.
    private bool _criticalOnly;
