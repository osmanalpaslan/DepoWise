@page "/materials"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth

<h3>Malzemeler</h3>

@if (Auth.CanCreate("materials"))
{
    <div class="card mb-3" style="max-width:820px;">
        <div class="card-body">
            <h6>Yeni Malzeme</h6>
            <div class="row g-2">
                <div class="col-md-3"><input class="form-control form-control-sm" placeholder="Kod *" @bind="_code" /></div>
                <div class="col-md-5"><input class="form-control form-control-sm" placeholder="Ad *" @bind="_name" /></div>
                <div class="col-md-4"><input class="form-control form-control-sm" placeholder="Tür" @bind="_type" /></div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="_unit"><option value="">Birim</option>@Opts(_units)</select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="_cat"><option value="">Kategori</option>@Opts(_cats)</select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="_brand"><option value="">Marka</option>@Opts(_brands)</select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="_sup"><option value="">Tedarikçi</option>@Opts(_sups)</select>
                </div>
                <div class="col-md-3"><input class="form-control form-control-sm" type="number" placeholder="Min. Stok" @bind="_min" /></div>
                <div class="col-md-3"><input class="form-control form-control-sm" type="number" placeholder="Birim Fiyat" @bind="_price" /></div>
            </div>
            <button class="btn btn-success btn-sm mt-2" @onclick="Create" disabled="@_busy">@(_busy ? "…" : "Malzeme Ekle")</button>
            @if (_msg is not null) { <span class="ms-2">@_msg</span> }
        </div>
    </div>
}

<DataList @key="_v" Title="Malzeme Listesi" Path="/api/materials" />

@code {
    private string _code = "", _name = "", _type = "", _unit = "", _cat = "", _brand = "", _sup = "";
    private decimal _min, _price;
    private List<(string Id, string Name)> _units = new(), _cats = new(), _brands = new(), _sups = new();
    private string? _msg; private bool _busy; private int _v;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.CanCreate("materials")) return;
        _units = await Lk("units"); _cats = await Lk("material_categories");
        _brands = await Lk("brands"); _sups = await Lk("suppliers");
    }

    private async Task<List<(string, string)>> Lk(string table)
    {
        try
        {
            var arr = await Api.GetArrayAsync($"/api/lookups/{table}");
            return arr.Where(e => e.ValueKind == JsonValueKind.Object)
                .Select(e => (e.GetProperty("id").GetString() ?? "", e.GetProperty("name").GetString() ?? ""))
                .ToList();
        }
        catch { return new(); }
    }

    private RenderFragment Opts(List<(string Id, string Name)> list) => builder =>
    {
        int i = 0;
        foreach (var (id, name) in list)
        {
            builder.OpenElement(i++, "option");
            builder.AddAttribute(i++, "value", id);
            builder.AddContent(i++, name);
            builder.CloseElement();
        }
    };

    private async Task Create()
    {
        _msg = null;
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name)) { _msg = "Kod ve ad zorunlu."; return; }
        _busy = true;
        try
        {
            var err = await Api.PostAsync("/api/materials", new
            {
                code = _code.Trim(), name = _name.Trim(), type = string.IsNullOrWhiteSpace(_type) ? null : _type,
                categoryId = Empty(_cat), unitId = Empty(_unit), brandId = Empty(_brand), supplierId = Empty(_sup),
                minStock = _min, unitPrice = _price
            });
            _msg = err ?? "Eklendi.";
            if (err is null) { _code = _name = _type = _unit = _cat = _brand = _sup = ""; _min = _price = 0; _v++; }
        }
        catch (Exception ex) { _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private static string? Empty(string v) => string.IsNullOrEmpty(v) ? null : v;
}
