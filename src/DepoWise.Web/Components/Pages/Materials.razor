            var t = await Api.GetObjectAsync($"/api/material-templates/{id}");
            _code = Str(t, "code"); if (!string.IsNullOrEmpty(Str(t, "name"))) _name = Str(t, "name");
            var tp = Str(t, "type"); if (!string.IsNullOrEmpty(tp)) _type = tp;
            _cat = NullId(t, "categoryId"); _unit = NullId(t, "unitId"); _brand = NullId(t, "brandId"); _sup = NullId(t, "supplierId");
            _min = Dec(t, "minStock"); _price = Dec(t, "unitPrice"); _desc = Str(t, "description");
        }
        catch { }
    }

    private async Task Save()
    {
        _err = true; _msg = null;
        // "Tüm Şubeler" modunda yazma yok: açılış stoğu hareketi şubesiz düşerdi (hangi şantiyeye ait olduğu kaybolur).
        if (!await Dialog.RequireBranchAsync(Auth, "Malzemeler")) return;
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name)) { _msg = "Kod ve ad zorunlu."; _ok = false; return; }
        if (string.IsNullOrEmpty(_unit)) { _msg = "Birim seçin."; _ok = false; return; }
        // Malzeme şablonu kaldırıldı (kullanıcı isteği 2026-08-05) — şablon dışı uyarısı yok; düz onay.
        if (!await Dialog.Confirm(_editId is null ? "Malzeme kaydedilsin mi?" : "Malzeme güncellensin mi?")) return;
        _busy = true;
        try
        {
            var body = new
            {
                code = _code.Trim(), name = _name.Trim(), type = string.IsNullOrWhiteSpace(_type) ? null : _type,
                categoryId = string.IsNullOrEmpty(_subCat) ? Empty(_cat) : _subCat,
                unitId = Empty(_unit), brandId = Empty(_brand), supplierId = Empty(_sup),
                minStock = _min, unitPrice = _price, description = Empty(_desc), openingStock = _opening,
                openingLocationId = EffectiveOpeningLocation,   // STK-04: açılış stoğunun deposu
                vehicleIds = _vehicleSel.ToList(), equivalentIds = _equivalents.Select(e => e.Id).ToList(),
                templateId = _templateId,   // seçilen şablon → şablonlu/şablon-dışı rapor ayrımı (create'te bağlanır)
                // G2-02: DÜZENLEME KİLİDİ. Yeni kayıtta _v = 0 → null gider (POST zaten sürüm kullanmaz),
                // düzenlemede formun açıldığı andaki sürüm gider → kayıt arada değiştiyse sunucu 409 döner.
                version = _v > 0 ? (long?)_v : null
            };
            string? err; string? savedId;
            if (_editId is null)
            {
                (err, savedId) = await Api.CreateAsync("/api/materials", body);
            }
            else
            {
                err = await Api.PutAsync($"/api/materials/{_editId}", body);
                savedId = _editId;
            }
            // ── G2-02: DÜZENLEME KİLİDİ — kayıt biz düzenlerken değişti (409) ──────────────────────
            // Yazdıklarını KAYBETME: karar kullanıcınındır. Masaüstündeki kanıtlanmış desenin AYNISI
            // (MaterialsViewModel.Add → ConcurrencyException): "Kaydı yenile" / "Formda kal".
            // NOT (WEB-01, Seçenek A): mesaj bugün ham JSON gövdesiyle geliyor. Ortak ayrıştırma
            // WEB-01'in konusudur — burada İKİNCİ bir ayrıştırma mekanizması KURULMAZ; yalnız
            // ApiClient'ın ürettiği "Hata {kod}: ..." önekinden durum kodu okunur.
            if (err is not null && _editId is not null && err.StartsWith("Hata 409", StringComparison.Ordinal))
            {
                _ok = false; _msg = err;
                if (await Dialog.Confirm(
                        err + "\n\nKaydın güncel hâlini yüklemek ister misiniz? " +
                        "(\"Formda kal\" derseniz yazdıklarınız durur, kopyalayıp tekrar uygulayabilirsiniz.)",
                        okText: "Kaydı yenile", cancelText: "Formda kal"))
                {
                    // Kullanıcı AÇIKÇA istedi → kaydı sunucudan tazele ve forma yeniden yükle.
                    // Clear() çağrılmaz; form açık kalır, alanlar güncel değerlerle dolar (yeni sürüm dahil).
                    try
                    {
                        _detail = await Api.GetObjectAsync($"/api/materials/{_editId}");
                        await BeginEdit();
                        _ok = true; _msg = "Kayıt güncel hâliyle yeniden yüklendi.";
                    }
                    catch { }
                }
                // "Formda kal" → hiçbir şey yapılmaz: form AÇIK, alanlar DOKUNULMAMIŞ, hata mesajı görünür.
                return;   // fotoğraf yükleme ve Clear()/yönlendirme ÇALIŞMAZ
            }

            // Bekleyen fotoğrafları oluşan/güncellenen kayda yükle
            if (err is null && savedId is not null && _staged.Count > 0)
                await Api.UploadFilesAsync($"/api/materials/{savedId}/photos", _staged.Select(p => (p.Name, p.Bytes, p.Mime)));

            _ok = err is null; _msg = err ?? (_editId is null ? "Malzeme eklendi." : "Malzeme güncellendi.");
            // forceLoad: EditNav ile aynı gerekçe — listeye dönerken bileşen yeniden kurulmalı ki
            // OnInitializedAsync (kolon tercihleri + Load) çalışsın; aksi hâlde liste boş/dönen
            // göstergede kalırdı. (G2-01 kapıyı açınca bu yol gerçekten kullanılır hâle geldi.)
            if (_ok) { Clear(); Nav.NavigateTo("/materials", forceLoad: true); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private void Clear()
    {
        _err = false; _editId = null; _code = _name = ""; _type = "Yedek Parça";
        _cat = _subCat = _unit = _brand = _sup = null; _min = _price = _opening = 0; _desc = "";
        _vehicleSel = new HashSet<string>(); _equivalents.Clear(); _eqPick = null; _staged.Clear();
        _movements = null; _snap = null; _stock = 0; _locations = null;
        _v = 0;   // G2-02: sürüm de sıfırlanır → yeni kayıtta düzenleme kilidi gönderilmez
    }

    // ── Değişiklik sayacı (S2) — kaydedilmemiş alan sayısı + iptalde uyarı ─────
    private (string code, string name, string type, string? cat, string? unit, string? brand, string? sup,
        decimal min, decimal price, string desc, string? tpl)? _snap;
    private int DirtyCount
    {
        get
        {
            if (_snap is not { } s) return 0;
            int n = 0;
            if (_code != s.code) n++;
            if (_name != s.name) n++;
            if (_type != s.type) n++;
            if (_cat != s.cat) n++;
            if (_unit != s.unit) n++;
            if (_brand != s.brand) n++;
            if (_sup != s.sup) n++;
            if (_min != s.min) n++;
            if (_price != s.price) n++;
            if ((_desc ?? "") != s.desc) n++;
            if (_templateId != s.tpl) n++;
            return n;
        }
    }
    private async Task CancelEdit()
    {
        if (_editId is not null && DirtyCount > 0 &&
            !await Dialog.Confirm($"{DirtyCount} kaydedilmemiş değişiklik var. Yine de çıkılsın mı? Değişiklikler kaybolur.",
                okText: "Evet, Çık", danger: true)) return;
        Clear();
    }

    // ── Kritik stok paneli (S3) — mevcut bakiye + onaylı TASLAK talep ──────────
    private decimal _stock;

    /// <summary>STK-04 — malzemenin depo kırılımı (kart açılınca TEK istekle gelir; null = henüz yüklenmedi).</summary>
    private List<LocRow>? _locations;
    private sealed record LocRow(string Id, string Name, decimal Quantity);

    /// <summary>Kırılım YALNIZ kart açılırken çekilir. Liste satırlarında çağrılmaz — 100 malzeme x 5 depo
    /// = 500 istek yapısı oluşmasın (STK-04 performans kuralı). Hata olursa panel gizlenir, kart açılır.</summary>
    private async Task LoadLocationBreakdown()
    {
        _locations = null;
        if (_editId is null) return;
        try
        {
            var d = await Api.GetObjectAsync($"/api/stock/balance/{_editId}/locations");
            if (d.TryGetProperty("locations", out var arr) && arr.ValueKind == System.Text.Json.JsonValueKind.Array)
                _locations = arr.EnumerateArray()
                    .Select(x => new LocRow(Str(x, "locationId"), Str(x, "locationName"), Dec(x, "quantity")))
                    .ToList();
        }
        catch { _locations = null; }
    }
    private bool _reqBusy;
    private async Task CreateRequestForMaterial()
    {
        if (_editId is null) return;
        var shortfall = Math.Max(1m, Math.Ceiling(_min - _stock));
        if (!await Dialog.Confirm($"Bu malzeme için {shortfall:0.##} birim talep taslağı oluşturulsun mu? " +
                "(Talepler ekranından şantiye/miktar tamamlayıp gönderebilirsiniz.)", okText: "Talep Oluştur")) return;
        _reqBusy = true;
        try
        {
            var body = new { items = new[] { new { materialId = _editId, quantity = shortfall } }, submitImmediately = false };
            var err = await Api.PostAsync("/api/requests", body);
            if (err is null) Snackbar.Add("Talep taslağı oluşturuldu (Talepler ekranından gönderebilirsiniz).", Severity.Success);
            else Snackbar.Add(err, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add("Talep oluşturulamadı: " + ex.Message, Severity.Error); }
        finally { _reqBusy = false; }
    }

    // ── İşlem Geçmişi paneli (A3 + madde 4, 2026-08-06) — salt-okunur; TÜM stok hareketleri ─────────────
    private List<JsonElement>? _movements;
    private async Task LoadMovementsAsync(string? id)
    {
        _movements = null;
        if (string.IsNullOrEmpty(id)) return;
        try { _movements = new List<JsonElement>(await Api.GetArrayAsync($"/api/materials/{id}/movements?take=100")); }
        catch { _movements = null; }
    }

    // Çift tık yerine tek tık (web'de satır zaten hover/click davranışlı) → salt-okunur detay + "Kaydı Görüntüle"
    // (madde 5): Stok Hareketleri ekranına malzeme koduyla arama yaparak gider.
    private async Task OpenMovementDetail(JsonElement m)
    {
        var qty = MvQty(m);
        var detail = (qty >= 0 ? "+" : "") + qty.ToString("0.##") +
            (string.IsNullOrEmpty(Str2(m, "reference")) ? "" : $" · {Str2(m, "reference")}");
        var pars = new DialogParameters
        {
            ["DateText"] = MvDate(m), ["KindText"] = Str2(m, "label"), ["DetailText"] = detail,
            ["OpenUrl"] = $"/stock/movements?q={Uri.EscapeDataString(_code)}"
        };
        await Dialog.ShowAsync<HistoryDetailDialog>("İşlem Detayı", pars,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
    }
    private static string Str2(JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
    private static string MvDate(JsonElement e)
        => e.TryGetProperty("date", out var v) && v.TryGetInt64(out var ms)
            ? DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.ToString("dd.MM.yyyy") : "";
    private static decimal MvQty(JsonElement e)
        => e.TryGetProperty("quantity", out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var d) ? d : 0m;

    private static string GuessMime(string name)
    {
        var ext = System.IO.Path.GetExtension(name).ToLowerInvariant();
        return ext switch { ".png" => "image/png", ".gif" => "image/gif", ".webp" => "image/webp", ".bmp" => "image/bmp", _ => "image/jpeg" };
    }

    private static string? Empty(string? v) => string.IsNullOrEmpty(v) ? null : v;
    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static string? NullId(JsonElement row, string key) { var s = Str(row, key); return string.IsNullOrEmpty(s) ? null : s; }
    private static decimal Dec(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0;
    /// <summary>G2-02 — DÜZENLEME KİLİDİ: kaydın sürümü. 0/eksik → kontrol yapılmaz (geriye uyumlu).
    /// MaterialEditDialog'daki aynı yardımcının eşi.</summary>
    private static long Long(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetInt64() : 0;
    private static IEnumerable<JsonElement> Arr(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Array
            ? v.EnumerateArray() : Enumerable.Empty<JsonElement>();
}
