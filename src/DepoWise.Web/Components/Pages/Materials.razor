    private bool _exporting;
    /// <summary>"Excel'e Aktar" (kullanıcı isteği 2026-07-19): AKTİF filtrelerle eşleşen TÜM sonuçları
    /// (sayfalama sınırı olmadan) indirir — o an ekrandaki sayfayı değil.</summary>
    private async Task ExportExcel()
    {
        // Deny-by-default: dışa aktarım ayrı yetki (2026-07-26). API da 403 döner; burada butonda uyarı + işlem yok.
        if (!Auth.CanView("export")) { Snackbar.Add("Dışa aktarım (export) yetkiniz yok.", Severity.Warning); return; }
        if (_exporting) return;
        _exporting = true;
        try
        {
            var qs = string.Join("&", BuildFilterSortQs());
            var (bytes, fileName) = await Api.GetFileAsync("/api/materials/grid/export" + (qs.Length > 0 ? "?" + qs : ""), "Malzemeler.xlsx");
            if (bytes is not null)
                await JS.InvokeVoidAsync("dwDownload", fileName, Convert.ToBase64String(bytes),
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _exporting = false; }
    }

