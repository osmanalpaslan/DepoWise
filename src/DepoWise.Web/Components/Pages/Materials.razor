@page "/materials"
@page "/materials/{Section}"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@inject NavigationManager Nav
@inject IJSRuntime JS

<MudText Typo="Typo.h5" GutterBottom="true">@(_isNew ? "Malzeme — Yeni Kayıt" : "Malzeme Listesi")</MudText>

@* "Tüm Şubeler" modunda bu ekranda İŞLEM yapılamaz (kayıt hangi şubeye yazılacağı belli değil) — okuma serbest. *@
@if (Auth.IsAllBranches())
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">@DepoWise.Web.Services.BranchGuard.Banner</MudAlert>
}

@if (_isNew && Auth.CanCreate("materials"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:760px;">
        <MudText Typo="Typo.h6" Class="mb-2">@(_editId is null ? "YENİ MALZEME" : "MALZEME DÜZENLE")</MudText>

        @if (_editId is null && _templates.Count > 0)
        {
            <MudSelect T="string" Value="_templateId" ValueChanged="ApplyTemplate" Label="Şablon (örnek kayıt)" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                       HelperText="Şablon seçerseniz alanlar önden dolar. Şablon seçmeden kaydederseniz uyarı çıkar (tek tip kayıt için).">
                @foreach (var t in _templates) { <MudSelectItem T="string" Value="@t.Id">@t.Name</MudSelectItem> }
            </MudSelect>
        }

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-1 mb-1">Tanım</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="6" md="3"><MudTextField @bind-Value="_code" Label="Kod *" Error="_err && string.IsNullOrWhiteSpace(_code)" ErrorText="Kod zorunlu." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_name" Label="Ad *" Error="_err && string.IsNullOrWhiteSpace(_name)" ErrorText="Ad zorunlu." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="_type" Label="Tür" Margin="Margin.Dense" Variant="Variant.Outlined">
                    @foreach (var t in _types) { <MudSelectItem T="string" Value="@t">@t</MudSelectItem> }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Sınıflandırma</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><LookupSelect Label="Kategori" @bind-Value="_cat" Items="_cats" AddTable="material_categories" OnAdded="ReloadCats" /></MudItem>
            <MudItem xs="12" md="6">
                @* Alt Kategori: seçili KATEGORİYE bağlı; "+" ile o kategoriye alt kategori eklenir (parent_id=_cat).
                   Kategori seçilene kadar pasif; seçilince o kategorinin alt kategorileri listelenir. *@
                <LookupSelect Label="Alt Kategori" @bind-Value="_subCat" Items="_subCats"
                              CreatePath="/api/materials/subcategories" CreateField="name"
                              ExtraField="parentId" ExtraValue="@_cat"
                              Disabled="@string.IsNullOrEmpty(_cat)" OnAdded="ReloadSubCats" />
                @if (string.IsNullOrEmpty(_cat)) { <MudText Typo="Typo.caption" Class="mud-text-secondary">Önce kategori seçin.</MudText> }
            </MudItem>
            <MudItem xs="12" md="6">
                <LookupSelect Label="Birim *" @bind-Value="_unit" Items="_units" AddTable="units" OnAdded="ReloadUnits" />
                @if (_err && string.IsNullOrEmpty(_unit)) { <MudText Typo="Typo.caption" Color="Color.Error">Birim seçin.</MudText> }
            </MudItem>
            <MudItem xs="12" md="6"><LookupSelect Label="Marka" @bind-Value="_brand" Items="_brands" AddTable="brands" OnAdded="ReloadBrands" /></MudItem>
            <MudItem xs="12" md="6"><LookupSelect Label="Tedarikçi" @bind-Value="_sup" Items="_sups" AddTable="suppliers" OnAdded="ReloadSups" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">İlişkiler</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="string" @bind-SelectedValues="_vehicleSel" Label="Uyumlu Araçlar" MultiSelection="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                           MultiSelectionTextFunc="@(v => $"{v.Count} araç seçili")" HelperText="Bu malzemenin takıldığı araçlar (çoklu seçim).">
                    @foreach (var o in _vehicles) { <MudSelectItem T="string" Value="@o.Id">@o.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudAutocomplete T="ApiClient.Opt" Label="Muadil Malzeme" SearchFunc="SearchMaterial" @bind-Value="_eqPick"
                                 ToStringFunc="@(o => o?.Name ?? "")" Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true"
                                 HelperText="Mevcut malzemelerden ara/ekle (çoklu)." />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Class="mt-1" OnClick="AddEquivalent">Muadil Ekle</MudButton>
                @if (_equivalents.Count > 0)
                {
                    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-1">
                        @foreach (var e in _equivalents)
                        {
                            <MudChip T="string" OnClose="@(() => _equivalents.Remove(e))" Size="Size.Small">@e.Name</MudChip>
                        }
                    </MudStack>
                }
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Fiyat &amp; Stok</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="6" md="4"><MudNumericField T="decimal" @bind-Value="_price" Label="Birim Fiyat (TRY)" Margin="Margin.Dense" Variant="Variant.Outlined" Min="0" Format="0.##" /></MudItem>
            <MudItem xs="6" md="4"><MudNumericField T="decimal" @bind-Value="_min" Label="Min Stok" Margin="Margin.Dense" Variant="Variant.Outlined" Min="0" Format="0.##" /></MudItem>
            @if (_editId is null)
            {
                <MudItem xs="6" md="4"><MudNumericField T="decimal" @bind-Value="_opening" Label="Açılış Stok" HelperText="0 dışında ise stok hareketi (eksi olabilir)." Margin="Margin.Dense" Variant="Variant.Outlined" Format="0.##" /></MudItem>
            }
            <MudItem xs="12"><MudTextField @bind-Value="_desc" Label="Açıklama" Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-3 mb-1">Fotoğraflar</MudText>
        <InputFile OnChange="OnFiles" multiple accept="image/*" />
        @if (_staged.Count > 0)
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-2">
                @foreach (var p in _staged)
                {
                    <div style="position:relative;width:84px;height:84px;margin:0 8px 8px 0;">
                        <MudImage Src="@p.Preview" Width="84" Height="84" ObjectFit="ObjectFit.Cover" Style="border-radius:8px;" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                       Style="position:absolute;top:0;right:0;" OnClick="@(() => _staged.Remove(p))" />
                    </div>
                }
            </MudStack>
        }

        <MudStack Row="true" Class="mt-3" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="Clear">İptal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_busy">@(_busy ? "…" : "Kaydet")</MudButton>
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

@if (!_isNew)
{
<MudGrid Spacing="2">
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Elevation="2">
            <div @oncontextmenu="OpenColumnPicker" @oncontextmenu:preventDefault="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6">Malzeme Listesi</MudText>
                    <MudTooltip Text="Kolonları ayarla (bu alanda sağ tık da açar) — yalnız sizin için geçerlidir">
                        <MudIconButton Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" OnClick="OpenColumnPicker" />
                    </MudTooltip>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Sayfa boyutu</MudText>
                    <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true" Style="max-width:90px">
                        @foreach (var sz in PageSizes) { <MudSelectItem T="int" Value="@sz">@sz</MudSelectItem> }
                    </MudSelect>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters">Filtrele</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearFilters">Temizle</MudButton>
                    <MudTooltip Text="Aktif filtrelerle eşleşen TÜM malzemeleri (yalnız bu sayfayı değil) Excel dosyası olarak indirir">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@_exporting" OnClick="ExportExcel">Excel'e Aktar</MudButton>
                    </MudTooltip>
                </MudStack>
            </div>

            @* Kolon bazlı filtreler — her görünür kolon için ayrı kutu; "içerir" arar (kullanıcı isteği 2026-07-17). *@
            <MudGrid Spacing="1" Class="mb-2">
                @foreach (var key in _visibleColumns)
                {
                    <MudItem xs="6" sm="4" md="3" lg="2">
                        <MudTooltip Text="@(IsNumeric(key) ? "Tam sayı: 5 · Karşılaştırma: >5  <5  >=5  <=5 · Aralık: 5-10" : "İçerir araması")">
                            <MudTextField T="string" Value="@GetFilter(key)" ValueChanged="@((string v) => SetFilter(key, v))"
                                          Label="@Label(key)" Placeholder="@(IsNumeric(key) ? "5, >5, 5-10…" : "içerir…")"
                                          Immediate="false" OnKeyUp="OnFilterKey"
                                          Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" />
                        </MudTooltip>
                    </MudItem>
                }
            </MudGrid>

            @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
            else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Filtre kriterine uygun malzeme bulunamadı.</MudText> }
            else
            {
                @* Excel-benzeri: sabit tablo düzeni + yatay kaydırma (pencere küçülünce taşma/kayma OLMAZ) +
                   başlığı sürükleyerek kolon genişliği (CSS resize). Başlığa tıklama = sırala. *@
                <div style="overflow-x:auto;">
                <table id="materials-grid" class="dw-grid">
                    <thead><tr>
                        @foreach (var key in _visibleColumns)
                        {
                            <th data-key="@key" style="@ThStyle(key)">
                                <div class="dw-th" @onclick="@(() => ToggleSort(key))">
                                    <span>@Label(key).ToUpperInvariant()</span>
                                    <span class="dw-sort">@SortArrow(key)</span>
                                </div>
                            </th>
                        }
                    </tr></thead>
                    <tbody>
                        @* Tek tık = sağdaki detay paneli (mevcut davranış korunur). Çift tık = ayrı düzenle/kaydet/sil penceresi. *@
                        @foreach (var row in _rows)
                        {
                            <tr @onclick="@(() => OpenDetail(Str(row, "id")))" @ondblclick="@(() => OpenQuickEdit(Str(row, "id")))" style="cursor:pointer;">
                                @foreach (var key in _visibleColumns) { <td title="@Str(row, key)">@Str(row, key)</td> }
                            </tr>
                        }
                    </tbody>
                </table>
                </div>

                @* Sayfa numaraları + kayıt bilgisi TABLONUN ALTINDA, SOLDA (kullanıcı isteği 2026-07-19: tüm tablolu ekranlarda). *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap" Justify="Justify.FlexStart">
                    <MudPagination Count="@_totalPages" Selected="@_page" SelectedChanged="OnPageChanged"
                                   BoundaryCount="1" MiddleCount="3" ShowFirstButton="true" ShowLastButton="true" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@_totalCount kayıt — sayfa @_page / @_totalPages</MudText>
                    <MudTooltip Text="Kolon genişliklerini (elle ayarladıklarını) sizin için kaydeder">
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Straighten" OnClick="SaveWidths">Genişlikleri kaydet</MudButton>
                    </MudTooltip>
                </MudStack>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2" Style="min-height:200px;">
            @if (_detail is null) { <MudText Class="mud-text-secondary">Detay için bir malzeme seçin.</MudText> }
            else
            {
                var d = _detail.Value;
                var did = Str(d, "id");
                <MudText Typo="Typo.h6">@Str(d, "name")</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@Str(d, "code")</MudText>
                <MudSimpleTable Dense="true" Bordered="false" Style="background:transparent">
                    <tbody>
                        <tr><td>Tür</td><td>@Str(d, "type")</td></tr>
                        <tr><td>Kategori</td><td>@Str(d, "categoryName")</td></tr>
                        <tr><td>Birim</td><td>@Str(d, "unitName")</td></tr>
                        <tr><td>Marka</td><td>@Str(d, "brandName")</td></tr>
                        <tr><td>Tedarikçi</td><td>@Str(d, "supplierName")</td></tr>
                        <tr><td>Min / Stok</td><td>@Str(d, "minStock") (min)</td></tr>
                        <tr><td>Birim Fiyat</td><td>@Str(d, "unitPrice") @Str(d, "currency")</td></tr>
                        <tr><td>Mevcut Stok</td><td><b>@Str(d, "stock")</b></td></tr>
                    </tbody>
                </MudSimpleTable>
                @if (!string.IsNullOrEmpty(Str(d, "description")))
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">Açıklama</MudText>
                    <MudText Typo="Typo.body2">@Str(d, "description")</MudText>
                }
                <MudText Typo="Typo.subtitle2" Class="mt-2">MUADİLLER</MudText>
                @foreach (var e in Arr(d, "equivalents")) { <MudText Typo="Typo.body2">• @Str(e, "name")</MudText> }
                <MudText Typo="Typo.subtitle2" Class="mt-2">UYUMLU ARAÇLAR</MudText>
                @foreach (var v in Arr(d, "compatibleVehicles")) { <MudText Typo="Typo.body2">• @Str(v, "code")</MudText> }

                <MudText Typo="Typo.subtitle2" Class="mt-2">FOTOĞRAFLAR</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap">
                    @foreach (var ph in _detailPhotos)
                    {
                        <div style="position:relative;width:72px;height:72px;margin:0 8px 8px 0;">
                            <MudImage Src="@ph.Url" Width="72" Height="72" ObjectFit="ObjectFit.Cover" Style="border-radius:6px;" />
                            @if (Auth.CanEdit("materials"))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                               Style="position:absolute;top:0;right:0;background:#99000000;" OnClick="@(() => DeletePhoto(ph.Id))" />
                            }
                        </div>
                    }
                </MudStack>

                <MudStack Row="true" Class="mt-3" Spacing="2">
                    @if (Auth.CanEdit("materials")) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => EditNav(did))">Düzenle</MudButton> }
                    @if (Auth.CanDelete("materials")) { <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteSelected">Sil</MudButton> }
                </MudStack>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
}

@code {
    [Parameter] public string? Section { get; set; }
    private bool _isNew => string.Equals(Section, "new", StringComparison.OrdinalIgnoreCase);
    private async Task EditNav(string id)
    {
        if (!await Dialog.Confirm("Bu kaydı düzenlemek istiyor musunuz?", okText: "Evet, Düzenle")) return;
        Nav.NavigateTo($"/materials/new?edit={id}");
    }

    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };
    private static readonly string[] _types = { "Yedek Parça", "Sarf Malzeme", "Hammadde", "Lastik", "Diğer" };

    private string? _editId;
    private string? _templateId;
    private List<ApiClient.Opt> _templates = new();
    private string _code = "", _name = "", _type = "Yedek Parça";
    private string? _cat, _subCat, _unit, _brand, _sup;
    private decimal _min, _price, _opening;
    private string _desc = "";
    private IReadOnlyCollection<string> _vehicleSel = new HashSet<string>();
    private ApiClient.Opt? _eqPick;
    private readonly List<ApiClient.Opt> _equivalents = new();
    private readonly List<Staged> _staged = new();
    private readonly List<PhotoRef> _detailPhotos = new();
    private sealed record Staged(string Name, byte[] Bytes, string Mime, string Preview);
    private sealed record PhotoRef(string Id, string Url);

    private List<ApiClient.Opt> _cats = new(), _subCats = new(), _units = new(), _brands = new(), _sups = new(), _vehicles = new();
    private JsonElement[]? _rows;
    private JsonElement? _detail;
    private string? _msg; private bool _ok; private bool _busy; private bool _err; private int _v;

    // ── Malzeme Listesi — kolon bazlı filtre + sayfalama (kullanıcı isteği 2026-07-17/18) ──
    private static readonly int[] PageSizes = { 25, 50, 100, 200 };
    private List<string> _visibleColumns = MaterialListColumns.DefaultVisible.ToList();
    private readonly Dictionary<string, string> _filters = new();
    private int _page = 1, _pageSize = 25, _totalCount, _totalPages = 1;   // varsayılan 25 (kullanıcı isteği)
    private string? _sortColumn; private bool _sortDesc;                    // başlığa tıklama sıralaması (madde 5)
    private Dictionary<string, int> _widths = new();                       // kişisel kolon genişlikleri (madde 3)

    private string GetFilter(string key) => _filters.TryGetValue(key, out var v) ? v : "";
    private void SetFilter(string key, string v) => _filters[key] = v ?? "";
    private static string Label(string key) => MaterialListColumns.All.FirstOrDefault(c => c.Key == key)?.Label ?? key;
    private static bool IsNumeric(string key) => MaterialListColumns.All.FirstOrDefault(c => c.Key == key)?.IsNumeric ?? false;

    private string ThStyle(string key) => _widths.TryGetValue(key, out var w) && w > 0 ? $"width:{w}px;" : "width:140px;";
    private string SortArrow(string key) => _sortColumn == key ? (_sortDesc ? "▼" : "▲") : "";
    private async Task ToggleSort(string key)
    {
        // Aynı kolona tekrar tık: A→Z → Z→A → sıralama yok. Farklı kolon: A→Z.
        if (_sortColumn != key) { _sortColumn = key; _sortDesc = false; }
        else if (!_sortDesc) { _sortDesc = true; }
        else { _sortColumn = null; _sortDesc = false; }
        _page = 1; await Load();
    }

    private async Task SaveWidths()
    {
        try
        {
            var w = await JS.InvokeAsync<Dictionary<string, int>>("dwReadColWidths", "materials-grid");
            if (w is { Count: > 0 }) { _widths = w; await Api.SaveWidthsAsync("materials", w); }
        }
        catch { }
    }

    private async Task ApplyFilters() { _page = 1; await Load(); }
    private async Task ClearFilters() { _filters.Clear(); _page = 1; await Load(); }
    private async Task OnFilterKey(KeyboardEventArgs e) { if (e.Key == "Enter") await ApplyFilters(); }
    private async Task OnPageChanged(int p) { _page = p; await Load(); }
    private async Task OnPageSizeChanged(int sz) { _pageSize = sz; _page = 1; await Api.SavePageSizeAsync("materials", sz); await Load(); }

    private async Task OpenColumnPicker()
    {
        var parameters = new DialogParameters { ["Available"] = MaterialListColumns.All.ToList(), ["Selected"] = _visibleColumns };
        var dlg = await Dialog.ShowAsync<ColumnPickerDialog>("Kolonları Ayarla", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dlg.Result;
        if (result is null || result.Canceled || result.Data is not List<string> chosen) return;
        _visibleColumns = chosen;
        await Api.SaveListColumnsAsync("materials", _visibleColumns);
        await Load();
    }

    protected override async Task OnInitializedAsync()
    {
        if (_isNew && Auth.CanCreate("materials"))
        {
            _cats = await Api.OptionsAsync("/api/lookups/material_categories", "id", "name");
            _units = await Api.OptionsAsync("/api/lookups/units", "id", "name");
            _brands = await Api.OptionsAsync("/api/lookups/brands", "id", "name");
            _sups = await Api.OptionsAsync("/api/lookups/suppliers", "id", "name");
            _vehicles = await Api.OptionsAsync("/api/vehicles", "id", "display");
            try { _templates = await Api.OptionsAsync("/api/material-templates", "id", "name"); } catch { }
            // Liste ekranından "Düzenle" ile gelindiyse (?edit=id) kaydı forma yükle
            var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
            if (q.TryGetValue("edit", out var eid) && !string.IsNullOrEmpty(eid))
            {
                try { _detail = await Api.GetObjectAsync($"/api/materials/{eid}"); await BeginEdit(); } catch { }
            }
        }
        if (!_isNew)
        {
            var saved = await Api.GetListColumnsAsync("materials");
            if (saved is { Count: > 0 }) _visibleColumns = saved;
            var (ps, widths) = await Api.GetListPrefsAsync("materials");
            if (ps is > 0) _pageSize = ps.Value;               // değiştirmediyse null → 25 kalır
            if (widths is { Count: > 0 }) _widths = widths;
            await Load();
        }
    }

    private string? _lastCat;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (_cat != _lastCat)
        {
            _lastCat = _cat; if (_suppressSub) { _suppressSub = false; }
            else _subCat = null;
            _subCats = string.IsNullOrEmpty(_cat) ? new()
                : await Api.OptionsAsync($"/api/materials/subcategories?parentId={_cat}", "id", "name");
            StateHasChanged();
        }
    }
    private bool _suppressSub;

    private async Task Load()
    {
        _rows = null;
        var qs = new List<string> { $"page={_page}", $"pageSize={_pageSize}" };
        qs.AddRange(BuildFilterSortQs());
        var grid = await Api.GetGridAsync("/api/materials/grid?" + string.Join("&", qs));
        _rows = grid.Items; _totalCount = grid.TotalCount; _page = grid.Page; _pageSize = grid.PageSize; _totalPages = grid.TotalPages;
    }

    /// <summary>Sıralama + kolon filtreleri — sayfalamasız (Load VE ExportExcel PAYLAŞIR; ikisi de AYNI
    /// aktif filtrelerle çalışsın istiyoruz, kullanıcı isteği 2026-07-19).</summary>
    private List<string> BuildFilterSortQs()
    {
        var qs = new List<string>();
        if (_sortColumn is not null) { qs.Add($"sort={_sortColumn}"); qs.Add($"desc={(_sortDesc ? "true" : "false")}"); }
        foreach (var (k, v) in _filters)
            if (!string.IsNullOrWhiteSpace(v)) qs.Add($"{k}={Uri.EscapeDataString(v.Trim())}");
        return qs;
    }

    private bool _exporting;
    /// <summary>"Excel'e Aktar" (kullanıcı isteği 2026-07-19): AKTİF filtrelerle eşleşen TÜM sonuçları
    /// (sayfalama sınırı olmadan) indirir — o an ekrandaki sayfayı değil.</summary>
    private async Task ExportExcel()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var qs = string.Join("&", BuildFilterSortQs());
            var (bytes, fileName) = await Api.GetFileAsync("/api/materials/grid/export" + (qs.Length > 0 ? "?" + qs : ""), "Malzemeler.xlsx");
            if (bytes is not null)
                await JS.InvokeVoidAsync("dwDownload", fileName, Convert.ToBase64String(bytes),
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _exporting = false; }
    }

    private async Task<IEnumerable<ApiClient.Opt>> SearchMaterial(string? t, CancellationToken ct)
        => await Api.OptionsAsync("/api/materials" + (string.IsNullOrWhiteSpace(t) ? "" : $"?search={Uri.EscapeDataString(t)}"), "id", "name");

    private void AddEquivalent()
    {
        if (_eqPick is null || _equivalents.Any(x => x.Id == _eqPick.Id)) return;
        _equivalents.Add(_eqPick); _eqPick = null;
    }

    private async Task ReloadCats(string _) => _cats = await Api.OptionsAsync("/api/lookups/material_categories", "id", "name");
    // Alt kategori "+" sonrası: seçili kategorinin alt kategorilerini tazele + yeni ekleneni seç.
    private async Task ReloadSubCats(string name)
    {
        if (string.IsNullOrEmpty(_cat)) return;
        _subCats = await Api.OptionsAsync($"/api/materials/subcategories?parentId={_cat}", "id", "name");
        var added = _subCats.FirstOrDefault(o => string.Equals(o.Name, name?.Trim(), StringComparison.OrdinalIgnoreCase));
        if (added is not null) _subCat = added.Id;
    }
    private async Task ReloadUnits(string _) => _units = await Api.OptionsAsync("/api/lookups/units", "id", "name");
    private async Task ReloadBrands(string _) => _brands = await Api.OptionsAsync("/api/lookups/brands", "id", "name");
    private async Task ReloadSups(string _) => _sups = await Api.OptionsAsync("/api/lookups/suppliers", "id", "name");

    private async Task OnFiles(InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(10))
        {
            using var ms = new MemoryStream();
            await f.OpenReadStream(8 * 1024 * 1024).CopyToAsync(ms);
            var bytes = ms.ToArray();
            var mime = f.ContentType;
            if (string.IsNullOrEmpty(mime) || mime == "application/octet-stream") mime = GuessMime(f.Name);
            _staged.Add(new Staged(f.Name, bytes, mime, $"data:{mime};base64,{Convert.ToBase64String(bytes)}"));
        }
    }

    private async Task OpenDetail(string id)
    {
        if (string.IsNullOrEmpty(id)) return;
        try { _detail = await Api.GetObjectAsync($"/api/materials/{id}"); }
        catch { _detail = null; }
        await LoadDetailPhotos(id);
    }

    /// <summary>Çift tık: ayrı pencerede Düzelt/Kaydet/Sil (kullanıcı isteği 2026-07-19). Kaydedilir/silinirse
    /// liste yenilenir; açık detay paneli de tazelenir.</summary>
    private async Task OpenQuickEdit(string id)
    {
        if (string.IsNullOrEmpty(id)) return;
        var pars = new DialogParameters { ["Id"] = id };
        var dlg = await Dialog.ShowAsync<MaterialEditDialog>("Malzeme", pars,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var res = await dlg.Result;
        if (res is null || res.Canceled) return;
        await Load();
        if (res.Data as string == "deleted") _detail = null;
        else if (_detail is not null && Str(_detail.Value, "id") == id) await OpenDetail(id);
    }

    private async Task LoadDetailPhotos(string id)
    {
        _detailPhotos.Clear();
        try
        {
            var arr = await Api.GetArrayAsync($"/api/materials/{id}/photos");
            foreach (var p in arr)
            {
                var url = await Api.GetImageDataUrlAsync(Str(p, "url"));
                if (url is not null) _detailPhotos.Add(new PhotoRef(Str(p, "id"), url));
            }
        }
        catch { }
    }

    private async Task DeletePhoto(string fileId)
    {
        if (_detail is null) return;
        var id = Str(_detail.Value, "id");
        if (!await Dialog.Confirm("Bu fotoğraf silinsin mi?", "Evet, Sil", danger: true)) return;
        await Api.DeleteAsync($"/api/materials/{id}/photos/{fileId}");
        await LoadDetailPhotos(id);
    }

    private async Task BeginEdit()
    {
        if (_detail is null) return;
        var d = _detail.Value;
        _editId = Str(d, "id");
        _code = Str(d, "code"); _name = Str(d, "name"); _type = string.IsNullOrEmpty(Str(d, "type")) ? "Yedek Parça" : Str(d, "type");
        _cat = NullId(d, "categoryId"); _unit = NullId(d, "unitId"); _brand = NullId(d, "brandId"); _sup = NullId(d, "supplierId");
        _min = Dec(d, "minStock"); _price = Dec(d, "unitPrice"); _desc = Str(d, "description");
        _vehicleSel = new HashSet<string>(Arr(d, "compatibleVehicles").Select(v => Str(v, "id")).Where(x => x != ""));
        _equivalents.Clear();
        foreach (var e in Arr(d, "equivalents")) _equivalents.Add(new ApiClient.Opt(Str(e, "id"), Str(e, "name")));
        _msg = null;
        await Task.CompletedTask;
    }

    private async Task DeleteSelected()
    {
        if (_detail is null) return;
        var id = Str(_detail.Value, "id");
        if (!await Dialog.Confirm("Bu malzeme silinsin mi?", "Evet, Sil", danger: true)) return;
        var err = await Api.DeleteAsync($"/api/materials/{id}");
        _msg = err ?? "Silindi."; _ok = err is null;
        if (_ok) { _detail = null; await Load(); }
    }

    /// <summary>Şablon seçilince malzeme formunu önden doldurur (örnek kayıt).</summary>
    private async Task ApplyTemplate(string? id)
    {
        _templateId = id;
        if (string.IsNullOrEmpty(id)) return;
        try
        {
            var t = await Api.GetObjectAsync($"/api/material-templates/{id}");
            _code = Str(t, "code"); if (!string.IsNullOrEmpty(Str(t, "name"))) _name = Str(t, "name");
            var tp = Str(t, "type"); if (!string.IsNullOrEmpty(tp)) _type = tp;
            _cat = NullId(t, "categoryId"); _unit = NullId(t, "unitId"); _brand = NullId(t, "brandId"); _sup = NullId(t, "supplierId");
            _min = Dec(t, "minStock"); _price = Dec(t, "unitPrice"); _desc = Str(t, "description");
        }
        catch { }
    }

    private async Task Save()
    {
        _err = true; _msg = null;
        // "Tüm Şubeler" modunda yazma yok: açılış stoğu hareketi şubesiz düşerdi (hangi şantiyeye ait olduğu kaybolur).
        if (!await Dialog.RequireBranchAsync(Auth, "Malzemeler")) return;
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name)) { _msg = "Kod ve ad zorunlu."; _ok = false; return; }
        if (string.IsNullOrEmpty(_unit)) { _msg = "Birim seçin."; _ok = false; return; }
        // Şablon dışı kayıt uyarısı (yalnız yeni kayıt + şablon seçilmemişse) — tek tip kayıt için.
        if (_editId is null && string.IsNullOrEmpty(_templateId))
        {
            if (!await Dialog.Confirm("Ana Yetkiliye Bilgi verilmelidir! Şablon dışı kayıt girmektesiniz!\n\nYine de devam edilsin mi?", "Evet, Devam Et", danger: true)) return;
        }
        else if (!await Dialog.Confirm(_editId is null ? "Malzeme kaydedilsin mi?" : "Malzeme güncellensin mi?")) return;
        _busy = true;
        try
        {
            var body = new
            {
                code = _code.Trim(), name = _name.Trim(), type = string.IsNullOrWhiteSpace(_type) ? null : _type,
                categoryId = string.IsNullOrEmpty(_subCat) ? Empty(_cat) : _subCat,
                unitId = Empty(_unit), brandId = Empty(_brand), supplierId = Empty(_sup),
                minStock = _min, unitPrice = _price, description = Empty(_desc), openingStock = _opening,
                vehicleIds = _vehicleSel.ToList(), equivalentIds = _equivalents.Select(e => e.Id).ToList()
            };
            string? err; string? savedId;
            if (_editId is null)
            {
                (err, savedId) = await Api.CreateAsync("/api/materials", body);
            }
            else
            {
                err = await Api.PutAsync($"/api/materials/{_editId}", body);
                savedId = _editId;
            }
            // Bekleyen fotoğrafları oluşan/güncellenen kayda yükle
            if (err is null && savedId is not null && _staged.Count > 0)
                await Api.UploadFilesAsync($"/api/materials/{savedId}/photos", _staged.Select(p => (p.Name, p.Bytes, p.Mime)));

            _ok = err is null; _msg = err ?? (_editId is null ? "Malzeme eklendi." : "Malzeme güncellendi.");
            if (_ok) { Clear(); Nav.NavigateTo("/materials"); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private void Clear()
    {
        _err = false; _editId = null; _code = _name = ""; _type = "Yedek Parça";
        _cat = _subCat = _unit = _brand = _sup = null; _min = _price = _opening = 0; _desc = "";
        _vehicleSel = new HashSet<string>(); _equivalents.Clear(); _eqPick = null; _staged.Clear();
    }

    private static string GuessMime(string name)
    {
        var ext = System.IO.Path.GetExtension(name).ToLowerInvariant();
        return ext switch { ".png" => "image/png", ".gif" => "image/gif", ".webp" => "image/webp", ".bmp" => "image/bmp", _ => "image/jpeg" };
    }

    private static string? Empty(string? v) => string.IsNullOrEmpty(v) ? null : v;
    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static string? NullId(JsonElement row, string key) { var s = Str(row, key); return string.IsNullOrEmpty(s) ? null : s; }
    private static decimal Dec(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0;
    private static IEnumerable<JsonElement> Arr(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Array
            ? v.EnumerateArray() : Enumerable.Empty<JsonElement>();
}
