@page "/permission-templates"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5">Yetki Şablonları (Süper Admin)</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

@if (Auth.CanCreate("permission_templates"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:760px;">
        <MudText Typo="Typo.h6" Class="mb-2">Yeni Şablon</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_name" Label="Şablon Adı *" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" Value="_companyId" ValueChanged="OnCompanyChanged" Label="Firma *"
                           HelperText="Şablon bu firmaya tanımlanır. 'Tüm Firmalar' → tüm firmalarda listelenir." Margin="Margin.Dense" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@_allCompanies">Tüm Firmalar</MudSelectItem>
                    @foreach (var c in _companies) { <MudSelectItem T="string" Value="@c.Id">@c.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_roleKey" Label="Rol (opsiyonel)" HelperText="Şablon seçilince kullanıcıya bu rol de atanır." Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var r in _roles) { <MudSelectItem T="string" Value="@r.Key">@r.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.subtitle2" Class="mt-2">Yetkiler (@(_companyId == _allCompanies ? "tüm firmalar için admine açık" : "seçilen firmada admine açık"))</MudText>
        @if (_viewedName is not null) { <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">Görüntülenen şablon: <b>@_viewedName</b> — düzenleyip yeni ad ile kaydedebilirsiniz.</MudAlert> }
        <PermMatrix @ref="_matrix" Modules="_modules" AdminOnly="_adminOnly" Buttons="_buttons" />
        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" OnClick="Create" Disabled="_busy">@(_busy ? "…" : "Şablonu Kaydet")</MudButton>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">Şablonlar</MudText><MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadList">Yenile</MudButton>
    </MudStack>
    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Şablon yok.</MudText> }
    else
    {
        <MudTable Items="_rows" Dense="true" Hover="true" Striped="true">
            <HeaderContent><MudTh>Ad</MudTh><MudTh>Kapsam</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                @{ var id = Str(context, "id"); var nm = Str(context, "name"); }
                <MudTd>@nm</MudTd>
                <MudTd>@Str(context, "scopeText")</MudTd>
                <MudTd>
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" OnClick="@(() => ViewTemplate(id, nm))" />
                    @if (Auth.CanDelete("permission_templates"))
                    {
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => Delete(id))" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };
    private const string _allCompanies = "";   // "Tüm Firmalar" seçimi
    private string _name = "";
    private string? _roleKey;
    private string _companyId = _allCompanies;
    private List<ApiClient.Opt> _companies = new();
    private List<RoleDto> _roles = new();
    private List<ApiClient.Opt> _modules = new(), _buttons = new();
    private HashSet<string> _adminOnly = new();
    private PermMatrix? _matrix;
    private JsonElement[]? _rows;
    private string? _msg; private bool _ok; private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try { _companies = await Api.OptionsAsync("/api/companies", "id", "name"); } catch { }
        try { _buttons = await Api.OptionsAsync("/api/buttons", "key", "label"); } catch { }
        try { _roles = await Api.GetRolesAsync(); } catch { }
        // ⭐ YET-C4: ilk yükleme çağrıları korumasız bırakılmaz — sunucu 401/500 dönerse istisna
        // render sırasında patlar ve Blazor devresi TAMAMEN düşer ("bağlantı kesildi", bembeyaz ekran).
        try
        {
            await LoadModules();
            await LoadList();
        }
        catch (Exception ex) { _ok = false; _msg = "Ekran yüklenemedi: " + ex.Message; }
    }

    /// <summary>Seçilen firmanın admine açık modüllerini ağaca yükler (firma yok → tüm firmalar).</summary>
    private async Task LoadModules()
    {
        _modules = new(); _adminOnly = new();
        var url = string.IsNullOrEmpty(_companyId) ? "/api/permission-templates/modules" : $"/api/permission-templates/modules?companyId={_companyId}";
        try
        {
            foreach (var e in await Api.GetArrayAsync(url))
            {
                var key = MS(e, "key"); if (key == "") continue;
                _modules.Add(new ApiClient.Opt(key, MS(e, "label")));
                if (e.TryGetProperty("adminOnly", out var a) && a.ValueKind == JsonValueKind.True) _adminOnly.Add(key);
            }
        }
        catch { }
    }

    private async Task OnCompanyChanged(string value)
    {
        _companyId = value ?? _allCompanies;
        _viewedName = null; _matrix?.Clear();
        await LoadModules();
    }

    private async Task LoadList() { _rows = null; try { _rows = await Api.GetArrayAsync("/api/permission-templates"); } catch { _rows = Array.Empty<JsonElement>(); } }

    private async Task Create()
    {
        _msg = null;
        if (string.IsNullOrWhiteSpace(_name)) { _msg = "Şablon adı zorunlu."; _ok = false; return; }
        if (!await Dialog.Confirm("Şablon oluşturulsun mu?")) return;
        _busy = true;
        try
        {
            bool scopeAll = string.IsNullOrEmpty(_companyId);
            var err = await Api.PostAsync("/api/permission-templates", new { name = _name.Trim(), roleKey = _roleKey, modules = _matrix?.Collect() ?? new(), buttons = _matrix?.CollectButtons() ?? new(), companyId = scopeAll ? null : _companyId, scopeAll });
            _ok = err is null; _msg = err ?? "Şablon oluşturuldu.";
            if (_ok) { _name = ""; _roleKey = null; _viewedName = null; _matrix?.Clear(); await LoadList(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private string? _viewedName;

    /// <summary>Kaydedilmiş şablonun yetkilerini matriste gösterir (#11 — şablon yetkileri artık görünür).</summary>
    private async Task ViewTemplate(string id, string name)
    {
        if (string.IsNullOrEmpty(id) || _matrix is null) return;
        try
        {
            var doc = await Api.GetObjectAsync($"/api/permission-templates/{id}");
            var list = new List<(string, bool, bool, bool, bool)>();
            if (doc.TryGetProperty("modules", out var mods) && mods.ValueKind == JsonValueKind.Array)
                foreach (var m in mods.EnumerateArray())
                    list.Add((MS(m, "moduleKey"), MB(m, "canView"), MB(m, "canCreate"), MB(m, "canEdit"), MB(m, "canDelete")));
            _matrix.LoadFrom(list);
            var btnKeys = new List<string>();
            if (doc.TryGetProperty("buttons", out var btns) && btns.ValueKind == JsonValueKind.Array)
                foreach (var b in btns.EnumerateArray())
                    if (b.ValueKind == JsonValueKind.String) btnKeys.Add(b.GetString() ?? "");
            _matrix.LoadButtons(btnKeys);
            if (doc.TryGetProperty("roleKey", out var rk) && rk.ValueKind == JsonValueKind.String) _roleKey = rk.GetString();
            _viewedName = name; _msg = null;
        }
        catch (Exception ex) { _msg = "Yüklenemedi: " + ex.Message; _ok = false; }
    }

    private static string MS(JsonElement e, string k) => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
    private static bool MB(JsonElement e, string k) => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.True;

    private async Task Delete(string id)
    {
        if (string.IsNullOrEmpty(id)) return;
        if (!await Dialog.Confirm("Bu şablon silinsin mi?", "Evet, Sil", danger: true)) return;
        var err = await Api.DeleteAsync($"/api/permission-templates/{id}");
        _msg = err ?? "Silindi."; _ok = err is null;
        await LoadList();
    }

    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
}
