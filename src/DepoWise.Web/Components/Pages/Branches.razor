@page "/branches"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<MudText Typo="Typo.h5" GutterBottom="true">Şube / Şantiye Tanım</MudText>

@if (Auth.CanCreate("branches"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:600px;">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@(_editId is null ? "YENİ ŞUBE" : "ŞUBE DÜZENLE")</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="7"><MudTextField @bind-Value="_name" Label="Ad *" Error="_err && string.IsNullOrWhiteSpace(_name)" ErrorText="Ad zorunlu." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="6" md="5">
                <MudSelect T="string" @bind-Value="_kind" Label="Tür" Margin="Margin.Dense" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("branch")">Şube</MudSelectItem>
                    <MudSelectItem T="string" Value="@("site")">Şantiye</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="6"><MudTextField @bind-Value="_code" Label="Şube Kodu" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="6" md="6"><MudTextField @bind-Value="_password" Label="@(_editId is null ? "Şube Şifresi" : "Yeni Şifre (boş = değişmez)")" InputType="InputType.Password" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12">
                <LookupSelect Label="Üst Şube" @bind-Value="_parent" Items="_parentOptions"
                              CreatePath="/api/branches" CreateField="name" ExtraField="kind" ExtraValue="branch"
                              OnAdded="ReloadAfterAdd" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Boş = en üst seviye. Kod + şifre login'de şube seçimi için kullanılır.</MudText>
            </MudItem>
        </MudGrid>
        <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="Clear">İptal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_busy">Kaydet</MudButton>
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

<MudGrid Spacing="2">
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2"><MudText Typo="Typo.h6">Şube / Şantiye</MudText><MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Load">Yenile</MudButton></MudStack>
            @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
            else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Henüz şube/şantiye tanımlanmadı.</MudText> }
            else
            {
                <MudTable Items="_rows" Dense="true" Hover="true" Striped="true" OnRowClick="@(e => OpenDetail(e.Item))" T="JsonElement">
                    <HeaderContent><MudTh>AD</MudTh><MudTh>KOD</MudTh><MudTh>ŞİFRE</MudTh><MudTh>TÜR</MudTh><MudTh>ÜST ŞUBE</MudTh><MudTh>KULLANICI</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd>@Str(context, "name")</MudTd>
                        <MudTd>@Str(context, "codeDisplay")</MudTd>
                        <MudTd>@Str(context, "passwordDisplay")</MudTd>
                        <MudTd>@Str(context, "kindDisplay")</MudTd>
                        <MudTd>@Str(context, "parentDisplay")</MudTd>
                        <MudTd>@Str(context, "userCount")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2" Style="min-height:160px;">
            @if (_detail is null) { <MudText Class="mud-text-secondary">Detay için bir şube seçin.</MudText> }
            else
            {
                var dd = _detail.Value;
                <MudText Typo="Typo.h6">@Str(dd, "name")</MudText>
                <MudStack Row="true" Class="mt-1" Spacing="2">
                    @if (Auth.CanEdit("branches")) { <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => BeginEdit(dd))">Düzenle</MudButton> }
                    @if (Auth.CanDelete("branches")) { <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => Delete(Str(dd,"id")))">Sil</MudButton> }
                </MudStack>
                <MudText Typo="Typo.subtitle2" Class="mt-3">ŞUBEDEKİ KULLANICILAR</MudText>
                @if (_branchUsers.Length == 0) { <MudText Typo="Typo.caption" Class="mud-text-secondary">Bu şubeye atanmış kullanıcı yok. Atama 'Kullanıcılar' ekranından yapılır.</MudText> }
                else
                {
                    @foreach (var u in _branchUsers)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <div><MudText Typo="Typo.body2">@Str(u, "fullName")</MudText><MudText Typo="Typo.caption" Class="mud-text-secondary">@Str(u, "username")</MudText></div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Str(u, "roles")</MudText>
                        </MudStack>
                    }
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };
    private string? _editId, _parent;
    private string _name = "", _kind = "branch", _code = "", _password = "";
    private List<ApiClient.Opt> _parentOptions = new();
    private JsonElement[]? _rows;
    private JsonElement? _detail;
    private JsonElement[] _branchUsers = Array.Empty<JsonElement>();
    private string? _msg; private bool _ok; private bool _busy; private bool _err;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _rows = null;
        try { _rows = await Api.GetArrayAsync("/api/branches"); } catch { _rows = Array.Empty<JsonElement>(); }
        _parentOptions = (_rows ?? Array.Empty<JsonElement>()).Where(r => Str(r, "id") != _editId)
            .Select(r => new ApiClient.Opt(Str(r, "id"), Str(r, "name"))).ToList();
    }

    private async Task ReloadAfterAdd(string _) => await Load();

    private async Task OpenDetail(JsonElement row)
    {
        _detail = row;
        try { _branchUsers = await Api.GetArrayAsync($"/api/branches/{Str(row, "id")}/users"); } catch { _branchUsers = Array.Empty<JsonElement>(); }
    }

    private void BeginEdit(JsonElement d)
    {
        _editId = Str(d, "id"); _name = Str(d, "name"); _kind = string.IsNullOrEmpty(Str(d, "kind")) ? "branch" : Str(d, "kind");
        _code = Str(d, "code"); _password = "";
        _parent = NullS(d, "parentId"); _msg = null;
        _parentOptions = (_rows ?? Array.Empty<JsonElement>()).Where(r => Str(r, "id") != _editId).Select(r => new ApiClient.Opt(Str(r, "id"), Str(r, "name"))).ToList();
    }

    private async Task Save()
    {
        _err = true; _msg = null;
        if (string.IsNullOrWhiteSpace(_name)) { _msg = "Ad zorunlu."; _ok = false; return; }
        if (!await Dialog.Confirm(_editId is null ? "Şube eklensin mi?" : "Şube güncellensin mi?")) return;
        _busy = true;
        try
        {
            var body = new { name = _name.Trim(), kind = _kind, parentId = _parent, code = _code, password = _password };
            var err = _editId is null ? await Api.PostAsync("/api/branches", body) : await Api.PutAsync($"/api/branches/{_editId}", body);
            _ok = err is null; _msg = err ?? (_editId is null ? "Eklendi." : "Güncellendi.");
            if (_ok) { Clear(); await Load(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task Delete(string id)
    {
        if (string.IsNullOrEmpty(id)) return;
        if (!await Dialog.Confirm("Bu şube silinsin mi?", "Evet, Sil", danger: true)) return;
        var err = await Api.DeleteAsync($"/api/branches/{id}");
        _msg = err ?? "Silindi."; _ok = err is null; _detail = null; await Load();
    }

    private void Clear() { _err = false; _editId = null; _name = ""; _kind = "branch"; _parent = null; _code = ""; _password = ""; }

    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static string? NullS(JsonElement row, string key) { var s = Str(row, key); return string.IsNullOrEmpty(s) ? null : s; }
}
