@page "/personnel"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<MudText Typo="Typo.h5" GutterBottom="true">Personel</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="max-width:70ch;">
    Kişi uygulamaya girecekse, önce <b>“Kullanıcılar”</b> ekranından hesabını açın; sonra bu formdan
    <b>“Mevcut kullanıcıyı bağla”</b> ile o hesabı bu personele bağlarsınız (bir personele <b>tek</b> hesap).
    Uygulamaya girmeyecek kişiler için <b>“Saha personeli”</b> kutucuğunu işaretleyin.
</MudText>

@if (Auth.CanCreate("personnel"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:720px;">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@(_editId is null ? "YENİ ÇALIŞAN" : "ÇALIŞAN DÜZENLE")</MudText>

        @if (_dups.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                <b>Olası aynı kişi:</b> @string.Join(" · ", _dups.Select(DupLabel)) başka kayıtta var.
                Aynı kişiyse kaydı açıp düzenleyin (Vazgeç); farklı kişiyse kaydı sürdürün.
            </MudAlert>
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_name" @bind-Value:after="OnKeyFieldsChanged" Label="Ad Soyad *" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>

            @* Unvan: SABİT TANIM listesinden seçilir; "+" ile yeni tanım eklenir. *@
            <MudItem xs="12" md="6">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <div style="flex:1"><LookupSelect Label="Unvan" @bind-Value="_title" Items="_titles" /></div>
                    @if (Auth.CanCreate("personnel"))
                    {
                        <MudTooltip Text="Yeni unvan tanımı ekle">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Outlined"
                                           Color="Color.Primary" OnClick="@(() => _addTitle = !_addTitle)" />
                        </MudTooltip>
                    }
                </MudStack>
                @if (_addTitle)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                        <MudTextField @bind-Value="_newTitle" Label="Yeni unvan" Margin="Margin.Dense" Variant="Variant.Outlined"
                                      UserAttributes="_noAuto" Immediate="true" />
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTitle">Ekle</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CancelAddTitle">Vazgeç</MudButton>
                    </MudStack>
                }
            </MudItem>

            <MudItem xs="6" md="4"><MudTextField @bind-Value="_phone" @bind-Value:after="OnKeyFieldsChanged" Label="Telefon" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="6" md="4"><LookupSelect Label="Şube" @bind-Value="_branch" Items="_branches" /></MudItem>
            <MudItem xs="6" md="2" Class="d-flex align-center"><MudCheckBox T="bool" @bind-Value="_active" Label="Aktif" Dense="true" /></MudItem>
            <MudItem xs="6" md="2" Class="d-flex align-center">
                <MudTooltip Text="İşaretlenirse bu kişi uygulamaya girmez; kullanıcı bağlanmadı uyarısı çıkmaz.">
                    <MudCheckBox T="bool" @bind-Value="_fieldStaff" @bind-Value:after="OnFieldStaffChanged" Label="Saha personeli" Dense="true" />
                </MudTooltip>
            </MudItem>
        </MudGrid>

        @* ── Uygulama erişimi: MEVCUT kullanıcıyı bağla (hesap açma yok — hesaplar "Kullanıcılar" ekranında açılır) ── *@
        @if (Auth.IsAdmin)
        {
            @if (_hasAccount)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                    Bu personele bağlı uygulama hesabı: <b>@_accountUsername</b> (@(_accountAdmin ? "Firma Admini" : "Personel")).
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="RemoveAccount">Bağı Kaldır</MudButton>
                </MudAlert>
            }
            else if (!_fieldStaff)
            {
                <div class="mt-2">
                    <MudSwitch T="bool" @bind-Value="_grantAccess" Color="Color.Primary" Label="Mevcut kullanıcıyı bağla" />
                </div>
                @if (_grantAccess)
                {
                    @if (_linkableUsers.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                            Bağlanabilir (henüz bir personele bağlı olmayan) kullanıcı yok. Önce <b>“Kullanıcılar”</b> ekranından hesap açın.
                        </MudAlert>
                    }
                    else
                    {
                        <MudGrid Spacing="2" Class="mt-0">
                            <MudItem xs="12" md="8">
                                <MudSelect T="string" @bind-Value="_linkUserId" Label="Bağlanacak kullanıcı *" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                                    @foreach (var u in _linkableUsers)
                                    {
                                        <MudSelectItem T="string" Value="@u.Id">@u.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Yalnız henüz bir personele bağlı olmayan kullanıcılar listelenir. Ekran yetkileri “Yetkiler” ekranından ayarlanır.</MudText>
                    }
                }
            }
        }

        <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="Clear">İptal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_busy">Kaydet</MudButton>
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2">
        <MudText Typo="Typo.h6">Personel Listesi</MudText><MudSpacer />
        <MudTextField @bind-Value="_q" Placeholder="Ara (ad / unvan / telefon)" Immediate="true"
                      Margin="Margin.Dense" Variant="Variant.Outlined" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:320px" Clearable="true" />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadList">Yenile</MudButton>
    </MudStack>
    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Henüz personel yok.</MudText> }
    else
    {
        <MudTable Items="Filtered" Dense="true" Hover="true" Striped="true" T="JsonElement">
            <HeaderContent><MudTh>AD SOYAD</MudTh><MudTh>UNVAN</MudTh><MudTh>TELEFON</MudTh><MudTh>ERİŞİM</MudTh><MudTh>DURUM</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                @{ var id = Str(context, "id"); var hasAcc = Bool(context, "hasAccount"); }
                <MudTd>@Str(context, "fullName")</MudTd>
                <MudTd>@Str(context, "title")</MudTd>
                <MudTd>@Str(context, "phone")</MudTd>
                <MudTd>
                    @if (hasAcc)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@(Bool(context, "accountAdmin") ? Color.Info : Color.Success)">
                            @(Bool(context, "accountAdmin") ? "Admin" : "Kullanıcı") · @Str(context, "username")
                        </MudChip>
                    }
                    else if (Bool(context, "isFieldStaff"))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Saha personeli</MudChip>
                    }
                    else
                    {
                        <MudTooltip Text="Kullanıcı bağlı değil ve saha personeli olarak da işaretlenmemiş.">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Kullanıcı yok</MudChip>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd>@(Bool(context, "isActive") ? "Aktif" : "Pasif")</MudTd>
                <MudTd>
                    @if (Auth.CanEdit("personnel")) { <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => BeginEdit(context))">Düzenle</MudButton> }
                    @if (Auth.CanDelete("personnel")) { <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => Delete(id))">Sil</MudButton> }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };
    private string? _editId;
    private string _name = "", _phone = "";
    private string? _title;                 // unvan: sabit tanım listesinden seçilir
    private string? _branch;
    private bool _active = true;
    private bool _fieldStaff;               // "Saha personeli" — işaretliyse kullanıcı-bağlı uyarısı çıkmaz
    private List<ApiClient.Opt> _branches = new();
    private List<ApiClient.Opt> _titles = new();
    private bool _addTitle; private string _newTitle = "";   // "+" ile yeni unvan tanımı
    private JsonElement[]? _rows;
    private string _q = "";
    private string? _msg; private bool _ok; private bool _busy;

    // Uygulama erişimi: MEVCUT kullanıcıyı bağla (hesap açma yok) + bağlı hesap bilgisi + mükerrer
    private bool _grantAccess;
    private string? _linkUserId;                       // bağlanacak mevcut kullanıcı
    private List<ApiClient.LinkableUser> _linkableUsers = new();
    private bool _hasAccount, _accountAdmin; private string _accountUsername = "";
    private List<JsonElement> _dups = new();
    private bool _dupAck;

    private IEnumerable<JsonElement> Filtered
    {
        get
        {
            if (_rows is null) return Array.Empty<JsonElement>();
            var q = _q?.Trim() ?? "";
            if (q.Length == 0) return _rows;
            bool Has(JsonElement r, string k) => Str(r, k).Contains(q, StringComparison.OrdinalIgnoreCase);
            return _rows.Where(r => Has(r, "fullName") || Has(r, "title") || Has(r, "phone"));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CanCreate("personnel"))
        {
            _branches = await Api.OptionsAsync("/api/branches", "id", "name");
            await LoadTitles();
        }
        if (Auth.IsAdmin) await LoadLinkableUsers();
        await LoadList();
    }

    private async Task LoadList() { _rows = null; try { _rows = await Api.GetArrayAsync("/api/personnel"); } catch { _rows = Array.Empty<JsonElement>(); } }

    // Bağlanabilir (henüz bir personele bağlı olmayan) kullanıcılar — "mevcut kullanıcıyı bağla" listesi.
    private async Task LoadLinkableUsers()
    {
        try { _linkableUsers = await Api.GetLinkableUsersAsync(); }
        catch { _linkableUsers = new(); }
    }

    // Unvan tanımları — değer olarak ADI kullanılır (personnel.title metin saklar).
    private async Task LoadTitles()
    {
        try { _titles = await Api.OptionsAsync("/api/personnel-titles", "name", "name"); }
        catch { _titles = new(); }
    }

    private void CancelAddTitle() { _addTitle = false; _newTitle = ""; }

    /// <summary>"Saha personeli" işaretlenirse kullanıcı bağlama kapanır (kişi uygulamaya girmeyecek).</summary>
    private void OnFieldStaffChanged()
    {
        if (_fieldStaff) { _grantAccess = false; _linkUserId = null; }
    }

    // "+" — yeni unvan tanımı ekler ve seçili hale getirir.
    private async Task AddTitle()
    {
        var name = _newTitle?.Trim() ?? "";
        if (name.Length == 0) { _msg = "Unvan adı boş olamaz."; _ok = false; return; }
        var err = await Api.PostAsync("/api/personnel-titles", new { name });
        if (err is not null) { _msg = "Unvan eklenemedi: " + err; _ok = false; return; }
        await LoadTitles();
        _title = name;              // yeni unvanı doğrudan seç
        CancelAddTitle();
        _ok = true; _msg = "Unvan eklendi.";
    }

    // Ad/telefon değişince olası mükerrer kaydı arka planda sorgula (yalnız yeni kayıtta).
    private async Task OnKeyFieldsChanged()
    {
        _dupAck = false;
        if (_editId is not null || string.IsNullOrWhiteSpace(_name)) { _dups = new(); return; }
        try
        {
            var arr = await Api.GetArrayAsync($"/api/personnel/duplicates?fullName={Uri.EscapeDataString(_name)}&phone={Uri.EscapeDataString(_phone ?? "")}");
            _dups = arr.ToList();
        }
        catch { _dups = new(); }
    }

    private async Task BeginEdit(JsonElement r)
    {
        if (!await Dialog.Confirm("Bu kaydı düzenlemek istiyor musunuz?", okText: "Evet, Düzenle")) return;
        _editId = Str(r, "id"); _name = Str(r, "fullName"); _title = NullS(r, "title"); _phone = Str(r, "phone");
        _branch = NullS(r, "branchId"); _active = Bool(r, "isActive"); _fieldStaff = Bool(r, "isFieldStaff"); _msg = null;
        _hasAccount = Bool(r, "hasAccount"); _accountAdmin = Bool(r, "accountAdmin"); _accountUsername = Str(r, "username");
        _grantAccess = false; _linkUserId = null;
        _dups = new(); _dupAck = false; CancelAddTitle();
    }

    private async Task Save()
    {
        _msg = null;
        if (string.IsNullOrWhiteSpace(_name)) { _msg = "Ad Soyad zorunlu."; _ok = false; return; }

        // Yeni kayıt: mükerrer uyarısı (onaylanmadıysa)
        if (_editId is null && _dups.Count > 0 && !_dupAck)
        {
            var names = string.Join("\n• ", _dups.Select(DupLabel));
            if (!await Dialog.Confirm($"Aşağıdaki kişi(ler) zaten kayıtlı olabilir:\n\n• {names}\n\nAynı kişiyse Vazgeç deyip mevcut kaydı düzenleyin. Farklı kişiyse devam edin.", "Farklı kişi, devam et", danger: false))
                return;
            _dupAck = true;
        }

        // Bu kayıtta mevcut kullanıcı bağlanıyor mu? (admin + hesabı yok + saha değil + anahtar açık + kullanıcı seçili)
        bool wantLink = Auth.IsAdmin && !_hasAccount && !_fieldStaff && _grantAccess && !string.IsNullOrEmpty(_linkUserId);
        if (Auth.IsAdmin && !_hasAccount && !_fieldStaff && _grantAccess && string.IsNullOrEmpty(_linkUserId))
        { _msg = "Bağlanacak kullanıcıyı seçin (veya anahtarı kapatın)."; _ok = false; return; }

        // KOŞUL (değişmedi): hesap YOKSA ve bağlanMIYORSA ve "Saha personeli" işaretli DEĞİLSE uyar.
        // Kutucuk işaretliyse bu koşul hiç çalışmaz.
        if (!_hasAccount && !wantLink && !_fieldStaff)
        {
            if (!await Dialog.Confirm(
                    "Bu personele uygulama kullanıcısı bağlanmadı. Saha personeli mi?\n\n" +
                    "• Evet ise “Saha personeli” olarak kaydedilir (kutucuk işaretlenir).\n" +
                    "• Hayır ise Vazgeç deyip “Mevcut kullanıcıyı bağla” ile bir kullanıcı bağlayın.",
                    "Evet, saha personeli"))
                return;
            _fieldStaff = true;   // onayladı → kutucuk işaretlenir, bir daha sorulmaz
        }

        _busy = true;
        try
        {
            var body = new { fullName = _name.Trim(), title = Empty(_title), phone = Empty(_phone), branchId = _branch, isActive = _active, isFieldStaff = _fieldStaff };
            string? id = _editId;
            if (_editId is null)
            {
                var doc = await Api.PostJsonAsync("/api/personnel", body);
                if (doc is null || !doc.Value.TryGetProperty("id", out var idv) || idv.ValueKind != JsonValueKind.String)
                { _ok = false; _msg = "Personel eklenemedi."; return; }
                id = idv.GetString();
            }
            else
            {
                var err = await Api.PutAsync($"/api/personnel/{_editId}", body);
                if (err is not null) { _ok = false; _msg = err; return; }
            }

            if (wantLink)
            {
                var linkErr = await Api.PostAsync($"/api/personnel/{id}/link-user", new { userId = _linkUserId });
                if (linkErr is not null) { _ok = false; _msg = "Personel kaydedildi ama kullanıcı bağlanamadı: " + linkErr; await LoadList(); return; }
            }
            _ok = true; _msg = _editId is null ? (wantLink ? "Personel eklendi + kullanıcı bağlandı." : "Eklendi.") : "Güncellendi.";
            Clear(); if (Auth.IsAdmin) await LoadLinkableUsers(); await LoadList();
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>Admin: personelin hesap bağını çözer (hesap silinmez).</summary>
    private async Task RemoveAccount()
    {
        if (_editId is null) return;
        if (!await Dialog.Confirm($"'{_accountUsername}' hesabının bu personele bağı kaldırılsın mı? (Hesap silinmez, bağ çözülür.)", "Evet, Kaldır", danger: true)) return;
        var err = await Api.DeleteAsync($"/api/personnel/{_editId}/account");
        _ok = err is null; _msg = err ?? "Hesap bağı kaldırıldı.";
        if (_ok) { _hasAccount = false; _accountUsername = ""; if (Auth.IsAdmin) await LoadLinkableUsers(); await LoadList(); }
    }

    private async Task Delete(string id)
    {
        if (string.IsNullOrEmpty(id)) return;
        if (!await Dialog.Confirm("Bu personel silinsin mi?", "Evet, Sil", danger: true)) return;
        var err = await Api.DeleteAsync($"/api/personnel/{id}");
        _msg = err ?? "Silindi."; _ok = err is null;
        await LoadList();
    }

    private void Clear()
    {
        _editId = null; _name = _phone = ""; _title = null; _branch = null; _active = true; _fieldStaff = false;
        _grantAccess = false; _linkUserId = null;
        _hasAccount = false; _accountAdmin = false; _accountUsername = ""; _dups = new(); _dupAck = false;
        CancelAddTitle();
    }

    private static string DupLabel(JsonElement e)
    {
        var n = Str(e, "fullName"); var ph = Str(e, "phone");
        return string.IsNullOrEmpty(ph) ? n : $"{n} ({ph})";
    }

    private static string? Empty(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static string? NullS(JsonElement row, string key) { var s = Str(row, key); return string.IsNullOrEmpty(s) ? null : s; }
    private static bool Bool(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && (v.ValueKind == JsonValueKind.True || (v.ValueKind == JsonValueKind.Number && v.GetInt32() != 0));
}
