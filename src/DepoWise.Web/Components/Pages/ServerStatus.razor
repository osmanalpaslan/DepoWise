@page "/server-status"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@implements IDisposable

<PageTitle>Canlı Sunucu — Alpnex</PageTitle>

@if (!Auth.IsSuperAdmin)
{
    <MudAlert Severity="Severity.Error">Bu ekran yalnız süper admin içindir.</MudAlert>
}
else
{
    <div class="d-flex align-center mb-4">
        <span class="dw-pulse @(_online ? "on" : "off")"></span>
        <MudText Typo="Typo.h5" Class="ml-2">Canlı Sunucu Durumu</MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@(_online ? "Bağlı — 3 sn'de bir yenilenir" : "Bağlantı bekleniyor…")</MudText>
    </div>

    @if (_err is not null) { <MudAlert Severity="Severity.Warning" Class="mb-3">@_err</MudAlert> }

    <MudGrid Spacing="3">
        @foreach (var k in Kpis())
        {
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-3" Elevation="2" Style="border-radius:14px;height:100%">
                    <div class="d-flex align-center mb-1">
                        <MudIcon Icon="@k.Icon" Color="@ColorOf(k.Color)" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@k.Label</MudText>
                    </div>
                    <div class="dw-kpi-val">@k.Val</div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    @* #3 — CPU% · Bellek% · Disk% canlı (animasyonlu) göstergeler *@
    <MudGrid Spacing="3" Class="mt-1">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2" Style="border-radius:14px;">
                <div class="d-flex align-center mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Memory" Color="@GaugeColor(_cpuPct)" Size="Size.Small" Class="mr-2" />
                    <MudText Typo="Typo.subtitle2">İşlemci Kullanımı (CPU)</MudText><MudSpacer />
                    <MudText Typo="Typo.h6" Style="@($"color:{GaugeHex(_cpuPct)}")">@_cpuPct.ToString("0.0")%</MudText>
                </div>
                <div class="dw-gauge"><div class="dw-gauge-fill" style="width:@W(_cpuPct)%;background:@GaugeHex(_cpuPct)"></div></div>
                <div class="dw-spark mt-2" style="height:56px">
                    @foreach (var v in _cpuHist) { <div class="dw-bar2" style="height:@W(Math.Max(3, v))%;background:@GaugeHex(v)"></div> }
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2" Style="border-radius:14px;">
                <div class="d-flex align-center mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Color="@GaugeColor(_diskPct)" Size="Size.Small" Class="mr-2" />
                    <MudText Typo="Typo.subtitle2">Disk Kullanımı (/data)</MudText><MudSpacer />
                    <MudText Typo="Typo.h6" Style="@($"color:{GaugeHex(_diskPct)}")">@_diskPct.ToString("0.0")%</MudText>
                </div>
                <div class="dw-gauge"><div class="dw-gauge-fill" style="width:@W(_diskPct)%;background:@GaugeHex(_diskPct)"></div></div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@FmtMb(_diskUsedMb) / @FmtMb(_diskTotalMb) · boş @FmtMb(_diskFreeMb) · paketler @FmtMb(_packagesMb) (@_packageCount)</MudText>
                <div class="dw-spark mt-2" style="height:40px">
                    @foreach (var v in _diskHist) { <div class="dw-bar2" style="height:@W(Math.Max(3, v))%;background:@GaugeHex(v)"></div> }
                </div>
                @if (_diskPct >= 85) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">Disk kritik! Dolarsa tüm API 500 verir. Eski paketleri silin.</MudAlert> }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2" Style="border-radius:14px;">
                <div class="d-flex align-center mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.DataUsage" Color="@GaugeColor(_memPct)" Size="Size.Small" Class="mr-2" />
                    <MudText Typo="Typo.subtitle2">Bellek Kullanımı (RAM)</MudText><MudSpacer />
                    <MudText Typo="Typo.h6" Style="@($"color:{GaugeHex(_memPct)}")">@_memPct.ToString("0.0")%</MudText>
                </div>
                <div class="dw-gauge"><div class="dw-gauge-fill" style="width:@W(_memPct)%;background:@GaugeHex(_memPct)"></div></div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_wsMb.ToString("0.0") MB / @_memLimitMb.ToString("0") MB limit</MudText>
                <div class="dw-spark mt-2" style="height:56px">
                    @foreach (var v in _memHist) { <div class="dw-bar2" style="height:@W(Math.Max(3, v))%;background:@GaugeHex(v)"></div> }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Bellek (son @_mem.Count örnek)</MudText>
        <div class="dw-spark">
            @{
                var mn = _mem.Count > 0 ? _mem.Min() : 0;
                var mx = _mem.Count > 0 ? _mem.Max() : 1;
                var range = mx - mn;
            }
            @foreach (var m in _mem)
            {
                // Min-max normalize: değişim görünür olsun (hep %100 pegleme yok). Sabitse orta yükseklik.
                var h = range > 0.0001 ? (int)(15 + (m - mn) / range * 85) : 50;
                <div class="dw-bar" style="height:@(Math.Max(4,h))%"></div>
            }
        </div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">.NET @_dotnet · sunucu saati @_serverTime</MudText>
    </MudPaper>

    @* Güncelleme paketleri — disk yükünü buradan yönet: eski paketleri MANUEL sil (ADR-070). *@
    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <div class="d-flex align-center mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="mr-2" />
            <MudText Typo="Typo.subtitle1">Güncelleme Paketleri (disk)</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadPackages" Disabled="_pkgBusy">Yenile</MudButton>
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Masaüstü güncelleyici daima EN GÜNCEL sürümü indirir; eski paketler disk yükü yapar. En güncel sürümün paketi silinemez.</MudText>

        @if (_pkgMsg is not null) { <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">@_pkgMsg</MudAlert> }
        @if (_pkgErr is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_pkgErr</MudAlert> }

        @if (_packages is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
        else if (_packages.Count == 0) { <MudText Class="mud-text-secondary">Diskte güncelleme paketi yok.</MudText> }
        else
        {
            <MudTable Items="_packages" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh>Sürüm</MudTh><MudTh>Dosya</MudTh><MudTh>Boyut</MudTh><MudTh>Değişiklik (UTC)</MudTh><MudTh /></HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @context.Version
                        @if (context.IsLatest) { <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-1">en güncel</MudChip> }
                    </MudTd>
                    <MudTd><code style="font-size:12px">@context.FileName</code></MudTd>
                    <MudTd>@context.SizeMb.ToString("0.0") MB</MudTd>
                    <MudTd>@context.ModifiedUtc.ToString("dd.MM.yyyy HH:mm")</MudTd>
                    <MudTd>
                        @if (!context.IsLatest)
                        {
                            <MudTooltip Text="Sil"><MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Delete" OnClick="() => DeletePackage(context)" Disabled="_pkgBusy" /></MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

<style>
    .dw-pulse { width:12px;height:12px;border-radius:50%;display:inline-block; }
    .dw-pulse.on { background:#22c55e; box-shadow:0 0 0 0 rgba(34,197,94,.7); animation:dwp 1.6s infinite; }
    .dw-pulse.off { background:#94a3b8; }
    @@keyframes dwp { 0%{box-shadow:0 0 0 0 rgba(34,197,94,.6)} 70%{box-shadow:0 0 0 10px rgba(34,197,94,0)} 100%{box-shadow:0 0 0 0 rgba(34,197,94,0)} }
    .dw-spark { display:flex; align-items:flex-end; gap:3px; height:90px; }
    .dw-bar { flex:1; min-width:3px; background:linear-gradient(180deg,#3b82f6,#1e3a8a); border-radius:3px 3px 0 0; transition:height .4s ease; }
    .dw-kpi-val { font-size:1.4rem; font-weight:700; transition:color .3s ease; }
    .dw-gauge { width:100%; height:14px; border-radius:8px; background:rgba(148,163,184,.25); overflow:hidden; }
    .dw-gauge-fill { height:100%; border-radius:8px; transition:width .5s ease, background .5s ease; }
    .dw-bar2 { flex:1; min-width:2px; border-radius:3px 3px 0 0; transition:height .4s ease, background .4s ease; align-self:flex-end; }
</style>

@code {
    private System.Threading.Timer? _timer;
    private bool _online;
    private string? _err;
    private string _uptime = "—", _version = "—", _dotnet = "—", _serverTime = "—";
    private double _wsMb, _gcMb, _dbMb, _memMax = 1;
    private double _cpuPct, _memPct, _memLimitMb;
    private double _diskPct, _diskTotalMb, _diskFreeMb, _diskUsedMb, _packagesMb;
    private int _packageCount;
    private int _threads, _machines, _companies, _users, _usersOnline;
    private long _requests;
    private readonly List<double> _mem = new();
    private readonly List<double> _cpuHist = new();
    private readonly List<double> _memHist = new();
    private readonly List<double> _diskHist = new();

    // Güncelleme paketleri (disk) — canlı 3 sn poll'de yenilenmez; ilk yükleme + silme sonrası yenilenir.
    private List<ReleasePackageDto>? _packages;
    private string? _pkgErr, _pkgMsg;
    private bool _pkgBusy;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsSuperAdmin) return;
        _timer = new System.Threading.Timer(async _ => await Poll(), null, 0, 3000);
        await LoadPackages();
    }

    private async Task Poll()
    {
        try
        {
            var d = await Api.GetObjectAsync("/api/server/status");
            _uptime = FormatUptime(Num(d, "uptimeSeconds"));
            _wsMb = Num(d, "workingSetMb");
            _gcMb = Num(d, "gcMemoryMb");
            _dbMb = Num(d, "dbSizeMb");
            _cpuPct = Num(d, "cpuPercent");
            _memPct = Num(d, "memPercent");
            _memLimitMb = Num(d, "memLimitMb");
            _usersOnline = (int)Num(d, "usersOnline");
            _threads = (int)Num(d, "threadCount");
            _machines = (int)Num(d, "machinesOnline");
            _companies = (int)Num(d, "companies");
            _users = (int)Num(d, "users");
            _requests = (long)Num(d, "requestCount");
            _diskPct = Num(d, "diskPercent");
            _diskTotalMb = Num(d, "diskTotalMb");
            _diskFreeMb = Num(d, "diskFreeMb");
            _diskUsedMb = Num(d, "diskUsedMb");
            _packagesMb = Num(d, "packagesMb");
            _packageCount = (int)Num(d, "packageCount");
            _cpuHist.Add(_cpuPct); if (_cpuHist.Count > 40) _cpuHist.RemoveAt(0);
            _memHist.Add(_memPct); if (_memHist.Count > 40) _memHist.RemoveAt(0);
            _diskHist.Add(_diskPct); if (_diskHist.Count > 40) _diskHist.RemoveAt(0);
            _version = Str(d, "latestVersion");
            _dotnet = Str(d, "dotnet");
            _serverTime = d.TryGetProperty("serverTimeUtc", out var st) ? st.ToString() : "—";
            _mem.Add(_wsMb);
            if (_mem.Count > 40) _mem.RemoveAt(0);
            _memMax = _mem.Count > 0 ? Math.Max(1, _mem.Max()) : 1;
            _online = true; _err = null;
        }
        catch (Exception ex) { _online = false; _err = "Durum alınamadı: " + ex.Message; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadPackages()
    {
        _pkgErr = _pkgMsg = null; _pkgBusy = true;
        try { _packages = await Api.GetReleasePackagesAsync(); }
        catch (Exception ex) { _pkgErr = "Paketler yüklenemedi: " + ex.Message; }
        finally { _pkgBusy = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task DeletePackage(ReleasePackageDto p)
    {
        _pkgErr = _pkgMsg = null;
        if (!await Dialog.Confirm($"'{p.Version}' güncelleme paketi ({p.SizeMb:0.0} MB) diskten silinsin mi?", "Evet, Sil", danger: true)) return;
        _pkgBusy = true;
        try
        {
            var err = await Api.DeleteReleasePackageAsync(p.Version);
            if (err is null) { _pkgMsg = $"'{p.Version}' paketi silindi ({p.SizeMb:0.0} MB boşaldı)."; await LoadPackages(); }
            else _pkgErr = err;
        }
        catch (Exception ex) { _pkgErr = ex.Message; }
        finally { _pkgBusy = false; await InvokeAsync(StateHasChanged); }
    }

    private static string FmtMb(double mb) => mb >= 1024 ? $"{mb / 1024.0:0.0} GB" : $"{mb:0.0} MB";

    private sealed record KpiItem(string Label, string Val, string Icon, string Color);

    private IEnumerable<KpiItem> Kpis() => new[]
    {
        new KpiItem("Çalışma Süresi", _uptime, Icons.Material.Filled.Timer, "info"),
        new KpiItem("Online Kullanıcı", _usersOnline.ToString(), Icons.Material.Filled.PersonPin, _usersOnline > 0 ? "success" : "default"),
        new KpiItem("Çevrimiçi Makine", _machines.ToString(), Icons.Material.Filled.DevicesOther, _machines > 0 ? "success" : "default"),
        new KpiItem("Çalışma Belleği", $"{_wsMb:0.0} MB", Icons.Material.Filled.Memory, "warning"),
        new KpiItem("GC Belleği", $"{_gcMb:0.0} MB", Icons.Material.Filled.DataUsage, "default"),
        new KpiItem("Thread", _threads.ToString(), Icons.Material.Filled.Timeline, "default"),
        new KpiItem("DB Boyutu", $"{_dbMb:0.00} MB", Icons.Material.Filled.Storage, "info"),
        new KpiItem("Disk (/data)", $"{_diskPct:0.0}%", Icons.Material.Filled.Storage, _diskPct >= 85 ? "error" : _diskPct >= 60 ? "warning" : "success"),
        new KpiItem("Disk Boş", FmtMb(_diskFreeMb), Icons.Material.Filled.SdStorage, _diskFreeMb < 100 ? "error" : "default"),
        new KpiItem("Firma", _companies.ToString(), Icons.Material.Filled.Business, "default"),
        new KpiItem("Kullanıcı", _users.ToString(), Icons.Material.Filled.People, "default"),
        new KpiItem("İstek Sayısı", _requests.ToString("N0"), Icons.Material.Filled.SwapVert, "default"),
        new KpiItem("Son Sürüm", _version, Icons.Material.Filled.NewReleases, "success"),
    };

    private static Color ColorOf(string c) => c switch
    {
        "success" => Color.Success, "warning" => Color.Warning, "info" => Color.Info, "error" => Color.Error, _ => Color.Default
    };

    // #3 — gösterge yardımcıları: eşik renkleri (yeşil<%60, turuncu<%85, kırmızı≥%85) + kültür-güvenli yüzde.
    private static readonly System.Globalization.CultureInfo Ci = System.Globalization.CultureInfo.InvariantCulture;
    private static string W(double v) => Math.Clamp(v, 0, 100).ToString("0.#", Ci);
    private static Color GaugeColor(double p) => p >= 85 ? Color.Error : p >= 60 ? Color.Warning : Color.Success;
    private static string GaugeHex(double p) => p >= 85 ? "#ef4444" : p >= 60 ? "#f59e0b" : "#22c55e";

    private static double Num(JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDouble() : 0;
    private static string Str(JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "—" : "—";

    private static string FormatUptime(double sec)
    {
        var t = TimeSpan.FromSeconds(sec);
        return t.TotalDays >= 1 ? $"{(int)t.TotalDays}g {t.Hours}s {t.Minutes}d"
             : t.TotalHours >= 1 ? $"{t.Hours}s {t.Minutes}d {t.Seconds}sn"
             : $"{t.Minutes}d {t.Seconds}sn";
    }

    public void Dispose() => _timer?.Dispose();
}
