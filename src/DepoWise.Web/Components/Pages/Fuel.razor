@page "/fuel"
@page "/fuel/{Section}"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Yakıt — @SecTitle</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

@* "Tüm Şubeler" modunda bu ekranda İŞLEM yapılamaz (kayıt hangi şubeye yazılacağı belli değil) — okuma serbest. *@
@if (Auth.IsAllBranches())
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">@DepoWise.Web.Services.BranchGuard.Banner</MudAlert>
}

    @* ═══════════ YAKIT DAĞITIMLARI ═══════════ *@
    @if (_sec == "dist")
    {
        @if (Auth.CanCreate("fuel"))
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:760px;">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@DistFormTitle</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="ApiClient.Opt" Label="Araç *" @bind-Value="_vehicle" SearchFunc="SearchVehicle"
                                         ToStringFunc="@(o => o?.Name ?? "")" Placeholder="İç kod / plaka ara..." Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true" />
                    </MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal" Value="_prevMeter" ReadOnly="true" Label="Önceki Sayaç" HelperText="Araçtan otomatik." Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    @* 2026-09-30 (kullanıcı isteği): SAYAÇ FARKI salt okunur (güncel sayaçtan hesaplanır); güncel sayaç boş başlar ve zorunlu. *@
                    <MudItem xs="6" md="3"><MudTextField T="string" Value="@SayacFarkiMetni" ReadOnly="true" Label="Sayaç Farkı" HelperText="Otomatik hesaplanır." Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal?" @bind-Value="_meter" Label="Güncel Sayaç *" Placeholder="Sayacı girin" Min="0" Format="0.##" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3">
                        @* TRH-01: işlem tarihi (iş günü). Kayıt anı ayrıca loglanır. Yetki yoksa kilitli. *@
                        <MudDatePicker @bind-Date="_distDate" Label="İşlem Tarihi" Margin="Margin.Dense" Variant="Variant.Outlined"
                                       Disabled="@(!CanBackDate)" DateFormat="dd.MM.yyyy" Style="max-width:200px"
                                       HelperText="@(CanBackDate ? "Geçmiş/ileri tarih seçilebilir" : "Tarih bugüne sabit (yetki yok)")" />
                    </MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_liters" Label="Litre *" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="3">
                @* MLY-01: opsiyonel maliyet merkezi — bağ sunucuda kayıt sonrası yazılır. *@
                @if (Auth.CanEdit("cost_centers") && _costCenters.Count > 0)
                {
                    <MudSelect T="string" @bind-Value="_distCostCenterId" Label="Maliyet Merkezi" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var cc in _costCenters) { <MudSelectItem T="string" Value="@cc.Id">@cc.Name</MudSelectItem> }
                    </MudSelect>
                }
            </MudItem>
            @* ⭐ MUH-01b: irsaliye / fiş no — depo girişindeki "Fatura/İrsaliye No" alanının dağıtım
               karşılığı; ön muhasebe (FAZ H) gideri kaynak belgesine bağlayabilsin diye eklendi. *@
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_distInvoice" Label="Fatura/İrsaliye No" HelperText="Opsiyonel — elinizdeki belge numarası."
                              Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" />
            </MudItem>

                    <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_price" Label="Birim Fiyat (₺/L)" HelperText="Varsayılan: güncel fiyat." Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><MudTextField Value="@((_liters * _price).ToString("0.##"))" ReadOnly="true" Label="Toplam" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><LookupSelect Label="Yakıtı Veren *" @bind-Value="_person" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" /></MudItem>
                    <MudItem xs="6" md="3"><LookupSelect Label="Yakıtı Alan" @bind-Value="_recipient" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" /></MudItem>
                </MudGrid>
                <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="ClearDist">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Distribute" Disabled="_busy">@DistSaveText</MudButton>
                </MudStack>
                @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
            </MudPaper>
        }
        @* ⭐ ARA İŞ 6 (kullanıcı bildirimi 2026-09-04) — ARAMA + SAYFALAMA.
           Bu ekran sabit 200 satır çekiyordu ve sorgu en yeniden başlıyordu → daha eski kayıtlar
           SESSİZCE düşüyordu (kullanıcı 02.08.2026 kaydını raporda görüp burada bulamadı).
           Webde ayrıca hiç arama alanı YOKTU (masaüstünde ölü bir kutu vardı — farklı belirti,
           aynı sonuç: filtrelenemiyordu).
           ⚠ Sorgu YAZARKEN ÇALIŞMAZ: kullanıcının açık isteği "sadece bu buton ve enter tuşu ile".
           Bu yüzden alanlar `@bind-Value` ile yalnız yerel değişkeni tutar; sorguyu Sorgula düğmesi
           ve alanlardaki Enter tetikler. *@
        <MudPaper Class="pa-3 mt-2" Elevation="0" Style="background:var(--dw-surface-1)">
            <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Wrap="Wrap.Wrap">
                <MudTextField T="string" @bind-Value="_qVehicle" Label="Araç (kod / plaka)" Margin="Margin.Dense"
                              Variant="Variant.Outlined" Style="min-width:170px;"
                              OnKeyUp="@(async e => { if (e.Key == "Enter") await Sorgula(); })" />
                <MudDatePicker @bind-Date="_qFrom" Label="Başlangıç Tarihi" Margin="Margin.Dense"
                               Variant="Variant.Outlined" Style="min-width:160px;" Clearable="true" />
                <MudDatePicker @bind-Date="_qTo" Label="Bitiş Tarihi" Margin="Margin.Dense"
                               Variant="Variant.Outlined" Style="min-width:160px;" Clearable="true" />
                <MudTextField T="string" @bind-Value="_qText" Label="Ara (kod / plaka / açıklama)" Margin="Margin.Dense"
                              Variant="Variant.Outlined" Style="min-width:200px;"
                              OnKeyUp="@(async e => { if (e.Key == "Enter") await Sorgula(); })" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Sorgula"
                           Title="Yukarıdaki alanlara göre arar. Arama yalnız bu düğme ve Enter tuşu ile çalışır.">Sorgula</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="AramayiTemizle"
                           Title="Filtreleri temizler ve tüm kayıtlara döner.">Temizle</MudButton>
            </MudStack>
        </MudPaper>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadDist">Yenile</MudButton>
            <MudCheckBox T="bool" Value="_showCancelled" ValueChanged="ToggleCancelled" Label="İptal edilenleri göster" Dense="true" />
            <MudSpacer />
            @* Kesilmenin SESSİZ olmaması asıl şikayetin özüydü: kaç kayıt var, kaçıncı sayfadayız — yazılır. *@
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @(_distTotal == 0 ? "Kayıt bulunamadı" : $"{_distTotal} dağıtım — sayfa {_distPage} / {_distTotalPages}")@(Filtreli ? " · filtreli" : "")
            </MudText>
            @if (BekleyenFiltre)
            {
                <MudText Typo="Typo.body2" Color="Color.Warning">· Sorgula'ya basın</MudText>
            }
            <MudSelect T="int" Value="_distPageSize" ValueChanged="SayfaBoyutuDegisti" Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Style="min-width:90px;" Label="Sayfa boyutu">
                @foreach (var n in new[] { 25, 50, 100, 200 }) { <MudSelectItem T="int" Value="@n">@n</MudSelectItem> }
            </MudSelect>
            <MudPagination Count="@Math.Max(1, _distTotalPages)" Selected="_distPage" SelectedChanged="SayfayaGit"
                           Rectangular="true" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" />
        </MudStack>
        @if (_dist is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
        else if (_dist.Length == 0) { <MudText Class="mud-text-secondary mt-2">Henüz yakıt dağıtımı kaydı yok.</MudText> }
        else
        {
            <MudTable Items="_dist" Dense="true" Hover="true" Striped="true" Class="mt-2">
                <HeaderContent><MudTh>ARAÇ</MudTh><MudTh>SAYAÇ</MudTh><MudTh Style="text-align:right">LİTRE</MudTh><MudTh Style="text-align:right">SAYAÇ FARKI</MudTh><MudTh Style="text-align:right" title="Litre / sayaç farkı (Yakıt Tüketim raporuyla aynı hesap)">ORT. TÜKETİM</MudTh><MudTh Style="text-align:right">BİRİM FİYAT</MudTh><MudTh Style="text-align:right">TOPLAM</MudTh><MudTh Style="text-align:right">TARİH</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@Str(context, "vehicleCode")</MudTd>
                    <MudTd>@Str(context, "prevMeter") → @Str(context, "currentMeter")</MudTd>
                    <MudTd Style="text-align:right">@Dec(context, "liters").ToString("0.##")</MudTd>
                    @* 2026-09-30: sunucu hesaplar (FuelMath) — masaüstüyle aynı metin. *@
                    <MudTd Style="text-align:right">@Str(context, "meterDiffText")</MudTd>
                    <MudTd Style="text-align:right">@Str(context, "consumptionText")</MudTd>
                    @* B-5: para birimi masaüstündeki gibi gösterilir — kayıt TRY dışı bir birimde girilmişse
                       rakam yalnız başına yanıltıcıydı. Depo tablosu bunu zaten sunucudan "priceText" ile alıyor. *@
                    <MudTd Style="text-align:right">@Dec(context, "unitPrice").ToString("0.##") @Cur(context)</MudTd>
                    <MudTd Style="text-align:right">@((Dec(context, "liters") * Dec(context, "unitPrice")).ToString("0.##")) @Cur(context)</MudTd>
                    <MudTd Style="text-align:right">@Date(context, "distributionDate")</MudTd>
                    <MudTd Style="text-align:right">
                        @if (Bool(context, "isCancelled")) { <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">İptal edildi</MudChip> }
                        else
                        {
                            @* Kullanıcı isteği (2026-09-02): kayıt düzeltilebilsin. Üzerine YAZILMAZ —
                               eski kayıt iptal edilip düzeltilmiş kayıt oluşturulur (tek işlem). *@
                            @if (CanEditFuel)
                            {
                                <MudTooltip Text="Kaydı düzelt: eski kayıt iptal edilip düzeltilmiş yeni kayıt oluşturulur; depo bakiyesi ve raporlar buna göre güncellenir.">
                                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Text"
                                               OnClick="@(() => BeginEditDist(context))">Düzenle</MudButton>
                                </MudTooltip>
                            }
                            @if (Auth.CanEdit("fuel") && Auth.CanButton("btn-reverse"))
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                           OnClick="@(() => CancelDist(Str(context, "id")))">İptal Et</MudButton>
                            }
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }

    @* ═══════════ DEPO GİRİŞLERİ ═══════════ *@
    @if (_sec == "depot")
    {
        @if (Auth.CanCreate("fuel"))
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:680px;">
                <MudText Typo="Typo.subtitle1" Class="mb-2">YENİ DEPO GİRİŞİ</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="6" md="4">
                        @* TRH-01: depo girişi işlem tarihi (iş günü). Dağıtımdan AYRIDIR. *@
                        <MudDatePicker @bind-Date="_depotDate" Label="İşlem Tarihi" Margin="Margin.Dense" Variant="Variant.Outlined"
                                       Disabled="@(!CanBackDate)" DateFormat="dd.MM.yyyy"
                                       HelperText="@(CanBackDate ? "Geçmiş/ileri tarih seçilebilir" : "Tarih bugüne sabit (yetki yok)")" />
                    </MudItem>
                    <MudItem xs="6" md="4"><MudNumericField T="decimal" @bind-Value="_dLiters" Label="Litre *" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="3">
                @* MLY-01: opsiyonel maliyet merkezi — bağ sunucuda kayıt sonrası yazılır. *@
                @if (Auth.CanEdit("cost_centers") && _costCenters.Count > 0)
                {
                    <MudSelect T="string" @bind-Value="_depotCostCenterId" Label="Maliyet Merkezi" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var cc in _costCenters) { <MudSelectItem T="string" Value="@cc.Id">@cc.Name</MudSelectItem> }
                    </MudSelect>
                }
            </MudItem>

                    <MudItem xs="6" md="4"><MudNumericField T="decimal" @bind-Value="_dPrice" Label="Birim Fiyat (₺/L) *" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="4"><MudTextField Value="@((_dLiters * _dPrice).ToString("0.##"))" ReadOnly="true" Label="Toplam" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><LookupSelect Label="Tedarikçi" @bind-Value="_dSupplier" Items="_suppliers" AddTable="suppliers" OnAdded="ReloadSuppliers" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_dInvoice" Label="Fatura/İrsaliye No" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
                </MudGrid>
                <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="ClearDepot">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddDepot" Disabled="_busy">Kaydet</MudButton>
                </MudStack>
                @if (_dMsg is not null) { <MudAlert Severity="@(_dOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_dMsg</MudAlert> }
            </MudPaper>
        }
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadDepot">Yenile</MudButton>
            <MudCheckBox T="bool" Value="_showCancelled" ValueChanged="ToggleCancelled" Label="İptal edilenleri göster" Dense="true" />
            <MudSpacer />
            @* Depo girişlerinde de aynı 200 tavanı vardı — burada da sayfalanır ve toplam yazılır. *@
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @(_depotTotal == 0 ? "Kayıt bulunamadı" : $"{_depotTotal} depo girişi — sayfa {_depotPage} / {_depotTotalPages}")
            </MudText>
            <MudPagination Count="@Math.Max(1, _depotTotalPages)" Selected="_depotPage" SelectedChanged="DepoSayfayaGit"
                           Rectangular="true" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" />
        </MudStack>
        @if (_depot is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
        else if (_depot.Length == 0) { <MudText Class="mud-text-secondary mt-2">Henüz depo girişi kaydı yok.</MudText> }
        else
        {
            <MudTable Items="_depot" Dense="true" Hover="true" Striped="true" Class="mt-2">
                <HeaderContent><MudTh>FATURA NO</MudTh><MudTh Style="text-align:right">LİTRE</MudTh><MudTh Style="text-align:right">BİRİM FİYAT</MudTh><MudTh Style="text-align:right">TARİH</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@Str(context, "invoiceDisplay")</MudTd>
                    <MudTd Style="text-align:right">@Str(context, "litersText")</MudTd>
                    <MudTd Style="text-align:right">@Str(context, "priceText")</MudTd>
                    <MudTd Style="text-align:right">@Str(context, "dateText")</MudTd>
                    <MudTd Style="text-align:right">
                        @if (Bool(context, "isCancelled")) { <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">İptal edildi</MudChip> }
                        else if (Auth.CanEdit("fuel") && Auth.CanButton("btn-reverse"))
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                       OnClick="@(() => CancelDepot(Str(context, "id")))">İptal Et</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }

    @* ═══════════ ÖZET ═══════════
       ⭐ 2026-10-10 (kullanıcı isteği) YENİ TASARIM — iOS tarzı yumuşak kartlar; masaüstüyle aynı düzen.
       Haftalar mavi ORAN ÇUBUĞU, günler yeşil TAKVİM KUTUCUĞU → ay açılınca ikisi artık karışmaz.
       Görüntü alanları (weekBars/dayTiles/monthName...) sunucudaki ortak modelden gelir. *@
    @if (_sec == "summary")
    {
        <div class="fz-wrap">
            <div class="d-flex justify-end mb-2">
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadSummary">Yenile</MudButton>
            </div>
            <div class="fz-kpis">
                <div class="fz-kpi"><div class="fz-kpi-lbl"><span class="fz-dot fz-accent"></span>Kalan Yakıt (Depo)</div><div class="fz-kpi-val">@_depotBalance.ToString("#,##0.##", Tr) L</div></div>
                <div class="fz-kpi"><div class="fz-kpi-lbl"><span class="fz-dot fz-warn"></span>Güncel Fiyat</div><div class="fz-kpi-val">@_currentPrice.ToString("#,##0.##", Tr) ₺/L</div></div>
                <div class="fz-kpi"><div class="fz-kpi-lbl"><span class="fz-dot fz-info"></span>Toplam Alınan</div><div class="fz-kpi-val">@_totalReceived.ToString("#,##0.##", Tr) L</div></div>
                <div class="fz-kpi"><div class="fz-kpi-lbl"><span class="fz-dot fz-ok"></span>Toplam Dağıtılan</div><div class="fz-kpi-val">@_totalDistributed.ToString("#,##0.##", Tr) L</div></div>
            </div>
            <div class="fz-note">Kalan = tüm alınan − tüm dağıtılan (fiziksel depo). Fiyatlar geçmişte snapshot saklanır.</div>

            <div class="fz-head">
                <div class="fz-title">Aylık Dağıtım</div>
                <div class="fz-legend">
                    <span><i class="fz-leg-bar"></i>Haftalık</span>
                    <span><i class="fz-leg-tile"></i>Günlük</span>
                    <span class="fz-muted">son 12 ay</span>
                </div>
            </div>
            @if (_months.Count == 0) { <div class="fz-muted">Bu dönemde dağıtım yok.</div> }
            @{ var enYuksek = _months.Count == 0 ? 0m : _months.Max(a => Dec(a, "liters")); }
            @foreach (var ay in _months)
            {
                var anahtar = Str(ay, "year") + "-" + Str(ay, "month");
                var acik = _openMonths.Contains(anahtar);
                var buAy = Bool(ay, "isCurrentMonth");
                var oran = enYuksek <= 0 ? 0 : Math.Max(4, (double)(Dec(ay, "liters") / enYuksek * 100m));
                <div class="fz-month @(buAy ? "fz-current" : null) @(Bool(ay, "isEmpty") ? "fz-empty" : null)">
                    <button type="button" class="fz-month-head" title="Haftalık ve günlük ayrıntıyı göster / gizle"
                            @onclick="@(() => ToggleMonth(anahtar))">
                        <div class="fz-mname"><b>@Str(ay, "monthName")</b> <span class="fz-muted">@Str(ay, "yearText")</span>
                            @if (buAy) { <span class="fz-pill fz-pill-accent">Bu ay</span> }</div>
                        <div class="fz-pills">
                            <span class="fz-pill fz-pill-info">Haftalık ort. @Str(ay, "weeklyAverageText")</span>
                            <span class="fz-pill fz-pill-ok">Günlük ort. @Str(ay, "dailyAverageText")</span>
                            <span class="fz-pill">@Str(ay, "countText")</span>
                        </div>
                        <div class="fz-total">@Str(ay, "litersText")</div>
                        <div class="fz-chev @(acik ? "fz-open" : null)">⌄</div>
                        <div class="fz-share" title="Son 12 ayın en yoğun ayına göre oran"><i style="width:@(oran.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
                    </button>
                    @if (acik)
                    {
                        <div class="fz-detail">
                            <div class="fz-panel">
                                <div class="fz-ptitle fz-t-info"><i class="fz-leg-bar"></i>HAFTALAR</div>
                                @foreach (var h in Arr(ay, "weekBars"))
                                {
                                    var p = Dbl(h, "percent");
                                    <div class="fz-week" title="@Str(h, "countText")">
                                        <div class="fz-week-row"><b>@Str(h, "label")</b><span class="fz-muted">@Str(h, "rangeText")</span><b class="fz-right">@Str(h, "litersText")</b></div>
