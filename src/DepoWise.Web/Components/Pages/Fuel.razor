@page "/fuel"
@page "/fuel/{Section}"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5">Yakıt — @SecTitle</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

@* "Tüm Şubeler" modunda bu ekranda İŞLEM yapılamaz (kayıt hangi şubeye yazılacağı belli değil) — okuma serbest. *@
@if (Auth.IsAllBranches())
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">@DepoWise.Web.Services.BranchGuard.Banner</MudAlert>
}

    @* ═══════════ YAKIT DAĞITIMLARI ═══════════ *@
    @if (_sec == "dist")
    {
        @if (Auth.CanCreate("fuel"))
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:760px;">
                <MudText Typo="Typo.subtitle1" Class="mb-2">YENİ DAĞITIM</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="ApiClient.Opt" Label="Araç *" @bind-Value="_vehicle" SearchFunc="SearchVehicle"
                                         ToStringFunc="@(o => o?.Name ?? "")" Placeholder="İç kod / plaka ara..." Margin="Margin.Dense" Variant="Variant.Outlined" MinCharacters="0" CoerceText="true" />
                    </MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal" Value="_prevMeter" ReadOnly="true" Label="Önceki Sayaç" HelperText="Araçtan otomatik." Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_meter" Label="Güncel Sayaç" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_liters" Label="Litre *" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_price" Label="Birim Fiyat (₺/L)" HelperText="Varsayılan: güncel fiyat." Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><MudTextField Value="@((_liters * _price).ToString("0.##"))" ReadOnly="true" Label="Toplam" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="3"><LookupSelect Label="Yakıtı Veren *" @bind-Value="_person" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" /></MudItem>
                    <MudItem xs="6" md="3"><LookupSelect Label="Yakıtı Alan" @bind-Value="_recipient" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" /></MudItem>
                </MudGrid>
                <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="ClearDist">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Distribute" Disabled="_busy">Kaydet</MudButton>
                </MudStack>
                @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
            </MudPaper>
        }
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadDist">Yenile</MudButton>
            <MudCheckBox T="bool" Value="_showCancelled" ValueChanged="ToggleCancelled" Label="İptal edilenleri göster" Dense="true" />
        </MudStack>
        @if (_dist is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
        else if (_dist.Length == 0) { <MudText Class="mud-text-secondary mt-2">Henüz yakıt dağıtımı kaydı yok.</MudText> }
        else
        {
            <MudTable Items="_dist" Dense="true" Hover="true" Striped="true" Class="mt-2">
                <HeaderContent><MudTh>ARAÇ</MudTh><MudTh>SAYAÇ</MudTh><MudTh Style="text-align:right">LİTRE</MudTh><MudTh Style="text-align:right">BİRİM FİYAT</MudTh><MudTh Style="text-align:right">TOPLAM</MudTh><MudTh Style="text-align:right">TARİH</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@Str(context, "vehicleCode")</MudTd>
                    <MudTd>@Str(context, "prevMeter") → @Str(context, "currentMeter")</MudTd>
                    <MudTd Style="text-align:right">@Dec(context, "liters").ToString("0.##")</MudTd>
                    <MudTd Style="text-align:right">@Dec(context, "unitPrice").ToString("0.##")</MudTd>
                    <MudTd Style="text-align:right">@((Dec(context, "liters") * Dec(context, "unitPrice")).ToString("0.##"))</MudTd>
                    <MudTd Style="text-align:right">@Date(context, "distributionDate")</MudTd>
                    <MudTd Style="text-align:right">
                        @if (Bool(context, "isCancelled")) { <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">İptal edildi</MudChip> }
                        else if (Auth.CanEdit("fuel"))
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                       OnClick="@(() => CancelDist(Str(context, "id")))">İptal Et</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }

    @* ═══════════ DEPO GİRİŞLERİ ═══════════ *@
    @if (_sec == "depot")
    {
        @if (Auth.CanCreate("fuel"))
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="max-width:680px;">
                <MudText Typo="Typo.subtitle1" Class="mb-2">YENİ DEPO GİRİŞİ</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="6" md="4"><MudNumericField T="decimal" @bind-Value="_dLiters" Label="Litre *" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="4"><MudNumericField T="decimal" @bind-Value="_dPrice" Label="Birim Fiyat (₺/L) *" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="6" md="4"><MudTextField Value="@((_dLiters * _dPrice).ToString("0.##"))" ReadOnly="true" Label="Toplam" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><LookupSelect Label="Tedarikçi" @bind-Value="_dSupplier" Items="_suppliers" AddTable="suppliers" OnAdded="ReloadSuppliers" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_dInvoice" Label="Fatura/İrsaliye No" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
                </MudGrid>
                <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="ClearDepot">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddDepot" Disabled="_busy">Kaydet</MudButton>
                </MudStack>
                @if (_dMsg is not null) { <MudAlert Severity="@(_dOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_dMsg</MudAlert> }
            </MudPaper>
        }
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadDepot">Yenile</MudButton>
            <MudCheckBox T="bool" Value="_showCancelled" ValueChanged="ToggleCancelled" Label="İptal edilenleri göster" Dense="true" />
        </MudStack>
        @if (_depot is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
        else if (_depot.Length == 0) { <MudText Class="mud-text-secondary mt-2">Henüz depo girişi kaydı yok.</MudText> }
        else
        {
            <MudTable Items="_depot" Dense="true" Hover="true" Striped="true" Class="mt-2">
                <HeaderContent><MudTh>FATURA NO</MudTh><MudTh Style="text-align:right">LİTRE</MudTh><MudTh Style="text-align:right">BİRİM FİYAT</MudTh><MudTh Style="text-align:right">TARİH</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@Str(context, "invoiceDisplay")</MudTd>
                    <MudTd Style="text-align:right">@Str(context, "litersText")</MudTd>
                    <MudTd Style="text-align:right">@Str(context, "priceText")</MudTd>
                    <MudTd Style="text-align:right">@Str(context, "dateText")</MudTd>
                    <MudTd Style="text-align:right">
                        @if (Bool(context, "isCancelled")) { <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">İptal edildi</MudChip> }
                        else if (Auth.CanEdit("fuel"))
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                       OnClick="@(() => CancelDepot(Str(context, "id")))">İptal Et</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }

    @* ═══════════ ÖZET ═══════════ *@
    @if (_sec == "summary")
    {
        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadSummary">Yenile</MudButton>
        <MudGrid Class="mt-2" Spacing="2">
            <MudItem xs="6" md="3"><MudPaper Class="pa-4" Elevation="1"><MudText Typo="Typo.h5">@_depotBalance.ToString("0.##") L</MudText><MudText Typo="Typo.caption" Class="mud-text-secondary">Kalan Yakıt (Depo)</MudText></MudPaper></MudItem>
            <MudItem xs="6" md="3"><MudPaper Class="pa-4" Elevation="1"><MudText Typo="Typo.h5">@_currentPrice.ToString("0.##")</MudText><MudText Typo="Typo.caption" Class="mud-text-secondary">Güncel Fiyat</MudText></MudPaper></MudItem>
            <MudItem xs="6" md="3"><MudPaper Class="pa-4" Elevation="1"><MudText Typo="Typo.h5">@_totalReceived.ToString("0.##") L</MudText><MudText Typo="Typo.caption" Class="mud-text-secondary">Toplam Alınan</MudText></MudPaper></MudItem>
            <MudItem xs="6" md="3"><MudPaper Class="pa-4" Elevation="1"><MudText Typo="Typo.h5">@_totalDistributed.ToString("0.##") L</MudText><MudText Typo="Typo.caption" Class="mud-text-secondary">Toplam Dağıtılan</MudText></MudPaper></MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">Kalan = tüm alınan − tüm dağıtılan (fiziksel depo). Fiyatlar geçmişte snapshot saklanır.</MudText>
    }


@code {
    [Parameter] public string? Section { get; set; }
    private string _sec => (Section ?? "dist").ToLowerInvariant();
    private string SecTitle => _sec switch { "depot" => "Depo Girişleri", "summary" => "Özet", _ => "Yakıt Dağıtımları" };

    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };

    private ApiClient.Opt? _vehicle;
    private decimal _prevMeter, _meter, _liters, _price;
    private string? _person;
    private string? _recipient;   // "Yakıtı Alan" (kullanıcı isteği 2026-07-19)

    private decimal _dLiters, _dPrice;
    private string? _dSupplier, _dInvoice;

    private List<ApiClient.Opt> _personnel = new(), _suppliers = new();
    private JsonElement[]? _dist, _depot;
    private decimal _depotBalance, _currentPrice, _totalReceived, _totalDistributed;
    private string? _msg; private bool _ok;
    private string? _dMsg = null; private bool _dOk;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CanCreate("fuel"))
        {
            _personnel = await Api.OptionsAsync("/api/personnel", "id", "fullName");
            _suppliers = await Api.OptionsAsync("/api/lookups/suppliers", "id", "name");
        }
        await LoadDist(); await LoadDepot(); await LoadSummary();
        _price = _currentPrice; _dPrice = _currentPrice;   // varsayılan: güncel fiyat
    }

    // Araç seçilince önceki sayacı araçtan çek
    private ApiClient.Opt? _lastVehicle;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!ReferenceEquals(_vehicle, _lastVehicle) && _vehicle is not null)
        {
            _lastVehicle = _vehicle;
            try { var d = await Api.GetObjectAsync($"/api/vehicles/{_vehicle.Id}"); _prevMeter = d.TryGetProperty("currentMeter", out var m) && m.ValueKind == JsonValueKind.Number ? m.GetDecimal() : 0; StateHasChanged(); }
            catch { }
        }
    }

    private async Task ReloadSuppliers(string _) => _suppliers = await Api.OptionsAsync("/api/lookups/suppliers", "id", "name");
    private async Task LoadDist() { _dist = null; try { _dist = await Api.GetArrayAsync("/api/fuel?includeCancelled=" + (_showCancelled ? "true" : "false")); } catch { _dist = Array.Empty<JsonElement>(); } }
    private async Task LoadDepot() { _depot = null; try { _depot = await Api.GetArrayAsync("/api/fuel/depot?includeCancelled=" + (_showCancelled ? "true" : "false")); } catch { _depot = Array.Empty<JsonElement>(); } }
    private async Task LoadSummary()
    {
        try
        {
            var d = await Api.GetObjectAsync("/api/fuel/summary");
            _depotBalance = D(d, "depotBalance"); _currentPrice = D(d, "currentPrice");
            _totalReceived = D(d, "totalReceived"); _totalDistributed = D(d, "totalDistributed");
        }
        catch { }
    }

    private async Task<IEnumerable<ApiClient.Opt>> SearchVehicle(string? t, CancellationToken ct)
    {
        var r = await Api.OptionsAsync("/api/vehicles" + (string.IsNullOrWhiteSpace(t) ? "" : $"?search={Uri.EscapeDataString(t)}"), "id", "display");
        return string.IsNullOrWhiteSpace(t) ? r.Take(DepoWise.Web.Services.FieldChecks.MaxUnfilteredOptions) : r;
    }

    private async Task Distribute()
    {
        _msg = null;
        if (!await Dialog.RequireBranchAsync(Auth, "Yakıt")) return;   // "Tüm Şubeler" modunda işlem yok
        if (_vehicle is null) { _msg = "Araç seçin."; _ok = false; return; }
        if (_liters <= 0) { _msg = "Litre pozitif olmalı."; _ok = false; return; }
        if (string.IsNullOrWhiteSpace(_person)) { _msg = "Yakıtı veren personeli seçin."; _ok = false; return; } // madde 8
        if (DepoWise.Web.Services.FieldChecks.IsSuspiciouslyLarge(_liters)
            && !await Dialog.Confirm($"Litre değeri çok büyük görünüyor ({_liters:0.##}). Emin misiniz?", "Evet, Doğru")) return; // madde 7
        // Masaüstüyle parite: onayda litre + TOPLAM TUTAR (₺) gösterilir — para ile ilgili son kontrol.
        if (!await Dialog.Confirm($"{_liters:0.##} L yakıt dağıtımı kaydedilsin mi? (Toplam {(_liters * _price):0.##} ₺)")) return;
        _busy = true;
        try
        {
            var err = await Api.PostAsync("/api/fuel/distribute", new
            {
                vehicleId = _vehicle.Id, liters = _liters, currentMeter = _meter,
                unitPrice = _price > 0 ? (decimal?)_price : null, personnelId = _person,
                recipientPersonnelId = string.IsNullOrEmpty(_recipient) ? null : _recipient
            });
            _ok = err is null; _msg = err ?? "Dağıtım kaydedildi.";
            if (_ok) { ClearDist(); await LoadDist(); await LoadSummary(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task AddDepot()
    {
        _dMsg = null;
        if (!await Dialog.RequireBranchAsync(Auth, "Yakıt Depo Girişi")) return;   // "Tüm Şubeler" modunda işlem yok
        if (_dLiters <= 0 || _dPrice <= 0) { _dMsg = "Litre ve birim fiyat pozitif olmalı."; _dOk = false; return; }
        // Masaüstüyle parite: onayda litre + TOPLAM TUTAR (₺) gösterilir — para ile ilgili son kontrol.
        if (!await Dialog.Confirm($"{_dLiters:0.##} L depo girişi kaydedilsin mi? (Toplam {(_dLiters * _dPrice):0.##} ₺)")) return;
        _busy = true;
        try
        {
            var err = await Api.PostAsync("/api/fuel/depot", new { liters = _dLiters, unitPrice = _dPrice, supplierId = _dSupplier, invoiceNo = Empty(_dInvoice) });
            _dOk = err is null; _dMsg = err ?? "Depo girişi kaydedildi.";
            if (_dOk) { ClearDepot(); await LoadDepot(); await LoadSummary(); }
        }
        catch (Exception ex) { _dOk = false; _dMsg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private void ClearDist() { _vehicle = null; _lastVehicle = null; _prevMeter = _meter = _liters = 0; _price = _currentPrice; _person = null; _recipient = null; }
    private void ClearDepot() { _dLiters = 0; _dPrice = _currentPrice; _dSupplier = _dInvoice = null; }

    // ── KAYIT İPTALİ (kullanıcı kararları Y1–Y5) — ortak FuelService/API; sayaç geri alınmaz ──
    private bool _showCancelled;
    private async Task ToggleCancelled(bool v) { _showCancelled = v; await LoadDist(); await LoadDepot(); }

    private async Task CancelDist(string id) => await CancelFuel($"/api/fuel/{id}/cancel", LoadDist,
        "Bu yakıt kaydı iptal edilecek. İptal edilen kayıt bakiye ve rapor hesaplarından çıkarılacaktır. " +
        "Araç sayacı geri alınmaz. İşlem geri alınamaz. Devam etmek istiyor musunuz?");

    private async Task CancelDepot(string id) => await CancelFuel($"/api/fuel/depot/{id}/cancel", LoadDepot,
        "Bu depo girişi iptal edilecek. İptal edilen kayıt bakiye ve rapor hesaplarından çıkarılacaktır. " +
        "İşlem geri alınamaz. Devam etmek istiyor musunuz?");

    private async Task CancelFuel(string path, Func<Task> reload, string question)
    {
        if (!await Dialog.Confirm(question)) return;
        var err = await Api.PostAsync(path, new Dictionary<string, object?> { ["reason"] = "Kullanıcı iptali" });
        _ok = err is null;
        _msg = err ?? "Kayıt iptal edildi.";
        await reload();
        await LoadSummary();
    }

    private static bool Bool(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.True;

    private static string? Empty(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static decimal Dec(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0;
    private static decimal D(JsonElement o, string key) => o.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0;
    private static string Date(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number
            ? DateTimeOffset.FromUnixTimeMilliseconds(v.GetInt64()).LocalDateTime.ToString("dd.MM.yyyy") : "—";
}
