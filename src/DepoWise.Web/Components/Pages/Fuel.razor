        "Araç sayacı, kalan geçerli kayıtlardan yeniden hesaplanır. İşlem geri alınamaz. Devam etmek istiyor musunuz?");

    private async Task CancelDepot(string id) => await CancelFuel($"/api/fuel/depot/{id}/cancel", LoadDepot,
        "Bu depo girişi iptal edilecek. İptal edilen kayıt bakiye ve rapor hesaplarından çıkarılacaktır. " +
        "İşlem geri alınamaz. Devam etmek istiyor musunuz?");

    private async Task CancelFuel(string path, Func<Task> reload, string question)
    {
        // B-4: gerekçe artık sabit "Kullanıcı iptali" DEĞİL — kullanıcıdan alınır ve denetim kaydına yazılır.
        // Vazgeçildiğinde (null) hiçbir istek gönderilmez.
        var reason = await Dialog.AskReason(question);
        if (reason is null) return;
        var err = await Api.PostAsync(path, new Dictionary<string, object?> { ["reason"] = reason });
        _ok = err is null;
        _msg = err ?? "Kayıt iptal edildi.";
        await reload();
        await LoadSummary();
    }

    /// <summary>B-5: satırın para birimi. Eski/eksik kayıtta boş gelirse varsayılan TRY gösterilir.</summary>
    private static string Cur(JsonElement row)
    {
        var c = Str(row, "currency");
        return string.IsNullOrWhiteSpace(c) ? "TRY" : c;
    }

    private static bool Bool(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.True;

    private static string? Empty(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static decimal Dec(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0;
    private static readonly System.Globalization.CultureInfo Tr = new("tr-TR");
    /// <summary>Özet: açık ay kartları (anahtar "yıl-ay").</summary>
    private readonly HashSet<string> _openMonths = new();
    private void ToggleMonth(string key) { if (!_openMonths.Remove(key)) _openMonths.Add(key); }
    private static double Dbl(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDouble() : 0;
    private static decimal D(JsonElement o, string key) => o.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0;
    private static string Date(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number
            ? DateTimeOffset.FromUnixTimeMilliseconds(v.GetInt64()).LocalDateTime.ToString("dd.MM.yyyy") : "—";

    // ── TRH-01: İŞLEM TARİHLERİ (iş günü) — dağıtım ve depo girişi AYRI işlemlerdir ────────────
    /// <summary>Dağıtımın gerçekten yapıldığı gün.</summary>
    private DateTime? _distDate = DateTime.Today;
    /// <summary>Depo girişinin gerçekten yapıldığı gün.</summary>
    private DateTime? _depotDate = DateTime.Today;

    /// <summary>Geri/ileri tarihli işlem yetkisi (btn-backdate). Yetki yoksa alanlar kilitlenir.
    /// ⚠️ Arayüz kilidi GÜVENLİK DEĞİLDİR: asıl kapı sunucuda DateEntryPolicy içindedir.</summary>
    // Anahtar düz metin: web projesi DepoWise.Application'a BAŞVURMAZ (bilinçli ayrım).
    // Karşılığı: AppModules.cs → SpecialButtons.BackDate
    private bool CanBackDate => Auth.CanButton("btn-backdate");

    private static long? Ms(DateTime? d) => d is null ? null
        : new DateTimeOffset(DateTime.SpecifyKind(d.Value, DateTimeKind.Utc)).ToUnixTimeMilliseconds();
    private long? _distDateMs => Ms(_distDate);
    private long? _depotDateMs => Ms(_depotDate);
}
