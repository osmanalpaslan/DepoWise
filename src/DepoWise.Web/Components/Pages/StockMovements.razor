@page "/stock/movements"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject LocationOptions Locations

@* Stok Hareketleri — ayrı ekran (kullanıcı isteği 2026-08-05): tüm giriş/çıkış/transfer/sayım hareketleri,
   tarih aralığı filtresi + metin araması. Salt-okunur. Şube kapsamı ve yetki API'de (/api/stock/movements). *@

<PageTitle>Stok Hareketleri — Alpnex</PageTitle>

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Stok Hareketleri</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")@(Filtered.Any() ? $" · {(_gercekToplam > 0 ? _gercekToplam : Filtered.Count())} hareket" : "")</MudText>
    </div>
</div>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid Spacing="1" Class="align-end">
        <MudItem xs="6" md="3"><MudDatePicker @bind-Date="_from" Label="Başlangıç" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" /></MudItem>
        <MudItem xs="6" md="3"><MudDatePicker @bind-Date="_to" Label="Bitiş" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" /></MudItem>
        <MudItem xs="8" md="4">
            <MudTextField @bind-Value="_search" Label="Ara (kod, malzeme, not, belge no)" Margin="Margin.Dense" Variant="Variant.Outlined"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="false"
                          OnKeyDown="@(async (e) => { if (e.Key == "Enter") await Load(); })" />
        </MudItem>
        @* STK-04 — LOKASYON FİLTRESİ. "Tüm Şubeler" ≠ "Atanmamış":
           Tüm Şubeler = filtre yok (hepsi) · Atanmamış = yalnız lokasyonu bilinmeyen geçmiş hareketler.
           🔴 STK-10b-4 (B-1): filtre artık SUNUCUDA uygulanıyor. Eskiden burada, sunucudan gelen
           LİMİTLİ listenin üzerinde istemcide süzülüyordu → seçilen depoya ait hareket ilk N kaydın
           dışındaysa kullanıcı onu HİÇ göremiyordu (ve eksikliği fark edemiyordu). Seçim değişince
           listeyi yeniden yüklüyoruz: doğruluk, tek bir gidiş-dönüşten önemlidir. *@
        <MudItem xs="6" md="3">
            <MudSelect T="string" @bind-Value="_location" @bind-Value:after="Load" Label="Depo / Şantiye" Margin="Margin.Dense" Variant="Variant.Outlined">
                @foreach (var o in _locationOptions) { <MudSelectItem T="string" Value="@o.Id">@o.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
        <MudItem xs="4" md="2" Class="d-flex" Style="gap:6px;">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Load" Disabled="_busy">Filtrele</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Clear" Disabled="_busy">Temizle</MudButton>
        </MudItem>
        @if (_location == LocationOptions.UnassignedId)
        {
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@LocationOptions.UnassignedHelp</MudText>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@* E2.4/ZB-3: özet YALNIZ ekranda görünen (filtrelenmiş) liste üzerinden hesaplanır — bu yüzden
   kutu etiketlerinde "filtreyle" yazar. Sunucuya ek sorgu YAPILMAZ. *@
@if (_rows is not null && Filtered.Any())
{
    <div class="dw-summary">
        <div class="dw-summary-box">
            <span class="dw-summary-num">@((_gercekToplam > 0 ? _gercekToplam : Filtered.Count()).ToString("N0"))</span>
            <span class="dw-summary-cap">hareket<br />(filtreyle)</span>
        </div>
        <div class="dw-summary-box">
            <span class="dw-summary-num" style="color:var(--mud-palette-success);">@ToplamYon(1).ToString("0.##")</span>
            <span class="dw-summary-cap">toplam giriş<br />(filtreyle)</span>
        </div>
        <div class="dw-summary-box">
            <span class="dw-summary-num" style="color:var(--mud-palette-error);">@ToplamYon(-1).ToString("0.##")</span>
            <span class="dw-summary-cap">toplam çıkış<br />(filtreyle)</span>
        </div>
    </div>
}

<MudPaper Class="pa-4" Elevation="2">
    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    @* G1-07: yükleme hatası ile "gerçekten boş sonuç" birbirinden ayrılır — eskiden hata da boş liste görünüyordu. *@
    else if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert> }
    else if (!Filtered.Any()) { <MudText Class="mud-text-secondary">Seçilen ölçütlerde hareket yok.</MudText> }
    else
    {
        @* Tavana takildiysa kullaniciya ACIKCA soyle: sessizce kesip "1000 hareket" yazmak yanlisti. *@
        @if (_gercekToplam > Filtered.Count())
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Toplam <b>@_gercekToplam.ToString("N0")</b> hareket var; en yenisinden
                <b>@Filtered.Count().ToString("N0")</b> tanesi gösteriliyor.
                Tümünü görmek için tarih aralığı veya arama ile daraltın.
            </MudAlert>
        }
        <MudTable Items="Filtered" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="62vh">
            <HeaderContent>
                <MudTh>Tarih</MudTh><MudTh>Tip</MudTh><MudTh>Kod</MudTh><MudTh>Malzeme</MudTh>
                <MudTh Style="text-align:right;">Miktar</MudTh><MudTh>Birim</MudTh>
                @* STK-04: depo bazlı stokta "hangi depo" bilgisi olmadan hareket defteri okunamaz. *@
                <MudTh>Depo / Şantiye</MudTh>
                <MudTh>Not / Belge</MudTh><MudTh>Durum</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var qty = Dec(context, "quantity"); var dir = Int(context, "direction"); var signed = dir < 0 ? -Math.Abs(qty) : Math.Abs(qty); }
                <MudTd DataLabel="Tarih" Class="mud-text-secondary" Style="font-size:12px; font-variant-numeric:tabular-nums;">@DateText(context)</MudTd>
                @* E2.4/ZB-8: tür rozeti. Renk YÖNDEN okunur (giriş/çıkış) — yeni sınıflandırma yok. *@
                <MudTd DataLabel="Tip">
                    <span class="dw-badge @(dir > 0 ? "dw-badge-ok" : dir < 0 ? "dw-badge-error" : "dw-badge-muted")">
                        <span>@TypeText(Str(context, "movementType"))</span>
                    </span>
                </MudTd>
                <MudTd DataLabel="Kod">@Str(context, "code")</MudTd>
                <MudTd DataLabel="Malzeme">@Str(context, "name")</MudTd>
                <MudTd DataLabel="Miktar" Style="text-align:right;font-weight:600;">
                    <span style="color:@(signed < 0 ? "var(--mud-palette-error)" : "var(--mud-palette-success)");">@(signed >= 0 ? "+" : "")@signed.ToString("0.##")</span>
                </MudTd>
                <MudTd DataLabel="Birim">@Str(context, "unit")</MudTd>
                <MudTd DataLabel="Depo / Şantiye" Style="white-space:nowrap;">@LocationCell(context)</MudTd>
                <MudTd DataLabel="Not / Belge">@NoteDoc(context)</MudTd>
                <MudTd DataLabel="Durum">@(Bool(context, "isReversed") ? "İptal edildi" : "")</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private JsonElement[]? _rows;

    /// <summary>E2.4/ZB-3: filtrelenmiş listedeki verilen yöndeki (giriş=+1 / çıkış=-1) miktar toplamı.
    /// Yalnız ekrandaki veriden hesaplanır; sunucuya ek istek YOKTUR.</summary>
    private decimal ToplamYon(int yon)
        => Filtered.Where(r => Math.Sign(Int(r, "direction")) == yon)
                   .Sum(r => Math.Abs(Dec(r, "quantity")));
    private DateTime? _from, _to;
    private string _search = "";
    private bool _busy;
    /// <summary>G1-07: yükleme hatası mesajı. null = hata yok (boş liste gerçekten boş demektir).</summary>
    private string? _error;

    /// <summary>
    /// SESSIZ KESME DUZELTMESI (10.000 kayitlik yuk testinde bulundu, 2026-09-06).
    /// Bu ekran /api/stock/movements ucunu kullanir ve o uc EN FAZLA 1000 satir doner.
    /// Eskiden ekran okudugu satir sayisini yaziyordu: 10.000 hareketi olan firmada
    /// "1000 hareket" goruluyor, kalan 9.000 kayit SESSIZCE dusuyordu.
    /// Artik gercek toplam ayrica sorulur (sayfalanmis ucun sayim kismi) ve tavana
    /// takilindiysa kullaniciya acikca soylenir. Masaustunde de ayni duzeltme yapildi.
    /// </summary>
    private int _gercekToplam;

    // İşlem Geçmişi "Kaydı Görüntüle" köprüsü (madde 5, 2026-08-06): /stock/movements?q=<kod> ile gelince
    // arama kutusu otomatik doldurulur.
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }

    // STK-04 — lokasyon filtresi. Varsayılan "Tüm Şubeler" = filtre YOK (Atanmamış dahil hepsi).
    private string _location = LocationOptions.AllId;
    private IReadOnlyList<LocationOption> _locationOptions = new[] { new LocationOption(LocationOptions.AllId, LocationOptions.AllLabel) };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Q)) _search = Q;
        // ⭐ WEB-01 (denetim 2026-08-25): korumasız ilk yükleme Blazor devresini düşürüyordu
        // (bembeyaz ekran). Aynı düzeltme YET-C4'te uygulanmış, stok ekranları atlanmıştı.
        try
        {
            _locationOptions = await Locations.FilterOptionsAsync();   // ortak önbellek — ekran başına tekrar indirme yok
            await Load();
        }
        catch (Exception) { _error = "Ekran yüklenemedi. Bağlantınızı kontrol edip tekrar deneyin."; }
    }

    /// <summary>
    /// 🔴 STK-10b-4 (B-1 DÜZELTMESİ): burada artık SÜZME YOK. Lokasyon filtresi sunucuya gider ve
    /// SQL'de, <b>LIMIT'ten önce</b> uygulanır (bkz. <c>StockMovementFilterSql</c> — Stok Hareketleri
    /// raporuyla AYNI üreteç). Eskiden bu özellik, sunucudan gelen limitli listeyi istemcide süzüyordu:
    /// seçilen depoya ait hareket ilk N kaydın dışındaysa listeye HİÇ girmemiş oluyordu ve kullanıcı
    /// eksik sonuç gördüğünü anlayamıyordu. Özellik, ekranın geri kalanını değiştirmemek için
    /// (satır sayısı/başlık/tablo) yerinde bırakıldı ama artık gelen satırları olduğu gibi döndürür.
    ///
    /// ⚠️ "Tüm Şubeler" (<see cref="LocationOptions.AllId"/>) ile "Atanmamış" (boş kimlik) FARKLI:
    /// ilki filtre GÖNDERMEZ (Atanmamış dahil HEPSİ), ikincisi yalnız lokasyonu bilinmeyenleri getirir.
    /// Transferde kaynak VEYA hedef eşleşirse satır görünür (hareket o depoyu ilgilendiriyor) —
    /// bu karar artık sunucudadır.
    /// </summary>
    private IEnumerable<JsonElement> Filtered => _rows ?? System.Array.Empty<JsonElement>();

    /// <summary>Transferde "Kaynak → Hedef", diğer hareketlerde tek depo adı. Boşsa "Atanmamış".</summary>
    private static string LocationCell(JsonElement r)
    {
        var to = Str(r, "locationName");
        if (string.IsNullOrEmpty(to)) to = string.IsNullOrEmpty(Str(r, "locationId")) ? "Atanmamış" : Str(r, "locationId");
        var from = Str(r, "fromLocationName");
        if (string.IsNullOrEmpty(from) || from == to) return to;
        return $"{from} → {to}";
    }

    private async Task Load()
    {
        _busy = true;
        try
        {
            var qs = new List<string>();
            if (_from is { } f) qs.Add($"from={DepoWise.Web.Services.FieldChecks.ToUnixMs(f)}");
            if (_to is { } t) qs.Add($"to={DepoWise.Web.Services.FieldChecks.ToUnixMs(t, endOfDay: true)}");
            if (!string.IsNullOrWhiteSpace(_search)) qs.Add($"q={Uri.EscapeDataString(_search.Trim())}");
            // 🔴 B-1: lokasyon SUNUCUYA gider. "Tüm Şubeler" GÖNDERİLMEZ (= filtre yok);
            // "Atanmamış" boş değerle gider (?location=) — rapor sözleşmesindeki "" ile aynı anlam.
            if (_location != LocationOptions.AllId) qs.Add($"location={Uri.EscapeDataString(_location)}");
            var url = "/api/stock/movements" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
            _rows = await Api.GetArrayAsync(url);

            // Gerçek toplam: AYNI filtreyle sayfalanmış uç, tek satır ister (ucuz sayım).
            var sayimUrl = "/api/stock/movements/grid?page=1&pageSize=1" + (qs.Count > 0 ? "&" + string.Join("&", qs) : "");
            var sayim = await Api.GetObjectAsync(sayimUrl);
            _gercekToplam = sayim.ValueKind == JsonValueKind.Object
                            && sayim.TryGetProperty("totalCount", out var tc) && tc.TryGetInt32(out var ti)
                ? ti : _rows.Length;
            _error = null;
        }
        // G1-07: hata SESSİZCE boş listeye dönüşmez — kullanıcı "hareket yok" ile "yüklenemedi"yi ayırt edebilmeli.
        catch
        {
            _rows = Array.Empty<JsonElement>();
            _error = "Stok hareketleri yüklenemedi. Bağlantınızı kontrol edip tekrar deneyin.";
        }
        finally { _busy = false; }
    }

    private async Task Clear() { _from = _to = null; _search = ""; _location = LocationOptions.AllId; await Load(); }

    private static string Str(JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
    private static decimal Dec(JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var d) ? d : 0m;
    private static int Int(JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetInt32(out var i) ? i : 0;
    private static bool Bool(JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.True;
    private static string DateText(JsonElement e)
        => e.TryGetProperty("createdAt", out var v) && v.TryGetInt64(out var ms)
            ? DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.ToString("dd.MM.yyyy HH:mm") : "";
    // STK-B1: hareket türü etiketi TEK KAYNAKTAN (MovementTypeOptions — Application'dan paylaşılan
    // dosya, bkz. DepoWise.Web.csproj). Eskiden burada ayrı bir switch vardı: `usage`/`usage_reverse`
    // HAM İngilizce sızıyordu, `adjustment`/`reverse` masaüstünden farklı adlanıyordu ve `count` için
    // ÖLÜ bir dal vardı (o bir doc_type'tır, movement_type değil — hiç eşleşmezdi).
    private static string TypeText(string t) => DepoWise.Application.Ui.MovementTypeOptions.Label(t);
    private static string NoteDoc(JsonElement e)
    {
        var note = Str(e, "note");
        var inv = Str(e, "invoiceNo");
        return string.Join(" · ", new[] { note, inv }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }
}
