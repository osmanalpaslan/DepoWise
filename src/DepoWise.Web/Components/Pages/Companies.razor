@page "/companies"
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<MudText Typo="Typo.h5" GutterBottom="true">Firma Tanım</MudText>

@if (Auth.CanCreate("companies"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:820px;">
        <MudText Typo="Typo.h6" Class="mb-2">@(_editId is null ? "Yeni Firma" : "Firma Düzenle")</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_name" Label="Firma Adı *" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="3"><MudTextField @bind-Value="_taxNo" Label="Vergi No" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="3"><MudTextField @bind-Value="_taxOffice" Label="Vergi Dairesi" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_phone" Label="Telefon" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_email" Label="E-posta" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_person" Label="Yetkili Kişi" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="2">
                <MudNumericField T="int" @bind-Value="_maxAdmins" Label="Maks. Admin (0 = ∞)" Min="0" Max="100000"
                                 Margin="Margin.Dense" Variant="Variant.Outlined" HelperText="Admin kullanıcı kotası" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudNumericField T="int" @bind-Value="_maxUsers" Label="Maks. Personel (0 = ∞)" Min="0" Max="100000"
                                 Margin="Margin.Dense" Variant="Variant.Outlined" HelperText="Normal kullanıcı kotası" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudNumericField T="int" @bind-Value="_machineQuota" Label="Makine Kotası (0 = ∞)" Min="0" Max="100000"
                                 Margin="Margin.Dense" Variant="Variant.Outlined" HelperText="Kayıtlı makine sayısı" />
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_address" Label="Adres" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            @* Yeni firmaya bağlı İLK şube/şantiye — firma şubesiz kalırsa o firmaya kullanıcı açılamaz. *@
            @if (_editId is null)
            {
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_branchName" Label="İlk Şube / Şantiye Adı *" Margin="Margin.Dense" Variant="Variant.Outlined"
                                  HelperText="Firma ile birlikte bu şube oluşturulur. Şubesiz firmaya kullanıcı eklenemez; sonradan Şube / Şantiye ekranından yenisi eklenebilir." />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_branchKind" Label="Türü" Margin="Margin.Dense" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("branch")">Şube</MudSelectItem>
                        <MudSelectItem T="string" Value="@("site")">Şantiye</MudSelectItem>
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>
        <MudStack Row="true" Class="mt-2" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Save" Disabled="_busy">
                @(_busy ? "Kaydediliyor…" : _editId is null ? "Firma Ekle" : "Değişiklikleri Kaydet")
            </MudButton>
            @if (_editId is not null) { <MudButton Variant="Variant.Text" OnClick="ClearForm">Vazgeç</MudButton> }
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">Firma Listesi</MudText><MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Yenile</MudButton>
    </MudStack>
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    @if (_items is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else
    {
        <MudTable Items="_items" Dense="true" Hover="true" Striped="true">
            <HeaderContent><MudTh>Firma</MudTh><MudTh>Vergi No</MudTh><MudTh>Telefon</MudTh><MudTh>Yetkili</MudTh><MudTh>Kullanıcı</MudTh><MudTh>Admin/Personel/Makine</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@(string.IsNullOrEmpty(context.TaxNo) ? "—" : context.TaxNo)</MudTd>
                <MudTd>@(string.IsNullOrEmpty(context.Phone) ? "—" : context.Phone)</MudTd>
                <MudTd>@(string.IsNullOrEmpty(context.AuthorizedPerson) ? "—" : context.AuthorizedPerson)</MudTd>
                <MudTd>@context.UserCount</MudTd>
                <MudTd>@Q(context.MaxAdmins) / @Q(context.MaxUsers) / @Q(context.MachineQuota)</MudTd>
                <MudTd>
                    @if (Auth.CanEdit("companies"))
                    {
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" OnClick="@(() => BeginEdit(context))" />
                    }
                    @if (Auth.IsSuperAdmin)
                    {
                        <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Delete" OnClick="@(() => Delete(context))" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@* ── Pasife alınmış firmalar (sözleşme yenileme / yeniden aktifleştirme) — yalnız süper admin ── *@
@if (Auth.IsSuperAdmin)
{
    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Warning" Class="mr-1" />
            <MudText Typo="Typo.h6">Pasif Firmalar (Sözleşme Yenileme)</MudText><MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDeleted">
                @(_showDeleted ? "Yenile" : "Göster")
            </MudButton>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
            Silinen firmalar buraya düşer; verileri ve pasife alınan kullanıcıları saklanır. "Aktife Al" ile firma
            geri gelir ve kullanıcılar tekrar giriş yapabilir hale gelir.
        </MudText>
        @if (_showDeleted)
        {
            @if (_deleted is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
            else if (_deleted.Count == 0) { <MudText Class="mud-text-secondary">Pasif firma yok.</MudText> }
            else
            {
                <MudTable Items="_deleted" Dense="true" Hover="true" Striped="true">
                    <HeaderContent><MudTh>Firma</MudTh><MudTh>Vergi No</MudTh><MudTh>Yetkili</MudTh><MudTh>Kullanıcı</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@(string.IsNullOrEmpty(context.TaxNo) ? "—" : context.TaxNo)</MudTd>
                        <MudTd>@(string.IsNullOrEmpty(context.AuthorizedPerson) ? "—" : context.AuthorizedPerson)</MudTd>
                        <MudTd>@context.UserCount</MudTd>
                        <MudTd Style="text-align:right">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Restore" OnClick="@(() => Reactivate(context))">Aktife Al</MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
        @if (_delMsg is not null) { <MudAlert Severity="@(_delOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_delMsg</MudAlert> }
    </MudPaper>
}

@code {
    private List<CompanyDto>? _items;
    private string? _error;
    private string? _editId;
    private string _name = "", _taxNo = "", _taxOffice = "", _phone = "", _email = "", _person = "", _address = "";
    private int _maxUsers;
    private int _maxAdmins;
    private int _machineQuota = 3;
    private string _branchName = "", _branchKind = "branch";   // yeni firmanın ilk şubesi
    private string? _msg; private bool _ok; private bool _busy;

    private static string Q(int v) => v <= 0 ? "∞" : v.ToString();

    protected override async Task OnInitializedAsync() { if (Auth.IsAuthenticated) await Load(); }

    private async Task Load()
    {
        _error = null;
        try { _items = await Api.GetCompaniesAsync(); }
        catch (Exception ex) { _error = "Yüklenemedi: " + ex.Message; }
    }

    private async Task BeginEdit(CompanyDto c)
    {
        if (!await Dialog.Confirm("Bu kaydı düzenlemek istiyor musunuz?", okText: "Evet, Düzenle")) return;
        _editId = c.Id;
        _name = c.Name; _taxNo = c.TaxNo ?? ""; _phone = c.Phone ?? ""; _person = c.AuthorizedPerson ?? "";
        _email = c.Email ?? ""; _taxOffice = ""; _address = ""; _maxUsers = c.MaxUsers;
        _maxAdmins = c.MaxAdmins; _machineQuota = c.MachineQuota;
        _msg = null;
    }

    private async Task Delete(CompanyDto c)
    {
        if (!await Dialog.Confirm($"'{c.Name}' firması silinsin mi? Bağlı kullanıcılar SİLİNMEZ, pasife alınır; firma 'Pasif Firmalar' bölümünden geri getirilebilir.", "Evet, Sil", danger: true)) return;
        var err = await Api.DeleteAsync($"/api/companies/{c.Id}");
        _ok = err is null; _msg = err ?? "Firma pasife alındı. Geri getirmek için aşağıdaki 'Pasif Firmalar' bölümünü kullanın.";
        await Load();
        if (_showDeleted) await LoadDeleted();
    }

    // ── Pasif firmalar ──
    private bool _showDeleted;
    private List<CompanyDto>? _deleted;
    private string? _delMsg; private bool _delOk;

    private async Task LoadDeleted()
    {
        _showDeleted = true; _deleted = null; _delMsg = null;
        try { _deleted = await Api.GetDeletedCompaniesAsync(); }
        catch (Exception ex) { _delMsg = "Yüklenemedi: " + ex.Message; _delOk = false; _deleted = new(); }
    }

    private async Task Reactivate(CompanyDto c)
    {
        if (!await Dialog.Confirm($"'{c.Name}' firması yeniden aktifleştirilsin mi? Firma geri gelir ve bu firmada silme sırasında pasife alınan kullanıcılar tekrar giriş yapabilir hale gelir.", "Evet, Aktife Al")) return;
        _delMsg = null;
        var err = await Api.PostAsync($"/api/companies/{c.Id}/reactivate", new { });
        _delOk = err is null; _delMsg = err ?? $"'{c.Name}' yeniden aktifleştirildi.";
        if (_delOk) { await Load(); await LoadDeleted(); }
    }

    private void ClearForm()
    {
        _editId = null;
        _name = _taxNo = _taxOffice = _phone = _email = _person = _address = ""; _maxUsers = 0;
        _maxAdmins = 0; _machineQuota = 3; _branchName = ""; _branchKind = "branch";
        _msg = null;
    }

    private async Task Save()
    {
        _msg = null;
        if (string.IsNullOrWhiteSpace(_name)) { _msg = "Firma adı zorunlu."; _ok = false; return; }
        if (_editId is null && string.IsNullOrWhiteSpace(_branchName)) { _msg = "İlk şube / şantiye adı zorunlu."; _ok = false; return; }
        if (!await Dialog.Confirm(_editId is null
                ? $"Yeni firma eklensin mi? '{_branchName.Trim()}' şubesi de bu firmaya bağlı oluşturulacak."
                : "Firma bilgileri güncellensin mi?")) return;
        _busy = true;
        try
        {
            var body = new
            {
                name = _name.Trim(), taxNo = _taxNo, taxOffice = _taxOffice,
                address = _address, phone = _phone, email = _email, authorizedPerson = _person,
                maxUsers = _maxUsers, maxAdmins = _maxAdmins, machineQuota = _machineQuota
            };
            string? err;
            if (_editId is null)
            {
                string? newId;
                (err, newId) = await Api.CreateAsync("/api/companies", body);
                // Firma oluştu → ilk şubeyi AYNI firmaya bağla (companyId'yi süper admin gönderebilir).
                if (err is null && !string.IsNullOrEmpty(newId))
                {
                    var bErr = await Api.PostAsync("/api/branches",
                        new { name = _branchName.Trim(), kind = _branchKind, companyId = newId });
                    if (bErr is not null)
                    {
                        // Firma kaydı DURUYOR; yalnız şube açılamadı — kullanıcıyı yanıltmadan söyle.
                        _ok = false;
                        _msg = $"Firma eklendi, ancak şube oluşturulamadı: {bErr} Şube / Şantiye ekranından elle ekleyin.";
                        await Load();
                        return;
                    }
                }
            }
            else err = await Api.PutAsync($"/api/companies/{_editId}", body);
            _ok = err is null;
            _msg = err ?? (_editId is null ? $"Firma ve '{_branchName.Trim()}' şubesi eklendi." : "Güncellendi.");
            if (_ok) { ClearForm(); await Load(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }
}
