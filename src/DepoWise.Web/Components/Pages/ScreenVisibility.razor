@page "/screen-visibility"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

@* ═══ MENÜ / EKRAN YÖNETİMİ ═══════════════════════════════════════════════════════════════════
   G5 (2026-08-12) platform görünürlüğü + MNU (2026-08-18) menü düzeni AYNI ekranda toplanmıştır:
   ikisi de aynı 59 ekranı yönetir, ayrı ekranlara bölmek aynı listeyi iki yerden yönetmek olurdu.

   ⚠️ BU EKRAN KİMLİK DEĞİŞTİRMEZ: route, ekran anahtarı, yetki anahtarı, servis ve API uçları
   buradan ETKİLENMEZ. Yalnız menüde NE YAZDIĞI, NEREDE ve KAÇINCI SIRADA durduğu ile o ekranın
   hangi platformda açık olduğu belirlenir.

   ⚠️ YETKİ EKRANI DEĞİLDİR: kullanıcıya yetki vermez, yetkiyi bypass etmez.
   ERİŞİM = PLATFORM_AKTİF && YETKİ_VAR. Yalnız süper admin (AppModules.IsSuperAdminOnly).

   TEK KAYDETME AKIŞI: "Düzenle → değiştir → Kaydet".
   Ad · üst menü · sıra · MASAÜSTÜ/WEB kutuları — hepsi aynı düzenleme modunda değiştirilir ve
   Kaydet ile birlikte yazılır.

   ⚠️ DÜZELTME (2026-08-19, kullanıcı bildirimi): platform kutuları önce "anında kaydeden" ayrı bir
   akıştaydı ve bu yüzden DÜZENLEME MODUNDA KİLİTLİYDİ. Kullanıcı Düzenle'ye bastığında kutular
   kapanıyor, basmadığında ise ekranın salt-okunur olduğunu sanıyordu → platform ayrımı fiilen
   yapılamıyordu. Tek akışa indirildi. *@

<PageTitle>Menü / Ekran Yönetimi — Alpnex</PageTitle>

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Menü / Ekran Yönetimi</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b></MudText>
    </div>
</div>

@if (!Auth.IsSuperAdmin)
{
    <MudAlert Severity="Severity.Warning">Bu ekran için yetkiniz yok.</MudAlert>
}
else
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">
        <b>Düzenle</b> düğmesine basın, istediğinizi değiştirin, <b>Kaydet</b> deyin. Ekranların menüde
        <b>hangi adla</b>, <b>hangi üst menüde</b>, <b>kaçıncı sırada</b> görüneceğini ve
        <b>Masaüstü / Web</b> kutularıyla hangi uygulamada kullanılabilir olacağını buradan
        belirlersiniz. Bu ayarlar <b>yetki değildir</b>: adı değişen ekran yine yalnız
        <b>yetkisi olan</b> kullanıcıya görünür. Ayarlar <b>yalnız bu firmayı</b> etkiler.
        Ekranın adresi ve yetkisi <b>değişmez</b>.
        <br />
        <b>Masaüstü kutusu için not:</b> ayar, masaüstü uygulamasına giriş sırasında iner. Bunun için
        makinedeki uygulamanın <b>bu özelliği içeren sürümde</b> olması gerekir; eski sürümdeki
        makineler ayarı almaz ve varsayılan menüyle çalışmaya devam eder.
    </MudAlert>

    @if (_msg is not null)
    {
        <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mb-3">@_msg</MudAlert>
    }

    @if (_rows is null)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
    }
    else
    {
        @* ── Araç çubuğu ──────────────────────────────────────────────────────────────────── *@
        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <div class="d-flex flex-wrap align-center" style="gap:12px;">
                <MudTextField @bind-Value="_q" Immediate="true" Placeholder="Ekran adı veya adres ara..."
                              Label="Ara" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                              Style="max-width:280px;" aria-label="Ekran ara" />

                <div>
                    <label for="f-grup" style="font-size:12px;display:block;">Üst Menü</label>
                    <select id="f-grup" aria-label="Üst menüye göre filtrele" @bind="_fGroup" class="mnu-select">
                        <option value="">(Tümü)</option>
                        @foreach (var g in _groups) { <option value="@g.GroupKey">@g.Title</option> }
                    </select>
                </div>

                <div>
                    <label for="f-platform" style="font-size:12px;display:block;">Platform</label>
                    <select id="f-platform" aria-label="Platforma göre filtrele" @bind="_fPlatform" class="mnu-select">
                        <option value="">(Tümü)</option>
                        <option value="desktop">Masaüstünde açık</option>
                        <option value="web">Web'de açık</option>
                        <option value="both">İkisinde de açık</option>
                        <option value="none">Kapalı</option>
                    </select>
                </div>

                <div>
                    <label for="f-durum" style="font-size:12px;display:block;">Durum</label>
                    <select id="f-durum" aria-label="Duruma göre filtrele" @bind="_fState" class="mnu-select">
                        <option value="">(Tümü)</option>
                        <option value="custom">Değiştirilmiş</option>
                        <option value="default">Varsayılan</option>
                    </select>
                </div>

                <MudSpacer />

                @if (!_edit)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" aria-label="Düzeni düzenle"
                               StartIcon="@Icons.Material.Filled.Edit" OnClick="BeginEdit">Düzenle</MudButton>
                    <MudButton Variant="Variant.Outlined" aria-label="Menüyü önizle"
                               StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => _preview = !_preview)">
                        Menüyü Önizle
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" aria-label="Varsayılan düzene dön"
                               StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetDefaults">
                        Varsayılan Düzene Dön
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" aria-label="Yeni üst menü ekle"
                               StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="AddGroup">+ Üst Menü</MudButton>
                    <MudButton Variant="Variant.Outlined" aria-label="Yeni üst grup ekle"
                               StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="AddSection">+ Üst Grup</MudButton>
                    <MudButton Variant="Variant.Outlined" aria-label="Menüyü önizle"
                               StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => _preview = !_preview)">
                        Menüyü Önizle
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" aria-label="Değişiklikleri kaydet"
                               StartIcon="@Icons.Material.Filled.Save" OnClick="Save">Kaydet</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="_busy" aria-label="Değişiklikleri iptal et"
                               OnClick="CancelEdit">Değişiklikleri İptal Et</MudButton>
                }
            </div>

            @if (_edit)
            {
                var (ds, dg, dr) = Diff();
                <MudAlert Severity="@(ds + dg + dr == 0 ? Severity.Normal : Severity.Warning)" Dense="true" Class="mt-3">
                    @if (ds + dg + dr == 0)
                    {
                        <span>Henüz değişiklik yapmadınız.</span>
                    }
                    else
                    {
                        <span><b>Kaydedilmemiş değişiklik:</b> @ds ekran (ad / üst menü / platform), @dg üst menü,
                            @dr grupta sıralama. Kaydetmeden sayfadan ayrılırsanız bu değişiklikler kaybolur.</span>
                    }
                </MudAlert>
            }
        </MudPaper>

        @* ── Menü önizleme ────────────────────────────────────────────────────────────────── *@
        @if (_preview)
        {
            <MudPaper Class="pa-3 mb-3" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">
                    Menü Önizleme <span class="mud-text-secondary" style="font-size:13px;">
                        (kaydedilmemiş değişiklikler dahil · yalnız menüde görünen ekranlar)</span>
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Not: burada <b>platformda açık</b> ekranlar listelenir. Her kullanıcı bunlardan
                    yalnız <b>yetkisi olanları</b> görür.
                </MudText>
                <div class="d-flex flex-wrap" style="gap:24px;">
                    @foreach (var (baslik, plat) in new[] { ("WEB", "web"), ("MASAÜSTÜ", "desktop") })
                    {
                        <div style="min-width:240px;">
                            <MudText Typo="Typo.overline"><b>@baslik</b></MudText>
                            @foreach (var g in PreviewGroups(plat))
                            {
                                <div class="mt-1" style="@($"padding-left:{g.Depth * 12}px;")"><b>@g.Title</b></div>
                                @foreach (var r in g.Rows)
                                {
                                    <div style="@($"padding-left:{g.Depth * 12 + 16}px;")">• @r.Label</div>
                                }
                            }
                        </div>
                    }
                </div>
            </MudPaper>
        }

        @* ── Üst menüler (yalnız düzenleme modunda) ───────────────────────────────────────── *@
        @if (_edit)
        {
            <MudPaper Class="pa-3 mb-3" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Üst Menüler</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Adı değiştirmek güvenlidir: sistem grubu <b>anahtarıyla</b> tanır, gösterilen adla değil.
                </MudText>
                <MudSimpleTable Dense="true" Striped="true">
                    <thead>
                        <tr><th style="width:70px;">Sıra</th><th>Görünen Ad</th><th style="width:80px;">Tür</th>
                            <th style="width:190px;">ÜST GRUP</th><th>Sistem Anahtarı</th>
                            <th style="width:90px;">Ekran</th><th style="width:150px;">İşlem</th></tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _groups.Count; i++)
                        {
                            var gi = i; var g = _groups[gi];
                            <tr @key="g.GroupKey">
                                <td>@(gi + 1)</td>
                                <td>
                                    <input class="mnu-input" value="@g.Title" aria-label="@($"{g.GroupKey} üst menü adı")"
                                           @onchange="@(e => g.Title = (e.Value?.ToString() ?? "").Trim())" />
                                </td>
                                <td>
                                    @if (g.IsSection)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Üst Grup</MudChip>
                                    }
                                    else
                                    {
                                        <span class="mud-text-secondary" style="font-size:12px;">Üst Menü</span>
                                    }
                                </td>
                                <td>
                                    @* SEC: yalnız ÜST MENÜLER bir üst gruba bağlanabilir. Üst grubun kendisi
                                       başka bir üst grubun altına konulamaz → menü ikiden fazla derinleşmez. *@
                                    @if (!g.IsSection)
                                    {
                                        <select class="mnu-select" aria-label="@($"{g.GroupKey} bagli oldugu ust grup")"
                                                value="@(g.ParentGroupKey ?? "")"
                                                @onchange="@(e => g.ParentGroupKey = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                                            <option value="">(üst grup yok)</option>
                                            @foreach (var s2 in _groups.Where(x => x.IsSection))
                                            {
                                                <option value="@s2.GroupKey">@s2.Title</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="mud-text-secondary" style="font-size:12px;">—</span>
                                    }
                                </td>
                                <td><span class="mud-text-secondary" style="font-size:12px;">@g.GroupKey</span></td>
                                <td>@(g.IsSection ? ChildGroupCount(g.GroupKey) : ScreenCount(g.GroupKey))</td>
                                <td>
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                   aria-label="@($"{g.Title} üst menüsünü yukarı taşı")"
                                                   Disabled="@(gi == 0)" OnClick="@(() => MoveGroup(gi, -1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                   aria-label="@($"{g.Title} üst menüsünü aşağı taşı")"
                                                   Disabled="@(gi == _groups.Count - 1)" OnClick="@(() => MoveGroup(gi, 1))" />
                                    @if (g.IsCustom || g.IsSection)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       aria-label="@($"{g.Title} {(g.IsSection ? "üst grubunu" : "üst menüsünü")} kaldır")"
                                                       OnClick="@(() => RemoveGroup(g))" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }

        @* ── Ekranlar ─────────────────────────────────────────────────────────────────────── *@
        <MudPaper Class="pa-2" Elevation="2">
            <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="overflow-x:auto;">
                <thead>
                    <tr>
                        <th style="width:60px;">SIRA</th>
                        <th>EKRAN ADI</th>
                        <th>SİSTEM ANAHTARI</th>
                        <th>ADRES</th>
                        <th style="width:190px;">ÜST MENÜ</th>
                        <th style="width:100px;text-align:center;">MASAÜSTÜ</th>
                        <th style="width:100px;text-align:center;">WEB</th>
                        <th style="width:150px;">PLATFORM</th>
                        <th>YETKİ</th>
                        <th style="width:110px;">İŞLEM</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in VisibleGroups())
                    {
                        var gk = "grp:" + g;   // @key için ekran anahtarlarıyla çakışmayan kimlik
                        <tr @key="gk"><td colspan="10" class="mud-theme-primary"><b>@GroupTitle(g)</b></td></tr>
                        @foreach (var r in VisibleRows(g))
                        {
                            var row = r;
                            @* ⭐ @key ZORUNLU: satırlar taşınıp yeniden sıralandığı için Blazor öğeleri
                               KONUMA göre yeniden kullanırsa, kullanıcının elle değiştirdiği <select>/<input>
                               DOM değerleri bir sonraki satıra yapışık kalır ve yanlış grup gösterilir
                               (GUI turunda bizzat görüldü: taşınan satırın altındaki ekran "Yönetim"
                               seçili görünüyordu, oysa C# tarafı doğruydu). @key öğeyi SATIRIN KİMLİĞİNE
                               bağlar → Blazor öğeyi taşır, yeniden kullanmaz. *@
                            var rowKey = row.ScreenKey + "#" + _rev;
                            <tr @key="rowKey">
                                <td>@(IndexInGroup(row) + 1)</td>
                                <td>
                                    @if (_edit && !row.IsProtected)
                                    {
                                        <input class="mnu-input" value="@row.Label" aria-label="@($"{row.ScreenKey} ekran adı")"
                                               @onchange="@(e => row.Label = (e.Value?.ToString() ?? "").Trim())" />
                                    }
                                    else
                                    {
                                        @row.Label
                                        @if (row.IsProtected)
                                        {
                                            <MudTooltip Text="Sistem için kritik ekran — adı ve yeri korunur.">
                                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="ml-1" />
                                            </MudTooltip>
                                        }
                                    }
                                    @if (!string.Equals(row.Label, row.CatalogLabel, StringComparison.Ordinal))
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                            özgün ad: @row.CatalogLabel
                                        </MudText>
                                    }
                                </td>
                                <td><span class="mud-text-secondary" style="font-size:12px;">@row.ScreenKey</span></td>
                                <td><span class="mud-text-secondary" style="font-size:12px;">@(row.WebRoute is null ? "—" : "/" + row.WebRoute)</span></td>
                                <td>
                                    @if (_edit && !row.IsProtected)
                                    {
                                        @* ⚠️ ÜST GRUPLAR bu listede YER ALMAZ: bir ekran doğrudan üst gruba
                                           bağlanamaz, yalnız bir ÜST MENÜYE bağlanır. Hiyerarşi tek yönlüdür:
                                           ÜST GRUP → ÜST MENÜ → EKRAN. *@
                                        <select class="mnu-select" aria-label="@($"{row.ScreenKey} üst menüsü")"
                                                value="@row.GroupKey"
                                                @onchange="@(e => MoveToGroup(row, e.Value?.ToString() ?? row.GroupKey))">
                                            @foreach (var gg in _groups.Where(x => !x.IsSection)) { <option value="@gg.GroupKey">@gg.Title</option> }
                                        </select>
                                    }
                                    else
                                    {
                                        @GroupTitle(row.GroupKey)
                                    }
                                </td>
                                @* NATIVE onay kutusu (MudCheckBox DEĞİL): MudBlazor gerçek <input>'u görsel
                                   olarak gizlediği için erişilebilirlik ağacında görünmüyor ve gerçek tarayıcı
                                   otomasyonuyla TIKLANAMIYOR (GUI turunda tespit edildi). §22 gereği yerel,
                                   etiketli ve klavyeyle erişilebilir bir kutu kullanılır. Davranış aynıdır. *@
                                <td style="text-align:center;">
                                    <input type="checkbox" class="mnu-check"
                                           aria-label="@($"{row.ScreenKey} masaüstünde açık")"
                                           checked="@row.EffectiveDesktop"
                                           disabled="@(_busy || !_edit || !row.DefaultDesktop)"
                                           @onchange="@(e => row.EffectiveDesktop = e.Value is bool b && b)" />
                                    @if (!row.DefaultDesktop) { <MudText Typo="Typo.caption" Class="mud-text-secondary">yok</MudText> }
                                </td>
                                <td style="text-align:center;">
                                    <input type="checkbox" class="mnu-check"
                                           aria-label="@($"{row.ScreenKey} web'de açık")"
                                           checked="@row.EffectiveWeb"
                                           disabled="@(_busy || !_edit || !row.DefaultWeb)"
                                           @onchange="@(e => row.EffectiveWeb = e.Value is bool b2 && b2)" />
                                    @if (!row.DefaultWeb) { <MudText Typo="Typo.caption" Class="mud-text-secondary">yok</MudText> }
                                </td>
                                <td>@row.LivePlatformText</td>
                                <td><span class="mud-text-secondary" style="font-size:12px;">@row.PermissionKey</span></td>
                                <td>
                                    @if (_edit && !row.IsProtected)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                       aria-label="@($"{row.ScreenKey} ekranını yukarı taşı")"
                                                       Disabled="@(IndexInGroup(row) == 0)" OnClick="@(() => MoveScreen(row, -1))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                       aria-label="@($"{row.ScreenKey} ekranını aşağı taşı")"
                                                       Disabled="@(IndexInGroup(row) == GroupRows(row.GroupKey).Count - 1)"
                                                       OnClick="@(() => MoveScreen(row, 1))" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

<style>
    .mnu-select, .mnu-input {
        padding: 4px 6px; border: 1px solid var(--mud-palette-lines-inputs);
        border-radius: 4px; background: transparent; color: inherit; font-size: 13px; min-width: 140px;
    }
    .mnu-input { width: 100%; }
    .mnu-check { width: 18px; height: 18px; cursor: pointer; }
    .mnu-check:disabled { cursor: not-allowed; opacity: .45; }
</style>

@code {
    // ═══ Yerel düzenleme modeli ═════════════════════════════════════════════════════════════
    // Sunucudan gelen satırlar burada DÜZENLENİR; "Kaydet" denene kadar sunucuya hiçbir düzen
    // değişikliği gitmez (§12). Platform kutuları bunun DIŞINDADIR: anında kaydeder (bkz. Toggle).
    private sealed class Row
    {
        public string ScreenKey { get; set; } = "";
        public string CatalogLabel { get; set; } = "";
        public string CatalogGroup { get; set; } = "";
        public string PermissionKey { get; set; } = "";
        public string? WebRoute { get; set; }
        public bool DefaultDesktop { get; set; }
        public bool DefaultWeb { get; set; }
        public bool EffectiveDesktop { get; set; }
        public bool EffectiveWeb { get; set; }
        public string PlatformText { get; set; } = "";
        public bool IsProtected { get; set; }

        // Düzenlenebilir alanlar
        public string Label { get; set; } = "";
        public string GroupKey { get; set; } = "";

        // "İptal" için başlangıç fotoğrafı
        public string OrigLabel { get; set; } = "";
        public string OrigGroupKey { get; set; } = "";
        public int OrigIndex { get; set; }   // yüklenirken listedeki genel sıra (sıra karşılaştırması için)
        public bool OrigDesktop { get; set; }
        public bool OrigWeb { get; set; }

        /// <summary>Platform tercihi değişti mi (kaydedilmemiş)?</summary>
        public bool PlatformChanged => EffectiveDesktop != OrigDesktop || EffectiveWeb != OrigWeb;

        /// <summary>O anki (kaydedilmemiş dahil) platform metni — kolonda anında görünsün.</summary>
        public string LivePlatformText => (EffectiveDesktop, EffectiveWeb) switch
        {
            (true, true) => "Masaüstü + Web",
            (true, false) => "Yalnız Masaüstü",
            (false, true) => "Yalnız Web",
            _ => "Kapalı",
        };
    }

    private sealed class Grp
    {
        public string GroupKey { get; set; } = "";
        public string Title { get; set; } = "";
        public bool IsCustom { get; set; }
        public string OrigTitle { get; set; } = "";
        public int OrigOrder { get; set; }

        // ── SEC (2026-08-19): menünün üçüncü seviyesi ──────────────────────────────────────
        /// <summary>Bu satır bir ÜST GRUP mu (altında üst menüler bulunur, kendi ekranı yoktur)?</summary>
        public bool IsSection { get; set; }
        /// <summary>Bağlı olduğu üst grubun anahtarı; null = en üst seviyede.</summary>
        public string? ParentGroupKey { get; set; }
        public string? OrigParentGroupKey { get; set; }
    }

    private List<Row>? _rows;
    private List<Grp> _groups = new();

    /// <summary>
    /// ⭐ Yeniden çizim sürümü — her <see cref="Load"/> sonrası artar ve satır <c>@key</c>'ine girer.
    ///
    /// NEDEN: Blazor, DOM'u kullanıcının ELLE değiştirdiğini bilmez. Kullanıcı bir onay kutusunu
    /// tıkladığında DOM anında değişir; sunucu bu değişikliği REDDEDERSE (ör. korumalı ekran) ya da
    /// kullanıcı onay penceresinde vazgeçerse, yeni değer eskisiyle AYNI olduğu için Blazor hiçbir
    /// fark üretmez ve <b>kutu yanlış durumda kalır</b> — kullanıcı ekranı kapattığını sanır.
    /// GUI turunda bizzat görüldü. Sürüm anahtarı satırları yeniden OLUŞTURDUĞU için DOM sunucudaki
    /// gerçek duruma döner. Düzenleme sırasında Load çağrılmadığından taşıma davranışı etkilenmez.
    /// </summary>
    private int _rev;
    private string? _msg; private bool _ok; private bool _busy; private bool _edit; private bool _preview;
    private string _q = "", _fGroup = "", _fPlatform = "", _fState = "";

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsSuperAdmin) await Load();
    }

    private async Task Load()
    {
        _rows = null;
        try
        {
            var json = await Api.GetObjectAsync("/api/screens/layout/manage");
            var rows = new List<Row>();
            if (json.TryGetProperty("screens", out var sa) && sa.ValueKind == JsonValueKind.Array)
                foreach (var e in sa.EnumerateArray())
                    rows.Add(new Row
                    {
                        ScreenKey = S(e, "screenKey"),
                        CatalogLabel = S(e, "catalogLabel"),
                        CatalogGroup = S(e, "catalogGroup"),
                        PermissionKey = S(e, "permissionKey"),
                        WebRoute = SN(e, "webRoute"),
                        DefaultDesktop = B(e, "defaultDesktop"),
                        DefaultWeb = B(e, "defaultWeb"),
                        EffectiveDesktop = B(e, "effectiveDesktop"),
                        EffectiveWeb = B(e, "effectiveWeb"),
                        PlatformText = S(e, "platformText"),
                        IsProtected = B(e, "isProtected"),
                        Label = S(e, "label"),
                        GroupKey = S(e, "groupKey"),
                    });

            var groups = new List<Grp>();
            if (json.TryGetProperty("groups", out var ga) && ga.ValueKind == JsonValueKind.Array)
                foreach (var e in ga.EnumerateArray())
                    groups.Add(new Grp
                    {
                        GroupKey = S(e, "groupKey"),
                        Title = S(e, "title"),
                        IsCustom = B(e, "isCustom"),
                        IsSection = B(e, "isSection"),
                        ParentGroupKey = SN(e, "parentGroupKey"),
                    });

            _groups = groups;
            _rev++;                  // satırları yeniden oluştur → elle değişmiş DOM sunucu durumuna döner
            _rows = rows;
            Snapshot();
        }
        catch (Exception ex) { _ok = false; _msg = "Liste alınamadı: " + ex.Message; _rows = new(); }
    }

    /// <summary>"İptal" ve "kaç şey değişti" için başlangıç fotoğrafı.</summary>
    private void Snapshot()
    {
        for (int i = 0; i < _groups.Count; i++)
        { _groups[i].OrigTitle = _groups[i].Title; _groups[i].OrigOrder = i;
          _groups[i].OrigParentGroupKey = _groups[i].ParentGroupKey; }

        for (int i = 0; i < _rows!.Count; i++)
        { var r = _rows[i]; r.OrigLabel = r.Label; r.OrigGroupKey = r.GroupKey; r.OrigIndex = i;
          r.OrigDesktop = r.EffectiveDesktop; r.OrigWeb = r.EffectiveWeb; }
    }

    private void BeginEdit() { _edit = true; _msg = null; }

    private async Task CancelEdit()
    {
        var (ds, dg, dr) = Diff();
        if (ds + dg + dr > 0 && !await Dialog.Confirm(
            $"Kaydedilmemiş değişiklikler ATILACAK ({ds} ekran, {dg} üst menü, {dr} grupta sıralama)." +
            "\n\nDevam edilsin mi?", "Evet, At", danger: true)) return;
        _edit = false; _msg = null;
        await Load();   // sunucudaki gerçek duruma dön
    }

    /// <summary>
    /// Kaydedilmemiş değişiklik sayısı: (adı/üst menüsü değişen ekran, değişen üst menü,
    /// sırası bozulan grup).
    ///
    /// ⚠️ Sıra DEĞİŞİKLİĞİ ekran ekran sayılmaz: bir ekran gruptan çıkınca geri kalanların index'i
    /// kayar ve hiç dokunulmadıkları hâlde "değişti" gibi görünürlerdi (ilk GUI turunda 1 taşıma
    /// "7 ekran" olarak raporlanıyordu). Bunun yerine grubun ekran DİZİLİMİ, o ekranların
    /// başlangıçtaki göreli sırasıyla karşılaştırılır.
    /// </summary>
    private (int Screens, int Groups, int Reordered) Diff()
    {
        if (_rows is null) return (0, 0, 0);

        int s = _rows.Count(r => !string.Equals(r.Label, r.OrigLabel, StringComparison.Ordinal)
                              || !string.Equals(r.GroupKey, r.OrigGroupKey, StringComparison.Ordinal)
                              || r.PlatformChanged);

        int g = 0;
        for (int i = 0; i < _groups.Count; i++)
            if (!string.Equals(_groups[i].Title, _groups[i].OrigTitle, StringComparison.Ordinal)
                || !string.Equals(_groups[i].ParentGroupKey ?? "", _groups[i].OrigParentGroupKey ?? "", StringComparison.Ordinal)
                || _groups[i].OrigOrder != i) g++;

        // Grubun dizilimi, üyelerin BAŞLANGIÇTAKİ genel sırasına göre artan değilse sıra bozulmuştur.
        int r2 = _groups.Count(grp =>
        {
            var keys = GroupRows(grp.GroupKey).Select(x => x.OrigIndex).ToList();
            for (int i = 1; i < keys.Count; i++) if (keys[i] < keys[i - 1]) return true;
            return false;
        });

        return (s, g, r2);
    }

    // ═══ Düzen işlemleri ════════════════════════════════════════════════════════════════════
    private List<Row> GroupRows(string groupKey)
        => _rows!.Where(r => string.Equals(r.GroupKey, groupKey, StringComparison.Ordinal)).ToList();

    private int IndexInGroup(Row r) => GroupRows(r.GroupKey).IndexOf(r);

    private int ScreenCount(string groupKey) => GroupRows(groupKey).Count;

    private string GroupTitle(string groupKey)
        => _groups.FirstOrDefault(g => string.Equals(g.GroupKey, groupKey, StringComparison.Ordinal))?.Title ?? groupKey;

    /// <summary>Ekranı grup içinde bir yukarı/aşağı taşır (listedeki fiziksel yerini değiştirir).</summary>
    private void MoveScreen(Row r, int delta)
    {
        var grup = GroupRows(r.GroupKey);
        int i = grup.IndexOf(r), j = i + delta;
        if (i < 0 || j < 0 || j >= grup.Count) return;
        int a = _rows!.IndexOf(grup[i]), b = _rows.IndexOf(grup[j]);
        (_rows[a], _rows[b]) = (_rows[b], _rows[a]);
    }

    private void MoveGroup(int i, int delta)
    {
        int j = i + delta;
        if (j < 0 || j >= _groups.Count) return;
        (_groups[i], _groups[j]) = (_groups[j], _groups[i]);
    }

    /// <summary>Ekranı başka üst menüye taşır — hedef grubun SONUNA eklenir.</summary>
    private void MoveToGroup(Row r, string groupKey)
    {
        if (string.Equals(r.GroupKey, groupKey, StringComparison.Ordinal)) return;
        _rows!.Remove(r);
        r.GroupKey = groupKey;
        var hedef = GroupRows(groupKey);
        int at = hedef.Count == 0 ? _rows.Count : _rows.IndexOf(hedef[^1]) + 1;
        _rows.Insert(at, r);
    }

    private async Task AddGroup()
    {
        // Mevcut metin-giriş penceresi yeniden kullanılır (yeni bir bileşen eklenmedi).
        var ad = await Dialog.AskReason(
            "Yeni bir üst menü oluşturulacak. Ekranları buraya taşıyabilirsiniz.",
            "Yeni Üst Menü", "Üst menü adı", "Oluştur");
        if (string.IsNullOrWhiteSpace(ad)) return;
        _groups.Add(new Grp
        {
            GroupKey = "custom:" + Guid.NewGuid().ToString("N")[..8],
            Title = ad.Trim(),
            IsCustom = true,
            OrigTitle = "",
            OrigOrder = -1,
        });
    }

    /// <summary>
    /// SEC — yeni ÜST GRUP oluşturur (menünün üçüncü seviyesi). Üst grup ekran taşımaz; altına
    /// üst menüler bağlanır ve menüde onları tek başlık altında toplar.
    /// </summary>
    private async Task AddSection()
    {
        var ad = await Dialog.AskReason(
            "Yeni bir ÜST GRUP oluşturulacak. Üst menüleri bunun altında toplayabilirsiniz.",
            "Yeni Üst Grup", "Üst grup adı", "Oluştur");
        if (string.IsNullOrWhiteSpace(ad)) return;
        _groups.Add(new Grp
        {
            GroupKey = "section:" + Guid.NewGuid().ToString("N")[..8],
            Title = ad.Trim(),
            IsCustom = true,
            IsSection = true,
            OrigTitle = "",
            OrigOrder = -1,
        });
    }

    /// <summary>Bir üst grubun altındaki üst menü sayısı (yönetim listesinde gösterilir).</summary>
    private int ChildGroupCount(string sectionKey)
        => _groups.Count(x => string.Equals(x.ParentGroupKey, sectionKey, StringComparison.Ordinal));

    /// <summary>Kullanıcı grubunu kaldırır. ⭐ Altında ekran varsa ÖNCE açıkça bildirir (yetim ekran yok).</summary>
    private async Task RemoveGroup(Grp g)
    {
        // SEC: ÜST GRUP kaldırılıyorsa önce altındaki üst menüler serbest bırakılır → yetim düğüm olmaz.
        if (g.IsSection)
        {
            var bagliOlanlar = _groups.Where(x => string.Equals(x.ParentGroupKey, g.GroupKey, StringComparison.Ordinal)).ToList();
            if (bagliOlanlar.Count > 0 && !await Dialog.Confirm(
                $"\"{g.Title}\" üst grubunun altında {bagliOlanlar.Count} üst menü var.\n\n" +
                "Üst grup kaldırılırsa bu üst menüler en üst seviyeye geri döner. " +
                "Hiçbir ekran ve hiçbir üst menü kaybolmaz.\n\nDevam edilsin mi?",
                "Evet, Kaldır", danger: true)) return;
            foreach (var x in bagliOlanlar) x.ParentGroupKey = null;
            _groups.Remove(g);
            return;
        }

        var icindekiler = GroupRows(g.GroupKey);
        if (icindekiler.Count > 0)
        {
            if (!await Dialog.Confirm(
                $"\"{g.Title}\" üst menüsünde {icindekiler.Count} ekran var.\n\n" +
                "Grup kaldırılırsa bu ekranlar KENDİ ÖZGÜN üst menülerine geri döner. " +
                "Hiçbir ekran kaybolmaz.\n\nDevam edilsin mi?", "Evet, Kaldır", danger: true)) return;
            foreach (var r in icindekiler) MoveToGroup(r, r.CatalogGroup);
        }
        _groups.Remove(g);
    }

    // ═══ Kaydetme ═══════════════════════════════════════════════════════════════════════════
    private async Task Save()
    {
        var (ds, dg, dr) = Diff();
        if (ds + dg + dr == 0) { _ok = true; _msg = "Değişiklik yok."; _edit = false; return; }

        // Platform değişiklikleri ayrıca listelenir: KAPATMA yıkıcıdır (o platformdaki herkes,
        // yetkisi olsa bile erişimi kaybeder) → kullanıcı neyi kapattığını AÇIKÇA görsün.
        var platformDegisen = _rows!.Where(r => r.PlatformChanged).ToList();
        var kapananlar = platformDegisen
            .Where(r => (r.OrigDesktop && !r.EffectiveDesktop) || (r.OrigWeb && !r.EffectiveWeb))
            .ToList();

        var uyari = $"Kaydedilecek: {ds} ekran, {dg} üst menü, {dr} grupta sıralama.\n\n" +
                    "Menü tüm kullanıcılar için güncellenir. Ekranların adresleri ve yetkileri DEĞİŞMEZ.\n";
        if (kapananlar.Count > 0)
        {
            uyari += "\n⚠️ ERİŞİME KAPATILACAK EKRANLAR:\n" +
                     string.Join("\n", kapananlar.Select(r => $"  • {r.Label} → {r.LivePlatformText}")) +
                     "\n\nBu ekranlara, kapatılan platform üzerinden YETKİSİ OLAN kullanıcılar da " +
                     "erişemeyecek; menüde görünmeyecek ve adresi elle yazarak da açılamayacak. " +
                     "Kullanıcı yetkileri DEĞİŞMEZ.\n";
        }

        if (!await Dialog.Confirm(uyari + "\nDevam edilsin mi?",
            "Evet, Kaydet", danger: kapananlar.Count > 0)) return;

        _busy = true; _msg = null;
        try
        {
            var screens = new List<object>();
            foreach (var g in _groups)
            {
                var liste = GroupRows(g.GroupKey);
                for (int i = 0; i < liste.Count; i++)
                    screens.Add(new { screenKey = liste[i].ScreenKey, label = liste[i].Label, groupKey = g.GroupKey, sortOrder = i });
            }
            // Hiçbir gruba düşmemiş satır kalmasın (savunma amaçlı — normalde olmaz).
            foreach (var r in _rows!)
                if (!_groups.Any(g => string.Equals(g.GroupKey, r.GroupKey, StringComparison.Ordinal)))
                    screens.Add(new { screenKey = r.ScreenKey, label = r.Label, groupKey = r.CatalogGroup, sortOrder = 0 });

            var groups = _groups.Select((g, i) => new
            {
                groupKey = g.GroupKey, title = g.Title, sortOrder = i, isCustom = g.IsCustom,
                parentGroupKey = g.ParentGroupKey,
            }).ToList();

            var err = await Api.PostAsync("/api/screens/layout", new { screens, groups });

            // PLATFORM değişiklikleri ayrı uçtan yazılır (kendi doğrulaması var: katalogda olmayan
            // platform açılamaz, korumalı ekran tüm platformlarda kapatılamaz). Düzen kaydı
            // başarısızsa platforma HİÇ dokunulmaz — yarım bir sonuç oluşmasın.
            int platformYazilan = 0;
            var platformHatalari = new List<string>();
            if (err is null)
            {
                foreach (var r in platformDegisen)
                {
                    var pErr = await Api.PostAsync("/api/screens/visibility", new
                    {
                        screenKey = r.ScreenKey,
                        desktop = r.EffectiveDesktop,
                        web = r.EffectiveWeb,
                    });
                    if (pErr is null) platformYazilan++;
                    else platformHatalari.Add($"{r.Label}: {pErr}");
                }
            }

            _ok = err is null && platformHatalari.Count == 0;
            _msg = err
                ?? (platformHatalari.Count > 0
                        ? "Menü düzeni kaydedildi, ancak bazı platform ayarları uygulanamadı — " +
                          string.Join(" · ", platformHatalari)
                        : $"Kaydedildi ({ds} ekran, {dg} üst menü, {dr} grupta sıralama" +
                          (platformYazilan > 0 ? $", {platformYazilan} platform ayarı" : "") + ").");
            if (_ok)
            {
                _edit = false;
                await Api.RefreshMenuAsync();   // §21 — kendi menüm de hemen güncellensin
            }
            await Load();
        }
        catch (Exception ex) { _ok = false; _msg = "Kaydedilemedi: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task ResetDefaults()
    {
        if (!await Dialog.Confirm(
            "Menü düzeni (ekran adları, üst menüler ve sıralama) FABRİKA VARSAYILANINA dönecek.\n\n" +
            "Platform ayarları (Masaüstü / Web kutuları) DEĞİŞMEZ.\n\nDevam edilsin mi?",
            "Evet, Varsayılana Dön", danger: true)) return;

        _busy = true; _msg = null;
        try
        {
            var err = await Api.PostAsync("/api/screens/layout/reset", new { });
            _ok = err is null;
            _msg = err ?? "Menü düzeni varsayılana döndürüldü.";
            if (_ok) await Api.RefreshMenuAsync();
            await Load();
        }
        catch (Exception ex) { _ok = false; _msg = "Sıfırlanamadı: " + ex.Message; }
        finally { _busy = false; }
    }

    // ═══ Süzgeçler ve önizleme ══════════════════════════════════════════════════════════════
    private bool Matches(Row r)
    {
        var q = _q.Trim();
        if (q.Length > 0 &&
            !r.Label.Contains(q, StringComparison.OrdinalIgnoreCase) &&
            !r.ScreenKey.Contains(q, StringComparison.OrdinalIgnoreCase) &&
            !(r.WebRoute ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)) return false;

        if (_fGroup.Length > 0 && !string.Equals(r.GroupKey, _fGroup, StringComparison.Ordinal)) return false;

        if (_fPlatform switch
        {
            "desktop" => !r.EffectiveDesktop,
            "web" => !r.EffectiveWeb,
            "both" => !(r.EffectiveDesktop && r.EffectiveWeb),
            "none" => r.EffectiveDesktop || r.EffectiveWeb,
            _ => false,
        }) return false;

        var degistirilmis = !string.Equals(r.Label, r.CatalogLabel, StringComparison.Ordinal)
                         || !string.Equals(r.GroupKey, r.CatalogGroup, StringComparison.Ordinal);
        if (_fState == "custom" && !degistirilmis) return false;
        if (_fState == "default" && degistirilmis) return false;

        return true;
    }

    private IEnumerable<string> VisibleGroups()
        => _groups.Select(g => g.GroupKey).Where(k => VisibleRows(k).Any());

    private List<Row> VisibleRows(string groupKey)
        => GroupRows(groupKey).Where(Matches).ToList();

    /// <summary>Önizleme satırı. <paramref name="Depth"/> 0 = üst grup, 1 = üst menü (girintiyi belirler).</summary>
    private sealed record PreviewGroup(string Title, List<Row> Rows, int Depth = 0);

    /// <summary>
    /// Kaydedilmemiş düzenle birlikte menü önizlemesi (süzgeçlerden BAĞIMSIZ).
    /// SEC: üst gruplar başlık olarak, altındaki üst menüler bir girinti içeride gösterilir.
    /// Boş kalan üst grup listelenmez — gerçek menüdeki davranışın aynısı.
    /// </summary>
    private List<PreviewGroup> PreviewGroups(string platform)
    {
        var sonuc = new List<PreviewGroup>();
        var yazilanUstGrup = new HashSet<string>(StringComparer.Ordinal);

        foreach (var g in _groups.Where(x => !x.IsSection))
        {
            var satirlar = GroupRows(g.GroupKey)
                .Where(r => platform == "web" ? r.EffectiveWeb : r.EffectiveDesktop)
                .ToList();
            if (satirlar.Count == 0) continue;

            // Üst grubu (varsa) ilk üyesinden hemen önce, bir kez yaz.
            var ust = _groups.FirstOrDefault(x => x.IsSection &&
                string.Equals(x.GroupKey, g.ParentGroupKey, StringComparison.Ordinal));
            if (ust is not null && yazilanUstGrup.Add(ust.GroupKey))
                sonuc.Add(new PreviewGroup(ust.Title, new List<Row>(), 0));

            sonuc.Add(new PreviewGroup(g.Title, satirlar, ust is null ? 0 : 1));
        }
        return sonuc;
    }

    private static string S(JsonElement e, string k) => SN(e, k) ?? "";
    private static string? SN(JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
    private static bool B(JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.True;
}
