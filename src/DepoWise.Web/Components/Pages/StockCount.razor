@page "/stock/count"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@inject LocationOptions Locations

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Stok Sayım</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

@* STK-04: sayım FİZİKSEL bir depoya aittir. "Tüm Şubeler" ile sayım YAPILAMAZ (hangi rafı saydığı
   belirsiz olurdu) — ama depo seçilirse yapılabilir. Sayılan depo ekranda her zaman görünür. *@
@if (Auth.IsAllBranches())
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">
        Sayım tek bir fiziksel depoya aittir. Aşağıdan <b>sayılacak depoyu</b> seçin — "Tüm Şubeler" ile sayım yapılamaz.
    </MudAlert>
}

@if (!Auth.CanCreate("stock"))
{
    <MudAlert Severity="Severity.Warning">Bu ekran için yetkiniz yok.</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-3" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            @* STK-04: SAYILAN DEPO. Şubeye bağlı kullanıcıda kendi deposu (değiştirilemez);
               "Tüm Şubeler" ile girende zorunlu seçim. Liste ve karşılaştırma HEP bu depoya göredir. *@
            @if (Auth.IsAllBranches())
            {
                <MudSelect T="string" @bind-Value="_location" @bind-Value:after="Load" Label="Sayılan Depo / Şantiye *" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:260px" Clearable="true">
                    @foreach (var b in _branches) { <MudSelectItem T="string" Value="@b.Id">@b.Name</MudSelectItem> }
                </MudSelect>
            }
            else
            {
                <MudTextField Value="@_locationName" Label="Sayılan Depo (Şubeniz)" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:260px" />
            }
            <MudTextField @bind-Value="_reason" Label="Sayım Gerekçesi *" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:320px" />
            @* TRH-01: işlem tarihi (iş günü). Kayıt anı ayrıca loglanır. Yetki yoksa kilitli. *@
            <MudDatePicker @bind-Date="_docDate" Label="İşlem Tarihi" Margin="Margin.Dense" Variant="Variant.Outlined"
                           Disabled="@(!CanBackDate)" DateFormat="dd.MM.yyyy" Style="max-width:200px"
                           HelperText="@(CanBackDate ? "Geçmiş/ileri tarih seçilebilir" : "Tarih bugüne sabit (yetki yok)")" />
            <MudTextField @bind-Value="_search" Placeholder="Kod / ad ara..." Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:220px" OnKeyUp="OnSearchKey" />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Load">Ara</MudButton>
            @* ⭐ M-28: kör sayım + taslak (masaüstüyle aynı seçenekler) *@
            <MudTooltip Text="Sayan kişiye sistem miktarı ve fark gösterilmez; sayılan gerçekten sayılır, sisteme uydurulmaz.">
                <MudCheckBox T="bool" @bind-Value="_kor" @bind-Value:after="Load" Dense="true" Label="Kör sayım" />
            </MudTooltip>
            <MudSpacer />
            <MudTooltip Text="Sayımı stoğa yazmadan kaydeder; sonra açıp sürdürebilirsiniz.">
                <MudButton Variant="Variant.Outlined" OnClick="TaslakKaydet" Disabled="_busy">Taslak Kaydet</MudButton>
            </MudTooltip>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_busy">Sayımı Tamamla</MudButton>
        </MudStack>
        @if (_toleransNotu is not null) { <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@_toleransNotu</MudText> }
        @if (_taslaklar.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-2">SAYIM TASLAKLARI</MudText>
            @foreach (var t in _taslaklar)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.caption" Style="flex:1">@t.Ozet</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => TaslakAc(t))">Aç</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => TaslakSil(t))">Sil</MudButton>
                </MudStack>
            }
        }
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Sayılan miktarı girin; <b>@(_locationName ?? "seçili depo")</b> stoğundan farkı kadar "düzeltme (adjustment)"
            hareketi oluşur. Karşılaştırma firma toplamıyla değil, <b>bu deponun</b> miktarıyla yapılır.
        </MudText>
    </MudPaper>

    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_rows.Count == 0) { <MudText Class="mud-text-secondary">Malzeme bulunamadı.</MudText> }
    else
    {
        <MudPaper Class="pa-2" Elevation="2">
            <MudTable Items="_rows" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="62vh" T="Row">
                <HeaderContent><MudTh>KOD</MudTh><MudTh>MALZEME</MudTh>@if (!_kor) {<MudTh Style="text-align:right">SİSTEM STOĞU</MudTh>}<MudTh Style="text-align:right">SAYILAN</MudTh>@if (!_kor) {<MudTh Style="text-align:right">FARK</MudTh>}</HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Code</MudTd>
                    <MudTd>@context.Name</MudTd>
                    @if (!_kor) { <MudTd Style="text-align:right">@context.SystemStock.ToString("0.##")</MudTd> }
                    <MudTd Style="text-align:right;width:140px"><MudNumericField T="decimal" @bind-Value="context.Counted" Min="0" Format="0.##" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTd>
                    @if (!_kor) { <MudTd Style="text-align:right">@((context.Counted - context.SystemStock).ToString("0.##"))</MudTd> }
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    private sealed class Row { public string Id = ""; public string Code = ""; public string Name = ""; public decimal SystemStock; public decimal Counted; }
    private List<Row>? _rows;
    private string _reason = "", _search = "";
    private string? _msg; private bool _ok; private bool _busy;

    // STK-04 — sayılan depo. Şubeye bağlı kullanıcıda oturum şubesi; "Tüm Şubeler"de kullanıcının seçimi.
    private string _location = "";
    private string? _locationName;
    private IReadOnlyList<LocationOption> _branches = System.Array.Empty<LocationOption>();
    private string? EffectiveLocation
        => Auth.IsAllBranches() ? (string.IsNullOrWhiteSpace(_location) ? null : _location) : Auth.BranchId;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.CanCreate("stock")) return;
        // ⭐ WEB-01 (denetim 2026-08-25): ilk yükleme çağrıları KORUMASIZDI. /api/branches 401/500
        // dönerse istisna render sırasında patlar, Blazor devresi TAMAMEN düşer ("bağlantı kesildi")
        // ve kullanıcı bembeyaz ekranla kalır. YET-C4'te aynı düzeltme dört ekrana uygulanmıştı;
        // lokasyon önbelleğini kullanan üç stok ekranı atlanmıştı.
        try
        {
            // Lokasyon listesi ORTAK önbellekten (her ekran kendi /api/branches çağrısını yapmaz).
            if (Auth.IsAllBranches()) _branches = await Locations.WriteTargets();
            else _locationName = await Locations.NameAsync(Auth.BranchId);
            await TaslaklariYukle();   // ⭐ M-28
            await Load();
        }
        catch (Exception ex) { _msg = "Ekran yüklenemedi: " + ex.Message; _ok = false; }
    }

    private async Task Load()
    {
        _rows = null;
        var loc = EffectiveLocation;
        if (loc is null) { _rows = new(); _locationName = null; return; }   // depo seçilmeden liste gösterilmez
        try
        {
            // STK-04: sistem miktarı SAYILAN DEPODAN gelir. Eskiden /api/materials'ın FİRMA GENELİ toplamı
            // "sistem stoğu" diye gösteriliyordu → kullanıcı yanlış farkı görürdü (sunucu doğru hesaplıyordu).
            var url = $"/api/stock/count-sheet?locationId={Uri.EscapeDataString(loc)}"
                      + (string.IsNullOrWhiteSpace(_search) ? "" : $"&search={Uri.EscapeDataString(_search)}");
            var d = await Api.GetObjectAsync(url);
            _locationName = d.TryGetProperty("locationName", out var n) ? n.GetString() : null;
            _rows = (d.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array
                        ? items.EnumerateArray()
                        : Enumerable.Empty<JsonElement>())
                .Select(e =>
                {
                    var stock = Dec(e, "systemStock");
                    var taslakta = _taslakMiktar?.TryGetValue(Str(e, "id"), out var tq) == true ? tq : (decimal?)null;
                    return new Row { Id = Str(e, "id"), Code = Str(e, "code"), Name = Str(e, "name"), SystemStock = stock,
                                     Counted = taslakta ?? (_kor ? 0m : stock) };   // ⭐ M-28: kör sayımda 0'dan başlar
                }).ToList();
        }
        catch { _rows = new(); }
    }

    private async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Load(); }

    // ═══ M-28 (AR-GE 2026-10-18, F-075) — KÖR SAYIM · TASLAK · TOLERANS ═══
    private bool _kor;
    private string? _acikTaslak, _toleransNotu;
    private Dictionary<string, decimal>? _taslakMiktar;
    private sealed class TaslakSatiri { public string Id = ""; public string? BranchId; public bool Kor; public string? Reason; public string Ozet = ""; public Dictionary<string, decimal> Miktar = new(); }
    private List<TaslakSatiri> _taslaklar = new();

    private async Task TaslaklariYukle()
    {
        try
        {
            _taslaklar = (await Api.GetArrayAsync("/api/stock/count-drafts")).Select(t => new TaslakSatiri
            {
                Id = Str(t, "id"), BranchId = Str(t, "branchId") is { Length: > 0 } b ? b : null,
                Kor = t.TryGetProperty("blind", out var k) && k.ValueKind == JsonValueKind.True,
                Reason = Str(t, "reason"), Ozet = Str(t, "summary"),
                Miktar = t.GetProperty("lines").EnumerateArray().ToDictionary(l => Str(l, "materialId"), l => Dec(l, "countedQuantity")),
            }).ToList();
        }
        catch { _taslaklar = new(); }
        try
        {
            var o = await Api.GetObjectAsync("/api/stock/count-tolerance");
            _toleransNotu = o.TryGetProperty("tolerance", out var tol) && tol.ValueKind == JsonValueKind.Number
                ? $"Firma sayım toleransı %{tol.GetDecimal():0.##}: bunu aşan farkı yalnız ters kayıt yetkisi olan kişi kesinleştirir (taslak kaydedip ona bırakın)."
                : null;
        }
        catch { _toleransNotu = null; }
    }

    private async Task TaslakKaydet()
    {
        _msg = null;
        if (EffectiveLocation is null) { _msg = "Önce sayılacak depoyu/şantiyeyi seçin."; _ok = false; return; }
        var lines = (_rows ?? new()).Select(r => new { materialId = r.Id, countedQuantity = r.Counted }).ToList();
        if (lines.Count == 0) { _msg = "Taslakta en az bir malzeme olmalı."; _ok = false; return; }
        var (err, data) = await Api.PostJsonWithErrorAsync("/api/stock/count-drafts",
            new { id = _acikTaslak, branchId = EffectiveLocation, blind = _kor, reason = _reason?.Trim(), lines });
        _ok = err is null;
        if (_ok) { _acikTaslak = Str(data!.Value, "id"); _msg = $"Taslak kaydedildi ({lines.Count} malzeme). Stok değişmedi; sonra açıp sürdürebilirsiniz."; }
        else _msg = "Taslak kaydedilemedi: " + err;
        await TaslaklariYukle();
    }

    private async Task TaslakAc(TaslakSatiri t)
    {
        if (Auth.IsAllBranches()) _location = t.BranchId ?? "";
        else if (t.BranchId != Auth.BranchId) { _ok = false; _msg = "Bu taslak başka bir depoya ait; o depoyla giriş yapın."; return; }
        _kor = t.Kor; _reason = string.IsNullOrWhiteSpace(t.Reason) ? _reason : t.Reason!;
        _acikTaslak = t.Id; _taslakMiktar = t.Miktar;
        await Load();
        _taslakMiktar = null;
        _ok = true; _msg = "Taslak açıldı — sayıma devam edebilir, yeniden kaydedebilir ya da tamamlayabilirsiniz.";
    }

    private async Task TaslakSil(TaslakSatiri t)
    {
        if (!await Dialog.Confirm("Sayım taslağı silinsin mi? (Stok etkilenmez.)", "Sil")) return;
        var err = await Api.DeleteAsync($"/api/stock/count-drafts/{t.Id}");
        _ok = err is null; _msg = err ?? "Taslak silindi.";
        if (_acikTaslak == t.Id) _acikTaslak = null;
        await TaslaklariYukle();
    }

    private async Task Save()
    {
        _msg = null;
        // STK-04: sayım fiziksel bir depoya aittir → depo seçilmeden kaydedilemez.
        if (EffectiveLocation is null) { _msg = "Önce sayılacak depoyu/şantiyeyi seçin."; _ok = false; return; }
        if (string.IsNullOrWhiteSpace(_reason)) { _msg = "Sayım gerekçesi zorunlu."; _ok = false; return; }
        // G1-03: EKRANDAKİ TÜM satırlar gönderilir — fark=0 olanlar da. Servis (StockService.Count) her satır
        // için sayım satırı yazar, stok hareketini yalnız fark≠0'da üretir. Fark=0 kayıtları "sayıldı, doğruydu"
        // denetim izidir ve Stok Sayım Raporu bunları içerecek şekilde tasarlanmıştır. Eskiden bu satırlar
        // gönderilmediği için web'den yapılan sayımlar raporda eksik kalıyordu.
        var lines = (_rows ?? new()).ToList();
        if (lines.Count == 0) { _msg = "Kaydedilecek sayım satırı yok."; _ok = false; return; }
        var diffCount = lines.Count(r => r.Counted != r.SystemStock);
        if (!await Dialog.Confirm($"{lines.Count} malzeme sayıldı ({diffCount} malzemede fark var). Sayım tamamlansın mı? (fark kadar düzeltme hareketi oluşur)")) return;
        _busy = true;
        // G1-05(a): işlem başına TEK jeton — aynı Save'in tekrar gönderiminde sunucu ikinci belge oluşturmaz.
        var operationId = Guid.NewGuid().ToString("N");
        try
        {
            string? err;
            if (_acikTaslak is { } taslak)   // ⭐ M-28: açık taslak son hâliyle kaydedilir, sonra TEK belgeyle kesinleşir
            {
                var (kErr, _) = await Api.PostJsonWithErrorAsync("/api/stock/count-drafts", new
                {
                    id = taslak, branchId = EffectiveLocation, blind = _kor, reason = _reason.Trim(),
                    lines = lines.Select(r => new { materialId = r.Id, countedQuantity = r.Counted }).ToList(),
                });
                err = kErr ?? await Api.PostAsync($"/api/stock/count-drafts/{taslak}/commit", new { reason = _reason.Trim(), docDate = _docDateMs });
                if (err is null) { _acikTaslak = null; await TaslaklariYukle(); }
            }
            else
            err = await Api.PostAsync("/api/stock/count", new
            {
                reason = _reason.Trim(),
                operationId,
                // 🔴 STK-04 DÜZELTMESİ: branchId eskiden HİÇ gönderilmiyordu → sayım farkı ATANMAMIŞ kovasına
                // yazılıyor, kullanıcının saydığı depo hiç düzelmiyordu. Artık sayılan depo açıkça gider.
                branchId = EffectiveLocation,
                lines = lines.Select(r => new { materialId = r.Id, countedQuantity = r.Counted }).ToList(),
                docDate = _docDateMs   // TRH-01: iş günü (created_at DEĞİL)
            });
            _ok = err is null; _msg = err ?? "Sayım tamamlandı, stok güncellendi.";
            if (_ok) await Load();
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static decimal Dec(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : 0;

    // ── TRH-01: İŞLEM TARİHİ (iş günü) ────────────────────────────────────────────────────────
    /// <summary>İşlemin gerçekten yapıldığı gün. Kayıt anı (created_at) bundan BAĞIMSIZDIR ve daima
    /// gerçek saattir → log, kaydın sisteme ne zaman girildiğini gösterir.</summary>
    private DateTime? _docDate = DateTime.Today;

    /// <summary>Geri/ileri tarihli işlem yetkisi (btn-backdate). Yetki yoksa alan kilitlenir.
    /// ⚠️ Arayüz kilidi GÜVENLİK DEĞİLDİR: asıl kapı sunucuda DateEntryPolicy içindedir.</summary>
    // Anahtar düz metin: web projesi DepoWise.Application'a BAŞVURMAZ (bilinçli ayrım).
    // Karşılığı: AppModules.cs → SpecialButtons.BackDate
    private bool CanBackDate => Auth.CanButton("btn-backdate");

    private long? _docDateMs => _docDate is null ? null
        : new DateTimeOffset(DateTime.SpecifyKind(_docDate.Value, DateTimeKind.Utc)).ToUnixTimeMilliseconds();
}
