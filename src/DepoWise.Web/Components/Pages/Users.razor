@page "/users"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Kullanıcı Tanım</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

@if (Auth.CanCreate("users"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:680px;">
        <MudText Typo="Typo.subtitle1" Class="mb-2">YENİ KULLANICI</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_u" Label="Kullanıcı Adı *" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_p" Label="Şifre *" InputType="InputType.Password" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_newPw" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_f" Label="Ad Soyad" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            @* ⭐ 2026-09-06 (kullanıcı isteği): iletişim alanları — masaüstüyle BİREBİR aynı dört alan. *@
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_email" Label="E-posta" Placeholder="ad@firma.com" HelperText="Boş bırakılabilir." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_phone" Label="Cep Telefonu" Placeholder="0500 111 22 33" HelperText="Boş bırakılabilir." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_title" Label="Unvan / Görev" HelperText="Örn. Depo Sorumlusu." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_notes" Label="Not" Lines="2" HelperText="Serbest not." Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            @* Firma seçimi YALNIZ süper adminde görünür; seçilen firmaya ait kullanıcı oluşturulur.
               Firma değişince şube listesi o firmaya göre yeniden yüklenir (yanlış firmaya şube atanmasın). *@
            @if (Auth.IsSuperAdmin)
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Value="_companyId" ValueChanged="OnCompanyChanged" Label="Firma *" Margin="Margin.Dense" Variant="Variant.Outlined"
                               HelperText="Kullanıcı bu firmaya bağlı oluşturulur.">
                        @foreach (var c in _companies) { <MudSelectItem T="string" Value="@c.Id">@c.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" md="6"><LookupSelect Label="Şube / Şantiye *" @bind-Value="_branch" Items="_branches" /></MudItem>
            @if (_branchesLoading)
            {
                <MudItem xs="12"><MudProgressLinear Indeterminate="true" Size="Size.Small" /></MudItem>
            }
            else if (_branches.Count == 0)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        @(SelectedIsOwnCompany ? "Bu firmada" : "Seçilen firmada") henüz <b>şube/şantiye</b> yok. Kullanıcı oluşturabilmek için önce
                        <MudLink Href="branches">Şube / Şantiye</MudLink> ekranından bu firmaya bir şube ekleyin.
                        (Yalnız Süper Admin kullanıcıları şube gerektirmez.)
                    </MudAlert>
                </MudItem>
            }

            @* Fikir B — Kullanıcıyı bir PERSONEL kaydına bağla (ad soyad tekrar yazılmaz; bir personele tek hesap).
               Personel listesi yalnız KENDİ firmanız için gelir; başka firma seçiliyken bağlama kapalıdır. *@
            <MudItem xs="12" md="6">
                @if (SelectedIsOwnCompany)
                {
                    <LookupSelect Label="Personel seç (bağla)" @bind-Value="_personnelId" Items="_personnel" SearchPath="/api/personnel" NameField="fullName" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Bu hesabın hangi personele ait olduğunu seçin. Listede yoksa önce <b>Personel</b> ekranından ekleyin.
                        Hesabı olmayan personeller listelenir.
                    </MudText>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Başka bir firma seçili: personel bağlama burada yapılamaz. Kullanıcı oluşturulduktan sonra
                        o firmanın <b>Personel</b> ekranından bağlanabilir.
                    </MudAlert>
                }
            </MudItem>

            @if (Auth.IsSuperAdmin)
            {
                <MudItem xs="12" md="6">
                    <MudCheckBox T="bool" @bind-Value="_viewAll" Label="Tüm Şubeler yetkisi" Dense="true"
                                 Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Bu kullanıcı tüm şube verisiyle çalışabilir (yalnız Süper Admin verir).</MudText>
                </MudItem>
            }
            @* G6-09: şablon seçici artık kullanıcı OLUŞTURMA yetkisi olan herkese açık (masaüstüyle aynı).
               Servis zaten users/Create istiyor ve şablonu firmaya göre süzüyor; web'de süper adminle
               sınırlı olması iki platformun farklı sonuç üretmesine yol açıyordu. *@
            @if (_templates.Length > 0)
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_templateId" Label="Yetki Şablonu" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                               HelperText="Firmanıza özel + tüm-firma şablonları. Seçilirse yetkiler bu şablona göre yazılır; şablonun rolü varsa o rol de atanır.">
                        @foreach (var t in _templates) { <MudSelectItem T="string" Value="@Str(t, "id")">@Str(t, "name")@(B(t, "scopeAll") ? " (tüm firmalar)" : "")</MudSelectItem> }
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>
        <MudText Typo="Typo.body2" Class="mt-2">Rol: <span class="mud-text-secondary">(tek rol; verilmezse kullanıcı hiçbir ekran görmez)</span></MudText>
        <MudRadioGroup T="string" @bind-Value="_role">
            @foreach (var r in _roles) { <MudRadio T="string" Value="@r.Key" Dense="true" Color="Color.Primary">@r.Name</MudRadio> }
        </MudRadioGroup>
        <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="ClearForm">İptal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Create" Disabled="_busy">Oluştur</MudButton>
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

@if (_selUser is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Seçili kullanıcı:</MudText>
            <MudText Typo="Typo.body1"><b>@Str(_selUser.Value, "username")</b></MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Mevcut şube: <b>@Str(_selUser.Value, "branchDisplay")</b></MudText>
            @if (CanManageSelected)
            {
                <MudSelect T="string" @bind-Value="_assignBranch" Label="Şube / Şantiye Ata" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Style="max-width:200px">
                    @foreach (var b in _branches) { <MudSelectItem T="string" Value="@b.Id">@b.Name</MudSelectItem> }
                </MudSelect>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="AssignBranch">Şube Ata</MudButton>
                @if (Auth.IsSuperAdmin)
                {
                    <MudDivider Vertical="true" FlexItem="true" />
                    <MudCheckBox T="bool" Value="_selViewAll" ValueChanged="ToggleViewAll" Dense="true" Color="Color.Primary"
                                 Label="Tüm Şubeler yetkisi" />
                }
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Lock" Color="Color.Warning">Admin — yalnız süper admin düzenler</MudChip>
            }
        </MudStack>
        @if (Auth.CanEdit("users") && CanManageSelected)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mt-2" Wrap="Wrap.Wrap">
                <MudTooltip Text="Şifreyi kullanıcı adına sıfırlar. Kullanıcı ilk girişte kendi şifresini belirler.">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.LockReset" OnClick="ResetPassword">Şifre Sıfırla</MudButton>
                </MudTooltip>
                @* ⭐ 2026-09-06 (kullanıcı isteği): kullanıcı bilgilerini düzenleme. Bu ekranda düzenleme
                   yolu hiç yoktu; yeni iletişim alanlarındaki yazım hatası kalıcı olurdu. *@
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="BeginEditProfile">Bilgileri Düzenle</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ToggleActive">Aktif / Pasif</MudButton>
                @if (Auth.CanDelete("users")) { <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteUser">Kullanıcıyı Sil</MudButton> }
            </MudStack>
            @if (_editProfile)
            {
                @* Kullanıcı adı, şifre, rol ve şube burada DEĞİŞMEZ — her birinin kendi işlemi ve kendi
                   yetki kapısı var; bu panel yalnız ad-soyad + iletişim alanlarını düzenler. *@
                <MudPaper Class="pa-3 mt-2" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">KULLANICI BİLGİLERİNİ DÜZENLE</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_eFull" Label="Ad Soyad" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_eEmail" Label="E-posta" Placeholder="ad@firma.com" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_ePhone" Label="Cep Telefonu" Placeholder="0500 111 22 33" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_eTitle" Label="Unvan / Görev" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12"><MudTextField @bind-Value="_eNotes" Label="Not" Lines="2" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                    </MudGrid>
                    <MudStack Row="true" Spacing="2" Class="mt-2" Justify="Justify.FlexEnd">
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _editProfile = false)">İptal</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProfile">Kaydet</MudButton>
                    </MudStack>
                </MudPaper>
            }
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mt-2" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Rol:</MudText>
                <MudRadioGroup T="string" @bind-Value="_editRole">
                    @foreach (var r in _roles) { <MudRadio T="string" Value="@r.Key" Dense="true" Color="Color.Primary">@r.Name</MudRadio> }
                </MudRadioGroup>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRoles">Rolü Kaydet</MudButton>
            </MudStack>
        }
        @if (_selMsg is not null) { <MudAlert Severity="@(_selOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_selMsg</MudAlert> }
    </MudPaper>
}

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2"><MudText Typo="Typo.h6">Kullanıcılar</MudText><MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Load">Yenile</MudButton></MudStack>
    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Henüz kullanıcı yok.</MudText> }
    else
    {
        <MudTable Items="_rows" Dense="true" Hover="true" Striped="true" OnRowClick="@(e => SelectUser(e.Item))" T="JsonElement">
            <HeaderContent><MudTh>KULLANICI</MudTh><MudTh>AD SOYAD</MudTh><MudTh>PERSONEL</MudTh><MudTh>ROLLER</MudTh><MudTh>ŞUBE</MudTh><MudTh>DURUM</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@Str(context, "username")</MudTd>
                <MudTd>@Str(context, "fullName")</MudTd>
                <MudTd>@Str(context, "personnelDisplay")</MudTd>
                <MudTd>@Str(context, "roles")</MudTd>
                <MudTd>@Str(context, "branchDisplay")</MudTd>
                <MudTd>@Str(context, "statusText")</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };
    // Tarayıcılar login formu sanıp KAYITLI superadmin şifresini dolduruyordu; "new-password" bunu engeller.
    private static readonly Dictionary<string, object?> _newPw = new() { ["autocomplete"] = "new-password" };

    private string _u = "", _p = "", _f = "";
    // ⭐ 2026-09-06: iletişim alanları (Migration095)
    private string _email = "", _phone = "", _title = "", _notes = "";
    private bool _viewAll;
    private string? _companyId, _branch, _templateId;
    private string? _personnelId;                       // Fikir B: hesabın bağlanacağı personel
    private string? _role;
    private List<RoleDto> _roles = new();
    private List<ApiClient.Opt> _companies = new(), _branches = new(), _personnel = new();
    private JsonElement[] _templates = Array.Empty<JsonElement>();
    private string? _msg; private bool _ok; private bool _busy;

    // selection
    private JsonElement? _selUser;
    private string? _assignBranch;
    private string? _editRole;
    private string? _selMsg; private bool _selOk;

    private JsonElement[]? _rows;
    private bool _branchesLoading;

    /// <summary>Seçili firma = oturumun kendi firması mı? (Süper admin başka firma seçebilir.)
    /// Personel bağlama yalnız kendi firmasında mümkün — personel listesi tenant'a kilitli.</summary>
    private bool SelectedIsOwnCompany => !Auth.IsSuperAdmin || string.IsNullOrEmpty(_companyId) || _companyId == Auth.CompanyId;

    protected override async Task OnInitializedAsync()
    {
        try { _roles = await Api.GetRolesAsync(); } catch { }
        if (Auth.IsSuperAdmin)
        {
            try
            {
                _companies = await Api.OptionsAsync("/api/companies/options", "id", "name");
                _companyId = Auth.CompanyId;   // varsayılan: kendi firması (şube listesiyle uyumlu başlar)
            }
            catch { }
        }
        // G6-09: şablonlar kullanıcı oluşturma yetkisi olan HERKES için yüklenir (uç zaten users/Create
        // ister ve yalnız kendi firması + tüm-firma şablonlarını döndürür → tenant izolasyonu serviste).
        if (Auth.CanCreate("users"))
        {
            try { _templates = await Api.GetArrayAsync("/api/permission-templates/for-user"); } catch { }
        }
        // ⭐ YET-C4: ilk yükleme çağrıları korumasız bırakılmaz — sunucu 401/500 dönerse istisna
        // render sırasında patlar ve Blazor devresi TAMAMEN düşer ("bağlantı kesildi", bembeyaz ekran).
        try
        {
            await LoadBranches();
            await LoadPersonnel();
            await Load();
        }
        catch (Exception ex) { _ok = false; _msg = "Ekran yüklenemedi: " + ex.Message; }
    }

    /// <summary>Şubeleri SEÇİLİ firmaya göre yükler. Sunucu (BranchService) tenant'ı fail-closed çözer:
    /// süper admin dışındaki roller companyId gönderse de yalnız kendi firmasının şubelerini görür.</summary>
    private async Task LoadBranches()
    {
        _branchesLoading = true;
        try
        {
            var path = Auth.IsSuperAdmin && !string.IsNullOrEmpty(_companyId)
                ? $"/api/branches?companyId={Uri.EscapeDataString(_companyId)}"
                : "/api/branches";
            _branches = await Api.OptionsAsync(path, "id", "name");
        }
        catch { _branches = new(); }
        finally { _branchesLoading = false; }
    }

    /// <summary>Firma değişti: şube + personel seçimleri sıfırlanır ve yeni firmaya göre yeniden yüklenir
    /// (aksi halde başka firmanın şubesi seçili kalır ve sunucu kaydı reddeder).</summary>
    private async Task OnCompanyChanged(string? companyId)
    {
        _companyId = companyId;
        _branch = null; _personnelId = null; _msg = null;
        await LoadBranches();
        await LoadPersonnel();
    }

    private async Task Load() { _rows = null; try { _rows = await Api.GetArrayAsync("/api/users"); } catch { _rows = Array.Empty<JsonElement>(); } }

    // Bağlanabilir personeller = hesabı OLMAYANLAR (bir personele tek kullanıcı kuralı).
    // Başka firma seçiliyse liste boştur: /api/personnel yalnız oturumun firmasını döndürür (tenant izolasyonu).
    private async Task LoadPersonnel()
    {
        if (!SelectedIsOwnCompany) { _personnel = new(); _personnelId = null; return; }
        try
        {
            var rows = await Api.GetArrayAsync("/api/personnel");
            _personnel = rows
                .Where(r => !Bool(r, "hasAccount"))
                .Select(r => new ApiClient.Opt(Str(r, "id"), Str(r, "fullName")))
                .ToList();
        }
        catch { _personnel = new(); }
    }


    private async Task Create()
    {
        _msg = null;
        if (string.IsNullOrWhiteSpace(_u) || string.IsNullOrWhiteSpace(_p)) { _msg = "Kullanıcı adı ve şifre zorunlu."; _ok = false; return; }
        if (Auth.IsSuperAdmin && string.IsNullOrEmpty(_companyId)) { _msg = "Firma seçin."; _ok = false; return; }
        if (!await Dialog.Confirm("Yeni kullanıcı oluşturulsun mu?")) return;
        _busy = true;
        try
        {
            var roleKeys = string.IsNullOrEmpty(_role) ? new List<string>() : new List<string> { _role };

            // ── G6-07 adım 1: şablon KULLANICI OLUŞTURULMADAN ÖNCE okunur ────────────────────────
            // Böylece bozuk/erişilemeyen şablonda hiç kullanıcı açılmaz (eskiden kullanıcı açılıyor,
            // şablon hatası sessizce yutuluyor ve ekranda yine "Oluşturuldu." yazıyordu).
            System.Text.Json.JsonElement tpl = default;
            bool hasTemplate = !string.IsNullOrEmpty(_templateId);
            if (hasTemplate)
            {
                try { tpl = await Api.GetObjectAsync($"/api/permission-templates/{_templateId}"); }
                catch (Exception ex)
                {
                    _ok = false;
                    _msg = "Yetki şablonu okunamadı, kullanıcı OLUŞTURULMADI: " + ex.Message;
                    return;
                }
                // G6-B: şablonun rolü de kullanıcıya atanır (masaüstündeki davranış). Yetki yükseltme
                // kanalı DEĞİLDİR: rol, kullanıcı oluşturma isteğiyle birlikte gider ve sunucudaki
                // RoleAssignmentGuard onu doğrular — aktörün atayamayacağı bir rolse istek 403 ile
                // reddedilir ve kullanıcı hiç oluşturulmaz.
                if (tpl.TryGetProperty("roleKey", out var rk) && rk.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var tplRole = rk.GetString();
                    if (!string.IsNullOrWhiteSpace(tplRole) && !roleKeys.Contains(tplRole!)) roleKeys.Add(tplRole!);
                }
            }

            // ── adım 2: kullanıcı + roller (tek sunucu çağrısı, tek transaction) ─────────────────
            var (err, id) = await Api.CreateAsync("/api/users", new
            {
                username = _u.Trim(), password = _p, fullName = _f,
                roleKeys,
                companyId = Auth.IsSuperAdmin ? _companyId : null, branchId = _branch,
                canViewAllBranches = Auth.IsSuperAdmin && _viewAll,
                personnelId = _personnelId,         // Fikir B: hesabı personele bağla
                email = _email, phone = _phone, title = _title, notes = _notes   // ⭐ 2026-09-06
            });
            if (err is not null || id is null) { _ok = false; _msg = err ?? "Kullanıcı oluşturulamadı."; return; }

            // ── adım 3: şablon yetkileri (ayrı çağrı — yetki yazımı delegasyon tavanını uygulayan
            // PermissionService'ten geçmek ZORUNDA; CreateUser'ın içindeki yol bu kontrolleri yapmaz).
            // Başarısız olursa SESSİZ GEÇİLMEZ: kullanıcı oluştu ama yetkisiz kaldı, bu açıkça söylenir.
            if (hasTemplate)
            {
                var mods = tpl.TryGetProperty("modules", out var m) ? m : default;
                var btns = tpl.TryGetProperty("buttons", out var b) ? b : default;
                string? permErr;
                try { permErr = await Api.PostAsync($"/api/permissions/{id}", new { modules = mods, buttons = btns }); }
                catch (Exception ex) { permErr = ex.Message; }
                if (permErr is not null)
                {
                    _ok = false;
                    _msg = $"Kullanıcı oluşturuldu ANCAK yetki şablonu uygulanamadı: {permErr} "
                         + "Kullanıcı şu an hiçbir ekranı göremez; yetkileri 'Yetkiler' ekranından verin.";
                    await ClearForm(); await Load(); await LoadPersonnel();
                    return;
                }
            }

            _ok = true;
            _msg = hasTemplate ? "Oluşturuldu (yetkiler şablondan uygulandı)." : "Oluşturuldu.";
            await ClearForm(); await Load(); await LoadPersonnel();   // bağlanan personel listeden düşer
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    // Form temizlenince firma KENDİ firmasına döner; şube/personel listeleri buna göre tazelenir.
    private async Task ClearForm()
    {
        _u = _p = _f = ""; _email = _phone = _title = _notes = ""; _viewAll = false; _branch = _templateId = _role = _personnelId = null;
        var back = Auth.IsSuperAdmin ? Auth.CompanyId : null;
        if (_companyId != back) { _companyId = back; await LoadBranches(); await LoadPersonnel(); }
    }

    private bool _selViewAll;

    private async Task SelectUser(JsonElement u)
    {
        _selUser = u; _selMsg = null; _assignBranch = NullS(u, "branchId");
        _selViewAll = u.TryGetProperty("canViewAllBranches", out var va) && va.ValueKind == JsonValueKind.True;
        _editRole = null;
        try { foreach (var k in await Api.GetArrayAsync($"/api/users/{Str(u, "id")}/roles")) { _editRole = k.GetString(); break; } } catch { }
    }

    private string SelId => _selUser is null ? "" : Str(_selUser.Value, "id");

    // ⭐ 2026-09-06: kullanıcı profili düzenleme (ad-soyad + iletişim alanları).
    private bool _editProfile;
    private string _eFull = "", _eEmail = "", _ePhone = "", _eTitle = "", _eNotes = "";

    private void BeginEditProfile()
    {
        if (_selUser is null) return;
        var u = _selUser.Value;
        _eFull = Str(u, "fullName");
        _eEmail = Str(u, "email");
        _ePhone = Str(u, "phone");
        _eTitle = Str(u, "title");
        _eNotes = Str(u, "notes");
        _editProfile = true;
    }

    private async Task SaveProfile()
    {
        if (_selUser is null) return;
        var err = await Api.PutAsync($"/api/users/{SelId}/profile",
            new { fullName = _eFull, email = _eEmail, phone = _ePhone, title = _eTitle, notes = _eNotes });
        _ok = err is null;
        _msg = err ?? "Kullanıcı bilgileri güncellendi.";
        if (err is null) { _editProfile = false; await Load(); }
    }

    private async Task AssignBranch()
    {
        if (_selUser is null) return;
        if (!await Dialog.Confirm("Şube ataması yapılsın mı?")) return;
        var err = await Api.PostAsync($"/api/users/{SelId}/branch", new { id = _assignBranch ?? "" });
        _selOk = err is null; _selMsg = err ?? "Şube atandı."; await Load();
    }
    private async Task ToggleViewAll(bool on)
    {
        if (_selUser is null) return;
        if (!await Dialog.Confirm(on ? "Tüm Şubeler yetkisi verilsin mi?" : "Tüm Şubeler yetkisi kaldırılsın mı?")) return;
        var err = await Api.PostAsync($"/api/users/{SelId}/all-branches", new { active = on });
        _selOk = err is null; _selMsg = err ?? "Yetki güncellendi.";
        if (err is null) _selViewAll = on;
        await Load();
    }
    private async Task ResetPassword()
    {
        if (_selUser is null) return;
        var uname = Str(_selUser.Value, "username");
        if (!await Dialog.Confirm($"'{uname}' kullanıcısının şifresi SIFIRLANSIN mı?\n\nGeçici şifre kullanıcı adı olacak; kullanıcı ilk girişte kendi şifresini belirleyecek.", "Evet, Sıfırla")) return;
        var doc = await Api.PostJsonAsync($"/api/users/{SelId}/reset-password", new { });
        if (doc is null) { _selOk = false; _selMsg = "Şifre sıfırlanamadı (yetki veya sunucu hatası)."; return; }
        var temp = doc.Value.TryGetProperty("tempPassword", out var t) ? t.GetString() : uname;
        _selOk = true; _selMsg = $"Şifre sıfırlandı. Geçici şifre: '{temp}'. Kullanıcı ilk girişte kendi şifresini belirleyecek.";
    }
    private async Task ToggleActive()
    {
        if (_selUser is null) return;
        var cur = Str(_selUser.Value, "statusText") == "Aktif";
        if (!await Dialog.Confirm(cur ? "Kullanıcı pasife alınsın mı?" : "Kullanıcı aktif edilsin mi?")) return;
        var err = await Api.PostAsync($"/api/users/{SelId}/active", new { active = !cur });
        _selOk = err is null; _selMsg = err ?? "Durum değişti."; await Load(); _selUser = null;
    }
    private async Task DeleteUser()
    {
        if (_selUser is null) return;
        if (!await Dialog.Confirm("Bu kullanıcı silinsin mi?", "Evet, Sil", danger: true)) return;
        var err = await Api.DeleteAsync($"/api/users/{SelId}");
        _selOk = err is null; _selMsg = err ?? "Silindi."; _selUser = null; await Load();
    }
    private async Task SaveRoles()
    {
        if (_selUser is null) return;
        if (!await Dialog.Confirm("Rol kaydedilsin mi?")) return;
        var roles = string.IsNullOrEmpty(_editRole) ? new List<string>() : new List<string> { _editRole };
        var err = await Api.PostAsync($"/api/users/{SelId}/roles", new { roles });
        _selOk = err is null; _selMsg = err ?? "Rol kaydedildi."; await Load();
    }

    // #8: Süper admin herkesi; aksi halde admin OLMAYAN kullanıcıyı veya kendini yönetebilir.
    private bool CanManageSelected => _selUser is null || Auth.IsSuperAdmin
        || !Bool(_selUser.Value, "isAdmin") || Str(_selUser.Value, "id") == Auth.UserId;

    private static bool Bool(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.True;

    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static string? NullS(JsonElement row, string key) { var s = Str(row, key); return string.IsNullOrEmpty(s) ? null : s; }
    private static bool B(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.True;
}
