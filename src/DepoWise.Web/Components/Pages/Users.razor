@page "/users"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<MudText Typo="Typo.h5" GutterBottom="true">Kullanıcılar</MudText>

@if (Auth.CanCreate("users"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:680px;">
        <MudText Typo="Typo.subtitle1" Class="mb-2">YENİ KULLANICI</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_u" Label="Kullanıcı Adı *" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_p" Label="Şifre *" InputType="InputType.Password" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_f" Label="Ad Soyad" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            @if (Auth.IsSuperAdmin)
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_companyId" Label="Firma *" Margin="Margin.Dense" Variant="Variant.Outlined">
                        @foreach (var c in _companies) { <MudSelectItem T="string" Value="@c.Id">@c.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" md="6"><LookupSelect Label="Şube" @bind-Value="_branch" Items="_branches" /></MudItem>
            @if (Auth.IsSuperAdmin)
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_templateId" Label="Yetki Şablonu (Süper Admin)" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                               HelperText="Seçilirse yeni kullanıcının yetkileri bu şablona göre yazılır.">
                        @foreach (var t in _templates) { <MudSelectItem T="string" Value="@Str(t, "id")">@Str(t, "name")</MudSelectItem> }
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>
        <MudText Typo="Typo.body2" Class="mt-2">Roller: <span class="mud-text-secondary">(rol verilmezse kullanıcı hiçbir ekran görmez)</span></MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap">
            @foreach (var r in _roles) { <MudCheckBox T="bool" Label="@r.Name" Value="_sel.Contains(r.Key)" ValueChanged="v => Toggle(r.Key, v)" Dense="true" /> }
        </MudStack>
        <MudStack Row="true" Class="mt-2" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="ClearForm">İptal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Create" Disabled="_busy">Oluştur</MudButton>
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

@if (_selUser is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Seçili kullanıcı:</MudText>
            <MudText Typo="Typo.body1"><b>@Str(_selUser.Value, "username")</b></MudText>
            <MudSelect T="string" @bind-Value="_assignBranch" Label="Şube" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Style="max-width:200px">
                @foreach (var b in _branches) { <MudSelectItem T="string" Value="@b.Id">@b.Name</MudSelectItem> }
            </MudSelect>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="AssignBranch">Şube Ata</MudButton>
        </MudStack>
        @if (Auth.CanEdit("users"))
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mt-2" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_newPass" Label="Yeni şifre" InputType="InputType.Password" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:200px" />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ChangePassword">Şifre Değiştir</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ToggleActive">Aktif / Pasif</MudButton>
                @if (Auth.CanDelete("users")) { <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteUser">Kullanıcıyı Sil</MudButton> }
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mt-2" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Roller:</MudText>
                @foreach (var r in _roles) { <MudCheckBox T="bool" Label="@r.Name" Value="_editSel.Contains(r.Key)" ValueChanged="v => ToggleEdit(r.Key, v)" Dense="true" /> }
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRoles">Rolleri Kaydet</MudButton>
            </MudStack>
        }
        @if (_selMsg is not null) { <MudAlert Severity="@(_selOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_selMsg</MudAlert> }
    </MudPaper>
}

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2"><MudText Typo="Typo.h6">Kullanıcılar</MudText><MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Load">Yenile</MudButton></MudStack>
    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Henüz kullanıcı yok.</MudText> }
    else
    {
        <MudTable Items="_rows" Dense="true" Hover="true" Striped="true" OnRowClick="@(e => SelectUser(e.Item))" T="JsonElement">
            <HeaderContent><MudTh>KULLANICI</MudTh><MudTh>AD SOYAD</MudTh><MudTh>ROLLER</MudTh><MudTh>ŞUBE</MudTh><MudTh>DURUM</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@Str(context, "username")</MudTd>
                <MudTd>@Str(context, "fullName")</MudTd>
                <MudTd>@Str(context, "roles")</MudTd>
                <MudTd>@Str(context, "branchDisplay")</MudTd>
                <MudTd>@Str(context, "statusText")</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };

    private string _u = "", _p = "", _f = "";
    private string? _companyId, _branch, _templateId;
    private readonly HashSet<string> _sel = new();
    private List<RoleDto> _roles = new();
    private List<ApiClient.Opt> _companies = new(), _branches = new();
    private JsonElement[] _templates = Array.Empty<JsonElement>();
    private string? _msg; private bool _ok; private bool _busy;

    // selection
    private JsonElement? _selUser;
    private string? _assignBranch;
    private string _newPass = "";
    private readonly HashSet<string> _editSel = new();
    private string? _selMsg; private bool _selOk;

    private JsonElement[]? _rows;

    protected override async Task OnInitializedAsync()
    {
        try { _roles = await Api.GetRolesAsync(); } catch { }
        _branches = await Api.OptionsAsync("/api/branches", "id", "name");
        if (Auth.IsSuperAdmin)
        {
            _companies = await Api.OptionsAsync("/api/companies", "id", "name");
            try { _templates = await Api.GetArrayAsync("/api/permission-templates"); } catch { }
        }
        await Load();
    }

    private async Task Load() { _rows = null; try { _rows = await Api.GetArrayAsync("/api/users"); } catch { _rows = Array.Empty<JsonElement>(); } }

    private void Toggle(string key, bool on) { if (on) _sel.Add(key); else _sel.Remove(key); }
    private void ToggleEdit(string key, bool on) { if (on) _editSel.Add(key); else _editSel.Remove(key); }

    private async Task Create()
    {
        _msg = null;
        if (string.IsNullOrWhiteSpace(_u) || string.IsNullOrWhiteSpace(_p)) { _msg = "Kullanıcı adı ve şifre zorunlu."; _ok = false; return; }
        if (Auth.IsSuperAdmin && string.IsNullOrEmpty(_companyId)) { _msg = "Firma seçin."; _ok = false; return; }
        if (!await Dialog.Confirm("Yeni kullanıcı oluşturulsun mu?")) return;
        _busy = true;
        try
        {
            var (err, id) = await Api.CreateAsync("/api/users", new
            {
                username = _u.Trim(), password = _p, fullName = _f, roleKeys = _sel.ToList(),
                companyId = Auth.IsSuperAdmin ? _companyId : null, branchId = _branch
            });
            // Yetki şablonu seçildiyse yeni kullanıcının yetkilerini şablona göre yaz
            if (err is null && id is not null && !string.IsNullOrEmpty(_templateId))
            {
                try
                {
                    var t = await Api.GetObjectAsync($"/api/permission-templates/{_templateId}");
                    var mods = t.TryGetProperty("modules", out var m) ? m : default;
                    var btns = t.TryGetProperty("buttons", out var b) ? b : default;
                    await Api.PostAsync($"/api/permissions/{id}", new { modules = mods, buttons = btns });
                }
                catch { }
            }
            _ok = err is null; _msg = err ?? "Oluşturuldu.";
            if (_ok) { ClearForm(); await Load(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private void ClearForm() { _u = _p = _f = ""; _companyId = _branch = _templateId = null; _sel.Clear(); }

    private async Task SelectUser(JsonElement u)
    {
        _selUser = u; _selMsg = null; _newPass = ""; _assignBranch = NullS(u, "branchId");
        _editSel.Clear();
        try { foreach (var k in await Api.GetArrayAsync($"/api/users/{Str(u, "id")}/roles")) _editSel.Add(k.GetString() ?? ""); } catch { }
    }

    private string SelId => _selUser is null ? "" : Str(_selUser.Value, "id");

    private async Task AssignBranch()
    {
        if (_selUser is null) return;
        if (!await Dialog.Confirm("Şube ataması yapılsın mı?")) return;
        var err = await Api.PostAsync($"/api/users/{SelId}/branch", new { id = _assignBranch ?? "" });
        _selOk = err is null; _selMsg = err ?? "Şube atandı."; await Load();
    }
    private async Task ChangePassword()
    {
        if (_selUser is null || string.IsNullOrWhiteSpace(_newPass)) { _selMsg = "Yeni şifre girin."; _selOk = false; return; }
        if (!await Dialog.Confirm("Şifre değiştirilsin mi?")) return;
        var err = await Api.PostAsync($"/api/users/{SelId}/password", new { password = _newPass });
        _selOk = err is null; _selMsg = err ?? "Şifre değiştirildi."; _newPass = "";
    }
    private async Task ToggleActive()
    {
        if (_selUser is null) return;
        var cur = Str(_selUser.Value, "statusText") == "Aktif";
        if (!await Dialog.Confirm(cur ? "Kullanıcı pasife alınsın mı?" : "Kullanıcı aktif edilsin mi?")) return;
        var err = await Api.PostAsync($"/api/users/{SelId}/active", new { active = !cur });
        _selOk = err is null; _selMsg = err ?? "Durum değişti."; await Load(); _selUser = null;
    }
    private async Task DeleteUser()
    {
        if (_selUser is null) return;
        if (!await Dialog.Confirm("Bu kullanıcı silinsin mi?", "Evet, Sil", danger: true)) return;
        var err = await Api.DeleteAsync($"/api/users/{SelId}");
        _selOk = err is null; _selMsg = err ?? "Silindi."; _selUser = null; await Load();
    }
    private async Task SaveRoles()
    {
        if (_selUser is null) return;
        if (!await Dialog.Confirm("Roller kaydedilsin mi?")) return;
        var err = await Api.PostAsync($"/api/users/{SelId}/roles", new { roles = _editSel.ToList() });
        _selOk = err is null; _selMsg = err ?? "Roller kaydedildi."; await Load();
    }

    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
    private static string? NullS(JsonElement row, string key) { var s = Str(row, key); return string.IsNullOrEmpty(s) ? null : s; }
}
