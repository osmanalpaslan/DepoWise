@page "/assignments"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@inject IJSRuntime JS

@*
    ═══ ZMT-01 (ADR-167, 2026-08-28) — ZİMMET ═══
    Tek ekran (PK-B4): işlem formu + "Kimde Ne Var" + seçili kaydın geçmiş zinciri.
    DEFTER modeli: her işlem değişmez hareket; durum Σ ile türetilir — geçmiş silinemez.
    PK-B1: malzeme teslimi stoktan düşer / iade döner (sunucuda mevcut stok kapılarıyla, aynı işlemde);
    ekipman stok dışı. PK-B3: kayıp stoğa dönmez, hasarlı iade döner. Kapılar SUNUCUDA.
*@

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Zimmet</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

@* ⭐ M-63 (AR-GE 2026-10-25, Şablon C — masaüstüyle aynı): iki sekme — "Yeni işlem" (form + teslim listesi + ALTTA yapışkan
   özet/Kaydet) ve "Kimde ne var" (açık zimmetler + geçmiş zinciri). Yazma yetkisi yoksa yalnız "Kimde ne var". *@
<MudTabs Elevation="0" Rounded="true" PanelClass="pt-3" KeepPanelsAlive="true">
@if (Auth.CanCreate("assignments"))
{
    <MudTabPanel Text="Yeni işlem">
    <MudPaper Class="pa-4 mb-3" Elevation="2">
        <MudGrid Spacing="2">
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="_op" @bind-Value:after="OnOpChanged" Label="İşlem" Margin="Margin.Dense" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("issue")">Teslim</MudSelectItem>
                    <MudSelectItem T="string" Value="@("return")">İade</MudSelectItem>
                    <MudSelectItem T="string" Value="@("damaged")">Hasarlı İade</MudSelectItem>
                    <MudSelectItem T="string" Value="@("transfer")">Devir</MudSelectItem>
                    <MudSelectItem T="string" Value="@("lost")">Kayıp</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="_assetType" Label="Varlık Türü" Margin="Margin.Dense" Variant="Variant.Outlined"
                           @bind-Value:after="OnAssetTypeChanged">
                    <MudSelectItem T="string" Value="@("material")">Malzeme</MudSelectItem>
                    <MudSelectItem T="string" Value="@("equipment")">Ekipman</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_assetId" Label="Varlık *" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var o in _assetOptions) { <MudSelectItem T="string" Value="@o.Id">@o.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            @* ⭐ M-49 (F-139): QR / barkod okutma — teslimde okutulan kalem listeye eklenir (masaüstüyle aynı) *@
            <MudItem xs="6" md="3"><MudTextField T="string" @bind-Value="_okunanKod" Label="QR / barkod okut" HelperText="Okutun ya da kodu yazıp Enter."
                                                 Immediate="true" OnKeyDown="KodOkutTus" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_personnelId" Label="@(_op == "transfer" ? "Veren Personel *" : "Personel *")" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var o in _personnel) { <MudSelectItem T="string" Value="@o.Id">@o.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            @if (_op == "transfer")
            {
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_toPersonnelId" Label="Alan Personel *" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var o in _personnel) { <MudSelectItem T="string" Value="@o.Id">@o.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
            }
            @if (_assetType == "material")
            {
                <MudItem xs="6" md="4">
                    <MudSelect T="string" @bind-Value="_branchId" Label="@(_op == "transfer" || _op == "lost" ? "Şube (kapsam)" : "Depo (şube) *")" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var b in _branches) { <MudSelectItem T="string" Value="@b.Id">@b.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudNumericField T="decimal" @bind-Value="_quantity" Label="Miktar" Min="0.0001m" Margin="Margin.Dense" Variant="Variant.Outlined" />
                </MudItem>
            }
            @* ⭐ 2026-10-11 (kullanıcı isteği): bir personele BİRDEN FAZLA kalem — her kalem listeye eklenir, Kaydet hepsini
               TEK işlemde teslim eder (ya hepsi ya hiçbiri). Liste boşsa eski tekli teslim aynen çalışır. *@
            @if (_op == "issue")
            {
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    @* 2026-10-25 kullanıcı isteği: "Listeye Ekle" kehribar (dolu) *@<MudButton Variant="Variant.Filled" Color="Color.Warning" Class="dw-listeye-ekle" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">Listeye Ekle</MudButton>
                </MudItem>
            }
            <MudItem xs="6" md="3">
                <MudDatePicker @bind-Date="_docDate" Label="İşlem Tarihi" Margin="Margin.Dense" Variant="Variant.Outlined"
                               Editable="true" Disabled="@(!CanBackDate)" />
            </MudItem>
            <MudItem xs="12" md="9"><MudTextField @bind-Value="_note" Label="Açıklama" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
        </MudGrid>
        @* ⭐ M-50 (F-083): zimmet kiti (set) — kit teslim listesine yüklenir; teslim her zamanki Kaydet ile tek işlemde (masaüstüyle aynı) *@
        <MudExpansionPanels Elevation="0" Class="mt-2">
        <MudExpansionPanel Text="Zimmet kiti (set) — kitten listeye yükle ya da listeyi kit olarak kaydet">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudSelect T="string" @bind-Value="_kitId" Label="Zimmet kiti (set)" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Style="min-width:240px">
                @foreach (var k in _kitler) { <MudSelectItem T="string" Value="@Str(k, "id")">@Str(k, "summary")</MudSelectItem> }
            </MudSelect>
            <MudTooltip Text="Seçili kitin kalemlerini teslim listesine ekler. Sonra personeli seçip Kaydet'e basın.">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="KitYukle" Disabled="_busy">Kiti Listeye Yükle</MudButton>
            </MudTooltip>
            <MudTextField T="string" @bind-Value="_kitAdi" Label="Kit adı" Placeholder="ör. Kaynakçı seti" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:220px" />
            <MudTooltip Text="Teslim listesindeki kalemleri adlandırılmış kit olarak saklar (aynı adlı kit varsa güncellenir).">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="KitKaydet" Disabled="@(_busy || !Auth.CanCreate("assignments"))">Listeyi Kit Olarak Kaydet</MudButton>
            </MudTooltip>
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="KitSil" Disabled="@(_busy || !Auth.CanCreate("assignments"))">Kiti Sil</MudButton>
        </MudStack>
        </MudExpansionPanel>
        </MudExpansionPanels>
        @if (_op == "issue" && _lines.Count > 0)
        {
            <MudSimpleTable Dense="true" Hover="true" Class="mt-2">
                <thead><tr><th style="width:90px">TÜR</th><th>TESLİM EDİLECEK KALEM</th><th style="width:90px">MİKTAR</th><th style="width:48px"></th></tr></thead>
                <tbody>
                    @foreach (var k in _lines.ToList())
                    {
                        <tr>
                            <td>@(k.AssetType == "equipment" ? "Ekipman" : "Malzeme")</td>
                            <td>@k.Label</td>
                            <td>@k.Quantity.ToString("0.####")</td>
                            <td><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Title="Bu kalemi listeden çıkar" OnClick="@(() => _lines.Remove(k))" /></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        @if (_op == "issue")
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">Birden fazla malzeme/ekipman teslim etmek için her birini «Listeye Ekle» ile ekleyin, sonra «Kaydet»e basın — hepsi tek işlemde kaydedilir.</MudText>
        }
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
    <MudPaper Class="pa-3 dw-islem-alt" Elevation="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.body2" Style="flex:1"><b>@(_op == "issue" && _lines.Count > 0 ? $"{_lines.Count} kalem teslim listesinde — Kaydet hepsini tek işlemde işler." : "")</b></MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_busy">@(_op == "issue" && _lines.Count > 0 ? $"Kaydet ({_lines.Count} kalem)" : "Kaydet")</MudButton>
        </MudStack>
    </MudPaper>
    </MudTabPanel>
}

<MudTabPanel Text="Kimde ne var">

@* ⭐ M-46: geciken iadeler — görme yetkisi yeter (masaüstünde de araç çubuğunda, yazma yetkisinden bağımsız) *@
@if (_gecikenler.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        <b>@_gecikenler.Count zimmetin iade tarihi geçti:</b>
        @foreach (var g in _gecikenler) { <div>@Str(g, "summary")</div> }
    </MudAlert>
}

<MudGrid Spacing="2">
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h6">Kimde Ne Var</MudText><MudSpacer />
                <MudTextField @bind-Value="_search" Label="Ara (personel / varlık / şube)" Margin="Margin.Dense" Variant="Variant.Outlined"
                              Immediate="false" OnKeyUp="@(async e => { if (e.Key == "Enter") await Load(); })" Style="min-width:220px;" />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Load">Yenile</MudButton>
                @if (Auth.CanView("export"))
                {
                    <MudTooltip Text="Aktif filtrelerle TÜM sonucu Excel dosyası olarak indirir.">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ExportExcel">Excel'e Aktar</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="Yazdir">Yazdır</MudButton>
                    </MudTooltip>
                }
            </MudStack>
            @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
            else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Açık zimmet yok.</MudText> }
            else
            {
                <MudTable Items="_rows" Dense="true" Hover="true" Striped="true" T="JsonElement"
                          OnRowClick="@(e => OpenHistory(e.Item))">
                    <HeaderContent><MudTh>PERSONEL</MudTh><MudTh>TÜR</MudTh><MudTh>VARLIK</MudTh><MudTh>MİKTAR</MudTh><MudTh>ŞUBE</MudTh><MudTh>SON İŞLEM</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd>@Str(context, "personnelName")</MudTd>
                        <MudTd>@Str(context, "assetTypeDisplay")</MudTd>
                        <MudTd>@Str(context, "assetLabel")</MudTd>
                        <MudTd>@Str(context, "quantity")</MudTd>
                        <MudTd>@Str(context, "branchName")</MudTd>
                        <MudTd>@DateText(context, "lastDocDate")</MudTd>
                    </RowTemplate>
                </MudTable>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">Geçmiş zinciri için satıra tıklayın.</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4" Elevation="2" Style="min-height:180px;">
            <MudText Typo="Typo.h6" Class="mb-2">Zimmet Geçmişi @(_historyTitle is null ? "" : "— " + _historyTitle)</MudText>
            @* ⭐ M-46: seçili zimmete beklenen iade tarihi (masaüstüyle aynı servis) *@
            @if (_selRow is not null && Auth.CanEdit("assignments"))
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudDatePicker @bind-Date="_iadeTarihi" Label="Beklenen iade" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Style="max-width:180px" />
                    <MudTooltip Text="Beklenen iade tarihini yazar (boş = kaldır); tarih geçince geciken iade uyarısı çıkar.">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="IadeTarihiKaydet">İade Tarihi Ver</MudButton>
                    </MudTooltip>
                </MudStack>
            }
            @if (_history is null) { <MudText Class="mud-text-secondary">Bir satır seçin — o varlığın tüm teslim/iade/devir zinciri burada görünür.</MudText> }
            else if (_history.Length == 0) { <MudText Class="mud-text-secondary">Geçmiş kaydı yok.</MudText> }
            else
            {
                @foreach (var m in _history)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="py-1" Style="border-bottom:1px solid var(--mud-palette-lines-default);">
                        <div>
                            <MudText Typo="Typo.body2"><b>@Str(m, "movementDisplay")</b> · @Str(m, "personnelName")</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Str(m, "assetLabel") · @Str(m, "quantity")@(string.IsNullOrEmpty(Str(m, "note")) ? "" : " · " + Str(m, "note"))</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@DateText(m, "docDate")</MudText>
                    </MudStack>
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>
</MudTabPanel>
</MudTabs>

@code {
    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };
    private string _op = "issue", _assetType = "material", _search = "", _note = "";
    private string? _assetId, _personnelId, _toPersonnelId, _branchId, _historyTitle;
    private decimal _quantity = 1m;
    private DateTime? _docDate = DateTime.Today;
    private List<ApiClient.Opt> _assetOptions = new(), _personnel = new(), _branches = new();
    private JsonElement[]? _rows, _history;
    private string? _msg; private bool _ok; private bool _busy;
    /// <summary>2026-10-11: toplu teslim kalemleri (masaüstü ZimmetKalemi ile aynı anlam).</summary>
    private sealed class Kalem { public string AssetType = ""; public string AssetId = ""; public string Label = ""; public decimal Quantity; }
    private readonly List<Kalem> _lines = new();
    private const int MaxTopluKalem = 100;   // sunucu: AssignmentService.MaxTopluKalem

    /// <summary>Seçili varlığı teslim listesine ekler. Aynı malzeme tekrar eklenirse miktarı ARTAR; aynı ekipman
    /// ikinci kez eklenemez. Ekledikten sonra varlık kutusu boşalır (sıradaki kalem için).</summary>
    /// <summary>Kalem listesi yalnız Teslim içindir; başka işleme geçilince temizlenir (masaüstü ile aynı).</summary>
    private void OnOpChanged() { if (_op != "issue") _lines.Clear(); }

    // ═══ M-49 — QR / BARKOD OKUTMA ═══
    private string? _okunanKod;
    private async Task KodOkutTus(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_okunanKod)) return;
        var kod = _okunanKod.Trim();
        _okunanKod = "";
        try
        {
            var r = await Api.GetObjectAsync($"/api/scan/resolve?type={_assetType}&code={Uri.EscapeDataString(kod)}");
            var id = Str(r, "id");
            if (_assetOptions.All(o => o.Id != id)) { _ok = false; _msg = $"'{kod}' seçili varlık türünde listede yok."; return; }
            _assetId = id;
            if (_op == "issue") AddLine();   // teslimde okutulan her kalem listeye eklenir (art arda okutma)
            if (_msg is null) { _ok = true; _msg = $"Okutuldu: {kod}"; }
        }
        catch (Exception ex) { _ok = false; _msg = ex.Message; }
    }

    private void AddLine()
    {
        _msg = null;
        if (string.IsNullOrEmpty(_assetId)) { _msg = "Listeye eklemek için önce bir malzeme/ekipman seçin."; _ok = false; return; }
        var qty = _assetType == "equipment" ? 1m : _quantity;
        if (qty <= 0) { _msg = "Miktar sıfırdan büyük olmalı."; _ok = false; return; }
        var var_ = _lines.FirstOrDefault(l => l.AssetType == _assetType && l.AssetId == _assetId);
        if (var_ is not null)
        {
            if (_assetType == "equipment") { _msg = "Bu ekipman listede zaten var."; _ok = false; return; }
            var_.Quantity += qty;
        }
        else
        {
            if (_lines.Count >= MaxTopluKalem) { _msg = $"Bir seferde en fazla {MaxTopluKalem} kalem."; _ok = false; return; }
            _lines.Add(new Kalem { AssetType = _assetType, AssetId = _assetId!, Quantity = qty,
                Label = _assetOptions.FirstOrDefault(o => o.Id == _assetId)?.Name ?? _assetId! });
        }
        _assetId = null; _quantity = 1m;
    }

    /// <summary>TRH-01: tarih alanı yetki yoksa BUGÜNE kilitli (sunucu da normalleştirir).</summary>
    private bool CanBackDate => Auth.CanButton("btn-backdate");

    protected override async Task OnInitializedAsync()
    {
        try { _personnel = await Api.OptionsAsync("/api/personnel", "id", "fullName"); } catch { }
        try { _branches = await Api.OptionsAsync("/api/branches", "id", "name"); } catch { }
        await OnAssetTypeChanged();
        await Load();
        await GecikenleriYukle();   // ⭐ M-46
        await KitleriYukle();       // ⭐ M-50
    }

    // ═══ M-50 — ZİMMET KİTİ (SET) ═══
    private List<JsonElement> _kitler = new();
    private string? _kitId, _kitAdi;

    private async Task KitleriYukle()
    {
        try { _kitler = (await Api.GetArrayAsync("/api/assignments/kits")).ToList(); } catch { _kitler = new(); }
        if (_kitler.All(k => Str(k, "id") != _kitId)) _kitId = null;
    }

    private void KitYukle()
    {
        _msg = null;
        var kit = _kitler.FirstOrDefault(k => Str(k, "id") == _kitId);
        if (_kitId is null || kit.ValueKind != JsonValueKind.Object) { _ok = false; _msg = "Önce bir kit seçin."; return; }
        if (_op != "issue") { _op = "issue"; }
        int eklenen = 0, atlanan = 0;
        foreach (var x in kit.GetProperty("lines").EnumerateArray())
        {
            if (x.TryGetProperty("exists", out var ex) && ex.ValueKind == JsonValueKind.False) { atlanan++; continue; }
            var tip = Str(x, "assetType"); var id = Str(x, "assetId"); var q = x.GetProperty("quantity").GetDecimal();
            var var_ = _lines.FirstOrDefault(l => l.AssetType == tip && l.AssetId == id);
            if (var_ is not null) { if (tip == "material") var_.Quantity += q; else atlanan++; continue; }
            if (_lines.Count >= MaxTopluKalem) { atlanan++; continue; }
            _lines.Add(new Kalem { AssetType = tip, AssetId = id, Quantity = q, Label = Str(x, "label") });
            eklenen++;
        }
        _ok = true;
        _msg = $"'{Str(kit, "name")}' kiti listeye yüklendi: {eklenen} kalem" + (atlanan > 0 ? $" ({atlanan} kalem atlandı: silinmiş ya da listede zaten var)." : ".") +
               " Personeli seçip Kaydet'e basın.";
    }

    private async Task KitKaydet()
    {
        _msg = null;
        if (_lines.Count == 0) { _ok = false; _msg = "Önce teslim listesine kalem ekleyin (Listeye Ekle), sonra kit olarak kaydedin."; return; }
        var secili = _kitler.FirstOrDefault(k => Str(k, "id") == _kitId);
        var ad = string.IsNullOrWhiteSpace(_kitAdi) ? (secili.ValueKind == JsonValueKind.Object ? Str(secili, "name") : null) : _kitAdi.Trim();
        if (string.IsNullOrWhiteSpace(ad)) { _ok = false; _msg = "Kit adı yazın (ya da güncellemek için bir kit seçin)."; return; }
        var ayni = _kitler.FirstOrDefault(k => string.Equals(Str(k, "name"), ad, StringComparison.OrdinalIgnoreCase));
        var ayniId = ayni.ValueKind == JsonValueKind.Object ? Str(ayni, "id") : null;
        if (!await Dialog.Confirm(ayniId is null ? $"Listedeki {_lines.Count} kalem '{ad}' adıyla kit olarak kaydedilsin mi?"
                                                 : $"'{ad}' kiti listedeki {_lines.Count} kalemle GÜNCELLENSİN mi?")) return;
        _busy = true;
        try
        {
            var (err, data) = await Api.PostJsonWithErrorAsync("/api/assignments/kits", new
            {
                id = ayniId, name = ad,
                lines = _lines.Select(l => new { assetType = l.AssetType, assetId = l.AssetId, quantity = l.Quantity }).ToList(),
            });
            _ok = err is null;
            _msg = err ?? $"'{ad}' kiti kaydedildi.";
            if (err is null) { _kitAdi = null; await KitleriYukle(); _kitId = data is { } d ? Str(d, "id") : _kitId; }
        }
        finally { _busy = false; }
    }

    private async Task KitSil()
    {
        _msg = null;
        var kit = _kitler.FirstOrDefault(k => Str(k, "id") == _kitId);
        if (_kitId is null || kit.ValueKind != JsonValueKind.Object) { _ok = false; _msg = "Silinecek kiti seçin."; return; }
        if (!await Dialog.Confirm($"'{Str(kit, "name")}' kiti silinsin mi? (Yapılmış zimmet teslimleri etkilenmez.)", danger: true)) return;
        _busy = true;
        try
        {
            var err = await Api.DeleteAsync($"/api/assignments/kits/{_kitId}");
            _ok = err is null;
            _msg = err ?? $"'{Str(kit, "name")}' kiti silindi.";
            if (err is null) { _kitId = null; await KitleriYukle(); }
        }
        finally { _busy = false; }
    }

    private async Task OnAssetTypeChanged()
    {
        _assetId = null;
        try
        {
            _assetOptions = _assetType == "equipment"
                ? await Api.OptionsAsync("/api/equipment", "id", "name")
                : await Api.MaterialOptionsAsync("/api/materials");   // 2026-10-11: "KOD — Ad" (masaüstü ile aynı)
        }
        catch { _assetOptions = new(); }
        if (_assetType == "equipment") _quantity = 1m;
    }

    private async Task Load()
    {
        _rows = null;
        var q = new List<string>();
        if (!string.IsNullOrWhiteSpace(_search)) q.Add("search=" + Uri.EscapeDataString(_search.Trim()));
        try { _rows = await Api.GetArrayAsync("/api/assignments/holdings" + (q.Count > 0 ? "?" + string.Join("&", q) : "")); }
        catch { _rows = Array.Empty<JsonElement>(); }
    }

    // ═══ M-46 — BEKLENEN İADE · GECİKENLER ═══
    private JsonElement? _selRow;
    private DateTime? _iadeTarihi;
    private List<JsonElement> _gecikenler = new();

    private async Task GecikenleriYukle()
    {
        try { _gecikenler = (await Api.GetArrayAsync("/api/assignments/returns?overdue=true")).ToList(); } catch { _gecikenler = new(); }
    }

    private async Task IadeTarihiKaydet()
    {
        if (_selRow is not { } r) return;
        var err = await Api.PutAsync("/api/assignments/due-date", new
        {
            personnelId = Str(r, "personnelId"), assetType = Str(r, "assetType"), assetId = Str(r, "assetId"),
            date = DepoWise.Web.Services.FieldChecks.ToUnixMs(_iadeTarihi),
        });
        _ok = err is null; _msg = err ?? (_iadeTarihi is null ? "Beklenen iade tarihi kaldırıldı." : $"Beklenen iade tarihi kaydedildi: {_iadeTarihi:dd.MM.yyyy}.");
        await GecikenleriYukle();
    }

    private async Task OpenHistory(JsonElement row)
    {
        _selRow = row;   // ⭐ M-46
        _historyTitle = Str(row, "personnelName") + " · " + Str(row, "assetLabel");
        _history = null;
        try
        {
            _history = await Api.GetArrayAsync(
                $"/api/assignments/history?assetType={Uri.EscapeDataString(Str(row, "assetType"))}&assetId={Uri.EscapeDataString(Str(row, "assetId"))}");
        }
        catch { _history = Array.Empty<JsonElement>(); }
    }

    private async Task Save()
    {
        _msg = null;
        // ⭐ 2026-10-11: TOPLU TESLİM — listede kalem varsa (seçili ama eklenmemiş varlık da listeye katılır).
        if (_op == "issue" && _lines.Count > 0)
        {
            if (string.IsNullOrEmpty(_personnelId)) { _msg = "Teslim alacak personeli seçin."; _ok = false; return; }
            if (!string.IsNullOrEmpty(_assetId)) { AddLine(); if (_msg is not null) return; }
            var kisi = _personnel.FirstOrDefault(p => p.Id == _personnelId)?.Name ?? "Personel";
            if (!await Dialog.Confirm($"{kisi} kişisine {_lines.Count} kalem teslim kaydedilsin mi?")) return;
            _busy = true;
            try
            {
                var toplu = new
                {
                    personnelId = _personnelId,
                    lines = _lines.Select(l => new { assetType = l.AssetType, assetId = l.AssetId, quantity = l.Quantity }).ToList(),
                    branchId = _branchId,
                    docDate = _docDate is null ? (long?)null
                        : new DateTimeOffset(DateTime.SpecifyKind(_docDate.Value.Date, DateTimeKind.Utc)).ToUnixTimeMilliseconds(),
                    note = _note,
                    operationId = "web-" + Guid.NewGuid().ToString("N"),
                };
                var adet = _lines.Count;
                var hata = await Api.PostAsync("/api/assignments/issue-many", toplu);
                _ok = hata is null; _msg = hata ?? $"{adet} kalem teslim kaydedildi.";
                if (_ok) { _lines.Clear(); _note = ""; await Load(); _history = null; _historyTitle = null; }
            }
            catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
            finally { _busy = false; }
            return;
        }
        if (string.IsNullOrEmpty(_assetId) || string.IsNullOrEmpty(_personnelId)) { _msg = "Varlık ve personel seçin."; _ok = false; return; }
        if (_op == "transfer" && string.IsNullOrEmpty(_toPersonnelId)) { _msg = "Devir için alan personeli seçin."; _ok = false; return; }
        var opText = _op switch { "return" => "İade", "damaged" => "Hasarlı iade", "transfer" => "Devir", "lost" => "Kayıp kaydı", _ => "Teslim" };
        if (!await Dialog.Confirm($"{opText} kaydedilsin mi?")) return;
        _busy = true;
        try
        {
            // idempotency: her kaydetme benzersiz operationId üretir; sunucu retry'da ikinci hareket/stok üretmez.
            var body = new
            {
                assetType = _assetType, assetId = _assetId, personnelId = _personnelId,
                toPersonnelId = _op == "transfer" ? _toPersonnelId : null,
                quantity = _assetType == "equipment" ? 1m : _quantity,
                branchId = _branchId,
                docDate = _docDate is null ? (long?)null
                    : new DateTimeOffset(DateTime.SpecifyKind(_docDate.Value.Date, DateTimeKind.Utc)).ToUnixTimeMilliseconds(),
                note = _note, damaged = _op == "damaged",
                operationId = "web-" + Guid.NewGuid().ToString("N"),
            };
            var path = _op switch
            {
                "return" or "damaged" => "/api/assignments/return",
                "transfer" => "/api/assignments/transfer",
                "lost" => "/api/assignments/lost",
                _ => "/api/assignments/issue",
            };
            var err = await Api.PostAsync(path, body);
            _ok = err is null; _msg = err ?? (opText + " kaydedildi.");
            if (_ok) { _note = ""; await Load(); _history = null; _historyTitle = null; }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task ExportExcel()
    {
        var q = new List<string>();
        if (!string.IsNullOrWhiteSpace(_search)) q.Add("search=" + Uri.EscapeDataString(_search.Trim()));
        var (bytes, name) = await Api.GetFileAsync("/api/assignments/export" + (q.Count > 0 ? "?" + string.Join("&", q) : ""), "Zimmet.xlsx");
        if (bytes is null) { _msg = "Excel indirilemedi (dışa aktarım yetkiniz olmayabilir)."; _ok = false; return; }
        await JS.InvokeVoidAsync("dwDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    // ⭐ 2026-09-06 (kullanıcı isteği "A grubu"): YAZDIR. Excel ile AYNI uç ve AYNI süzgeçler;
    // yalnız format=pdf eklenir → iki çıktı asla ayrışmaz. Masaüstündeki "Yazdır" düğmesinin karşılığı.
    private async Task Yazdir()
    {
        var q = new List<string>();
        if (!string.IsNullOrWhiteSpace(_search)) q.Add("search=" + Uri.EscapeDataString(_search.Trim()));
        var (bytes, name) = await Api.GetFileAsync("/api/assignments/export?format=pdf" + (q.Count > 0 ? "&" + string.Join("&", q) : ""), "Zimmet.pdf");
        if (bytes is null) { _msg = "PDF indirilemedi (dışa aktarım yetkiniz olmayabilir)."; _ok = false; return; }
        await JS.InvokeVoidAsync("dwDownload", name, Convert.ToBase64String(bytes),
            "application/pdf");
    }

    private static string DateText(JsonElement row, string key)
        => row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.Number
            ? DateTimeOffset.FromUnixTimeMilliseconds(v.GetInt64()).UtcDateTime.ToString("dd.MM.yyyy") : "—";

    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString()) : "";
}
