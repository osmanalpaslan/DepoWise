@page "/stock"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Stok İşlemleri</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
    @* STK-08: Atanmamış stok dağıtımı — ayrı menü/yetki düğümü açılmadı, buradan erişilir. *@
    @if (Auth.CanCreate("stock"))
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CallSplit" Href="/stock/distribute"
                   title="Geçmişte deposu girilmemiş (Atanmamış) stoğu depolara dağıtın.">Atanmamış Stok Dağıtımı</MudButton>
    }
</div>

@* STK-04: "Tüm Şubeler" modunda artık İŞLEM YAPILABİLİR — ama depo AÇIKÇA seçilmek zorunda.
   (Eskiden tümden engelleniyordu; çok depolu firmada yönetici hiç stok işlemi yapamıyordu.) *@
@if (Auth.IsAllBranches())
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">
        "Tüm Şubeler" modundasınız. Stok bir depoya ait olmalıdır — işlem yapmadan önce aşağıdan
        <b>Depo / Şantiye</b> seçin.
    </MudAlert>
}

@if (Auth.CanCreate("stock"))
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:1000px;">
        @* Kayıt tipi (kullanıcı isteği 2026-08-07): üst seviye "Transfer" KALDIRILDI → "Depo Çıkışı" altına
           Şube İçi/Şube Dışı olarak taşındı. Şube İçi = çıkış (issue), Şube Dışı = transfer. *@
        <MudRadioGroup T="string" @bind-Value="_kind" Class="mb-1">
            <MudRadio T="string" Value="@("Yeni Kayıt")" Color="Color.Primary">Yeni Kayıt</MudRadio>
            <MudRadio T="string" Value="@("Depo Çıkışı")" Color="Color.Primary">Depo Çıkışı</MudRadio>
        </MudRadioGroup>
        @* Depo Çıkışı alt-türü: yalnız Depo Çıkışı seçilince görünür; seçime göre alanlar dinamik gizlenir. *@
        @if (IsExit)
        {
            <MudRadioGroup T="string" @bind-Value="_exitScope" Class="mb-3 ml-4">
                <MudRadio T="string" Value="@("Şube İçi")" Color="Color.Secondary" Dense="true">Şube İçi Çıkış</MudRadio>
                <MudRadio T="string" Value="@("Şube Dışı")" Color="Color.Secondary" Dense="true">Şube Dışı Çıkış (Transfer)</MudRadio>
            </MudRadioGroup>
        }

        <MudGrid Spacing="2">
            @* STK-11 (kullanıcı isteği 2026-08-26): İŞLEM TARİHİ = hareketin ait olduğu iş günü.
               Varsayılan bugün; GEÇMİŞ ve GELECEK tarih serbesttir. Kaydın sisteme girildiği gerçek
               zaman (created_at + audit) sunucuda yazılır; bu alan onu DEĞİŞTİRMEZ.
               Masaüstüyle aynı iş kuralı ve aynı API sözleşmesi (docDate) kullanılır. *@
            <MudItem xs="12" md="3">
                <MudDatePicker @bind-Date="_docDate" Label="İşlem Tarihi" Margin="Margin.Dense" Variant="Variant.Outlined"
                               HelperText="Hareketin ait olduğu gün. Kayıt zamanı ayrıca saklanır." />
            </MudItem>
            <MudItem xs="6" md="3">
                @* MLY-01: opsiyonel maliyet merkezi — bağ sunucuda kayıt sonrası yazılır.
                   ⭐ TRF-01 (2026-09-04): TRANSFERDE GİZLİ. Alan eskiden işlem türünden bağımsız
                   görünüyordu; kullanıcı transfer yaparken de doldurabiliyordu ama değer HİÇBİR YERE
                   yazılmıyordu (transfer gövdesinde `costCenterId` yok, API DTO'sunda alan yok) ve
                   uyarı da verilmiyordu — sessizce yutuluyordu.
                   Neden "gönder" değil de "gizle": depo→depo transfer bir MALİYET OLAYI DEĞİLDİR;
                   malzeme tüketilmez, yalnız yer değiştirir. Maliyet, malzeme kullanıldığında
                   (Şube İçi çıkış) doğar ve orada zaten çalışıyor. Transferlerin maliyetlendirilmesi
                   gerekirse doğru yer yol haritasındaki MUH-04'tür. *@
                @if (!IsOutBranch && Auth.CanEdit("cost_centers") && _costCenters.Count > 0)
                {
                    <MudSelect T="string" @bind-Value="_costCenterId" Label="Maliyet Merkezi" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var cc in _costCenters) { <MudSelectItem T="string" Value="@cc.Id">@cc.Name</MudSelectItem> }
                    </MudSelect>
                }
            </MudItem>

            @if (_kind == "Yeni Kayıt")
            {
                @* Malzeme seçimi OPSİYONEL (madde 1.1, kullanıcı isteği 2026-08-06): mevcut malzeme seçilirse
                   Kod/Ad/Tür/Birim/Kategori/Alt Kategori/Marka KİLİTLENİR + malzemeden doldurulur; Tedarikçi/
                   Birim Fiyat/Fatura-Fiş-İrsaliye/Açıklama HER ZAMAN aktif kalır. *@
                <MudItem xs="12" md="7">
                    <MudAutocomplete T="MaterialItem" Label="Mevcut Malzemeye Giriş Yap (opsiyonel)" @bind-Value="_existingMaterial" @bind-Value:after="OnExistingMaterialPicked" SearchFunc="SearchMaterials"
                                     ToStringFunc="@(m => m is null ? "" : m.Display)" Margin="Margin.Dense" Variant="Variant.Outlined"
                                     ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
                </MudItem>
                <MudItem xs="12" md="5" Class="d-flex align-center" Style="gap:8px;">
                    @if (_existingMaterial is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearExistingMaterial">Seçimi Temizle</MudButton>
                    }
                </MudItem>
                <MudItem xs="6" md="3"><MudTextField @bind-Value="_code" Label="Kod *" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" ReadOnly="@(_existingMaterial is not null)" /></MudItem>
                <MudItem xs="12" md="5"><MudTextField @bind-Value="_name" Label="Ad *" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" ReadOnly="@(_existingMaterial is not null)" /></MudItem>
                <MudItem xs="6" md="4"><MudSelect T="string" @bind-Value="_type" Label="Tür" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Disabled="@(_existingMaterial is not null)">
                    @foreach (var t in _types) { <MudSelectItem T="string" Value="@t">@t</MudSelectItem> }
                </MudSelect></MudItem>
                <MudItem xs="6" md="3"><MudSelect T="string" @bind-Value="_unit" Label="Birim *" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Disabled="@(_existingMaterial is not null)"
                                                  Adornment="@LkEkleSuslemesi" AdornmentIcon="@Icons.Material.Filled.Add" AdornmentColor="Color.Primary" OnAdornmentClick='() => AddLk("units")'>@Opts(_units)</MudSelect></MudItem>
                @* G1-04: Kategori → Alt Kategori kaskadı (masaüstü paritesi). Kategori kutusu artık YALNIZ
                   üst seviyeyi listeler (/api/materials/subcategories); alt kategoriler ayrı kutuda gelir. *@
                <MudItem xs="6" md="3"><MudSelect T="string" @bind-Value="_cat" @bind-Value:after="OnCatChanged" Label="Kategori" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Disabled="@(_existingMaterial is not null)"
                                                  Adornment="@LkEkleSuslemesi" AdornmentIcon="@Icons.Material.Filled.Add" AdornmentColor="Color.Primary" OnAdornmentClick='() => AddLk("material_categories")'>@Opts(_cats)</MudSelect></MudItem>
                @* ⭐ TDR-01 devamı (2026-09-05): Alt Kategori'de "+" YOKTU — bu ekrandaki tek eksik kutuydu
                   (masaüstünde de yoktu, ikisi birlikte tamamlandı). Alt kategori seçili KATEGORİYE bağlıdır,
                   bu yüzden ayrı uca (parentId ile) gider; kategori seçilmeden kutu zaten pasiftir. *@
                <MudItem xs="6" md="3"><MudSelect T="string" @bind-Value="_subCat" Label="Alt Kategori" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                                                  Disabled="@(_existingMaterial is not null || string.IsNullOrEmpty(_cat))"
                                                  Adornment="@LkEkleSuslemesi" AdornmentIcon="@Icons.Material.Filled.Add" AdornmentColor="Color.Primary" OnAdornmentClick="AddAltKategori">@Opts(_subCats)</MudSelect></MudItem>
                <MudItem xs="6" md="3"><MudSelect T="string" @bind-Value="_brand" Label="Marka" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Disabled="@(_existingMaterial is not null)"
                                                  Adornment="@LkEkleSuslemesi" AdornmentIcon="@Icons.Material.Filled.Add" AdornmentColor="Color.Primary" OnAdornmentClick='() => AddLk("brands")'>@Opts(_brands)</MudSelect></MudItem>
                <MudItem xs="6" md="3"><MudSelect T="string" @bind-Value="_sup" Label="Tedarikçi" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                                                  Adornment="@LkEkleSuslemesi" AdornmentIcon="@Icons.Material.Filled.Add" AdornmentColor="Color.Primary" OnAdornmentClick='() => AddLk("suppliers")'>@Opts(_sups)</MudSelect></MudItem>
                @* FAZ 3c: fiyatı göremeyen kullanıcıya giriş alanı da açılmaz; gönderilse bile
                   servis yok sayar (StockService yazma kapısı). *@
                @if (_fiyatGorunur)
                {
                    <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_price" Label="Birim Fiyat" Margin="Margin.Dense" Variant="Variant.Outlined" Min="0" /></MudItem>
                }
            }
            else
            {
                <MudItem xs="12" md="7">
                    @* G1-04/G1-01: seçim sonrası mevcut bakiye gösterilir (masaüstü paritesi). *@
                    <MudAutocomplete T="MaterialItem" Label="Malzeme *" @bind-Value="_material" @bind-Value:after="OnExitMaterialPicked" SearchFunc="SearchMaterials"
                                     ToStringFunc="@(m => m is null ? "" : m.Display)" Margin="Margin.Dense" Variant="Variant.Outlined"
                                     ResetValueOnEmptyText="true" CoerceText="true" MinCharacters="0" />
                </MudItem>
                <MudItem xs="12" md="5" Class="d-flex align-center">
                    @if (!string.IsNullOrEmpty(_balance)) { <MudChip T="string" Color="Color.Info" Variant="Variant.Text">@_balance</MudChip> }
                </MudItem>
            }

            <MudItem xs="6" md="3"><MudNumericField T="decimal" @bind-Value="_qty" Label="@QtyLabel" Margin="Margin.Dense" Variant="Variant.Outlined" Min="0" /></MudItem>

            @* ÇOK MALZEMELİ ÇIKIŞ (İş #8, 2026-08-09): eskiden bir çıkış/transfer belgesinde yalnız BİR malzeme
               olabiliyordu. Artık "Listeye Ekle" ile birkaç malzeme toplanıp TEK belgede kaydedilir.
               Liste boş bırakılırsa eski davranış aynen sürer. Masaüstündeki desenle birebir aynı. *@
            @if (ShowExitLines)
            {
                <MudItem xs="12">
                    <div class="d-flex align-center flex-wrap" style="gap:12px;">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlaylistAdd"
                                   OnClick="AddExitLine"
                                   title="Seçili malzeme ve miktarı listeye ekler; sonra başka malzeme seçebilirsiniz.">
                            Listeye Ekle
                        </MudButton>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@ExitLinesSummary</MudText>
                    </div>
                    @if (_exitLines.Count > 0)
                    {
                        <MudSimpleTable Dense="true" Striped="true" Class="mt-2" Style="overflow-x:auto;">
                            <thead><tr><th>Malzeme</th><th style="width:120px;">Miktar</th><th style="width:90px;"></th></tr></thead>
                            <tbody>
                                @foreach (var l in _exitLines.ToList())
                                {
                                    <tr>
                                        <td>@l.Display</td>
                                        <td>@l.Quantity.ToString("0.##")</td>
                                        <td><MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => RemoveExitLine(l))">Çıkar</MudButton></td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudItem>
            }

            @* İşlem şubesi = login (çalışma) şube — salt-okunur; kullanıcı seçmez (kullanıcı isteği 2026-08-06).
               Giriş/çıkışta İŞLEM şubesi, transferde KAYNAK şube budur. Yalnız transfer HEDEFİ seçilir. *@
            @* STK-04: STOK LOKASYONU. Şubeye bağlı kullanıcıda salt-okunur kalır (2026-08-06 kararı; sunucu
               zaten başka şubeye yazdırmaz → seçim kutusu SAHTE seçim olurdu). "Tüm Şubeler" ile giren
               yöneticide ise ZORUNLU seçim olur; eskiden bu kullanıcı hiç stok işlemi yapamıyordu. *@
            @if (IsOutBranch)
            {
                @if (Auth.IsAllBranches())
                {
                    <MudItem xs="6" md="3"><MudSelect T="string" @bind-Value="_workLocation" @bind-Value:after="OnExitMaterialPicked" Label="Kaynak Depo / Şantiye *" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">@Opts(_branches)</MudSelect></MudItem>
                }
                else
                {
                    <MudItem xs="6" md="3"><MudTextField Value="@LoginBranchName" Label="Kaynak Depo (Şubeniz)" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                }
                <MudItem xs="6" md="3"><MudSelect T="string" @bind-Value="_toBranch" Label="Hedef Depo / Şantiye *" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">@Opts(TargetBranches)</MudSelect></MudItem>
            }
            else if (Auth.IsAllBranches())
            {
                <MudItem xs="6" md="3"><MudSelect T="string" @bind-Value="_workLocation" @bind-Value:after="OnExitMaterialPicked" Label="Depo / Şantiye *" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                                                  HelperText="İşlem bu depoya yazılır. Seçilmeden kayıt yapılamaz.">@Opts(_branches)</MudSelect></MudItem>
            }
            else
            {
                <MudItem xs="6" md="3"><MudTextField Value="@LoginBranchName" Label="Depo (Şubeniz)" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
            }

            @* Personel (teslim eden/alan): Yeni Kayıt + Şube İçi'nde görünür/zorunlu; Şube Dışı'nda GİZLİ (madde 6). *@
            @if (IsNew || IsInBranch)
            {
                <MudItem xs="6" md="3"><MudSelect T="string" @bind-Value="_personnel" Label="Teslim Eden / Alan (Personel) *" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">@Opts(_personnelList)</MudSelect></MudItem>
            }
            <MudItem xs="6" md="3"><MudSelect T="string" @bind-Value="_vehicle" Label="Transfer Edilen / Kullanılan Araç" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">@Opts(_vehicles)</MudSelect></MudItem>

            <MudItem xs="6" md="3"><MudTextField @bind-Value="_invoiceNo" Label="Fatura / İrsaliye No" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="6" md="3"><MudTextField @bind-Value="_orderSlipNo" Label="Sipariş Fişi No" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="6" md="3"><MudTextField @bind-Value="_creditSlipNo" Label="Veresiye Fişi No" Margin="Margin.Dense" Variant="Variant.Outlined" UserAttributes="_noAuto" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_note" Label="Açıklama" Margin="Margin.Dense" Variant="Variant.Outlined" Lines="2" UserAttributes="_noAuto" /></MudItem>
        </MudGrid>

        <MudStack Row="true" Class="mt-2" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Save" Disabled="_busy">@(_busy ? "…" : "Kaydet")</MudButton>
            <MudButton Variant="Variant.Text" OnClick="ClearForm" Disabled="_busy">Temizle</MudButton>
        </MudStack>
        @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
    </MudPaper>
}

<MudMessageBox @ref="_confirm" Title="Hareketi İptal Et" YesText="Evet, İptal" CancelText="Vazgeç">
    <MessageContent>Bu stok hareketi iptal edilsin mi? (stok etkisi ters kayıtla geri alınır)</MessageContent>
</MudMessageBox>

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">Son Stok Hareketleri</MudText><MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadMovements">Yenile</MudButton>
    </MudStack>
    @* ⭐ LST-01: SAYFALAMA ÇUBUĞU. Liste eskiden sabit 200 kayıtla kesiliyor ve kesildiğini
       SÖYLEMİYORDU → kullanıcı 200. kaydın ötesindeki hareketi "kaybolmuş" sanıyordu. *@
    @if (_rows is not null && _hrkTotal > 0)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@HrkDurum</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(_hrkPage <= 1)"
                       OnClick="@(() => HrkSayfa(_hrkPage - 1))">◀ Önceki</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(_hrkPage >= _hrkTotalPages)"
                       OnClick="@(() => HrkSayfa(_hrkPage + 1))">Sonraki ▶</MudButton>
            <MudSelect T="int" Value="_hrkPageSize" ValueChanged="HrkBoyut" Label="Sayfa boyutu" Dense="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:130px">
                @foreach (var b in HrkPageSizes) { <MudSelectItem T="int" Value="@b">@b</MudSelectItem> }
            </MudSelect>
        </MudStack>
    }
    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    @* ⭐ FAZ K §13: liste YÜKLENEMEDİĞİNDE "Hareket yok." yazmak YANLIŞ bir cevaptır — kullanıcı
       kayıtların silindiğini/olmadığını sanır. Hata ile boş liste AYRI gösterilir; tekrar deneme sunulur. *@
    else if (_hrkError is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="my-2">
            Hareket listesi yüklenemedi (@_hrkError). Bu, kayıtların olmadığı anlamına GELMEZ —
            bağlantı ya da sunucu kaynaklı olabilir.
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="LoadMovements" Class="ml-2">Tekrar dene</MudButton>
        </MudAlert>
    }
    else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Hareket yok.</MudText> }
    else
    {
        <MudTable Items="_rows" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="55vh">
            <HeaderContent>
                <MudTh>Tarih</MudTh><MudTh>Tip</MudTh><MudTh>Kod</MudTh><MudTh>Malzeme</MudTh>
                <MudTh>Yön</MudTh><MudTh>Miktar</MudTh><MudTh>Birim</MudTh>
                @if (_fiyatGorunur) { <MudTh>B. Fiyat</MudTh> }
                <MudTh>Belge</MudTh><MudTh>Durum</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var docId = Str(context, "documentId"); }
                <MudTd>@Str(context, "dateText")</MudTd>
                <MudTd>@Str(context, "typeText")</MudTd>
                <MudTd>@Str(context, "code")</MudTd>
                <MudTd>@Str(context, "name")</MudTd>
                <MudTd>@Str(context, "directionText")</MudTd>
                <MudTd>@Str(context, "quantity")</MudTd>
                <MudTd>@Str(context, "unit")</MudTd>
                @* FAZ 3c: kapalıysa kolon BAŞLIĞIYLA birlikte hiç çizilmez. *@
                @if (_fiyatGorunur) { <MudTd>@Str(context, "unitPrice")</MudTd> }
                <MudTd>@Str(context, "invoiceText")</MudTd>
                <MudTd>@Str(context, "statusText")</MudTd>
                <MudTd>
                    @* ⭐ YET-05 (2026-08-26): sunucu stock.Edit + btn-reverse ister; burada Delete soruluyordu →
                       Edit+buton verilen kullanıcı butonu göremiyordu. Masaüstü Stok ekranı da eşitlendi. *@
                    @if (Auth.CanEdit("stock") && Auth.CanButton("btn-reverse") && Bool(context, "canReverse"))
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => Reverse(docId))">İptal</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private static readonly Dictionary<string, object?> _noAuto = new() { ["autocomplete"] = "off" };
    private static readonly string[] _types = { "Yedek Parça", "Sarf Malzeme", "Hammadde", "Lastik", "Diğer" };

    private string _kind = "Yeni Kayıt";

    /// <summary>
    /// STK-11 (kullanıcı isteği 2026-08-26) — İŞLEM TARİHİ: hareketin AİT OLDUĞU iş günü.
    /// Varsayılan BUGÜN; geçmiş ve gelecek tarih serbesttir (üst sınır YOK).
    /// Kaydın sisteme girildiği gerçek zaman (created_at + audit) SUNUCUDA yazılır ve bu alandan
    /// etkilenmez — kullanıcı geri tarih seçerek kaydı bugün attığını gizleyemez.
    /// Masaüstü (StockEntryViewModel.DocDate) ile AYNI iş kuralı, AYNI API alanı (docDate).
    /// </summary>
    private DateTime? _docDate = DateTime.Today;

    /// <summary>
    /// Seçilen günü API sözleşmesinin beklediği Unix ms değerine çevirir.
    /// 🔴 ADR-184 (ARA İŞ 3): burada <c>new DateTimeOffset(gun)</c> kullanılıyordu — bu YEREL saat
    /// dilimini uygular (TR = UTC+3) ve seçilen gün bir gün ERKENE kayardı (2 Ağustos → 1 Ağustos
