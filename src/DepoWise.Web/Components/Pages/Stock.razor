    private async Task LoadMovements()
    {
        _rows = null;
        _hrkError = null;
        try
        {
            // ⭐ LST-01 (2026-09-04): eski /api/stock ucu sabit 200 satır döndürüyordu ve sorgu en
            // yeniden başlıyordu → 200. kaydın ötesindeki hareketler SESSİZCE düşüyordu. Artık
            // sayfalanmış uç kullanılıyor; toplam sayı ekranda görünür.
            var res = await Api.GetObjectAsync($"/api/stock/movements/grid?page={_hrkPage}&pageSize={_hrkPageSize}");
            _rows = res.TryGetProperty("items", out var it) && it.ValueKind == JsonValueKind.Array
                ? it.EnumerateArray().ToArray() : Array.Empty<JsonElement>();
            _hrkTotal = res.TryGetProperty("totalCount", out var tc) ? tc.GetInt32() : _rows.Length;
            _hrkTotalPages = res.TryGetProperty("totalPages", out var tp) ? Math.Max(1, tp.GetInt32()) : 1;
            _hrkPage = res.TryGetProperty("page", out var pg) ? pg.GetInt32() : _hrkPage;
        }
        // ⭐ FAZ K §13: hata YUTULMAZ. Eskiden istek başarısız olunca ekran boş listeye düşüyor ve
        // "Hareket yok." yazıyordu — kullanıcıya SESSİZCE yanlış bilgi. Artık sebep saklanır ve
        // kullanıcıya "yüklenemedi + tekrar dene" olarak gösterilir.
        catch (Exception ex)
        {
            _rows = Array.Empty<JsonElement>(); _hrkTotal = 0; _hrkTotalPages = 1;
            _hrkError = ex is HttpRequestException ? "sunucuya ulaşılamadı" : "beklenmeyen hata";
        }
    }

    // ── LST-01: hareket listesi sayfalama durumu ──
    private int _hrkPage = 1, _hrkPageSize = 50, _hrkTotal, _hrkTotalPages = 1;
    /// <summary>FAZ K §13: liste yüklenemediğinde sebebi. null = hata yok (boş liste GERÇEKTEN boştur).</summary>
    private string? _hrkError;
    private static readonly int[] HrkPageSizes = { 25, 50, 100, 200 };
    /// <summary>Kullanıcı kaç kaydın VAR olduğunu görür — sessiz kesilme bir daha olmaz.</summary>
    private string HrkDurum => _hrkTotal == 0 ? "Hareket yok" : $"{_hrkTotal} hareket — sayfa {_hrkPage} / {_hrkTotalPages}";
    private async Task HrkSayfa(int p)
    {
        if (p < 1 || p > _hrkTotalPages) return;
        _hrkPage = p; await LoadMovements();
    }
    private async Task HrkBoyut(int b) { _hrkPageSize = b; _hrkPage = 1; await LoadMovements(); }

    private async Task<List<(string, string)>> Lk(string table) => await LoadList($"/api/lookups/{table}", "id", "name");

    private async Task<List<(string, string)>> LoadList(string path, string idKey, string nameKey)
    {
        try
        {
            var arr = await Api.GetArrayAsync(path);
            return arr.Where(e => e.ValueKind == JsonValueKind.Object)
                .Select(e => (e.TryGetProperty(idKey, out var i) ? i.GetString() ?? "" : "",
                              e.TryGetProperty(nameKey, out var n) ? (n.ValueKind == JsonValueKind.String ? n.GetString() ?? "" : n.ToString()) : ""))
                .Where(t => t.Item1 != "").ToList();
        }
        catch { return new(); }
    }

    private async Task<IEnumerable<MaterialItem>> SearchMaterials(string? term, CancellationToken ct)
    {
        try
        {
            var arr = await Api.GetArrayAsync("/api/materials" + (string.IsNullOrWhiteSpace(term) ? "" : $"?search={Uri.EscapeDataString(term)}"));
            var items = arr.Where(e => e.ValueKind == JsonValueKind.Object)
                .Select(e => new MaterialItem(
                    e.GetProperty("id").GetString() ?? "",
                    e.TryGetProperty("code", out var c) ? c.GetString() ?? "" : "",
                    e.TryGetProperty("name", out var n) ? n.GetString() ?? "" : ""));
            return string.IsNullOrWhiteSpace(term) ? items.Take(DepoWise.Web.Services.FieldChecks.MaxUnfilteredOptions).ToList() : items.ToList();
        }
        catch { return Array.Empty<MaterialItem>(); }
    }

    private async Task OnExistingMaterialPicked()
    {
        if (_existingMaterial is null) return;
        try
        {
            var d = await Api.GetObjectAsync($"/api/materials/{_existingMaterial.Id}");
            _code = Str(d, "code"); _name = Str(d, "name");
            var t = Str(d, "type"); _type = string.IsNullOrEmpty(t) ? "Diğer" : t;
            _unit = NullId(d, "unitId") ?? ""; _brand = NullId(d, "brandId") ?? "";
            _sup = NullId(d, "supplierId") ?? "";   // öneri — Tedarikçi düzenlenebilir kalır
            await ResolveCategoryAsync(NullId(d, "categoryId"));   // G1-04: yaprak kategori üst/alt kutulara dağıtılır
        }
        catch { }
    }

    /// <summary>G1-04 — Kategori değişince alt kategori listesi yenilenir (MaterialEditDialog ile aynı desen).</summary>
    private async Task OnCatChanged()
    {
        _subCat = "";
        _subCats = string.IsNullOrEmpty(_cat)
            ? new()
            : await LoadList($"/api/materials/subcategories?parentId={_cat}", "id", "name");
    }

    /// <summary>G1-04 — Malzemenin <c>category_id</c>'si YAPRAK tutar: üst seviye mi alt kategori mi olduğunu
    /// bulup iki kutuya doğru dağıtır (MaterialEditDialog.ResolveCategoryAsync ile aynı mantık).</summary>
    private async Task ResolveCategoryAsync(string? catId)
    {
        _cat = ""; _subCat = ""; _subCats = new();
        if (string.IsNullOrEmpty(catId)) return;
        if (_cats.Any(o => o.Id == catId))
        {
            _cat = catId;
            _subCats = await LoadList($"/api/materials/subcategories?parentId={catId}", "id", "name");
            return;
        }
        foreach (var top in _cats)
        {
            List<(string Id, string Name)> subs = await LoadList($"/api/materials/subcategories?parentId={top.Id}", "id", "name");
            if (subs.Any(s => s.Id == catId)) { _cat = top.Id; _subCats = subs; _subCat = catId; return; }
        }
    }

    /// <summary>G1-01 — Çıkış/transferde malzeme seçilince mevcut bakiyeyi gösterir (masaüstü paritesi:
    /// StockEntryViewModel.PickMaterial). Hazır uç kullanılır: GET /api/stock/balance/{materialId}.</summary>
    private async Task OnExitMaterialPicked()
    {
        _balance = "";
        if (_material is null) return;
        try
        {
            // STK-04: çıkış YALNIZ seçili depodan yapılır → gösterilen bakiye de O DEPONUN bakiyesidir.
            // Firma toplamını göstermek kullanıcıyı yanıltırdı ("15 var" deyip çıkış reddedilirdi).
            var loc = EffectiveLocation;
            if (loc is null) { _balance = "Bakiye için önce depo seçin."; return; }
            var d = await Api.GetObjectAsync($"/api/stock/balance/{_material.Id}/location?locationId={Uri.EscapeDataString(loc)}");
            if (d.TryGetProperty("balance", out var b) && b.TryGetDecimal(out var q))
            {
                var name = d.TryGetProperty("locationName", out var n) ? n.GetString() : null;
                _balance = $"{name ?? "Depo"} stoğu: {q:0.##}";
            }
        }
        catch { /* bakiye gösterimi bilgilendirmedir; alınamazsa çip gizli kalır */ }
    }

