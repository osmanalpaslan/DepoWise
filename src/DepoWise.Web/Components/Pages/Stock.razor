    private Adornment LkEkleSuslemesi => Auth.CanButton("btn-add-lookup") ? Adornment.End : Adornment.None;

    /// <summary>
    /// ⭐ TDR-01 devamı — ALT KATEGORİ EKLEME. Diğer tanımlardan farklı bir uca gider
    /// (<c>/api/materials/subcategories</c>) çünkü alt kategori seçili KATEGORİYE bağlıdır
    /// (<c>parentId</c>); genel <c>/api/lookups/{table}</c> ucu üst kategori taşıyamaz ve sahipsiz
    /// bir alt kategori oluştururdu. Aynı kural masaüstünde de uygulanır.
    /// </summary>
    private async Task AddAltKategori()
    {
        if (string.IsNullOrEmpty(_cat)) return;   // kutu zaten pasif; yine de savunmacı kontrol

        var dlg = await Dialog.ShowAsync<AddLookupDialog>("Yeni Alt Kategori",
            new DialogParameters { ["Table"] = "material_categories", ["Label"] = "Alt kategori adı", ["ParentId"] = _cat },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var res = await dlg.Result;
        if (res is null || res.Canceled || res.Data is not string ad) return;

        // Liste seçili kategoriye göre yeniden yüklenir; yeni kayıt seçili gelir.
        _subCats = await LoadList($"/api/materials/subcategories?parentId={_cat}", "id", "name");
        _subCat = IdOf(_subCats, ad);
        StateHasChanged();
    }

    private async Task AddLk(string table)
    {
        var dlg = await Dialog.ShowAsync<AddLookupDialog>("Yeni Kayıt",
            new DialogParameters { ["Table"] = table, ["Label"] = "Ad" },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var res = await dlg.Result;
        if (res is null || res.Canceled || res.Data is not string name) return;
        switch (table)
        {
            case "units": _units = await Lk(table); _unit = IdOf(_units, name); break;
            // G1-04: kategori listesi üst-seviye ucundan gelir (düz lookups listesinden DEĞİL).
            case "material_categories":
                _cats = await LoadList("/api/materials/subcategories", "id", "name");
                _cat = IdOf(_cats, name); await OnCatChanged(); break;
            case "brands": _brands = await Lk(table); _brand = IdOf(_brands, name); break;
            case "suppliers": _sups = await Lk(table); _sup = IdOf(_sups, name); break;
        }
        StateHasChanged();
    }

    private static string IdOf(List<(string Id, string Name)> list, string name)
        => list.FirstOrDefault(x => DepoWise.Web.Services.FieldChecks.TrCompare.Compare(x.Name ?? "", name, System.Globalization.CompareOptions.IgnoreCase) == 0).Id ?? "";

    private RenderFragment Opts(List<(string Id, string Name)> list) => builder =>
    {
        int i = 0;
        foreach (var (id, name) in list)
        {
            builder.OpenComponent<MudSelectItem<string>>(i++);
            builder.AddAttribute(i++, "Value", id);
            builder.AddAttribute(i++, "ChildContent", (RenderFragment)(b => b.AddContent(0, name)));
            builder.CloseComponent();
        }
    };

    private async Task Save()
    {
        _msg = null;
        // STK-04: "Tüm Şubeler" modunda artık işlem YAPILABİLİR — ama yalnız depo AÇIKÇA seçilirse.
        // (Eskiden BranchGuard tümden engelliyordu; belirsiz stok işlemi yine oluşamaz.)
        if (EffectiveLocation is null)
        {
            _msg = "Önce işlemin yapılacağı depoyu/şantiyeyi seçin. Stok bir depoya ait olmalıdır.";
            _ok = false; return;
        }
        // madde 8: personel Yeni Kayıt + Şube İçi'nde zorunlu; Şube Dışı (transfer) alanı gizli → zorunlu değil.
        if ((IsNew || IsInBranch) && string.IsNullOrWhiteSpace(_personnel)) { _msg = "Personel (işlemi yapan) zorunludur."; _ok = false; return; }
        // madde 7 — İş #8: sepetteki satırlar da denetlenir (formdaki miktar 0 olduğunda eski kontrol hiç tetiklenmezdi).
        var biggest = _exitLines.Count == 0 ? _qty : Math.Max(_qty, _exitLines.Max(l => l.Quantity));
        if (DepoWise.Web.Services.FieldChecks.IsSuspiciouslyLarge(biggest)
            && !await Dialog.Confirm($"Miktar çok büyük görünüyor ({biggest:0.##}). Emin misiniz?", "Evet, Doğru")) return;

        // MASAÜSTÜYLE PARİTE (StockEntryViewModel.Save): alan doğrulaması ÖNCE, onay penceresi SONRA — kullanıcı
        // eksik alanla "kaydedilsin mi?" sorusuna tıklayıp ardından hata görmesin. Onay metni de masaüstüyle
        // AYNI ve yön belirtir (stok ARTAR/AZALIR) — genel "işlem kaydedilsin mi?" yerine.
        if (_kind == "Yeni Kayıt")
        {
            if (_existingMaterial is null)   // madde 1.1: mevcut malzeme seçiliyken kart alanları zorunlu DEĞİL
            {
                if (string.IsNullOrWhiteSpace(_code)) { _msg = "Kod zorunlu."; _ok = false; return; }
                if (string.IsNullOrWhiteSpace(_name)) { _msg = "Ad zorunlu."; _ok = false; return; }
                if (string.IsNullOrWhiteSpace(_unit)) { _msg = "Birim seçin."; _ok = false; return; }
            }
            if (_qty < 0) { _msg = "Eklenecek stok negatif olamaz."; _ok = false; return; }
            var confirmMsg = _existingMaterial is not null
                ? "Mevcut malzemeye stok girişi yapılsın mı? (stok ARTAR)"
                : "Malzeme kaydedilip stok girişi yapılsın mı? (stok ARTAR)";
            if (!await Dialog.Confirm(confirmMsg, "Evet, Kaydet")) return;
        }
        else if (IsInBranch)   // Şube İçi Çıkış = merkez depodan düşer (issue)
        {
            _saveLines = BuildExitLines();
            if (_saveLines.Count == 0) { _msg = "Malzeme seçin (ya da listeye ekleyin)."; _ok = false; return; }
            if (!await Dialog.Confirm($"Şube içi çıkış kaydedilsin mi?{LineText(_saveLines)} (stok AZALIR)", "Evet, Kaydet")) return;
        }
        else // Şube Dışı Çıkış = Transfer
        {
            _saveLines = BuildExitLines();
            if (_saveLines.Count == 0) { _msg = "Malzeme seçin (ya da listeye ekleyin)."; _ok = false; return; }
            // Kaynak = login şube (otomatik); kullanıcı yalnız HEDEFİ seçer.
            if (string.IsNullOrWhiteSpace(_toBranch)) { _msg = "Hedef şube seçin."; _ok = false; return; }
            if (EffectiveLocation == _toBranch) { _msg = "Hedef depo, kaynak depodan farklı olmalı."; _ok = false; return; }
            // ⭐ TRF-01: onayda HEDEFİN ADI yazılır. Eskiden yalnız "hedef şubeye" deniyordu →
            // kullanıcı, malzemenin hangi depoya gideceğini onay ekranında GÖREMİYORDU. Bu, geri
            // alınamayan bir işlemde (transfer `CanReverse` dışında) ciddi bir eksikti.
            // Masaüstü bunu zaten doğru yapıyordu; parite web lehine değil masaüstü lehine kapatıldı.
            if (!await Dialog.Confirm($"{KaynakDepoAdi} → {HedefDepoAdi} transferi kaydedilsin mi?{LineText(_saveLines)}", "Evet, Kaydet")) return;
        }

        _busy = true;
        // G1-05(a): bu KAYIT işlemi için TEK jeton — istek zaman aşımına uğrayıp yeniden gönderilse bile
        // sunucudaki mevcut idempotency mekanizması ikinci belge/hareket oluşturmaz.
        var operationId = Guid.NewGuid().ToString("N");
        try
        {
            string? err;
            if (_kind == "Yeni Kayıt")
            {
                err = await Api.PostAsync("/api/stock/receive", new
                {
                    operationId,
                    materialId = Empty(_existingMaterial?.Id),   // madde 1.1: doluysa mevcut malzeme kullanılır
                    // G1-04: yaprak kategori gönderilir — alt seçiliyse o, değilse üst (masaüstü ile aynı kural).
                    code = _code.Trim(), name = _name.Trim(), type = Empty(_type), categoryId = Empty(_subCat) ?? Empty(_cat),
                    unitId = Empty(_unit), brandId = Empty(_brand), supplierId = Empty(_sup),
                    quantity = _qty, unitPrice = _price, branchId = EffectiveLocation, personnelId = Empty(_personnel),
                    vehicleId = Empty(_vehicle), note = Empty(_note), invoiceNo = Empty(_invoiceNo),
                    orderSlipNo = Empty(_orderSlipNo), creditSlipNo = Empty(_creditSlipNo),
                    docDate = DocDateMs()   // STK-11: işlem tarihi (created_at DEĞİL)
                });
            }
            else if (IsInBranch)   // Şube İçi Çıkış → issue
            {
                err = await Api.PostAsync("/api/stock/issue", new
                {
                    operationId,
                    lines = _saveLines.Select(l => new { materialId = l.MaterialId, quantity = l.Quantity }),
                    materialId = _saveLines[0].MaterialId, quantity = _saveLines[0].Quantity,   // eski alanlar (uyumluluk)
                    branchId = EffectiveLocation, personnelId = Empty(_personnel),
                    vehicleId = Empty(_vehicle), note = Empty(_note), invoiceNo = Empty(_invoiceNo),
                    orderSlipNo = Empty(_orderSlipNo), creditSlipNo = Empty(_creditSlipNo),
                    docDate = DocDateMs(),   // STK-11
                    costCenterId = Empty(_costCenterId)   // MLY-01
                });
            }
            else // Şube Dışı Çıkış → transfer
            {
                err = await Api.PostAsync("/api/stock/transfer", new
                {
                    operationId,
                    lines = _saveLines.Select(l => new { materialId = l.MaterialId, quantity = l.Quantity }),
                    materialId = _saveLines[0].MaterialId, quantity = _saveLines[0].Quantity,   // eski alanlar (uyumluluk)
                    fromBranchId = EffectiveLocation, toBranchId = _toBranch,
                    personnelId = Empty(_personnel), vehicleId = Empty(_vehicle), note = Empty(_note),
                    invoiceNo = Empty(_invoiceNo), orderSlipNo = Empty(_orderSlipNo), creditSlipNo = Empty(_creditSlipNo),
                    docDate = DocDateMs()   // STK-11
                });
            }
            _ok = err is null; _msg = err ?? "Kaydedildi.";
            if (_ok) { ClearForm(); await LoadMovements(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Kaydedilemedi: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task Reverse(string documentId)
    {
        if (string.IsNullOrEmpty(documentId)) return;
        var ok = _confirm is not null ? await _confirm.ShowAsync() : true;
        if (ok != true) return;
        var err = await Api.PostAsync("/api/stock/reverse", new { documentId, reason = "Kullanıcı iptali" });
        _msg = err ?? "Hareket iptal edildi."; _ok = err is null;
        await LoadMovements();
    }

    // ══════════════ ÇOK MALZEMELİ ÇIKIŞ (İş #8, 2026-08-09) ══════════════
    // Masaüstüyle birebir aynı desen: "Listeye Ekle" ile sepet toplanır, Kaydet'te TEK belge oluşur.
    // Liste boş bırakılırsa eski davranış aynen sürer (tek malzeme + miktar).

    private sealed record ExitLine(string MaterialId, string Display, decimal Quantity);
    private readonly List<ExitLine> _exitLines = new();
    private List<ExitLine> _saveLines = new();

    private bool ShowExitLines => !IsNew;
    private string ExitLinesSummary => _exitLines.Count == 0
        ? "Listeye malzeme eklemeden tek malzeme de kaydedebilirsiniz."
        : $"{_exitLines.Count} malzeme listede — Kaydet'e basınca hepsi TEK belgede işlenir.";
    private static string LineText(List<ExitLine> lines) => lines.Count == 1 ? "" : $" ({lines.Count} malzeme, tek belge)";

    private void AddExitLine()
    {
        _msg = null;
        if (_material is null) { _msg = "Önce malzeme seçin."; _ok = false; return; }
        if (_qty <= 0) { _msg = "Miktar sıfırdan büyük olmalı."; _ok = false; return; }
        // Aynı malzeme tekrar eklenirse miktarlar TOPLANIR (iki ayrı satır kullanıcıyı yanıltırdı).
        var i = _exitLines.FindIndex(l => l.MaterialId == _material.Id);
        if (i >= 0) _exitLines[i] = _exitLines[i] with { Quantity = _exitLines[i].Quantity + _qty };
        else _exitLines.Add(new ExitLine(_material.Id, _material.Display, _qty));
        _material = null; _qty = 0; _balance = "";
    }

    private void RemoveExitLine(ExitLine line) => _exitLines.Remove(line);

    /// <summary>Sepet + (varsa) formda duran seçim. Kullanıcı "Listeye Ekle"ye basmayı unutursa seçim kaybolmasın.</summary>
    private List<ExitLine> BuildExitLines()
    {
        var lines = _exitLines.ToList();
        if (_material is not null && _qty > 0)
        {
            var i = lines.FindIndex(l => l.MaterialId == _material.Id);
            if (i >= 0) lines[i] = lines[i] with { Quantity = lines[i].Quantity + _qty };
            else lines.Add(new ExitLine(_material.Id, _material.Display, _qty));
        }
        return lines;
    }

    private void ClearForm()
    {
        _code = _name = ""; _type = "Yedek Parça"; _unit = _cat = _brand = _sup = ""; _price = 0;
        _subCat = ""; _subCats = new();   // G1-04
        _exitLines.Clear(); _saveLines = new();   // İş #8: sepet de temizlenir
        _qty = 0; _note = _invoiceNo = _orderSlipNo = _creditSlipNo = "";
        _branch = _fromBranch = _toBranch = _personnel = _vehicle = "";
        _material = null; _balance = "";
        _existingMaterial = null;
        _docDate = DateTime.Today;   // STK-11: her yeni kayıtta varsayılan BUGÜN
        _exitScope = "Şube İçi";
    }

    private static string? Empty(string? v) => string.IsNullOrEmpty(v) ? null : v;

    private static string Str(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ValueKind is JsonValueKind.Null ? "" : v.ToString())
            : "";

    private static string? NullId(JsonElement row, string key) { var s = Str(row, key); return string.IsNullOrEmpty(s) ? null : s; }

    private static bool Bool(JsonElement row, string key)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.True;
}
