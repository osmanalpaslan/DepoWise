@page "/reports"
@using System.Text.Json
@using System.Globalization
@inject ApiClient Api
@inject AuthState Auth
@inject IJSRuntime JS

@*  ============================================================================
    Raporlar — ORTAK MİMARİ (kullanıcı isteği 2026-08-07). Rapor listesi, filtre
    görünürlüğü ve yetki, sunucudaki TEK KATALOĞA (/api/reports/catalog) göre
    dinamik sürülür — sabit dizi YOK. Yeni rapor eklemek = sunucu kataloğuna 1
    satır; bu ekran otomatik gösterir. Filtreler rapora göre görünür (madde 3).
    Tarih kullanan raporlarda varsayılan BU AY; kullanmayanlarda gizli (madde 4).
    Şube seçici yalnız YETKİLİ kullanıcıda (btn-branch-select). Otomatik sorgu YOK.
    Özet şeridi + saf CSS grafik tarayıcıda hesaplanır (değişmedi).
    ============================================================================ *@

<MudText Typo="Typo.h5" GutterBottom="true">Raporlar</MudText>

@if (_catalog.Count == 0)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
}
else
{
<MudGrid Spacing="3">
  <!-- ── Sol: kategori-gruplu rapor seçici (katalogdan) ── -->
  <MudItem xs="12" md="3">
    <MudPaper Elevation="2" Class="pa-2">
      @foreach (var grp in _catalog.GroupBy(x => x.CategoryLabel))
      {
          <MudText Typo="Typo.caption" Class="mud-text-secondary px-2 py-1 d-block"
                   Style="font-weight:700; letter-spacing:.10em;">@grp.Key.ToUpperInvariant()</MudText>
          @foreach (var def in grp)
          {
              var on = _selKey == def.Key;
              <div class="dw-rpick @(on ? "active" : "")" @onclick="@(() => OnSelect(def.Key))">
                  <MudIcon Icon="@IconFor(def.Category)" Size="Size.Small" Class="dw-rpick-ico" />
                  <div style="min-width:0;">
                      <div class="dw-rpick-name">@def.Name</div>
                      <div class="dw-rpick-desc">@def.Description</div>
                  </div>
              </div>
          }
      }
    </MudPaper>
  </MudItem>

  <!-- ── Sağ: filtreler + sonuç ── -->
  <MudItem xs="12" md="9">

<MudPaper Class="pa-4 mb-3" Elevation="2">
    <MudGrid Spacing="2" Class="align-center">
        @if (Auth.IsSuperAdmin)
        {
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_companyId" Label="Firma (Süper Admin)" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var co in _companies) { <MudSelectItem T="string" Value="@co.Id">@co.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
        }
        @* Tarih — yalnız rapor tarih kullanıyorsa; RequiresDate ise Bu Ay ön-dolu. *@
        @if (_sel?.UsesDate == true)
        {
            <MudItem xs="6" md="2"><MudDatePicker @bind-Date="_from" Label="Başlangıç" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" /></MudItem>
            <MudItem xs="6" md="2"><MudDatePicker @bind-Date="_to" Label="Bitiş" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" /></MudItem>
        }
        @* Şube seçici — yalnız rapor şube kullanıyorsa VE kullanıcı yetkiliyse (btn-branch-select). Boş = oturum şubesi. *@
        @if (_sel?.UsesBranch == true && _showBranchSelect)
        {
            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-SelectedValues="_branchSel" Label="Şube / Şantiye" MultiSelection="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                           MultiSelectionTextFunc="@(v => v.Count == 0 ? "Kendi şubem" : $"{v.Count} şube")">
                    @foreach (var b in _branches) { <MudSelectItem T="string" Value="@b.Id">@b.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
        }
        @if (_sel?.UsesVehicle == true)
        {
            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-SelectedValues="_vehicleSel" Label="Araçlar" MultiSelection="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                           MultiSelectionTextFunc="@(v => v.Count == 0 ? "Tümü" : $"{v.Count} araç")">
                    @foreach (var vh in _vehicles) { <MudSelectItem T="string" Value="@vh.Id">@vh.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
        }
        <MudItem xs="6" md="1"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Run" Disabled="_busy">Sorgula</MudButton></MudItem>
        <MudItem xs="6" md="2">
            <MudTooltip Text="Seçili rapor ve filtrelerle TÜM sonucu Excel'e aktarır (yetki gerekir).">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportExcel" Disabled="_exporting">Excel'e Aktar</MudButton>
            </MudTooltip>
        </MudItem>
    </MudGrid>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_error</MudAlert> }
</MudPaper>

@if (_sel is not null)
{
    <div class="d-flex align-center mb-1" style="gap:10px;">
        <MudIcon Icon="@IconFor(_sel.Category)" Color="Color.Primary" />
        <div>
            <MudText Typo="Typo.h6">@_sel.Name</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_sel.Description</MudText>
        </div>
    </div>
}

@* ── Özet şeridi: satır sayısı + sayısal kolon toplamları (tarayıcıda hesaplanır) ── *@
@if (_headers is not null && _rows.Count > 0)
{
    <div class="dw-rsum mt-3">
        <div class="dw-rsum-card">
            <span class="dw-rsum-label">SATIR</span>
            <span class="dw-rsum-value">@_rows.Count.ToString("N0", Tr)</span>
        </div>
        @foreach (var t in _totals.Take(3))
        {
            <div class="dw-rsum-card">
                <span class="dw-rsum-label">@t.Header.ToUpperInvariant() — TOPLAM</span>
                <span class="dw-rsum-value">@t.Sum.ToString("N2", Tr)</span>
            </div>
        }
    </div>
}

@* ── Saf CSS sütun grafiği — sayısal kolon varsa ── *@
@if (_chart.Count > 1)
{
    <MudPaper Class="pa-4 mt-3" Elevation="2">
        <div class="d-flex align-center justify-space-between mb-3 flex-wrap" style="gap:8px;">
            <MudText Typo="Typo.subtitle2" Style="font-weight:700;">@_chartValueLabel — @_chartGroupLabel bazında</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">en yüksek @_chart.Count değer</MudText>
        </div>
        <div class="dw-chart">
            @foreach (var b in _chart)
            {
                <div class="dw-bar-col" title="@b.Label: @b.Value.ToString("N2", Tr)">
                    <span class="dw-bar-val">@b.Value.ToString("N0", Tr)</span>
                    <div class="dw-bar" style="@($"height:{Pct(b.Value)}%;")"></div>
                    <span class="dw-bar-lbl">@Short(b.Label)</span>
                </div>
            }
        </div>
    </MudPaper>
}

<MudPaper Class="pa-4 mt-3" Elevation="2">
    @if (_busy) { <div class="d-flex align-center" style="gap:10px;"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><MudText Class="mud-text-secondary">Rapor hazırlanıyor…</MudText></div> }
    else if (_headers is null) { <MudText Class="mud-text-secondary">Filtreleri seçip <b>Sorgula</b>'ya basın.</MudText> }
    else if (_rows.Count == 0) { <MudText Class="mud-text-secondary">Kayıt bulunamadı.</MudText> }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="overflow-x:auto">
            <thead><tr>@foreach (var h in _headers) { <th>@h</th> }</tr></thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_rows.Count satır</MudText>
    }
</MudPaper>

  </MudItem>
</MudGrid>
}

<style>
    .dw-rpick {
        display: flex; align-items: flex-start; gap: 11px;
        padding: 10px 11px; border-radius: 12px; cursor: pointer; user-select: none;
        transition: background-color .14s ease;
    }
    .dw-rpick:hover { background: color-mix(in srgb, var(--mud-palette-text-primary) 7%, transparent); }
    .dw-rpick.active {
        background: linear-gradient(90deg,
            color-mix(in srgb, var(--mud-palette-primary) 20%, transparent),
            color-mix(in srgb, var(--mud-palette-primary) 5%, transparent));
        border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 30%, transparent);
    }
    .dw-rpick-ico { color: var(--mud-palette-text-secondary); margin-top: 1px; }
    .dw-rpick.active .dw-rpick-ico { color: var(--mud-palette-primary); }
    .dw-rpick-name { font-size: .86rem; font-weight: 600; color: var(--mud-palette-text-primary); }
    .dw-rpick.active .dw-rpick-name { color: var(--mud-palette-primary); }
    .dw-rpick-desc { font-size: .74rem; color: var(--mud-palette-text-secondary); margin-top: 1px; }

    .dw-rsum { display: flex; flex-wrap: wrap; gap: 12px; }
    .dw-rsum-card {
        display: flex; flex-direction: column; gap: 4px; min-width: 150px;
        padding: 13px 16px; border-radius: 14px;
        background: color-mix(in srgb, var(--mud-palette-text-primary) 4%, transparent);
        border: 1px solid var(--mud-palette-lines-default);
    }
    .dw-rsum-label { font-size: .68rem; font-weight: 700; letter-spacing: .07em; color: var(--mud-palette-text-secondary); }
    .dw-rsum-value { font-size: 1.4rem; font-weight: 800; letter-spacing: -.02em;
        font-variant-numeric: tabular-nums; color: var(--mud-palette-text-primary); }

    .dw-chart { display: flex; align-items: flex-end; gap: 14px; height: 168px; }
    .dw-bar-col { flex: 1 1 0; min-width: 0; height: 100%;
        display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 6px; }
    .dw-bar {
        width: 100%; min-height: 3px; border-radius: 8px 8px 3px 3px;
        background: linear-gradient(180deg,
            var(--mud-palette-primary),
            color-mix(in srgb, var(--mud-palette-primary) 35%, transparent));
    }
    .dw-bar-val { font-size: .72rem; font-weight: 700; font-variant-numeric: tabular-nums;
        color: var(--mud-palette-text-primary); white-space: nowrap; }
    .dw-bar-lbl { font-size: .7rem; color: var(--mud-palette-text-secondary);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
</style>

@code {
    // ── Katalog-sürümlü rapor listesi (sunucudan) ──
    private sealed record CatItem(string Key, string Name, string Description, string Category, string CategoryLabel,
        bool UsesDate, bool UsesBranch, bool UsesVehicle, bool RequiresDate, bool Manager);
    private List<CatItem> _catalog = new();
    private string _selKey = "general";
    private CatItem? _sel => _catalog.FirstOrDefault(x => x.Key == _selKey);

    private static string IconFor(string category) => category switch
    {
        "Vehicle" => Icons.Material.Filled.LocalShipping,
        "Material" => Icons.Material.Filled.Inventory2,
        "Fuel" => Icons.Material.Filled.LocalGasStation,
        "Maintenance" => Icons.Material.Filled.Build,
        "Requests" => Icons.Material.Filled.Description,
        "Purchasing" => Icons.Material.Filled.ShoppingCart,
        "Stock" => Icons.Material.Filled.Warehouse,
        "Management" => Icons.Material.Filled.Assessment,
        _ => Icons.Material.Filled.Summarize,
    };

    /// <summary>Rapor seçilince: önceki sonucu TEMİZLE (otomatik sorgu YOK) + RequiresDate ise tarihi Bu Ay'a ön-doldur.</summary>
    private void OnSelect(string key)
    {
        _selKey = key;
        _headers = null; _rows = new(); _error = null; ClearSummary();
        ApplyDateDefault();
    }

    private void ApplyDateDefault()
    {
        if (_sel is { RequiresDate: true } && _from is null && _to is null)
        {
            var now = DateTime.Now;
            _from = new DateTime(now.Year, now.Month, 1);
            _to = now;
        }
    }

    private string? _companyId;
    private DateTime? _from, _to;
    private IReadOnlyCollection<string> _branchSel = new HashSet<string>();
    private IReadOnlyCollection<string> _vehicleSel = new HashSet<string>();
    private bool _showBranchSelect;   // btn-branch-select yetkisi (yoksa şube seçici gizli — sunucu da zorlar)

    private List<ApiClient.Opt> _companies = new(), _branches = new(), _vehicles = new();
    private List<string>? _headers;
    private List<List<string>> _rows = new();
    private string? _error; private bool _busy;

    // ── Özet + grafik (yalnız tarayıcıda hesaplanır; sunucuya hiç sorulmaz) ──
    private static readonly CultureInfo Tr = CultureInfo.GetCultureInfo("tr-TR");
    private sealed record Total(string Header, decimal Sum);
    private sealed record Bar(string Label, decimal Value);
    private List<Total> _totals = new();
    private List<Bar> _chart = new();
    private string _chartValueLabel = "", _chartGroupLabel = "";

    private void ClearSummary() { _totals = new(); _chart = new(); _chartValueLabel = ""; _chartGroupLabel = ""; }

    private decimal Pct(decimal v)
    {
        var max = _chart.Count == 0 ? 0m : _chart.Max(b => b.Value);
        if (max <= 0) return 3m;
        var p = v / max * 100m;
        return p < 3m ? 3m : p;
    }

    private static string Short(string s) => s.Length <= 14 ? s : s[..13] + "…";

    private static bool TryNum(string s, out decimal value)
    {
        value = 0m;
        if (string.IsNullOrWhiteSpace(s)) return false;
        var t = s.Trim().Replace(" ", "").Replace(" ", "");
        int i = t.Length;
        while (i > 0 && !char.IsDigit(t[i - 1])) i--;
        t = t[..i];
        if (t.Length == 0) return false;
        if (decimal.TryParse(t, NumberStyles.Number, Tr, out value)) return true;
        if (decimal.TryParse(t, NumberStyles.Number, CultureInfo.InvariantCulture, out value)) return true;
        return false;
    }

    private void BuildSummary()
    {
        ClearSummary();
        if (_headers is null || _rows.Count == 0) return;
        int cols = _headers.Count;

        var numericCols = new List<int>();
        for (int c = 0; c < cols; c++)
        {
            int filled = 0, parsed = 0;
            foreach (var r in _rows)
            {
                if (c >= r.Count || string.IsNullOrWhiteSpace(r[c])) continue;
                filled++;
                if (TryNum(r[c], out _)) parsed++;
            }
            if (filled >= 3 && parsed * 10 >= filled * 6) numericCols.Add(c);
        }

        foreach (var c in numericCols)
        {
            decimal sum = 0m;
            foreach (var r in _rows) if (c < r.Count && TryNum(r[c], out var v)) sum += v;
            _totals.Add(new Total(_headers[c], sum));
        }

        int valueCol = numericCols.Count > 0 ? numericCols[0] : -1;
        int groupCol = -1;
        for (int c = 0; c < cols; c++) if (!numericCols.Contains(c)) { groupCol = c; break; }
        if (valueCol < 0 || groupCol < 0) return;

        var groups = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
        foreach (var r in _rows)
        {
            if (groupCol >= r.Count || valueCol >= r.Count) continue;
            var key = string.IsNullOrWhiteSpace(r[groupCol]) ? "—" : r[groupCol].Trim();
            if (!TryNum(r[valueCol], out var v)) continue;
            groups[key] = groups.TryGetValue(key, out var cur) ? cur + v : v;
        }
        if (groups.Count < 2) return;

        _chart = groups.OrderByDescending(kv => kv.Value).Take(8)
                       .Select(kv => new Bar(kv.Key, kv.Value)).ToList();
        _chartValueLabel = _headers[valueCol];
        _chartGroupLabel = _headers[groupCol];
    }

    protected override async Task OnInitializedAsync()
    {
        // Katalog (rapor listesi + filtre bayrakları) + yetki (şube seçimi) + kapsam (şube/araç/firma).
        await LoadCatalog();
        try
        {
            var cf = await Api.GetObjectAsync("/api/reports/company-filter");
            _showBranchSelect = cf.TryGetProperty("showBranchSelect", out var b) && b.ValueKind == JsonValueKind.True;
        }
        catch { }
        if (Auth.IsSuperAdmin) _companies = await Api.OptionsAsync("/api/companies", "id", "name");
        await LoadScope();
        ApplyDateDefault();
    }

    private async Task LoadCatalog()
    {
        try
        {
            var arr = await Api.GetArrayAsync("/api/reports/catalog");
            _catalog = arr.Select(e => new CatItem(
                Str(e, "key"), Str(e, "name"), Str(e, "description"), Str(e, "category"), Str(e, "categoryLabel"),
                Bool(e, "usesDate"), Bool(e, "usesBranch"), Bool(e, "usesVehicle"), Bool(e, "requiresDate"), Bool(e, "manager"))).ToList();
            if (_catalog.Count > 0 && _catalog.All(x => x.Key != _selKey)) _selKey = _catalog[0].Key;
        }
        catch { _catalog = new(); }
    }

    private string? _lastCompany;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (Auth.IsSuperAdmin && _companyId != _lastCompany)
        {
            _lastCompany = _companyId;
            await LoadScope();
            StateHasChanged();
        }
    }

    private async Task LoadScope()
    {
        try
        {
            var doc = await Api.GetObjectAsync("/api/reports/scope" + (string.IsNullOrEmpty(_companyId) ? "" : $"?companyId={_companyId}"));
            _branches = Read(doc, "branches", "id", "name");
            _vehicles = Read(doc, "vehicles", "id", "display");
            _branchSel = new HashSet<string>(); _vehicleSel = new HashSet<string>();
        }
        catch { }
    }

    private static List<ApiClient.Opt> Read(JsonElement doc, string key, string idKey, string nameKey)
    {
        var list = new List<ApiClient.Opt>();
        if (doc.TryGetProperty(key, out var arr) && arr.ValueKind == JsonValueKind.Array)
            foreach (var e in arr.EnumerateArray())
                list.Add(new ApiClient.Opt(e.GetProperty(idKey).GetString() ?? "", e.TryGetProperty(nameKey, out var n) ? n.GetString() ?? "" : ""));
        return list;
    }

    private static long? Ms(DateTime? d) => d is null ? null : new DateTimeOffset(d.Value, TimeSpan.Zero).ToUnixTimeMilliseconds();

    private async Task Run()
    {
        _busy = true; _error = null;
        try
        {
            var body = new
            {
                fromDate = _sel?.UsesDate == true ? Ms(_from) : null,
                toDate = _sel?.UsesDate == true ? Ms(_to) : null,
                branchIds = _sel?.UsesBranch == true ? _branchSel.ToList() : new List<string>(),
                vehicleIds = _sel?.UsesVehicle == true ? _vehicleSel.ToList() : new List<string>(),
                companyId = Auth.IsSuperAdmin ? _companyId : null
            };
            var doc = await Api.PostJsonAsync($"/api/reports/{_selKey}", body);
            if (doc is null) { _error = "Rapor alınamadı."; _headers = null; ClearSummary(); return; }
            var d = doc.Value;
            _headers = d.TryGetProperty("headers", out var h) && h.ValueKind == JsonValueKind.Array
                ? h.EnumerateArray().Select(x => x.GetString() ?? "").ToList() : new();
            _rows = new();
            if (d.TryGetProperty("rows", out var rows) && rows.ValueKind == JsonValueKind.Array)
                foreach (var row in rows.EnumerateArray())
                    _rows.Add(row.EnumerateArray().Select(Cell).ToList());
            BuildSummary();
        }
        catch (Exception ex) { _error = "Hata: " + ex.Message; _headers = null; ClearSummary(); }
        finally { _busy = false; }
    }

    private bool _exporting;
    private async Task ExportExcel()
    {
        if (_exporting) return;
        _exporting = true; _error = null;
        try
        {
            var body = new
            {
                fromDate = _sel?.UsesDate == true ? Ms(_from) : null,
                toDate = _sel?.UsesDate == true ? Ms(_to) : null,
                branchIds = _sel?.UsesBranch == true ? _branchSel.ToList() : new List<string>(),
                vehicleIds = _sel?.UsesVehicle == true ? _vehicleSel.ToList() : new List<string>(),
                companyId = Auth.IsSuperAdmin ? _companyId : null
            };
            var (bytes, fileName, status) = await Api.PostFileAsync($"/api/reports/{_selKey}/export", body, "Rapor.xlsx");
            if (status == 403) { _error = "Excel dışa aktarma yetkiniz yok. Yetki için firma yöneticinize başvurun."; return; }
            if (bytes is null) { _error = "Excel dışa aktarma başarısız."; return; }
            await JS.InvokeVoidAsync("dwDownload", fileName, Convert.ToBase64String(bytes),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex) { _error = "Hata: " + ex.Message; }
        finally { _exporting = false; }
    }

    private static string Cell(JsonElement v) => v.ValueKind switch
    {
        JsonValueKind.Null => "",
        JsonValueKind.String => v.GetString() ?? "",
        JsonValueKind.True => "Evet", JsonValueKind.False => "Hayır",
        _ => v.ToString(),
    };

    private static string Str(JsonElement e, string key)
        => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
    private static bool Bool(JsonElement e, string key)
        => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(key, out var v) && v.ValueKind == JsonValueKind.True;
}
