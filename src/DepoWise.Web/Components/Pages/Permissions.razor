@page "/permissions"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Yetkiler</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
    </div>
</div>

<MudPaper Class="pa-4" Elevation="2" Style="max-width:760px;">
    <MudGrid Spacing="2" Class="align-center mb-2">
        <MudItem xs="12">
            @* Kullanıcı seçilince mevcut yetkiler OTOMATİK yüklenir (masaüstüyle aynı davranış) — ayrı "Yükle" gerekmez. *@
            <MudSelect T="string" @bind-Value="_userId" Label="Kullanıcı" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value:after="OnUserChanged">
                @foreach (var u in _users) { <MudSelectItem T="string" Value="@u.Id">@u.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_userId))
    {
        @* YET-C3: ROL aynı ekranda. Rol, kullanıcının alabileceği yetkilerin ÜST SINIRINI belirler;
           ayrı ekrana gitmek gerekmesin diye buraya alındı. Kendi rolünü değiştirmek kilitlenme
           yarattığı için o durumda kutu kapalıdır. *@
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" md="5">
                <MudSelect T="string" Value="_roleKey" ValueChanged="OnRoleChanged" Label="Rol"
                           Margin="Margin.Dense" Variant="Variant.Outlined"
                           Disabled="@(!_edit || _isSelf)"
                           HelperText="Rol, bu kullanıcıya verilebilecek yetkilerin üst sınırıdır.">
                    @foreach (var r in _roles) { <MudSelectItem T="string" Value="@r.Key">@r.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
        </MudGrid>
        @if (_targetIsAdmin)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                Bu kullanıcı <b>Admin / Süper Admin</b> — TÜM ekranlara erişir (alanlar bu yüzden tam işaretli ve salt-okunur).
                Yetkilerini kısıtlamak için önce rolünü <b>Personel</b> yapın.
            </MudAlert>
        }
        @* YET-C3: ekran SALT-OKUNUR açılır — verilmiş yetkiler görünür ama yanlışlıkla değiştirilemez. *@
        <MudAlert Severity="@(_edit ? Severity.Warning : Severity.Normal)" Dense="true" Class="mb-2">
            @if (_edit)
            {
                <span>Düzenleme açık. İşaretli kutular <b>mevcut yetkilerdir</b>; değişiklikler <b>Kaydet</b> denene kadar yazılmaz.</span>
            }
            else
            {
                <span>Bu ekran şu an <b>salt-okunur</b>. Verilmiş yetkileri görüyorsunuz; değiştirmek için <b>Düzenle</b> deyin.</span>
            }
        </MudAlert>
        @if (_roleChanged)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                <b>Rol değişikliği bekliyor.</b> Kaydet dediğinizde önce rol yazılır, sonra yetki ağacı yeni role göre yenilenir.
            </MudAlert>
        }
        <PermMatrix @ref="_matrix" Modules="_modules" AdminOnly="_adminOnly" Buttons="_buttons" Groups="_moduleGroups"
                    FieldRows="_fieldRows" ReadOnlyAllAccess="_targetIsAdmin" Locked="@(!_edit)" />
        @* G1a (2026-08-12): Kaydet'in yanına ÖZET ve SIFIRLA. Sıfırlama yıkıcıdır → ayrı renk + onay. *@
        <MudStack Row="true" Spacing="2" Class="mt-3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            @if (!_targetIsAdmin && !_edit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="BeginEdit" Disabled="_busy">Düzenle</MudButton>
            }
            @if (!_targetIsAdmin && _edit)
            {
                @* A3 (ADR-116): şablon uygulamak için artık ayrı ekrana gitmek gerekmez.
                   Şablon SEÇİLİ KUTULARI DOLDURUR; hiçbir şey kaydedilmez — kararı "Kaydet" verir. *@
                @if (_templates.Count > 0)
                {
                    <MudSelect T="string" Value="_templateId" ValueChanged="ApplyTemplate" Label="Şablondan doldur"
                               Margin="Margin.Dense" Variant="Variant.Outlined" Dense="true"
                               Style="min-width:220px" Disabled="_busy"
                               HelperText="Kutuları doldurur; kaydetmez.">
                        @foreach (var t in _templates) { <MudSelectItem T="string" Value="@t.Id">@t.Name</MudSelectItem> }
                    </MudSelect>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Save" Disabled="_busy">@(_busy ? "…" : "Kaydet")</MudButton>
                @* ⭐ YTK-05: tüm ağacı tek hamlede temizler. Grup başına "Temizle" vardı; sıfırdan
                   yetki kurarken 8 grubu tek tek temizlemek gerekiyordu. Sunucuya HİÇBİR ŞEY YAZMAZ
                   (yıkıcı olan "Yetkileri Sıfırla"dır) → bu yüzden Error değil nötr renk. *@
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ClearAll"
                           OnClick="ClearAllPerms" Disabled="_busy"
                           Title="Ekrandaki tüm işaretleri kaldırır. Kaydet'e basmazsanız sunucuda hiçbir şey değişmez.">Tümünü Temizle</MudButton>
                <MudButton Variant="Variant.Text" OnClick="CancelEdit" Disabled="_busy">Vazgeç</MudButton>
            }
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FactCheck"
                       OnClick="LoadSummary" Disabled="_busy">Yetki Özeti</MudButton>
            @if (!_targetIsAdmin && !_isSelf)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.LayersClear"
                           OnClick="ResetPerms" Disabled="_busy">Yetkileri Sıfırla</MudButton>
            }
        </MudStack>

        @* ── ŞUBE KAPSAMI (G4-3d) ──────────────────────────────────────────────────────
             İKİNCİ BİR YETKİ AĞACI DEĞİLDİR: modül yetkileri yukarıdaki matriste kalır.
             Burada yalnız "hangi şubelerde" sorusu yönetilir.
             ETKİN ERİŞİM = MODÜL YETKİSİ ∧ ŞUBE KAPSAMI ∧ PLATFORM ∧ diğer kurallar.
             ⚠️ Liste AKTÖRÜN kapsamıyla kırpılmış gelir; asıl kapı serviste
                (BranchAccess.RequireGrantable) — yetkisiz şube gönderilirse HATA verir. *@
        @if (_scopeLoaded)
        {
            <MudPaper Class="pa-3 mt-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Şube Kapsamı</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    Mevcut kapsam: <b>@_scopeModeText</b>.
                    @if (_scopeMode == "own")
                    {
                        <span>Kullanıcı yalnız kendi şubesinde çalışır.</span>
                    }
                    else if (_scopeMode == "all")
                    {
                        <span>Kullanıcı tüm şubelere erişebilir (yönetici düzeyi / tüm şube yetkisi).</span>
                    }
                    else if (_scopeMode == "none")
                    {
                        <span>Şube atanmamış — kapsam kısıtı uygulanmaz. Sıkılaştırmak için şube seçin.</span>
                    }
                </MudText>

                @if (_isSelf)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Kendi şube kapsamınızı değiştiremezsiniz. Bunu başka bir yetkili yapmalıdır.
                    </MudAlert>
                }
                else if (_assignable.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        Devredebileceğiniz şube yok. Yalnız kendi kapsamınızdaki şubeleri verebilirsiniz.
                    </MudAlert>
                }
                else
                {
                    @* 🔴 2026-09-04 (kullanıcı bildirimi): kapalı kutuda ŞUBE ADI yerine ID'ler
                       ("1c6dc32bd8104936…") görünüyordu. MudBlazor çoklu seçimde varsayılan olarak
                       seçili DEĞERLERİ yazar; etiket göstermek için MultiSelectionTextFunc gerekir.
                       Aynı düzeltme Reports.razor ve BranchPicker'da zaten vardı — burada eksikti.
                       Kullanıcı sayı değil AD istedi: "bütün alanlarda tanım ismi ne ise o görünmeli". *@
                    @* ⭐ DÜZELTME (kullanıcı bildirimi 2026-09-06): şube kapsamı "Düzenle"ye basılmadan
                       değiştirilebiliyordu. Artık düzenleme modu şart; bölüm salt-okunur görünür. *@
                    <MudSelect T="string" MultiSelection="true" SelectedValues="_scopeSelected" Disabled="@(!_edit)"
                               SelectedValuesChanged="@(v => _scopeSelected = v?.ToHashSet(StringComparer.Ordinal) ?? new())"
                               MultiSelectionTextFunc="@(v => SubeAdlari(v))"
                               Label="Çalışabileceği şubeler" Margin="Margin.Dense" Variant="Variant.Outlined"
                               Dense="true" Style="max-width:520px"
                               HelperText="Boş bırakılırsa açık kapsam kaldırılır; kullanıcı kendi şubesi/varsayılan davranışına döner.">
                        @foreach (var b in _assignable)
                        {
                            <MudSelectItem T="string" Value="@b.Id">@b.Name</MudSelectItem>
                        }
                    </MudSelect>
                    @if (!_edit)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                            Şube kapsamını değiştirmek için önce yukarıdaki «Düzenle» düğmesine basın.
                        </MudText>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Class="mt-2"
                               OnClick="SaveScope" Disabled="@(_busy || !_edit)">Şube Kapsamını Kaydet</MudButton>
                }
            </MudPaper>
        }

        @if (_summary is not null)
        {
            <MudPaper Class="pa-3 mt-3" Elevation="2">
                <MudText Typo="Typo.subtitle1"><b>Yetki Özeti</b></MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@_summaryText</MudText>
                @if (_summary.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">Bu kullanıcının erişebildiği hiçbir ekran yok.</MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Striped="true" Style="max-height:320px;overflow:auto;">
                        <thead><tr><th>EKRAN</th><th>YAPABİLDİKLERİ</th></tr></thead>
                        <tbody>
                        @foreach (var m in _summary)
                        {
                            <tr><td>@m.Label</td><td>@m.Actions</td></tr>
                        }
                        </tbody>
                    </MudSimpleTable>
                }
                @if (_summaryButtons.Count > 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-2"><b>Özel izinler:</b> @string.Join(" · ", _summaryButtons)</MudText>
                }
            </MudPaper>
        }
    }
    @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
</MudPaper>

@* ═══ FAZ 3b-5 (ADR-223, 2026-09-05) — KORUMALI ALANLAR ══════════════════════════════════════
   FİRMA ayarıdır, kişiye özel değildir: "bu alan bizim için hassastır" der. Korumalı yapılan alan
   yukarıdaki yetki ağacında AYRI BİR SATIR olarak belirir ve oradan kişi/rol bazında açılır.

   ⚠️ Korumasız alan ağaçta GÖRÜNMEZ — bilerek: korumasız alanı zaten herkes görür, ağaçta boş bir
   kutu göstermek "kapalı" izlenimi verirdi. Liste boşken uygulama bugünküyle birebir aynı çalışır. *@
<MudPaper Class="pa-4 mt-4" Elevation="2" Style="max-width:760px;">
    <MudText Typo="Typo.h6" Class="mb-1">Korumalı Alanlar</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Bir alanı korumalı yaparsanız o alanı <b>yalnız yetkisi olan kişiler</b> görür.
        Yetkiyi yukarıdaki <b>yetki ağacından</b> (alanın kendi ekranının altında) verirsiniz.
        Hiçbir alan korumalı değilken uygulama <b>bugünkü gibi</b> çalışır.
    </MudText>

    @* ⭐ DÜZELTME (kullanıcı bildirimi 2026-09-06): bu kutular "Düzenle"ye basılmadan değiştirilebiliyor
       ve değişiklik ANINDA kaydediliyordu. Artık AYNI düzenleme modu şart. Kullanıcı seçilmeden de
       yönetilebilmesi gerektiği için düğme burada da sunulur — aynı `_edit` bayrağını kullanır. *@
    @if (!_edit)
    {
        <div class="d-flex align-center flex-wrap mb-3" style="gap:12px;">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Korumalı alanları değiştirmek için önce «Düzenle» düğmesine basın.
            </MudText>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                       OnClick="BeginEdit" Disabled="_busy">Düzenle</MudButton>
        </div>
    }

    @if (_korumaSatirlari.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">Korunabilir alan listesi yüklenemedi ya da boş.</MudAlert>
    }
    else
    {
        string? _sonEkran = null;
        <MudSimpleTable Dense="true" Bordered="true" Style="max-width:700px;">
            <thead><tr><th>Alan</th><th style="width:120px;">Korumalı</th><th>Ne olur?</th></tr></thead>
            <tbody>
            @foreach (var k in _korumaSatirlari)
            {
                @if (k.ScreenLabel != _sonEkran)
                {
                    _sonEkran = k.ScreenLabel;
                    <tr><td colspan="3" style="background:var(--mud-palette-background);"><b>@k.ScreenLabel</b></td></tr>
                }
                var satir = k;
                <tr>
                    <td>@satir.Label</td>
                    <td>
                        <MudCheckBox T="bool" Dense="true" Value="@satir.IsProtected" Disabled="@(_korumaBusy || !_edit)"
                                     ValueChanged="@(async (bool v) => await KorumaDegistir(satir, v))" />
                    </td>
                    <td><MudText Typo="Typo.caption" Class="mud-text-secondary">@satir.Note</MudText></td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            Değişiklik anında kaydedilir ve yetki ağacı yenilenir.
        </MudText>
    }
    @if (_korumaMsg is not null)
    {
        <MudAlert Severity="@(_korumaOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_korumaMsg</MudAlert>
    }
</MudPaper>

@* ═══ FAZ 3a (ADR-222, 2026-09-05) — ROL YETKİLERİ ═══════════════════════════════════════════
   AYRI bir bölüm olarak eklendi; yukarıdaki KULLANICI akışına HİÇ dokunulmadı (çalışan yapıyı
   bozmama şartı). Rol yetkisi, o role sahip HERKESE aynı izinleri EKLER — hiçbir şey kaldırmaz.

   ⚠️ Bu ekranda DENY yoktur ve bilerek gösterilmez: model yalnız ALLOW üretir (K1). "Globalde ver,
   ekranda engelle" gibi desteklenmeyen bir davranış kullanıcıya sunulmaz — aksi hâlde arayüz
   tutmayacağı bir söz vermiş olurdu. *@
<MudPaper Class="pa-4 mt-4" Elevation="2" Style="max-width:760px;">
    <MudText Typo="Typo.h6" Class="mb-1">Rol Yetkileri</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Bir role verilen yetkiler, o role sahip <b>tüm kullanıcılara EKLENİR</b>. Kişiye özel yetkiler
        yukarıdan verilmeye devam eder; ikisi birleşir ve <b>kimse bir şey kaybetmez</b>.
    </MudText>

    <MudSelect T="string" Value="_rolYetkiId" ValueChanged="OnRolYetkiSecildi" Label="Rol"
               Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
               HelperText="Yetkilerini düzenlemek istediğiniz rolü seçin.">
        @foreach (var r in _roles) { <MudSelectItem T="string" Value="@r.Key">@r.Name</MudSelectItem> }
    </MudSelect>

    @if (!string.IsNullOrEmpty(_rolYetkiId))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="my-2">
            Bu rolün yetkileri <b>@(_roles.FirstOrDefault(r => r.Key == _rolYetkiId)?.Name ?? "")</b> rolüne sahip
            her kullanıcıya uygulanır. Kaydettiğinizde etki <b>anında</b> geçerli olur; yeniden giriş gerekmez.
        </MudAlert>

        <PermMatrix @ref="_rolMatrix" Modules="_modules" AdminOnly="_adminOnly" Buttons="_buttons"
                    Groups="_moduleGroups" FieldRows="_fieldRows" Locked="@(!_rolEdit)" />

        <MudStack Row="true" Spacing="2" Class="mt-3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            @if (!_rolEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="@(() => _rolEdit = true)" Disabled="_rolBusy">Düzenle</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="RolYetkileriniKaydet"
                           Disabled="_rolBusy">@(_rolBusy ? "…" : "Kaydet")</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ClearAll"
                           OnClick="RolYetkileriniTemizle" Disabled="_rolBusy"
                           Title="Ekrandaki tüm işaretleri kaldırır. Kaydet'e basmazsanız sunucuda hiçbir şey değişmez.">Tümünü Temizle</MudButton>
                <MudButton Variant="Variant.Text" OnClick="RolDuzenlemeIptal" Disabled="_rolBusy">Vazgeç</MudButton>
            }
        </MudStack>

        @if (_rolMsg is not null)
        {
            <MudAlert Severity="@(_rolOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_rolMsg</MudAlert>
        }
    }
</MudPaper>

@code {
    private List<ApiClient.Opt> _users = new(), _modules = new(), _buttons = new();

    /// <summary>Ekran açıldığında kullanıcının SAHİP OLDUĞU ekranlar — "Kaydet" özeti bununla karşılaştırır.</summary>
    private HashSet<string> _yuklenenEkranlar = new(StringComparer.Ordinal);

    /// <summary>
    /// Seçili şube ID'lerini ADLARA çevirir (kullanıcı bildirimi 2026-09-04: kutuda ham ID görünüyordu).
    /// Ad bulunamazsa ID yazmak yerine "(bilinmeyen şube)" denir — kullanıcıya asla ham değer gösterilmez.
    /// Çok sayıda seçimde metin taşmasın diye ilk 4 ad + kalan sayısı gösterilir.
    /// </summary>
    private string SubeAdlari(IEnumerable<string>? secili)
    {
        var liste = secili?.ToList() ?? new List<string>();
        if (liste.Count == 0) return "Kendi şubesi (varsayılan)";

        var adlar = liste
            .Select(id => _assignable.FirstOrDefault(a => a.Id == id)?.Name)
            .Select(ad => string.IsNullOrWhiteSpace(ad) ? "(bilinmeyen şube)" : ad!)
            .OrderBy(x => x, StringComparer.CurrentCulture)
            .ToList();

        return adlar.Count <= 4
            ? string.Join(", ", adlar)
            : string.Join(", ", adlar.Take(4)) + $" +{adlar.Count - 4} şube";
    }

    /// <summary>
    /// ⭐ KAYDETME ÖZETİ (kullanıcı isteği 2026-09-04).
    ///
    /// Eskiden onay kutusu yalnız "Yetkiler kaydedilsin mi?" diyordu — kullanıcı NE kaydettiğini
    /// göremiyordu. Gerçek bir olayda bu acıttı: bazı yetkiler kaldırıldı sanıldı, veritabanına
    /// 60 modülün 60'ı da TAM yetkiyle yazılmıştı ve fark kaydetme anında görülemedi.
    /// Artık onay ekranı ne EKLENDİĞİNİ ve ne KALDIRILDIĞINI açıkça söyler.
    /// </summary>
    private string DegisiklikOzeti()
    {
        var secili = _matrix!.SelectedKeys().ToHashSet(StringComparer.Ordinal);
        string Ad(string k) => _modules.FirstOrDefault(m => m.Id == k)?.Name ?? k;

        var eklenen = secili.Except(_yuklenenEkranlar).Select(Ad).OrderBy(x => x, StringComparer.CurrentCulture).ToList();
        var kaldirilan = _yuklenenEkranlar.Except(secili).Select(Ad).OrderBy(x => x, StringComparer.CurrentCulture).ToList();

        if (eklenen.Count == 0 && kaldirilan.Count == 0)
            return "Ekran yetkilerinde değişiklik yok.\n\n" +
                   "(İşlem hakları — oluştur/düzenle/sil — değişmiş olabilir.)\n\nYine de kaydedilsin mi?";

        var sb = new System.Text.StringBuilder();
        if (kaldirilan.Count > 0)
        {
            sb.Append($"KALDIRILACAK ({kaldirilan.Count} ekran):\n• ");
            sb.Append(string.Join("\n• ", kaldirilan.Take(12)));
            if (kaldirilan.Count > 12) sb.Append($"\n• … ve {kaldirilan.Count - 12} ekran daha");
            sb.Append("\n\n");
        }
        if (eklenen.Count > 0)
        {
            sb.Append($"EKLENECEK ({eklenen.Count} ekran):\n• ");
            sb.Append(string.Join("\n• ", eklenen.Take(12)));
            if (eklenen.Count > 12) sb.Append($"\n• … ve {eklenen.Count - 12} ekran daha");
            sb.Append("\n\n");
        }
        sb.Append("Kaydedilsin mi?");
        return sb.ToString();
    }
    /// <summary>2026-09-03 — modül anahtarı → yetki ağacı kategorisi (menü grupları gibi).</summary>
    private Dictionary<string, string> _moduleGroups = new();
    private HashSet<string> _adminOnly = new();
    private readonly HashSet<string> _restricted = new();   // #3: alt role verilemeyen modüller

    // ── FAZ 3b-5: alan yetkisi ──────────────────────────────────────────────────────────────
    /// <summary>Yetki ağacında ALAN satırı olan anahtarlar (fld_*) — sunucudan gelir.</summary>
    private HashSet<string> _fieldRows = new(StringComparer.Ordinal);

    private sealed record KorumaSatiri(string ScreenKey, string ScreenLabel, string FieldKey,
        string Label, string Note, bool IsProtected);

    private List<KorumaSatiri> _korumaSatirlari = new();
    private bool _korumaBusy, _korumaOk;
    private string? _korumaMsg;

    private async Task KorumaYukle()
    {
        try
        {
            var liste = new List<KorumaSatiri>();
            foreach (var e in await Api.GetArrayAsync("/api/field-protections"))
                liste.Add(new KorumaSatiri(S(e, "screenKey"), S(e, "screenLabel"), S(e, "fieldKey"),
                    S(e, "label"), S(e, "note"), Bo(e, "isProtected")));
            _korumaSatirlari = liste;
        }
        catch (Exception ex) { _korumaOk = false; _korumaMsg = "Korumalı alanlar yüklenemedi: " + ex.Message; }
    }

    /// <summary>
    /// Korumayı açar/kapatır. Değişiklik ANINDA kaydedilir (tek kutu = tek karar; "kaydet" beklemek
    /// yetki ağacının bayat kalmasına yol açardı) ve ardından AĞAÇ YENİLENİR — yeni alan satırı
    /// hemen görünür/kaybolur.
    /// </summary>
    private async Task KorumaDegistir(KorumaSatiri satir, bool korumali)
    {
        // ⭐ İKİNCİ KAPI (2026-09-06): arayüz kilidi atlansa bile düzenleme modu dışında YAZILMAZ.
        if (!_edit) return;
        _korumaBusy = true; _korumaMsg = null;
        try
        {
            var err = await Api.PostAsync("/api/field-protections",
                new { screenKey = satir.ScreenKey, fieldKey = satir.FieldKey, isProtected = korumali });
            if (err is not null) { _korumaOk = false; _korumaMsg = err; return; }

            _korumaOk = true;
            _korumaMsg = korumali
                ? $"«{satir.Label}» korumalı yapıldı. Yetki ağacından kimlerin göreceğini seçin."
                : $"«{satir.Label}» koruması kaldırıldı; alanı herkes görür.";

            await KorumaYukle();
            // Ağaç yeniden kurulur: korumalı alan satırı belirir/kaybolur.
            await LoadModules(string.IsNullOrEmpty(_userId) ? null : _userId);
            if (!string.IsNullOrEmpty(_userId)) _loadPending = true;   // yetkiler render sonrası tazelenir
        }
        catch (Exception ex) { _korumaOk = false; _korumaMsg = "Kaydedilemedi: " + ex.Message; }
        finally { _korumaBusy = false; }
    }
    private readonly HashSet<string> _adminUserIds = new();  // hedef Admin/Süper mi
    private string? _userId;
    private bool _targetIsAdmin;   // hedef Admin/Süper Admin → matris tam işaretli + salt-okunur

    private PermMatrix? _matrix;
    private string? _msg; private bool _ok; private bool _busy;
    /// <summary>KLT-01c DÜZENLEME KİLİDİ: ekran açılırken okunan yetki sürümü (0 = bilinmiyor → kontrol yok).</summary>
    private long _permVersion;
    private bool _loadPending;   // kullanıcı seçildi → matrix render edilince yetkileri otomatik yükle

    // ═══ YET-C3 — DÜZENLE → KAYDET AKIŞI + ROL ═══════════════════════════════════════════════
    /// <summary>Düzenleme modu. false = salt-okunur (varsayılan).</summary>
    private bool _edit;
    private List<RoleDto> _roles = new();
    /// <summary>Kutuda seçili rol.</summary>
    private string? _roleKey;
    /// <summary>Kullanıcı yüklendiğindeki rol — "değişti mi" karşılaştırması bununla yapılır.</summary>
    private string? _loadedRoleKey;
    private bool _roleChanged => _roleKey is not null && _loadedRoleKey is not null
                                 && !string.Equals(_roleKey, _loadedRoleKey, StringComparison.Ordinal);

    /// <summary>Düzenleme moduna geç. ⭐ Yüklenmiş yetkilere DOKUNMAZ — yalnız kilidi açar.</summary>
    private async Task BeginEdit()
    {
        // ⭐ FAZ 4.2: standart işlem onayı (kullanıcı isteği 2026-09-06).
        if (!await Dialog.ConfirmEdit()) return;
        _edit = true; _msg = null;
    }

    /// <summary>Vazgeç — sunucudan taze yükleyip salt-okunur moda döner (yarım değişiklik kalmaz).</summary>
    private async Task CancelEdit()
    {
        _edit = false; _msg = null;
        _roleKey = _loadedRoleKey;
        await LoadUserPerms();
    }

    private void OnRoleChanged(string? v) { _roleKey = v; }

    // ═══ A3 — ŞABLONDAN DOLDURMA ═════════════════════════════════════════════════════════════
    /// <summary>Uygulanabilir şablonlar (kendi firması + tüm-firma şablonları).</summary>
    private List<ApiClient.Opt> _templates = new();
    private string? _templateId;

    /// <summary>
    /// Şablonu MATRİSE yazar — sunucuya HİÇBİR ŞEY göndermez. Kullanıcı isterse üzerinde değişiklik
    /// yapar, sonra "Kaydet" der. Böylece şablon "uygulandı ve kaydedildi" sürprizi olmaz.
    /// </summary>
    private async Task ApplyTemplate(string? id)
    {
        _templateId = id;
        if (string.IsNullOrEmpty(id) || _matrix is null) return;
        _busy = true; _msg = null;
        try
        {
            var d = await Api.GetObjectAsync($"/api/permission-templates/{id}");
            var mods = new List<(string, bool, bool, bool, bool)>();
            if (d.TryGetProperty("modules", out var ms) && ms.ValueKind == JsonValueKind.Array)
                foreach (var m in ms.EnumerateArray())
                    mods.Add((S(m, "moduleKey"), Bo(m, "canView"), Bo(m, "canCreate"), Bo(m, "canEdit"), Bo(m, "canDelete")));
            _matrix.LoadFrom(mods);

            var btns = new List<string>();
            if (d.TryGetProperty("buttons", out var bs) && bs.ValueKind == JsonValueKind.Array)
                foreach (var b in bs.EnumerateArray()) { var v = b.GetString(); if (!string.IsNullOrEmpty(v)) btns.Add(v!); }
            _matrix.LoadButtons(btns);

            var ad = _templates.FirstOrDefault(t => t.Id == id)?.Name ?? "Şablon";
            _ok = true; _msg = $"\"{ad}\" şablonu kutulara uygulandı. Gözden geçirip Kaydet deyin.";
        }
        catch (Exception ex) { _ok = false; _msg = "Şablon uygulanamadı: " + ex.Message; }
        finally { _busy = false; }
    }

    private static bool Bo(JsonElement e, string k) => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.True;

    protected override async Task OnInitializedAsync()
    {
        // ⭐ YET-C4 (gerçek arayüz turunda bulundu): ilk yükleme çağrıları KORUMASIZDI. Sunucu 401/500
        // dönerse istisna render sırasında patlıyor, Blazor devresi TAMAMEN düşüyor ("bağlantı kesildi")
        // ve kullanıcı bembeyaz ekranla kalıyordu. Artık hata YAKALANIR ve ekranda yazılır.
        try
        {
            await LoadUsers();
            await LoadModules();
        }
        catch (Exception ex) { _ok = false; _msg = "Ekran yüklenemedi: " + ex.Message; }
        try { _buttons = await Api.OptionsAsync("/api/buttons", "key", "label"); } catch { }
        try { _roles = await Api.GetRolesAsync(); } catch { }
        try { _templates = await Api.OptionsAsync("/api/permission-templates/for-user", "id", "name"); } catch { }
        await KorumaYukle();   // FAZ 3b-5
    }

    /// <summary>Kullanıcı seçilince ağaç yeni render edilir; matrix hazır olunca (ilk seçimde ref henüz null
    /// olabilir) mevcut yetkiler BİR KEZ otomatik yüklenir → ekran artık boş açılmaz.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loadPending && _matrix is not null)
        {
            _loadPending = false;
            await LoadUserPerms();
        }
        // FAZ 3a: rol matrisi de render OLDUKTAN SONRA doldurulur (kullanıcı akışıyla aynı desen —
        // bileşen referansı ilk render'da henüz yoktur).
        if (_rolYuklemeBekliyor && _rolMatrix is not null)
        {
            _rolYuklemeBekliyor = false;
            await RolYetkileriniYukle();
            StateHasChanged();
        }
    }

    private async Task LoadUsers()
    {
        _users = new(); _adminUserIds.Clear();
        try
        {
            foreach (var e in await Api.GetArrayAsync("/api/users"))
            {
                var id = S(e, "id"); if (id == "") continue;
                var name = S(e, "username"); if (name == "") name = S(e, "fullName");
                _users.Add(new ApiClient.Opt(id, name));
                if (e.TryGetProperty("isAdmin", out var a) && a.ValueKind == JsonValueKind.True) _adminUserIds.Add(id);
            }
        }
        catch { }
    }

    /// <summary>Kullanıcı değişince ağacı ONUN ROLÜNE göre yeniden kur — Rol Yetki Kontrol'de o role
    /// kapatılmış ekranlar ağaçta hiç görünmez.</summary>
    private async Task OnUserChanged()
    {
        _msg = null;
        _edit = false;   // başka kullanıcıya geçerken yarım düzenleme taşınmaz
        if (string.IsNullOrEmpty(_userId)) { _roleKey = _loadedRoleKey = null; return; }
        _targetIsAdmin = _adminUserIds.Contains(_userId);   // admin hedef → matris tam işaretli + salt-okunur
        try
        {
            var rd = await Api.GetObjectAsync($"/api/users/{_userId}/roles");
            _loadedRoleKey = rd.ValueKind == JsonValueKind.Array && rd.GetArrayLength() > 0
                ? rd[0].GetString() : null;
            _roleKey = _loadedRoleKey;
        }
        catch { _roleKey = _loadedRoleKey = null; }
        try { await LoadModules(_userId); } catch (Exception ex) { _msg = "Ekran listesi yüklenemedi: " + ex.Message; _ok = false; return; }
        _loadPending = true;   // render sonrası mevcut yetkileri otomatik yükle (OnAfterRenderAsync)
        await LoadScope();     // G4-3d: şube kapsamı da kullanıcıyla birlikte gelir
    }

    private async Task LoadModules(string? userId = null)
    {
        _modules = new(); _adminOnly = new(); _moduleGroups = new(); _fieldRows = new();
        var url = string.IsNullOrEmpty(userId) ? "/api/modules" : $"/api/modules?userId={Uri.EscapeDataString(userId)}";
        foreach (var e in await Api.GetArrayAsync(url))
        {
            var key = S(e, "key"); if (key == "") continue;
            _modules.Add(new ApiClient.Opt(key, S(e, "label")));
            // 2026-09-03: kategori bilgisi (menü gibi gruplu ağaç + grup başına Tümünü Seç).
            _moduleGroups[key] = S(e, "group");
            if (e.TryGetProperty("adminOnly", out var a) && a.ValueKind == JsonValueKind.True) _adminOnly.Add(key);
            if (e.TryGetProperty("restricted", out var r) && r.ValueKind == JsonValueKind.True) _restricted.Add(key);
            // FAZ 3b-5: alan kalemi mi? (yalnız Oku/Düzelt çizilir + EDIT ⇒ VIEW bağlaması)
            if (e.TryGetProperty("fieldItem", out var fi) && fi.ValueKind == JsonValueKind.True) _fieldRows.Add(key);
        }
    }

    private async Task LoadUserPerms()
    {
        _msg = null;
        if (string.IsNullOrEmpty(_userId) || _matrix is null) return;
        try
        {
            var doc = await Api.GetObjectAsync($"/api/permissions/{_userId}");
            var list = new List<(string, bool, bool, bool, bool)>();
            if (doc.TryGetProperty("modules", out var mods) && mods.ValueKind == JsonValueKind.Array)
                foreach (var m in mods.EnumerateArray())
                    list.Add((S(m, "moduleKey"), B(m, "canView"), B(m, "canCreate"), B(m, "canEdit"), B(m, "canDelete")));
            _matrix.LoadFrom(list);
            // Kaydetmeden önceki ÖZET için başlangıç durumu saklanır (kullanıcı isteği 2026-09-04).
            _yuklenenEkranlar = list.Where(x => x.Item2 || x.Item3 || x.Item4 || x.Item5)
                .Select(x => x.Item1).ToHashSet(StringComparer.Ordinal);
            var btnKeys = new List<string>();
            if (doc.TryGetProperty("buttons", out var btns) && btns.ValueKind == JsonValueKind.Array)
                foreach (var b in btns.EnumerateArray())
                    if (b.ValueKind == JsonValueKind.String) btnKeys.Add(b.GetString() ?? "");
            _matrix.LoadButtons(btnKeys);
            // KLT-01c DÜZENLEME KİLİDİ: kaydederken geri gönderilir; arada başkası kaydettiyse sunucu 409 döner.
            _permVersion = doc.TryGetProperty("version", out var pv) && pv.TryGetInt64(out var pvv) ? pvv : 0;
        }
        catch (Exception ex) { _msg = "Yüklenemedi: " + ex.Message; _ok = false; }
    }

    // ── G1a: YETKİ ÖZETİ + SIFIRLAMA (2026-08-12) ────────────────────────────────────────────
    private sealed record SumRow(string Label, string Actions);
    private List<SumRow>? _summary;
    private List<string> _summaryButtons = new();
    private string _summaryText = "";

    /// <summary>Kendi yetkisini sıfırlamak kullanıcıyı kendi ekranından kilitler → düğme gizlenir
    /// (sunucu da ayrıca reddeder — UI tek savunma değildir).</summary>
    private bool _isSelf => !string.IsNullOrEmpty(_userId) && _userId == Auth.UserId;

    private async Task LoadSummary()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        _busy = true; _msg = null;
        try
        {
            var d = await Api.GetObjectAsync($"/api/permissions/{_userId}/summary");
            _summaryText = d.TryGetProperty("sourceText", out var st) ? st.GetString() ?? "" : "";
            _summary = d.TryGetProperty("modules", out var ms) && ms.ValueKind == JsonValueKind.Array
                ? ms.EnumerateArray().Select(m => new SumRow(
                    m.GetProperty("label").GetString() ?? "",
                    m.GetProperty("actionsText").GetString() ?? "—")).ToList()
                : new();
            _summaryButtons = d.TryGetProperty("buttons", out var bs) && bs.ValueKind == JsonValueKind.Array
                ? bs.EnumerateArray().Select(b => b.GetProperty("label").GetString() ?? "").ToList()
                : new();
        }
        catch (Exception ex) { _ok = false; _msg = "Özet alınamadı: " + ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>
    /// ⭐ YTK-05 — TÜM AĞACI TEMİZLE (masaüstündeki <c>ClearAllPerms</c> ile aynı davranış).
    ///
    /// ⚠️ <see cref="ResetPerms"/>'ten FARKI: bu işlem sunucuya <b>hiçbir şey yazmaz</b> — yalnız
    /// ekrandaki kutuları boşaltır. Kaydet'e basılmazsa değişiklik olmaz, Vazgeç eski hâli getirir.
    /// </summary>
    // ═══ FAZ 3a (ADR-222, 2026-09-05) — ROL YETKİLERİ ═══════════════════════════════════════
    //
    // Ayrı durum değişkenleri kullanılır; yukarıdaki KULLANICI akışının hiçbir alanı paylaşılmaz
    // → mevcut ekran davranışı hiç değişmez (çalışanı bozmama şartı).
    //
    // ⚠️ Rol yetkisi YALNIZ EKLER (K1). Bu yüzden burada "kaldır/engelle" kavramı yoktur; kutunun
    // boş olması "o izni bu rol VERMİYOR" demektir, "yasaklıyor" demek DEĞİLDİR.

    private PermMatrix? _rolMatrix;
    private string? _rolYetkiId;      // rol ANAHTARI (API ve Rol Yetki Kontrol ekranı da anahtarla konuşur)
    private bool _rolEdit, _rolBusy, _rolOk;
    private string? _rolMsg;
    private bool _rolYuklemeBekliyor;

    private async Task OnRolYetkiSecildi(string? roleKey)
    {
        _rolYetkiId = roleKey;
        _rolEdit = false;
        _rolMsg = null;
        if (string.IsNullOrEmpty(roleKey)) return;

        // Modül listesi AKTÖRÜN verebilecekleriyle kırpılmış gelir (mevcut /api/modules davranışı).
        if (_modules.Count == 0)
            try { await LoadModules(); } catch (Exception ex) { _rolOk = false; _rolMsg = "Ekran listesi yüklenemedi: " + ex.Message; return; }

        _rolYuklemeBekliyor = true;   // matris render olduktan SONRA doldurulur (kullanıcı akışıyla aynı desen)
    }

    private async Task RolYetkileriniYukle()
    {
        if (string.IsNullOrEmpty(_rolYetkiId) || _rolMatrix is null) return;
        try
        {
            var doc = await Api.GetObjectAsync($"/api/permissions/role/{Uri.EscapeDataString(_rolYetkiId)}");
            var list = new List<(string, bool, bool, bool, bool)>();
            if (doc.TryGetProperty("modules", out var mods) && mods.ValueKind == JsonValueKind.Array)
                foreach (var m in mods.EnumerateArray())
                    list.Add((S(m, "moduleKey"), B(m, "canView"), B(m, "canCreate"), B(m, "canEdit"), B(m, "canDelete")));
            _rolMatrix.LoadFrom(list);

            var btnKeys = new List<string>();
            if (doc.TryGetProperty("buttons", out var btns) && btns.ValueKind == JsonValueKind.Array)
                foreach (var b in btns.EnumerateArray())
                    if (b.ValueKind == JsonValueKind.String) btnKeys.Add(b.GetString() ?? "");
            _rolMatrix.LoadButtons(btnKeys);
        }
        catch (Exception ex) { _rolOk = false; _rolMsg = "Rol yetkileri yüklenemedi: " + ex.Message; }
    }

    private async Task RolYetkileriniTemizle()
    {
        if (_rolMatrix is null || !_rolEdit) return;
        if (!await Dialog.Confirm(
            "Bu ROLE ait tüm yetki işaretleri kaldırılsın mı?\n\n" +
            "Sunucuya hiçbir şey yazmaz — Kaydet'e basmazsanız hiçbir değişiklik olmaz.",
            "Evet, Temizle")) return;
        _rolMatrix.Clear();
    }

    private void RolDuzenlemeIptal()
    {
        _rolEdit = false;
        _rolMsg = null;
        _rolYuklemeBekliyor = true;   // sunucudaki gerçek durumu geri yükle
    }

    private async Task RolYetkileriniKaydet()
    {
        if (string.IsNullOrEmpty(_rolYetkiId) || _rolMatrix is null) return;
        var rolAdi = _roles.FirstOrDefault(r => r.Key == _rolYetkiId)?.Name ?? _rolYetkiId;

        if (!await Dialog.Confirm(
                $"\"{rolAdi}\" rolünün yetkileri kaydedilecek.\n\n" +
                "Bu yetkiler, bu role sahip TÜM kullanıcılara EKLENİR. Kimsenin mevcut yetkisi kaldırılmaz.\n\n" +
                "Etki anında geçerli olur; kullanıcıların yeniden giriş yapması gerekmez.",
                "Evet, Kaydet")) return;

        _rolBusy = true; _rolMsg = null;
        try
        {
            var err = await Api.PostAsync($"/api/permissions/role/{Uri.EscapeDataString(_rolYetkiId)}",
                new { modules = _rolMatrix.Collect(), buttons = _rolMatrix.CollectButtons() });
            if (err is not null) { _rolOk = false; _rolMsg = err; return; }
            _rolOk = true;
            _rolMsg = $"\"{rolAdi}\" rolünün yetkileri kaydedildi.";
            _rolEdit = false;
            _rolYuklemeBekliyor = true;   // sunucunun GERÇEKTE yazdığını göster (tavan kırpmış olabilir)
        }
        catch (Exception ex) { _rolOk = false; _rolMsg = "Kaydedilemedi: " + ex.Message; }
        finally { _rolBusy = false; }
    }

    private async Task ClearAllPerms()
    {
        if (_matrix is null || !_edit) return;
        if (!await Dialog.Confirm(
            "Ekrandaki TÜM yetki işaretleri kaldırılsın mı?\n\n" +
            "Bu işlem sunucuya hiçbir şey yazmaz — Kaydet'e basmazsanız hiçbir değişiklik olmaz.",
            "Evet, Temizle")) return;
        _matrix.Clear();
    }

    /// <summary>Yıkıcı işlem → açık onay + ne olacağının düz anlatımı (teknik terim yok).</summary>
    private async Task ResetPerms()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        var who = _users.FirstOrDefault(u => u.Id == _userId)?.Name ?? "bu kullanıcı";
        if (!await Dialog.Confirm(
            $"{who} adlı kullanıcının TÜM ekran ve buton yetkileri silinecek.\n\n" +
            "Sonrasında hiçbir ekrana erişemez; yetkileri yeniden verilene kadar yalnız giriş yapabilir.\n" +
            "Kullanıcı kaydı ve rolü SİLİNMEZ, yalnız yetkileri temizlenir.\n\nDevam edilsin mi?",
            "Evet, Sıfırla", danger: true)) return;

        _busy = true; _msg = null;
        try
        {
            var err = await Api.PostAsync($"/api/permissions/{_userId}/reset", new { version = _permVersion });
            _ok = err is null;
            _msg = err ?? "Yetkiler sıfırlandı. Kullanıcı artık hiçbir ekrana erişemez.";
            if (_ok) { _summary = null; await LoadUserPerms(); }
        }
        catch (Exception ex) { _ok = false; _msg = "Sıfırlanamadı: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task Save()
    {
        if (string.IsNullOrEmpty(_userId) || _matrix is null) return;

        // ── YET-C3: ROL DEĞİŞİKLİĞİ (varsa) ÖNCE uygulanır — masaüstüyle AYNI kural ────────────
        // Rol yetki tavanını belirler; önce rol yazılır, sonra ağaç o role göre yeniden yüklenir.
        if (_roleChanged && _roleKey is not null)
        {
            if (_isSelf) { _ok = false; _msg = "Kendi rolünüzü bu ekrandan değiştiremezsiniz."; return; }
            var yeniAd = _roles.FirstOrDefault(r => r.Key == _roleKey)?.Name ?? _roleKey;
            if (!await Dialog.Confirm(
                    $"Bu kullanıcının rolü \"{yeniAd}\" olarak değiştirilecek." + Environment.NewLine + Environment.NewLine +
                    "Rol, kullanıcının alabileceği yetkilerin ÜST SINIRINI belirler; kaydedildikten sonra " +
                    "yetki ağacı yeni role göre yeniden yüklenir." + Environment.NewLine + Environment.NewLine + "Devam edilsin mi?",
                    "Evet, Rolü Değiştir")) return;

            _busy = true; _msg = null;
            try
            {
                var rerr = await Api.PostAsync($"/api/users/{_userId}/roles", new { roles = new[] { _roleKey } });
                if (rerr is not null) { _ok = false; _msg = "Rol değiştirilemedi: " + rerr; return; }
                _loadedRoleKey = _roleKey;
                if (_roleKey == "role-company-admin" || _roleKey == "role-super-admin"
                    || _roleKey == "role-restricted-super-admin") _adminUserIds.Add(_userId!);
                else _adminUserIds.Remove(_userId!);
                _edit = false;
                await OnUserChanged();   // ağaç yeni role göre taze kurulur
                _ok = true;
                _msg = $"Rol \"{yeniAd}\" olarak değiştirildi. Yetki ağacı yenilendi — ekran yetkilerini şimdi düzenleyebilirsiniz.";
            }
            catch (Exception ex) { _ok = false; _msg = "Rol değiştirilemedi: " + ex.Message; }
            finally { _busy = false; }
            return;
        }

        // #3: Kısıtlı modül (Yönetim/Kullanıcı/Yetkiler...) seçili + hedef Admin değil + aktör süper admin değil →
        // uyarı: onaylanırsa kullanıcı Admin'e yükseltilir (Admin tüm ekranlara erişir).
        var causeKeys = _matrix.SelectedKeys().Where(k => _restricted.Contains(k)).ToList();
        bool targetIsAdmin = _adminUserIds.Contains(_userId);
        bool needUpgrade = causeKeys.Count > 0 && !targetIsAdmin && !Auth.IsSuperAdmin;
        if (needUpgrade)
        {
            var causeNames = causeKeys.Select(k => _modules.FirstOrDefault(m => m.Id == k)?.Name ?? k);
            var reason =
                "Seçtiğiniz şu ekranlar yalnız Admin'e verilebilir:\n• " + string.Join("\n• ", causeNames) +
                "\n\nOnaylarsanız bu kullanıcının rolü ADMIN olarak değiştirilecek ve TÜM ekranlara erişebilecektir. Devam edilsin mi?";
            if (!await Dialog.Confirm(reason, "Evet, Admin Yap", danger: true)) return;
        }
        else if (!await Dialog.Confirm(DegisiklikOzeti())) return;

        _busy = true; _msg = null;
        try
        {
            if (needUpgrade)
            {
                // Admin'e yükselt → Admin zaten TÜM ekranlara erişir; granular yetki kaydına gerek yok
                // (ayrıca hedef artık admin olduğundan #8 gereği firma admini onun yetkisini düzenleyemez).
                var rerr = await Api.PostAsync($"/api/users/{_userId}/roles", new { roles = new[] { "role-company-admin" } });
                if (rerr is not null) { _ok = false; _msg = "Rol yükseltilemedi: " + rerr; return; }
                _adminUserIds.Add(_userId!);
                _edit = false;
                _ok = true; _msg = "Kullanıcı Admin yapıldı — tüm ekranlara erişebilir.";
            }
            else
            {
                var err = await Api.PostAsync($"/api/permissions/{_userId}",
                    new { modules = _matrix.Collect(), buttons = _matrix.CollectButtons(), version = _permVersion });
                if (err is not null)
                {
                    // KLT-01c: arada başka bir yönetici kaydetmiş → değişiklik YAZILMADI.
                    // Ekranı yenilemiyoruz ki yöneticinin işaretledikleri kaybolmasın; kararı kendisi versin.
                    _ok = false;
                    _msg = err;
                    return;
                }
                _edit = false;   // kaydedildi → ekran tekrar salt-okunur
                _ok = true; _msg = "Yetkiler kaydedildi.";
                _permVersion++;   // sunucu sürümü artırdı; ekranı kapatmadan ikinci kayıt yapılabilsin
            }
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private static string S(JsonElement e, string k) => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
    private static bool B(JsonElement e, string k) => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.True;

    // ── ŞUBE KAPSAMI (G4-3d) ─────────────────────────────────────────────────────────────
    // İkinci bir yetki sistemi DEĞİLDİR: mevcut PermissionService/BranchAccess üzerinden çalışır.
    private bool _scopeLoaded;
    private string _scopeMode = "", _scopeModeText = "";
    private List<ApiClient.Opt> _assignable = new();
    private HashSet<string> _scopeSelected = new(StringComparer.Ordinal);

    /// <summary>Seçili kullanıcının şube kapsamını + AKTÖRÜN verebileceği şubeleri okur.</summary>
    private async Task LoadScope()
    {
        _scopeLoaded = false;
        _assignable = new();
        _scopeSelected = new(StringComparer.Ordinal);
        if (string.IsNullOrWhiteSpace(_userId)) return;
        try
        {
            var d = await Api.GetObjectAsync($"/api/permissions/{_userId}/branch-scope");
            _scopeMode = d.TryGetProperty("mode", out var m) ? (m.GetString() ?? "") : "";
            _scopeModeText = d.TryGetProperty("modeText", out var mt) ? (mt.GetString() ?? "") : "";
            if (d.TryGetProperty("assignable", out var a) && a.ValueKind == JsonValueKind.Array)
                _assignable = a.EnumerateArray()
                    .Select(x => new ApiClient.Opt(
                        x.TryGetProperty("id", out var i) ? (i.GetString() ?? "") : "",
                        x.TryGetProperty("name", out var n) ? (n.GetString() ?? "") : ""))
                    .ToList();
            if (d.TryGetProperty("scopeBranchIds", out var s) && s.ValueKind == JsonValueKind.Array)
                _scopeSelected = s.EnumerateArray().Select(x => x.GetString() ?? "")
                    .Where(x => x.Length > 0).ToHashSet(StringComparer.Ordinal);
            _scopeLoaded = true;
        }
        catch (Exception ex) { _ok = false; _msg = "Şube kapsamı alınamadı: " + ex.Message; }
    }

    /// <summary>
    /// Kapsamı kaydeder. Yetkisiz şube gönderilirse servis AÇIK HATA döner (sessiz kırpma yok) —
    /// mesaj kullanıcıya olduğu gibi gösterilir.
    /// </summary>
    private async Task SaveScope()
    {
        if (_busy || string.IsNullOrWhiteSpace(_userId)) return;
        _busy = true; _msg = null;
        try
        {
            var err = await Api.PutAsync($"/api/permissions/{_userId}/branch-scope",
                new { branchIds = _scopeSelected.ToArray() });
            _ok = err is null;
            _msg = err ?? "Şube kapsamı kaydedildi.";
            if (_ok) await LoadScope();   // kip değişmiş olabilir (explicit ↔ own/all)
        }
        catch (Exception ex) { _ok = false; _msg = "Kaydedilemedi: " + ex.Message; }
        finally { _busy = false; }
    }
}
