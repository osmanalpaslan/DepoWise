@page "/company-permissions"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

<PageTitle>Firma Yetki Paketi — Alpnex</PageTitle>

@if (!Auth.IsSuperAdmin)
{
    <MudAlert Severity="Severity.Error">Bu ekran yalnız süper admin içindir.</MudAlert>
}
else
{
    <div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
        <div>
            <MudText Typo="Typo.h5" Class="dw-pagetitle">Firma Yetki Paketi</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b>@(Auth.IsSuperAdmin ? " · Süper Admin" : "")</MudText>
        </div>
    </div>
    @* A2 (ADR-116): "Firma Yetki Kontrol" ve "Rol Yetki Kontrol" TEK EKRANDA birleşti. İkisi de aynı
       soruyu yanıtlıyordu — "bu ekran kime verilebilir?" — ama biri firma bazlı, diğeri TÜM FİRMALAR
       için ortaktı. Artık ikisi de FİRMA BAZLI ve tek firma seçicisiyle yönetiliyor. *@
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="max-width:78ch;">
        Seçtiğiniz firmanın yetki tavanını burada belirlersiniz. <b>Ekran paketi</b> sekmesi
        "bu ekran bu firmada kime kadar verilebilir", <b>Rol tavanı</b> sekmesi "bu ekran hangi role
        verilebilir" sorusunu yanıtlar. <b>Her ikisi de yalnız seçili firmayı etkiler.</b>
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="max-width:74ch;">
        Ekran paketi düzeyleri:
        <b>🟢 Serbest</b> — firma adminleri bu ekranı tüm personele verebilir.
        <b>🟡 Admin</b> — yalnız Admin (personele verilemez).
        <b>🔴 Süper Admin</b> — yalnız Süper Admin ve “Kısıtlı Süper Admin” rolüne verilebilir.
        <b>“(sabit)”</b> etiketli ekranlar yapısal olarak kilitlidir ve değiştirilemez.
    </MudText>

    <MudPaper Class="pa-4 mb-3" Elevation="2">
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" md="5">
                <MudSelect T="string" @bind-Value="_companyId" Label="Firma" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value:after="LoadAll">
                    @foreach (var c in _companies) { <MudSelectItem T="string" Value="@c.Id">@c.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Ekran ara (örn. yakıt, rapor, bakım…)"
                              Margin="Margin.Dense" Variant="Variant.Outlined" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Disabled="@(_rows is null)" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ⭐ YÜKLEME HATASI HER DURUMDA GÖRÜNÜR (2026-08-19). Eskiden hata mesajı yalnız tablo
       çizildikten sonraki bölümde duruyordu; yükleme başarısız olunca sayfa sonsuza kadar dönen
       tekerlekte kalıyor ve kullanıcı NEDENİNİ hiç göremiyordu. *@
    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            @_loadError
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="ml-2" OnClick="Load">Yeniden dene</MudButton>
        </MudAlert>
    }

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Class="mb-3">
    <MudTabPanel Text="Ekran paketi" Icon="@Icons.Material.Filled.ViewList">
    @if (_rows is not null)
    {
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="4">
                <MudPaper Class="pa-3" Elevation="1" Style="border-radius:12px">
                    <MudText Typo="Typo.h5" Style="color:var(--mud-palette-success)">@_rows.Count(r => r.Level == LFree)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Serbest — admin personele verebilir</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="4">
                <MudPaper Class="pa-3" Elevation="1" Style="border-radius:12px">
                    <MudText Typo="Typo.h5" Style="color:var(--mud-palette-warning)">@_rows.Count(r => r.Level == LAdmin)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Admin — yalnız adminler</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="4">
                <MudPaper Class="pa-3" Elevation="1" Style="border-radius:12px">
                    <MudText Typo="Typo.h5" Style="color:var(--mud-palette-error)">@_rows.Count(r => r.Level == LSuper)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Süper Admin — yalnız süper admin</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @foreach (var grp in Grouped())
        {
            <MudPaper Class="pa-3 mb-3" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary" Style="letter-spacing:.05em">@grp.Key.ToUpper()</MudText>
                    <MudSpacer />
                    @if (grp.Any(r => !r.Hard))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => BulkFree(grp.Key))">Tümünü serbest bırak</MudButton>
                    }
                </MudStack>
                @foreach (var r in grp)
                {
                    <div class="d-flex align-center py-2" style="border-top:1px solid var(--mud-palette-lines-default)">
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body2" Style="font-weight:600">@r.Label</MudText>
                            @if (!string.IsNullOrEmpty(Hint(r.ModuleKey))) { <MudText Typo="Typo.caption" Class="mud-text-secondary">@Hint(r.ModuleKey)</MudText> }
                        </div>
                        @if (r.Hard)
                        {
                            @* Derleme-zamanı sabit düzey — değiştirilemez. *@
                            <MudChip T="string" Size="Size.Small" Color="@(r.Level == LSuper ? Color.Error : Color.Warning)" Icon="@Icons.Material.Filled.Lock" Variant="Variant.Text">
                                @(r.Level == LSuper ? "Süper Admin (sabit)" : "Admin (sabit)")
                            </MudChip>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" DropShadow="false"
                                       Variant="@(r.Level == LFree ? Variant.Filled : Variant.Outlined)"
                                       Color="@(r.Level == LFree ? Color.Success : Color.Default)"
                                       OnClick="@(() => SetLevel(r, LFree))" Class="mr-1">🟢 Serbest</MudButton>
                            <MudButton Size="Size.Small" DropShadow="false"
                                       Variant="@(r.Level == LAdmin ? Variant.Filled : Variant.Outlined)"
                                       Color="@(r.Level == LAdmin ? Color.Warning : Color.Default)"
                                       OnClick="@(() => SetLevel(r, LAdmin))" Class="mr-1">🟡 Admin</MudButton>
                            <MudButton Size="Size.Small" DropShadow="false"
                                       Variant="@(r.Level == LSuper ? Variant.Filled : Variant.Outlined)"
                                       Color="@(r.Level == LSuper ? Color.Error : Color.Default)"
                                       StartIcon="@Icons.Material.Filled.Lock"
                                       OnClick="@(() => SetLevel(r, LSuper))">🔴 Süper Admin</MudButton>
                        }
                    </div>
                }
            </MudPaper>
        }

        @if (Grouped().Sum(g => g.Count()) == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">Aramayla eşleşen ekran yok.</MudAlert>
        }

        <MudPaper Class="pa-3 mt-3" Elevation="4" Style="position:sticky;bottom:8px;border-radius:12px">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @if (_changes > 0) { <b>@_changes değişiklik</b> } else { <span>Değişiklik yok</span> } bekliyor
                    · kaydedilince o firmanın adminleri anında etkilenir
                </MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Text" OnClick="Load" Disabled="@(_busy || _changes == 0)">Geri al</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(_busy || _changes == 0)">Kaydet</MudButton>
            </MudStack>
            @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_msg</MudAlert> }
        </MudPaper>
    }
    </MudTabPanel>

    @* ═══ ROL TAVANI — eskiden ayrı "Rol Yetki Kontrol" ekranıydı ═══════════════════════════ *@
    <MudTabPanel Text="Rol tavanı" Icon="@Icons.Material.Filled.AdminPanelSettings">
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="max-width:80ch;">
            Bir ekranı bir role <b>kapattığınızda</b>: o roldeki kullanıcılara yetki verilirken ekran
            <b>yetki ağacında hiç görünmez</b>, kaydedilmeye çalışılırsa <b>reddedilir</b> ve daha önce
            verilmiş olsa bile <b>erişim kapanır</b> (Admin'in genel yetkisi de bunu aşamaz).
            <b>Süper Admin</b> bu kısıtlardan muaftır. <b>Kilit</b> ikonlu hücreler yapısal olarak zaten
            kapalıdır ve değiştirilemez.
        </MudText>

        @if (_roleError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">
                @_roleError
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="ml-2" OnClick="LoadRoles">Yeniden dene</MudButton>
            </MudAlert>
        }

        @if (_roleRows is null)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            <MudPaper Class="pa-0" Elevation="2">
                <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto;">
                    <thead>
                        <tr>
                            <th style="min-width:230px">Ekran</th>
                            @foreach (var r in _roles)
                            {
                                <th style="text-align:center;min-width:150px">
                                    @r.Name
                                    <div>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => BulkRole(r.Id, false))">Tümü açık</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => BulkRole(r.Id, true))">Tümü kapalı</MudButton>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredRoles())
                        {
                            <tr>
                                <td><b>@row.Label</b></td>
                                @foreach (var r in _roles)
                                {
                                    var cell = row.Cells[r.Id];
                                    <td style="text-align:center">
                                        @if (cell.Hard)
                                        {
                                            <MudTooltip Text="Yapısal olarak kapalı — bu ekran bu role zaten verilemez.">
                                                <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Default" Size="Size.Small" />
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudSwitch T="bool" Value="@(!cell.Blocked)" Color="Color.Success" UnCheckedColor="Color.Error"
                                                       ValueChanged="@((bool open) => ToggleRole(cell, open))" />
                                            <div>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@(cell.Blocked ? "Kapalı" : "Açık")</MudText>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>

            @if (!FilteredRoles().Any()) { <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Aramayla eşleşen ekran yok.</MudAlert> }

            <MudPaper Class="pa-3 mt-3" Elevation="4" Style="position:sticky;bottom:8px;border-radius:12px">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @if (_roleChanges > 0) { <b>@_roleChanges değişiklik</b> } else { <span>Değişiklik yok</span> } bekliyor
                        · <b>yalnız seçili firmayı</b> etkiler · ilgili kullanıcılar <b>yeniden giriş yapınca</b> tam etkin olur
                    </MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" OnClick="LoadRoles" Disabled="@(_busy || _roleChanges == 0)">Geri al</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRoles" Disabled="@(_busy || _roleChanges == 0)">Kaydet</MudButton>
                </MudStack>
                @if (_roleMsg is not null) { <MudAlert Severity="@(_roleOk ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">@_roleMsg</MudAlert> }
            </MudPaper>
        }
    </MudTabPanel>
    </MudTabs>
}

@code {
    // Düzey sabitleri (CompanyGrantService ile aynı).
    private const string LFree = "serbest";
    private const string LAdmin = "admin";
    private const string LSuper = "superadmin";

    private sealed class Row
    {
        public string ModuleKey { get; set; } = "";
        public string Label { get; set; } = "";
        public bool Hard { get; set; }              // derleme-zamanı sabit düzey (değiştirilemez)
        public string Level { get; set; } = LFree;  // serbest / admin / superadmin
        public string Original { get; set; } = LFree;
    }

    private List<ApiClient.Opt> _companies = new();
    private string? _companyId;
    private List<Row>? _rows;
    /// <summary>Yükleme hatası — tablo hiç çizilemese de ekranda görünür (sonsuz yükleme düzeltmesi).</summary>
    private string? _loadError;
    private string _search = "";
    private int _changes;
    private string? _msg; private bool _ok; private bool _busy;

    // ═══ ROL TAVANI (A2: eskiden ayrı ekrandı) ═══════════════════════════════════════════════
    private sealed class RoleCell
    {
        public bool Blocked { get; set; }
        public bool Original { get; set; }
        public bool Hard { get; set; }
    }
    private sealed class RoleRow
    {
        public string ModuleKey { get; set; } = "";
        public string Label { get; set; } = "";
        public Dictionary<string, RoleCell> Cells { get; } = new(StringComparer.Ordinal);
    }

    private List<ApiClient.Opt> _roles = new();     // Id = roleKey
    private List<RoleRow>? _roleRows;
    private string? _roleError;
    private int _roleChanges;
    private string? _roleMsg; private bool _roleOk;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsSuperAdmin) return;
        // ⭐ Korumasız bırakılmaz: 401/500 render sırasında patlarsa Blazor devresi tamamen düşer.
        try { _companies = await Api.OptionsAsync("/api/companies", "id", "name"); }
        catch (Exception ex) { _loadError = "Firma listesi alınamadı: " + ex.Message; }
    }

    /// <summary>Firma seçilince İKİ sekme de yüklenir (tek seçici, iki tablo).</summary>
    private async Task LoadAll()
    {
        await Load();
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        _roleRows = null; _roleMsg = null; _roleError = null; _roleChanges = 0;
        if (string.IsNullOrEmpty(_companyId)) return;
        try
        {
            var doc = await Api.GetObjectAsync($"/api/role-permissions?companyId={Uri.EscapeDataString(_companyId)}");
            _roles = new();
            if (doc.TryGetProperty("roles", out var roles) && roles.ValueKind == JsonValueKind.Array)
                foreach (var r in roles.EnumerateArray())
                    _roles.Add(new ApiClient.Opt(S(r, "key"), S(r, "name")));

            var list = new List<RoleRow>();
            if (doc.TryGetProperty("modules", out var mods) && mods.ValueKind == JsonValueKind.Array)
                foreach (var m in mods.EnumerateArray())
                {
                    var row = new RoleRow { ModuleKey = S(m, "moduleKey"), Label = S(m, "label") };
                    if (m.TryGetProperty("cells", out var cells) && cells.ValueKind == JsonValueKind.Array)
                        foreach (var c in cells.EnumerateArray())
                        {
                            var blocked = B(c, "blocked");
                            row.Cells[S(c, "roleKey")] = new RoleCell { Blocked = blocked, Original = blocked, Hard = B(c, "hard") };
                        }
                    list.Add(row);
                }
            _roleRows = list;
        }
        // Hata hâlinde de liste DOLDURULUR — sonsuz yükleme olmaz.
        catch (Exception ex) { _roleError = "Rol tavanı yüklenemedi: " + ex.Message; _roleRows = new(); }
    }

    private void ToggleRole(RoleCell cell, bool open)
    {
        if (cell.Hard) return;
        cell.Blocked = !open;
        RecountRoles();
    }

    private void BulkRole(string roleKey, bool blocked)
    {
        if (_roleRows is null) return;
        foreach (var r in FilteredRoles())
            if (r.Cells.TryGetValue(roleKey, out var c) && !c.Hard) c.Blocked = blocked;
        RecountRoles();
    }

    private void RecountRoles()
        => _roleChanges = _roleRows?.Sum(r => r.Cells.Values.Count(c => !c.Hard && c.Blocked != c.Original)) ?? 0;

    private IEnumerable<RoleRow> FilteredRoles()
    {
        if (_roleRows is null) return Enumerable.Empty<RoleRow>();
        var q = _search?.Trim() ?? "";
        return q.Length == 0 ? _roleRows : _roleRows.Where(r => r.Label.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SaveRoles()
    {
        if (_roleRows is null || string.IsNullOrEmpty(_companyId)) return;
        var firmaAdi = _companies.FirstOrDefault(c => c.Id == _companyId)?.Name ?? "seçili firma";
        if (!await Dialog.Confirm(
            $"\"{firmaAdi}\" firmasının rol tavanı kaydedilsin mi? Kapatılan ekranlar ilgili roldeki " +
            "kullanıcılarda yetki ağacından kalkar ve erişim reddedilir. Diğer firmalar etkilenmez.")) return;

        _busy = true; _roleMsg = null;
        try
        {
            // Yalnız yapısal olmayan (Hard değil) ve KAPALI hücreler gönderilir; gönderilmeyen = açık.
            var blocked = _roles.ToDictionary(
                r => r.Id,
                r => _roleRows.Where(x => x.Cells.TryGetValue(r.Id, out var c) && !c.Hard && c.Blocked)
                              .Select(x => x.ModuleKey).ToList());
            var err = await Api.PostAsync("/api/role-permissions", new { blocked, companyId = _companyId });
            _roleOk = err is null;
            _roleMsg = err ?? "Kaydedildi. İlgili kullanıcılar yeniden giriş yapınca tam etkin olur.";
            if (_roleOk) await LoadRoles();
        }
        catch (Exception ex) { _roleOk = false; _roleMsg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task Load()
    {
        _rows = null; _msg = null; _loadError = null; _changes = 0;
        if (string.IsNullOrEmpty(_companyId)) return;
        try
        {
            var list = new List<Row>();
            foreach (var e in await Api.GetArrayAsync($"/api/company-permissions/{_companyId}"))
            {
                var lvl = S(e, "level");
                if (string.IsNullOrEmpty(lvl)) lvl = LFree;
                list.Add(new Row
                {
                    ModuleKey = S(e, "moduleKey"),
                    Label = S(e, "label"),
                    Hard = B(e, "hard"),
                    Level = lvl,
                    Original = lvl,
                });
            }
            _rows = list;
        }
        // ⭐ Hata hâlinde de _rows DOLDURULUR — bkz. RolePermissions ile aynı düzeltme.
        catch (Exception ex) { _loadError = "Firma yetkileri yüklenemedi: " + ex.Message; _rows = new(); }
    }

    private void SetLevel(Row r, string level)
    {
        if (r.Hard || r.Level == level) return;
        r.Level = level;
        Recount();
    }

    private void BulkFree(string group)
    {
        if (_rows is null) return;
        foreach (var r in _rows.Where(r => !r.Hard && Group(r.ModuleKey) == group))
            r.Level = LFree;
        Recount();
    }

    private void Recount() => _changes = _rows?.Count(r => r.Level != r.Original) ?? 0;

    private IEnumerable<IGrouping<string, Row>> Grouped()
    {
        if (_rows is null) return Enumerable.Empty<IGrouping<string, Row>>();
        var q = _search?.Trim() ?? "";
        var rows = q.Length == 0 ? _rows : _rows.Where(r => r.Label.Contains(q, StringComparison.OrdinalIgnoreCase));
        return rows.GroupBy(r => Group(r.ModuleKey)).OrderBy(g => GroupOrder(g.Key));
    }

    private async Task Save()
    {
        if (_rows is null || string.IsNullOrEmpty(_companyId)) return;
        if (!await Dialog.Confirm("Firma ekran düzeyleri kaydedilsin mi? Kaydedilince o firmanın adminleri anında etkilenir.")) return;
        _busy = true; _msg = null;
        try
        {
            // Yalnız değiştirilebilir (Hard değil) satırların düzeyleri; serbest = sunucuda satır silinir.
            var levels = _rows.Where(r => !r.Hard).ToDictionary(r => r.ModuleKey, r => r.Level);
            var err = await Api.PostAsync($"/api/company-permissions/{_companyId}", new { levels });
            _ok = err is null; _msg = err ?? "Kaydedildi.";
            if (_ok) await Load();
        }
        catch (Exception ex) { _ok = false; _msg = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    // ── Modülleri gruplama (istemci tarafı; API değişmeden). Bilinmeyen anahtar → "Diğer". ──
    private static string Group(string key) => key switch
    {
        "materials" or "stock" or "stock_count" or "requests" => "Depo & Operasyon",
        "vehicles" or "vehicle_templates" or "inspection" or "maintenance" or "fuel" => "Araç & Bakım",
        "reports" or "daily_activity" or "audit" => "Rapor & Kayıt",
        "companies" or "users" or "permissions" or "roles" or "personnel" or "branches"
            or "quota_monitor" or "server_status" or "server_backups" or "machines" => "Yönetim (yalnız adminler)",
        _ => "Diğer",
    };
    private static int GroupOrder(string g) => g switch
    {
        "Depo & Operasyon" => 0, "Araç & Bakım" => 1, "Rapor & Kayıt" => 2, "Yönetim (yalnız adminler)" => 3, _ => 9
    };
    private static string Hint(string key) => key switch
    {
        "reports" => "Ağır raporlar — sunucu yükü",
        "fuel" => "Yakıt girişi ve tüketim",
        "requests" => "Talep oluştur, onaya gönder",
        "maintenance" => "Planlı / arıza bakımı",
        "stock" => "Giriş / çıkış / transfer",
        _ => "",
    };

    private static string S(JsonElement e, string k) => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
    private static bool B(JsonElement e, string k) => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.True;
}
