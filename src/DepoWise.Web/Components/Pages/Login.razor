@page "/login"
@layout DepoWise.Web.Components.Layout.BlankLayout
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage LocalStorage

<PageTitle>Giriş — DepoWise</PageTitle>

<div style="max-width:420px;margin:60px auto;">
    <h2>DepoWise Yönetim</h2>
    <p class="text-muted">Sunucu (API) hesabınızla giriş yapın.</p>

    <div class="mb-3">
        <label class="form-label">Kullanıcı adı</label>
        <input class="form-control" @bind="_username" />
    </div>
    <div class="mb-3">
        <label class="form-label">Parola</label>
        <input class="form-control" type="password" @bind="_password" @onkeyup="OnKey" />
    </div>
    <button class="btn btn-primary w-100" @onclick="DoLogin" disabled="@_busy">
        @(_busy ? "Giriş yapılıyor…" : "Giriş")
    </button>

    @if (_error is not null)
    {
        <div class="alert alert-danger mt-3">@_error</div>
    }
</div>

@code {
    private string _username = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await DoLogin(); }

    private async Task DoLogin()
    {
        _error = null; _busy = true;
        try
        {
            _error = await Api.LoginAsync(_username.Trim(), _password);
            if (_error is null)
            {
                await LocalStorage.SetAsync("dw_auth", $"{Auth.Token}|{Auth.UserId}|{Auth.CompanyId}|{Auth.IsSuperAdmin}");
                Nav.NavigateTo("/machines");
            }
        }
        catch (Exception ex) { _error = "Bağlantı hatası: " + ex.Message; }
        finally { _busy = false; }
    }
}
