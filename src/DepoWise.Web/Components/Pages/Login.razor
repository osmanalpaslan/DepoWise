@page "/login"
@layout DepoWise.Web.Components.Layout.BlankLayout
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage LocalStorage

<PageTitle>Giriş — DepoWise</PageTitle>

<MudPaper Class="pa-8" Elevation="4" Style="max-width:420px;width:100%;margin-top:12vh;">
    <MudText Typo="Typo.h5" Class="mb-1">DepoWise Yönetim</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Sunucu hesabınızla giriş yapın.</MudText>

    <MudTextField @bind-Value="_username" Label="Kullanıcı adı" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
    <MudTextField @bind-Value="_password" Label="Parola" InputType="InputType.Password" Variant="Variant.Outlined"
                  Margin="Margin.Dense" Class="mb-3" OnKeyUp="OnKey" />
    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="DoLogin" Disabled="_busy">
        @(_busy ? "Giriş yapılıyor…" : "Giriş")
    </MudButton>

    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
</MudPaper>

@code {
    private string _username = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await DoLogin(); }

    private async Task DoLogin()
    {
        _error = null; _busy = true;
        try
        {
            _error = await Api.LoginAsync(_username.Trim(), _password);
            if (_error is null)
            {
                await LocalStorage.SetAsync("dw_auth", $"{Auth.Token}|{Auth.UserId}|{Auth.CompanyId}|{Auth.IsSuperAdmin}");
                Nav.NavigateTo("/machines");
            }
        }
        catch (Exception ex) { _error = "Bağlantı hatası: " + ex.Message; }
        finally { _busy = false; }
    }
}
