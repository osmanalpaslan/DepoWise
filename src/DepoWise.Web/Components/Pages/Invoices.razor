    private async Task EFaturaSecildi(IBrowserFile? dosya)
    {
        if (dosya is null) return;
        string xml;
        try
        {
            using var akis = dosya.OpenReadStream(5 * 1024 * 1024);
            using var okuyucu = new System.IO.StreamReader(akis);
            xml = await okuyucu.ReadToEndAsync();
        }
        catch (Exception ex) { _ok = false; _msg = "Dosya okunamadı: " + ex.Message; return; }
        var (err, t) = await Api.PostJsonWithErrorAsync("/api/invoices/efatura/preview", new { xml });
        if (err is not null || t is not { } on) { _ok = false; _msg = "e-Fatura içe alınamadı: " + (err ?? "önizleme alınamadı"); return; }
        var no = on.TryGetProperty("faturaNo", out var f) ? f.GetString() : "";
        if (on.TryGetProperty("dahaOnceAlindi", out var d) && d.GetBoolean()) { _ok = false; _msg = $"{no} numaralı e-Fatura daha önce içe alınmış."; return; }
        var ozet = on.TryGetProperty("ozet", out var o) ? o.GetString() ?? "" : "";
        if (!await Dialog.Confirm(ozet, "Evet, İçe Al")) return;
        _busy = true;
        try
        {
            var (err2, r) = await Api.PostJsonWithErrorAsync("/api/invoices/efatura/import", new { xml, branchId = Auth.BranchId });
            _ok = err2 is null;
            _msg = err2 is null && r is { } j ? $"e-Fatura içe alındı: {j.GetProperty("invoiceNo").GetString()} (dış no {no})." : "e-Fatura içe alınamadı: " + err2;
            if (_ok) await Load();
        }
        finally { _busy = false; }
    }

    private async Task Load()
    {
        _busy = true; _rows = null; _detail = null;
        try
        {
            var url = $"/api/invoices?page={_page}&pageSize=50" + FiltreQuery;
            var d = await Api.GetObjectAsync(url);
            _total = d.TryGetProperty("total", out var tt) && tt.TryGetInt32(out var ti) ? ti : 0;
            _pageText = $"{_total:N0} fatura";   // M-64: sayfa bilgisi alttaki ListePager'da
            _rows = d.TryGetProperty("items", out var arr) && arr.ValueKind == JsonValueKind.Array
                ? arr.EnumerateArray().Select(e => new Row
                {
                    Id = Str(e, "id"), InvoiceNo = Str(e, "invoiceNo"), DirectionText = Str(e, "directionText"),
                    PartyTitle = Str(e, "partyTitle"), DateText = Str(e, "dateText"), DueText = Str(e, "dueText"),
                    GrandTotal = Dec(e, "grandTotal"), StatusText = Str(e, "statusText"), IsCancelled = Bool(e, "isCancelled"),
                }).ToList() : new();
        }
        catch (Exception ex) { _ok = false; _msg = "Liste alınamadı: " + ex.Message; _rows = new(); }
        finally { _busy = false; }
    }

