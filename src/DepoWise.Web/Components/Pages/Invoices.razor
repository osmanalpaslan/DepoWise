    // ═══ M-25 (AR-GE 2026-10-18, F-072) — MAL KABULDEN FATURA ═══
    // Form kabulden dolar; stok kutusu kapalı ve kilitli (mal kabulle girdi). Eşleştirme kuralları sunucuda.
    private async Task KabuldenAc(string belgeId)
    {
        JsonElement t;
        try { t = await Api.GetObjectAsync($"/api/invoices/from-receipt/{Uri.EscapeDataString(belgeId)}"); }
        catch (Exception ex) { _ok = false; _msg = ex.Message; return; }
        if (t.ValueKind != JsonValueKind.Object || !t.TryGetProperty("lines", out var satirlar))
        { _ok = false; _msg = Str(t, "error") is { Length: > 0 } e ? e : "Mal kabul bilgisi alınamadı."; return; }
        await OpenNew();
        if (!_formOpen) return;
        _fDirection = "purchase";
        _fAffectsStock = false;
        _kabulBelgesi = Str(t, "receiptDocumentId");
        var uyari = Str(t, "uyari");
        _kabulNotu = "Mal kabulden fatura: " + Str(t, "not") + ". Stok mal kabulle girdi; bu fatura stoğa İKİNCİ kez girmez. " +
                     "KDV oranını ve satıcının fatura numarasını kontrol edin." + (uyari.Length == 0 ? "" : " ⚠ " + uyari);
        var cari = Str(t, "partyId");
        if (cari.Length > 0)
        {
            if (_parties.All(p => p.Key != cari)) _parties.Add(new Opt { Key = cari, Label = Str(t, "partyText") });
            _fPartyId = cari;
        }
        var sube = Str(t, "branchId");
        if (sube.Length > 0) _fBranchId = sube;
        _fNote = Str(t, "not");
        _fLines = satirlar.EnumerateArray().Select(l => new FormLine
        {
            Material = new Opt { Key = Str(l, "materialId"), Label = $"{Str(l, "materialCode")} — {Str(l, "materialName")}" },
            MaterialId = Str(l, "materialId"),
            Quantity = l.TryGetProperty("quantity", out var q) && q.ValueKind == JsonValueKind.Number ? q.GetDecimal() : 0m,
            UnitPrice = l.TryGetProperty("unitPrice", out var p) && p.ValueKind == JsonValueKind.Number ? p.GetDecimal() : 0m,
        }).ToList();
    }

