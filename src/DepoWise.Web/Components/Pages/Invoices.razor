@page "/invoices"
@page "/invoices/{Section}"
@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog
@inject IJSRuntime JS   // ⭐ M-54: Excel/PDF indirme (dwDownload)

@* G4-2 — FATURALAR (web). Masaüstüyle AYNI API/servis sözleşmesini kullanır: doğrulama, toplam
   hesabı, yetki, idempotency ve iptal kuralı SUNUCUDADIR → iki platform aynı sonucu verir.

   ⚠️ PARALEL DEFTER YOK: bu ekran stok veya cari tablolarına yazmaz. Kaydet tek çağrı yapar
      (POST /api/invoices); stok ve cari etkisini InvoiceService, StockService ve
      PartyLedgerService üzerinden TEK transaction'da oluşturur.
   ⚠️ SİLME YOK: "Sil" butonu bilinçli olarak yoktur; yalnız gerekçeli İPTAL vardır ve iptal
      ters kayıt üretir. *@

<PageTitle>Faturalar — Alpnex</PageTitle>

<div class="d-flex align-end justify-space-between mb-4 flex-wrap" style="gap:12px;">
    <div>
        <MudText Typo="Typo.h5" Class="dw-pagetitle">Faturalar</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1"><b>@Auth.CompanyDisplay</b></MudText>
    </div>
    @if (Auth.CanCreate("invoices"))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenNew">Yeni Fatura</MudButton>
    }
</div>

@if (!Auth.CanView("invoices"))
{
    <MudAlert Severity="Severity.Warning">Bu ekran için yetkiniz yok.</MudAlert>
}
else
{
    @if (_msg is not null) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Error)" Dense="true" Class="mb-3">@_msg</MudAlert> }

    @* ── FİLTRE ────────────────────────────────────────────────────────────────── *@
    <MudPaper Class="pa-4 mb-3" Elevation="2">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search" Placeholder="Fatura no / karşı belge no / cari" Margin="Margin.Dense"
                          Variant="Variant.Outlined" Style="max-width:300px" OnKeyUp="OnSearchKey" />
            <MudSelect T="string" @bind-Value="_direction" Label="Fatura türü" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Style="max-width:200px" Clearable="true">
                @foreach (var d in _directions) { <MudSelectItem T="string" Value="@d.Key">@d.Label</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_status" Label="Durum" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Style="max-width:180px" Clearable="true">
                <MudSelectItem T="string" Value="@("active")">Yürürlükte</MudSelectItem>
                <MudSelectItem T="string" Value="@("cancelled")">İptal</MudSelectItem>
            </MudSelect>
            <!-- ORTAK ŞUBE SEÇİCİ: yalnız kullanıcının YETKİLİ olduğu şubeleri gösterir.
                 Güvenlik kapısı serviste (BranchAccess) — bu yalnız kullanım kolaylığıdır. -->
            <BranchPicker @ref="_branchPicker" Multi="true" SelectionChanged="OnBranchesChanged"
                          HelperText="Boş = tüm yetkili şubeler" />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Load" Disabled="_busy">Ara</MudButton>
            @* ⭐ M-52 (2/2): muhasebe aktarım dosyası — masaüstüyle aynı dönem seçenekleri ve servis *@
            @if (Auth.CanView("export"))
            {
                <MudSelect T="string" @bind-Value="_aktarimDonemi" Label="Aktarım dönemi" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:150px">
                    @foreach (var (k, l) in _donemler) { <MudSelectItem T="string" Value="@k">@l</MudSelectItem> }
                </MudSelect>
                <MudTooltip Text="Seçili dönemin faturalarını muhasebe programına aktarılabilir genel Excel olarak indirir (Faturalar, KDV Dökümü, Cariler; iptaller hariç).">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AccountBalance" OnClick="MuhasebeAktarimi" Disabled="_busy">Muhasebe Aktarımı</MudButton>
                </MudTooltip>
            }
            @* ⭐ M-52 (AR-GE 2026-10-27): e-Fatura (UBL-TR XML) içe alma — masaüstüyle aynı servis ve özet metni *@
            @if (Auth.CanCreate("invoices"))
            {
                <MudTooltip Text="Tedarikçiden gelen e-Fatura (UBL-TR XML) dosyasını okur; özeti gösterir, onaylarsanız alış faturası olarak kaydeder.">
                    <MudFileUpload T="IBrowserFile" Accept=".xml" FilesChanged="EFaturaSecildi" Disabled="_busy">
                        <ActivatorContent>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile">e-Fatura İçe Al</MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </MudTooltip>
            }
            @* ⭐ M-54 (F-057): filtrelenmiş TÜM sonuç — liste ile aynı süzgeç (FiltreQuery) *@
            @if (Auth.CanView("export"))
            {
                <MudTooltip Text="Aktif filtrelerle eşleşen TÜM faturaları (yalnız bu sayfayı değil) Excel dosyası olarak indirir.">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="@(() => Disari(false))" Disabled="_busy">Excel'e Aktar</MudButton>
                </MudTooltip>
                <MudTooltip Text="Aktif filtrelerle eşleşen TÜM faturaları PDF olarak indirir — yazdırmak için. Excel ile aynı süzgeç.">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => Disari(true))" Disabled="_busy">Yazdır</MudButton>
                </MudTooltip>
            }
            <MudSpacer />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_pageText</MudText>
        </MudStack>
    </MudPaper>

    @* ── LİSTE ─────────────────────────────────────────────────────────────────── *@
    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_rows.Count == 0) { <MudAlert Severity="Severity.Info" Dense="true">Fatura bulunamadı.</MudAlert> }
    else
    {
        <MudPaper Class="pa-2" Elevation="2">
            <MudTable Items="_rows" Dense="true" Hover="true" Striped="true" T="Row"
                      OnRowClick="@(e => Select(e.Item))" RowClass="cursor-pointer">
                <HeaderContent>
                    <MudTh>FATURA NO</MudTh><MudTh>TÜR</MudTh><MudTh>CARİ</MudTh>
                    <MudTh>TARİH</MudTh><MudTh>VADE</MudTh>
                    @if (_tutarGorunur) { <MudTh Style="text-align:right">TUTAR</MudTh> }
                    <MudTh>DURUM</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.InvoiceNo</MudTd>
                    <MudTd>@context.DirectionText</MudTd>
                    <MudTd>@context.PartyTitle</MudTd>
                    <MudTd>@context.DateText</MudTd>
                    <MudTd>@context.DueText</MudTd>
                    @* FAZ 3b-5: tutar kapalıysa kolon HİÇ çizilmez ("0,00" yanlış bilgi olurdu). *@
                    @if (_tutarGorunur) { <MudTd Style="text-align:right">@context.GrandTotal.ToString("0.00")</MudTd> }
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsCancelled ? Color.Error : Color.Success)">
                            @context.StatusText
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @* ⭐ M-64 (Şablon B): sayfalama listenin hemen altında, ortak ListePager ile (masaüstü Pager ile aynı biçim). *@
            <ListePager Page="_page" PageSize="50" Total="_total" Busy="_busy" OnGo="Go" />
        </MudPaper>
    }

    @* ── DETAY ─────────────────────────────────────────────────────────────────── *@
    @if (_detail is not null)
    {
        <MudPaper Class="pa-4 mt-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">@_detail.InvoiceNo</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(_detail.IsCancelled ? Color.Error : Color.Success)">@_detail.StatusText</MudChip>
                <MudSpacer />
                @if (!_detail.IsCancelled && Auth.CanEdit("invoices"))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               OnClick="@(() => _cancelOpen = true)">İptal Et</MudButton>
                }
            </MudStack>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2"><b>Tür:</b> @_detail.DirectionText</MudText>
                    <MudText Typo="Typo.body2"><b>Cari:</b> @_detail.PartyTitle</MudText>
                    <MudText Typo="Typo.body2"><b>Depo:</b> @(_detail.BranchName ?? "—")</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2"><b>Tarih:</b> @_detail.DateText</MudText>
                    <MudText Typo="Typo.body2"><b>Vade:</b> @_detail.DueText</MudText>
                    <MudText Typo="Typo.body2"><b>Karşı belge no:</b> @(_detail.ExternalNo ?? "—")</MudText>
                </MudItem>
            </MudGrid>

            <MudTable Items="_detail.Lines" Dense="true" Class="mt-3" T="LineRow" Elevation="0">
                <HeaderContent>
                    <MudTh>KALEM</MudTh>
                    <MudTh Style="text-align:right">MİKTAR</MudTh>
                    <MudTh Style="text-align:right">B.FİYAT</MudTh>
                    <MudTh Style="text-align:right">İSK.</MudTh>
                    <MudTh Style="text-align:right">KDV</MudTh>
                    <MudTh Style="text-align:right">TEVKİFAT</MudTh>
                    <MudTh Style="text-align:right">TOPLAM</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ItemText</MudTd>
                    <MudTd Style="text-align:right">@context.Quantity.ToString("0.##")</MudTd>
                    <MudTd Style="text-align:right">@context.UnitPrice.ToString("0.00")</MudTd>
                    <MudTd Style="text-align:right">@context.DiscountAmount.ToString("0.00")</MudTd>
                    <MudTd Style="text-align:right">@context.VatAmount.ToString("0.00")</MudTd>
                    <MudTd Style="text-align:right">@context.WithholdingAmount.ToString("0.00")</MudTd>
                    <MudTd Style="text-align:right">@context.LineTotal.ToString("0.00")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudPaper Class="pa-3 mt-3" Elevation="0" Style="background:var(--mud-palette-background-grey)">
                <MudText Typo="Typo.body2">
                    Ara toplam @_detail.Subtotal.ToString("0.00") ·
                    İskonto @_detail.DiscountTotal.ToString("0.00") ·
                    KDV @_detail.VatTotal.ToString("0.00") ·
                    Tevkifat @_detail.WithholdingTotal.ToString("0.00")
                </MudText>
                <MudText Typo="Typo.h6" Class="mt-1">
                    GENEL TOPLAM @_detail.GrandTotal.ToString("0.00") @_detail.Currency
                </MudText>
            </MudPaper>

            @if (_detail.IsCancelled)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">
                    <b>İPTAL EDİLDİ.</b> @_detail.CancelReason
                </MudAlert>
            }

            @* İptal paneli — gerekçe ZORUNLU; ne olacağı açıkça yazılır. *@
            @if (_cancelOpen && !_detail.IsCancelled)
            {
                <MudPaper Class="pa-4 mt-3" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Fatura İptali</MudText>
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        Fatura <b>silinmez</b>; kaydı durur ve etkisi ters kayıtlarla sıfırlanır:
                        cari hareketi ters yönde yazılır
                        (@_detail.GrandTotal.ToString("0.00") @_detail.Currency).
                        @if (_detail.StockDocumentId is null)
                        {
                            <span>Stok etkisi yok.</span>
                        }
                        else if (_detail.Direction == "purchase")
                        {
                            <span>Stoktan <b>çıkış</b> yapılır — mal tüketilmişse iptal reddedilir (yarım iptal olmaz).</span>
                        }
                        else
                        {
                            <span>Stoğa <b>giriş</b> yapılır.</span>
                        }
                    </MudAlert>
                    <MudTextField @bind-Value="_cancelReason" Label="İptal gerekçesi" Required="true"
                                  Variant="Variant.Outlined" Lines="2" Margin="Margin.Dense" />
                    <MudStack Row="true" Spacing="2" Class="mt-3" Justify="Justify.FlexEnd">
                        @* M-61/K-10: ikincil (Vazgeç) solda, onay EN SAĞDA *@
                        <MudButton Variant="Variant.Text" OnClick="@(() => _cancelOpen = false)">Vazgeç</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_saving"
                                   OnClick="DoCancel">İptali Onayla</MudButton>
                    </MudStack>
                </MudPaper>
            }
        </MudPaper>
    }

    @* ── YENİ FATURA FORMU ─────────────────────────────────────────────────────── *@
    <MudDialog @bind-Visible="_formOpen" Options="_dlgOptions">
        <TitleContent><MudText Typo="Typo.h6">Yeni Fatura</MudText></TitleContent>
        <DialogContent>
            @if (_formError is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_formError</MudAlert> }

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_fDirection" Label="Fatura türü" Required="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               HelperText="Alış: stok girer, satıcıya borçlanırsınız. Satış: stok çıkar, müşteri size borçlanır.">
                        @foreach (var d in _directions) { <MudSelectItem T="string" Value="@d.Key">@d.Label</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_fPartyId" Label="Cari" Required="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var p in _parties) { <MudSelectItem T="string" Value="@p.Key">@p.Label</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_fBranchId" Label="Depo / Şantiye" Clearable="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               HelperText="Stok hareketinin hangi depoda oluşacağını belirler.">
                        @foreach (var b in _branches) { <MudSelectItem T="string" Value="@b.Key">@b.Label</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_fExternalNo" Label="Karşı taraf belge no"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  HelperText="Satıcının kendi fatura numarası" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_fInvoiceDate" Label="Fatura tarihi"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd.MM.yyyy" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_fDueDate" Label="Vade tarihi" Clearable="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd.MM.yyyy" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox T="bool" @bind-Value="_fAffectsStock" Dense="true" Disabled="@(_kabulBelgesi is not null)"
                                 Label="Stoğu etkilesin (kapatılırsa hizmet/masraf faturası olur — cari etkisi yine oluşur)" />
                    @if (_kabulNotu is not null)
                    {
                        @* ⭐ M-25: mal kabulden açılan fatura (masaüstüyle aynı metin) *@
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">@_kabulNotu</MudAlert>
                    }
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Satırlar</MudText>
            @foreach (var l in _fLines)
            {
                <MudPaper Class="pa-3 mb-2" Elevation="1">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            @* Malzeme ARANABİLİR seçilir: tüm malzemeler listeye doldurulmaz
                               (sayfalama sınırı yüzünden sessizce kesilirdi). *@
                            <MudAutocomplete T="Opt" Label="Malzeme" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Value="l.Material" ValueChanged="@(v => PickMaterial(l, v))"
                                             SearchFunc="SearchMaterials" ToStringFunc="@(o => o?.Label ?? "")"
                                             Clearable="true" ResetValueOnEmptyText="true"
                                             HelperText="Hizmet satırında boş bırakın ve açıklama yazın." />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="l.Description" Label="Açıklama"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudNumericField T="decimal" @bind-Value="l.Quantity" Label="Miktar" Min="0"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudNumericField T="decimal" @bind-Value="l.UnitPrice" Label="Birim fiyat" Min="0"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="4" md="2">
                            <MudNumericField T="decimal" @bind-Value="l.DiscountRate" Label="İskonto %" Min="0" Max="100"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="4" md="2">
                            <MudNumericField T="decimal" @bind-Value="l.VatRate" Label="KDV %" Min="0" Max="100"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="4" md="2">
                            <MudNumericField T="decimal" @bind-Value="l.WithholdingRate" Label="Tevkifat %" Min="0" Max="100"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HelperText="KDV üzerinden" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       OnClick="@(() => _fLines.Remove(l))">Satırı sil</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => _fLines.Add(new FormLine()))">
                Satır ekle
            </MudButton>

            <MudTextField @bind-Value="_fNote" Label="Not" Lines="2" Class="mt-3"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />

            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                Toplamlar kaydederken sunucuda hesaplanır (ekran ile kayıt aynı koddan gelir).
            </MudAlert>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _formOpen = false)">Vazgeç</MudButton>
            @* _saving sürerken düğme kapalıdır; ayrıca operation_id sabit olduğu için çift gönderim
               sunucuda da İKİNCİ fatura oluşturmaz. *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="Save">Kaydet</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    // ── ORTAK ŞUBE KAPSAMI (G4-3d) ───────────────────────────────────────────────
    // Seçim yalnız OKUMA filtresidir; yazma tarafında tekil "aktif çalışma şubesi" kullanılır.
    private BranchPicker? _branchPicker;
    private IReadOnlyList<string> _branchIds = Array.Empty<string>();

    /// <summary>Seçim değişince veri YENİDEN yüklenir (kullanıcı Ara demek zorunda kalmasın).</summary>
    private async Task OnBranchesChanged(IReadOnlyList<string> ids)
    {
        _branchIds = ids;
        await Load();
    }

    /// <summary>API sorgu eki: &branchIds=a,b. Boş → ek yok (tüm yetkili şubeler).</summary>
    /// <summary>⭐ M-54: liste ve dışa aktarım TEK süzgeç kaynağı (ikisi asla ayrışmaz).</summary>
    private string FiltreQuery =>
        (string.IsNullOrWhiteSpace(_search) ? "" : $"&search={Uri.EscapeDataString(_search)}")
        + (string.IsNullOrWhiteSpace(_direction) ? "" : $"&direction={Uri.EscapeDataString(_direction)}")
        + (string.IsNullOrWhiteSpace(_status) ? "" : $"&status={Uri.EscapeDataString(_status)}")
        + BranchQuery;

    /// <summary>⭐ M-54: Excel (pdf=false) / Yazdır (pdf=true) — aynı uç, aynı süzgeç; yalnız format farkı.</summary>
    private async Task Disari(bool pdf)
    {
        var (bytes, name) = await Api.GetFileAsync("/api/invoices/export?" + FiltreQuery.TrimStart('&') + (pdf ? "&format=pdf" : ""),
            pdf ? "Faturalar.pdf" : "Faturalar.xlsx");
        if (bytes is null) { _ok = false; _msg = (pdf ? "PDF" : "Excel") + " indirilemedi (dışa aktarım yetkiniz olmayabilir)."; return; }
        await JS.InvokeVoidAsync("dwDownload", name, Convert.ToBase64String(bytes),
            pdf ? "application/pdf" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private string BranchQuery => _branchIds.Count == 0 ? "" : "&branchIds=" + Uri.EscapeDataString(string.Join(",", _branchIds));

    [Parameter] public string? Section { get; set; }
    /// <summary>⭐ M-25: Satın Alma ekranındaki "Faturalaştır" → /invoices?kabul=&lt;mal kabul belgesi&gt;.</summary>
    [SupplyParameterFromQuery(Name = "kabul")] public string? Kabul { get; set; }
    private string? _kabulBelgesi, _kabulNotu;
    /// <summary>⭐ M-56 2/2: stok hareketinden kaynağa gitme → /invoices?ac=&lt;fatura&gt; (detay doğrudan açılır).</summary>
    [SupplyParameterFromQuery(Name = "ac")] public string? Ac { get; set; }

    private sealed class Opt
    {
        public string Key = "", Label = "";
    }

    private sealed class Row
    {
        public string Id = "", InvoiceNo = "", DirectionText = "", PartyTitle = "", DateText = "", DueText = "", StatusText = "";
        public decimal GrandTotal;
        public bool IsCancelled;
    }

    private sealed class LineRow
    {
        public string ItemText = "";
        public decimal Quantity, UnitPrice, DiscountAmount, VatAmount, WithholdingAmount, LineTotal;
    }

    private sealed class Detail
    {
        public string Id = "", InvoiceNo = "", Direction = "", DirectionText = "", PartyTitle = "",
                      DateText = "", DueText = "", StatusText = "", Currency = "TRY";
