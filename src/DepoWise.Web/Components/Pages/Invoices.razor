    /// <summary>Malzeme ARAMASI sunucuda yapılır — tüm malzemeler tarayıcıya indirilmez.</summary>
    private async Task<IEnumerable<Opt>> SearchMaterials(string? term, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(term)) return Array.Empty<Opt>();
        try
        {
            var d = await Api.GetObjectAsync($"/api/materials/grid?page=1&pageSize=30&search={Uri.EscapeDataString(term)}");
            return d.TryGetProperty("items", out var arr) && arr.ValueKind == JsonValueKind.Array
                ? arr.EnumerateArray().Select(e => new Opt { Key = Str(e, "id"), Label = $"{Str(e, "code")} — {Str(e, "name")}" }).ToList()
                : Array.Empty<Opt>();
        }
        catch { return Array.Empty<Opt>(); }
    }

