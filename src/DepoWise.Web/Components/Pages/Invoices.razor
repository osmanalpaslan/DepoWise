    private async Task Save()
    {
        if (_saving) return;
        _formError = null;
        if (string.IsNullOrWhiteSpace(_fPartyId)) { _formError = "Cari seçin."; return; }
        if (_fLines.Count == 0) { _formError = "En az bir satır ekleyin."; return; }

        _saving = true;
        try
        {
            // ⭐ M-24 (K-09 a) + M-51 (K-13 a): kayıt ÖNCESİ kontrol — çift stok riski ve para işlemi onayı. Metinler masaüstüyle
            // AYNI servisten (API) gelir. Öneri kabul edilirse fatura stoğu etkilemeden kaydedilir (cari etkisi yine oluşur).
            var (kontrolHata, kontrol) = await Api.PostJsonWithErrorAsync("/api/invoices/check", Govde(_fAffectsStock));
            if (kontrolHata is not null || kontrol is null) { _formError = kontrolHata ?? "Kayıt öncesi kontrol yapılamadı."; return; }
            var k = kontrol.Value;
            var stokEtkiler = _fAffectsStock && _kabulBelgesi is null;   // M-25: kabulden fatura stok yazmaz
            if (k.TryGetProperty("ciftStokMetni", out var cs) && cs.ValueKind == JsonValueKind.String)
            {
                if (await Dialog.Confirm(cs.GetString()!, "Stoğu Etkilemeden Kaydet", "Diğer Seçenek", danger: true))
                { stokEtkiler = false; _fAffectsStock = false; }
                else if (!await Dialog.Confirm(Str(k, "zorlaMetni"), "Evet, Stoğa Girsin", "Vazgeç", danger: true))
                    return;
            }
            else if (!await Dialog.Confirm(Str(k, "onayMetni"), "Kaydet", "Vazgeç"))
                return;

            var err = await Api.PostAsync("/api/invoices", Govde(stokEtkiler));
            if (err is not null) { _formError = err; return; }

            _formOpen = false;
            _ok = true; _msg = "Fatura kaydedildi.";
            await Load();
        }
        catch (Exception ex) { _formError = "Kaydedilemedi: " + ex.Message; }
        finally { _saving = false; }
    }

    /// <summary>Fatura gövdesi (kontrol ve kayıt AYNI gövdeyi gönderir; yalnız "stoğu etkilesin" farklı olabilir).</summary>
    private object Govde(bool affectsStock) => new
    {
                direction = _fDirection,
                partyId = _fPartyId,
                operationId = _operationId,
                seriesId = (string?)null,
                externalNo = string.IsNullOrWhiteSpace(_fExternalNo) ? null : _fExternalNo,
                branchId = string.IsNullOrWhiteSpace(_fBranchId) ? null : _fBranchId,
                invoiceDate = Ms(_fInvoiceDate),
                dueDate = Ms(_fDueDate),
                currency = "TRY",
                note = string.IsNullOrWhiteSpace(_fNote) ? null : _fNote,
                affectsStock = affectsStock && _kabulBelgesi is null,
                receiptDocumentId = _kabulBelgesi,   // ⭐ M-25
                lines = _fLines.Select(l => new
                {
                    materialId = l.MaterialId,
                    description = string.IsNullOrWhiteSpace(l.Description) ? null : l.Description,
                    unit = (string?)null,
                    quantity = l.Quantity,
                    unitPrice = l.UnitPrice,
                    discountRate = l.DiscountRate,
                    vatRate = l.VatRate,
                    withholdingRate = l.WithholdingRate,
                }).ToArray(),
    };

    // ── İPTAL (SİLME DEĞİL) ───────────────────────────────────────────────────────

    private async Task DoCancel()
    {
        if (_detail is null || _saving) return;
        if (string.IsNullOrWhiteSpace(_cancelReason))
        {
            _ok = false; _msg = "İptal gerekçesi zorunlu.";
            return;
        }
        var gerekce = _cancelReason.Trim();
        if (!await Dialog.Confirm(
                $"'{_detail.InvoiceNo}' faturası iptal edilecek.\n\n" +
                "Fatura SİLİNMEZ; ters stok ve ters cari kayıtları oluşturulur.\n" +
                $"Gerekçe: {gerekce}\n\nDevam edilsin mi?", "Evet, İptal Et")) return;

        _saving = true; _msg = null;
        try
        {
            var id = _detail.Id;
            var err = await Api.PostAsync($"/api/invoices/{id}/cancel", new { reason = gerekce });
            _ok = err is null;
            _msg = err ?? "Fatura iptal edildi.";
            if (_ok)
            {
                _cancelOpen = false; _cancelReason = "";
                await Load();
                var row = _rows?.FirstOrDefault(r => r.Id == id);
                if (row is not null) await Select(row);
            }
        }
        catch (Exception ex) { _ok = false; _msg = "İptal edilemedi: " + ex.Message; }
        finally { _saving = false; }
    }

    /// <summary>
    /// 🔴 GUI TESTİNDE BULUNAN HATA (2026-08-12): tarih alanları <c>DateTime.Today</c> ile
    /// başlatılıyor → <c>Kind=Local</c>. <c>new DateTimeOffset(local, TimeSpan.Zero)</c> .NET'te
    /// ArgumentException atar ("UTC Offset ... does not match the offset argument") ve KAYIT DÜŞER.
    /// Servis testleri bunu yakalayamazdı: dönüşüm yalnız UI katmanındadır.
    ///
    /// Çözüm: gün bileşeni alınır ve Kind NÖTRLENİR, sonra UTC 00:00 olarak yorumlanır.
    /// <b>Neden <c>new DateTimeOffset(d)</c> değil:</b> o, yerel saat dilimini uygular (TR = UTC+3) →
    /// 00:00 yerel = 21:00 UTC ÖNCEKİ GÜN olur ve tarih BİR GÜN KAYARDI.
    /// </summary>
    private static long? Ms(DateTime? d) => DepoWise.Web.Services.FieldChecks.ToUnixMs(d);

    // ── JSON yardımcıları (Parties.razor ile aynı desen) ──────────────────────────

    private static string Str(JsonElement e, string name)
        => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? (v.GetString() ?? "") : "";

    private static bool Bool(JsonElement e, string name)
        => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.True;

    private static decimal Dec(JsonElement e, string name)
        => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var d) ? d : 0m;
}
