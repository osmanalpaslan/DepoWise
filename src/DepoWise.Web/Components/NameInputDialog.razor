@* Yalnız ad toplar (POST etmez) — LookupSelect özel create yolu için. *@
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="@Label" Variant="Variant.Outlined" Immediate="true" AutoFocus="true" Margin="Margin.Dense"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "off" })" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">İptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Ok">Ekle</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Ad";
    private string _name = "";
    private void Ok() { if (!string.IsNullOrWhiteSpace(_name)) Dialog.Close(DialogResult.Ok(_name.Trim())); }
}
