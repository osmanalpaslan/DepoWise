@* Modül × (Oku/Yaz/Düzelt/Sil) yetki matrisi — Yetkiler ve Yetki Şablonları ekranlarında ortak.
   Özel işlem yetkileri (özel butonlar) de AYNI ağacın içinde tek-onaylı satır olarak listelenir. *@
<MudSimpleTable Dense="true" Bordered="true" Style="max-width:640px;">
    <thead>
        <tr><th>Modül / İşlem</th><th>Oku</th><th>Yaz</th><th>Düzelt</th><th>Sil</th></tr>
    </thead>
    <tbody>
        @{ string? _sonGrup = null; }
        @foreach (var m in Modules)
        {
            @* ⭐ 2026-09-03 (kullanıcı isteği): ağaç MENÜ GİBİ KATEGORİZE — grup başlığı + grup başına
               "Tümünü Seç"/"Temizle". Liste sunucudan zaten gruplu sırayla gelir. *@
            var grup = Groups is not null && Groups.TryGetValue(m.Id, out var g) ? g : null;
            @if (!string.IsNullOrEmpty(grup) && grup != _sonGrup)
            {
                _sonGrup = grup;
                var grupAdi = grup;
                <tr>
                    <td colspan="5" style="background:var(--mud-palette-background);">
                        <div class="d-flex align-center justify-space-between">
                            <b>@grupAdi</b>
                            @if (!(ReadOnlyAllAccess || Locked))
                            {
                                <span>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => GrupSec(grupAdi, true))"
                                               title="Bu gruptaki tüm yetkileri işaretler; uygun olmayanları elle kaldırıp kaydedin.">Tümünü Seç</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" OnClick="@(() => GrupSec(grupAdi, false))">Temizle</MudButton>
                                </span>
                            }
                        </div>
                    </td>
                </tr>
            }
            <tr>
                @* Yetki ağacında kilit/kısıt gösterilmez: verilemeyecek kalemler zaten hiç listelenmez (hedef bazlı filtre). *@
                <td>@m.Name</td>
                @for (int i = 0; i < 4; i++)
                {
                    var idx = i; var key = m.Id;
                    <td><MudCheckBox T="bool" Dense="true" ReadOnly="@(ReadOnlyAllAccess || Locked)" Value="@Get(key, idx)" ValueChanged="@(v => Set(key, idx, v))" /></td>
                }
            </tr>
        }
        @if (Buttons is { Count: > 0 })
        {
            <tr><td colspan="5" class="pt-3"><b>İşlem Yetkileri (özel butonlar)</b></td></tr>
            @foreach (var b in Buttons)
            {
                var bkey = b.Id;
                <tr>
                    <td>@b.Name</td>
                    <td colspan="4">
                        <MudCheckBox T="bool" Dense="true" Label="Yetki ver" ReadOnly="@(ReadOnlyAllAccess || Locked)"
                                     Value="@GetBtn(bkey)" ValueChanged="@(v => SetBtn(bkey, v))" />
                    </td>
                </tr>
            }
        }
    </tbody>
</MudSimpleTable>

@code {
    [Parameter] public List<ApiClient.Opt> Modules { get; set; } = new();
    /// <summary>Süper-admin-only modül anahtarları — kilit rozeti gösterilir (#6).</summary>
    [Parameter] public HashSet<string>? AdminOnly { get; set; }
    /// <summary>Özel işlem yetkileri (özel butonlar) — ağacın içinde tek-onaylı satır olarak gösterilir.</summary>
    [Parameter] public List<ApiClient.Opt>? Buttons { get; set; }
    /// <summary>Hedef Admin/Süper Admin ise: tüm kutular TAM işaretli + salt-okunur (admin bypass ile
    /// hepsine erişir; granular yetki tutmaz). Ekranı boş göstermek "yetkisi yok" izlenimi verirdi.</summary>
    [Parameter] public bool ReadOnlyAllAccess { get; set; }

    /// <summary>
    /// YET-C3 (2026-08-19) — SALT-OKUNUR KİLİT. <see cref="ReadOnlyAllAccess"/> ile karıştırılmamalı:
    /// o, hedef Admin olduğunda kutuları <b>tam işaretli</b> gösterir; bu ise <b>mevcut yetkileri
    /// olduğu gibi</b> gösterir, yalnız tıklanamaz yapar. "Düzenle" denene kadar bu açıktır.
    /// </summary>
    [Parameter] public bool Locked { get; set; }

    private readonly Dictionary<string, bool[]> _state = new();
    private readonly HashSet<string> _btn = new();

    private bool Get(string key, int idx) => ReadOnlyAllAccess || (_state.TryGetValue(key, out var a) && a[idx]);
    private void Set(string key, int idx, bool v)
    {
        if (!_state.TryGetValue(key, out var a)) { a = new bool[4]; _state[key] = a; }
        a[idx] = v;
    }

    private bool GetBtn(string key) => ReadOnlyAllAccess || _btn.Contains(key);
    private void SetBtn(string key, bool v) { if (v) _btn.Add(key); else _btn.Remove(key); }

    /// <summary>2026-09-03 — modül anahtarı → kategori adı (menü grupları gibi). Boş/verilmemişse
    /// başlıksız düz liste (eski görünüm) sürer — geriye uyumlu.</summary>
    [Parameter] public Dictionary<string, string>? Groups { get; set; }

    /// <summary>"Tümünü Seç"/"Temizle" (kullanıcı isteği 2026-09-03): gruptaki TÜM kutuları işaretler/
    /// temizler; kullanıcı uygun olmayanları elle düzeltip kaydeder. Kaydedene kadar hiçbir şey yazılmaz.</summary>
    private void GrupSec(string grup, bool ver)
    {
        if (Groups is null) return;
        foreach (var m in Modules)
            if (Groups.TryGetValue(m.Id, out var g) && g == grup)
                _state[m.Id] = new[] { ver, ver, ver, ver };
        StateHasChanged();
    }

    /// <summary>Kayıtlı yetkileri yükle: (moduleKey, view, create, edit, delete).</summary>
    public void LoadFrom(IEnumerable<(string Key, bool V, bool C, bool E, bool D)> data)
    {
        _state.Clear();
        foreach (var (k, v, c, e, d) in data) _state[k] = new[] { v, c, e, d };
        StateHasChanged();
    }

    /// <summary>Kayıtlı özel buton yetkilerini yükle.</summary>
    public void LoadButtons(IEnumerable<string> keys)
    {
        _btn.Clear();
        foreach (var k in keys) _btn.Add(k);
        StateHasChanged();
    }

    public void Clear() { _state.Clear(); _btn.Clear(); StateHasChanged(); }

    /// <summary>En az bir bayrağı açık olan modül anahtarları (#3 kısıtlı modül kontrolü için).</summary>
    public IEnumerable<string> SelectedKeys()
        => _state.Where(kv => kv.Value.Any(b => b)).Select(kv => kv.Key);

    /// <summary>Seçili özel buton anahtarları.</summary>
    public List<string> CollectButtons() => _btn.ToList();

    /// <summary>Sunucuya gönderilecek satırlar (en az bir bayrak açık olanlar).</summary>
    public List<object> Collect()
        => _state.Where(kv => kv.Value.Any(b => b))
            .Select(kv => (object)new { moduleKey = kv.Key, canView = kv.Value[0], canCreate = kv.Value[1], canEdit = kv.Value[2], canDelete = kv.Value[3] })
            .ToList();
}
