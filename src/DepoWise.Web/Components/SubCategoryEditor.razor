@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

@* Malzeme ALT KATEGORİ yönetimi (kullanıcı isteği 2026-08-05, madde 10): kategori seç → o kategorinin
   alt kategorilerini ekle/düzenle/sil. Her alt kategori seçili KATEGORİYE bağlıdır (parent_id). *@

<MudPaper Class="pa-3 mb-2" Elevation="1" Style="max-width:520px;">
    <MudText Typo="Typo.subtitle2">Alt Kategori</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">Ekran: Malzemeler · Önce kategori seçin, sonra alt kategorilerini yönetin.</MudText>

    <MudSelect T="string" Value="_cat" ValueChanged="OnCatChanged" Label="Kategori" Margin="Margin.Dense"
               Variant="Variant.Outlined" Dense="true" Clearable="true" Class="mt-1" Style="max-width:280px">
        @foreach (var c in _cats) { <MudSelectItem T="string" Value="@c.Id">@c.Name</MudSelectItem> }
    </MudSelect>

    @if (string.IsNullOrEmpty(_cat)) { <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">Alt kategorileri görmek/eklemek için bir kategori seçin.</MudText> }
    else if (_items is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mt-1" /> }
    else
    {
        @if (_items.Count == 0) { <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">Bu kategoride alt kategori yok.</MudText> }
        @foreach (var it in _items)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                <MudTextField @bind-Value="it.Name" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:240px" MaxLength="50" />
                <MudTooltip Text="Adı değiştir (ID korunur)"><MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" Color="Color.Primary" OnClick="@(() => Rename(it))" /></MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(it.Id))" />
            </MudStack>
        }
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
            <MudTextField @bind-Value="_new" Placeholder="Yeni alt kategori" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:240px" MaxLength="50" />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="Add">Ekle</MudButton>
        </MudStack>
        @if (_msg is not null) { <MudText Typo="Typo.caption" Color="@(_ok ? Color.Success : Color.Error)">@_msg</MudText> }
    }
</MudPaper>

@code {
    private sealed class Item { public string Id = ""; public string Name = ""; }
    private List<ApiClient.Opt> _cats = new();
    private List<Item>? _items;
    private string? _cat;
    private string _new = "";
    private string? _msg; private bool _ok;

    protected override async Task OnInitializedAsync()
        => _cats = await Api.OptionsAsync("/api/materials/subcategories", "id", "name");   // üst-seviye kategoriler

    private async Task OnCatChanged(string? v)
    {
        _cat = v; _msg = null; _new = "";
        _items = null;
        if (!string.IsNullOrEmpty(v)) await Load();
    }

    private async Task Load()
    {
        try
        {
            var arr = await Api.GetArrayAsync($"/api/materials/subcategories?parentId={_cat}");
            _items = arr.Where(e => e.ValueKind == JsonValueKind.Object)
                .Select(e => new Item
                {
                    Id = e.GetProperty("id").GetString() ?? "",
                    Name = e.TryGetProperty("name", out var n) ? n.GetString() ?? "" : "",
                }).ToList();
        }
        catch { _items = new(); }
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_new) || string.IsNullOrEmpty(_cat)) return;
        var err = await Api.PostAsync("/api/materials/subcategories", new { name = _new.Trim(), parentId = _cat });
        _ok = err is null; _msg = err ?? "Eklendi."; if (_ok) { _new = ""; await Load(); }
    }

    private async Task Delete(string id)
    {
        if (!await Dialog.Confirm("Bu alt kategori silinsin mi?", "Evet, Sil", danger: true)) return;
        var err = await Api.DeleteAsync($"/api/lookups/material_categories/{id}");
        _ok = err is null; _msg = err ?? "Silindi."; if (_ok) await Load();
    }

    private async Task Rename(Item it)
    {
        if (string.IsNullOrWhiteSpace(it.Name)) { _msg = "Ad boş olamaz."; _ok = false; return; }
        var err = await Api.PutAsync($"/api/lookups/material_categories/{it.Id}", new { name = it.Name.Trim() });
        _ok = err is null; _msg = err ?? "Ad güncellendi (ID korundu)."; if (_ok) await Load();
    }
}
