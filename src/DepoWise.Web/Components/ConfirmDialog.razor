@* Ortak onay penceresi — ekle/düzelt/sil/kaydet işlemlerinden önce. *@
@inject DepoWise.Web.Services.WebSesServisi Ses
<MudDialog>
    <DialogContent>
        <MudText Style="white-space:pre-line">@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@CancelText</MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Ok">@OkText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string Message { get; set; } = "Bu işlemi onaylıyor musunuz?";
    [Parameter] public string OkText { get; set; } = "Evet";
    [Parameter] public string CancelText { get; set; } = "Vazgeç";
    [Parameter] public Color Color { get; set; } = Color.Primary;

    /// <summary>
    /// ⭐ SES (kullanıcı isteği 2026-09-07): buton uyarı/onay penceresi açılınca ses çalar.
    /// Burası web'deki TÜM standart onayların tek geçidi (DialogExtensions.Confirm →
    /// ConfirmEdit/ConfirmDelete/ConfirmCancelRecord) olduğu için tek yer yeter.
    ///
    /// ⚠️ Kullanıcının açık şartı: buton uyarılarına SPAM KALKANI UYGULANMAZ — bu pencereler
    /// kullanıcının kendi tıklamasıyla, teker teker açılır.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Ses.CalAsync(DepoWise.Application.Notifications.SesTuru.DugmeUyarisi);
    }

    private void Ok() => Dialog.Close(DialogResult.Ok(true));
    private void Cancel() => Dialog.Cancel();
}
