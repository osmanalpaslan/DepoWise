@inject ApiClient Api

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="@Label" Variant="Variant.Outlined"
                      Immediate="true" AutoFocus="true" Margin="Margin.Dense"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "off" })" />
        @if (_err is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_err</MudAlert> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_busy">Ekle</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string Table { get; set; } = "";
    [Parameter] public string Label { get; set; } = "Ad";

    /// <summary>
    /// ⭐ TDR-01 devamı (2026-09-05) — ÜST KAYIT. Doluysa kayıt genel <c>/api/lookups/{Table}</c>
    /// ucuna DEĞİL, üst kayıt taşıyabilen özel uca gider. Bugün tek kullanıcısı ALT KATEGORİDİR:
    /// alt kategori seçili kategoriye aittir; genel uç <c>parentId</c> taşıyamadığı için oradan
    /// eklenen kayıt sahipsiz bir ÜST kategori olur ve kullanıcı "eklediğim alt kategori listede yok"
    /// derdi. Boş bırakılırsa davranış eskisiyle BİREBİR aynıdır.
    /// </summary>
    [Parameter] public string? ParentId { get; set; }

    private string _name = "";
    private string? _err;
    private bool _busy;

    private async Task Save()
    {
        _err = null;
        if (string.IsNullOrWhiteSpace(_name)) { _err = "Ad zorunlu."; return; }
        _busy = true;
        try
        {
            var err = string.IsNullOrEmpty(ParentId)
                ? await Api.PostAsync($"/api/lookups/{Table}", new { name = _name.Trim() })
                : await Api.PostAsync("/api/materials/subcategories", new { name = _name.Trim(), parentId = ParentId });
            if (err is null) { Dialog.Close(DialogResult.Ok(_name.Trim())); }
            else { _err = err; }
        }
        catch (Exception ex) { _err = "Hata: " + ex.Message; }
        finally { _busy = false; }
    }

    private void Cancel() => Dialog.Cancel();
}
