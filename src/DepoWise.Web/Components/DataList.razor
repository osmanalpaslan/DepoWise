@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth

<h3>@Title</h3>
@if (!string.IsNullOrEmpty(Hint)) { <p class="text-muted">@Hint</p> }

<button class="btn btn-outline-secondary btn-sm mb-2" @onclick="Load">Yenile</button>
@if (_error is not null) { <div class="alert alert-danger">@_error</div> }

@if (_rows is null) { <p>Yükleniyor…</p> }
else if (_rows.Length == 0) { <p class="text-muted">Kayıt yok.</p> }
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead><tr>@foreach (var c in _cols) { <th>@c</th> }</tr></thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        @foreach (var c in _cols)
                        {
                            <td>@Cell(row, c)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted">@_rows.Length kayıt</p>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Path { get; set; } = "";
    [Parameter] public string? Hint { get; set; }

    private JsonElement[]? _rows;
    private List<string> _cols = new();
    private string? _error;

    protected override async Task OnInitializedAsync() { if (Auth.IsAuthenticated) await Load(); }

    private async Task Load()
    {
        _error = null; _rows = null;
        try
        {
            _rows = await Api.GetArrayAsync(Path);
            _cols = BuildCols(_rows);
        }
        catch (Exception ex) { _error = "Yüklenemedi: " + ex.Message; _rows = Array.Empty<JsonElement>(); }
    }

    // İlk kayıtların basit (metin/sayı/bool) alanlarından kolon başlıkları üret (en fazla 8).
    private static List<string> BuildCols(JsonElement[] rows)
    {
        var cols = new List<string>();
        foreach (var row in rows.Take(5))
        {
            if (row.ValueKind != JsonValueKind.Object) continue;
            foreach (var p in row.EnumerateObject())
            {
                if (cols.Contains(p.Name)) continue;
                if (p.Value.ValueKind is JsonValueKind.Object or JsonValueKind.Array) continue;
                cols.Add(p.Name);
            }
        }
        return cols.Take(8).ToList();
    }

    private static string Cell(JsonElement row, string col)
    {
        if (row.ValueKind == JsonValueKind.Object && row.TryGetProperty(col, out var v))
        {
            return v.ValueKind switch
            {
                JsonValueKind.True => "Evet",
                JsonValueKind.False => "Hayır",
                JsonValueKind.Null => "—",
                JsonValueKind.String => v.GetString() ?? "",
                _ => v.ToString(),
            };
        }
        return "";
    }
}
