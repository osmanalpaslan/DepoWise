@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Yenile</MudButton>
    </MudStack>
    @if (!string.IsNullOrEmpty(Hint)) { <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@Hint</MudText> }
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-2">@_error</MudAlert> }

    @if (_rows is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (_rows.Length == 0) { <MudText Class="mud-text-secondary">Kayıt yok.</MudText> }
    else
    {
        <MudTable Items="_rows" Dense="true" Hover="true" Striped="true" Bordered="false" FixedHeader="true" Height="60vh">
            <HeaderContent>
                @foreach (var c in _cols) { <MudTh>@Label(c)</MudTh> }
            </HeaderContent>
            <RowTemplate>
                @foreach (var c in _cols) { <MudTd DataLabel="@c">@Cell(context, c)</MudTd> }
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_rows.Length kayıt</MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Path { get; set; } = "";
    [Parameter] public string? Hint { get; set; }

    private JsonElement[]? _rows;
    private List<string> _cols = new();
    private string? _error;

    protected override async Task OnInitializedAsync() { if (Auth.IsAuthenticated) await Load(); }

    private async Task Load()
    {
        _error = null; _rows = null;
        try { _rows = await Api.GetArrayAsync(Path); _cols = BuildCols(_rows); }
        catch (Exception ex) { _error = "Yüklenemedi: " + ex.Message; _rows = Array.Empty<JsonElement>(); }
    }

    // Teknik/yinelenen kolonlar gizlenir (masaüstündeki gibi temiz tablo).
    private static readonly HashSet<string> Hidden = new(StringComparer.OrdinalIgnoreCase)
    {
        "id", "companyId", "createdAt", "updatedAt", "version", "isDeleted", "branchId", "branchName",
        "isActive", "currency", "taxDisplay", "parentId", "kind", "brandType", "subDefinitionId",
        "definitionId", "vehicleId", "materialId", "documentId", "operationId", "approverId", "personnelId",
    };

    private static List<string> BuildCols(JsonElement[] rows)
    {
        var cols = new List<string>();
        foreach (var row in rows.Take(5))
        {
            if (row.ValueKind != JsonValueKind.Object) continue;
            foreach (var p in row.EnumerateObject())
            {
                if (cols.Contains(p.Name)) continue;
                if (p.Value.ValueKind is JsonValueKind.Object or JsonValueKind.Array) continue;
                if (Hidden.Contains(p.Name)) continue;
                if (p.Name.EndsWith("Id", StringComparison.Ordinal)) continue;
                cols.Add(p.Name);
            }
        }
        return cols.Take(9).ToList();
    }

    // JSON alan adı → masaüstüyle uyumlu Türkçe başlık.
    private static readonly Dictionary<string, string> Labels = new(StringComparer.OrdinalIgnoreCase)
    {
        ["code"] = "Kod", ["name"] = "Ad", ["type"] = "Tür", ["minStock"] = "Min. Stok", ["unitPrice"] = "Birim Fiyat",
        ["username"] = "Kullanıcı Adı", ["fullName"] = "Ad Soyad", ["roles"] = "Roller", ["statusText"] = "Durum",
        ["branchDisplay"] = "Şube", ["title"] = "Unvan", ["phone"] = "Telefon", ["plate"] = "Plaka",
        ["internalCode"] = "İç Kod", ["docNo"] = "Belge No", ["status"] = "Durum", ["statusDisplay"] = "Durum",
        ["date"] = "Tarih", ["dateText"] = "Tarih", ["quantity"] = "Miktar", ["qtyText"] = "Miktar",
        ["liters"] = "Litre", ["litersText"] = "Litre", ["vehicleCode"] = "Araç", ["definitionName"] = "Bakım Tanımı",
        ["materialName"] = "Malzeme", ["docType"] = "Belge Tipi", ["nextDate"] = "Sonraki Tarih",
        ["lastDate"] = "Son Tarih", ["result"] = "Sonuç", ["note"] = "Açıklama", ["noteText"] = "Açıklama",
        ["typeText"] = "Tür", ["directionText"] = "Yön", ["priceText"] = "B. Fiyat", ["model"] = "Model",
        ["brand"] = "Marka", ["year"] = "Yıl", ["meter"] = "Sayaç", ["driver"] = "Sürücü",
        ["requestDate"] = "Talep Tarihi", ["approvalStatus"] = "Onay", ["itemCount"] = "Kalem",
    };

    private static string Label(string key)
    {
        if (Labels.TryGetValue(key, out var v)) return v;
        // Bilinmeyen: camelCase → "Camel Case"
        var s = System.Text.RegularExpressions.Regex.Replace(key, "([a-z])([A-Z])", "$1 $2");
        return char.ToUpper(s[0]) + s[1..];
    }

    private static string Cell(JsonElement row, string col)
    {
        if (row.ValueKind == JsonValueKind.Object && row.TryGetProperty(col, out var v))
        {
            return v.ValueKind switch
            {
                JsonValueKind.True => "Evet",
                JsonValueKind.False => "Hayır",
                JsonValueKind.Null => "—",
                JsonValueKind.String => v.GetString() ?? "",
                _ => v.ToString(),
            };
        }
        return "";
    }
}
