@inject IDialogService Dialog
@inject ApiClient Api

<MudAutocomplete T="string" Value="@Value" ValueChanged="Changed" Label="@Label" Margin="Margin.Dense" Variant="Variant.Outlined"
                 SearchFunc="Search" ToStringFunc="IdToName" Clearable="true" Dense="true" Disabled="@(Disabled || _busy)"
                 ResetValueOnEmptyText="false" CoerceText="true" CoerceValue="false" Strict="false"
                 MaxItems="null" Placeholder="Ara / seç..."
                 Adornment="@(CanAdd ? Adornment.End : Adornment.None)"
                 AdornmentIcon="@Icons.Material.Filled.Add" AdornmentColor="Color.Primary" OnAdornmentClick="Add">
    <ItemTemplate Context="id">@IdToName(id)</ItemTemplate>
</MudAutocomplete>
@if (_busy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-n1" Style="height:2px" /> }

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public List<ApiClient.Opt> Items { get; set; } = new();
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Doluysa "+" çıkar; yeni kayıt /api/lookups/{AddTable}'a { name } olarak eklenir.</summary>
    [Parameter] public string? AddTable { get; set; }
    /// <summary>AddTable yerine özel create ucu (ör. /api/branches). Gövde: { CreateField: ad, [ExtraField: ExtraValue] }.</summary>
    [Parameter] public string? CreatePath { get; set; }
    [Parameter] public string CreateField { get; set; } = "name";
    [Parameter] public string? ExtraField { get; set; }
    [Parameter] public string? ExtraValue { get; set; }
    /// <summary>"+" ile ekleme sonrası ebeveyn listeyi tazelesin diye (yeni ad döner).</summary>
    [Parameter] public EventCallback<string> OnAdded { get; set; }

    private bool CanAdd => AddTable is not null || CreatePath is not null;

    private async Task Changed(string? v) { Value = v; await ValueChanged.InvokeAsync(v); }

    /// <summary>Id → görünen ad (seçili değeri metne çevirir).</summary>
    private string IdToName(string? id)
        => string.IsNullOrEmpty(id) ? "" : Items.FirstOrDefault(x => x.Id == id)?.Name ?? "";

    /// <summary>Metne göre filtrele; boş metinde tümü. Id değerlerini döndürür (görünen ad ItemTemplate/ToStringFunc ile).</summary>
    private Task<IEnumerable<string>> Search(string? text, System.Threading.CancellationToken _)
    {
        var q = (text ?? "").Trim();
        IEnumerable<ApiClient.Opt> src = Items;
        if (q.Length > 0)
            src = Items.Where(o => (o.Name ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(src.Select(o => o.Id));
    }

    private bool _busy;

    private async Task Add()
    {
        if (!CanAdd || _busy) return;
        var dlg = await Dialog.ShowAsync<NameInputDialog>("Yeni Kayıt",
            new DialogParameters { ["Label"] = "Ad" },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var res = await dlg.Result;
        if (res is null || res.Canceled || res.Data is not string raw) return;
        var name = raw.Trim();
        if (name.Length == 0) return;

        // DUPLICATE KONTROLÜ (madde 9): aynı ad zaten varsa yeni tanım OLUŞTURMA — uyar ve mevcut olanı seç.
        var dup = Items.FirstOrDefault(o => string.Equals(o.Name?.Trim(), name, StringComparison.OrdinalIgnoreCase));
        if (dup is not null)
        {
            await Dialog.Confirm($"\"{name}\" adında bir tanım zaten mevcut. Mevcut olan seçildi.", okText: "Tamam", cancelText: "");
            await Changed(dup.Id);
            return;
        }

        _busy = true; // Kaydet sırasında yükleme simgesi
        try
        {
            string? err;
            if (CreatePath is not null)
            {
                var body = new Dictionary<string, object?> { [CreateField] = name };
                if (ExtraField is not null) body[ExtraField] = ExtraValue;
                err = await Api.PostAsync(CreatePath, body);
            }
            else
            {
                err = await Api.PostAsync($"/api/lookups/{AddTable}", new { name });
            }
            if (err is null) await OnAdded.InvokeAsync(name);
            else await Dialog.Confirm("Eklenemedi: " + err, okText: "Tamam", cancelText: "");
        }
        finally { _busy = false; }
    }
}
