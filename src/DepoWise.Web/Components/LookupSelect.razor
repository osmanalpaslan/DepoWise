@inject IDialogService Dialog
@inject ApiClient Api

<MudAutocomplete T="string" Value="@Value" ValueChanged="Changed" Label="@Label" Margin="Margin.Dense" Variant="Variant.Outlined"
                 SearchFunc="Search" ToStringFunc="IdToName" Clearable="true" Dense="true" Disabled="@(Disabled || _busy)"
                 ResetValueOnEmptyText="false" CoerceText="true" CoerceValue="false" Strict="false"
                 MaxItems="null" Placeholder="Ara / seç..."
                 Adornment="@(CanAdd ? Adornment.End : Adornment.None)"
                 AdornmentIcon="@Icons.Material.Filled.Add" AdornmentColor="Color.Primary" OnAdornmentClick="Add">
    <ItemTemplate Context="id">@IdToName(id)</ItemTemplate>
</MudAutocomplete>
@if (_busy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-n1" Style="height:2px" /> }

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public List<ApiClient.Opt> Items { get; set; } = new();
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Doluysa "+" çıkar; yeni kayıt /api/lookups/{AddTable}'a { name } olarak eklenir.</summary>
    [Parameter] public string? AddTable { get; set; }
    /// <summary>AddTable yerine özel create ucu (ör. /api/branches). Gövde: { CreateField: ad, [ExtraField: ExtraValue] }.</summary>
    [Parameter] public string? CreatePath { get; set; }
    [Parameter] public string CreateField { get; set; } = "name";
    [Parameter] public string? ExtraField { get; set; }
    [Parameter] public string? ExtraValue { get; set; }
    /// <summary>ŞB-06 (2026-08-18): İKİNCİ ek alan. Şube ekranında "+" ile üst şube eklerken hem <c>kind</c>
    /// hem de <c>companyId</c> gönderilmesi gerekiyordu; tek ek alan yetmiyordu ve companyId gitmediği için
    /// süper admin başka firmayı yönetirken şube KENDİ firmasına açılıyordu.</summary>
    [Parameter] public string? Extra2Field { get; set; }
    [Parameter] public string? Extra2Value { get; set; }
    /// <summary>"+" ile ekleme sonrası ebeveyn listeyi tazelesin diye (yeni ad döner).</summary>
    [Parameter] public EventCallback<string> OnAdded { get; set; }

    // ── SUNUCU-TARAFLI ARAMA (İş A, 2026-08-09) — OPSİYONEL ──────────────────────────────
    // Varsayılan davranış DEĞİŞMEDİ: SearchPath verilmezse arama eskisi gibi Items üzerinde
    // (istemcide) yapılır. Küçük/sayfasız lookup'lar (birim, marka, kategori…) için doğrusu budur.
    //
    // SearchPath verilirse arama SUNUCUDA yapılır. Gerekçe: /api/personnel gibi SAYFALI uçlarda
    // Items en fazla 200 kayıt taşır → 200'den sonraki personel istemci aramasıyla ASLA bulunamıyordu.
    /// <summary>Doluysa arama sunucuda yapılır (ör. "/api/personnel"). "?search=" bileşen tarafından eklenir.</summary>
    [Parameter] public string? SearchPath { get; set; }
    /// <summary>Sunucu yanıtındaki görünen ad alanı (ör. "fullName").</summary>
    [Parameter] public string NameField { get; set; } = "name";

    /// <summary>Sunucudan görülen adlar — seçili kayıt Items'ta olmasa da adı gösterilebilsin diye.</summary>
    private readonly Dictionary<string, string> _serverNames = new(StringComparer.Ordinal);

    private bool CanAdd => AddTable is not null || CreatePath is not null;

    private async Task Changed(string? v) { Value = v; await ValueChanged.InvokeAsync(v); }

    /// <summary>Id → görünen ad (seçili değeri metne çevirir). Sunucu aramasında, seçili kayıt
    /// Items'ta olmayabilir → sunucudan görülen adlar önbellekten çözülür (aksi halde alan boş görünürdü).</summary>
    private string IdToName(string? id)
    {
        if (string.IsNullOrEmpty(id)) return "";
        var fromItems = Items.FirstOrDefault(x => x.Id == id)?.Name;
        if (!string.IsNullOrEmpty(fromItems)) return fromItems!;
        return _serverNames.TryGetValue(id, out var n) ? n : "";
    }

    /// <summary>Ortak seçim alanı davranışı (madde 3, kullanıcı isteği 2026-08-06): arama boşken (alana
    /// tıklanınca) en fazla 25 kayıt; arama başlayınca sınır kalkar, TÜM eşleşenler listelenir. Türkçe
    /// karakter-doğru (FieldChecks.TrCompare) — bu TEK ortak bileşen 14+ ekranı etkiler.</summary>
    private const int MaxUnfiltered = 25;
    private async Task<IEnumerable<string>> Search(string? text, System.Threading.CancellationToken _)
    {
        var q = (text ?? "").Trim();

        // SearchPath verildiyse arama SUNUCUDA (sayfa sınırının ötesine ulaşır). Verilmediyse eski
        // istemci-taraflı davranış AYNEN korunur — 14+ mevcut kullanım etkilenmez.
        if (!string.IsNullOrEmpty(SearchPath))
        {
            var url = SearchPath + (q.Length > 0 ? $"?search={Uri.EscapeDataString(q)}" : "");
            List<ApiClient.Opt> found;
            try { found = await Api.OptionsAsync(url, "id", NameField); }
            catch { found = new List<ApiClient.Opt>(); }
            foreach (var o in found) _serverNames[o.Id] = o.Name;
            // Arama boşken de sunucudan gelen ilk sayfa gösterilir (alana tıklayınca liste boş kalmasın).
            return (q.Length > 0 ? found : found.Take(MaxUnfiltered)).Select(o => o.Id);
        }

        IEnumerable<ApiClient.Opt> src;
        if (q.Length > 0)
            src = Items.Where(o => DepoWise.Web.Services.FieldChecks.TrCompare.IndexOf(o.Name ?? "", q, System.Globalization.CompareOptions.IgnoreCase) >= 0);
        else
            src = Items.Take(MaxUnfiltered);
        return src.Select(o => o.Id);
    }

    private bool _busy;

    private async Task Add()
    {
        if (!CanAdd || _busy) return;
        var dlg = await Dialog.ShowAsync<NameInputDialog>("Yeni Kayıt",
            new DialogParameters { ["Label"] = "Ad" },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var res = await dlg.Result;
        if (res is null || res.Canceled || res.Data is not string raw) return;
        var name = raw.Trim();
        if (name.Length == 0) return;

        // DUPLICATE KONTROLÜ (madde 9): aynı ad zaten varsa yeni tanım OLUŞTURMA — uyar ve mevcut olanı seç.
        // Türkçe karakter-doğru karşılaştırma (bkz. Search — aynı gerekçe).
        var dup = Items.FirstOrDefault(o => DepoWise.Web.Services.FieldChecks.TrCompare.Compare(o.Name?.Trim() ?? "", name, System.Globalization.CompareOptions.IgnoreCase) == 0);
        if (dup is not null)
        {
            await Dialog.Confirm($"\"{name}\" adında bir tanım zaten mevcut. Mevcut olan seçildi.", okText: "Tamam", cancelText: "");
            await Changed(dup.Id);
            return;
        }

        _busy = true; // Kaydet sırasında yükleme simgesi
        try
        {
            string? err;
            if (CreatePath is not null)
            {
                var body = new Dictionary<string, object?> { [CreateField] = name };
                if (ExtraField is not null) body[ExtraField] = ExtraValue;
                if (Extra2Field is not null) body[Extra2Field] = Extra2Value;
                err = await Api.PostAsync(CreatePath, body);
            }
            else
            {
                err = await Api.PostAsync($"/api/lookups/{AddTable}", new { name });
            }
            if (err is null) await OnAdded.InvokeAsync(name);
            else await Dialog.Confirm("Eklenemedi: " + err, okText: "Tamam", cancelText: "");
        }
        finally { _busy = false; }
    }
}
