@using System.Text.Json
@inject ApiClient Api
@inject AuthState Auth
@inject IDialogService Dialog

@* ⭐ FAZ 4.5 (kullanıcı isteği 2026-09-06) — PERSONEL UNVANLARI "Tanımlar" ekranında.

   Bulunan eksik: Personel formunda "+" ile unvan eklenebiliyordu, ama bu tanım Tanım Düzenle
   ekranında YOKTU — yanlış eklenen bir unvan hiçbir yerden düzeltilemiyordu.

   ⚠️ ADI DEĞİŞTİRME YOKTUR (bilinçli): personel kaydı unvanı METİN olarak saklar (personnel.title).
   Tanımın adını değiştirmek mevcut personelin unvanını GÜNCELLEMEZ → sessiz tutarsızlık olurdu.
   Doğru akış: yeni unvanı ekle, personeli güncelle, eskisini sil. Masaüstündeki bölüm de aynı kuralı uygular.

   Yetki: bu tanım ortak "definitions" modülünde DEĞİL, "personnel" modülündedir (kendi servisi). *@

<MudPaper Class="pa-3 mb-2" Elevation="1" Style="max-width:520px;">
    <MudText Typo="Typo.subtitle2">Unvan</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">Ekran: Personel · Tablo: personnel_titles</MudText>

    @if (!Auth.CanView("personnel"))
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">Bu tanımı görmek için Personel yetkisi gerekir.</MudText>
    }
    else if (_items is null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mt-1" /> }
    else
    {
        @if (_items.Count == 0) { <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">Henüz unvan tanımlanmamış.</MudText> }
        @foreach (var it in _items)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                <MudField Variant="Variant.Text" Dense="true" Style="max-width:240px">@it.Name</MudField>
                @if (Auth.CanDelete("personnel"))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => Sil(it.Id, it.Name))" />
                }
            </MudStack>
        }
        @if (Auth.CanCreate("personnel"))
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
                <MudTextField @bind-Value="_yeni" Placeholder="Yeni unvan" Margin="Margin.Dense"
                              Variant="Variant.Outlined" Style="max-width:240px" MaxLength="50" />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="Ekle">Ekle</MudButton>
            </MudStack>
        }
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
            Unvan adı değiştirilemez: personel kayıtları unvanı metin olarak saklar. Yeni unvan ekleyip personeli güncelleyin.
        </MudText>
        @if (_mesaj is not null) { <MudText Typo="Typo.caption" Color="@(_ok ? Color.Success : Color.Error)">@_mesaj</MudText> }
    }
</MudPaper>

@code {
    private sealed class Kayit { public string Id = ""; public string Name = ""; }

    private List<Kayit>? _items;
    private string _yeni = "";
    private string? _mesaj;
    private bool _ok;

    protected override async Task OnInitializedAsync() => await Yukle();

    private async Task Yukle()
    {
        if (!Auth.CanView("personnel")) { _items = new(); return; }
        try
        {
            var arr = await Api.GetArrayAsync("/api/personnel-titles");
            _items = arr.Select(x => new Kayit
            {
                Id = x.TryGetProperty("id", out var i) ? i.GetString() ?? "" : "",
                Name = x.TryGetProperty("name", out var n) ? n.GetString() ?? "" : "",
            }).Where(x => x.Id.Length > 0).ToList();
        }
        catch { _items = new(); _ok = false; _mesaj = "Unvanlar yüklenemedi."; }
    }

    private async Task Ekle()
    {
        var ad = (_yeni ?? "").Trim();
        if (ad.Length == 0) { _ok = false; _mesaj = "Unvan adı boş olamaz."; return; }
        var hata = await Api.PostAsync("/api/personnel-titles", new { name = ad });
        _ok = hata is null;
        _mesaj = hata ?? "Unvan eklendi.";
        if (_ok) { _yeni = ""; await Yukle(); }
    }

    private async Task Sil(string id, string ad)
    {
        if (!await Dialog.ConfirmDelete($"«{ad}» unvanı silinecek. Bu unvanı taşıyan personel kayıtları DEĞİŞMEZ.")) return;
        var hata = await Api.DeleteAsync($"/api/personnel-titles/{id}");
        _ok = hata is null;
        _mesaj = hata ?? "Unvan silindi.";
        if (_ok) await Yukle();
    }
}
