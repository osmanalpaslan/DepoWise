<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.6.0" />
  </ItemGroup>

  <!--
    KOLON KATALOĞU TEKİLLEŞTİRİLDİ (İş #10, 2026-08-09).

    Eskiden aynı katalog İKİ dosyada duruyordu (Application/Ui/ListColumns.cs + Web/Services/ListColumns.cs)
    ve elle senkron tutuluyordu; biri unutulunca ekran sessizce filtrelenemez/eksik kalıyordu.

    Neden PROJE REFERANSI değil de DOSYA PAYLAŞIMI: web bilinçli olarak tek başınadır (iş kurallarına
    derleme-zamanı erişimi YOKTUR, her şeyi API'den alır). Proje referansı bu sınırı gevşetirdi.
    Neden API'den ÇEKME değil: katalog `const` alanlar içerir ve Razor'da `switch` desenlerinde
    kullanılır — çalışma zamanında gelen veri `const` yerine geçemez.

    Sonuç: TEK dosya, iki projede derlenir. Katalog artık tek yerden yönetilir.
  -->
  <ItemGroup>
    <Compile Include="..\DepoWise.Application\Ui\ListColumns.cs" Link="Services\ListColumns.cs" />
    <!--
      B-2 (PRT-01 Grup 4, 2026-08-10): talep ÖNCELİĞİ kataloğu (RequestPriorityInfo) — yukarıdaki
      ListColumns ile AYNI gerekçe. Öncelik seçicisinin web ve masaüstünde aynı seçenekleri, aynı
      sırayı ve aynı Türkçe etiketleri göstermesi gerekir; Razor'da metinleri elle tekrarlamak
      kataloğu ikinci bir doğruluk kaynağına bölerdi.
      Dosya SAF katalogdur: yalnız enum + static eşleme içerir, hiçbir dış bağımlılığı yoktur
      (using satırı yok) → web'in "her şeyi API'den al" sınırını gevşetmez, veri çekmez.
    -->
    <Compile Include="..\DepoWise.Application\Requests\RequestOperationStatus.cs" Link="Services\RequestPriorityInfo.cs" />
    <!--
      STK-B1 (2026-08-11): stok HAREKET TÜRÜ kataloğu (MovementTypeOptions) — yukarıdakilerle AYNI
      gerekçe. Aynı movement_type değeri web'de ve masaüstünde AYNI Türkçe adla görünmeli; etiketler
      Razor'da elle tekrarlandığı için üç ayrı yerde ıraksamıştı (adjustment/reverse farklı, usage ve
      usage_reverse ham İngilizce sızıyordu). Dosya SAF katalogdur (using yok, bağımlılık yok) →
      web'in "her şeyi API'den al" sınırını gevşetmez.
    -->
    <Compile Include="..\DepoWise.Application\Ui\MovementTypeOptions.cs" Link="Services\MovementTypeOptions.cs" />
    <!--
      G2/G6 (2026-08-12): MERKEZİ EKRAN KATALOĞU (AppScreens) — yukarıdakilerle AYNI gerekçe ve AYNI desen.
      Eskiden web menüsü (46 bağlantı) masaüstü menüsünün (40 bağlantı) ELLE tutulan aynasıydı; dosyanın
      kendi yorumu "BİREBİR" dediği hâlde sayılar çoktan ayrışmıştı. Artık iki menü de bu tek katalogdan
      ÜRETİLİR → yeni ekran TEK satırla iki platforma birden gelir.
      Dosya SAF katalogdur: yalnız record/enum + static liste içerir, hiçbir iş kuralı veya dış bağımlılığı
      yoktur → web'in "her şeyi API'den al" sınırını gevşetmez, veri çekmez.
      MudBlazor ikonları Application katmanına SIZDIRILMAZ; grup→ikon eşlemesi NavMenu.razor içindedir.
    -->
    <Compile Include="..\DepoWise.Application\Security\AppScreens.cs" Link="Services\AppScreens.cs" />
    <!-- MNU (2026-08-18): menü DÜZENİ çözümleyicisi (ad · üst menü · sıra). Aynı gerekçe: sıralama
         kuralı TEK yerde kalsın, web kendi kopyasını tutmasın — masaüstü menüsü de aynı kodu çağırır.
         Saf mantıktır: veri erişimi yok, MudBlazor bağımlılığı yok, erişim kararı vermez. -->
    <Compile Include="..\DepoWise.Application\Security\MenuLayout.cs" Link="Services\MenuLayout.cs" />
    <!-- BAG-01 (2026-08-26): "sunucuya ulaşılamıyor" KARARI (ağ hatası ↔ yetki hatası ayrımı).
         Saf mantıktır: veri erişimi yok, MudBlazor bağımlılığı yok. Web projesine referans
         verilemediği (ortak dosyaların aynası derlendiği) için burada da AYNI dosya derlenir →
         karar tek yerde kalır ve birim testinden Application üzerinden sınanır. -->
    <Compile Include="..\DepoWise.Application\Common\BaglantiIzleyici.cs" Link="Services\BaglantiIzleyici.cs" />
    <!-- ADR-182 (2026-08-29, PK-V1=A): ekran içi "son seçim" tercih ANAHTARLARI. Aynı gerekçe: anahtar
         iki platformda elle tekrarlansaydı biri değiştiğinde web ve masaüstü FARKLI tercih kaydını okur,
         kullanıcı "web'de seçtiğim masaüstünde gelmiyor" derdi. Dosya SAF katalogdur (yalnız const). -->
    <Compile Include="..\DepoWise.Application\Ui\UserPrefKeys.cs" Link="Services\UserPrefKeys.cs" />
  </ItemGroup>

</Project>
