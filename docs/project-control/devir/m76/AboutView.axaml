<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DepoWise.Desktop.ViewModels"
             xmlns:ctrl="using:DepoWise.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="440"
             x:Class="DepoWise.Desktop.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <!-- ⭐ M-76 (AR-GE 2026-10-26): web "Hakkında" ile aynı bilgiler (eskiden "İçerik yakında eklenecek."). -->
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}" Margin="24">
        <ctrl:Toolbar Grid.Row="0" Title="Hakkında"/>
        <Border Grid.Row="1" Classes="Panel" Margin="0,16,0,0" VerticalAlignment="Top" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding AppName}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Şantiye, depo, araç-makine ve stok yönetimi." Classes="Helper"/>
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" Margin="0,6,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Program sürümü" Classes="Helper"/>
                    <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SurumMetni}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Firma" Classes="Helper" Margin="0,6,0,0"/>
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FirmaAdi}" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Son güncelleme" Classes="Helper" Margin="0,6,0,0" IsVisible="{Binding SonGuncellemeVar}"/>
                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SonGuncelleme}" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding SonGuncellemeVar}"/>
                </Grid>
                <Button Content="Güncelleme Notları" Command="{Binding GuncellemeNotlariniAcCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
